// -----

module attributes {llzk.lang} {
  function.def @identity(%input: !felt.type) -> !felt.type {
    function.return %input : !felt.type
  }
  struct.def @ScalarCallArgumentObservation {
    function.def @compute(%initial: !felt.type, %replacement: !felt.type, %bonus: !felt.type)
        -> !struct.type<@ScalarCallArgumentObservation> {
      %self = struct.new : !struct.type<@ScalarCallArgumentObservation>
      function.return %self : !struct.type<@ScalarCallArgumentObservation>
    }
    function.def @constrain(
        %self: !struct.type<@ScalarCallArgumentObservation>,
        %initial: !felt.type {function.arg_name = "initial"},
        %replacement: !felt.type {function.arg_name = "replacement"},
        %bonus: !felt.type {function.arg_name = "bonus"}
    ) {
      %source = pod.new { @value = %initial } : !pod.type<[@value: !felt.type]>
      %old = pod.read %source[@value] : !pod.type<[@value: !felt.type]>, !felt.type
      pod.write %source[@value] = %replacement : !pod.type<[@value: !felt.type]>, !felt.type
      %observed = function.call @identity(%old) : (!felt.type) -> !felt.type
      %expected = felt.const 0
      constrain.eq %observed, %expected : !felt.type
      function.return
    }
  }
}
// CHECK-LABEL: @ScalarCallArgumentObservation ConstraintDependencyGraph {
// CHECK-NEXT:      { initial, <felt.const: 0> }
// CHECK-NEXT:  }

// -----

module attributes {llzk.lang} {
  function.def @load(%initial: !felt.type, %replacement: !felt.type) -> !felt.type {
    %source = pod.new { @value = %initial } : !pod.type<[@value: !felt.type]>
    %old = pod.read %source[@value] : !pod.type<[@value: !felt.type]>, !felt.type
    pod.write %source[@value] = %replacement : !pod.type<[@value: !felt.type]>, !felt.type
    function.return %old : !felt.type
  }
  struct.def @ScalarReturnObservation {
    function.def @compute(%initial: !felt.type, %replacement: !felt.type, %bonus: !felt.type)
        -> !struct.type<@ScalarReturnObservation> {
      %self = struct.new : !struct.type<@ScalarReturnObservation>
      function.return %self : !struct.type<@ScalarReturnObservation>
    }
    function.def @constrain(
        %self: !struct.type<@ScalarReturnObservation>,
        %initial: !felt.type {function.arg_name = "initial"},
        %replacement: !felt.type {function.arg_name = "replacement"},
        %bonus: !felt.type {function.arg_name = "bonus"}
    ) {
      %observed = function.call @load(%initial, %replacement) : (!felt.type, !felt.type) -> !felt.type
      %expected = felt.const 0
      constrain.eq %observed, %expected : !felt.type
      function.return
    }
  }
}
// CHECK-LABEL: @ScalarReturnObservation ConstraintDependencyGraph {
// CHECK-NEXT:      { initial, <felt.const: 0> }
// CHECK-NEXT:  }

// -----

// The dead else region must not reintroduce a different yielded dependency.
module attributes {llzk.lang} {
  struct.def @ScalarYieldObservation {
    function.def @compute(%initial: !felt.type, %replacement: !felt.type, %bonus: !felt.type)
        -> !struct.type<@ScalarYieldObservation> {
      %self = struct.new : !struct.type<@ScalarYieldObservation>
      function.return %self : !struct.type<@ScalarYieldObservation>
    }
    function.def @constrain(
        %self: !struct.type<@ScalarYieldObservation>,
        %initial: !felt.type {function.arg_name = "initial"},
        %replacement: !felt.type {function.arg_name = "replacement"},
        %bonus: !felt.type {function.arg_name = "bonus"}
    ) {
      %true = arith.constant true
      %observed = scf.if %true -> !felt.type {
        %source = pod.new { @value = %initial } : !pod.type<[@value: !felt.type]>
        %old = pod.read %source[@value] : !pod.type<[@value: !felt.type]>, !felt.type
        pod.write %source[@value] = %replacement : !pod.type<[@value: !felt.type]>, !felt.type
        scf.yield %old : !felt.type
      } else {
        scf.yield %replacement : !felt.type
      }
      %expected = felt.const 0
      constrain.eq %observed, %expected : !felt.type
      function.return
    }
  }
}
// CHECK-LABEL: @ScalarYieldObservation ConstraintDependencyGraph {
// CHECK-NEXT:      { initial, <felt.const: 0> }
// CHECK-NEXT:  }

// -----

// A dead then region must also be excluded, even when it yields a live argument.
module attributes {llzk.lang} {
  struct.def @ScalarFalseYieldObservation {
    function.def @compute(%initial: !felt.type, %replacement: !felt.type)
        -> !struct.type<@ScalarFalseYieldObservation> {
      %self = struct.new : !struct.type<@ScalarFalseYieldObservation>
      function.return %self : !struct.type<@ScalarFalseYieldObservation>
    }
    function.def @constrain(
        %self: !struct.type<@ScalarFalseYieldObservation>,
        %initial: !felt.type {function.arg_name = "initial"},
        %replacement: !felt.type {function.arg_name = "replacement"}
    ) {
      %condition = arith.constant false
      %observed = scf.if %condition -> !felt.type {
        scf.yield %initial : !felt.type
      } else {
        scf.yield %replacement : !felt.type
      }
      %expected = felt.const 0
      constrain.eq %observed, %expected : !felt.type
      function.return
    }
  }
}
// CHECK-LABEL: @ScalarFalseYieldObservation ConstraintDependencyGraph {
// CHECK-NEXT:      { replacement, <felt.const: 0> }
// CHECK-NEXT:  }

// -----

// Both executable regions contribute when the condition is unknown.
module attributes {llzk.lang} {
  struct.def @ScalarUnknownYieldObservation {
    function.def @compute(%initial: !felt.type, %replacement: !felt.type)
        -> !struct.type<@ScalarUnknownYieldObservation> {
      %self = struct.new : !struct.type<@ScalarUnknownYieldObservation>
      function.return %self : !struct.type<@ScalarUnknownYieldObservation>
    }
    function.def @constrain(
        %self: !struct.type<@ScalarUnknownYieldObservation>,
        %initial: !felt.type {function.arg_name = "initial"},
        %replacement: !felt.type {function.arg_name = "replacement"}
    ) {
      %condition = llzk.nondet : i1
      %observed = scf.if %condition -> !felt.type {
        %source = pod.new { @value = %initial } : !pod.type<[@value: !felt.type]>
        %old = pod.read %source[@value] : !pod.type<[@value: !felt.type]>, !felt.type
        pod.write %source[@value] = %replacement : !pod.type<[@value: !felt.type]>, !felt.type
        scf.yield %old : !felt.type
      } else {
        scf.yield %replacement : !felt.type
      }
      %expected = felt.const 0
      constrain.eq %observed, %expected : !felt.type
      function.return
    }
  }
}
// CHECK-LABEL: @ScalarUnknownYieldObservation ConstraintDependencyGraph {
// CHECK-NEXT:      { initial, replacement },
// CHECK-NEXT:      { initial, <felt.const: 0> },
// CHECK-NEXT:      { replacement, <felt.const: 0> }
// CHECK-NEXT:  }
