// RUN: llzk-opt -split-input-file -llzk-print-constraint-dependency-graphs %s -o /dev/null 2>&1 | FileCheck --match-full-lines %s
// RUN: llzk-opt -split-input-file -llzk-print-constraint-dependency-graphs="intraprocedural" %s -o /dev/null 2>&1 | FileCheck --match-full-lines %s

// A scalar read is an immutable observation, even when its source is overwritten
// before the value reaches a storage write, initializer, call, return, or yield.

module attributes {llzk.lang} {
  struct.def @PodScalarObservation {
    function.def @compute(%initial: !felt.type, %replacement: !felt.type, %bonus: !felt.type)
        -> !struct.type<@PodScalarObservation> {
      %self = struct.new : !struct.type<@PodScalarObservation>
      function.return %self : !struct.type<@PodScalarObservation>
    }
    function.def @constrain(
        %self: !struct.type<@PodScalarObservation>,
        %initial: !felt.type {function.arg_name = "initial"},
        %replacement: !felt.type {function.arg_name = "replacement"},
        %bonus: !felt.type {function.arg_name = "bonus"}
    ) {
      %source = pod.new { @value = %initial } : !pod.type<[@value: !felt.type]>
      %old = pod.read %source[@value] : !pod.type<[@value: !felt.type]>, !felt.type
      pod.write %source[@value] = %replacement : !pod.type<[@value: !felt.type]>, !felt.type
      %target = pod.new : !pod.type<[@value: !felt.type]>
      pod.write %target[@value] = %old : !pod.type<[@value: !felt.type]>, !felt.type
      %observed = pod.read %target[@value] : !pod.type<[@value: !felt.type]>, !felt.type
      %expected = felt.const 0
      constrain.eq %observed, %expected : !felt.type
      function.return
    }
  }
}
// CHECK-LABEL: @PodScalarObservation ConstraintDependencyGraph {
// CHECK-NEXT:      { initial, <felt.const: 0> }
// CHECK-NEXT:  }

// -----

module attributes {llzk.lang} {
  struct.def @ArrayScalarObservation {
    function.def @compute(%initial: !felt.type, %replacement: !felt.type, %bonus: !felt.type)
        -> !struct.type<@ArrayScalarObservation> {
      %self = struct.new : !struct.type<@ArrayScalarObservation>
      function.return %self : !struct.type<@ArrayScalarObservation>
    }
    function.def @constrain(
        %self: !struct.type<@ArrayScalarObservation>,
        %initial: !felt.type {function.arg_name = "initial"},
        %replacement: !felt.type {function.arg_name = "replacement"},
        %bonus: !felt.type {function.arg_name = "bonus"}
    ) {
      %c0 = arith.constant 0 : index
      %source = array.new %initial : !array.type<1 x !felt.type>
      %old = array.read %source[%c0] : !array.type<1 x !felt.type>, !felt.type
      array.write %source[%c0] = %replacement : !array.type<1 x !felt.type>, !felt.type
      %target = array.new : !array.type<1 x !felt.type>
      array.write %target[%c0] = %old : !array.type<1 x !felt.type>, !felt.type
      %observed = array.read %target[%c0] : !array.type<1 x !felt.type>, !felt.type
      %expected = felt.const 0
      constrain.eq %observed, %expected : !felt.type
      function.return
    }
  }
}
// CHECK-LABEL: @ArrayScalarObservation ConstraintDependencyGraph {
// CHECK-NEXT:      { initial, <felt.const: 0> }
// CHECK-NEXT:  }

// -----

module attributes {llzk.lang} {
  struct.def @ArithmeticScalarObservation {
    function.def @compute(%initial: !felt.type, %replacement: !felt.type, %bonus: !felt.type)
        -> !struct.type<@ArithmeticScalarObservation> {
      %self = struct.new : !struct.type<@ArithmeticScalarObservation>
      function.return %self : !struct.type<@ArithmeticScalarObservation>
    }
    function.def @constrain(
        %self: !struct.type<@ArithmeticScalarObservation>,
        %initial: !felt.type {function.arg_name = "initial"},
        %replacement: !felt.type {function.arg_name = "replacement"},
        %bonus: !felt.type {function.arg_name = "bonus"}
    ) {
      %source = pod.new { @value = %initial } : !pod.type<[@value: !felt.type]>
      %old = pod.read %source[@value] : !pod.type<[@value: !felt.type]>, !felt.type
      pod.write %source[@value] = %replacement : !pod.type<[@value: !felt.type]>, !felt.type
      %sum = felt.add %old, %bonus
      %target = pod.new : !pod.type<[@value: !felt.type]>
      pod.write %target[@value] = %sum : !pod.type<[@value: !felt.type]>, !felt.type
      %observed = pod.read %target[@value] : !pod.type<[@value: !felt.type]>, !felt.type
      %expected = felt.const 0
      constrain.eq %observed, %expected : !felt.type
      function.return
    }
  }
}
// CHECK-LABEL: @ArithmeticScalarObservation ConstraintDependencyGraph {
// CHECK-NEXT:      { initial, bonus },
// CHECK-NEXT:      { initial, <felt.const: 0> },
// CHECK-NEXT:      { bonus, <felt.const: 0> }
// CHECK-NEXT:  }

// -----

module attributes {llzk.lang} {
  struct.def @PodInitializerObservation {
    function.def @compute(%initial: !felt.type, %replacement: !felt.type, %bonus: !felt.type)
        -> !struct.type<@PodInitializerObservation> {
      %self = struct.new : !struct.type<@PodInitializerObservation>
      function.return %self : !struct.type<@PodInitializerObservation>
    }
    function.def @constrain(
        %self: !struct.type<@PodInitializerObservation>,
        %initial: !felt.type {function.arg_name = "initial"},
        %replacement: !felt.type {function.arg_name = "replacement"},
        %bonus: !felt.type {function.arg_name = "bonus"}
    ) {
      %source = pod.new { @value = %initial } : !pod.type<[@value: !felt.type]>
      %old = pod.read %source[@value] : !pod.type<[@value: !felt.type]>, !felt.type
      pod.write %source[@value] = %replacement : !pod.type<[@value: !felt.type]>, !felt.type
      %target = pod.new { @value = %old } : !pod.type<[@value: !felt.type]>
      %observed = pod.read %target[@value] : !pod.type<[@value: !felt.type]>, !felt.type
      %expected = felt.const 0
      constrain.eq %observed, %expected : !felt.type
      function.return
    }
  }
}
// CHECK-LABEL: @PodInitializerObservation ConstraintDependencyGraph {
// CHECK-NEXT:      { initial, <felt.const: 0> }
// CHECK-NEXT:  }

