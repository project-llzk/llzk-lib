        %replacement: !felt.type {function.arg_name = "replacement"},
        %bonus: !felt.type {function.arg_name = "bonus"}
    ) {
      %c0 = arith.constant 0 : index
      %source = pod.new { @value = %initial } : !pod.type<[@value: !felt.type]>
      %array = array.new : !array.type<1 x !pod.type<[@value: !felt.type]>>
      array.write %array[%c0] = %source : !array.type<1 x !pod.type<[@value: !felt.type]>>, !pod.type<[@value: !felt.type]>
      pod.write %source[@value] = %replacement : !pod.type<[@value: !felt.type]>, !felt.type
      %copy = array.read %array[%c0] : !array.type<1 x !pod.type<[@value: !felt.type]>>, !pod.type<[@value: !felt.type]>
      %observed = pod.read %copy[@value] : !pod.type<[@value: !felt.type]>, !felt.type
      %expected = felt.const 0
      constrain.eq %observed, %expected : !felt.type
      function.return
    }
  }
}

// CHECK-LABEL: @ArrayWriteCopiesPod ConstraintDependencyGraph {
// CHECK-NEXT:      { initial, <felt.const: 0> }
// CHECK-NEXT:  }

