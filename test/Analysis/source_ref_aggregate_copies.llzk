module attributes {llzk.lang} {
  struct.def @ArrayRecordCopiesContents {
    function.def @compute(%initial: !felt.type, %replacement: !felt.type, %bonus: !felt.type)
        -> !struct.type<@ArrayRecordCopiesContents> {
      %self = struct.new : !struct.type<@ArrayRecordCopiesContents>
      function.return %self : !struct.type<@ArrayRecordCopiesContents>
    }
    function.def @constrain(
        %self: !struct.type<@ArrayRecordCopiesContents>,
        %initial: !felt.type {function.arg_name = "initial"},
        %replacement: !felt.type {function.arg_name = "replacement"},
        %bonus: !felt.type {function.arg_name = "bonus"}
    ) {
      %c0 = arith.constant 0 : index
      %source = array.new %initial, %bonus : !array.type<2 x !felt.type>
      %holder = pod.new : !pod.type<[@saved: !array.type<2 x !felt.type>]>
      pod.write %holder[@saved] = %source : !pod.type<[@saved: !array.type<2 x !felt.type>]>, !array.type<2 x !felt.type>
      array.write %source[%c0] = %replacement : !array.type<2 x !felt.type>, !felt.type
      %copy = pod.read %holder[@saved] : !pod.type<[@saved: !array.type<2 x !felt.type>]>, !array.type<2 x !felt.type>
      %observed = array.read %copy[%c0] : !array.type<2 x !felt.type>, !felt.type
      %expected = felt.const 0
      constrain.eq %observed, %expected : !felt.type
      function.return
    }
  }
}

// CHECK-LABEL: @ArrayRecordCopiesContents ConstraintDependencyGraph {
// CHECK-NEXT:      { initial, <felt.const: 0> }
// CHECK-NEXT:  }

