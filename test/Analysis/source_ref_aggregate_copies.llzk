module attributes {llzk.lang} {
  struct.def @UnwrittenScalarObservation {
    function.def @compute(%initial: !felt.type, %replacement: !felt.type, %bonus: !felt.type)
        -> !struct.type<@UnwrittenScalarObservation> {
      %self = struct.new : !struct.type<@UnwrittenScalarObservation>
      function.return %self : !struct.type<@UnwrittenScalarObservation>
    }
    function.def @constrain(
        %self: !struct.type<@UnwrittenScalarObservation>,
        %initial: !felt.type {function.arg_name = "initial"},
        %replacement: !felt.type {function.arg_name = "replacement"},
        %bonus: !felt.type {function.arg_name = "bonus"}
    ) {
      %source = pod.new : !pod.type<[@value: !felt.type]>
      %old = pod.read %source[@value] : !pod.type<[@value: !felt.type]>, !felt.type
      pod.write %source[@value] = %replacement : !pod.type<[@value: !felt.type]>, !felt.type
      %target = pod.new : !pod.type<[@value: !felt.type]>
      pod.write %target[@value] = %old : !pod.type<[@value: !felt.type]>, !felt.type
      %observed = pod.read %target[@value] : !pod.type<[@value: !felt.type]>, !felt.type
      %expected = felt.const 0
      constrain.eq %observed, %expected : !felt.type
      function.return
    }
  }
}

// CHECK-LABEL: @UnwrittenScalarObservation ConstraintDependencyGraph {
// CHECK-NEXT:      { %[[VAL_0:[0-9a-zA-Z_.-]+]].value, <felt.const: 0> }
// CHECK-NEXT:  }

// -----

module attributes {llzk.lang} {
  struct.def @NestedCopyPreservesStructHandle {
    struct.member @out : !felt.type {llzk.pub}
    function.def @compute(%component: !struct.type<@NestedCopyPreservesStructHandle>)
        -> !struct.type<@NestedCopyPreservesStructHandle> {
      %self = struct.new : !struct.type<@NestedCopyPreservesStructHandle>
      function.return %self : !struct.type<@NestedCopyPreservesStructHandle>
    }
    function.def @constrain(
        %self: !struct.type<@NestedCopyPreservesStructHandle>,
        %component: !struct.type<@NestedCopyPreservesStructHandle> {function.arg_name = "component"}
    ) {
      %source = pod.new { @child = %component }
          : !pod.type<[@child: !struct.type<@NestedCopyPreservesStructHandle>]>
      %holder = pod.new { @nested = %source }
          : !pod.type<[@nested: !pod.type<[@child: !struct.type<@NestedCopyPreservesStructHandle>]>]>
      %copy = pod.read %holder[@nested]
          : !pod.type<[@nested: !pod.type<[@child: !struct.type<@NestedCopyPreservesStructHandle>]>]>,
            !pod.type<[@child: !struct.type<@NestedCopyPreservesStructHandle>]>
      %child = pod.read %copy[@child]
          : !pod.type<[@child: !struct.type<@NestedCopyPreservesStructHandle>]>,
            !struct.type<@NestedCopyPreservesStructHandle>
      %observed = struct.readm %child[@out] : !struct.type<@NestedCopyPreservesStructHandle>, !felt.type
      %expected = felt.const 0
      constrain.eq %observed, %expected : !felt.type
      function.return
    }
  }
}

// CHECK-LABEL: @NestedCopyPreservesStructHandle ConstraintDependencyGraph {
// CHECK-NEXT:      { component.out, <felt.const: 0> }
// CHECK-NEXT:  }
