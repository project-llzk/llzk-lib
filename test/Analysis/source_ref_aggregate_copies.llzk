// RUN: llzk-opt -split-input-file -llzk-print-constraint-dependency-graphs %s -o /dev/null 2>&1 | FileCheck --match-full-lines %s
// RUN: llzk-opt -split-input-file -llzk-print-constraint-dependency-graphs="intraprocedural" %s -o /dev/null 2>&1 | FileCheck --match-full-lines %s

// Mutable POD and array transfers copy their contents. Mutating a source or a
// read result must not change another copy. Struct leaves preserve instance identity.
module attributes {llzk.lang} {
  struct.def @PodWriteCopiesContents {
    function.def @compute(%initial: !felt.type, %replacement: !felt.type, %bonus: !felt.type)
        -> !struct.type<@PodWriteCopiesContents> {
      %self = struct.new : !struct.type<@PodWriteCopiesContents>
      function.return %self : !struct.type<@PodWriteCopiesContents>
    }
    function.def @constrain(
        %self: !struct.type<@PodWriteCopiesContents>,
        %initial: !felt.type {function.arg_name = "initial"},
        %replacement: !felt.type {function.arg_name = "replacement"},
        %bonus: !felt.type {function.arg_name = "bonus"}
    ) {
      %source = pod.new { @value = %initial } : !pod.type<[@value: !felt.type]>
      %holder = pod.new : !pod.type<[@saved: !pod.type<[@value: !felt.type]>]>
      pod.write %holder[@saved] = %source : !pod.type<[@saved: !pod.type<[@value: !felt.type]>]>, !pod.type<[@value: !felt.type]>
      pod.write %source[@value] = %replacement : !pod.type<[@value: !felt.type]>, !felt.type
      %copy = pod.read %holder[@saved] : !pod.type<[@saved: !pod.type<[@value: !felt.type]>]>, !pod.type<[@value: !felt.type]>
      %observed = pod.read %copy[@value] : !pod.type<[@value: !felt.type]>, !felt.type
      %expected = felt.const 0
      constrain.eq %observed, %expected : !felt.type
      function.return
    }
  }
}

// CHECK-LABEL: @PodWriteCopiesContents ConstraintDependencyGraph {
// CHECK-NEXT:      { initial, <felt.const: 0> }
// CHECK-NEXT:  }

// -----

