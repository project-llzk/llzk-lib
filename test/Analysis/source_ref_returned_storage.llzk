module attributes {llzk.lang} {
  function.def @make(%input: !felt.type) -> !array.type<1 x !felt.type> {
    %result = array.new %input : !array.type<1 x !felt.type>
    function.return %result : !array.type<1 x !felt.type>
  }
  function.def @forward(%input: !felt.type) -> !array.type<1 x !felt.type> {
    %result = function.call @make(%input) : (!felt.type) -> !array.type<1 x !felt.type>
    function.return %result : !array.type<1 x !felt.type>
  }
  struct.def @ForwardedReturnsHaveDistinctStorage {
    function.def @compute(%initial: !felt.type, %replacement: !felt.type)
        -> !struct.type<@ForwardedReturnsHaveDistinctStorage> {
      %self = struct.new : !struct.type<@ForwardedReturnsHaveDistinctStorage>
      function.return %self : !struct.type<@ForwardedReturnsHaveDistinctStorage>
    }
    function.def @constrain(
        %self: !struct.type<@ForwardedReturnsHaveDistinctStorage>,
        %initial: !felt.type {function.arg_name = "initial"},
        %replacement: !felt.type {function.arg_name = "replacement"}
    ) {
      %first = function.call @forward(%initial) : (!felt.type) -> !array.type<1 x !felt.type>
      %second = function.call @forward(%initial) : (!felt.type) -> !array.type<1 x !felt.type>
      %c0 = arith.constant 0 : index
      array.write %first[%c0] = %replacement : !array.type<1 x !felt.type>, !felt.type
      %observed = array.read %second[%c0] : !array.type<1 x !felt.type>, !felt.type
      %expected = felt.const 0
      constrain.eq %observed, %expected : !felt.type
      function.return
    }
  }
}

// CHECK-LABEL: @ForwardedReturnsHaveDistinctStorage ConstraintDependencyGraph {
// CHECK-NEXT:      { initial, <felt.const: 0> }
// CHECK-NEXT:  }

