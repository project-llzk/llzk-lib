module attributes {llzk.lang} {
  function.def @identity(%array: !array.type<1 x !felt.type>) -> !array.type<1 x !felt.type> {
    function.return %array : !array.type<1 x !felt.type>
  }
  struct.def @ReturnedArgumentCopiesStorage {
    function.def @compute(%initial: !felt.type, %replacement: !felt.type)
        -> !struct.type<@ReturnedArgumentCopiesStorage> {
      %self = struct.new : !struct.type<@ReturnedArgumentCopiesStorage>
      function.return %self : !struct.type<@ReturnedArgumentCopiesStorage>
    }
    function.def @constrain(
        %self: !struct.type<@ReturnedArgumentCopiesStorage>,
        %initial: !felt.type {function.arg_name = "initial"},
        %replacement: !felt.type {function.arg_name = "replacement"}
    ) {
      %source = array.new %initial : !array.type<1 x !felt.type>
      %copy = function.call @identity(%source) : (!array.type<1 x !felt.type>) -> !array.type<1 x !felt.type>
      %c0 = arith.constant 0 : index
      array.write %copy[%c0] = %replacement : !array.type<1 x !felt.type>, !felt.type
      %observed = array.read %source[%c0] : !array.type<1 x !felt.type>, !felt.type
      %expected = felt.const 0
      constrain.eq %observed, %expected : !felt.type
      function.return
    }
  }
}

// CHECK-LABEL: @ReturnedArgumentCopiesStorage ConstraintDependencyGraph {
// CHECK-NEXT:      { initial, <felt.const: 0> }
// CHECK-NEXT:  }

// -----

module attributes {llzk.lang} {
  function.def @slice(%matrix: !array.type<2,1 x !felt.type>) -> !array.type<1 x !felt.type> {
    %c1 = arith.constant 1 : index
    %row = array.extract %matrix[%c1] : !array.type<2,1 x !felt.type>
    function.return %row : !array.type<1 x !felt.type>
  }
  struct.def @ReturnedSliceCopiesStorage {
    function.def @compute(%initial: !felt.type, %replacement: !felt.type, %bonus: !felt.type)
        -> !struct.type<@ReturnedSliceCopiesStorage> {
      %self = struct.new : !struct.type<@ReturnedSliceCopiesStorage>
      function.return %self : !struct.type<@ReturnedSliceCopiesStorage>
    }
    function.def @constrain(
        %self: !struct.type<@ReturnedSliceCopiesStorage>,
        %initial: !felt.type {function.arg_name = "initial"},
        %replacement: !felt.type {function.arg_name = "replacement"},
        %bonus: !felt.type {function.arg_name = "bonus"}
    ) {
      %source = array.new %initial, %bonus : !array.type<2,1 x !felt.type>
      %row = function.call @slice(%source) : (!array.type<2,1 x !felt.type>) -> !array.type<1 x !felt.type>
      %c0 = arith.constant 0 : index
      %c1 = arith.constant 1 : index
      array.write %row[%c0] = %replacement : !array.type<1 x !felt.type>, !felt.type
      %observed = array.read %source[%c1, %c0] : !array.type<2,1 x !felt.type>, !felt.type
      %expected = felt.const 0
      constrain.eq %observed, %expected : !felt.type
      function.return
    }
  }
}

// CHECK-LABEL: @ReturnedSliceCopiesStorage ConstraintDependencyGraph {
// CHECK-NEXT:      { bonus, <felt.const: 0> }
// CHECK-NEXT:  }

