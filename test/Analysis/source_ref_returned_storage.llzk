module attributes {llzk.lang} {
  function.def @make(%input: !felt.type) -> !pod.type<[@value: !felt.type]> {
    %result = pod.new { @value = %input } : !pod.type<[@value: !felt.type]>
    function.return %result : !pod.type<[@value: !felt.type]>
  }
  struct.def @ReturnedPodsHaveDistinctStorage {
    function.def @compute(%initial: !felt.type, %replacement: !felt.type)
        -> !struct.type<@ReturnedPodsHaveDistinctStorage> {
      %self = struct.new : !struct.type<@ReturnedPodsHaveDistinctStorage>
      function.return %self : !struct.type<@ReturnedPodsHaveDistinctStorage>
    }
    function.def @constrain(
        %self: !struct.type<@ReturnedPodsHaveDistinctStorage>,
        %initial: !felt.type {function.arg_name = "initial"},
        %replacement: !felt.type {function.arg_name = "replacement"}
    ) {
      %first = function.call @make(%initial) : (!felt.type) -> !pod.type<[@value: !felt.type]>
      %second = function.call @make(%initial) : (!felt.type) -> !pod.type<[@value: !felt.type]>
      pod.write %first[@value] = %replacement : !pod.type<[@value: !felt.type]>, !felt.type
      %observed = pod.read %second[@value] : !pod.type<[@value: !felt.type]>, !felt.type
      %expected = felt.const 0
      constrain.eq %observed, %expected : !felt.type
      function.return
    }
  }
}

// CHECK-LABEL: @ReturnedPodsHaveDistinctStorage ConstraintDependencyGraph {
// CHECK-NEXT:      { initial, <felt.const: 0> }
// CHECK-NEXT:  }
