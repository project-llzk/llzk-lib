// RUN: llzk-opt -split-input-file -llzk-print-constraint-dependency-graphs %s -o /dev/null 2>&1 | FileCheck --match-full-lines %s
// RUN: llzk-opt -split-input-file -llzk-print-constraint-dependency-graphs="intraprocedural" %s -o /dev/null 2>&1 | FileCheck --match-full-lines %s

// Fresh aggregate returns have call-specific storage, even if their contents
// depend on the same values. Returned arguments and slices also have independent storage.
module attributes {llzk.lang} {
  function.def @make(%input: !felt.type) -> !array.type<1 x !felt.type> {
    %result = array.new %input : !array.type<1 x !felt.type>
    function.return %result : !array.type<1 x !felt.type>
  }
  struct.def @ReturnedArraysHaveDistinctStorage {
    function.def @compute(%initial: !felt.type, %replacement: !felt.type)
        -> !struct.type<@ReturnedArraysHaveDistinctStorage> {
      %self = struct.new : !struct.type<@ReturnedArraysHaveDistinctStorage>
      function.return %self : !struct.type<@ReturnedArraysHaveDistinctStorage>
    }
    function.def @constrain(
        %self: !struct.type<@ReturnedArraysHaveDistinctStorage>,
        %initial: !felt.type {function.arg_name = "initial"},
        %replacement: !felt.type {function.arg_name = "replacement"}
    ) {
      %first = function.call @make(%initial) : (!felt.type) -> !array.type<1 x !felt.type>
      %second = function.call @make(%initial) : (!felt.type) -> !array.type<1 x !felt.type>
      %c0 = arith.constant 0 : index
      array.write %first[%c0] = %replacement : !array.type<1 x !felt.type>, !felt.type
      %observed = array.read %second[%c0] : !array.type<1 x !felt.type>, !felt.type
      %expected = felt.const 0
      constrain.eq %observed, %expected : !felt.type
      function.return
    }
  }
}

// CHECK-LABEL: @ReturnedArraysHaveDistinctStorage ConstraintDependencyGraph {
// CHECK-NEXT:      { initial, <felt.const: 0> }
// CHECK-NEXT:  }

// -----

module attributes {llzk.lang} {
  function.def @make(%input: !felt.type) -> !array.type<1 x !felt.type> {
    %seven = felt.const 7
    %result = array.new %seven : !array.type<1 x !felt.type>
    function.return %result : !array.type<1 x !felt.type>
  }
  struct.def @ReturnedConstantArrayCanBeWritten {
    function.def @compute(%initial: !felt.type, %replacement: !felt.type)
        -> !struct.type<@ReturnedConstantArrayCanBeWritten> {
      %self = struct.new : !struct.type<@ReturnedConstantArrayCanBeWritten>
      function.return %self : !struct.type<@ReturnedConstantArrayCanBeWritten>
    }
    function.def @constrain(
        %self: !struct.type<@ReturnedConstantArrayCanBeWritten>,
        %initial: !felt.type {function.arg_name = "initial"},
        %replacement: !felt.type {function.arg_name = "replacement"}
    ) {
      %first = function.call @make(%initial) : (!felt.type) -> !array.type<1 x !felt.type>
      %c0 = arith.constant 0 : index
      array.write %first[%c0] = %replacement : !array.type<1 x !felt.type>, !felt.type
      %observed = array.read %first[%c0] : !array.type<1 x !felt.type>, !felt.type
      %expected = felt.const 0
      constrain.eq %observed, %expected : !felt.type
      function.return
    }
  }
}

// CHECK-LABEL: @ReturnedConstantArrayCanBeWritten ConstraintDependencyGraph {
// CHECK-NEXT:      { replacement, <felt.const: 0> }
// CHECK-NEXT:  }

