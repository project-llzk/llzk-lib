module attributes {llzk.lang} {
  function.def @make(%input: !felt.type) -> !array.type<2 x !felt.type> {
    %result = array.new %input, %input : !array.type<2 x !felt.type>
    function.return %result : !array.type<2 x !felt.type>
  }
  struct.def @ReturnedArrayElementsHaveDistinctStorage {
    function.def @compute(%initial: !felt.type, %replacement: !felt.type)
        -> !struct.type<@ReturnedArrayElementsHaveDistinctStorage> {
      %self = struct.new : !struct.type<@ReturnedArrayElementsHaveDistinctStorage>
      function.return %self : !struct.type<@ReturnedArrayElementsHaveDistinctStorage>
    }
    function.def @constrain(
        %self: !struct.type<@ReturnedArrayElementsHaveDistinctStorage>,
        %initial: !felt.type {function.arg_name = "initial"},
        %replacement: !felt.type {function.arg_name = "replacement"}
    ) {
      %first = function.call @make(%initial) : (!felt.type) -> !array.type<2 x !felt.type>
      %c0 = arith.constant 0 : index
      array.write %first[%c0] = %replacement : !array.type<2 x !felt.type>, !felt.type
      %c1 = arith.constant 1 : index
      %observed = array.read %first[%c1] : !array.type<2 x !felt.type>, !felt.type
      %expected = felt.const 0
      constrain.eq %observed, %expected : !felt.type
      function.return
    }
  }
}

// CHECK-LABEL: @ReturnedArrayElementsHaveDistinctStorage ConstraintDependencyGraph {
// CHECK-NEXT:      { initial, <felt.const: 0> }
// CHECK-NEXT:  }

