// RUN: llzk-opt -split-input-file -llzk-print-constraint-dependency-graphs %s -o /dev/null 2>&1 | FileCheck --match-full-lines %s
// RUN: llzk-opt -split-input-file -llzk-print-constraint-dependency-graphs="intraprocedural" %s -o /dev/null 2>&1 | FileCheck --match-full-lines %s

// Each module observes one read through a constraint against zero. Separate
// modules prevent graph closure from merging different reads and hiding a
// missing dependency. Full graph checks also reject unexpected dependencies.
// Named arguments keep the expected sources distinct in generated checks.

// SymbolicArrayOverwritePreservesUnboundedTail (overwritten)
// A definite overwrite preserves the unbounded tail of a symbolic array.
module attributes {llzk.lang} {
  poly.template @Arrays {
    poly.param @N : index
    struct.def @SymbolicArrayOverwriteOverwritten {
      function.def @compute(%array: !array.type<@N x !felt.type>, %i: index,
          %value: !felt.type, %replacement: !felt.type)
          -> !struct.type<@Arrays::@SymbolicArrayOverwriteOverwritten<[@N]>> {
        %self = struct.new : !struct.type<@Arrays::@SymbolicArrayOverwriteOverwritten<[@N]>>
        function.return %self : !struct.type<@Arrays::@SymbolicArrayOverwriteOverwritten<[@N]>>
      }
      function.def @constrain(
          %self: !struct.type<@Arrays::@SymbolicArrayOverwriteOverwritten<[@N]>>,
          %array: !array.type<@N x !felt.type> {function.arg_name = "array"},
          %i: index {function.arg_name = "i"},
          %value: !felt.type {function.arg_name = "value"},
          %replacement: !felt.type {function.arg_name = "replacement"}
      ) {
        %c0 = arith.constant 0 : index
        array.write %array[%i] = %value : <@N x !felt.type>, !felt.type
        array.write %array[%c0] = %replacement : <@N x !felt.type>, !felt.type
        %overwritten = array.read %array[%c0] : <@N x !felt.type>, !felt.type
        %expected = felt.const 0
        constrain.eq %overwritten, %expected : !felt.type
        function.return
      }
    }
  }
}
// CHECK-LABEL: @Arrays::@SymbolicArrayOverwriteOverwritten ConstraintDependencyGraph {
// CHECK-NEXT:      { replacement, <felt.const: 0> }
// CHECK-NEXT:  }

// -----

// SymbolicArrayOverwritePreservesUnboundedTail (remaining)
// A definite overwrite preserves the unbounded tail of a symbolic array.
module attributes {llzk.lang} {
  poly.template @Arrays {
    poly.param @N : index
    struct.def @SymbolicArrayOverwriteRemaining {
      function.def @compute(%array: !array.type<@N x !felt.type>, %i: index,
          %value: !felt.type, %replacement: !felt.type)
          -> !struct.type<@Arrays::@SymbolicArrayOverwriteRemaining<[@N]>> {
        %self = struct.new : !struct.type<@Arrays::@SymbolicArrayOverwriteRemaining<[@N]>>
        function.return %self : !struct.type<@Arrays::@SymbolicArrayOverwriteRemaining<[@N]>>
      }
      function.def @constrain(
          %self: !struct.type<@Arrays::@SymbolicArrayOverwriteRemaining<[@N]>>,
          %array: !array.type<@N x !felt.type> {function.arg_name = "array"},
          %i: index {function.arg_name = "i"},
          %value: !felt.type {function.arg_name = "value"},
          %replacement: !felt.type {function.arg_name = "replacement"}
      ) {
        %c0 = arith.constant 0 : index
        %c1 = arith.constant 1 : index
        array.write %array[%i] = %value : <@N x !felt.type>, !felt.type
        array.write %array[%c0] = %replacement : <@N x !felt.type>, !felt.type
        %remaining = array.read %array[%c1] : <@N x !felt.type>, !felt.type
        %expected = felt.const 0
        constrain.eq %remaining, %expected : !felt.type
        function.return
      }
    }
  }
}
// CHECK-LABEL: @Arrays::@SymbolicArrayOverwriteRemaining ConstraintDependencyGraph {
// CHECK-NEXT:      { array[1], value },
// CHECK-NEXT:      { array[1], <felt.const: 0> },
// CHECK-NEXT:      { value, <felt.const: 0> }
// CHECK-NEXT:  }

// -----

// ConditionalStorageWritePreservesNondeterministicAlternative
// A conditional write retains both the nondeterministic initializer and replacement.
module attributes {llzk.lang} {
  struct.def @NondeterministicStorage {
    function.def @compute(%replacement: !felt.type) -> !struct.type<@NondeterministicStorage> {
      %self = struct.new : !struct.type<@NondeterministicStorage>
      function.return %self : !struct.type<@NondeterministicStorage>
    }

    function.def @constrain(
        %self: !struct.type<@NondeterministicStorage>,
        %replacement: !felt.type {function.arg_name = "replacement"}
    ) {
      %unknown = llzk.nondet : !felt.type
      %storage = pod.new { @value = %unknown } : !pod.type<[@value: !felt.type]>
      %true = arith.constant true
      scf.if %true {
        pod.write %storage[@value] = %replacement
            : !pod.type<[@value: !felt.type]>, !felt.type
      }
      %read = pod.read %storage[@value]
          : !pod.type<[@value: !felt.type]>, !felt.type
      %expected = felt.const 0
      constrain.eq %read, %expected : !felt.type
      function.return
    }
  }
}
// CHECK-LABEL: @NondeterministicStorage ConstraintDependencyGraph {
// CHECK-NEXT:      { replacement, <%nondet = llzk.nondet : !felt.type> },
// CHECK-NEXT:      { replacement, <felt.const: 0> },
// CHECK-NEXT:      { <%nondet = llzk.nondet : !felt.type>, <felt.const: 0> }
// CHECK-NEXT:  }

// -----

// DefiniteStorageWritesFollowProgramOrderAfterSolverRevisit
// The last definite write wins even when the solver revisits an earlier scf.if result.
module attributes {llzk.lang} {
  struct.def @OrderedStorage {
    function.def @compute(
        %earlier: !felt.type, %alternative: !felt.type, %final: !felt.type
    ) -> !struct.type<@OrderedStorage> {
      %self = struct.new : !struct.type<@OrderedStorage>
      function.return %self : !struct.type<@OrderedStorage>
    }

    function.def @constrain(
        %self: !struct.type<@OrderedStorage>,
        %earlier: !felt.type {function.arg_name = "earlier"},
        %alternative: !felt.type {function.arg_name = "alternative"},
        %final: !felt.type {function.arg_name = "final"}
    ) {
      %storage = pod.new : !pod.type<[@value: !felt.type]>
      %true = arith.constant true
      %selected = scf.if %true -> (!felt.type) {
        scf.yield %earlier : !felt.type
      } else {
        scf.yield %alternative : !felt.type
      }
      pod.write %storage[@value] = %selected
          : !pod.type<[@value: !felt.type]>, !felt.type
      pod.write %storage[@value] = %final
          : !pod.type<[@value: !felt.type]>, !felt.type
      %read = pod.read %storage[@value]
          : !pod.type<[@value: !felt.type]>, !felt.type
      %expected = felt.const 0
      constrain.eq %read, %expected : !felt.type
      function.return
    }
  }
}
// CHECK-LABEL: @OrderedStorage ConstraintDependencyGraph {
// CHECK-NEXT:      { final, <felt.const: 0> }
// CHECK-NEXT:  }

// -----

// AggregatePodInitializerRebasesNestedRecordDependencies
// A nested POD initializer retains the selected child and excludes its sibling.
module attributes {llzk.lang} {
  struct.def @NestedPodStorage {
    function.def @compute(%left: !felt.type, %right: !felt.type)
        -> !struct.type<@NestedPodStorage> {
      %self = struct.new : !struct.type<@NestedPodStorage>
      function.return %self : !struct.type<@NestedPodStorage>
    }

    function.def @constrain(
        %self: !struct.type<@NestedPodStorage>,
        %left: !felt.type {function.arg_name = "left"},
        %right: !felt.type {function.arg_name = "right"}
    ) {
      %inner = pod.new { @left = %left, @right = %right }
          : !pod.type<[@left: !felt.type, @right: !felt.type]>
      %outer = pod.new { @nested = %inner }
          : !pod.type<[@nested: !pod.type<[@left: !felt.type, @right: !felt.type]>]>
      %nested = pod.read %outer[@nested]
          : !pod.type<[@nested: !pod.type<[@left: !felt.type, @right: !felt.type]>]>,
            !pod.type<[@left: !felt.type, @right: !felt.type]>
      %read = pod.read %nested[@left]
          : !pod.type<[@left: !felt.type, @right: !felt.type]>, !felt.type
      %expected = felt.const 0
      constrain.eq %read, %expected : !felt.type
      function.return
    }
  }
}
// CHECK-LABEL: @NestedPodStorage ConstraintDependencyGraph {
// CHECK-NEXT:      { left, <felt.const: 0> }
// CHECK-NEXT:  }

// -----

// AggregateAliasesRebaseStorageOnlyFromTheirAssignmentPoint
// Assignment order wins over allocation order when replacing a nested POD.
module attributes {llzk.lang} {
  struct.def @OrderedAggregateAliases {
    function.def @compute(%aValue: !felt.type, %bValue: !felt.type)
        -> !struct.type<@OrderedAggregateAliases> {
      %self = struct.new : !struct.type<@OrderedAggregateAliases>
      function.return %self : !struct.type<@OrderedAggregateAliases>
    }

    function.def @constrain(
        %self: !struct.type<@OrderedAggregateAliases>,
        %aValue: !felt.type {function.arg_name = "aValue"},
        %bValue: !felt.type {function.arg_name = "bValue"}
    ) {
      %b = pod.new { @value = %bValue } : !pod.type<[@value: !felt.type]>
      %a = pod.new { @value = %aValue } : !pod.type<[@value: !felt.type]>
      %holder = pod.new { @nested = %a }
          : !pod.type<[@nested: !pod.type<[@value: !felt.type]>]>
      pod.write %holder[@nested] = %b
          : !pod.type<[@nested: !pod.type<[@value: !felt.type]>]>,
            !pod.type<[@value: !felt.type]>
      %nested = pod.read %holder[@nested]
          : !pod.type<[@nested: !pod.type<[@value: !felt.type]>]>,
            !pod.type<[@value: !felt.type]>
      %read = pod.read %nested[@value]
          : !pod.type<[@value: !felt.type]>, !felt.type
      %expected = felt.const 0
      constrain.eq %read, %expected : !felt.type
      function.return
    }
  }
}
// CHECK-LABEL: @OrderedAggregateAliases ConstraintDependencyGraph {
// CHECK-NEXT:      { bValue, <felt.const: 0> }
// CHECK-NEXT:  }

// -----

// StorageReadsResolveAtTheirProgramPoint
// A read keeps its original value when constrained after a later overwrite.
module attributes {llzk.lang} {
  struct.def @ReadBeforeWrite {
    function.def @compute(%initial: !felt.type, %replacement: !felt.type)
        -> !struct.type<@ReadBeforeWrite> {
      %self = struct.new : !struct.type<@ReadBeforeWrite>
      function.return %self : !struct.type<@ReadBeforeWrite>
    }

    function.def @constrain(
        %self: !struct.type<@ReadBeforeWrite>,
        %initial: !felt.type {function.arg_name = "initial"},
        %replacement: !felt.type {function.arg_name = "replacement"}
    ) {
      %storage = pod.new { @value = %initial } : !pod.type<[@value: !felt.type]>
      %before = pod.read %storage[@value]
          : !pod.type<[@value: !felt.type]>, !felt.type
      pod.write %storage[@value] = %replacement
          : !pod.type<[@value: !felt.type]>, !felt.type
      %expected = felt.const 0
      constrain.eq %before, %expected : !felt.type
      function.return
    }
  }
}
// CHECK-LABEL: @ReadBeforeWrite ConstraintDependencyGraph {
// CHECK-NEXT:      { initial, <felt.const: 0> }
// CHECK-NEXT:  }

// -----

// ArrayMutationsUpdateStorageDependencies (readUninitialized)
// A first write to an uninitialized array resolves to the written value.
module attributes {llzk.lang} {
  struct.def @ArrayMutationsReadUninitialized {
    function.def @compute(%uninitializedValue: !felt.type)
        -> !struct.type<@ArrayMutationsReadUninitialized> {
      %self = struct.new : !struct.type<@ArrayMutationsReadUninitialized>
      function.return %self : !struct.type<@ArrayMutationsReadUninitialized>
    }

    function.def @constrain(
        %self: !struct.type<@ArrayMutationsReadUninitialized>,
        %uninitializedValue: !felt.type {function.arg_name = "uninitializedValue"}
    ) {
      %c0 = arith.constant 0 : index
      %uninitialized = array.new : !array.type<1 x !felt.type>
      array.write %uninitialized[%c0] = %uninitializedValue
          : !array.type<1 x !felt.type>, !felt.type
      %readUninitialized = array.read %uninitialized[%c0]
          : !array.type<1 x !felt.type>, !felt.type
      %expected = felt.const 0
      constrain.eq %readUninitialized, %expected : !felt.type
      function.return
    }
  }
}
// CHECK-LABEL: @ArrayMutationsReadUninitialized ConstraintDependencyGraph {
// CHECK-NEXT:      { uninitializedValue, <felt.const: 0> }
// CHECK-NEXT:  }

// -----

// ArrayMutationsUpdateStorageDependencies (readOverwritten)
// An overwrite of an initialized array resolves to the replacement value.
module attributes {llzk.lang} {
  struct.def @ArrayMutationsReadOverwritten {
    function.def @compute(%initial: !felt.type, %replacement: !felt.type)
        -> !struct.type<@ArrayMutationsReadOverwritten> {
