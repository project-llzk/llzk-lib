    function.def @constrain(
        %self: !struct.type<@ArrayMutationsReadOverwritten>,
        %initial: !felt.type {function.arg_name = "initial"},
        %replacement: !felt.type {function.arg_name = "replacement"}
    ) {
      %c0 = arith.constant 0 : index
      %initialized = array.new %initial : !array.type<1 x !felt.type>
      array.write %initialized[%c0] = %replacement
          : !array.type<1 x !felt.type>, !felt.type
      %readOverwritten = array.read %initialized[%c0]
          : !array.type<1 x !felt.type>, !felt.type
      %expected = felt.const 0
      constrain.eq %readOverwritten, %expected : !felt.type
      function.return
    }
  }
}
// CHECK-LABEL: @ArrayMutationsReadOverwritten ConstraintDependencyGraph {
// CHECK-NEXT:      { replacement, <felt.const: 0> }
// CHECK-NEXT:  }

// -----

// RangedArrayReadPreservesUnwrittenStorageAfterPartialPointWrite
// An unknown-index read retains the written value and unwritten symbolic storage.
module attributes {llzk.lang} {
  poly.template @TPartialArrayWrite {
    poly.param @N : index

    struct.def @PartialArrayWrite {
      function.def @compute(%array: !array.type<@N x !felt.type>, %written: !felt.type)
          -> !struct.type<@TPartialArrayWrite::@PartialArrayWrite<[@N]>> {
        %self = struct.new : !struct.type<@TPartialArrayWrite::@PartialArrayWrite<[@N]>>
        function.return %self : !struct.type<@TPartialArrayWrite::@PartialArrayWrite<[@N]>>
      }

      function.def @constrain(
          %self: !struct.type<@TPartialArrayWrite::@PartialArrayWrite<[@N]>>,
          %array: !array.type<@N x !felt.type> {function.arg_name = "array"},
          %written: !felt.type {function.arg_name = "written"}
      ) {
        %c0 = arith.constant 0 : index
        array.write %array[%c0] = %written : !array.type<@N x !felt.type>, !felt.type
        %unknown = llzk.nondet : index
        %read = array.read %array[%unknown] : !array.type<@N x !felt.type>, !felt.type
        %expected = felt.const 0
        constrain.eq %read, %expected : !felt.type
        function.return
      }
    }
  }
}
// CHECK-LABEL: @TPartialArrayWrite::@PartialArrayWrite ConstraintDependencyGraph {
// CHECK-NEXT:      { array[<dynamic>], written },
// CHECK-NEXT:      { array[<dynamic>], <felt.const: 0> },
// CHECK-NEXT:      { written, <felt.const: 0> }
// CHECK-NEXT:  }

// -----

// StorageWritesResolveReadValuesBeforeLaterOverwrites
// A stored read keeps its value after the source storage is overwritten.
module attributes {llzk.lang} {
  struct.def @StorageWriteSnapshotsReadValue {
    function.def @compute(%initial: !felt.type, %replacement: !felt.type)
        -> !struct.type<@StorageWriteSnapshotsReadValue> {
      %self = struct.new : !struct.type<@StorageWriteSnapshotsReadValue>
      function.return %self : !struct.type<@StorageWriteSnapshotsReadValue>
    }

    function.def @constrain(
        %self: !struct.type<@StorageWriteSnapshotsReadValue>,
        %initial: !felt.type {function.arg_name = "initial"},
        %replacement: !felt.type {function.arg_name = "replacement"}
    ) {
      %c0 = arith.constant 0 : index
      %source = array.new %initial : !array.type<1 x !felt.type>
      %target = array.new : !array.type<1 x !felt.type>
      %readSource = array.read %source[%c0] : !array.type<1 x !felt.type>, !felt.type
      array.write %target[%c0] = %readSource : !array.type<1 x !felt.type>, !felt.type
      array.write %source[%c0] = %replacement : !array.type<1 x !felt.type>, !felt.type
      %readTarget = array.read %target[%c0] : !array.type<1 x !felt.type>, !felt.type
      %expected = felt.const 0
      constrain.eq %readTarget, %expected : !felt.type
      function.return
    }
  }
}
// CHECK-LABEL: @StorageWriteSnapshotsReadValue ConstraintDependencyGraph {
// CHECK-NEXT:      { initial, <felt.const: 0> }
// CHECK-NEXT:  }

// -----

// SkippedFirstStorageWritesPreserveUnwrittenDependencies (podRead)
// A conditional first write retains the original POD address as an alternative.
module attributes {llzk.lang} {
  struct.def @SkippedFirstStorageWritesPodRead {
    function.def @compute(%podValue: !felt.type)
        -> !struct.type<@SkippedFirstStorageWritesPodRead> {
      %self = struct.new : !struct.type<@SkippedFirstStorageWritesPodRead>
      function.return %self : !struct.type<@SkippedFirstStorageWritesPodRead>
    }

    function.def @constrain(
        %self: !struct.type<@SkippedFirstStorageWritesPodRead>,
        %podValue: !felt.type {function.arg_name = "podValue"}
    ) {
      %pod = pod.new : !pod.type<[@value: !felt.type]>
      %condition = arith.constant true
      scf.if %condition {
        pod.write %pod[@value] = %podValue
            : !pod.type<[@value: !felt.type]>, !felt.type
      }
      %podRead = pod.read %pod[@value] : !pod.type<[@value: !felt.type]>, !felt.type
      %expected = felt.const 0
      constrain.eq %podRead, %expected : !felt.type
      function.return
    }
  }
}
// CHECK-LABEL: @SkippedFirstStorageWritesPodRead ConstraintDependencyGraph {
// CHECK-NEXT:      { podValue, %pod.value },
// CHECK-NEXT:      { podValue, <felt.const: 0> },
// CHECK-NEXT:      { %pod.value, <felt.const: 0> }
// CHECK-NEXT:  }

