// CHECK-NEXT:     { input.arr[1], input.comp, expected }
// CHECK-NEXT: }
// INTRA-LABEL: @NamedPodCheck ConstraintDependencyGraph {
// INTRA-NEXT:     { input.arr[1], input.comp, expected }
// INTRA-NEXT: }
// -----

