!NamedPodInput = !pod.type<[@comp: !felt.type, @arr: !array.type<2 x !felt.type>]>

module attributes {llzk.lang} {
  struct.def @NamedPodCheck {
    function.def @compute(
      %arg0: !NamedPodInput {function.arg_name = "input"},
      %arg1: !felt.type {function.arg_name = "expected"}
    ) -> !struct.type<@NamedPodCheck> {
      %self = struct.new : !struct.type<@NamedPodCheck>
      function.return %self : !struct.type<@NamedPodCheck>
    }

    function.def @constrain(
      %arg0: !struct.type<@NamedPodCheck>,
      %arg1: !NamedPodInput {function.arg_name = "input"},
      %arg2: !felt.type {function.arg_name = "expected"}
    ) {
      %comp = pod.read %arg1[@comp] : !NamedPodInput, !felt.type
      %arr = pod.read %arg1[@arr] : !NamedPodInput, !array.type<2 x !felt.type>
      %idx = arith.constant 1 : index
      %elem = array.read %arr[%idx] : !array.type<2 x !felt.type>, !felt.type
      constrain.eq %comp, %arg2 : !felt.type
      constrain.eq %elem, %arg2 : !felt.type
      function.return
    }
  }
}

