module attributes {llzk.lang} {
  // Constrains arr[0] === @A and arr[2] === @B, leaving arr[1] unconstrained
  poly.template @TArrayConstrain {
    poly.param @A
    poly.param @B

    struct.def @ArrayConstrain {
      function.def @compute(%arr: !array.type<3 x !felt.type>) -> !struct.type<@TArrayConstrain::@ArrayConstrain<[@A, @B]>> {
        %self = struct.new : !struct.type<@TArrayConstrain::@ArrayConstrain<[@A, @B]>>
        function.return %self : !struct.type<@TArrayConstrain::@ArrayConstrain<[@A, @B]>>
      }

      function.def @constrain(%self: !struct.type<@TArrayConstrain::@ArrayConstrain<[@A, @B]>>, %arr: !array.type<3 x !felt.type>) {
        %const0 = poly.read_const @A : !felt.type
        %const2 = poly.read_const @B : !felt.type
        %0 = arith.constant 0 : index
        %2 = arith.constant 2 : index
        %elem0 = array.read %arr[%0] : !array.type<3 x !felt.type>, !felt.type
        %elem2 = array.read %arr[%2] : !array.type<3 x !felt.type>, !felt.type
        constrain.eq %elem0, %const0 : !felt.type
        constrain.eq %elem2, %const2 : !felt.type
        function.return
      }
    }
  }

  struct.def @MatrixConstrain {
    struct.member @check0 : !struct.type<@TArrayConstrain::@ArrayConstrain<[7, 11]>>
    struct.member @check1 : !struct.type<@TArrayConstrain::@ArrayConstrain<[13, 17]>>

    function.def @compute(%mat: !array.type<2,3 x !felt.type>) -> !struct.type<@MatrixConstrain> {
      %self = struct.new : !struct.type<@MatrixConstrain>
      function.return %self : !struct.type<@MatrixConstrain>
    }

    function.def @constrain(%self: !struct.type<@MatrixConstrain>, %mat: !array.type<2,3 x !felt.type>) {
      // split into two arrays and constrain each
      %check0 = struct.readm %self[@check0] : !struct.type<@MatrixConstrain>, !struct.type<@TArrayConstrain::@ArrayConstrain<[7, 11]>>
      %0 = arith.constant 0 : index
      %arr0 = array.extract %mat[%0] : !array.type<2,3 x !felt.type>
      function.call @TArrayConstrain::@ArrayConstrain::@constrain(%check0, %arr0) : (!struct.type<@TArrayConstrain::@ArrayConstrain<[7, 11]>>, !array.type<3 x !felt.type>) -> ()

      %check1 = struct.readm %self[@check1] : !struct.type<@MatrixConstrain>, !struct.type<@TArrayConstrain::@ArrayConstrain<[13, 17]>>
      %1 = arith.constant 1 : index
      %arr1 = array.extract %mat[%1] : !array.type<2,3 x !felt.type>
      function.call @TArrayConstrain::@ArrayConstrain::@constrain(%check1, %arr1) : (!struct.type<@TArrayConstrain::@ArrayConstrain<[13, 17]>>, !array.type<3 x !felt.type>) -> ()
      function.return
    }
  }
}

// COM: Propagation of template constants is not currently implemented and
// COM: should likely be relegated to a specialized transformation pass.
// CHECK-LABEL: @ArrayConstrain ConstraintDependencyGraph {
// CHECK-NEXT:     { %arg1[0], @ArrayConstrain<[@A]> },
// CHECK-NEXT:     { %arg1[2], @ArrayConstrain<[@B]> }
// CHECK-NEXT: }
// CHECK-NEXT: @MatrixConstrain ConstraintDependencyGraph {
// CHECK-NEXT:     { %arg1[0][0], @ArrayConstrain<[@A]> },
// CHECK-NEXT:     { %arg1[0][2], @ArrayConstrain<[@B]> },
// CHECK-NEXT:     { %arg1[1][0], @ArrayConstrain<[@A]> },
// CHECK-NEXT:     { %arg1[1][2], @ArrayConstrain<[@B]> }
// CHECK-NEXT: }
// INTRA-LABEL: @ArrayConstrain ConstraintDependencyGraph {
// INTRA-NEXT:     { %arg1[0], @ArrayConstrain<[@A]> },
// INTRA-NEXT:     { %arg1[2], @ArrayConstrain<[@B]> }
// INTRA-NEXT: }
// INTRA-NEXT: @MatrixConstrain ConstraintDependencyGraph { }
// -----

module attributes {llzk.lang} {
  // Constrains arr[1] === 7, leaving other indices unconstrained
  struct.def @ArrayConstrain {
    function.def @compute(%arr: !array.type<3 x !felt.type>) -> !struct.type<@ArrayConstrain> {
      %self = struct.new : !struct.type<@ArrayConstrain>
      function.return %self : !struct.type<@ArrayConstrain>
    }

    function.def @constrain(%self: !struct.type<@ArrayConstrain>, %arr: !array.type<3 x !felt.type>) {
      %const = felt.const 7
      %1 = arith.constant 1 : index
      %elem = array.read %arr[%1] : !array.type<3 x !felt.type>, !felt.type
      constrain.eq %elem, %const : !felt.type
      function.return
    }
  }

  struct.def @MatrixConstrain {
    struct.member @check : !struct.type<@ArrayConstrain>

    struct.member @a : !felt.type
    struct.member @b : !felt.type
    struct.member @c : !felt.type
    struct.member @d : !felt.type
    struct.member @e : !felt.type
    struct.member @f : !felt.type

    function.def @compute() -> !struct.type<@MatrixConstrain> {
      %self = struct.new : !struct.type<@MatrixConstrain>
      function.return %self : !struct.type<@MatrixConstrain>
    }

    function.def @constrain(%self: !struct.type<@MatrixConstrain>) {
      %a = struct.readm %self[@a] : !struct.type<@MatrixConstrain>, !felt.type
      %b = struct.readm %self[@b] : !struct.type<@MatrixConstrain>, !felt.type
      %c = struct.readm %self[@c] : !struct.type<@MatrixConstrain>, !felt.type
      %d = struct.readm %self[@d] : !struct.type<@MatrixConstrain>, !felt.type
      %e = struct.readm %self[@e] : !struct.type<@MatrixConstrain>, !felt.type
      %f = struct.readm %self[@f] : !struct.type<@MatrixConstrain>, !felt.type

      %mat = array.new %a, %b, %c, %d, %e, %f : !array.type<2,3 x !felt.type>

      %check = struct.readm %self[@check] : !struct.type<@MatrixConstrain>, !struct.type<@ArrayConstrain>
      %0 = arith.constant 0 : index
      %arr = array.extract %mat[%0] : !array.type<2,3 x !felt.type>
      function.call @ArrayConstrain::@constrain(%check, %arr) : (!struct.type<@ArrayConstrain>, !array.type<3 x !felt.type>) -> ()

      function.return
    }
  }
}

