          %13 = struct.readm %arg0[@"$temp"] : <@TFoo::@Foo<[@N]>>, !array.type<#map x !felt.type>
          %14 = struct.readm %arg0[@"$temp"] : <@TFoo::@Foo<[@N]>>, !array.type<#map x !felt.type>
