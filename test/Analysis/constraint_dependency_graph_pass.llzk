        }
        %7 = poly.read_const @N : index
        %array_2 = array.new{()[%7]} : <#map x !felt.type>
        %8 = array.len %array_1, %c0 : <#map x !felt.type>
        scf.for %arg1 = %c0 to %8 step %c1 {
          %10 = array.read %array_1[%arg1] : <#map x !felt.type>, !felt.type
          %11 = cast.toindex %10
          %12 = array.read %5[%11] : <#map x !felt.type>, !felt.type
          %16 = struct.readm %self[@"$temp_0"] : <@TFoo::@Foo<[@N]>>, !array.type<#map x !felt.type>
          array.write %16[%arg1] = %12 : <#map x !felt.type>, !felt.type
          struct.writem %self[@"$temp_0"] = %16 : <@TFoo::@Foo<[@N]>>, !array.type<#map x !felt.type>
          %17 = struct.readm %self[@"$temp_0"] : <@TFoo::@Foo<[@N]>>, !array.type<#map x !felt.type>
          %18 = array.read %17[%arg1] : <#map x !felt.type>, !felt.type
