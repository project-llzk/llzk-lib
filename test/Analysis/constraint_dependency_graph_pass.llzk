        %2 = poly.read_const @N : index
        scf.for %arg1 = %c0 to %2 step %c1 {
          %10 = cast.tofelt %arg1 : index
          array.write %array[%arg1] = %10 : <#map x !felt.type>, !felt.type
        }
        %3 = poly.read_const @N : index
        %array_0 = array.new{()[%3]} : <#map x !felt.type>
        %4 = array.len %array, %c0 : <#map x !felt.type>
        scf.for %arg1 = %c0 to %4 step %c1 {
          %10 = array.read %array[%arg1] : <#map x !felt.type>, !felt.type
          %11 = cast.toindex %10
          %12 = array.read %arg0[%11] : <@N x !felt.type>, !felt.type
          %14 = struct.readm %self[@"$temp"] : <@TFoo::@Foo<[@N]>>, !array.type<#map x !felt.type>
          array.write %14[%arg1] = %12 : <#map x !felt.type>, !felt.type
          struct.writem %self[@"$temp"] = %14 : <@TFoo::@Foo<[@N]>>, !array.type<#map x !felt.type>
          %15 = struct.readm %self[@"$temp"] : <@TFoo::@Foo<[@N]>>, !array.type<#map x !felt.type>
          %16 = array.read %15[%arg1] : <#map x !felt.type>, !felt.type
          array.write %array_0[%arg1] = %16 : <#map x !felt.type>, !felt.type
        } {original_op = "map"}
        struct.writem %self[@internal] = %array_0 : <@TFoo::@Foo<[@N]>>, !array.type<#map x !felt.type>
        %5 = struct.readm %self[@internal] : <@TFoo::@Foo<[@N]>>, !array.type<#map x !felt.type>
        %6 = poly.read_const @N : index
