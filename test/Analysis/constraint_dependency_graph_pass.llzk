module attributes {llzk.lang} {
  struct.def @NamedStructMemberInput {
    struct.member @lhs : !felt.type {llzk.pub}
    struct.member @rhs : !felt.type {llzk.pub}

    function.def @compute(%lhs: !felt.type, %rhs: !felt.type) -> !struct.type<@NamedStructMemberInput> {
      %self = struct.new : !struct.type<@NamedStructMemberInput>
      struct.writem %self[@lhs] = %lhs : !struct.type<@NamedStructMemberInput>, !felt.type
      struct.writem %self[@rhs] = %rhs : !struct.type<@NamedStructMemberInput>, !felt.type
      function.return %self : !struct.type<@NamedStructMemberInput>
    }

    function.def @constrain(%self: !struct.type<@NamedStructMemberInput>, %lhs: !felt.type, %rhs: !felt.type) {
      function.return
    }
  }

  struct.def @NamedStructMemberCheck {
    function.def @compute(
      %arg0: !struct.type<@NamedStructMemberInput> {function.arg_name = "input"},
      %arg1: !felt.type {function.arg_name = "expected"}
    ) -> !struct.type<@NamedStructMemberCheck> {
      %self = struct.new : !struct.type<@NamedStructMemberCheck>
      function.return %self : !struct.type<@NamedStructMemberCheck>
    }

    function.def @constrain(
      %arg0: !struct.type<@NamedStructMemberCheck>,
      %arg1: !struct.type<@NamedStructMemberInput> {function.arg_name = "input"},
      %arg2: !felt.type {function.arg_name = "expected"}
    ) {
      %lhs = struct.readm %arg1[@lhs] : !struct.type<@NamedStructMemberInput>, !felt.type
      constrain.eq %lhs, %arg2 : !felt.type
      function.return
    }
  }
}

