// CHECK-LABEL: @ConstructedSameElement SSAIntervals {
// CHECK:          %[[VAL_6:[0-9a-zA-Z_.-]+]] [struct.readm] in TypeA:[ 7, 9 ]
// CHECK:          %[[VAL_7:[0-9a-zA-Z_.-]+]] [struct.readm] in TypeA:[ 7, 9 ]

// -----

// Reusing one value from an ambiguous selection still permits decomposition.
module attributes {llzk.lang} {
  struct.def @Cell {
    struct.member @value : !felt.type {llzk.pub}
    function.def @compute() -> !struct.type<@Cell> {
