// Direct felt-array reads across a dynamic-index overwrite can hold different values.
module attributes {llzk.lang} {
  struct.def @FeltOverlappingWrite {
    function.def @product(%array: !array.type<2 x !felt.type>, %i: index, %replacement: !felt.type) -> !struct.type<@FeltOverlappingWrite> {
      %self = struct.new : !struct.type<@FeltOverlappingWrite>
      %zero = felt.const 0
      %seven = felt.const 7
      %nine = felt.const 9
      %x = array.read %array[%i] : !array.type<2 x !felt.type>, !felt.type
      array.write %array[%i] = %replacement : !array.type<2 x !felt.type>, !felt.type
      %y = array.read %array[%i] : !array.type<2 x !felt.type>, !felt.type
      %xMinusSeven = felt.sub %x, %seven
      %yMinusNine = felt.sub %y, %nine
      %product = felt.mul %xMinusSeven, %yMinusNine
      constrain.eq %product, %zero : !felt.type
      function.return %self : !struct.type<@FeltOverlappingWrite>
    }
  }
}

