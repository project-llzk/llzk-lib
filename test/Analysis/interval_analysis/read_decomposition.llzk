// CHECK-LABEL: @SameDynamicIndex SSAIntervals {
// CHECK:          %[[VAL_6:[0-9a-zA-Z_.-]+]] [struct.readm] in TypeA:[ 7, 9 ]
// CHECK:          %[[VAL_7:[0-9a-zA-Z_.-]+]] [struct.readm] in TypeA:[ 7, 9 ]

// -----

// Reading twice through one aggregate handle preserves the decomposition bounds.
module attributes {llzk.lang} {
  struct.def @Cell {
    struct.member @value : !felt.type {llzk.pub}
    function.def @compute() -> !struct.type<@Cell> {
      %self = struct.new : !struct.type<@Cell>
      function.return %self : !struct.type<@Cell>
    }
    function.def @constrain(%self: !struct.type<@Cell>) {
      function.return
    }
  }
  struct.def @SameAggregateHandle {
    function.def @product(%array: !array.type<2 x !struct.type<@Cell>>, %i: index, %j: index, %replacement: !struct.type<@Cell>) -> !struct.type<@SameAggregateHandle> {
      %self = struct.new : !struct.type<@SameAggregateHandle>
      %index = arith.constant 0 : index
      %zero = felt.const 0
      %seven = felt.const 7
      %nine = felt.const 9
      %left = array.read %array[%i] : !array.type<2 x !struct.type<@Cell>>, !struct.type<@Cell>
      %right = array.read %array[%j] : !array.type<2 x !struct.type<@Cell>>, !struct.type<@Cell>
      %x = struct.readm %left[@value] : !struct.type<@Cell>, !felt.type
      %y = struct.readm %left[@value] : !struct.type<@Cell>, !felt.type
      %xMinusSeven = felt.sub %x, %seven
      %yMinusNine = felt.sub %y, %nine
      %product = felt.mul %xMinusSeven, %yMinusNine
      constrain.eq %product, %zero : !felt.type
      function.return %self : !struct.type<@SameAggregateHandle>
    }
  }
}

// CHECK-LABEL: @SameAggregateHandle SSAIntervals {
// CHECK:          %[[VAL_6:[0-9a-zA-Z_.-]+]] [struct.readm] in TypeA:[ 7, 9 ]
// CHECK:          %[[VAL_7:[0-9a-zA-Z_.-]+]] [struct.readm] in TypeA:[ 7, 9 ]

// -----

// A potentially overlapping write prevents equality between the two reads.
module attributes {llzk.lang} {
  struct.def @Cell {
    struct.member @value : !felt.type {llzk.pub}
    function.def @compute() -> !struct.type<@Cell> {
      %self = struct.new : !struct.type<@Cell>
      function.return %self : !struct.type<@Cell>
    }
    function.def @constrain(%self: !struct.type<@Cell>) {
      function.return
    }
  }
  struct.def @OverlappingWrite {
    function.def @product(%array: !array.type<2 x !struct.type<@Cell>>, %i: index, %j: index, %replacement: !struct.type<@Cell>) -> !struct.type<@OverlappingWrite> {
      %self = struct.new : !struct.type<@OverlappingWrite>
      %index = arith.constant 0 : index
      %zero = felt.const 0
      %seven = felt.const 7
      %nine = felt.const 9
      %left = array.read %array[%i] : !array.type<2 x !struct.type<@Cell>>, !struct.type<@Cell>
      array.write %array[%i] = %replacement : !array.type<2 x !struct.type<@Cell>>, !struct.type<@Cell>
      %right = array.read %array[%i] : !array.type<2 x !struct.type<@Cell>>, !struct.type<@Cell>
      %x = struct.readm %left[@value] : !struct.type<@Cell>, !felt.type
      %y = struct.readm %right[@value] : !struct.type<@Cell>, !felt.type
      %xMinusSeven = felt.sub %x, %seven
      %yMinusNine = felt.sub %y, %nine
      %product = felt.mul %xMinusSeven, %yMinusNine
      constrain.eq %product, %zero : !felt.type
      function.return %self : !struct.type<@OverlappingWrite>
    }
  }
}

// CHECK-LABEL: @OverlappingWrite SSAIntervals {
// CHECK:          %[[VAL_6:[0-9a-zA-Z_.-]+]] [struct.readm] in Entire
// CHECK:          %[[VAL_7:[0-9a-zA-Z_.-]+]] [struct.readm] in Entire

// -----

// A write to fresh array storage preserves repeated array-read identity.
module attributes {llzk.lang} {
  struct.def @Cell {
    struct.member @value : !felt.type {llzk.pub}
    function.def @compute() -> !struct.type<@Cell> {
      %self = struct.new : !struct.type<@Cell>
      function.return %self : !struct.type<@Cell>
    }
    function.def @constrain(%self: !struct.type<@Cell>) {
      function.return
    }
  }
  struct.def @DisjointArrayWrite {
    function.def @product(%array: !array.type<2 x !struct.type<@Cell>>, %i: index, %j: index, %replacement: !struct.type<@Cell>) -> !struct.type<@DisjointArrayWrite> {
      %self = struct.new : !struct.type<@DisjointArrayWrite>
      %index = arith.constant 0 : index
      %zero = felt.const 0
      %seven = felt.const 7
      %nine = felt.const 9
      %left = array.read %array[%i] : !array.type<2 x !struct.type<@Cell>>, !struct.type<@Cell>
      %scratch = array.new : !array.type<2 x !felt.type>
      array.write %scratch[%i] = %seven : !array.type<2 x !felt.type>, !felt.type
      %right = array.read %array[%i] : !array.type<2 x !struct.type<@Cell>>, !struct.type<@Cell>
      %x = struct.readm %left[@value] : !struct.type<@Cell>, !felt.type
      %y = struct.readm %right[@value] : !struct.type<@Cell>, !felt.type
      %xMinusSeven = felt.sub %x, %seven
      %yMinusNine = felt.sub %y, %nine
      %product = felt.mul %xMinusSeven, %yMinusNine
      constrain.eq %product, %zero : !felt.type
      function.return %self : !struct.type<@DisjointArrayWrite>
    }
  }
}

