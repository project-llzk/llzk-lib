// A write to the same constant index must preserve the valid witness x = 11, y = 9.
module attributes {llzk.lang} {
  struct.def @Cell {
    struct.member @value : !felt.type {llzk.pub}
    function.def @compute() -> !struct.type<@Cell> {
      %self = struct.new : !struct.type<@Cell>
      function.return %self : !struct.type<@Cell>
    }
    function.def @constrain(%self: !struct.type<@Cell>) {
      function.return
    }
  }
  struct.def @ConcreteSameElementWrite {
    function.def @product(%array: !array.type<2 x !struct.type<@Cell>>, %replacement: !struct.type<@Cell>) -> !struct.type<@ConcreteSameElementWrite> {
      %self = struct.new : !struct.type<@ConcreteSameElementWrite>
      %index = arith.constant 0 : index
      %zero = felt.const 0
      %seven = felt.const 7
      %nine = felt.const 9
      %left = array.read %array[%index] : !array.type<2 x !struct.type<@Cell>>, !struct.type<@Cell>
      array.write %array[%index] = %replacement : !array.type<2 x !struct.type<@Cell>>, !struct.type<@Cell>
      %right = array.read %array[%index] : !array.type<2 x !struct.type<@Cell>>, !struct.type<@Cell>
      %x = struct.readm %left[@value] : !struct.type<@Cell>, !felt.type
      %y = struct.readm %right[@value] : !struct.type<@Cell>, !felt.type
      %xMinusSeven = felt.sub %x, %seven
      %yMinusNine = felt.sub %y, %nine
      %product = felt.mul %xMinusSeven, %yMinusNine
      constrain.eq %product, %zero : !felt.type
      function.return %self : !struct.type<@ConcreteSameElementWrite>
    }
  }
}

