// RUN: llzk-opt -split-input-file -llzk-print-interval-analysis="field=babybear print-compute-intervals print-ssa-intervals" %s -o /dev/null 2>&1 | FileCheck %s --match-full-lines --implicit-check-not=error:

// Independent selections can satisfy the product with x = 11 and y = 9.
module attributes {llzk.lang} {
  struct.def @Cell {
    struct.member @value : !felt.type {llzk.pub}
    function.def @compute() -> !struct.type<@Cell> {
      %self = struct.new : !struct.type<@Cell>
      function.return %self : !struct.type<@Cell>
    }
    function.def @constrain(%self: !struct.type<@Cell>) {
      function.return
    }
  }
  struct.def @IndependentSelections {
    function.def @product(%array: !array.type<2 x !struct.type<@Cell>>, %i: index, %j: index) -> !struct.type<@IndependentSelections> {
      %self = struct.new : !struct.type<@IndependentSelections>
      %index = arith.constant 0 : index
      %zero = felt.const 0
      %seven = felt.const 7
      %nine = felt.const 9
      %left = array.read %array[%i] : !array.type<2 x !struct.type<@Cell>>, !struct.type<@Cell>
      %right = array.read %array[%j] : !array.type<2 x !struct.type<@Cell>>, !struct.type<@Cell>
      %x = struct.readm %left[@value] : !struct.type<@Cell>, !felt.type
      %y = struct.readm %right[@value] : !struct.type<@Cell>, !felt.type
      %xMinusSeven = felt.sub %x, %seven
      %yMinusNine = felt.sub %y, %nine
      %product = felt.mul %xMinusSeven, %yMinusNine
      constrain.eq %product, %zero : !felt.type
      function.return %self : !struct.type<@IndependentSelections>
    }
  }
}

// CHECK-LABEL: @IndependentSelections SSAIntervals {
// CHECK-NEXT:      product {
// CHECK-NEXT:          %[[VAL_0:[0-9a-zA-Z_.-]+]] in Entire
// CHECK-NEXT:          %[[VAL_1:[0-9a-zA-Z_.-]+]] in Entire
// CHECK-NEXT:          %[[VAL_2:[0-9a-zA-Z_.-]+]] [arith.constant] in Degenerate(0)
// CHECK-NEXT:          %[[VAL_3:[0-9a-zA-Z_.-]+]] [felt.const] in Degenerate(0)
// CHECK-NEXT:          %[[VAL_4:[0-9a-zA-Z_.-]+]] [felt.const] in Degenerate(7)
// CHECK-NEXT:          %[[VAL_5:[0-9a-zA-Z_.-]+]] [felt.const] in Degenerate(9)
// CHECK-NEXT:          %[[VAL_6:[0-9a-zA-Z_.-]+]] [struct.readm] in Entire
// CHECK-NEXT:          %[[VAL_7:[0-9a-zA-Z_.-]+]] [struct.readm] in Entire
// CHECK-NEXT:          %[[VAL_8:[0-9a-zA-Z_.-]+]] [felt.sub] in Entire
// CHECK-NEXT:          %[[VAL_9:[0-9a-zA-Z_.-]+]] [felt.sub] in Entire
// CHECK-NEXT:          %[[VAL_10:[0-9a-zA-Z_.-]+]] [felt.mul] in Degenerate(0)
// CHECK-NEXT:      }
// CHECK-NEXT:  }

