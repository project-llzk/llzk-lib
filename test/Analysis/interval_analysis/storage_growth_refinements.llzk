// RUN: llzk-opt -split-input-file -llzk-print-interval-analysis="field=babybear print-compute-intervals print-ssa-intervals print-unreduced-intervals" %s -o /dev/null 2>&1 | FileCheck %s --match-full-lines --implicit-check-not=error:

// Backward bounds must include every write: read [7,11], sum 20, input [9,13].
// The final write precedes the read and constraints.
module attributes {llzk.lang} {
  struct.def @GrowthBeforeRead {
    function.def @product(%array: !array.type<1 x !felt.type>, %condition: i1, %input: !felt.type) -> !struct.type<@GrowthBeforeRead>
        attributes {function.allow_constraint} {
      %self = struct.new : !struct.type<@GrowthBeforeRead>
      %zero = arith.constant 0 : index
      %seven = felt.const 7
      %nine = felt.const 9
      %eleven = felt.const 11
      %twenty = felt.const 20
      scf.if %condition {
        array.write %array[%zero] = %seven : !array.type<1 x !felt.type>, !felt.type
      }
      array.write %array[%zero] = %nine : !array.type<1 x !felt.type>, !felt.type
      scf.if %condition {
        array.write %array[%zero] = %eleven : !array.type<1 x !felt.type>, !felt.type
      }
      %read = array.read %array[%zero] : !array.type<1 x !felt.type>, !felt.type
      %sum = felt.add %read, %input
      constrain.eq %sum, %twenty : !felt.type
      function.return %self : !struct.type<@GrowthBeforeRead>
    }
  }
}

// CHECK-LABEL: @GrowthBeforeRead StructIntervals { }
// CHECK-LABEL: @GrowthBeforeRead SSAIntervals {
// CHECK-NEXT:      product {
// CHECK-NEXT:          %[[VAL_0:[0-9a-zA-Z_.-]+]] in Entire
// CHECK-NEXT:          %[[VAL_1:[0-9a-zA-Z_.-]+]] in TypeA:[ 9, 13 ]
// CHECK-NEXT:          %[[VAL_2:[0-9a-zA-Z_.-]+]] [arith.constant] in Degenerate(0) ( unreduced: Unreduced:[ 0, 0 ] )
// CHECK-NEXT:          %[[VAL_3:[0-9a-zA-Z_.-]+]] [felt.const] in Degenerate(7) ( unreduced: Unreduced:[ 7, 7 ] )
// CHECK-NEXT:          %[[VAL_4:[0-9a-zA-Z_.-]+]] [felt.const] in Degenerate(9) ( unreduced: Unreduced:[ 9, 9 ] )
// CHECK-NEXT:          %[[VAL_5:[0-9a-zA-Z_.-]+]] [felt.const] in Degenerate(11) ( unreduced: Unreduced:[ 11, 11 ] )
// CHECK-NEXT:          %[[VAL_6:[0-9a-zA-Z_.-]+]] [felt.const] in Degenerate(20) ( unreduced: Unreduced:[ 20, 20 ] )
// CHECK-NEXT:          %[[VAL_7:[0-9a-zA-Z_.-]+]] [array.read] in TypeA:[ 7, 11 ] ( unreduced: Unreduced:[ 7, 11 ] )
// CHECK-NEXT:          %[[VAL_8:[0-9a-zA-Z_.-]+]] [felt.add] in Degenerate(20)
// CHECK-NEXT:      }
// CHECK-NEXT:  }

// -----

// Backward bounds must include every write: read [7,11], sum 20, input [9,13].
// The final write follows the read and constraints.
module attributes {llzk.lang} {
  struct.def @GrowthAfterConstraints {
    function.def @product(%array: !array.type<1 x !felt.type>, %condition: i1, %input: !felt.type) -> !struct.type<@GrowthAfterConstraints>
        attributes {function.allow_constraint} {
      %self = struct.new : !struct.type<@GrowthAfterConstraints>
      %zero = arith.constant 0 : index
      %seven = felt.const 7
      %nine = felt.const 9
      %eleven = felt.const 11
      %twenty = felt.const 20
      scf.if %condition {
        array.write %array[%zero] = %seven : !array.type<1 x !felt.type>, !felt.type
      }
      array.write %array[%zero] = %nine : !array.type<1 x !felt.type>, !felt.type
      %read = array.read %array[%zero] : !array.type<1 x !felt.type>, !felt.type
      %sum = felt.add %read, %input
      constrain.eq %sum, %twenty : !felt.type
      scf.if %condition {
        array.write %array[%zero] = %eleven : !array.type<1 x !felt.type>, !felt.type
      }
      function.return %self : !struct.type<@GrowthAfterConstraints>
    }
  }
}

// CHECK-LABEL: @GrowthAfterConstraints StructIntervals { }
// CHECK-LABEL: @GrowthAfterConstraints SSAIntervals {
// CHECK-NEXT:      product {
// CHECK-NEXT:          %[[VAL_0:[0-9a-zA-Z_.-]+]] in Entire
// CHECK-NEXT:          %[[VAL_1:[0-9a-zA-Z_.-]+]] in TypeA:[ 9, 13 ]
// CHECK-NEXT:          %[[VAL_2:[0-9a-zA-Z_.-]+]] [arith.constant] in Degenerate(0) ( unreduced: Unreduced:[ 0, 0 ] )
// CHECK-NEXT:          %[[VAL_3:[0-9a-zA-Z_.-]+]] [felt.const] in Degenerate(7) ( unreduced: Unreduced:[ 7, 7 ] )
// CHECK-NEXT:          %[[VAL_4:[0-9a-zA-Z_.-]+]] [felt.const] in Degenerate(9) ( unreduced: Unreduced:[ 9, 9 ] )
// CHECK-NEXT:          %[[VAL_5:[0-9a-zA-Z_.-]+]] [felt.const] in Degenerate(11) ( unreduced: Unreduced:[ 11, 11 ] )
// CHECK-NEXT:          %[[VAL_6:[0-9a-zA-Z_.-]+]] [felt.const] in Degenerate(20) ( unreduced: Unreduced:[ 20, 20 ] )
// CHECK-NEXT:          %[[VAL_7:[0-9a-zA-Z_.-]+]] [array.read] in TypeA:[ 7, 11 ] ( unreduced: Unreduced:[ 7, 11 ] )
// CHECK-NEXT:          %[[VAL_8:[0-9a-zA-Z_.-]+]] [felt.add] in Degenerate(20)
// CHECK-NEXT:      }
// CHECK-NEXT:  }

