// A copied handle keeps its component despite a later source-slot overwrite.
module attributes {llzk.lang} {
  struct.def @Cell {
    struct.member @value : !felt.type {llzk.pub}
    function.def @compute() -> !struct.type<@Cell> {
      %self = struct.new : !struct.type<@Cell>
      function.return %self : !struct.type<@Cell>
    }
    function.def @constrain(%self: !struct.type<@Cell>) { function.return }
  }
  poly.template @Arrays {
    poly.param @N : index
    struct.def @SymbolicCopyStructHandles {
      function.def @compute(%source: !array.type<@N x !struct.type<@Cell>>, %first: !struct.type<@Cell>, %second: !struct.type<@Cell>) -> !struct.type<@Arrays::@SymbolicCopyStructHandles<[@N]>> {
        %self = struct.new : !struct.type<@Arrays::@SymbolicCopyStructHandles<[@N]>>
        function.return %self : !struct.type<@Arrays::@SymbolicCopyStructHandles<[@N]>>
      }
      function.def @constrain(
          %self: !struct.type<@Arrays::@SymbolicCopyStructHandles<[@N]>>,
          %source: !array.type<@N x !struct.type<@Cell>> {function.arg_name = "source"},
          %first: !struct.type<@Cell> {function.arg_name = "first"},
          %second: !struct.type<@Cell> {function.arg_name = "second"}
      ) {
        %c0 = arith.constant 0 : index
        %c1 = arith.constant 1 : index
        array.write %source[%c0] = %first : !array.type<@N x !struct.type<@Cell>>, !struct.type<@Cell>
        array.write %source[%c1] = %second : !array.type<@N x !struct.type<@Cell>>, !struct.type<@Cell>
        %holder = pod.new { @saved = %source } : !pod.type<[@saved: !array.type<@N x !struct.type<@Cell>>]>
        %copy = pod.read %holder[@saved] : !pod.type<[@saved: !array.type<@N x !struct.type<@Cell>>]>, !array.type<@N x !struct.type<@Cell>>
        array.write %source[%c1] = %first : !array.type<@N x !struct.type<@Cell>>, !struct.type<@Cell>
        %selected = array.read %copy[%c1] : !array.type<@N x !struct.type<@Cell>>, !struct.type<@Cell>
        %observed = struct.readm %selected[@value] : !struct.type<@Cell>, !felt.type
        %zero = felt.const 0
        constrain.eq %observed, %zero : !felt.type
        function.return
      }
    }
  }
}

