  poly.template @Arrays {
    poly.param @N : index
    struct.def @SymbolicCopyUnknownSourceWrite {
      function.def @compute(%source: !array.type<@N x !felt.type>, %a: !felt.type, %i: index) -> !struct.type<@Arrays::@SymbolicCopyUnknownSourceWrite<[@N]>> {
