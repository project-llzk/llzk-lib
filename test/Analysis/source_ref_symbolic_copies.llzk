// Scalar callers refresh when the source contents of an unchanged deferred return become known.
module attributes {llzk.lang} {
  poly.template @Arrays {
    poly.param @N : index
    struct.def @SymbolicForwardScalarObserver {
      function.def @compute(%source: !array.type<@N x !felt.type>, %b: !felt.type) -> !struct.type<@Arrays::@SymbolicForwardScalarObserver<[@N]>> {
        %self = struct.new : !struct.type<@Arrays::@SymbolicForwardScalarObserver<[@N]>>
        function.return %self : !struct.type<@Arrays::@SymbolicForwardScalarObserver<[@N]>>
      }
      function.def @constrain(
          %self: !struct.type<@Arrays::@SymbolicForwardScalarObserver<[@N]>>,
          %source: !array.type<@N x !felt.type> {function.arg_name = "source"},
          %b: !felt.type {function.arg_name = "b"}
      ) {
        %c0 = arith.constant 0 : index
        %c1 = arith.constant 1 : index
        %observed = function.call @Arrays::@observe(%source, %b) : (!array.type<@N x !felt.type>, !felt.type) -> !felt.type
        %zero = felt.const 0
        constrain.eq %observed, %zero : !felt.type
        function.return
      }
    }
    function.def @observe(%input: !array.type<@N x !felt.type>, %value: !felt.type) -> !felt.type {
      %copy = function.call @Arrays::@make(%input, %value) : (!array.type<@N x !felt.type>, !felt.type) -> !array.type<@N x !felt.type>
      %c1 = arith.constant 1 : index
      %read = array.read %copy[%c1] : !array.type<@N x !felt.type>, !felt.type
      function.return %read : !felt.type
    }
    function.def @make(%input: !array.type<@N x !felt.type>, %value: !felt.type) -> !array.type<@N x !felt.type> {
      %c1 = arith.constant 1 : index
      array.write %input[%c1] = %value : !array.type<@N x !felt.type>, !felt.type
      function.return %input : !array.type<@N x !felt.type>
    }
  }
}

// CHECK-LABEL: @Arrays::@SymbolicForwardScalarObserver ConstraintDependencyGraph {
// CHECK-NEXT:      { b, <felt.const: 0> }
// CHECK-NEXT:  }
