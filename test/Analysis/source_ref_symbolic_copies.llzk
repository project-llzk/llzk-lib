// RUN: llzk-opt -split-input-file -llzk-print-constraint-dependency-graphs %s -o /dev/null 2>&1 | FileCheck --match-full-lines %s
// RUN: llzk-opt -split-input-file -llzk-print-constraint-dependency-graphs="intraprocedural" %s -o /dev/null 2>&1 | FileCheck --match-full-lines %s

// A symbolic copy preserves the correspondence between individual elements.
// Separate modules keep unrelated observations from hiding extra dependencies.
module attributes {llzk.lang} {
  poly.template @Arrays {
    poly.param @N : index
    struct.def @SymbolicCopyUnwrittenElement {
      function.def @compute(%source: !array.type<@N x !felt.type>, %a: !felt.type)
          -> !struct.type<@Arrays::@SymbolicCopyUnwrittenElement<[@N]>> {
        %self = struct.new : !struct.type<@Arrays::@SymbolicCopyUnwrittenElement<[@N]>>
        function.return %self : !struct.type<@Arrays::@SymbolicCopyUnwrittenElement<[@N]>>
      }
      function.def @constrain(
          %self: !struct.type<@Arrays::@SymbolicCopyUnwrittenElement<[@N]>>,
          %source: !array.type<@N x !felt.type> {function.arg_name = "source"},
          %a: !felt.type {function.arg_name = "a"}
      ) {
        %c0 = arith.constant 0 : index
        %c1 = arith.constant 1 : index
        array.write %source[%c0] = %a : <@N x !felt.type>, !felt.type
        %holder = pod.new { @saved = %source } : !pod.type<[@saved: !array.type<@N x !felt.type>]>
        %copy = pod.read %holder[@saved] : !pod.type<[@saved: !array.type<@N x !felt.type>]>, !array.type<@N x !felt.type>
        %observed = array.read %copy[%c1] : <@N x !felt.type>, !felt.type
        %zero = felt.const 0
        constrain.eq %observed, %zero : !felt.type
        function.return
      }
    }
  }
}

// CHECK-LABEL: @Arrays::@SymbolicCopyUnwrittenElement ConstraintDependencyGraph {
// CHECK-NEXT:      { source[1], <felt.const: 0> }
// CHECK-NEXT:  }

