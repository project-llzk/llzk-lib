// A forward-defined helper copies a locally modified array through POD storage.
module attributes {llzk.lang} {
  poly.template @Arrays {
    poly.param @N : index
    struct.def @SymbolicCalleeStorageCopy {
      function.def @compute(%source: !array.type<@N x !felt.type>, %a: !felt.type, %b: !felt.type, %later: !felt.type) -> !struct.type<@Arrays::@SymbolicCalleeStorageCopy<[@N]>> {
        %self = struct.new : !struct.type<@Arrays::@SymbolicCalleeStorageCopy<[@N]>>
        function.return %self : !struct.type<@Arrays::@SymbolicCalleeStorageCopy<[@N]>>
      }
      function.def @constrain(
          %self: !struct.type<@Arrays::@SymbolicCalleeStorageCopy<[@N]>>,
          %source: !array.type<@N x !felt.type> {function.arg_name = "source"},
          %a: !felt.type {function.arg_name = "a"},
          %b: !felt.type {function.arg_name = "b"},
          %later: !felt.type {function.arg_name = "later"}
      ) {
        %c0 = arith.constant 0 : index
        %c1 = arith.constant 1 : index
        array.write %source[%c1] = %b : !array.type<@N x !felt.type>, !felt.type
        %copy = function.call @Arrays::@saveForward(%source, %a) : (!array.type<@N x !felt.type>, !felt.type) -> !array.type<@N x !felt.type>
        array.write %source[%c1] = %later : !array.type<@N x !felt.type>, !felt.type
        %observed = array.read %copy[%c1] : !array.type<@N x !felt.type>, !felt.type
        %zero = felt.const 0
        constrain.eq %observed, %zero : !felt.type
        function.return
      }
    }
    function.def @saveForward(%source: !array.type<@N x !felt.type>, %value: !felt.type) -> !array.type<@N x !felt.type> {
      %result = function.call @Arrays::@save(%source, %value) : (!array.type<@N x !felt.type>, !felt.type) -> !array.type<@N x !felt.type>
      function.return %result : !array.type<@N x !felt.type>
    }
    function.def @save(%source: !array.type<@N x !felt.type>, %value: !felt.type) -> !array.type<@N x !felt.type> {
      %c0 = arith.constant 0 : index
      array.write %source[%c0] = %value : !array.type<@N x !felt.type>, !felt.type
      %holder = pod.new { @saved = %source } : !pod.type<[@saved: !array.type<@N x !felt.type>]>
      %result = pod.read %holder[@saved] : !pod.type<[@saved: !array.type<@N x !felt.type>]>, !array.type<@N x !felt.type>
      function.return %result : !array.type<@N x !felt.type>
    }
  }
}

