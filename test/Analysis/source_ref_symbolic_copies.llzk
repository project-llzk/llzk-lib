// Splitting a copied range preserves the remaining correspondence.
module attributes {llzk.lang} {
  poly.template @Arrays {
    poly.param @N : index
    struct.def @SymbolicCopyOverwriteNeighbor {
      function.def @compute(%source: !array.type<@N x !felt.type>, %a: !felt.type, %b: !felt.type, %later: !felt.type) -> !struct.type<@Arrays::@SymbolicCopyOverwriteNeighbor<[@N]>> {
