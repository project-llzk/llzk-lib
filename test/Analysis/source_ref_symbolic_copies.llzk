    function.def @updated(%input: !array.type<@N x !felt.type>, %value: !felt.type) -> !array.type<@N x !felt.type> {
      %c0 = arith.constant 0 : index
      array.write %input[%c0] = %value : !array.type<@N x !felt.type>, !felt.type
      function.return %input : !array.type<@N x !felt.type>
    }
  }
}

