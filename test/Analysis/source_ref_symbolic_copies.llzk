          %self: !struct.type<@Arrays::@SymbolicConditionalFirstCopy<[@N]>>,
          %source: !array.type<@N x !felt.type> {function.arg_name = "source"},
          %other: !array.type<@N x !felt.type> {function.arg_name = "other"},
          %cond: i1 {function.arg_name = "cond"}
      ) {
        %c0 = arith.constant 0 : index
        %c1 = arith.constant 1 : index
        scf.if %cond {
          array.insert %source[] = %other : !array.type<@N x !felt.type>, !array.type<@N x !felt.type>
        }
        %observed = array.read %source[%c1] : !array.type<@N x !felt.type>, !felt.type
        %zero = felt.const 0
        constrain.eq %observed, %zero : !felt.type
        function.return
      }
    }
  }
}

