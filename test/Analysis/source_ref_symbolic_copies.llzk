        %c0 = arith.constant 0 : index
        %c1 = arith.constant 1 : index
        %copy = function.call @Arrays::@slice(%source) : (!array.type<@N,@N x !felt.type>) -> !array.type<@N x !felt.type>
        array.write %source[%c1, %c0] = %later : !array.type<@N,@N x !felt.type>, !felt.type
