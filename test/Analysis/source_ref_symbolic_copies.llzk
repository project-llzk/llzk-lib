// A callee-local point write does not contaminate the rest of its symbolic return.
module attributes {llzk.lang} {
  poly.template @Arrays {
    poly.param @N : index
    struct.def @SymbolicReturnedModifiedArgument {
      function.def @compute(%source: !array.type<@N x !felt.type>, %a: !felt.type) -> !struct.type<@Arrays::@SymbolicReturnedModifiedArgument<[@N]>> {
