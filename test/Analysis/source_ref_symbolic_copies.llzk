// -----


// A whole-array copy replaces earlier point and ranged writes.
module attributes {llzk.lang} {
  poly.template @Arrays {
    poly.param @N : index
    struct.def @SymbolicCopyWholeOverwrite {
      function.def @compute(%source: !array.type<@N x !felt.type>, %other: !array.type<@N x !felt.type>, %a: !felt.type, %b: !felt.type, %later: !felt.type) -> !struct.type<@Arrays::@SymbolicCopyWholeOverwrite<[@N]>> {
        %self = struct.new : !struct.type<@Arrays::@SymbolicCopyWholeOverwrite<[@N]>>
        function.return %self : !struct.type<@Arrays::@SymbolicCopyWholeOverwrite<[@N]>>
      }
      function.def @constrain(
          %self: !struct.type<@Arrays::@SymbolicCopyWholeOverwrite<[@N]>>,
          %source: !array.type<@N x !felt.type> {function.arg_name = "source"},
          %other: !array.type<@N x !felt.type> {function.arg_name = "other"},
          %a: !felt.type {function.arg_name = "a"},
          %b: !felt.type {function.arg_name = "b"},
          %later: !felt.type {function.arg_name = "later"}
      ) {
        %c0 = arith.constant 0 : index
        %c1 = arith.constant 1 : index
        array.write %source[%c0] = %a : !array.type<@N x !felt.type>, !felt.type
        array.write %source[%c1] = %b : !array.type<@N x !felt.type>, !felt.type
        %holder = pod.new { @saved = %source } : !pod.type<[@saved: !array.type<@N x !felt.type>]>
        %copy = pod.read %holder[@saved] : !pod.type<[@saved: !array.type<@N x !felt.type>]>, !array.type<@N x !felt.type>
        array.write %copy[%c1] = %later : !array.type<@N x !felt.type>, !felt.type
        array.insert %copy[] = %other : !array.type<@N x !felt.type>, !array.type<@N x !felt.type>
        %observed = array.read %copy[%c1] : !array.type<@N x !felt.type>, !felt.type
        %zero = felt.const 0
        constrain.eq %observed, %zero : !felt.type
        function.return
      }
    }
  }
}

// CHECK-LABEL: @Arrays::@SymbolicCopyWholeOverwrite ConstraintDependencyGraph {
// CHECK-NEXT:      { other[1], <felt.const: 0> }
// CHECK-NEXT:  }

// -----


// A conditional whole-array copy retains both initialized alternatives.
module attributes {llzk.lang} {
  poly.template @Arrays {
    poly.param @N : index
    struct.def @SymbolicCopyConditional {
      function.def @compute(%source: !array.type<@N x !felt.type>, %other: !array.type<@N x !felt.type>, %b: !felt.type, %cond: i1) -> !struct.type<@Arrays::@SymbolicCopyConditional<[@N]>> {
        %self = struct.new : !struct.type<@Arrays::@SymbolicCopyConditional<[@N]>>
        function.return %self : !struct.type<@Arrays::@SymbolicCopyConditional<[@N]>>
      }
      function.def @constrain(
          %self: !struct.type<@Arrays::@SymbolicCopyConditional<[@N]>>,
          %source: !array.type<@N x !felt.type> {function.arg_name = "source"},
          %other: !array.type<@N x !felt.type> {function.arg_name = "other"},
          %b: !felt.type {function.arg_name = "b"},
          %cond: i1 {function.arg_name = "cond"}
      ) {
        %c0 = arith.constant 0 : index
        %c1 = arith.constant 1 : index
        array.write %source[%c1] = %b : !array.type<@N x !felt.type>, !felt.type
        %holder = pod.new { @saved = %source } : !pod.type<[@saved: !array.type<@N x !felt.type>]>
        %copy = pod.read %holder[@saved] : !pod.type<[@saved: !array.type<@N x !felt.type>]>, !array.type<@N x !felt.type>
        scf.if %cond {
          array.insert %copy[] = %other : !array.type<@N x !felt.type>, !array.type<@N x !felt.type>
        }
        %observed = array.read %copy[%c1] : !array.type<@N x !felt.type>, !felt.type
        %zero = felt.const 0
        constrain.eq %observed, %zero : !felt.type
        function.return
      }
    }
  }
}

// CHECK-LABEL: @Arrays::@SymbolicCopyConditional ConstraintDependencyGraph {
// CHECK-NEXT:      { other[1], b },
// CHECK-NEXT:      { other[1], <felt.const: 0> },
// CHECK-NEXT:      { b, <felt.const: 0> }
// CHECK-NEXT:  }

