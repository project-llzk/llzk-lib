// A conditional first copy retains the destination input on the skipped path.
module attributes {llzk.lang} {
  poly.template @Arrays {
    poly.param @N : index
    struct.def @SymbolicConditionalFirstCopy {
      function.def @compute(%source: !array.type<@N x !felt.type>, %other: !array.type<@N x !felt.type>, %cond: i1) -> !struct.type<@Arrays::@SymbolicConditionalFirstCopy<[@N]>> {
        %self = struct.new : !struct.type<@Arrays::@SymbolicConditionalFirstCopy<[@N]>>
        function.return %self : !struct.type<@Arrays::@SymbolicConditionalFirstCopy<[@N]>>
