// A second copy preserves the first copy snapshot through later mutations.
module attributes {llzk.lang} {
  poly.template @Arrays {
    poly.param @N : index
    struct.def @SymbolicCopyChain {
      function.def @compute(%source: !array.type<@N x !felt.type>, %b: !felt.type, %later: !felt.type) -> !struct.type<@Arrays::@SymbolicCopyChain<[@N]>> {
        %self = struct.new : !struct.type<@Arrays::@SymbolicCopyChain<[@N]>>
        function.return %self : !struct.type<@Arrays::@SymbolicCopyChain<[@N]>>
      }
      function.def @constrain(
