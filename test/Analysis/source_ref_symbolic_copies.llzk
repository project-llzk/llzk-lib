          %self: !struct.type<@Arrays::@SymbolicCopyUnknownSourceWrite<[@N]>>,
          %source: !array.type<@N x !felt.type> {function.arg_name = "source"},
          %a: !felt.type {function.arg_name = "a"},
          %i: index {function.arg_name = "i"}
      ) {
        %c0 = arith.constant 0 : index
        %c1 = arith.constant 1 : index
        array.write %source[%i] = %a : !array.type<@N x !felt.type>, !felt.type
        %holder = pod.new { @saved = %source } : !pod.type<[@saved: !array.type<@N x !felt.type>]>
        %copy = pod.read %holder[@saved] : !pod.type<[@saved: !array.type<@N x !felt.type>]>, !array.type<@N x !felt.type>
        %observed = array.read %copy[%c1] : !array.type<@N x !felt.type>, !felt.type
        %zero = felt.const 0
        constrain.eq %observed, %zero : !felt.type
        function.return
      }
    }
  }
}

