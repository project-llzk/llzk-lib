// Loop backedges retain prior contents and later writes while copy queries terminate.
module attributes {llzk.lang} {
  poly.template @Arrays {
    poly.param @N : index
    struct.def @SymbolicLoopCopy {
      function.def @compute(%source: !array.type<@N x !felt.type>, %b: !felt.type, %later: !felt.type) -> !struct.type<@Arrays::@SymbolicLoopCopy<[@N]>> {
        %self = struct.new : !struct.type<@Arrays::@SymbolicLoopCopy<[@N]>>
        function.return %self : !struct.type<@Arrays::@SymbolicLoopCopy<[@N]>>
      }
      function.def @constrain(
          %self: !struct.type<@Arrays::@SymbolicLoopCopy<[@N]>>,
          %source: !array.type<@N x !felt.type> {function.arg_name = "source"},
          %b: !felt.type {function.arg_name = "b"},
          %later: !felt.type {function.arg_name = "later"}
      ) {
        %c0 = arith.constant 0 : index
        %c1 = arith.constant 1 : index
        array.write %source[%c1] = %b : !array.type<@N x !felt.type>, !felt.type
        %holder = pod.new { @saved = %source } : !pod.type<[@saved: !array.type<@N x !felt.type>]>
        %copy = pod.read %holder[@saved] : !pod.type<[@saved: !array.type<@N x !felt.type>]>, !array.type<@N x !felt.type>
        %c2 = arith.constant 2 : index
        scf.for %j = %c0 to %c2 step %c1 {
          %holder2 = pod.new { @saved = %copy } : !pod.type<[@saved: !array.type<@N x !felt.type>]>
          %iterationCopy = pod.read %holder2[@saved] : !pod.type<[@saved: !array.type<@N x !felt.type>]>, !array.type<@N x !felt.type>
          %inside = array.read %iterationCopy[%c1] : !array.type<@N x !felt.type>, !felt.type
          %insideZero = felt.const 0
          constrain.eq %inside, %insideZero : !felt.type
          array.write %copy[%c1] = %later : !array.type<@N x !felt.type>, !felt.type
        }
        %observed = array.read %copy[%c1] : !array.type<@N x !felt.type>, !felt.type
        %zero = felt.const 0
        constrain.eq %observed, %zero : !felt.type
        function.return
      }
    }
  }
}

