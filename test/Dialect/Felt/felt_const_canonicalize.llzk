// RUN: llzk-opt --canonicalize %s | FileCheck %s
// RUN: llzk-opt --canonicalize %s | llzk-opt --canonicalize | FileCheck %s

// COM: Tests canonical representatives, including values wider than a machine word.

function.def @zero() -> !felt.type<"babybear"> {
  %c = felt.const 0 : !felt.type<"babybear">
  function.return %c : !felt.type<"babybear">
}
// CHECK-LABEL:   function.def @zero() -> !felt.type<"babybear"> {
// CHECK-NEXT:      %[[VAL_0:[0-9a-zA-Z_\.\-]+]] = felt.const  0 : <"babybear">
// CHECK-NEXT:      function.return %[[VAL_0]] : !felt.type<"babybear">
// CHECK-NEXT:    }

function.def @below_prime() -> !felt.type<"babybear"> {
  %c = felt.const 2013265920 : !felt.type<"babybear">
  function.return %c : !felt.type<"babybear">
}
// CHECK-LABEL:   function.def @below_prime() -> !felt.type<"babybear"> {
// CHECK-NEXT:      %[[VAL_0:[0-9a-zA-Z_\.\-]+]] = felt.const  2013265920 : <"babybear">
// CHECK-NEXT:      function.return %[[VAL_0]] : !felt.type<"babybear">
// CHECK-NEXT:    }

function.def @prime() -> !felt.type<"babybear"> {
  %c = felt.const 2013265921 : !felt.type<"babybear">
  function.return %c : !felt.type<"babybear">
}
// CHECK-LABEL:   function.def @prime() -> !felt.type<"babybear"> {
// CHECK-NEXT:      %[[VAL_0:[0-9a-zA-Z_\.\-]+]] = felt.const  0 : <"babybear">
// CHECK-NEXT:      function.return %[[VAL_0]] : !felt.type<"babybear">
// CHECK-NEXT:    }

function.def @above_prime() -> !felt.type<"babybear"> {
  %c = felt.const 2013265922 : !felt.type<"babybear">
  function.return %c : !felt.type<"babybear">
}
// CHECK-LABEL:   function.def @above_prime() -> !felt.type<"babybear"> {
// CHECK-NEXT:      %[[VAL_0:[0-9a-zA-Z_\.\-]+]] = felt.const  1 : <"babybear">
// CHECK-NEXT:      function.return %[[VAL_0]] : !felt.type<"babybear">
// CHECK-NEXT:    }

function.def @multiple() -> !felt.type<"babybear"> {
  %c = felt.const 4026531842 : !felt.type<"babybear">
  function.return %c : !felt.type<"babybear">
}
// CHECK-LABEL:   function.def @multiple() -> !felt.type<"babybear"> {
// CHECK-NEXT:      %[[VAL_0:[0-9a-zA-Z_\.\-]+]] = felt.const  0 : <"babybear">
// CHECK-NEXT:      function.return %[[VAL_0]] : !felt.type<"babybear">
// CHECK-NEXT:    }

function.def @wide() -> !felt.type<"babybear"> {
  %c = felt.const 685078892839143109828915728799132272895486590993 : !felt.type<"babybear">
  function.return %c : !felt.type<"babybear">
}
// CHECK-LABEL:   function.def @wide() -> !felt.type<"babybear"> {
// CHECK-NEXT:      %[[VAL_0:[0-9a-zA-Z_\.\-]+]] = felt.const  17 : <"babybear">
// CHECK-NEXT:      function.return %[[VAL_0]] : !felt.type<"babybear">
// CHECK-NEXT:    }

function.def @unspecified() -> !felt.type {
  %c = felt.const 4026531842 : !felt.type
  function.return %c : !felt.type
}
// CHECK-LABEL:   function.def @unspecified() -> !felt.type {
// CHECK-NEXT:      %[[VAL_0:[0-9a-zA-Z_\.\-]+]] = felt.const  4026531842
// CHECK-NEXT:      function.return %[[VAL_0]] : !felt.type
// CHECK-NEXT:    }

// Negative literals also have nonnegative canonical representatives.
function.def @negative() -> !felt.type<"babybear"> {
  %c = felt.const -1 : !felt.type<"babybear">
  function.return %c : !felt.type<"babybear">
}
// CHECK-LABEL:   function.def @negative() -> !felt.type<"babybear"> {
// CHECK-NEXT:      %[[VAL_0:[0-9a-zA-Z_\.\-]+]] = felt.const  2013265920 : <"babybear">
// CHECK-NEXT:      function.return %[[VAL_0]] : !felt.type<"babybear">
// CHECK-NEXT:    }

function.def @negative_multiple() -> !felt.type<"babybear"> {
  %c = felt.const -4026531842 : !felt.type<"babybear">
  function.return %c : !felt.type<"babybear">
}
// CHECK-LABEL:   function.def @negative_multiple() -> !felt.type<"babybear"> {
// CHECK-NEXT:      %[[VAL_0:[0-9a-zA-Z_\.\-]+]] = felt.const  0 : <"babybear">
// CHECK-NEXT:      function.return %[[VAL_0]] : !felt.type<"babybear">
// CHECK-NEXT:    }

function.def @negative_wide() -> !felt.type<"babybear"> {
  %c = felt.const -685078892839143109828915728799132272895486590993 : !felt.type<"babybear">
  function.return %c : !felt.type<"babybear">
}
// CHECK-LABEL:   function.def @negative_wide() -> !felt.type<"babybear"> {
// CHECK-NEXT:      %[[VAL_0:[0-9a-zA-Z_\.\-]+]] = felt.const  2013265904 : <"babybear">
// CHECK-NEXT:      function.return %[[VAL_0]] : !felt.type<"babybear">
// CHECK-NEXT:    }

function.def @negative_unspecified() -> !felt.type {
  %c = felt.const -18446744073709551617
  function.return %c : !felt.type
}
// CHECK-LABEL:   function.def @negative_unspecified() -> !felt.type {
// CHECK-NEXT:      %[[VAL_0:[0-9a-zA-Z_\.\-]+]] = felt.const  -18446744073709551617
// CHECK-NEXT:      function.return %[[VAL_0]] : !felt.type
// CHECK-NEXT:    }

function.def @wide_prime() -> !felt.type<"bn254"> {
  // 3 * prime + 17
  %c = felt.const 65664728615517825666739217235771825265645093201248103031094612559727425486868 : !felt.type<"bn254">
  function.return %c : !felt.type<"bn254">
}
// CHECK-LABEL:   function.def @wide_prime() -> !felt.type<"bn254"> {
// CHECK-NEXT:      %[[VAL_1:[0-9a-zA-Z_\.]+]] = felt.const  17 : <"bn254">
// CHECK-NEXT:      function.return %[[VAL_1]] : !felt.type<"bn254">
// CHECK-NEXT:    }
