// RUN: llzk-opt %s > %t.text
// RUN: llzk-opt -emit-bytecode %s | llzk-opt > %t.bytecode-text
// RUN: diff %t.text %t.bytecode-text
// RUN: llzk-opt -emit-bytecode %s > %t.first
// RUN: llzk-opt -emit-bytecode %t.first > %t.second
// RUN: cmp %t.first %t.second

module attributes {llzk.lang} {
  function.def @signed_literals() {
    %a = felt.const -1
    %b = felt.const -18446744073709551617
    %c = felt.const 18446744073709551615
    %d = felt.const 340282366920938463463374607431768211455
    %e = felt.const 0
    function.return
  }
}
