// RUN: llzk-opt -split-input-file --canonicalize %s | FileCheck --enable-var-scope %s

module attributes {llzk.lang} {
  function.def private @use_index(%i: index) -> ()
  function.def private @use_felt(%f: !felt.type) -> ()
  function.def private @use_felt_bb(%f: !felt.type<"babybear">) -> ()

  function.def @field_specified_casts(%a: !felt.type) attributes {function.allow_non_native_field_ops} {
    %f1 = felt.const 1 : !felt.type<"babybear">
    %c1 = cast.toindex %f1 : !felt.type<"babybear">
    function.call @use_index(%c1) : (index) -> ()

    %c2 = arith.constant 2 : index
    %f2 = cast.tofelt %c2 : index, !felt.type<"babybear">
    function.call @use_felt_bb(%f2) : (!felt.type<"babybear">) -> ()

    function.return
  }

  function.def @unspecified_0_casts(%a: !felt.type) attributes {function.allow_non_native_field_ops} {
    %f0 = felt.const 0
    %f0_cast = cast.toindex %f0
    function.call @use_index(%f0_cast) : (index) -> ()

    %c0 = arith.constant 0 : index
    %c0_cast = cast.tofelt %c0 : index, !felt.type
    function.call @use_felt(%c0_cast) : (!felt.type) -> ()

    function.return
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def private @use_index(index)
// CHECK-NEXT:    function.def private @use_felt(!felt.type)
// CHECK-NEXT:    function.def private @use_felt_bb(!felt.type<"babybear">)
// CHECK-NEXT:    function.def @field_specified_casts(%[[VAL_0:[0-9a-zA-Z_\.-]+]]: !felt.type) attributes {function.allow_non_native_field_ops} {
// CHECK-NEXT:      %[[VAL_1:[0-9a-zA-Z_\.-]+]] = felt.const  2 : <"babybear">
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.-]+]] = arith.constant 1 : index
// CHECK-NEXT:      function.call @use_index(%[[VAL_2]]) : (index) -> ()
// CHECK-NEXT:      function.call @use_felt_bb(%[[VAL_1]]) : (!felt.type<"babybear">) -> ()
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:    function.def @unspecified_0_casts(%[[VAL_3:[0-9a-zA-Z_\.-]+]]: !felt.type) attributes {function.allow_non_native_field_ops} {
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.-]+]] = arith.constant 0 : index
// CHECK-NEXT:      %[[VAL_5:[0-9a-zA-Z_\.-]+]] = felt.const  0
// CHECK-NEXT:      %[[VAL_6:[0-9a-zA-Z_\.-]+]] = cast.toindex %[[VAL_5]] : !felt.type
// CHECK-NEXT:      function.call @use_index(%[[VAL_6]]) : (index) -> ()
// CHECK-NEXT:      %[[VAL_7:[0-9a-zA-Z_\.-]+]] = cast.tofelt %[[VAL_4]] : index, !felt.type
// CHECK-NEXT:      function.call @use_felt(%[[VAL_7]]) : (!felt.type) -> ()
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:  }
