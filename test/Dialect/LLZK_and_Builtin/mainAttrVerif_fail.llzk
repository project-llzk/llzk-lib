// RUN: llzk-opt -split-input-file -verify-diagnostics %s

// expected-error@+2 {{'builtin.module' op references unknown symbol "@MissingMain"}}
// expected-error@+1 {{could not find 'struct.def' named "@MissingMain"}}
module attributes {llzk.main = !struct.type<@MissingMain>, llzk.lang} {
  struct.def @Main {
    function.def @compute() -> !struct.type<@Main> {
      %self = struct.new : !struct.type<@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>) {
      function.return
    }
  }
}
// -----

module attributes {llzk.lang} {
  // expected-error@+1 {{"llzk.main" attribute can only be specified on 'builtin.module'}}
  global.def @b : i1 = false {llzk.main = !struct.type<@NonModuleMainAttr>}
}

// -----

// A concrete root must also respect restrictions inside its type arguments.
// expected-error@+1 {{instantiation value '#felt<const 35 : <"goldilocks">> : !felt.type<"goldilocks">' is not compatible with parameter "@N" type restriction '!felt.type<"bn128">'}}
module attributes {llzk.lang, llzk.main = !struct.type<@Outer::@S<[!struct.type<@Inner::@S<[#felt<const 35 : !felt.type<"goldilocks">>]>>]>>} {
  poly.template @Inner {
    poly.param @N : !felt.type<"bn128">
    struct.def @S {
      function.def @compute() -> !struct.type<@Inner::@S<[@N]>> {
        %self = struct.new : !struct.type<@Inner::@S<[@N]>>
        function.return %self : !struct.type<@Inner::@S<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@Inner::@S<[@N]>>) { function.return }
    }
  }
  poly.template @Outer {
    poly.param @Ty : !poly.tvar<@Ty>
    struct.def @S {
      struct.member @child : !poly.tvar<@Ty>
      function.def @compute() -> !struct.type<@Outer::@S<[@Ty]>> {
        %self = struct.new : !struct.type<@Outer::@S<[@Ty]>>
        function.return %self : !struct.type<@Outer::@S<[@Ty]>>
      }
      function.def @constrain(%self: !struct.type<@Outer::@S<[@Ty]>>) { function.return }
    }
  }
}

// -----

// POD records and array elements cannot hide an invalid nested struct argument.
// expected-error@+1 {{instantiation value '#felt<const 35 : <"goldilocks">> : !felt.type<"goldilocks">' is not compatible with parameter "@N" type restriction '!felt.type<"bn128">'}}
module attributes {llzk.lang, llzk.main = !struct.type<@Outer::@S<[!pod.type<[@child: !array.type<2 x !struct.type<@Inner::@S<[#felt<const 35 : !felt.type<"goldilocks">>]>>>]>]>>} {
  poly.template @Inner {
    poly.param @N : !felt.type<"bn128">
    struct.def @S {
      function.def @compute() -> !struct.type<@Inner::@S<[@N]>> {
        %self = struct.new : !struct.type<@Inner::@S<[@N]>>
        function.return %self : !struct.type<@Inner::@S<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@Inner::@S<[@N]>>) { function.return }
    }
  }
  poly.template @Outer {
    poly.param @Ty : !poly.tvar<@Ty>
    struct.def @S {
      struct.member @child : !poly.tvar<@Ty>
      function.def @compute() -> !struct.type<@Outer::@S<[@Ty]>> {
        %self = struct.new : !struct.type<@Outer::@S<[@Ty]>>
        function.return %self : !struct.type<@Outer::@S<[@Ty]>>
      }
      function.def @constrain(%self: !struct.type<@Outer::@S<[@Ty]>>) { function.return }
    }
  }
}
