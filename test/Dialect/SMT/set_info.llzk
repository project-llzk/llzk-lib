// RUN: llzk-opt %s | FileCheck %s

module {
  smt.solver () : () -> () {
    smt_info.set ":llzk-stage" "pre"
    smt_info.set ":status" sat
    smt_info.set ":payload" (:alpha (beta 7 true "x"))
    smt.yield
  }
}

// CHECK:      module {
// CHECK-NEXT:   smt.solver() : () -> () {
// CHECK-NEXT:     smt_info.set ":llzk-stage" "pre"
// CHECK-NEXT:     smt_info.set ":status" sat
// CHECK-NEXT:     smt_info.set ":payload" (:alpha (beta 7 true "x"))
// CHECK-NEXT:   }
// CHECK-NEXT: }
