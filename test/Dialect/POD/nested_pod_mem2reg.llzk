// RUN: llzk-opt --mem2reg -split-input-file %s | FileCheck %s

!Inner = !pod.type<[@value: index]>
!Outer = !pod.type<[@inner: !Inner]>
module attributes {llzk.lang} {
  function.def @preserve_mutated_read_copy(%replacement: index) -> index {
    %outer = pod.new : !Outer
    %first = pod.read %outer[@inner] : !Outer, !Inner
    %second = pod.read %outer[@inner] : !Outer, !Inner
    pod.write %first[@value] = %replacement : !Inner, index
    %observed = pod.read %second[@value] : !Inner, index
    function.return %observed : index
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @preserve_mutated_read_copy(%[[VAL_0:[0-9a-zA-Z_\.]+]]: index) -> index {
// CHECK-NEXT:      %[[VAL_1:[0-9a-zA-Z_\.]+]] = pod.new : <[@inner: !pod.type<[@value: index]>]>
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = pod.read %[[VAL_1]][@inner] : <[@inner: !pod.type<[@value: index]>]>, !pod.type<[@value: index]>
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = pod.read %[[VAL_1]][@inner] : <[@inner: !pod.type<[@value: index]>]>, !pod.type<[@value: index]>
// CHECK-NEXT:      pod.write %[[VAL_2]][@value] = %[[VAL_0]] : <[@value: index]>, index
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = pod.read %[[VAL_3]][@value] : <[@value: index]>, index
// CHECK-NEXT:      function.return %[[VAL_4]] : index
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

!Leaf = !pod.type<[@value: index]>
!Inner = !pod.type<[@leaf: !Leaf]>
!Outer = !pod.type<[@inner: !Inner]>
module attributes {llzk.lang} {
  function.def @preserve_transitively_mutated_read_copy(%replacement: index) -> index {
    %outer = pod.new : !Outer
    %first = pod.read %outer[@inner] : !Outer, !Inner
    %leaf = pod.read %first[@leaf] : !Inner, !Leaf
    pod.write %leaf[@value] = %replacement : !Leaf, index
    %second = pod.read %outer[@inner] : !Outer, !Inner
    %secondLeaf = pod.read %second[@leaf] : !Inner, !Leaf
    %observed = pod.read %secondLeaf[@value] : !Leaf, index
    function.return %observed : index
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @preserve_transitively_mutated_read_copy(%[[VAL_0:[0-9a-zA-Z_\.]+]]: index) -> index {
// CHECK-NEXT:      %[[VAL_1:[0-9a-zA-Z_\.]+]] = pod.new : <[@inner: !pod.type<[@leaf: !pod.type<[@value: index]>]>]>
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = pod.read %[[VAL_1]][@inner] : <[@inner: !pod.type<[@leaf: !pod.type<[@value: index]>]>]>, !pod.type<[@leaf: !pod.type<[@value: index]>]>
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = pod.read %[[VAL_2]][@leaf] : <[@leaf: !pod.type<[@value: index]>]>, !pod.type<[@value: index]>
// CHECK-NEXT:      pod.write %[[VAL_3]][@value] = %[[VAL_0]] : <[@value: index]>, index
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = pod.read %[[VAL_1]][@inner] : <[@inner: !pod.type<[@leaf: !pod.type<[@value: index]>]>]>, !pod.type<[@leaf: !pod.type<[@value: index]>]>
// CHECK-NEXT:      %[[VAL_5:[0-9a-zA-Z_\.]+]] = pod.read %[[VAL_4]][@leaf] : <[@leaf: !pod.type<[@value: index]>]>, !pod.type<[@value: index]>
// CHECK-NEXT:      %[[VAL_6:[0-9a-zA-Z_\.]+]] = pod.read %[[VAL_5]][@value] : <[@value: index]>, index
// CHECK-NEXT:      function.return %[[VAL_6]] : index
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

!Inner = !pod.type<[@value: index]>
!Outer = !pod.type<[@inner: !Inner]>
module attributes {llzk.lang} {
  function.def @preserve_written_nested_value(%initial: index, %replacement: index) -> index {
    %inner = pod.new { @value = %initial } : !Inner
    %outer = pod.new : !Outer
    pod.write %outer[@inner] = %inner : !Outer, !Inner
    pod.write %inner[@value] = %replacement : !Inner, index
    %loaded = pod.read %outer[@inner] : !Outer, !Inner
    %observed = pod.read %loaded[@value] : !Inner, index
    function.return %observed : index
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @preserve_written_nested_value(%[[VAL_0:[0-9a-zA-Z_\.]+]]: index, %[[VAL_1:[0-9a-zA-Z_\.]+]]: index) -> index {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = pod.new { @value = %[[VAL_0]] }  : <[@value: index]>
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = pod.new : <[@inner: !pod.type<[@value: index]>]>
// CHECK-NEXT:      pod.write %[[VAL_3]][@inner] = %[[VAL_2]] : <[@inner: !pod.type<[@value: index]>]>, !pod.type<[@value: index]>
// CHECK-NEXT:      pod.write %[[VAL_2]][@value] = %[[VAL_1]] : <[@value: index]>, index
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = pod.read %[[VAL_3]][@inner] : <[@inner: !pod.type<[@value: index]>]>, !pod.type<[@value: index]>
// CHECK-NEXT:      %[[VAL_5:[0-9a-zA-Z_\.]+]] = pod.read %[[VAL_4]][@value] : <[@value: index]>, index
// CHECK-NEXT:      function.return %[[VAL_5]] : index
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

!Inner = !pod.type<[@value: index]>
!Outer = !pod.type<[@inner: !Inner]>
module attributes {llzk.lang} {
  function.def @preserve_forwarded_read_copy(
      %condition: i1, %replacement: index
  ) -> index {
    %outer = pod.new : !Outer
    %first = pod.read %outer[@inner] : !Outer, !Inner
    %forwarded = scf.if %condition -> (!Inner) {
      scf.yield %first : !Inner
    } else {
      scf.yield %first : !Inner
    }
    pod.write %forwarded[@value] = %replacement : !Inner, index
    %second = pod.read %outer[@inner] : !Outer, !Inner
    %observed = pod.read %second[@value] : !Inner, index
    function.return %observed : index
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @preserve_forwarded_read_copy(%[[VAL_0:[0-9a-zA-Z_\.]+]]: i1, %[[VAL_1:[0-9a-zA-Z_\.]+]]: index) -> index {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = pod.new : <[@inner: !pod.type<[@value: index]>]>
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = pod.read %[[VAL_2]][@inner] : <[@inner: !pod.type<[@value: index]>]>, !pod.type<[@value: index]>
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = scf.if %[[VAL_0]] -> (!pod.type<[@value: index]>) {
// CHECK-NEXT:        scf.yield %[[VAL_3]] : !pod.type<[@value: index]>
// CHECK-NEXT:      } else {
// CHECK-NEXT:        scf.yield %[[VAL_3]] : !pod.type<[@value: index]>
// CHECK-NEXT:      }
// CHECK-NEXT:      pod.write %[[VAL_4]][@value] = %[[VAL_1]] : <[@value: index]>, index
// CHECK-NEXT:      %[[VAL_5:[0-9a-zA-Z_\.]+]] = pod.read %[[VAL_2]][@inner] : <[@inner: !pod.type<[@value: index]>]>, !pod.type<[@value: index]>
// CHECK-NEXT:      %[[VAL_6:[0-9a-zA-Z_\.]+]] = pod.read %[[VAL_5]][@value] : <[@value: index]>, index
// CHECK-NEXT:      function.return %[[VAL_6]] : index
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

!Inner = !pod.type<[@value: index]>
!Outer = !pod.type<[@inner: !Inner]>
module attributes {llzk.lang} {
  function.def @mutate(%inner: !Inner, %replacement: index) {
    pod.write %inner[@value] = %replacement : !Inner, index
    function.return
  }

  function.def @preserve_escaping_read_copy(%replacement: index) -> index {
    %outer = pod.new : !Outer
    %first = pod.read %outer[@inner] : !Outer, !Inner
    function.call @mutate(%first, %replacement) : (!Inner, index) -> ()
    %second = pod.read %outer[@inner] : !Outer, !Inner
    %observed = pod.read %second[@value] : !Inner, index
    function.return %observed : index
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @mutate(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !pod.type<[@value: index]>, %[[VAL_1:[0-9a-zA-Z_\.]+]]: index) {
// CHECK-NEXT:      pod.write %[[VAL_0]][@value] = %[[VAL_1]] : <[@value: index]>, index
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:    function.def @preserve_escaping_read_copy(%[[VAL_2:[0-9a-zA-Z_\.]+]]: index) -> index {
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = pod.new : <[@inner: !pod.type<[@value: index]>]>
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = pod.read %[[VAL_3]][@inner] : <[@inner: !pod.type<[@value: index]>]>, !pod.type<[@value: index]>
// CHECK-NEXT:      function.call @mutate(%[[VAL_4]], %[[VAL_2]]) : (!pod.type<[@value: index]>, index) -> ()
// CHECK-NEXT:      %[[VAL_5:[0-9a-zA-Z_\.]+]] = pod.read %[[VAL_3]][@inner] : <[@inner: !pod.type<[@value: index]>]>, !pod.type<[@value: index]>
// CHECK-NEXT:      %[[VAL_6:[0-9a-zA-Z_\.]+]] = pod.read %[[VAL_5]][@value] : <[@value: index]>, index
// CHECK-NEXT:      function.return %[[VAL_6]] : index
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

!Inner = !pod.type<[@value: index]>
!Outer = !pod.type<[@inner: !Inner]>
module attributes {llzk.lang} {
  function.def @preserve_initialized_nested_value(%initial: index, %replacement: index) -> index {
    %inner = pod.new { @value = %initial } : !Inner
    %outer = pod.new { @inner = %inner } : !Outer
    pod.write %inner[@value] = %replacement : !Inner, index
    %loaded = pod.read %outer[@inner] : !Outer, !Inner
    %observed = pod.read %loaded[@value] : !Inner, index
    function.return %observed : index
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @preserve_initialized_nested_value(%[[VAL_0:[0-9a-zA-Z_\.]+]]: index, %[[VAL_1:[0-9a-zA-Z_\.]+]]: index) -> index {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = pod.new { @value = %[[VAL_0]] }  : <[@value: index]>
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = pod.new { @inner = %[[VAL_2]] }  : <[@inner: !pod.type<[@value: index]>]>
// CHECK-NEXT:      pod.write %[[VAL_2]][@value] = %[[VAL_1]] : <[@value: index]>, index
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = pod.read %[[VAL_3]][@inner] : <[@inner: !pod.type<[@value: index]>]>, !pod.type<[@value: index]>
// CHECK-NEXT:      %[[VAL_5:[0-9a-zA-Z_\.]+]] = pod.read %[[VAL_4]][@value] : <[@value: index]>, index
// CHECK-NEXT:      function.return %[[VAL_5]] : index
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

!Inner = !pod.type<[@value: index]>
!Outer = !pod.type<[@inner: !Inner]>
module attributes {llzk.lang} {
  function.def @erase_unused_nested_default() {
    %outer = pod.new : !Outer
    %unused = pod.read %outer[@inner] : !Outer, !Inner
    function.return
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @erase_unused_nested_default() {
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:  }
