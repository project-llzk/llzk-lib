// RUN: llzk-opt -split-input-file %s 2>&1 | FileCheck --enable-var-scope %s

function.def @unify_cast_pod(%0: !pod.type<[]>) -> !pod.type<[]> {
  %1 = poly.unifiable_cast %0 : (!pod.type<[]>) -> !pod.type<[]>
  function.return %1 : !pod.type<[]>
}
//CHECK-LABEL:  function.def @unify_cast_pod(
//CHECK-SAME:      %[[A1:[0-9a-zA-Z_\.]+]]: !pod.type<[]>) -> !pod.type<[]> {
//CHECK-NEXT:     %[[T1:[0-9a-zA-Z_\.]+]] = poly.unifiable_cast %[[A1]] : (!pod.type<[]>) -> !pod.type<[]>
//CHECK-NEXT:     function.return %[[T1]] : !pod.type<[]>
//CHECK-NEXT:   }

// -----

function.def @unify_cast_pod(%0: !pod.type<[@n: index]>) -> !pod.type<[@n: index]> {
  %1 = poly.unifiable_cast %0 : (!pod.type<[@n: index]>) -> !pod.type<[@n: index]>
  function.return %1 : !pod.type<[@n: index]>
}
//CHECK-LABEL:  function.def @unify_cast_pod(
//CHECK-SAME:      %[[A1:[0-9a-zA-Z_\.]+]]: !pod.type<[@n: index]>) -> !pod.type<[@n: index]> {
//CHECK-NEXT:     %[[T1:[0-9a-zA-Z_\.]+]] = poly.unifiable_cast %[[A1]] : (!pod.type<[@n: index]>) -> !pod.type<[@n: index]>
//CHECK-NEXT:     function.return %[[T1]] : !pod.type<[@n: index]>
//CHECK-NEXT:   }

// -----

function.def @unify_cast_pod(%0: !pod.type<[@n: index, @x: !felt.type]>) -> !pod.type<[@n: index, @x: !felt.type]> {
  %1 = poly.unifiable_cast %0 : (!pod.type<[@n: index, @x: !felt.type]>) -> !pod.type<[@n: index, @x: !felt.type]>
  function.return %1 : !pod.type<[@n: index, @x: !felt.type]>
}
//CHECK-LABEL:  function.def @unify_cast_pod(
//CHECK-SAME:      %[[A1:[0-9a-zA-Z_\.]+]]: !pod.type<[@n: index, @x: !felt.type]>) -> !pod.type<[@n: index, @x: !felt.type]> {
//CHECK-NEXT:     %[[T1:[0-9a-zA-Z_\.]+]] = poly.unifiable_cast %[[A1]] : (!pod.type<[@n: index, @x: !felt.type]>) -> !pod.type<[@n: index, @x: !felt.type]>
//CHECK-NEXT:     function.return %[[T1]] : !pod.type<[@n: index, @x: !felt.type]>
//CHECK-NEXT:   }

// -----

// An explicit empty argument list remains valid inside a POD record.
module attributes {llzk.lang} {
  struct.def @S {
    function.def @product() -> !struct.type<@S> {
      %self = struct.new : !struct.type<@S>
      function.return %self : !struct.type<@S>
    }
  }
  function.def @unify_struct_pod(%0: !pod.type<[@n: index, @x: !struct.type<@S<[]>>]>) -> !pod.type<[@n: index, @x: !struct.type<@S<[]>>]> {
    %1 = poly.unifiable_cast %0 : (!pod.type<[@n: index, @x: !struct.type<@S<[]>>]>) -> !pod.type<[@n: index, @x: !struct.type<@S<[]>>]>
    function.return %1 : !pod.type<[@n: index, @x: !struct.type<@S<[]>>]>
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    struct.def @S {
// CHECK-NEXT:      function.def @product() -> !struct.type<@S> attributes {function.allow_constraint, function.allow_witness} {
// CHECK-NEXT:        %[[VAL_0:[0-9a-zA-Z_\.]+]] = struct.new : <@S>
// CHECK-NEXT:        function.return %[[VAL_0]] : !struct.type<@S>
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    function.def @unify_struct_pod(%[[VAL_1:[0-9a-zA-Z_\.]+]]: !pod.type<[@n: index, @x: !struct.type<@S<[]>>]>) -> !pod.type<[@n: index, @x: !struct.type<@S<[]>>]> {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = poly.unifiable_cast %[[VAL_1]] : (!pod.type<[@n: index, @x: !struct.type<@S<[]>>]>) -> !pod.type<[@n: index, @x: !struct.type<@S<[]>>]>
// CHECK-NEXT:      function.return %[[VAL_2]] : !pod.type<[@n: index, @x: !struct.type<@S<[]>>]>
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

// POD records can unify concrete and forwarded struct template arguments.
module attributes {llzk.lang} {
  poly.template @TS {
    poly.param @N : index
    struct.def @S {
      function.def @product() -> !struct.type<@TS::@S<[@N]>> {
        %self = struct.new : !struct.type<@TS::@S<[@N]>>
        function.return %self : !struct.type<@TS::@S<[@N]>>
      }
    }
  }
  poly.template @Caller {
    poly.param @A : index
    function.def @unify_template_pod(%0: !pod.type<[@n: index, @x: !struct.type<@TS::@S<[1]>>]>) -> !pod.type<[@n: index, @x: !struct.type<@TS::@S<[@A]>>]> {
      %1 = poly.unifiable_cast %0 : (!pod.type<[@n: index, @x: !struct.type<@TS::@S<[1]>>]>) -> !pod.type<[@n: index, @x: !struct.type<@TS::@S<[@A]>>]>
      function.return %1 : !pod.type<[@n: index, @x: !struct.type<@TS::@S<[@A]>>]>
    }
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    poly.template @TS {
// CHECK-NEXT:      poly.param @N : index
// CHECK-NEXT:      struct.def @S {
// CHECK-NEXT:        function.def @product() -> !struct.type<@TS::@S<[@N]>> attributes {function.allow_constraint, function.allow_witness} {
// CHECK-NEXT:          %[[VAL_0:[0-9a-zA-Z_\.]+]] = struct.new : <@TS::@S<[@N]>>
// CHECK-NEXT:          function.return %[[VAL_0]] : !struct.type<@TS::@S<[@N]>>
// CHECK-NEXT:        }
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    poly.template @Caller {
// CHECK-NEXT:      poly.param @A : index
// CHECK-NEXT:      function.def @unify_template_pod(%[[VAL_1:[0-9a-zA-Z_\.]+]]: !pod.type<[@n: index, @x: !struct.type<@TS::@S<[1]>>]>) -> !pod.type<[@n: index, @x: !struct.type<@TS::@S<[@A]>>]> {
// CHECK-NEXT:        %[[VAL_2:[0-9a-zA-Z_\.]+]] = poly.unifiable_cast %[[VAL_1]] : (!pod.type<[@n: index, @x: !struct.type<@TS::@S<[1]>>]>) -> !pod.type<[@n: index, @x: !struct.type<@TS::@S<[@A]>>]>
// CHECK-NEXT:        function.return %[[VAL_2]] : !pod.type<[@n: index, @x: !struct.type<@TS::@S<[@A]>>]>
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

#map = affine_map<()[s0, s1] -> (s0 + s1)>
function.def @unify_cast_pod(
    %0: !pod.type<[@n: index, @x: !array.type<10 x !felt.type>]>
) -> !pod.type<[@n: index, @x: !array.type<#map x !felt.type>]> {
  %1 = poly.unifiable_cast %0 : (!pod.type<[@n: index, @x: !array.type<10 x !felt.type>]>) ->
      !pod.type<[@n: index, @x: !array.type<#map x !felt.type>]>
  function.return %1 : !pod.type<[@n: index, @x: !array.type<#map x !felt.type>]>
}
// CHECK: #[[$M0:[0-9a-zA-Z_\.]+]] = affine_map<()[s0, s1] -> (s0 + s1)>
//CHECK-LABEL:  function.def @unify_cast_pod(
//CHECK-SAME:      %[[A1:[0-9a-zA-Z_\.]+]]: !pod.type<[@n: index, @x: !array.type<10 x !felt.type>]>
//CHECK-SAME:   ) -> !pod.type<[@n: index, @x: !array.type<#[[$M0]] x !felt.type>]> {
//CHECK-NEXT:     %[[T1:[0-9a-zA-Z_\.]+]] = poly.unifiable_cast %[[A1]] :
//CHECK-SAME:         (!pod.type<[@n: index, @x: !array.type<10 x !felt.type>]>) ->
//CHECK-SAME:            !pod.type<[@n: index, @x: !array.type<#[[$M0]] x !felt.type>]>
//CHECK-NEXT:     function.return %[[T1]] : !pod.type<[@n: index, @x: !array.type<#[[$M0]] x !felt.type>]>
//CHECK-NEXT:   }

// -----

module attributes { llzk.lang} {
  struct.def @ConstraintPod {
    function.def @compute(
        %0: !pod.type<[@n: !felt.type]>,
        %1: !pod.type<[@n: !felt.type]>
    ) -> !struct.type<@ConstraintPod> {
      %self = struct.new : !struct.type<@ConstraintPod>
      function.return %self : !struct.type<@ConstraintPod>
    }
    function.def @constrain(
        %self: !struct.type<@ConstraintPod>,
        %0: !pod.type<[@n: !felt.type]>,
        %1: !pod.type<[@n: !felt.type]>
    )  {
      constrain.eq %0, %1 : !pod.type<[@n: !felt.type]>
      function.return
    }
  }
}
//CHECK-LABEL:  function.def @constrain(
//CHECK-SAME:      %[[A1:[0-9a-zA-Z_\.]+]]: !pod.type<[@n: !felt.type]>,
//CHECK-SAME:      %[[A2:[0-9a-zA-Z_\.]+]]: !pod.type<[@n: !felt.type]>
//CHECK-SAME:   ) attributes {function.allow_constraint} {
//CHECK-NEXT:     constrain.eq %[[A1]], %[[A2]] :
//CHECK-SAME:         !pod.type<[@n: !felt.type]>, !pod.type<[@n: !felt.type]>
//CHECK-NEXT:     function.return
//CHECK-NEXT:   }

// -----

