// RUN: llzk-opt -split-input-file -verify-diagnostics %s

module attributes {llzk.lang} {
  // expected-error@+1 {{'llzk.idempotent' attribute must be a unit attribute}}
  function.def private @external_fn() attributes {llzk.idempotent = true}
}

// -----

// expected-error@+1 {{'llzk.idempotent' attribute is only valid on 'function.def'}}
module attributes {llzk.lang, llzk.idempotent} {}
