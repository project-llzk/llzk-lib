// RUN: llzk-opt -I %input_dir -split-input-file -verify-diagnostics %s

// Reject missing or unresolved arguments, mutable globals, symbols that resolve to another
// operation kind, and values that violate untyped or typed target parameter restrictions.
module attributes {llzk.lang} {
  poly.template @GlobalFunc {
    poly.param @A

    function.def @id() -> index {
      %a = poly.read_const @A : index
      function.return %a : index
    }
  }

  struct.def @MissingTemplateParams {
    function.def @compute() -> !struct.type<@MissingTemplateParams> {
      %self = struct.new : !struct.type<@MissingTemplateParams>
      // expected-error@+1 {{'function.call' op must provide template instantiation parameters when calling "@id" because not all template parameters of "@GlobalFunc" appear in the function type signature}}
      %0 = function.call @GlobalFunc::@id() : () -> index
      function.return %self : !struct.type<@MissingTemplateParams>
    }

    function.def @constrain(%self: !struct.type<@MissingTemplateParams>) { function.return }
  }
}

// -----

// Affine maps may parameterize struct types, but a direct free-function template argument for an
// index parameter must be an integer value.
#map = affine_map<(i) -> (i)>
module attributes {llzk.lang} {
  poly.template @T {
    poly.param @N : index

    function.def @value() -> index {
      %n = poly.read_const @N : index
      function.return %n : index
    }
  }

  function.def @use() -> index {
    // expected-error@+1 {{'function.call' op instantiation value 'affine_map<(d0) -> (d0)>' is not compatible with parameter "@N" type restriction 'index'}}
    %value = function.call @T::@value<[#map]>() : () -> index
    function.return %value : index
  }
}
// -----

// TypeAttr call arguments are recursively verified while concrete types and caller template type
// variables remain accepted for a TypeVar restriction.
module attributes {llzk.lang} {
  poly.template @TypeTarget {
    poly.param @T : !poly.tvar<@T>

    function.def @id() -> index {
      %value = arith.constant 0 : index
      function.return %value : index
    }
  }

  function.def @missing_type_argument() -> index {
    // expected-error@+1 {{type variable '!poly.tvar<@MissingType>' must reference a parameter of its enclosing 'poly.template'}}
    %value = function.call @TypeTarget::@id<[!poly.tvar<@MissingType>]>() : () -> index
    function.return %value : index
  }

  function.def @valid_type_argument() -> index {
    %value = function.call @TypeTarget::@id<[!felt.type]>() : () -> index
    function.return %value : index
  }

  poly.template @Caller {
    poly.param @U : !poly.tvar<@U>

    function.def @valid_type_variable() -> index {
      %value = function.call @TypeTarget::@id<[!poly.tvar<@U>]>() : () -> index
      function.return %value : index
    }
  }
}

// -----

// A TypeAttr call argument must contain a valid LLZK type.
module attributes {llzk.lang} {
  poly.template @TypeTarget {
    poly.param @T : !poly.tvar<@T>

    function.def @id() -> index {
      %value = arith.constant 0 : index
      function.return %value : index
    }
  }

  function.def @invalid_builtin_type_argument() -> index {
    // expected-error@+1 {{'function.call' op expected a valid LLZK type but found 'i8'}}
    %value = function.call @TypeTarget::@id<[i8]>() : () -> index
    function.return %value : index
  }
}

// Symbolic call arguments must resolve to local template bindings or constant globals even when
// the target parameter has no type restriction.
// -----
module attributes {llzk.lang} {
  poly.template @UntypedTarget {
    poly.param @P
    function.def @id() -> index {
      %value = arith.constant 0 : index
      function.return %value : index
    }
  }

  // Unknown symbols are rejected for unrestricted parameters.
  function.def @missing_untyped() -> index {
    // expected-error@+1 {{'function.call' op references unknown symbol "@Missing"}}
    %value = function.call @UntypedTarget::@id<[@Missing]>() : () -> index
    function.return %value : index
  }
}

// -----
module attributes {llzk.lang} {
  poly.template @TypedTarget {
    poly.param @P : index
    function.def @id() -> index {
      %value = arith.constant 0 : index
      function.return %value : index
    }
  }

  // Unknown symbols are rejected for typed parameters.
  function.def @missing_typed() -> index {
    // expected-error@+1 {{'function.call' op references unknown symbol "@MissingTyped"}}
    %value = function.call @TypedTarget::@id<[@MissingTyped]>() : () -> index
    function.return %value : index
  }
}

// -----
module attributes {llzk.lang} {
  poly.template @UntypedTarget {
    poly.param @P
    function.def @id() -> index {
      %value = arith.constant 0 : index
      function.return %value : index
    }
  }
  function.def @WrongFunction() -> index {
    %value = arith.constant 0 : index
    function.return %value : index
  }

  // Wrong operation kinds are rejected for unrestricted parameters.
  function.def @function_untyped() -> index {
    // expected-error@+1 {{'function.call' op instantiation value '@WrongFunction' refers to a 'function.def' which is not allowed}}
    %value = function.call @UntypedTarget::@id<[@WrongFunction]>() : () -> index
    function.return %value : index
  }
}

