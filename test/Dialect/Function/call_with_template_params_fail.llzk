// -----

// Equal repeated dimensions accept both explicit and inferred arguments.
module attributes {llzk.lang} {
  poly.template @RepeatedParam {
    poly.param @N : index

    function.def @accept(
        %lhs: !array.type<@N x index>, %rhs: !array.type<@N x index>
    ) {
      function.return
    }
  }

  function.def @caller(%lhs: !array.type<5 x index>, %rhs: !array.type<5 x index>) {
    function.call @RepeatedParam::@accept<[5]>(%lhs, %rhs) :
        (!array.type<5 x index>, !array.type<5 x index>) -> ()
    function.call @RepeatedParam::@accept(%lhs, %rhs) :
        (!array.type<5 x index>, !array.type<5 x index>) -> ()
    function.return
  }
}
