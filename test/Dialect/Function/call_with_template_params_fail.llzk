  struct.def @CannotUnifyWithInferredD {
    function.def @compute() -> !struct.type<@CannotUnifyWithInferredD> {
      %self = struct.new : !struct.type<@CannotUnifyWithInferredD>
      // expected-error@+1 {{'function.call' op instantiation value 'i1' is not compatible with parameter "@N" type restriction 'index'}}
      %0 = function.call @GlobalFunc::@id<[i1]>() : () -> !array.type<2,5 x index>
      function.return %self : !struct.type<@CannotUnifyWithInferredD>
    }

    function.def @constrain(%self: !struct.type<@CannotUnifyWithInferredD>) { function.return }
  }
}
