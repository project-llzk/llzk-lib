// -----

// An initialized mutable global cannot instantiate a free-function template parameter.
module attributes {llzk.lang} {
  poly.template @MutableGlobalInitializedCall {
    poly.param @F : !felt.type

    function.def @id() -> !felt.type {
      %value = poly.read_const @F : !felt.type
      function.return %value : !felt.type
    }
  }
  module @globals {
    // expected-note@+1 {{global defined here}}
    global.def @G : !felt.type<"bn128"> = 35
  }
  struct.def @Caller {
    function.def @compute() -> !struct.type<@Caller> {
      %self = struct.new : !struct.type<@Caller>
      // expected-error@+1 {{'function.call' op instantiation value '@globals::@G' refers to a global that is not marked as 'const'}}
      %value = function.call @MutableGlobalInitializedCall::@id<[@globals::@G]>() : () -> !felt.type
      function.return %self : !struct.type<@Caller>
    }
    function.def @constrain(%self: !struct.type<@Caller>) { function.return }
  }
}

// -----

// An uninitialized mutable global cannot instantiate a free-function template parameter.
module attributes {llzk.lang} {
  poly.template @MutableGlobalUninitializedCall {
    poly.param @F : !felt.type

    function.def @id() -> !felt.type {
      %value = poly.read_const @F : !felt.type
      function.return %value : !felt.type
    }
  }
  module @globals {
    // expected-note@+1 {{global defined here}}
    global.def @G : !felt.type<"bn128">
  }
  struct.def @Caller {
    function.def @compute() -> !struct.type<@Caller> {
      %self = struct.new : !struct.type<@Caller>
      // expected-error@+1 {{'function.call' op instantiation value '@globals::@G' refers to a global that is not marked as 'const'}}
      %value = function.call @MutableGlobalUninitializedCall::@id<[@globals::@G]>() : () -> !felt.type
      function.return %self : !struct.type<@Caller>
    }
    function.def @constrain(%self: !struct.type<@Caller>) { function.return }
  }
}

// -----

// An explicit value cannot hide conflicting evidence inferred for the same parameter from repeated
// signature positions.
module attributes {llzk.lang} {
  poly.template @RepeatedParam {
    poly.param @N : index

    function.def @accept(
        %lhs: !array.type<@N x index>, %rhs: !array.type<@N x index>
    ) {
      function.return
    }
  }

  function.def @caller(%lhs: !array.type<5 x index>, %rhs: !array.type<7 x index>) {
    // expected-error@+1 {{'function.call' op cannot infer a unique template instantiation value for parameter "@N" from function type signature}}
    function.call @RepeatedParam::@accept<[5]>(%lhs, %rhs) :
        (!array.type<5 x index>, !array.type<7 x index>) -> ()
    function.return
  }
}
// -----

// Equal type-variable spellings in different template scopes still identify different bindings:
// an omitted call rejects an unrestricted caller binding.
module attributes {llzk.lang} {
  poly.template @TypeOnlyTarget {
    poly.param @T : !poly.tvar<@T>

    function.def @accept(%value: !poly.tvar<@T>) {
      function.return
    }
  }

  poly.template @UntypedCaller {
    poly.param @T

    function.def @reject_same_name(%value: !poly.tvar<@T>) {
      // expected-error@+1 {{'function.call' op instantiation value '@T' is not compatible with parameter "@T" type restriction '!poly.tvar<@T>'}}
      function.call @TypeOnlyTarget::@accept(%value) : (!poly.tvar<@T>) -> ()
      function.return
    }
  }

}
// -----

// A struct definition with the same name as a target parameter does not make that parameter
// inferable from the function signature.
module attributes {llzk.lang} {
  struct.def @T {
    function.def @compute() -> !struct.type<@T> {
      %self = struct.new : !struct.type<@T>
      function.return %self : !struct.type<@T>
    }

    function.def @constrain(%self: !struct.type<@T>) { function.return }
  }

  poly.template @Target {
    poly.param @T

    function.def @accept(%value: !struct.type<@T>) {
      function.return
    }
  }

  function.def @caller(%value: !struct.type<@T>) {
    // expected-error@+1 {{'function.call' op cannot infer template instantiation value for parameter "@T" from function type signature}}
    function.call @Target::@accept(%value) : (!struct.type<@T>) -> ()
    function.return
  }
}
// -----

// Omitted parameters with `!poly.tvar` restrictions reject conflicting inferences from repeated
// signature positions.
module attributes {llzk.lang} {
  poly.template @RepeatedTypeOnly {
    poly.param @T : !poly.tvar<@T>

    function.def @accept(%lhs: !poly.tvar<@T>, %rhs: !poly.tvar<@T>) {
      function.return
    }
  }

  function.def @mismatched(%lhs: !felt.type, %rhs: index) {
    // expected-error@+1 {{'function.call' op cannot infer template instantiation value for parameter "@T" from function type signature}}
    function.call @RepeatedTypeOnly::@accept(%lhs, %rhs) : (!felt.type, index) -> ()
    function.return
  }

}
// -----

// An omitted argument cannot infer through a caller-local struct whose raw path matches a struct
// in an included target signature; the included definition is qualified by the alias namespace.
module attributes {llzk.lang} {
  include.from "Inputs/template_signature_namespace.llzk" as @Lib

  poly.template @Target {
    poly.param @T : !poly.tvar<@T>

    struct.def @Box {
      function.def @compute() -> !struct.type<@Target::@Box<[@T]>> {
        %self = struct.new : !struct.type<@Target::@Box<[@T]>>
        function.return %self : !struct.type<@Target::@Box<[@T]>>
      }
      function.def @constrain(%self: !struct.type<@Target::@Box<[@T]>>) {
        function.return
      }
    }
  }

  poly.template @Caller {
    poly.param @T : !poly.tvar<@T>

    function.def @reject_local_box(%value: !struct.type<@Target::@Box<[@T]>>) {
      // expected-error@+1 {{'function.call' op operand type mismatch: expected type '!struct.type<@Target::@Box<[@T]>>' from included target "@Lib::@Target::@accept", but found '!struct.type<@Target::@Box<[@T]>>' for operand number 0}}
      function.call @Lib::@Target::@accept(%value) :
          (!struct.type<@Target::@Box<[@T]>>) -> ()
      function.return
    }
  }
}
// -----

// Omitted parameters with `!poly.tvar` restrictions reject a unique value inferred through an
// unrestricted struct parameter.
module attributes {llzk.lang} {
  poly.template @BoxTemplate {
    poly.param @P
    struct.def @Box {
      function.def @compute() -> !struct.type<@BoxTemplate::@Box<[@P]>> {
        %self = struct.new : <@BoxTemplate::@Box<[@P]>>
        function.return %self : !struct.type<@BoxTemplate::@Box<[@P]>>
      }
      function.def @constrain(%self: !struct.type<@BoxTemplate::@Box<[@P]>>) {
        function.return
      }
    }
  }

  poly.template @TypeTarget {
    poly.param @T : !poly.tvar<@T>
    function.def @accept(%value: !struct.type<@BoxTemplate::@Box<[@T]>>) {
      function.return
    }
  }

  function.def @wrongKind(%value: !struct.type<@BoxTemplate::@Box<[5]>>) {
    // expected-error@+1 {{'function.call' op instantiation value '5 : index' is not compatible with parameter "@T" type restriction '!poly.tvar<@T>'}}
    function.call @TypeTarget::@accept(%value) :
        (!struct.type<@BoxTemplate::@Box<[5]>>) -> ()
    function.return
  }

}
// -----

module attributes {llzk.lang} {
  poly.template @GlobalFunc {
    poly.param @A

    function.def @id() -> index {
      %a = poly.read_const @A : index
      function.return %a : index
    }
  }

  struct.def @EmptyTemplateParams {
    function.def @compute() -> !struct.type<@EmptyTemplateParams> {
      %self = struct.new : !struct.type<@EmptyTemplateParams>
      // expected-error@+1 {{'function.call' op must provide template instantiation parameters when calling "@id" because not all template parameters of "@GlobalFunc" appear in the function type signature}}
      %0 = function.call @GlobalFunc::@id<[]>() : () -> index
      function.return %self : !struct.type<@EmptyTemplateParams>
    }

    function.def @constrain(%self: !struct.type<@EmptyTemplateParams>) { function.return }
  }
}
// -----
module attributes {llzk.lang} {
  poly.template @GlobalFunc {
    poly.param @A

    function.def @id() -> index {
      %a = poly.read_const @A : index
      function.return %a : index
    }
  }

  struct.def @ExtraTemplateParams {
    function.def @compute() -> !struct.type<@ExtraTemplateParams> {
      %self = struct.new : !struct.type<@ExtraTemplateParams>
      // expected-error@+1 {{'function.call' op template instantiation has 2 parameter(s) but "@GlobalFunc" expects 1 template parameter(s)}}
      %0 = function.call @GlobalFunc::@id<[23, 91]>() : () -> index
      function.return %self : !struct.type<@ExtraTemplateParams>
    }

    function.def @constrain(%self: !struct.type<@ExtraTemplateParams>) { function.return }
  }
}
// -----
module attributes {llzk.lang} {
  function.def @id() -> index {
    %a = arith.constant 42 : index
    function.return %a : index
  }

  struct.def @ShouldNotHaveTemplateParams {
    function.def @compute() -> !struct.type<@ShouldNotHaveTemplateParams> {
      %self = struct.new : !struct.type<@ShouldNotHaveTemplateParams>
      // expected-error@+1 {{'function.call' op can only have template instantiations when targeting a templated free function}}
      %0 = function.call @id<[23, 91]>() : () -> index
      function.return %self : !struct.type<@ShouldNotHaveTemplateParams>
    }

    function.def @constrain(%self: !struct.type<@ShouldNotHaveTemplateParams>) { function.return }
  }
}
