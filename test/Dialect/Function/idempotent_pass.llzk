// RUN: llzk-opt %s | FileCheck %s
// RUN: llzk-opt %s | llzk-opt | FileCheck %s

module attributes {llzk.lang} {
  function.def private @external_fn(!felt.type) -> !felt.type attributes {llzk.idempotent}

  function.def @identity(%x: !felt.type) -> !felt.type attributes {llzk.idempotent} {
    function.return %x : !felt.type
  }

  struct.def @Repeatable {
    function.def @compute(%x: !felt.type) -> !struct.type<@Repeatable> attributes {llzk.idempotent} {
      %self = struct.new : !struct.type<@Repeatable>
      function.return %self : !struct.type<@Repeatable>
    }
    function.def @constrain(%self: !struct.type<@Repeatable>, %x: !felt.type) attributes {llzk.idempotent} {
      function.return
    }
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def private @external_fn(!felt.type) -> !felt.type attributes {llzk.idempotent}
// CHECK-NEXT:    function.def @identity(%[[VAL_0:[0-9a-zA-Z_.-]+]]: !felt.type) -> !felt.type attributes {llzk.idempotent} {
// CHECK-NEXT:      function.return %[[VAL_0]] : !felt.type
// CHECK-NEXT:    }
// CHECK-NEXT:    struct.def @Repeatable {
// CHECK-NEXT:      function.def @compute(%[[VAL_1:[0-9a-zA-Z_.-]+]]: !felt.type) -> !struct.type<@Repeatable> attributes {function.allow_witness, llzk.idempotent} {
// CHECK-NEXT:        %[[VAL_2:[0-9a-zA-Z_.-]+]] = struct.new : <@Repeatable>
// CHECK-NEXT:        function.return %[[VAL_2]] : !struct.type<@Repeatable>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_3:[0-9a-zA-Z_.-]+]]: !struct.type<@Repeatable>, %[[VAL_4:[0-9a-zA-Z_.-]+]]: !felt.type) attributes {function.allow_constraint, llzk.idempotent} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }

