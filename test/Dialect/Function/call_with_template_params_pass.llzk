module attributes {llzk.lang} {
  poly.template @GlobalFunc {
    poly.param @A : !poly.tvar<@A>

    function.def @id() -> !poly.tvar<@A> {
      %0 = felt.const 1 : !felt.type
      %1 = poly.unifiable_cast %0 : (!felt.type) -> !poly.tvar<@A>
      function.return %1 : !poly.tvar<@A>
    }
  }

  struct.def @ParamTypeTVar {
    function.def @compute() -> !struct.type<@ParamTypeTVar> {
      %self = struct.new : !struct.type<@ParamTypeTVar>
      %0 = function.call @GlobalFunc::@id<[!felt.type]>() : () -> !felt.type
      function.return %self : !struct.type<@ParamTypeTVar>
    }

    function.def @constrain(%self: !struct.type<@ParamTypeTVar>) { function.return }
  }
}
