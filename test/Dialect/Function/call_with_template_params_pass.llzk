// CHECK-NEXT:        %[[VAL_1:[0-9a-zA-Z_\.]+]] = poly.unifiable_cast %[[VAL_0]] : (!felt.type) -> !poly.tvar<@A>
// CHECK-NEXT:        function.return %[[VAL_1]] : !poly.tvar<@A>
// CHECK-NEXT:      }
