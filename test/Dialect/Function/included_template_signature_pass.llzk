// RUN: llzk-opt -I %input_dir %s | FileCheck --enable-var-scope %s

// Included target signatures resolve their type paths through the include alias
// while validating both explicit and omitted template arguments.
module attributes {llzk.lang} {
  include.from "Inputs/template_signature_namespace.llzk" as @Lib

  poly.template @Caller {
    poly.param @T : !poly.tvar<@T>

    function.def @explicit(%value: !struct.type<@Lib::@Target::@Box<[@T]>>) {
      function.call @Lib::@Target::@accept<[@T]>(%value) : (!struct.type<@Lib::@Target::@Box<[@T]>>) -> ()
      function.return
    }

    function.def @inferred(%value: !struct.type<@Lib::@Target::@Box<[@T]>>) {
      function.call @Lib::@Target::@accept(%value) : (!struct.type<@Lib::@Target::@Box<[@T]>>) -> ()
      function.return
    }
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    include.from "Inputs/template_signature_namespace.llzk" as @Lib
// CHECK-NEXT:    poly.template @Caller {
// CHECK-NEXT:      poly.param @T : !poly.tvar<@T>
// CHECK-NEXT:      function.def @explicit(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !struct.type<@Lib::@Target::@Box<[@T]>>) {
// CHECK-NEXT:        function.call @Lib::@Target::@accept<[@T]>(%[[VAL_0]]) : (!struct.type<@Lib::@Target::@Box<[@T]>>) -> ()
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @inferred(%[[VAL_1:[0-9a-zA-Z_\.]+]]: !struct.type<@Lib::@Target::@Box<[@T]>>) {
// CHECK-NEXT:        function.call @Lib::@Target::@accept(%[[VAL_1]]) : (!struct.type<@Lib::@Target::@Box<[@T]>>) -> ()
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }
