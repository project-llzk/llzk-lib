// RUN: llzk-opt -split-input-file %s 2>&1 | FileCheck --enable-var-scope %s

function.def private @abort()
//CHECK-LABEL:  function.def private @abort()
// -----

function.def private @scribble(!felt.type, !felt.type)
//CHECK-LABEL:  function.def private @scribble(!felt.type, !felt.type)
// -----

function.def @identity(%x: !felt.type) -> !felt.type {
  function.return %x: !felt.type
}
//CHECK-LABEL:  function.def @identity(%arg0: !felt.type) -> !felt.type {
//CHECK-NEXT:     function.return %arg0 : !felt.type
//CHECK-NEXT:   }
// -----

module attributes {llzk.lang} {
  function.def @split(%x: index) -> (index, index) {
    %0 = arith.constant 1 : index
    function.return %x, %0 : index, index
  }
  function.def @user(%x: index) -> (index, index) {
    %1, %2 = function.call @split(%x) : (index) -> (index, index)
    function.return %1, %2 : index, index
  }
}
//CHECK-LABEL:  function.def @split(%arg0: index) -> (index, index) {
//CHECK-NEXT:     %[[T1:[0-9a-zA-Z_\.]+]] = arith.constant 1 : index
//CHECK-NEXT:     function.return %arg0, %[[T1]] : index, index
//CHECK-NEXT:   }
//CHECK-LABEL:  function.def @user(%arg0: index) -> (index, index) {
//CHECK-NEXT:     %[[T1:[0-9a-zA-Z_\.]+]]:2 = function.call @split(%arg0) : (index) -> (index, index)
//CHECK-NEXT:     function.return %[[T1]]#0, %[[T1]]#1 : index, index
//CHECK-NEXT:   }
// -----

function.def private @example_arg_attr1(%x: i1 {llzk.pub}, %y: i1)
//CHECK-LABEL:  function.def private @example_arg_attr1(i1 {llzk.pub}, i1)
// -----

function.def private @example_arg_attr2(
    %a: !felt.type {llzk.pub},
    %b: index {llzk.pub}) {
  function.return
}
//CHECK-LABEL:  function.def private @example_arg_attr2(%arg0: !felt.type {llzk.pub}, %arg1: index {llzk.pub}) {
//CHECK-NEXT:     function.return
//CHECK-NEXT:   }
// -----

function.def private @example_arg_name_external(
    i1 {function.arg_name = "lhs"},
    index {function.arg_name = "rhs"})
//CHECK-LABEL:  function.def private @example_arg_name_external(i1 {function.arg_name = "lhs"}, index {function.arg_name = "rhs"})
// -----

function.def @example_arg_name_body(
    %source_name: i1 {function.arg_name = "input 0"},
    %path_name: index {function.arg_name = "a/b"}) {
  function.return
}
//CHECK-LABEL:  function.def @example_arg_name_body(%arg0: i1 {function.arg_name = "input 0"}, %arg1: index {function.arg_name = "a/b"}) {
//CHECK-NEXT:     function.return
//CHECK-NEXT:   }
// -----

function.def private @example_arg_name_with_pub(%x: i1 {function.arg_name = "public", llzk.pub})
//CHECK-LABEL:  function.def private @example_arg_name_with_pub(i1 {function.arg_name = "public", llzk.pub})
// -----

function.def private @example_res_name_external() -> (i1 {function.res_name = "out"})
//CHECK-LABEL:  function.def private @example_res_name_external() -> (i1 {function.res_name = "out"})
// -----

function.def @example_res_name_body(%x: i1) -> (i1 {function.res_name = "out"}) {
  function.return %x : i1
}
//CHECK-LABEL:  function.def @example_res_name_body(%arg0: i1) -> (i1 {function.res_name = "out"}) {
//CHECK-NEXT:     function.return %arg0 : i1
//CHECK-NEXT:   }
// -----

// Template call arguments may name a parameter, expression, or constant global.
module attributes {llzk.lang} {
  poly.template @Target {
    poly.param @N
    function.def @id() -> index {
      %zero = arith.constant 0 : index
      function.return %zero : index
    }
  }
  module @globals {
    global.def const @G : index = 7
  }
  poly.template @Caller {
    poly.param @P
    poly.expr @E {
      %seven = arith.constant 7 : index
      poly.yield %seven : index
    }
    function.def @use() -> index {
      %from_param = function.call @Target::@id<[@P]>() : () -> index
      %from_expr = function.call @Target::@id<[@E]>() : () -> index
      %from_global = function.call @Target::@id<[@globals::@G]>() : () -> index
      function.return %from_global : index
    }
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    poly.template @Target {
// CHECK-NEXT:      poly.param @N
// CHECK-NEXT:      function.def @id() -> index {
// CHECK-NEXT:        %[[VAL_0:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:        function.return %[[VAL_0]] : index
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    module @globals {
// CHECK-NEXT:      global.def const @G : index = 7
// CHECK-NEXT:    }
// CHECK-NEXT:    poly.template @Caller {
// CHECK-NEXT:      poly.param @P
// CHECK-NEXT:      poly.expr @E {
// CHECK-NEXT:        %[[VAL_1:[0-9a-zA-Z_\.]+]] = arith.constant 7 : index
// CHECK-NEXT:        poly.yield %[[VAL_1]] : index
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @use() -> index {
// CHECK-NEXT:        %[[VAL_2:[0-9a-zA-Z_\.]+]] = function.call @Target::@id<[@P]>() : () -> index
// CHECK-NEXT:        %[[VAL_3:[0-9a-zA-Z_\.]+]] = function.call @Target::@id<[@E]>() : () -> index
// CHECK-NEXT:        %[[VAL_4:[0-9a-zA-Z_\.]+]] = function.call @Target::@id<[@globals::@G]>() : () -> index
// CHECK-NEXT:        function.return %[[VAL_4]] : index
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }
