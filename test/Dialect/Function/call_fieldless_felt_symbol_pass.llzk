// RUN: llzk-opt -verify-diagnostics %s | FileCheck %s

// A fieldless restriction accepts known-field symbols from a global or enclosing template.
module attributes {llzk.lang} {
  global.def const @GlobalValue : !felt.type<"bn128"> = 35

  poly.template @Target {
    poly.param @N : !felt.type
    function.def @id() -> index {
      %zero = arith.constant 0 : index
      function.return %zero : index
    }
  }

  poly.template @Caller {
    poly.param @LocalValue : !felt.type<"bn128">
    function.def @use() -> index {
      %global = function.call @Target::@id<[@GlobalValue]>() : () -> index
      %local = function.call @Target::@id<[@LocalValue]>() : () -> index
      function.return %local : index
    }
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    global.def const @GlobalValue : !felt.type<"bn128"> =  35 : <"bn128">
// CHECK-NEXT:    poly.template @Target {
// CHECK-NEXT:      poly.param @N : !felt.type
// CHECK-NEXT:      function.def @id() -> index {
// CHECK-NEXT:        %[[VAL_0:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:        function.return %[[VAL_0]] : index
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    poly.template @Caller {
// CHECK-NEXT:      poly.param @LocalValue : !felt.type<"bn128">
// CHECK-NEXT:      function.def @use() -> index {
// CHECK-NEXT:        %[[VAL_1:[0-9a-zA-Z_\.]+]] = function.call @Target::@id<[@GlobalValue]>() : () -> index
// CHECK-NEXT:        %[[VAL_2:[0-9a-zA-Z_\.]+]] = function.call @Target::@id<[@LocalValue]>() : () -> index
// CHECK-NEXT:        function.return %[[VAL_2]] : index
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }
