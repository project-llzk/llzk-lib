  }

  module @globals {
    global.def const @G : !felt.type<"bn128"> = 35
  }

  function.def @global_value_conflict(
      %value: !struct.type<@BoxTemplate::@Box<[#felt<const 36 : !felt.type<"bn128">>]>>
  ) {
    // expected-error@+1 {{'function.call' op template instantiation value '@globals::@G' for parameter "@F" conflicts with value '#felt<const 36 : <"bn128">> : !felt.type<"bn128">' inferred from function type signature}}
    function.call @Target::@accept<[@globals::@G]>(%value) :
        (!struct.type<@BoxTemplate::@Box<[#felt<const 36 : !felt.type<"bn128">>]>>) -> ()
    function.return
  }
}
