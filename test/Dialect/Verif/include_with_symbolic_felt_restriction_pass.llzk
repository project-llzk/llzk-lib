// CHECK-NEXT:    }
// CHECK-NEXT:    module @globals {
// CHECK-NEXT:      global.def const @G : !felt.type<"bn128"> =  35
// CHECK-NEXT:    }
// CHECK-NEXT:    function.def @qualified(%[[VAL_17:[0-9a-zA-Z_\.]+]]: !struct.type<@BoxTemplate::@Box<[@globals::@G]>>) {
