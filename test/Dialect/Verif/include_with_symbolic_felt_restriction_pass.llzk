// CHECK-NEXT:    }
// CHECK-NEXT:    verif.contract @Qualified for @qualified (%[[VAL_18:[0-9a-zA-Z_\.]+]]: !struct.type<@BoxTemplate::@Box<[@globals::@G]>>) {
// CHECK-NEXT:      verif.include @Target::@Base<[@globals::@G]>(%[[VAL_18]]) : (!struct.type<@BoxTemplate::@Box<[@globals::@G]>>) -> ()
// CHECK-NEXT:    }
// CHECK-NEXT:    function.def @qualified_concrete(%[[VAL_19:[0-9a-zA-Z_\.]+]]: !struct.type<@BoxTemplate::@Box<[#felt<const 35 : <"bn128">>]>>) {
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:    verif.contract @QualifiedConcrete for @qualified_concrete (%[[VAL_20:[0-9a-zA-Z_\.]+]]: !struct.type<@BoxTemplate::@Box<[#felt<const 35 : <"bn128">>]>>) {
// CHECK-NEXT:      verif.include @Target::@Base<[@globals::@G]>(%[[VAL_20]]) : (!struct.type<@BoxTemplate::@Box<[#felt<const 35 : <"bn128">>]>>) -> ()
// CHECK-NEXT:    }
// CHECK-NEXT:    function.def @qualified_fieldless_concrete(%[[VAL_21:[0-9a-zA-Z_\.]+]]: !struct.type<@BoxTemplate::@Box<[#felt<const 35>]>>) {
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:    verif.contract @QualifiedFieldlessConcrete for @qualified_fieldless_concrete (%[[VAL_22:[0-9a-zA-Z_\.]+]]: !struct.type<@BoxTemplate::@Box<[#felt<const 35>]>>) {
// CHECK-NEXT:      verif.include @Target::@Base<[@globals::@G]>(%[[VAL_22]]) : (!struct.type<@BoxTemplate::@Box<[#felt<const 35>]>>) -> ()
// CHECK-NEXT:    }
// CHECK-NEXT:  }
