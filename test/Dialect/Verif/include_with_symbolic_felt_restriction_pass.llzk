// CHECK-NEXT:    poly.template @BoxTemplate {
// CHECK-NEXT:      poly.param @P
// CHECK-NEXT:      struct.def @Box {
// CHECK-NEXT:        function.def @compute() -> !struct.type<@BoxTemplate::@Box<[@P]>> attributes {function.allow_witness} {
// CHECK-NEXT:          %[[VAL_0:[0-9a-zA-Z_\.]+]] = struct.new : <@BoxTemplate::@Box<[@P]>>
// CHECK-NEXT:          function.return %[[VAL_0]] : !struct.type<@BoxTemplate::@Box<[@P]>>
// CHECK-NEXT:        }
// CHECK-NEXT:        function.def @constrain(%[[VAL_1:[0-9a-zA-Z_\.]+]]: !struct.type<@BoxTemplate::@Box<[@P]>>) attributes {function.allow_constraint} {
// CHECK-NEXT:          function.return
// CHECK-NEXT:        }
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    poly.template @Target {
// CHECK-NEXT:      poly.param @F : !felt.type
// CHECK-NEXT:      function.def @accept(%[[VAL_2:[0-9a-zA-Z_\.]+]]: !struct.type<@BoxTemplate::@Box<[@F]>>) {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:      verif.contract @Base for @Target::@accept (%[[VAL_3:[0-9a-zA-Z_\.]+]]: !struct.type<@BoxTemplate::@Box<[@F]>>) {
// CHECK-NEXT:        %[[VAL_4:[0-9a-zA-Z_\.]+]] = arith.constant true
// CHECK-NEXT:        verif.ensure_compute %[[VAL_4]]
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    poly.template @Caller {
// CHECK-NEXT:      poly.param @G : !felt.type<"bn128">
// CHECK-NEXT:      poly.param @H : !felt.type<"bn128">
// CHECK-NEXT:      function.def @explicit(%[[VAL_5:[0-9a-zA-Z_\.]+]]: !struct.type<@BoxTemplate::@Box<[@G]>>) {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @inferred(%[[VAL_6:[0-9a-zA-Z_\.]+]]: !struct.type<@BoxTemplate::@Box<[@G]>>) {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:      verif.contract @Explicit for @Caller::@explicit (%[[VAL_7:[0-9a-zA-Z_\.]+]]: !struct.type<@BoxTemplate::@Box<[@G]>>) {
