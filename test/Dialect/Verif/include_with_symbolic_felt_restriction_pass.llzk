// CHECK-NEXT:      }
// CHECK-NEXT:      verif.contract @Inferred for @Caller::@inferred (%[[VAL_8:[0-9a-zA-Z_\.]+]]: !struct.type<@BoxTemplate::@Box<[@G]>>) {
// CHECK-NEXT:        verif.include @Target::@Base(%[[VAL_8]]) : (!struct.type<@BoxTemplate::@Box<[@G]>>) -> ()
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @concrete(%[[VAL_9:[0-9a-zA-Z_\.]+]]: !struct.type<@BoxTemplate::@Box<[#felt<const 35 : <"bn128">>]>>) {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:      verif.contract @Concrete for @Caller::@concrete (%[[VAL_10:[0-9a-zA-Z_\.]+]]: !struct.type<@BoxTemplate::@Box<[#felt<const 35 : <"bn128">>]>>) {
// CHECK-NEXT:        verif.include @Target::@Base<[@G]>(%[[VAL_10]]) : (!struct.type<@BoxTemplate::@Box<[#felt<const 35 : <"bn128">>]>>) -> ()
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @fieldless_concrete(%[[VAL_11:[0-9a-zA-Z_\.]+]]: !struct.type<@BoxTemplate::@Box<[#felt<const 35>]>>) {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:      verif.contract @FieldlessConcrete for @Caller::@fieldless_concrete (%[[VAL_12:[0-9a-zA-Z_\.]+]]: !struct.type<@BoxTemplate::@Box<[#felt<const 35>]>>) {
// CHECK-NEXT:        verif.include @Target::@Base<[@G]>(%[[VAL_12]]) : (!struct.type<@BoxTemplate::@Box<[#felt<const 35>]>>) -> ()
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @concrete_vs_symbol(%[[VAL_13:[0-9a-zA-Z_\.]+]]: !struct.type<@BoxTemplate::@Box<[@G]>>) {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:      verif.contract @ConcreteVsSymbol for @Caller::@concrete_vs_symbol (%[[VAL_14:[0-9a-zA-Z_\.]+]]: !struct.type<@BoxTemplate::@Box<[@G]>>) {
// CHECK-NEXT:        verif.include @Target::@Base<[#felt<const 35 : <"bn128">>]>(%[[VAL_14]]) : (!struct.type<@BoxTemplate::@Box<[@G]>>) -> ()
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @symbols_match(%[[VAL_15:[0-9a-zA-Z_\.]+]]: !struct.type<@BoxTemplate::@Box<[@H]>>) {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:      verif.contract @SymbolsMatch for @Caller::@symbols_match (%[[VAL_16:[0-9a-zA-Z_\.]+]]: !struct.type<@BoxTemplate::@Box<[@H]>>) {
// CHECK-NEXT:        verif.include @Target::@Base<[@G]>(%[[VAL_16]]) : (!struct.type<@BoxTemplate::@Box<[@H]>>) -> ()
