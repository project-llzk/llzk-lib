module attributes {llzk.lang} {
  function.def @helper_gates(%gate_a: i1, %gate_b: i1) {
    function.return
  }

  struct.def @GateBox {
    struct.member @gate_a : i1
    struct.member @gate_b : i1
    function.def @compute(%gate_a: i1, %gate_b: i1) -> !struct.type<@GateBox> {
      %self = struct.new : !struct.type<@GateBox>
      struct.writem %self[@gate_a] = %gate_a : !struct.type<@GateBox>, i1
      struct.writem %self[@gate_b] = %gate_b : !struct.type<@GateBox>, i1
      function.return %self : !struct.type<@GateBox>
    }
    function.def @constrain(%self: !struct.type<@GateBox>, %gate_a: i1, %gate_b: i1) {
      function.return
    }
  }

  verif.contract @Leaf for @helper_gates (%gate_a: i1, %gate_b: i1) {
    // expected-note@+1 {{included precondition triggered here}}
    verif.require_constrain %gate_a
    // expected-note@+1 {{included precondition triggered here}}
    verif.require_constrain %gate_b
  }

  verif.contract @Wrapper for @GateBox (%self: !struct.type<@GateBox>, %gate_a: i1, %gate_b: i1) {
    // expected-note@+1 {{forbidden struct member value originates here}}
    %member_gate_a = struct.readm %self[@gate_a] : !struct.type<@GateBox>, i1
    // expected-note@+1 {{forbidden struct member value originates here}}
    %member_gate_b = struct.readm %self[@gate_b] : !struct.type<@GateBox>, i1
    // expected-error@+1 {{'verif.include' op includes preconditions whose conditions cannot be derived from a struct member value}}
    verif.include @Leaf(%member_gate_a, %member_gate_b) : (i1, i1) -> ()
  }
}

