    verif.contract @TemplateWrapper for @outer (%x: index) {
      %n = poly.read_const @N : index
      %zero = arith.constant 0 : index
      %ok = arith.cmpi eq, %n, %zero : index
      verif.ensure_compute %ok
    }
  }
}

