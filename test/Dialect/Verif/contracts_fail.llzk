    %secret = struct.readm %self[@secret] : !struct.type<@SecretBox>, !felt.type
    // expected-note@+1 {{forbidden struct member value originates here}}
    %member_gate = struct.readm %self[@gate] : !struct.type<@SecretBox>, i1
    %ret = function.call @select_secret(%secret, %value, %member_gate) : (!felt.type, !felt.type, i1) -> !felt.type
    %isEq = bool.cmp eq(%ret, %value) : !felt.type, !felt.type
    // expected-error@+1 {{'verif.require_constrain' op condition cannot be derived from a struct member value}}
    verif.require_constrain %isEq
  }
}

// -----

module attributes {llzk.lang} {
  function.def @select_ret(%ret_value: i1, %fallback: i1) -> i1 {
    %true = arith.constant true
    %false = arith.constant false
    %selected = scf.if %ret_value -> (i1) {
      scf.yield %true : i1
    } else {
      scf.yield %false : i1
    }
    %result = arith.ori %selected, %fallback : i1
    function.return %result : i1
  }

  function.def @passthrough_bool(%flag : i1) -> i1 {
    function.return %flag : i1
  }

  verif.contract @CallHelperWithReturnControlledValue for @passthrough_bool (%flag : i1, %ret_value : i1) {
    %ret = function.call @select_ret(%ret_value, %flag) : (i1, i1) -> i1
    %isEq = arith.cmpi eq, %ret, %flag : i1
    // expected-error@+1 {{'verif.require_compute' op condition cannot be derived from a function return value}}
    verif.require_compute %isEq
  }
}

