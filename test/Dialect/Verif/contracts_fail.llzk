// -----

module attributes {llzk.lang} {
  function.def @check(%x: index) {
    function.return
  }

  verif.contract @Outer for @check (%x: index) {
    // expected-error@+1 {{'function.def' op cannot be nested within 'verif.contract' operations}}
    function.def @inner() {
      function.return
    }
  }
}

// -----

module attributes {llzk.lang} {
  function.def @check(%x: index, %ok: i1) {
    function.return
  }

  verif.contract @Base for @check (%x: index, %ok: i1) {
    verif.require_compute %ok
  }

  verif.contract @Wrapper for @check (%x: index, %ok: i1) {
    // expected-error@+1 {{'verif.include' op operand type mismatch: expected type 'index', but found 'i1' for operand number 0}}
    verif.include @Base(%ok, %ok) : (i1, i1) -> ()
  }
}

// -----

module attributes {llzk.lang} {
  function.def @check() {
    function.return
  }

  verif.contract @Base for @check () {
    %ok = arith.constant true
    verif.ensure_compute %ok
  }

  verif.contract @Wrapper for @check () {
    // expected-error@+1 {{'verif.include' op can only have template instantiations when targeting a templated contract}}
    verif.include @Base<[9]>() : () -> ()
  }
}

// -----

module attributes {llzk.lang} {
  poly.template @SpecTemplate {
    poly.param @N : index

    function.def @token() {
      %n = poly.read_const @N : index
      function.return
    }

    verif.contract @Base for @SpecTemplate::@token () {
      %ok = arith.constant true
      verif.ensure_compute %ok
    }

    verif.contract @Wrapper for @SpecTemplate::@token () {
      // expected-error@+1 {{'verif.include' op must provide template instantiation parameters when calling "@Base" because not all template parameters of "@SpecTemplate" appear in the contract type signature}}
      verif.include @SpecTemplate::@Base() : () -> ()
    }
  }
}
// -----

// Include arguments for a `poly.tvar` parameter are recursively verified while accepting a
// concrete type argument.
module attributes {llzk.lang} {
  poly.template @TypeTarget {
    poly.param @T : !poly.tvar<@T>

    function.def @token() { function.return }

    verif.contract @Base for @TypeTarget::@token () {
      %ok = arith.constant true
      verif.ensure_compute %ok
    }
  }

  function.def @entry() { function.return }

  verif.contract @ValidTypeArgument for @entry () {
    verif.include @TypeTarget::@Base<[!felt.type]>() : () -> ()
  }

  verif.contract @MissingTypeArgument for @entry () {
    // expected-error@+1 {{type variable '!poly.tvar<@MissingType>' must reference a parameter of its enclosing 'poly.template'}}
    verif.include @TypeTarget::@Base<[!poly.tvar<@MissingType>]>() : () -> ()
  }
}

// -----

// A TypeAttr include argument must contain a valid LLZK type.
module attributes {llzk.lang} {
  poly.template @TypeTarget {
    poly.param @T : !poly.tvar<@T>

    function.def @token() { function.return }

    verif.contract @Base for @TypeTarget::@token () {
      %ok = arith.constant true
      verif.ensure_compute %ok
    }
  }

  function.def @entry() { function.return }

  verif.contract @InvalidBuiltinTypeArgument for @entry () {
    // expected-error@+1 {{'verif.include' op expected a valid LLZK type but found 'i8'}}
    verif.include @TypeTarget::@Base<[i8]>() : () -> ()
  }
}

// Symbolic include arguments must resolve to local template bindings or constant globals even when
// the target parameter has no type restriction.
// -----
module attributes {llzk.lang} {
  poly.template @UntypedTarget {
    poly.param @P
    function.def @token() { function.return }
    verif.contract @Base for @UntypedTarget::@token () {
      %ok = arith.constant true
      verif.ensure_compute %ok
    }
  }
  function.def @Entry() { function.return }
  verif.contract @Wrapper for @Entry () {
    // Unknown symbols are rejected for unrestricted parameters.
    // expected-error@+1 {{'verif.include' op references unknown symbol "@Missing"}}
    verif.include @UntypedTarget::@Base<[@Missing]>() : () -> ()
  }
}

// -----
module attributes {llzk.lang} {
  poly.template @TypedTarget {
    poly.param @P : index
    function.def @token() { function.return }
    verif.contract @Base for @TypedTarget::@token () {
      %ok = arith.constant true
      verif.ensure_compute %ok
    }
  }

  function.def @Entry() { function.return }
  verif.contract @Wrapper for @Entry () {
    // Unknown symbols are rejected for typed parameters.
    // expected-error@+1 {{'verif.include' op references unknown symbol "@MissingTyped"}}
    verif.include @TypedTarget::@Base<[@MissingTyped]>() : () -> ()
  }
}

// -----
module attributes {llzk.lang} {
  poly.template @UntypedTarget {
    poly.param @P
    function.def @token() { function.return }
    verif.contract @Base for @UntypedTarget::@token () {
      %ok = arith.constant true
      verif.ensure_compute %ok
    }
  }
  function.def @WrongFunction() { function.return }

  function.def @Entry() { function.return }
  verif.contract @Wrapper for @Entry () {
    // Wrong operation kinds are rejected for unrestricted parameters.
    // expected-error@+1 {{'verif.include' op instantiation value '@WrongFunction' refers to a 'function.def' which is not allowed}}
    verif.include @UntypedTarget::@Base<[@WrongFunction]>() : () -> ()
  }
}

