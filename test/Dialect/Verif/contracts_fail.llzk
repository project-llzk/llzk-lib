// RUN: llzk-opt -I %input_dir -split-input-file -verify-diagnostics %s

module attributes {llzk.lang} {
  function.def @check(%x: index) {
    function.return
  }

  // expected-error@+1 {{'verif.contract' op 'function.arg_name' on argument 0 must be a string attribute}}
  verif.contract @BadArgName for @check (%x: index {function.arg_name = 7 : i64}) {
    %ok = arith.constant true
    verif.ensure_compute %ok
  }
}

// -----

// Affine maps may parameterize struct types, but a direct contract template argument for an index
// parameter must be an integer value.
#map = affine_map<(i) -> (i)>
module attributes {llzk.lang} {
  poly.template @T {
    poly.param @N : index
    function.def @token() { function.return }

    verif.contract @Base for @T::@token () {
      %ok = arith.constant true
      verif.ensure_compute %ok
    }
  }

  function.def @entry() { function.return }

  verif.contract @Wrapper for @entry () {
    // expected-error@+1 {{'verif.include' op instantiation value 'affine_map<(d0) -> (d0)>' is not compatible with parameter "@N" type restriction 'index'}}
    verif.include @T::@Base<[#map]>() : () -> ()
  }
}

// -----

// An initialized mutable global cannot instantiate an included contract parameter.
module attributes {llzk.lang} {
  poly.template @MutableGlobalInitializedInclude {
    poly.param @F : !felt.type

    function.def @token() { function.return }

    verif.contract @Base for @MutableGlobalInitializedInclude::@token () {
      %ok = arith.constant true
      verif.ensure_compute %ok
    }
  }
  module @globals {
    // expected-note@+1 {{global defined here}}
    global.def @G : !felt.type<"bn128"> = 35
  }
  verif.contract @Wrapper for @MutableGlobalInitializedInclude::@token () {
    // expected-error@+1 {{'verif.include' op instantiation value '@globals::@G' refers to a global that is not marked as 'const'}}
    verif.include @MutableGlobalInitializedInclude::@Base<[@globals::@G]>() : () -> ()
  }
}

// -----

// An uninitialized mutable global cannot instantiate an included contract parameter.
module attributes {llzk.lang} {
  poly.template @MutableGlobalUninitializedInclude {
    poly.param @F : !felt.type

    function.def @token() { function.return }

    verif.contract @Base for @MutableGlobalUninitializedInclude::@token () {
      %ok = arith.constant true
      verif.ensure_compute %ok
    }
  }
  module @globals {
    // expected-note@+1 {{global defined here}}
    global.def @G : !felt.type<"bn128">
  }
  verif.contract @Wrapper for @MutableGlobalUninitializedInclude::@token () {
    // expected-error@+1 {{'verif.include' op instantiation value '@globals::@G' refers to a global that is not marked as 'const'}}
    verif.include @MutableGlobalUninitializedInclude::@Base<[@globals::@G]>() : () -> ()
  }
}

// -----

// An explicit value cannot hide conflicting evidence inferred for the same parameter from repeated
// contract signature positions.
module attributes {llzk.lang} {
  poly.template @RepeatedParam {
    poly.param @N : index

    function.def @target(
        %lhs: !array.type<@N x index>, %rhs: !array.type<@N x index>
    ) {
      function.return
    }

    verif.contract @Base for @RepeatedParam::@target (
        %lhs: !array.type<@N x index>, %rhs: !array.type<@N x index>
    ) {
      %ok = arith.constant true
      verif.ensure_compute %ok
    }
  }

  function.def @caller(%lhs: !array.type<5 x index>, %rhs: !array.type<7 x index>) {
    function.return
  }

  verif.contract @Wrapper for @caller (
      %lhs: !array.type<5 x index>, %rhs: !array.type<7 x index>
  ) {
    // expected-error@+1 {{'verif.include' op cannot infer a unique template instantiation value for parameter "@N" from contract type signature}}
    verif.include @RepeatedParam::@Base<[5]>(%lhs, %rhs) :
        (!array.type<5 x index>, !array.type<7 x index>) -> ()
  }
}

// -----

// Equal type-variable spellings in different template scopes still identify different bindings:
// an omitted include rejects an unrestricted caller binding.
module attributes {llzk.lang} {
  poly.template @TypeOnlyTarget {
    poly.param @T : !poly.tvar<@T>

    function.def @accept(%value: !poly.tvar<@T>) {
      function.return
    }

    verif.contract @Base for @TypeOnlyTarget::@accept (%value: !poly.tvar<@T>) {
      %ok = arith.constant true
      verif.ensure_compute %ok
    }
  }

  poly.template @UntypedCaller {
    poly.param @T

    function.def @reject_same_name(%value: !poly.tvar<@T>) {
      function.return
    }

    verif.contract @RejectSameName for @UntypedCaller::@reject_same_name (
        %value: !poly.tvar<@T>
    ) {
      // expected-error@+1 {{'verif.include' op instantiation value '@T' is not compatible with parameter "@T" type restriction '!poly.tvar<@T>'}}
      verif.include @TypeOnlyTarget::@Base(%value) : (!poly.tvar<@T>) -> ()
    }
  }

}

// -----

// A struct definition with the same name as a target parameter does not make that parameter
// inferable from the contract signature.
module attributes {llzk.lang} {
  struct.def @T {
    function.def @compute() -> !struct.type<@T> {
      %self = struct.new : !struct.type<@T>
      function.return %self : !struct.type<@T>
    }

    function.def @constrain(%self: !struct.type<@T>) { function.return }
  }

  poly.template @Target {
    poly.param @T

    function.def @accept(%value: !struct.type<@T>) {
      function.return
    }

    verif.contract @Base for @Target::@accept (%value: !struct.type<@T>) {
      %ok = arith.constant true
      verif.ensure_compute %ok
    }
  }

  function.def @caller(%value: !struct.type<@T>) {
    function.return
  }

  verif.contract @Wrapper for @caller (%value: !struct.type<@T>) {
    // expected-error@+1 {{'verif.include' op cannot infer template instantiation value for parameter "@T" from contract type signature}}
    verif.include @Target::@Base(%value) : (!struct.type<@T>) -> ()
  }
}

// -----

// Omitted parameters with `!poly.tvar` restrictions reject conflicting inferences from repeated
// contract signature positions.
module attributes {llzk.lang} {
  poly.template @RepeatedTypeOnly {
    poly.param @T : !poly.tvar<@T>

    function.def @target(%lhs: !poly.tvar<@T>, %rhs: !poly.tvar<@T>) {
      function.return
    }

    verif.contract @Base for @RepeatedTypeOnly::@target (
        %lhs: !poly.tvar<@T>, %rhs: !poly.tvar<@T>
    ) {
      %ok = arith.constant true
      verif.ensure_compute %ok
    }
  }

  function.def @mismatched(%lhs: !felt.type, %rhs: index) {
    function.return
  }

  verif.contract @MismatchedWrapper for @mismatched (
      %lhs: !felt.type, %rhs: index
  ) {
    // expected-error@+1 {{'verif.include' op cannot infer template instantiation value for parameter "@T" from contract type signature}}
    verif.include @RepeatedTypeOnly::@Base(%lhs, %rhs) : (!felt.type, index) -> ()
    %ok = arith.constant true
    verif.ensure_compute %ok
  }

}

// -----

// An explicit argument cannot make a caller-local struct match the same raw path in an included
// contract signature; the included definition is qualified by the alias namespace.
module attributes {llzk.lang} {
  include.from "Inputs/template_signature_namespace.llzk" as @Lib

  poly.template @Target {
    poly.param @T : !poly.tvar<@T>

    struct.def @Box {
      function.def @compute() -> !struct.type<@Target::@Box<[@T]>> {
        %self = struct.new : !struct.type<@Target::@Box<[@T]>>
        function.return %self : !struct.type<@Target::@Box<[@T]>>
      }
      function.def @constrain(%self: !struct.type<@Target::@Box<[@T]>>) {
        function.return
      }
    }
  }

  poly.template @Caller {
    poly.param @T : !poly.tvar<@T>

    function.def @reject_local_box(%value: !struct.type<@Target::@Box<[@T]>>) {
      function.return
    }

    verif.contract @RejectLocalBox for @Caller::@reject_local_box (
        %value: !struct.type<@Target::@Box<[@T]>>
    ) {
      // expected-error@+1 {{'verif.include' op operand type mismatch: expected type '!struct.type<@Target::@Box<[@T]>>' from included target "@Lib::@Target::@Base", but found '!struct.type<@Target::@Box<[@T]>>' for operand number 0}}
      verif.include @Lib::@Target::@Base<[@T]>(%value) :
          (!struct.type<@Target::@Box<[@T]>>) -> ()
    }
  }
}

// -----

// Omitted parameters with `!poly.tvar` restrictions reject a unique value inferred through an
// unrestricted struct parameter.
module attributes {llzk.lang} {
  poly.template @BoxTemplate {
    poly.param @P
    struct.def @Box {
      function.def @compute() -> !struct.type<@BoxTemplate::@Box<[@P]>> {
        %self = struct.new : <@BoxTemplate::@Box<[@P]>>
        function.return %self : !struct.type<@BoxTemplate::@Box<[@P]>>
      }
      function.def @constrain(%self: !struct.type<@BoxTemplate::@Box<[@P]>>) {
        function.return
      }
    }
  }

  poly.template @TypeTarget {
    poly.param @T : !poly.tvar<@T>
    function.def @accept(%value: !struct.type<@BoxTemplate::@Box<[@T]>>) {
      function.return
    }
    verif.contract @Base for @TypeTarget::@accept (
        %value: !struct.type<@BoxTemplate::@Box<[@T]>>
    ) {
      %ok = arith.constant true
      verif.ensure_compute %ok
    }
  }

  function.def @wrongKind(%value: !struct.type<@BoxTemplate::@Box<[5]>>) {
    function.return
  }

  verif.contract @WrongKind for @wrongKind (
      %value: !struct.type<@BoxTemplate::@Box<[5]>>
  ) {
    // expected-error@+1 {{'verif.include' op instantiation value '5 : index' is not compatible with parameter "@T" type restriction '!poly.tvar<@T>'}}
    verif.include @TypeTarget::@Base(%value) :
        (!struct.type<@BoxTemplate::@Box<[5]>>) -> ()
    %ok = arith.constant true
    verif.ensure_compute %ok
  }

}

