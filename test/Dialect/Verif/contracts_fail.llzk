// -----

// Equal repeated dimensions accept both explicit and inferred include arguments.
module attributes {llzk.lang} {
  poly.template @RepeatedParam {
    poly.param @N : index

    function.def @target(
        %lhs: !array.type<@N x index>, %rhs: !array.type<@N x index>
    ) {
      function.return
    }

    verif.contract @Base for @RepeatedParam::@target (
        %lhs: !array.type<@N x index>, %rhs: !array.type<@N x index>
    ) {
      %ok = arith.constant true
      verif.ensure_compute %ok
    }
  }

  function.def @caller(%lhs: !array.type<5 x index>, %rhs: !array.type<5 x index>) {
    function.return
  }

  verif.contract @Wrapper for @caller (
      %lhs: !array.type<5 x index>, %rhs: !array.type<5 x index>
  ) {
    verif.include @RepeatedParam::@Base<[5]>(%lhs, %rhs) :
        (!array.type<5 x index>, !array.type<5 x index>) -> ()
    verif.include @RepeatedParam::@Base(%lhs, %rhs) :
        (!array.type<5 x index>, !array.type<5 x index>) -> ()
  }
}
