// RUN: llzk-opt -split-input-file -verify-diagnostics %s

// TESTS: invalid type for a global
module attributes {llzk.lang} {
  // expected-error@+1 {{'global.def' op attribute 'type' failed to satisfy constraint: type attribute of any LLZK type except non-constant types}}
  global.def @g : !poly.tvar<@X>
}
// -----
module attributes {llzk.lang} {
  // expected-error@+1 {{'global.def' op attribute 'type' failed to satisfy constraint: type attribute of any LLZK type except non-constant types}}
  global.def @g : i64
}
// -----

// TEST: generic construction must use initializer attributes with the declared type.
module attributes {llzk.lang} {
  // expected-error@+1 {{'global.def' op with type 'index' expected attribute value with type 'index' but found 'i64'}}
  "global.def"() <{constant, initial_value = 3 : i64, sym_name = "bad_index", type = index}> : () -> ()
}
// -----
module attributes {llzk.lang} {
  // expected-error@+1 {{'global.def' op with type 'i1' expected attribute value with type 'i1' but found 'i64'}}
  "global.def"() <{constant, initial_value = 1 : i64, sym_name = "bad_bool", type = i1}> : () -> ()
}
// -----
module attributes {llzk.lang} {
  // expected-error@+1 {{'global.def' op with type '!felt.type' expected attribute value with type '!felt.type' but found 'i64'}}
  "global.def"() <{constant, initial_value = 35 : i64, sym_name = "bad_felt", type = !felt.type}> : () -> ()
}
// -----
module attributes {llzk.lang} {
  // expected-error@+1 {{'global.def' op with type '!felt.type<"babybear">' expected attribute value with type '!felt.type<"babybear">' but found '!felt.type<"bn128">'}}
  "global.def"() <{constant, initial_value = #felt<const 35 : !felt.type<"bn128">>, sym_name = "bad_felt_field", type = !felt.type<"babybear">}> : () -> ()
}
// -----
module attributes {llzk.lang} {
  // expected-error@+1 {{'global.def' op with type '!array.type<1 x index>' expected array element with type 'index' but found 'i64'}}
  "global.def"() <{constant, initial_value = [3 : i64], sym_name = "bad_index_array", type = !array.type<1 x index>}> : () -> ()
}
// -----
module attributes {llzk.lang} {
  // expected-error@+1 {{'global.def' op attribute 'type' failed to satisfy constraint: type attribute of any LLZK type except non-constant types}}
  global.def @g : !array.type<@b x i1>
}
// -----
module attributes {llzk.lang} {
  // expected-error@+1 {{'global.def' op attribute 'type' failed to satisfy constraint: type attribute of any LLZK type except non-constant types}}
  global.def @g : !array.type<affine_map<(i)->(i)> x i1>
}
// -----
module attributes {llzk.lang} {
  // expected-error@+1 {{'global.def' op attribute 'type' failed to satisfy constraint: type attribute of any LLZK type except non-constant types}}
  global.def @g : !struct.type<@TComponent01::@Component01<[affine_map<(i)->(i)>]>>
  poly.template @TComponent01 {
    poly.param @N

    struct.def @Component01 {
      function.def @compute() -> !struct.type<@TComponent01::@Component01<[@N]>> {
        %self = struct.new : !struct.type<@TComponent01::@Component01<[@N]>>
        function.return %self : !struct.type<@TComponent01::@Component01<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@TComponent01::@Component01<[@N]>>) { function.return }
    }
  }
}
// -----
module attributes {llzk.lang} {
  // expected-error@+1 {{'global.def' op attribute 'type' failed to satisfy constraint: type attribute of any LLZK type except non-constant types}}
  global.def @g : !struct.type<@TComponent01::@Component01<[@any_symbol_here_is_illegal]>>
  poly.template @TComponent01 {
    poly.param @N

    struct.def @Component01 {
      function.def @compute() -> !struct.type<@TComponent01::@Component01<[@N]>> {
        %self = struct.new : !struct.type<@TComponent01::@Component01<[@N]>>
        function.return %self : !struct.type<@TComponent01::@Component01<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@TComponent01::@Component01<[@N]>>) { function.return }
    }
  }
}
// -----

// TEST: 'felt' type global initialized with unparsable attribute
module attributes {llzk.lang} {
  // expected-error@+2 {{custom op 'global.def' expected integer value}}
  // expected-error@+1 {{custom op 'global.def' failed to parse LLZK_FeltConstAttr parameter 'value' which is to be a `::llvm::APInt`}}
  global.def const @g : !felt.type = unparseable
}
// -----

// TEST: any other type global initialized with unparsable attribute
module attributes {llzk.lang} {
  // expected-error@+1 {{expected attribute value}}
  global.def const @g : index = unparseable
}
// -----

// TEST: 'felt' type global initialized with incorrect attribute kind
module attributes {llzk.lang} {
  // expected-error@+2 {{custom op 'global.def' expected integer value}}
  // expected-error@+1 {{custom op 'global.def' failed to parse LLZK_FeltConstAttr parameter 'value' which is to be a `::llvm::APInt`}}
  global.def const @g : !felt.type = "Hello"
}
// -----

// TESTS: any other type global initialized with incorrect attribute kind
module attributes {llzk.lang} {
  // expected-error@+1 {{integer constant out of range for attribute}}
  global.def const @g : i1 = 123
}
// -----
module attributes {llzk.lang} {
  // expected-error@+1 {{integer constant out of range for attribute}}
  global.def const @g : i1 = -2
}
// -----
// TEST: boolean array initializers reject integer values outside the boolean range
module attributes {llzk.lang} {
  // expected-error@+1 {{integer constant out of range for attribute}}
  global.def const @g : !array.type<2 x i1> = [0, 2]
}
// -----
module attributes {llzk.lang} {
  // expected-error@+1 {{'global.def' op with type 'i1' expected builtin.bool or builtin.integer attribute value but found builtin.array}}
  global.def const @g : i1 = [7,8,0]
}
// -----
module attributes {llzk.lang} {
  // expected-error@+1 {{'global.def' op with type 'index' expected attribute value with type 'index' but found 'i1'}}
  global.def const @g : index = false
}
// -----
module attributes {llzk.lang} {
  // expected-error@+1 {{'global.def' op with type 'index' expected builtin.index attribute value but found builtin.string}}
  global.def const @g : index = "hello"
}
// -----
// TEST: index array initializers reject booleans like scalar index initializers.
module attributes {llzk.lang} {
  // expected-error@+1 {{'global.def' op with type '!array.type<1 x index>' expected array element with type 'index' but found 'i1'}}
  global.def const @g : !array.type<1 x index> = [false]
}
// -----
// TEST: index array initializers reject narrow negative values rather than changing their value.
module attributes {llzk.lang} {
  // expected-error@+1 {{negative narrow integer initializer cannot be converted to `index`}}
  global.def const @g : !array.type<1 x index> = [-1 : i8]
}
// -----
module attributes {llzk.lang} {
  // expected-error@+1 {{integer literal not valid for specified type}}
  global.def const @g : !string.type = 65723456
}
// -----
module attributes {llzk.lang} {
  // expected-error@+1 {{'global.def' op with type '!array.type<2 x !string.type>' expected builtin.array attribute value but found builtin.string}}
  global.def const @g : !array.type<2 x !string.type> = "a string and something else"
}
// -----
module attributes {llzk.lang} {
  // expected-error@+1 {{'global.def' op with type '!array.type<2 x !string.type>' expected builtin.array attribute value to contain 2 elements but found 0}}
  global.def const @g : !array.type<2 x !string.type> = []
}
// -----
module attributes {llzk.lang} {
  // expected-error@+1 {{'global.def' op with type '!array.type<2 x !string.type>' expected array element with type '!string.type' but found 'i64'}}
  global.def const @g : !array.type<2 x !string.type> = [7, 8]
}
// -----
module attributes {llzk.lang} {
  // expected-error@+1 {{'global.def' op with type '!array.type<2 x !string.type>' expected builtin.array attribute value to contain 2 elements but found 3}}
  global.def const @g : !array.type<2 x !string.type> = ["too", "many", "strings"]
}
// -----
module attributes {llzk.lang} {
  // expected-error@+3 {{'global.def' op with type '!array.type<4 x !string.type>' expected array element with type '!string.type' but found 'i1'}}
  // expected-error@+2 {{'global.def' op with type '!array.type<4 x !string.type>' expected array element with type '!string.type' but found builtin.affine_map}}
  // expected-error@+1 {{'global.def' op with type '!array.type<4 x !string.type>' expected array element with type '!string.type' but found 'i64'}}
  global.def const @g : !array.type<4 x !string.type> = ["a string and something else", false, affine_map<(i)->(i)>, -100]
}
// -----
module attributes {llzk.lang} {
  // expected-error@+1 {{'global.def' op with type '!array.type<2,2,1,2 x !felt.type>' expected builtin.array attribute value to contain 8 elements but found 4}}
  global.def const @g : !array.type<2,2,1,2 x !felt.type> = [6, 12134, 45523, 15623]
}
// -----

// TEST: 'felt' type global initialized with incorrect attribute kind
module attributes {llzk.lang} {
  // expected-error@+2 {{custom op 'global.def' expected integer value}}
  // expected-error@+1 {{custom op 'global.def' failed to parse LLZK_FeltConstAttr parameter 'value' which is to be a `::llvm::APInt`}}
  global.def const @g : !felt.type = "Hello"
}
// -----

// TEST: global with "const" not initialized
module attributes {llzk.lang} {
  // expected-error@+1 {{'global.def' op marked as 'const' must be assigned a value}}
  global.def const @g : !string.type
}
// -----

// TEST: GlobalReadOp with unknown symbol name
module attributes {llzk.lang} {
  global.def @g : !string.type = "Hello"
  struct.def @Component02 {
    function.def @compute() -> !struct.type<@Component02> {
      // expected-error@+1 {{'global.read' op references unknown symbol "@unknown"}}
      %t = global.read @unknown : !string.type
      %self = struct.new : !struct.type<@Component02>
      function.return %self : !struct.type<@Component02>
    }
    function.def @constrain(%self: !struct.type<@Component02>) { function.return }
  }
}
// -----

// TEST: GlobalReadOp with type that does not match the GlobalDefOp
module attributes {llzk.lang} {
  global.def @g : !felt.type = 6546
  struct.def @Component03 {
    function.def @compute() -> !struct.type<@Component03> {
      // expected-error@+1 {{'global.read' op has wrong type; expected '!felt.type', got '!string.type'}}
      %t = global.read @g : !string.type
      %self = struct.new : !struct.type<@Component03>
      function.return %self : !struct.type<@Component03>
    }
    function.def @constrain(%self: !struct.type<@Component03>) { function.return }
  }
}
// -----

// TEST: GlobalWriteOp with unknown symbol name
module attributes {llzk.lang} {
  global.def @g : !felt.type = 125
  struct.def @Component04 {
    function.def @compute() -> !struct.type<@Component04> {
      %c = felt.const 99999
      // expected-error@+1 {{'global.write' op references unknown symbol "@unknown"}}
      global.write @unknown = %c : !felt.type
      %self = struct.new : !struct.type<@Component04>
      function.return %self : !struct.type<@Component04>
    }
    function.def @constrain(%self: !struct.type<@Component04>) { function.return }
  }
}
// -----

// TEST: GlobalWriteOp with type that does not match the GlobalDefOp
module attributes {llzk.lang} {
  global.def @g : index = 125
  struct.def @Component05 {
    function.def @compute() -> !struct.type<@Component05> {
      %c = felt.const 99999
      // expected-error@+1 {{'global.write' op has wrong type; expected 'index', got '!felt.type'}}
      global.write @g = %c : !felt.type
      %self = struct.new : !struct.type<@Component05>
      function.return %self : !struct.type<@Component05>
    }
    function.def @constrain(%self: !struct.type<@Component05>) { function.return }
  }
}
// -----

// TEST: GlobalWriteOp with type that does not Value
module attributes {llzk.lang} {
  global.def @g : !felt.type = 125
  struct.def @Component06 {
    function.def @compute() -> !struct.type<@Component06> {
      %c = arith.constant true // expected-note {{prior use here}}
      // expected-error@+1 {{use of value '%c' expects different type than prior uses: '!felt.type' vs 'i1'}}
      global.write @g = %c : !felt.type
      %self = struct.new : !struct.type<@Component06>
      function.return %self : !struct.type<@Component06>
    }
    function.def @constrain(%self: !struct.type<@Component06>) { function.return }
  }
}
// -----

// TEST: GlobalWriteOp targeting a "const" GlobalDefOp
module attributes {llzk.lang} {
  global.def const @t : i1 = true
  struct.def @Component07 {
    function.def @compute() -> !struct.type<@Component07> {
      %c = arith.constant false
      // expected-error@+1 {{'global.write' op cannot target 'global.def' marked as 'const'}}
      global.write @t = %c : i1
      %self = struct.new : !struct.type<@Component07>
      function.return %self : !struct.type<@Component07>
    }
    function.def @constrain(%self: !struct.type<@Component07>) { function.return }
  }
}
// -----

// TEST: Struct parameter conflicts with a global name
module attributes {llzk.lang} {
  global.def const @N : index = 3 // expected-note {{symbol already defined here}}
  poly.template @TComponent08 {
    // expected-error@+1 {{'poly.param' op name conflicts with an existing symbol}}
    poly.param @N

    struct.def @Component08 {
      function.def @compute() -> !struct.type<@TComponent08::@Component08<[@N]>> {
        %self = struct.new : !struct.type<@TComponent08::@Component08<[@N]>>
        function.return %self : !struct.type<@TComponent08::@Component08<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@TComponent08::@Component08<[@N]>>) { function.return }
    }
  }
}
// -----

// TEST: `writeg` cannot be used in a "constrain" function
module attributes {llzk.lang} {
  global.def @t : i1 = true
  struct.def @Component09 {
    function.def @compute() -> !struct.type<@Component09> {
      %self = struct.new : !struct.type<@Component09>
      function.return %self : !struct.type<@Component09>
    }
    function.def @constrain(%self: !struct.type<@Component09>) {
      %c = arith.constant false
      // expected-error@+1 {{'global.write' op only valid within a 'function.def' with 'function.allow_witness' attribute}}
      global.write @t = %c : i1
      function.return
    }
  }
}
// -----

// TEST: `writeg` cannot be used in a free function
module attributes {llzk.lang} {
  global.def @g : !felt.type
  function.def @test() {
    %c = felt.const 99999
    // expected-error@+1 {{'global.write' op only valid within a 'function.def' with 'function.allow_witness' attribute}}
    global.write @g = %c : !felt.type
    function.return
  }
}
// -----

module attributes {llzk.lang} {
  module @untyped_attr {
    global.def const @A : !felt.type<"babybear"> =  16
  }
  function.def @differently_specified() -> !felt.type<"bn254"> {
    // expected-error@+1 {{'global.read' op has wrong type; expected '!felt.type<"babybear">', got '!felt.type<"bn254">'}}
    %a = global.read @untyped_attr::@A : !felt.type<"bn254">
    function.return %a : !felt.type<"bn254">
  }
}
// -----

module attributes {llzk.lang} {
  module @typed_attr {
    // expected-error@+1 {{custom op 'global.def' initializer type '!felt.type<"bn128">' conflicts with declared type '!felt.type<"babybear">'}}
    global.def const @A : !felt.type<"babybear"> =  #felt<const 35 : !felt.type<"bn128">>
  }
  function.def @def_differently_specified() -> !felt.type<"babybear"> {
    %a = global.read @typed_attr::@A : !felt.type<"babybear">
    function.return %a : !felt.type<"babybear">
  }
}
// -----

// TEST: mutable globals retain refinements made by unqualified reads at call sites
module attributes {llzk.lang} {
  global.def @g : !felt.type
  function.def private @use_bn128(!felt.type<"bn128">)
  function.def private @use_babybear(!felt.type<"babybear">)
  struct.def @ComponentReadRefinement {
    function.def @compute() -> !struct.type<@ComponentReadRefinement> {
      %read = global.read @g : !felt.type
      // expected-error@+1 {{'function.call' op has field 'bn128' conflicting with prior field refinement 'babybear' of mutable global 'g'}}
      function.call @use_bn128(%read) : (!felt.type) -> ()
      function.call @use_babybear(%read) : (!felt.type) -> ()
      %self = struct.new : !struct.type<@ComponentReadRefinement>
      function.return %self : !struct.type<@ComponentReadRefinement>
    }
    function.def @constrain(%self: !struct.type<@ComponentReadRefinement>) { function.return }
  }
}
// -----

// TEST: references to a field-qualified mutable global cannot discard its field
module attributes {llzk.lang} {
  global.def @g : !felt.type<"bn128">
  struct.def @ComponentReadField {
    function.def @compute() -> !struct.type<@ComponentReadField> {
      // expected-error@+1 {{'global.read' op has wrong type; expected '!felt.type<"bn128">', got '!felt.type'}}
      %read = global.read @g : !felt.type
      %self = struct.new : !struct.type<@ComponentReadField>
      function.return %self : !struct.type<@ComponentReadField>
    }
    function.def @constrain(%self: !struct.type<@ComponentReadField>) { function.return }
  }
}
// -----

// TEST: mutable globals retain refinements made by casts from separate unspecified reads
module attributes {llzk.lang} {
  global.def @g : !felt.type
  struct.def @ComponentReadCastRefinement {
    function.def @compute() -> !struct.type<@ComponentReadCastRefinement> {
      %first_read = global.read @g : !felt.type
      %bn128 = poly.unifiable_cast %first_read : (!felt.type) -> !felt.type<"bn128">
      %second_read = global.read @g : !felt.type
      // expected-error@+1 {{'poly.unifiable_cast' op has field 'babybear' conflicting with prior field refinement 'bn128' of mutable global 'g'}}
      %babybear = poly.unifiable_cast %second_read : (!felt.type) -> !felt.type<"babybear">
      %self = struct.new : !struct.type<@ComponentReadCastRefinement>
      function.return %self : !struct.type<@ComponentReadCastRefinement>
    }
    function.def @constrain(%self: !struct.type<@ComponentReadCastRefinement>) { function.return }
  }
}
// -----

// TEST: mutable unspecified felt globals cannot be refined to conflicting fields
module attributes {llzk.lang} {
  global.def @g : !felt.type
  struct.def @Component10 {
    function.def @compute() -> !struct.type<@Component10> {
      %value = felt.const 1 : !felt.type<"bn128">
      // expected-error@+1 {{'global.write' op has wrong type; expected '!felt.type', got '!felt.type<"bn128">'}}
      global.write @g = %value : !felt.type<"bn128">
      %self = struct.new : !struct.type<@Component10>
      function.return %self : !struct.type<@Component10>
    }
    function.def @constrain(%self: !struct.type<@Component10>) { function.return }
  }
}
// -----

// TEST: refinement conflicts are checked for every mutable global in the root
module attributes {llzk.lang} {
  global.def @first : !felt.type
  global.def @refined : !felt.type
  struct.def @Component10A {
    function.def @compute() -> !struct.type<@Component10A> {
      %value = felt.const 1 : !felt.type<"bn128">
      // expected-error@+1 {{'global.write' op has wrong type; expected '!felt.type', got '!felt.type<"bn128">'}}
      global.write @refined = %value : !felt.type<"bn128">
      %self = struct.new : !struct.type<@Component10A>
      function.return %self : !struct.type<@Component10A>
    }
    function.def @constrain(%self: !struct.type<@Component10A>) { function.return }
  }
}
// -----

// TEST: mutable aggregate globals cannot be refined to conflicting fields
module attributes {llzk.lang} {
  global.def @g : !array.type<2 x !felt.type>
  struct.def @Component11 {
    function.def @compute() -> !struct.type<@Component11> {
      %value = array.new : !array.type<2 x !felt.type<"bn128">>
      // expected-error@+1 {{'global.write' op has wrong type; expected '!array.type<2 x !felt.type>', got '!array.type<2 x !felt.type<"bn128">>'}}
      global.write @g = %value : !array.type<2 x !felt.type<"bn128">>
      %self = struct.new : !struct.type<@Component11>
      function.return %self : !struct.type<@Component11>
    }
    function.def @constrain(%self: !struct.type<@Component11>) { function.return }
  }
}
// -----

// TEST: GlobalReadOp with more felt positions than its GlobalDefOp
module attributes {llzk.lang} {
  global.def @g : !felt.type
  function.def @invalid_reference() -> !pod.type<[@a: !felt.type, @b: !felt.type]> {
    // expected-error@+1 {{'global.read' op has wrong type; expected '!felt.type', got '!pod.type<[@a: !felt.type, @b: !felt.type]>'}}
    %value = global.read @g : !pod.type<[@a: !felt.type, @b: !felt.type]>
    function.return %value : !pod.type<[@a: !felt.type, @b: !felt.type]>
  }
}
// -----

// TEST: mutable unspecified felt globals retain their initializer's field
module attributes {llzk.lang} {
  global.def @g : !felt.type = #felt<const 1 : !felt.type<"bn128">>
  struct.def @Component12 {
    function.def @compute() -> !struct.type<@Component12> {
      // expected-error@+1 {{'global.read' op has wrong type; expected '!felt.type<"bn128">', got '!felt.type<"babybear">'}}
      %read = global.read @g : !felt.type<"babybear">
      %self = struct.new : !struct.type<@Component12>
      function.return %self : !struct.type<@Component12>
    }
    function.def @constrain(%self: !struct.type<@Component12>) { function.return }
  }
}
// -----

// TEST: const unspecified felt globals retain their initializer's field
module attributes {llzk.lang} {
  global.def const @g : !felt.type = #felt<const 1 : !felt.type<"bn128">>
  function.def @invalid_reference() -> !felt.type<"babybear"> {
    // expected-error@+1 {{'global.read' op has wrong type; expected '!felt.type<"bn128">', got '!felt.type<"babybear">'}}
    %value = global.read @g : !felt.type<"babybear">
    function.return %value : !felt.type<"babybear">
  }
}
// -----

// TEST: mutable aggregate globals retain fields at every initializer position
module attributes {llzk.lang} {
  global.def @g : !array.type<2 x !felt.type> = [1, #felt<const 2 : !felt.type<"babybear">>]
  struct.def @Component13 {
    function.def @compute() -> !struct.type<@Component13> {
      // expected-error@+1 {{'global.read' op has wrong type; expected '!array.type<2 x !felt.type<"babybear">>', got '!array.type<2 x !felt.type<"bn128">>'}}
      %read = global.read @g : !array.type<2 x !felt.type<"bn128">>
      %self = struct.new : !struct.type<@Component13>
      function.return %self : !struct.type<@Component13>
    }
    function.def @constrain(%self: !struct.type<@Component13>) { function.return }
  }
}
// -----

// TEST: mutable aggregate globals cannot initialize one felt position with conflicting fields
module attributes {llzk.lang} {
  // expected-error@+1 {{custom op 'global.def' initializer array contains conflicting types '!felt.type<"babybear">' vs '!felt.type<"bn128">'}}
  global.def @g : !array.type<2 x !felt.type> = [#felt<const 1 : !felt.type<"bn128">>, #felt<const 2 : !felt.type<"babybear">>]
}
