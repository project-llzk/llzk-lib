// -----
module attributes {llzk.lang} {
  struct.def @ComponentM {
    struct.member @f2 : !array.type<2 x index>

    function.def @compute() -> !struct.type<@ComponentM> {
      %self = struct.new : !struct.type<@ComponentM>
      function.return %self : !struct.type<@ComponentM>
    }

    function.def @constrain(%p: !struct.type<@ComponentM>, %0: !array.type<7 x index>) { // expected-note {{prior use here}}
      // expected-error@+1 {{use of value '%0' expects different type than prior uses: '!array.type<2 x index>' vs '!array.type<7 x index>'}}
      struct.writem %p[@f2] = %0 : !struct.type<@ComponentM>, !array.type<2 x index>
      function.return
    }
  }
}
// -----
module attributes {llzk.lang} {
  struct.def @WrongComponent { // expected-note {{uses this type instead}}
    struct.member @f : !felt.type
    function.def @compute() -> !struct.type<@WrongComponent> {
      %self = struct.new : !struct.type<@WrongComponent>
      function.return %self : !struct.type<@WrongComponent>
    }
    function.def @constrain(%self: !struct.type<@WrongComponent>)  { function.return }
  }

  struct.def @ComponentN {
    function.def @compute(%0: !struct.type<@WrongComponent>, %1: !felt.type) -> !struct.type<@ComponentN> {
      %self = struct.new : !struct.type<@ComponentN>
      // expected-error@+1 {{'struct.writem' op must use type of its ancestor 'struct.def' "@ComponentN<[]>" as base value type}}
      struct.writem %0[@f] = %1 : !struct.type<@WrongComponent>, !felt.type
      function.return %self : !struct.type<@ComponentN>
    }
    function.def @constrain(%self: !struct.type<@ComponentN>, %0: !struct.type<@WrongComponent>, %1: !felt.type)  { function.return }
  }
}

// -----
module attributes {llzk.lang} {
  struct.def @PrivateComponent {
    struct.member @f : !felt.type // expected-note {{member defined here}}
    function.def @compute() -> !struct.type<@PrivateComponent> {
      %self = struct.new : !struct.type<@PrivateComponent>
      function.return %self : !struct.type<@PrivateComponent>
    }
    function.def @constrain(%self: !struct.type<@PrivateComponent>)  { function.return }
  }

  struct.def @ComponentN {
    function.def @compute(%0: !struct.type<@PrivateComponent>, %1: !felt.type) -> !struct.type<@ComponentN> {
      %self = struct.new : !struct.type<@ComponentN>
      // expected-error@+1 {{'struct.readm' op cannot read from private member of struct "@PrivateComponent<[]>"}}
      %res = struct.readm %0[@f] : !struct.type<@PrivateComponent>, !felt.type
      function.return %self : !struct.type<@ComponentN>
    }
    function.def @constrain(%self: !struct.type<@ComponentN>, %0: !struct.type<@PrivateComponent>, %1: !felt.type)  { function.return }
  }
}

// -----

// A specified value cannot be written through an unspecified member
// declaration, which would erase its selected field.
module attributes {llzk.lang} {
  struct.def @SpecifiedValueWrite {
    struct.member @value : !felt.type

    function.def @compute() -> !struct.type<@SpecifiedValueWrite> {
      %self = struct.new : !struct.type<@SpecifiedValueWrite>
      %bn128 = felt.const 1 : !felt.type<"bn128">
      // expected-error@+1 {{'struct.writem' op has wrong type; expected '!felt.type', got '!felt.type<"bn128">'}}
      struct.writem %self[@value] = %bn128 : !struct.type<@SpecifiedValueWrite>, !felt.type<"bn128">
      function.return %self : !struct.type<@SpecifiedValueWrite>
    }

    function.def @constrain(%self: !struct.type<@SpecifiedValueWrite>) { function.return }
  }
}

// -----

// Two independent reads of the same unspecified member must not select different fields through
// otherwise disconnected unifiable-cast graphs.
module attributes {llzk.lang} {
  struct.def @MemberReadCastRefinement {
    struct.member @value : !felt.type

    function.def @compute() -> !struct.type<@MemberReadCastRefinement> {
      %self = struct.new : !struct.type<@MemberReadCastRefinement>
      %first_read = struct.readm %self[@value] : !struct.type<@MemberReadCastRefinement>, !felt.type
      %bn128 = poly.unifiable_cast %first_read : (!felt.type) -> !felt.type<"bn128">
      %second_read = struct.readm %self[@value] : !struct.type<@MemberReadCastRefinement>, !felt.type
      // expected-error@+1 {{'poly.unifiable_cast' op has field 'babybear' conflicting with prior field refinement 'bn128' of mutable struct member 'value'}}
      %babybear = poly.unifiable_cast %second_read : (!felt.type) -> !felt.type<"babybear">
      function.return %self : !struct.type<@MemberReadCastRefinement>
    }

    function.def @constrain(%self: !struct.type<@MemberReadCastRefinement>) { function.return }
  }
}

// -----

// A member read may refine an unspecified field, but it may not erase a field
// selected by the member declaration.
module attributes {llzk.lang} {
  struct.def @SpecifiedMemberRead {
    struct.member @value : !felt.type<"bn128">

    function.def @compute() -> !struct.type<@SpecifiedMemberRead> {
      %self = struct.new : !struct.type<@SpecifiedMemberRead>
      // expected-error@+1 {{'struct.readm' op has wrong type; expected '!felt.type<"bn128">', got '!felt.type'}}
      %value = struct.readm %self[@value] : !struct.type<@SpecifiedMemberRead>, !felt.type
      function.return %self : !struct.type<@SpecifiedMemberRead>
    }

    function.def @constrain(%self: !struct.type<@SpecifiedMemberRead>) { function.return }
  }
}

// -----

// A field in a type-variable position does not refine the preceding felt storage position.
module attributes {llzk.lang} {
  poly.template @TypeVariableMember {
    poly.param @T

    struct.def @Container {
      struct.member @value : !pod.type<[@a: !felt.type, @b: !poly.tvar<@T>]> {llzk.pub}

      function.def @compute() -> !struct.type<@TypeVariableMember::@Container<[@T]>> {
        %self = struct.new : !struct.type<@TypeVariableMember::@Container<[@T]>>
        function.return %self : !struct.type<@TypeVariableMember::@Container<[@T]>>
      }

      function.def @constrain(%self: !struct.type<@TypeVariableMember::@Container<[@T]>>) { function.return }
    }
  }

  struct.def @User {
    function.def @compute() -> !struct.type<@User> {
      %self = struct.new : !struct.type<@User>
      %container = function.call @TypeVariableMember::@Container::@compute()
          : () -> !struct.type<@TypeVariableMember::@Container<[!felt.type<"bn128">]>>
      // expected-error@+1 {{'struct.readm' op refines felt position 1 beyond the 1 felt positions in mutable struct member 'value'}}
      %value = struct.readm %container[@value]
          : !struct.type<@TypeVariableMember::@Container<[!felt.type<"bn128">]>>,
            !pod.type<[@a: !felt.type, @b: !felt.type<"bn128">]>
      function.return %self : !struct.type<@User>
    }

    function.def @constrain(%self: !struct.type<@User>) { function.return }
  }
}
