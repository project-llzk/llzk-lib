// CHECK-NEXT:      struct.def @Use {
// CHECK-NEXT:        struct.member @from_global : !struct.type<@T::@S<[@GlobalValue]>>
// CHECK-NEXT:        struct.member @from_binding : !struct.type<@T::@S<[@LocalValue]>>
// CHECK-NEXT:        struct.member @from_expr_fielded : !struct.type<@T::@S<[@ExprFielded]>>
// CHECK-NEXT:        struct.member @from_deferred_binding : !struct.type<@T::@S<[@DeferredValue]>>
// CHECK-NEXT:        struct.member @from_concrete_fieldless : !struct.type<@FieldlessTarget::@S<[#felt<const 35>]>>
// CHECK-NEXT:        struct.member @from_global_fieldless : !struct.type<@FieldlessTarget::@S<[@FieldlessGlobal]>>
// CHECK-NEXT:        struct.member @from_binding_fieldless : !struct.type<@FieldlessTarget::@S<[@FieldlessValue]>>
