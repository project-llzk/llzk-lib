// A fieldless symbolic restriction cannot establish a fielded target restriction.
module attributes {llzk.lang} {
  poly.template @Target {
    // expected-note@+1 {{template parameter declared here}}
    poly.param @F : !felt.type<"bn128">
    struct.def @S {
      function.def @compute() -> !struct.type<@Target::@S<[@F]>> {
        %self = struct.new : <@Target::@S<[@F]>>
        function.return %self : !struct.type<@Target::@S<[@F]>>
      }
      function.def @constrain(%self: !struct.type<@Target::@S<[@F]>>) {
        function.return
      }
    }
  }
  poly.template @Caller {
    // expected-note@+1 {{template parameter declared here}}
    poly.param @G : !felt.type
    // expected-error@+1 {{ref "@G" in type '!struct.type<@Target::@S<[@G]>>' refers to a 'poly.param' with type '!felt.type' but expected '!felt.type<"bn128">'}}
    function.def @useLocal(%value: !struct.type<@Target::@S<[@G]>>) {
      function.return
    }
  }
}

