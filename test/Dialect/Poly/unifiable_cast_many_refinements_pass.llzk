    %c29 = poly.unifiable_cast %input : (!felt.type) -> !felt.type<"bn128">
    %c30 = poly.unifiable_cast %input : (!felt.type) -> !felt.type<"bn128">
    %c31 = poly.unifiable_cast %input : (!felt.type) -> !felt.type<"bn128">
    function.return
  }
