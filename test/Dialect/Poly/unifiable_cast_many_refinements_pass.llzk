// RUN: llzk-opt %s

// Verify a wide connected cast graph without repeatedly walking it from every cast.
module attributes {llzk.lang} {
  function.def @many_matching_refinements(%input: !felt.type) {
    %c0 = poly.unifiable_cast %input : (!felt.type) -> !felt.type<"bn128">
