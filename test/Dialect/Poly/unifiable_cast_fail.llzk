#map1 = affine_map<()[s0, s1] -> (s0 + s1)>
module attributes {llzk.lang} {
  poly.template @TT2 {
    poly.param @N

    struct.def @T2 {
      function.def @compute() -> !struct.type<@TT2::@T2<[@N]>> {
        %self = struct.new : <@TT2::@T2<[@N]>>
        function.return %self : !struct.type<@TT2::@T2<[@N]>>
      }
      function.def @constrain(%self : !struct.type<@TT2::@T2<[@N]>>) {
        function.return
      }
    }
  }
  poly.template @TTester {
    poly.param @S0
    poly.param @S1

    struct.def @Tester {
      function.def @compute(%6: !struct.type<@TT2::@T2<[index]>>) -> !struct.type<@TTester::@Tester<[@S0, @S1]>> {
        %self = struct.new : <@TTester::@Tester<[@S0, @S1]>>
        // expected-error@+1 {{'poly.unifiable_cast' op input type '!struct.type<@TT2::@T2<[index]>>' and output type '!struct.type<@TT2::@T2<[affine_map<()[s0, s1] -> (s0 + s1)>]>>' are not unifiable}}
        %r6 = poly.unifiable_cast %6 : (!struct.type<@TT2::@T2<[index]>>) -> !struct.type<@TT2::@T2<[#map1]>>
        function.return %self : !struct.type<@TTester::@Tester<[@S0, @S1]>>
      }
      function.def @constrain(%self: !struct.type<@TTester::@Tester<[@S0, @S1]>>, %6: !struct.type<@TT2::@T2<[index]>>) {
        function.return
      }
    }
  }
}

