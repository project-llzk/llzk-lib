        function.return
      }
    }
  }
  poly.template @TTester {
    poly.param @S0
    poly.param @S1

    struct.def @Tester {
      function.def @compute(%18: !struct.type<@TT3::@T3<[1, 1, @S0, 1, !struct.type<@TT2::@T2<[1]>>]>>) -> !struct.type<@TTester::@Tester<[@S0, @S1]>> {
        %self = struct.new : <@TTester::@Tester<[@S0, @S1]>>
        // expected-error@+1 {{'poly.unifiable_cast' op input type '!struct.type<@TT3::@T3<[1, 1, @S0, 1, !struct.type<@TT2::@T2<[1]>>]>>' and output type '!struct.type<@TT3::@T3<[!string.type, affine_map<()[s0, s1] -> (s0 + s1)>, 1, @S0, !struct.type<@TT2::@T2<[affine_map<()[s0, s1] -> (s0 + s1)>]>>]>>' are not unifiable}}
        %19 = poly.unifiable_cast %18 : (!struct.type<@TT3::@T3<[1, 1, @S0, 1, !struct.type<@TT2::@T2<[1]>>]>>) -> !struct.type<@TT3::@T3<[!string.type, #map1, 1, @S0, !struct.type<@TT2::@T2<[#map1]>>]>>
        function.return %self : !struct.type<@TTester::@Tester<[@S0, @S1]>>
      }
      function.def @constrain(%self: !struct.type<@TTester::@Tester<[@S0, @S1]>>, %18: !struct.type<@TT3::@T3<[1, 1, @S0, 1, !struct.type<@TT2::@T2<[1]>>]>>) {
        function.return
      }
    }
  }
}

// -----

// `unifiable_cast` cannot be used to specify the field on a felt type.
module attributes {llzk.lang} {
  function.def @unspecified_felt_cannot_become_specified(%input: !felt.type) -> !felt.type<"bn128"> {
    // expected-error@+1 {{'poly.unifiable_cast' op input type '!felt.type' and output type '!felt.type<"bn128">' are not unifiable}}
    %o = poly.unifiable_cast %input : (!felt.type) -> !felt.type<"bn128">
    function.return %o : !felt.type<"bn128">
  }
}

// -----

// `unifiable_cast` cannot erase a specified field from a felt type.
module attributes {llzk.lang} {
  function.def @specified_felt_cannot_become_unspecified(%input: !felt.type<"bn128">) -> !felt.type {
    // expected-error@+1 {{'poly.unifiable_cast' op input type '!felt.type<"bn128">' and output type '!felt.type' are not unifiable}}
    %o = poly.unifiable_cast %input : (!felt.type<"bn128">) -> !felt.type
    function.return %o : !felt.type
  }
}

