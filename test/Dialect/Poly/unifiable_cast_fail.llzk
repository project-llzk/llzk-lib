// -----

#map1 = affine_map<()[s0, s1] -> (s0 + s1)>
module attributes {llzk.lang} {
  poly.template @TT2 {
    poly.param @N

    struct.def @T2 {
      function.def @compute() -> !struct.type<@TT2::@T2<[@N]>> {
        %self = struct.new : <@TT2::@T2<[@N]>>
        function.return %self : !struct.type<@TT2::@T2<[@N]>>
      }
      function.def @constrain(%self : !struct.type<@TT2::@T2<[@N]>>) {
        function.return
      }
    }
  }
  poly.template @TT3 {
    poly.param @A
    poly.param @B
    poly.param @C
    poly.param @D
    poly.param @E

    struct.def @T3 {
      function.def @compute() -> !struct.type<@TT3::@T3<[@A, @B, @C, @D, @E]>> {
        %self = struct.new : <@TT3::@T3<[@A, @B, @C, @D, @E]>>
        function.return %self : !struct.type<@TT3::@T3<[@A, @B, @C, @D, @E]>>
      }
      function.def @constrain(%self : !struct.type<@TT3::@T3<[@A, @B, @C, @D, @E]>>) {
        function.return
      }
    }
  }
  poly.template @TTester {
    poly.param @S0
    poly.param @S1

    struct.def @Tester {
      function.def @compute(%18: !struct.type<@TT3::@T3<[1, 1, @S0, 1, !struct.type<@TT2::@T2<[1]>>]>>) -> !struct.type<@TTester::@Tester<[@S0, @S1]>> {
        %self = struct.new : <@TTester::@Tester<[@S0, @S1]>>
        // expected-error@+1 {{'poly.unifiable_cast' op input type '!struct.type<@TT3::@T3<[1, 1, @S0, 1, !struct.type<@TT2::@T2<[1]>>]>>' and output type '!struct.type<@TT3::@T3<[!string.type, affine_map<()[s0, s1] -> (s0 + s1)>, 1, @S0, !struct.type<@TT2::@T2<[affine_map<()[s0, s1] -> (s0 + s1)>]>>]>>' are not unifiable}}
        %19 = poly.unifiable_cast %18 : (!struct.type<@TT3::@T3<[1, 1, @S0, 1, !struct.type<@TT2::@T2<[1]>>]>>) -> !struct.type<@TT3::@T3<[!string.type, #map1, 1, @S0, !struct.type<@TT2::@T2<[#map1]>>]>>
        function.return %self : !struct.type<@TTester::@Tester<[@S0, @S1]>>
      }
      function.def @constrain(%self: !struct.type<@TTester::@Tester<[@S0, @S1]>>, %18: !struct.type<@TT3::@T3<[1, 1, @S0, 1, !struct.type<@TT2::@T2<[1]>>]>>) {
        function.return
      }
    }
  }
}

// -----

// A specified field cannot be erased and then reselected as another field by a cast chain.
module attributes {llzk.lang} {
  function.def @specified_felt_cannot_be_erased(%input: !felt.type<"bn128">) {
    // expected-error@+1 {{'poly.unifiable_cast' op input type '!felt.type<"bn128">' and output type '!felt.type' would discard a specified felt field}}
    %generic = poly.unifiable_cast %input : (!felt.type<"bn128">) -> !felt.type
    %other_field = poly.unifiable_cast %generic : (!felt.type) -> !felt.type<"babybear">
    function.return
  }
}

// -----

// A type variable must retain the selected field of the value it represents.
module attributes {llzk.lang} {
  function.def @specified_felt_cannot_be_reinterpreted_through_tvar(
      %input: !felt.type<"bn128">) {
    %as_tvar = poly.unifiable_cast %input : (!felt.type<"bn128">) -> !poly.tvar<@T>
    // expected-error@+1 {{'poly.unifiable_cast' op input type '!felt.type<"bn128">' and output type '!felt.type<"babybear">' would discard a specified felt field}}
    %other_field = poly.unifiable_cast %as_tvar : (!poly.tvar<@T>) -> !felt.type<"babybear">
    function.return
  }
}

// -----

// Field preservation applies recursively to aggregate types as well.
module attributes {llzk.lang} {
  function.def @specified_nested_felt_cannot_be_erased(
      %input: !array.type<2 x !felt.type<"bn128">>) {
    // expected-error@+1 {{'poly.unifiable_cast' op input type '!array.type<2 x !felt.type<"bn128">>' and output type '!array.type<2 x !felt.type>' would discard a specified felt field}}
    %generic = poly.unifiable_cast %input : (!array.type<2 x !felt.type<"bn128">>) ->
        !array.type<2 x !felt.type>
    function.return
  }
}

// -----

// Sibling cast uses must agree on the field selected for their shared SSA value.
module attributes {llzk.lang} {
  function.def @unspecified_felt_cannot_be_refined_to_two_fields(%input: !felt.type) {
    // expected-error@+1 {{'poly.unifiable_cast' op result type '!felt.type<"bn128">' conflicts with another unifiable cast refinement of the same value}}
    %bn128 = poly.unifiable_cast %input : (!felt.type) -> !felt.type<"bn128">
    %babybear = poly.unifiable_cast %input : (!felt.type) -> !felt.type<"babybear">
    function.return
  }
}

// -----

// Cast chains must retain sibling refinements made through an intermediate generic cast.
module attributes {llzk.lang} {
  function.def @cast_chain_cannot_hide_conflicting_sibling_refinements(%input: !felt.type) {
    %forwarded = poly.unifiable_cast %input : (!felt.type) -> !felt.type
    // expected-error@+1 {{'poly.unifiable_cast' op result type '!felt.type<"bn128">' conflicts with another unifiable cast refinement of the same value}}
    %bn128 = poly.unifiable_cast %input : (!felt.type) -> !felt.type<"bn128">
    %babybear = poly.unifiable_cast %forwarded : (!felt.type) -> !felt.type<"babybear">
    function.return
  }
}

// -----

// Sibling refinements must compare nested felt fields even when earlier struct parameters differ.
module attributes {llzk.lang} {
  function.def @sibling_casts_detect_late_nested_field_conflict(
      %input: !struct.type<@S<[@N, !felt.type]>>) {
    // expected-error@+1 {{'poly.unifiable_cast' op result type '!struct.type<@S<[1, !felt.type<"bn128">]>>' conflicts with another unifiable cast refinement of the same value}}
    %bn128 = poly.unifiable_cast %input : (!struct.type<@S<[@N, !felt.type]>>) ->
        !struct.type<@S<[1, !felt.type<"bn128">]>>
    %babybear = poly.unifiable_cast %input : (!struct.type<@S<[@N, !felt.type]>>) ->
        !struct.type<@S<[2, !felt.type<"babybear">]>>
    function.return
  }
}

// -----

// Sibling refinements must compare array elements even when their dimensions differ.
module attributes {llzk.lang} {
  function.def @sibling_casts_detect_array_element_field_conflict(
      %input: !array.type<? x !felt.type>) {
    // expected-error@+1 {{'poly.unifiable_cast' op result type '!array.type<1 x !felt.type<"bn128">>' conflicts with another unifiable cast refinement of the same value}}
    %bn128 = poly.unifiable_cast %input : (!array.type<? x !felt.type>) ->
        !array.type<1 x !felt.type<"bn128">>
    %babybear = poly.unifiable_cast %input : (!array.type<? x !felt.type>) ->
        !array.type<2 x !felt.type<"babybear">>
    function.return
  }
}

// -----

// Sibling refinements must compare corresponding POD records past an unrelated type mismatch.
module attributes {llzk.lang} {
  function.def @sibling_casts_detect_pod_record_field_conflict(
      %input: !pod.type<[@other: !poly.tvar<@T>, @value: !felt.type]>) {
    // expected-error@+1 {{'poly.unifiable_cast' op result type '!pod.type<[@other: index, @value: !felt.type<"bn128">]>' conflicts with another unifiable cast refinement of the same value}}
    %bn128 = poly.unifiable_cast %input
        : (!pod.type<[@other: !poly.tvar<@T>, @value: !felt.type]>) ->
              !pod.type<[@other: index, @value: !felt.type<"bn128">]>
    %babybear = poly.unifiable_cast %input
        : (!pod.type<[@other: !poly.tvar<@T>, @value: !felt.type]>) ->
              !pod.type<[@other: i1, @value: !felt.type<"babybear">]>
    function.return
  }
}

// -----

// Sibling casts in a contract must agree on the field selected for their shared input.
module attributes {llzk.lang} {
  struct.def @Target {
    function.def @compute(%input: !felt.type) -> !struct.type<@Target> {
      %self = struct.new : !struct.type<@Target>
      function.return %self : !struct.type<@Target>
    }
    function.def @constrain(%self: !struct.type<@Target>, %input: !felt.type) {
      function.return
    }
  }

  verif.contract @FieldRefinements for @Target
      (%self: !struct.type<@Target>, %input: !felt.type) {
    // expected-error@+1 {{'poly.unifiable_cast' op result type '!felt.type<"bn128">' conflicts with another unifiable cast refinement of the same value}}
    %bn128 = poly.unifiable_cast %input : (!felt.type) -> !felt.type<"bn128">
    %babybear = poly.unifiable_cast %input : (!felt.type) -> !felt.type<"babybear">
    %ok = arith.constant true
    verif.ensure_compute %ok
  }
}
