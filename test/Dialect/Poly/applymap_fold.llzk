// RUN: llzk-opt -split-input-file --canonicalize %s | FileCheck --enable-var-scope %s

function.def @fold_no_operands() -> index {
  %x = poly.applymap() affine_map<() -> (12)>
  function.return %x : index
}
// CHECK-LABEL: module {
// CHECK-NEXT:    function.def @fold_no_operands() -> index {
// CHECK-NEXT:      %[[VAL_0:[0-9a-zA-Z_\.]+]] = arith.constant 12 : index
// CHECK-NEXT:      function.return %[[VAL_0]] : index
// CHECK-NEXT:    }
// CHECK-NEXT:  }
// -----

#map = affine_map<(d0)[s0] -> (d0 * 5 + s0)>
function.def @fold_constant_operands() -> index {
  %c2 = arith.constant 2 : index
  %c3 = arith.constant 3 : index
  %x = poly.applymap(%c2)[%c3] #map
  function.return %x : index
}
// CHECK-LABEL: module {
// CHECK-NEXT:    function.def @fold_constant_operands() -> index {
// CHECK-NEXT:      %[[VAL_0:[0-9a-zA-Z_\.]+]] = arith.constant 13 : index
// CHECK-NEXT:      function.return %[[VAL_0]] : index
// CHECK-NEXT:    }
// CHECK-NEXT:  }
// -----

#map = affine_map<(d0)[s0] -> (d0 * 5 + s0)>
function.def @preserve_dynamic_operand(%arg0: index) -> index {
  %c3 = arith.constant 3 : index
  %x = poly.applymap(%arg0)[%c3] #map
  function.return %x : index
}
// CHECK: #[[$ATTR_0:[0-9a-zA-Z_\.]+]] = affine_map<(d0)[s0] -> (d0 * 5 + s0)>
// CHECK-LABEL: module {
// CHECK-NEXT:    function.def @preserve_dynamic_operand(%[[VAL_0:[0-9a-zA-Z_\.]+]]: index) -> index {
// CHECK-NEXT:      %[[VAL_1:[0-9a-zA-Z_\.]+]] = arith.constant 3 : index
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = poly.applymap (%[[VAL_0]]){{\[}}%[[VAL_1]]] #[[$ATTR_0]]
// CHECK-NEXT:      function.return %[[VAL_2]] : index
// CHECK-NEXT:    }
// CHECK-NEXT:  }
