// -----

module attributes {pcl.prime = #pcl.prime<7>} {
  func.func @fold_eq_lhs_0_and_sub() {
    %a = pcl.var "a" false
    %b = pcl.var "b" false
    %0 = pcl.sub %a, %b 
    %1 = pcl.const 0
    %2 = pcl.eq %1, %0
    pcl.assert %2
    return
  }
}

