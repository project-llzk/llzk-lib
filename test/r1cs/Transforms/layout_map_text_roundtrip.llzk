// RUN: llzk-opt %s --llzk-monomorphize --llzk-evaluate-constraints --llzk-full-direct-r1cs-lowering -o %t.mlir
// RUN: llzk-translate --r1cs-to-binary --r1cs-prime=2013265921 --llzk-layout-map=%t.layout %t.mlir -o %t.r1cs
// RUN: FileCheck %s --input-file=%t.layout

// CHECK: # LLZK layout map v1
// CHECK-NEXT: # signals
// CHECK-NEXT: signal 0{{[[:space:]]+}}main["out"]
// CHECK-NEXT: signal 1{{[[:space:]]+}}arg["input"]
// CHECK-NEXT: # r1cs
// CHECK-NEXT: wire 0{{[[:space:]]+}}<one>
// CHECK-NEXT: wire 1{{[[:space:]]+}}signal 0
// CHECK-NEXT: wire 2{{[[:space:]]+}}signal 1

module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  struct.def @Main {
    struct.member @out : !felt.type<"babybear"> {llzk.pub}
    function.def @compute(%input: !felt.type<"babybear"> {llzk.pub}) -> !struct.type<@Main> {
      %self = struct.new : <@Main>
      struct.writem %self[@out] = %input : !struct.type<@Main>, !felt.type<"babybear">
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>, %input: !felt.type<"babybear"> {llzk.pub}) {
      %out = struct.readm %self[@out] : !struct.type<@Main>, !felt.type<"babybear">
      constrain.eq %out, %input : !felt.type<"babybear">
      function.return
    }
  }
}
