// RUN: split-file %s %t
// RUN: llzk-witgen %t/test.llzk --inputs %t/input.json | FileCheck %s
// RUN: llzk-witgen %t/test.llzk --inputs %t/input.json --backend=execution-engine | FileCheck %s
// RUN: llzk-witgen %t/test.llzk --inputs %t/input.json --output-scope=full-witness | FileCheck %s --check-prefix=FULL
// RUN: llzk-witgen %t/test.llzk --inputs %t/input.json --backend=execution-engine --output-scope=full-witness | FileCheck %s --check-prefix=FULL
// RUN: llzk-witgen %t/test.llzk --inputs %t/input.json --output-wtns %t/witness.wtns > /dev/null
// RUN: od -An -v -t x1 %t/witness.wtns | tr -d ' \n' | FileCheck %s --check-prefix=WTNS

//--- test.llzk

module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  struct.def @Main {
    struct.member @sum : !felt.type<"babybear"> {llzk.pub}
    struct.member @secret : !felt.type<"babybear"> {signal}
    function.def @compute(
      %lhs: !felt.type<"babybear"> {function.arg_name = "lhs"},
      %rhs: !felt.type<"babybear"> {function.arg_name = "rhs"}
    ) -> !struct.type<@Main> {
      %self = struct.new : !struct.type<@Main>
      %sum = felt.add %lhs, %rhs : !felt.type<"babybear">, !felt.type<"babybear">
      struct.writem %self[@sum] = %sum : !struct.type<@Main>, !felt.type<"babybear">
      struct.writem %self[@secret] = %lhs : !struct.type<@Main>, !felt.type<"babybear">
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(
      %self: !struct.type<@Main>, %lhs: !felt.type<"babybear">, %rhs: !felt.type<"babybear">
    ) {
      %sum = struct.readm %self[@sum] : !struct.type<@Main>, !felt.type<"babybear">
      %secret = struct.readm %self[@secret] : !struct.type<@Main>, !felt.type<"babybear">
      %expected = felt.add %lhs, %rhs : !felt.type<"babybear">, !felt.type<"babybear">
      constrain.eq %sum, %expected : !felt.type<"babybear">
      constrain.eq %secret, %lhs : !felt.type<"babybear">
      function.return
    }
  }
}

// CHECK: {
// CHECK-NEXT:   "sum": "9"
// CHECK-NEXT: }

