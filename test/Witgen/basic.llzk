// FULL-NEXT:   "inputs": {
// FULL-NEXT:     "lhs": "4",
// FULL-NEXT:     "rhs": "5"
// FULL-NEXT:   },
// FULL-NEXT:   "signals": {
// FULL-NEXT:     "secret": "4",
// FULL-NEXT:     "sum": "9"
// FULL-NEXT:   }
// FULL-NEXT: }

