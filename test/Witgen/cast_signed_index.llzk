// RUN: split-file %s %t
// RUN: sed 's/babybear/goldilocks/g' %t/babybear.llzk > %t/goldilocks.llzk
// RUN: sed 's/babybear/bn128/g' %t/babybear.llzk > %t/bn128.llzk
// RUN: llzk-opt %t/babybear.llzk --canonicalize > %t/babybear-folded.llzk
// RUN: llzk-witgen %t/babybear.llzk --inputs %t/input.json | FileCheck %s --check-prefix=BABYBEAR
// RUN: llzk-witgen %t/babybear.llzk --inputs %t/input.json --backend=execution-engine | FileCheck %s --check-prefix=BABYBEAR
// RUN: llzk-witgen %t/babybear-folded.llzk --inputs %t/input.json | FileCheck %s --check-prefix=BABYBEAR
// RUN: llzk-witgen %t/babybear-folded.llzk --inputs %t/input.json --backend=execution-engine | FileCheck %s --check-prefix=BABYBEAR
// RUN: llzk-opt %t/goldilocks.llzk --canonicalize > %t/goldilocks-folded.llzk
// RUN: llzk-witgen %t/goldilocks.llzk --inputs %t/input.json | FileCheck %s --check-prefix=GOLDILOCKS
// RUN: llzk-witgen %t/goldilocks.llzk --inputs %t/input.json --backend=execution-engine | FileCheck %s --check-prefix=GOLDILOCKS
// RUN: llzk-witgen %t/goldilocks-folded.llzk --inputs %t/input.json | FileCheck %s --check-prefix=GOLDILOCKS
// RUN: llzk-witgen %t/goldilocks-folded.llzk --inputs %t/input.json --backend=execution-engine | FileCheck %s --check-prefix=GOLDILOCKS
// RUN: llzk-opt %t/bn128.llzk --canonicalize > %t/bn128-folded.llzk
// RUN: llzk-witgen %t/bn128.llzk --inputs %t/input.json | FileCheck %s --check-prefix=BN128
// RUN: llzk-witgen %t/bn128.llzk --inputs %t/input.json --backend=execution-engine | FileCheck %s --check-prefix=BN128
// RUN: llzk-witgen %t/bn128-folded.llzk --inputs %t/input.json | FileCheck %s --check-prefix=BN128
// RUN: llzk-witgen %t/bn128-folded.llzk --inputs %t/input.json --backend=execution-engine | FileCheck %s --check-prefix=BN128

// Both backends must agree with signed constant folding for fields narrower
// than, equal to, and wider than the backend's 64-bit index representation.
// Adding the zero input keeps each runtime cast dynamic after canonicalization.
// The prime boundaries and multiples below use BabyBear: the other two moduli
// are larger than every nonnegative signed index.

//--- babybear.llzk
module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  struct.def @Main {
    struct.member @dynamic : !array.type<13 x !felt.type<"babybear">> {llzk.pub}
    struct.member @folded : !array.type<13 x !felt.type<"babybear">> {llzk.pub}
    struct.member @booleans : !array.type<4 x !felt.type<"babybear">> {llzk.pub}
    function.def @compute(%input: !felt.type<"babybear"> {function.arg_name = "zero"}) -> !struct.type<@Main> attributes {function.allow_non_native_field_ops} {
      %self = struct.new : !struct.type<@Main>
      %base = cast.toindex %input : !felt.type<"babybear">
      %zero = arith.constant 0 : index
      %zero_index = arith.addi %base, %zero : index
      %zero_dynamic = cast.tofelt wrap %zero_index : index, !felt.type<"babybear">
      %zero_folded = cast.tofelt wrap %zero : index, !felt.type<"babybear">
      %one = arith.constant 1 : index
      %one_index = arith.addi %base, %one : index
      %one_dynamic = cast.tofelt wrap %one_index : index, !felt.type<"babybear">
      %one_folded = cast.tofelt wrap %one : index, !felt.type<"babybear">
      %negative = arith.constant -1 : index
      %negative_index = arith.addi %base, %negative : index
      %negative_dynamic = cast.tofelt wrap %negative_index : index, !felt.type<"babybear">
      %negative_folded = cast.tofelt wrap %negative : index, !felt.type<"babybear">
      %minimum = arith.constant -9223372036854775808 : index
      %minimum_index = arith.addi %base, %minimum : index
      %minimum_dynamic = cast.tofelt wrap %minimum_index : index, !felt.type<"babybear">
      %minimum_folded = cast.tofelt wrap %minimum : index, !felt.type<"babybear">
      %maximum = arith.constant 9223372036854775807 : index
      %maximum_index = arith.addi %base, %maximum : index
      %maximum_dynamic = cast.tofelt wrap %maximum_index : index, !felt.type<"babybear">
      %maximum_folded = cast.tofelt wrap %maximum : index, !felt.type<"babybear">
      %below_prime = arith.constant 2013265920 : index
      %below_prime_index = arith.addi %base, %below_prime : index
      %below_prime_dynamic = cast.tofelt wrap %below_prime_index : index, !felt.type<"babybear">
      %below_prime_folded = cast.tofelt wrap %below_prime : index, !felt.type<"babybear">
      %prime = arith.constant 2013265921 : index
      %prime_index = arith.addi %base, %prime : index
      %prime_dynamic = cast.tofelt wrap %prime_index : index, !felt.type<"babybear">
      %prime_folded = cast.tofelt wrap %prime : index, !felt.type<"babybear">
      %above_prime = arith.constant 2013265922 : index
      %above_prime_index = arith.addi %base, %above_prime : index
      %above_prime_dynamic = cast.tofelt wrap %above_prime_index : index, !felt.type<"babybear">
      %above_prime_folded = cast.tofelt wrap %above_prime : index, !felt.type<"babybear">
      %twice_prime = arith.constant 4026531842 : index
      %twice_prime_index = arith.addi %base, %twice_prime : index
      %twice_prime_dynamic = cast.tofelt wrap %twice_prime_index : index, !felt.type<"babybear">
      %twice_prime_folded = cast.tofelt wrap %twice_prime : index, !felt.type<"babybear">
      %below_negative_prime = arith.constant -2013265922 : index
      %below_negative_prime_index = arith.addi %base, %below_negative_prime : index
      %below_negative_prime_dynamic = cast.tofelt wrap %below_negative_prime_index : index, !felt.type<"babybear">
      %below_negative_prime_folded = cast.tofelt wrap %below_negative_prime : index, !felt.type<"babybear">
      %negative_prime = arith.constant -2013265921 : index
      %negative_prime_index = arith.addi %base, %negative_prime : index
      %negative_prime_dynamic = cast.tofelt wrap %negative_prime_index : index, !felt.type<"babybear">
      %negative_prime_folded = cast.tofelt wrap %negative_prime : index, !felt.type<"babybear">
      %above_negative_prime = arith.constant -2013265920 : index
      %above_negative_prime_index = arith.addi %base, %above_negative_prime : index
      %above_negative_prime_dynamic = cast.tofelt wrap %above_negative_prime_index : index, !felt.type<"babybear">
      %above_negative_prime_folded = cast.tofelt wrap %above_negative_prime : index, !felt.type<"babybear">
      %negative_twice_prime = arith.constant -4026531842 : index
      %negative_twice_prime_index = arith.addi %base, %negative_twice_prime : index
      %negative_twice_prime_dynamic = cast.tofelt wrap %negative_twice_prime_index : index, !felt.type<"babybear">
      %negative_twice_prime_folded = cast.tofelt wrap %negative_twice_prime : index, !felt.type<"babybear">
      %true = arith.cmpi eq, %base, %zero : index
      %false = arith.cmpi ne, %base, %zero : index
      %assert_true = cast.tofelt assert %true : i1, !felt.type<"babybear">
      %assert_false = cast.tofelt assert %false : i1, !felt.type<"babybear">
      %wrap_true = cast.tofelt wrap %true : i1, !felt.type<"babybear">
      %wrap_false = cast.tofelt wrap %false : i1, !felt.type<"babybear">
      %dynamic = array.new
          %zero_dynamic, %one_dynamic, %negative_dynamic,
          %minimum_dynamic, %maximum_dynamic, %below_prime_dynamic,
          %prime_dynamic, %above_prime_dynamic, %twice_prime_dynamic,
          %below_negative_prime_dynamic, %negative_prime_dynamic, %above_negative_prime_dynamic,
          %negative_twice_prime_dynamic : !array.type<13 x !felt.type<"babybear">>
      struct.writem %self[@dynamic] = %dynamic : !struct.type<@Main>, !array.type<13 x !felt.type<"babybear">>
      %folded = array.new
          %zero_folded, %one_folded, %negative_folded,
          %minimum_folded, %maximum_folded, %below_prime_folded,
          %prime_folded, %above_prime_folded, %twice_prime_folded,
          %below_negative_prime_folded, %negative_prime_folded, %above_negative_prime_folded,
          %negative_twice_prime_folded : !array.type<13 x !felt.type<"babybear">>
      struct.writem %self[@folded] = %folded : !struct.type<@Main>, !array.type<13 x !felt.type<"babybear">>
      %booleans = array.new
          %assert_true, %assert_false, %wrap_true,
          %wrap_false : !array.type<4 x !felt.type<"babybear">>
      struct.writem %self[@booleans] = %booleans : !struct.type<@Main>, !array.type<4 x !felt.type<"babybear">>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>, %input: !felt.type<"babybear">) {
      function.return
    }
  }
}

