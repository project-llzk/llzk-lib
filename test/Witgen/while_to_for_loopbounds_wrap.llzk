// RUN: split-file %s %t
// RUN: llzk-witgen %t/test.llzk --inputs %t/input.json > %t/original.json
// RUN: diff %t/expected.json %t/original.json
// RUN: llzk-opt %t/test.llzk --llzk-while-to-for --verify-diagnostics > %t/converted.llzk
// RUN: llzk-witgen %t/converted.llzk --inputs %t/input.json > %t/converted.json
// RUN: diff %t/original.json %t/converted.json
// RUN: llzk-opt %t/converted.llzk --canonicalize > %t/folded.llzk
// RUN: llzk-witgen %t/folded.llzk --inputs %t/input.json > %t/folded.json
// RUN: diff %t/original.json %t/folded.json

// Both annotations match the source loops' field values and iteration counts.
// Decimal accumulation makes the output sensitive to the order and number of iterations.
// The interpreter supports runtime wrapping casts; the execution-engine backend does not.

//--- test.llzk
!F = !felt.type<"babybear">
module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  struct.def @Main {
    struct.member @above_modulus : !F {llzk.pub}
    struct.member @cross_modulus : !F {llzk.pub}
    function.def @compute() -> !struct.type<@Main> attributes {function.allow_non_native_field_ops} {
      %self = struct.new : !struct.type<@Main>
      %zero = felt.const 0 : <"babybear">
      %one = felt.const 1 : <"babybear">
      %three = felt.const 3 : <"babybear">
      %four = felt.const 4 : <"babybear">
      %ten = felt.const 10 : <"babybear">
      %reverse = felt.const 2013265920 : <"babybear">

      // Integer IVs p+1, p+2, p+3 reconstruct the original felt sequence 1, 2, 3.
      %above_modulus_end, %above_modulus = scf.while (%i = %one, %acc = %zero) : (!F, !F) -> (!F, !F) {
        %cond = bool.cmp lt(%i, %four) : !F, !F
        scf.condition(%cond) %i, %acc : !F, !F
      } do {
      ^bb0(%i: !F, %acc: !F):
        %shifted = felt.mul %acc, %ten : !F, !F
        %next_acc = felt.add %shifted, %i : !F, !F
        %next = felt.add %i, %one : !F, !F
        scf.yield %next, %next_acc : !F, !F
      } attributes {llzk.loopbounds = #llzk.loopbounds<2013265922 to 2013265925 step 1>}
      struct.writem %self[@above_modulus] = %above_modulus : !struct.type<@Main>, !F

      // Integer IVs 1, p reconstruct 1, 0; the original loop then exits at p-1 >= 3.
      %cross_modulus_end, %cross_modulus = scf.while (%i = %one, %acc = %zero) : (!F, !F) -> (!F, !F) {
        %cond = bool.cmp lt(%i, %three) : !F, !F
        scf.condition(%cond) %i, %acc : !F, !F
      } do {
      ^bb0(%i: !F, %acc: !F):
        %shifted = felt.mul %acc, %ten : !F, !F
        %next_acc = felt.add %shifted, %i : !F, !F
        %next = felt.add %i, %reverse : !F, !F
        scf.yield %next, %next_acc : !F, !F
      } attributes {llzk.loopbounds = #llzk.loopbounds<1 to 4026531841 step 2013265920>}
      struct.writem %self[@cross_modulus] = %cross_modulus : !struct.type<@Main>, !F

      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>) {
      function.return
    }
  }
}

//--- input.json
{}

//--- expected.json
{
  "above_modulus": "123",
  "cross_modulus": "10"
}
