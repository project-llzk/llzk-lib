// RUN: split-file %s %t
// RUN: llzk-witgen %t/test.llzk --inputs %t/input.json --output-scope=full-witness --check-output %t/expected.json
// RUN: llzk-witgen %t/test.llzk --inputs %t/input.json --output-wtns %t/interpreter.wtns --check-output %t/expected.json
// RUN: llzk-witgen %t/test.llzk --inputs %t/input.json --backend=execution-engine --output-wtns %t/jit.wtns --check-output %t/expected.json
// RUN: cmp %t/interpreter.wtns %t/jit.wtns
// RUN: test -s %t/interpreter.wtns

// Unmarked private storage must not add JSON leaves or WTNS wires. Both the
// implicit public signal and the explicitly marked private signal are retained.
// Successful WTNS output also checks the witness count against the R1CS wires.
//--- test.llzk
module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  struct.def @Main {
    struct.member @out : !felt.type<"babybear"> {llzk.pub}
    struct.member @scratch : !felt.type<"babybear">
    struct.member @buffer : !array.type<2 x !felt.type<"babybear">>
    struct.member @ordinary : !felt.type<"babybear"> {signal}

    function.def @compute(
      %input: !felt.type<"babybear"> {function.arg_name = "input"}
    ) -> !struct.type<@Main> attributes {function.allow_non_native_field_ops} {
      %self = struct.new : !struct.type<@Main>
      %scratch = felt.const 42 : !felt.type<"babybear">
      %buffer = array.new %input, %scratch : !array.type<2 x !felt.type<"babybear">>
      struct.writem %self[@scratch] = %scratch : !struct.type<@Main>, !felt.type<"babybear">
      struct.writem %self[@buffer] = %buffer : !struct.type<@Main>, !array.type<2 x !felt.type<"babybear">>
      %square = felt.mul %input, %input : !felt.type<"babybear">, !felt.type<"babybear">
      struct.writem %self[@out] = %square : !struct.type<@Main>, !felt.type<"babybear">
      struct.writem %self[@ordinary] = %square : !struct.type<@Main>, !felt.type<"babybear">
      function.return %self : !struct.type<@Main>
    }

    function.def @constrain(
      %self: !struct.type<@Main>, %input: !felt.type<"babybear">
    ) {
      %out = struct.readm %self[@out] : !struct.type<@Main>, !felt.type<"babybear">
      %ordinary = struct.readm %self[@ordinary] : !struct.type<@Main>, !felt.type<"babybear">
      constrain.eq %out, %ordinary : !felt.type<"babybear">
      function.return
    }
  }
}

//--- input.json
{"input": 4}

//--- expected.json
{"inputs": {"input": "4"}, "signals": {"ordinary": "16", "out": "16"}}
