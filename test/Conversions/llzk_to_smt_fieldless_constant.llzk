// OPT-NEXT:    func.func @smt_ReducedConstant() {
// OPT-NEXT:      %[[VAL_0:[0-9a-zA-Z_\.]+]] = smt.declare_fun "out_c" : !smt.int
// OPT-NEXT:      %[[VAL_1:[0-9a-zA-Z_\.]+]] = smt.declare_fun "out_w" : !smt.int
// OPT-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = smt.int.constant 7
// OPT-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = smt.int.constant 7
// OPT-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = smt.int.cmp ge %[[VAL_0]], %[[VAL_2]]
// OPT-NEXT:      %[[VAL_5:[0-9a-zA-Z_\.]+]] = smt.int.cmp le %[[VAL_0]], %[[VAL_3]]
// OPT-NEXT:      smt.assert %[[VAL_4]]
// OPT-NEXT:      smt.assert %[[VAL_5]]
// OPT-NEXT:      %[[VAL_6:[0-9a-zA-Z_\.]+]] = smt.int.constant 7
// OPT-NEXT:      %[[VAL_7:[0-9a-zA-Z_\.]+]] = smt.int.constant 7
// OPT-NEXT:      %[[VAL_8:[0-9a-zA-Z_\.]+]] = smt.int.cmp ge %[[VAL_1]], %[[VAL_6]]
// OPT-NEXT:      %[[VAL_9:[0-9a-zA-Z_\.]+]] = smt.int.cmp le %[[VAL_1]], %[[VAL_7]]
// OPT-NEXT:      smt.assert %[[VAL_8]]
// OPT-NEXT:      smt.assert %[[VAL_9]]
// OPT-NEXT:      %[[VAL_10:[0-9a-zA-Z_\.]+]] = smt.int.constant 7
// OPT-NEXT:      %[[VAL_11:[0-9a-zA-Z_\.]+]] = smt.eq %[[VAL_1]], %[[VAL_10]] : !smt.int
// OPT-NEXT:      smt.assert %[[VAL_11]]
// OPT-NEXT:      %[[VAL_12:[0-9a-zA-Z_\.]+]] = smt.int.constant 7
// OPT-NEXT:      %[[VAL_13:[0-9a-zA-Z_\.]+]] = smt.eq %[[VAL_0]], %[[VAL_12]] : !smt.int
// OPT-NEXT:      smt.assert %[[VAL_13]]
// OPT-NEXT:      return
// OPT-NEXT:    }
// OPT-NEXT:  }

