// RUN: llzk-opt --llzk-compute-constrain-to-product='root-struct=ReducedConstant' --llzk-to-smt-no-cf='field=babybear' %s | FileCheck %s --check-prefix=OPT
// RUN: llzk-opt --llzk-compute-constrain-to-product='root-struct=ReducedConstant' --llzk-to-smt-no-cf-naive='field=babybear' %s | FileCheck %s --check-prefix=NAIVE

// No canonicalization: the consumer must interpret N modulo its field prime.
module attributes {llzk.lang, llzk.main = !struct.type<@ReducedConstant>} {
  struct.def @ReducedConstant {
    struct.member @out : !felt.type {llzk.pub}
    function.def @compute() -> !struct.type<@ReducedConstant> {
      %self = struct.new : !struct.type<@ReducedConstant>
      %c = felt.const 2013265928 : !felt.type
      struct.writem %self[@out] = %c : !struct.type<@ReducedConstant>, !felt.type
      function.return %self : !struct.type<@ReducedConstant>
    }
    function.def @constrain(%self: !struct.type<@ReducedConstant>) {
      %out = struct.readm %self[@out] : !struct.type<@ReducedConstant>, !felt.type
      %c = felt.const 2013265928 : !felt.type
      constrain.eq %out, %c : !felt.type
      function.return
    }
  }
}

