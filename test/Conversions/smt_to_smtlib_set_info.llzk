// RUN: llzk-translate --smt-to-smtlib  %s | FileCheck %s
// Purpose: generic smt_info.set emission, including structured metadata payloads.

module {
  smt.solver () : () -> () {
    smt_info.set ":llzk-root" "Demo"
    smt_info.set ":notes" (:phase_one pass 7 true)
    smt_info.set ":llzk-stage" "pre"
    smt_info.set ":status" unsat
    smt.check sat {
      smt.yield
    } unknown {
      smt.yield
    } unsat {
      smt.yield
    }
    smt.yield
  }
}

// CHECK:      (set-logic ALL)
// CHECK-NEXT: (set-info :llzk-root "Demo")
// CHECK-NEXT: (set-info :notes (:phase_one pass 7 true))
// CHECK-NEXT: (set-info :llzk-stage "pre")
// CHECK-NEXT: (set-info :status unsat)
// CHECK-NEXT: (check-sat)
