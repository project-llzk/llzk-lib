// RUN: llzk-opt --llzk-compute-constrain-to-product='root-struct=ReducedConstant' --llzk-to-smt-no-cf='field=babybear' %s | FileCheck %s

// No canonicalization: the consumer must interpret N modulo its field prime.
module attributes {llzk.lang, llzk.main = !struct.type<@ReducedConstant>} {
  struct.def @ReducedConstant {
    struct.member @out : !felt.type<"babybear"> {llzk.pub}
    function.def @compute() -> !struct.type<@ReducedConstant> {
      %self = struct.new : !struct.type<@ReducedConstant>
      %c = felt.const 2013265928 : !felt.type<"babybear">
      struct.writem %self[@out] = %c : !struct.type<@ReducedConstant>, !felt.type<"babybear">
      function.return %self : !struct.type<@ReducedConstant>
    }
    function.def @constrain(%self: !struct.type<@ReducedConstant>) {
      %out = struct.readm %self[@out] : !struct.type<@ReducedConstant>, !felt.type<"babybear">
      %c = felt.const 2013265928 : !felt.type<"babybear">
      constrain.eq %out, %c : !felt.type<"babybear">
      function.return
    }
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    func.func @smt_ReducedConstant() {
// CHECK-NEXT:      %[[VAL_0:[0-9a-zA-Z_\.]+]] = smt.declare_fun "out_c" : !smt.int
// CHECK-NEXT:      %[[VAL_1:[0-9a-zA-Z_\.]+]] = smt.declare_fun "out_w" : !smt.int
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = smt.int.constant 7
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = smt.int.constant 7
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = smt.int.cmp ge %[[VAL_0]], %[[VAL_2]]
// CHECK-NEXT:      %[[VAL_5:[0-9a-zA-Z_\.]+]] = smt.int.cmp le %[[VAL_0]], %[[VAL_3]]
// CHECK-NEXT:      smt.assert %[[VAL_4]]
// CHECK-NEXT:      smt.assert %[[VAL_5]]
// CHECK-NEXT:      %[[VAL_6:[0-9a-zA-Z_\.]+]] = smt.int.constant 7
// CHECK-NEXT:      %[[VAL_7:[0-9a-zA-Z_\.]+]] = smt.int.constant 7
// CHECK-NEXT:      %[[VAL_8:[0-9a-zA-Z_\.]+]] = smt.int.cmp ge %[[VAL_1]], %[[VAL_6]]
// CHECK-NEXT:      %[[VAL_9:[0-9a-zA-Z_\.]+]] = smt.int.cmp le %[[VAL_1]], %[[VAL_7]]
// CHECK-NEXT:      smt.assert %[[VAL_8]]
// CHECK-NEXT:      smt.assert %[[VAL_9]]
// CHECK-NEXT:      %[[VAL_10:[0-9a-zA-Z_\.]+]] = smt.int.constant 7
// CHECK-NEXT:      %[[VAL_11:[0-9a-zA-Z_\.]+]] = smt.eq %[[VAL_1]], %[[VAL_10]] : !smt.int
// CHECK-NEXT:      smt.assert %[[VAL_11]]
// CHECK-NEXT:      %[[VAL_12:[0-9a-zA-Z_\.]+]] = smt.int.constant 7
// CHECK-NEXT:      %[[VAL_13:[0-9a-zA-Z_\.]+]] = smt.eq %[[VAL_0]], %[[VAL_12]] : !smt.int
// CHECK-NEXT:      smt.assert %[[VAL_13]]
// CHECK-NEXT:      return
// CHECK-NEXT:    }
// CHECK-NEXT:  }
