// CHECK-NEXT:    func.func @smt_Sum(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !smt.array<[!smt.int -> !smt.int]>) {
// CHECK-NEXT:      %[[VAL_1:[0-9a-zA-Z_\.]+]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !smt.array<[!smt.int -> !smt.int]> to !array.type<8 x !felt.type>
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = smt.declare_fun "arr_c" : !smt.array<[!smt.int -> !smt.int]>
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = builtin.unrealized_conversion_cast %[[VAL_2]] : !smt.array<[!smt.int -> !smt.int]> to !array.type<8 x !felt.type>
