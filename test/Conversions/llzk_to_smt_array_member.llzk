// RUN: llzk-opt --llzk-to-smt-no-cf='field=babybear' %s | FileCheck --enable-var-scope %s

!F = !felt.type
!A = !array.type<8 x !F>
!S = !struct.type<@Sum>

module attributes {llzk.lang} {
    struct.def @Sum {
        struct.member @arr: !A
        function.def @product(%a: !A) -> !S {
            %self = struct.new : !S
            struct.writem %self[@arr] = %a : !S, !A

            %arr_c = struct.readm %self[@arr] : !S, !A
            %c0 = arith.constant 0 : index
            %c1 = arith.constant 1 : index
            %c8 = arith.constant 8 : index
            scf.for %i = %c0 to %c8 step %c1 {
                %x = array.read %a[%i] : !A, !F
                %sum_i = array.read %arr_c[%i] : !A, !F
                constrain.eq %x, %sum_i : !F, !F
            }

            function.return %self : !S
        }
    }
}

