// CHECK-NEXT:        constrain.eq %[[VAL_21]], %[[VAL_6]] : !felt.type<"bn128">, !felt.type<"bn128">
// CHECK-NEXT:        constrain.eq %[[VAL_22]], %[[VAL_6]] : !felt.type<"bn128">, !felt.type<"bn128">
// CHECK-NEXT:        constrain.eq %[[VAL_17]], %[[VAL_6]] : !felt.type<"bn128">, !felt.type<"bn128">
