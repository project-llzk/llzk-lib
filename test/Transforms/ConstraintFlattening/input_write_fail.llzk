// RUN: llzk-opt %s --llzk-flatten-constraints --verify-diagnostics -o /dev/null
module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  function.def @identity(%input: !array.type<2 x !felt.type>) -> !array.type<2 x !felt.type> {
    function.return %input : !array.type<2 x !felt.type>
  }
  function.def @write(%input: !array.type<2 x !felt.type>, %value: !felt.type) {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %returned = function.call @identity(%input) : (!array.type<2 x !felt.type>) -> !array.type<2 x !felt.type>
    // A returned alias remains protected by the enclosing call.
    // Loop-carried values retain the function input's identity.
    %result = scf.for %i = %zero to %one step %one iter_args(%carried = %returned) -> (!array.type<2 x !felt.type>) {
      // expected-error @+1 {{cannot write to function input or original storage}}
      array.write %carried[%zero] = %value : !array.type<2 x !felt.type>, !felt.type
      scf.yield %carried : !array.type<2 x !felt.type>
    }
    function.return
  }
  struct.def @Main {
    function.def @compute(%x: !felt.type) -> !struct.type<@Main> {
      %self = struct.new : <@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>, %x: !felt.type) {
      %local = array.new %x, %x : !array.type<2 x !felt.type>
      function.call @write(%local, %x) : (!array.type<2 x !felt.type>, !felt.type) -> ()
      function.return
    }
  }
}
