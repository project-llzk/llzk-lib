// RUN: llzk-opt %s --llzk-flatten-constraints -split-input-file | FileCheck --enable-var-scope %s --match-full-lines

module attributes {llzk.lang, llzk.fields = #felt.field<"small", 7>, llzk.main = !struct.type<@Main>} {
  struct.def @Main {
    function.def @compute(%x: !felt.type<"bn128">, %y: !felt.type<"bn128">) -> !struct.type<@Main> {
      %self = struct.new : <@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>, %x: !felt.type<"bn128">, %y: !felt.type<"bn128">) attributes {function.allow_non_native_field_ops} {
      %values = array.new %y, %x : !array.type<2 x !felt.type<"bn128">>

      // Valid assertions at both endpoints may disappear, even when unused.
      %zero = felt.const 0 : <"bn128">
      %unused = cast.toindex %zero : !felt.type<"bn128">
      %limit = felt.const 9223372036854775807 : <"bn128">
      %asserted = cast.toindex %limit : !felt.type<"bn128">
      %expected = arith.constant 9223372036854775807 : index
      %valid = arith.cmpi eq, %asserted, %expected : index
      bool.assert %valid

      // Saturation and wrapping must use the index safe range, not int64 casts.
      %large = felt.const 9223372036854775809 : <"bn128">
      %saturated = cast.toindex sat %large : !felt.type<"bn128">
      %atLimit = arith.cmpi eq, %saturated, %expected : index
      bool.assert %atLimit
      %wrapped = cast.toindex wrap %large : !felt.type<"bn128">
      %truncated = cast.toindex trunc %large : !felt.type<"bn128">
      %a = array.read %values[%wrapped] : !array.type<2 x !felt.type<"bn128">>, !felt.type<"bn128">
      %b = array.read %values[%truncated] : !array.type<2 x !felt.type<"bn128">>, !felt.type<"bn128">
      constrain.eq %a, %x : !felt.type<"bn128">, !felt.type<"bn128">
      constrain.eq %b, %x : !felt.type<"bn128">, !felt.type<"bn128">

      // Structural facts can depend on a valid assert-mode integer-to-felt cast.
      %one = arith.constant 1 : index
      %felt = cast.tofelt %one : index, !felt.type<"small">
      %index = cast.toindex %felt : !felt.type<"small">
      %c = array.read %values[%index] : !array.type<2 x !felt.type<"bn128">>, !felt.type<"bn128">
      constrain.eq %c, %x : !felt.type<"bn128">, !felt.type<"bn128">

      // An assertion in a statically untaken branch never executes.
      %false = arith.constant false
      scf.if %false {
        %unreached = cast.toindex %x : !felt.type<"bn128">
        %invalid = arith.constant 7 : index
        %unreachedFelt = cast.tofelt %invalid : index, !felt.type<"small">
      }

      // Valid integer-to-felt assertions at both endpoints remain even when unused.
      %lower = arith.constant 0 : index
      %upper = arith.constant 6 : index
      %assertLower = cast.tofelt %lower : index, !felt.type<"small">
      %assertUpper = cast.tofelt assert %upper : index, !felt.type<"small">

      // Non-assert casts may convert out-of-range values or defer field selection.
      %outside = arith.constant 7 : index
      %saturatedFelt = cast.tofelt sat %outside : index, !felt.type<"small">
      %wrappedFelt = cast.tofelt wrap %outside : index, !felt.type<"small">
      %truncatedFelt = cast.tofelt trunc %outside : index, !felt.type<"small">
      constrain.eq %saturatedFelt, %saturatedFelt : !felt.type<"small">, !felt.type<"small">
      constrain.eq %wrappedFelt, %truncatedFelt : !felt.type<"small">, !felt.type<"small">
      %fieldless = cast.tofelt wrap %one : index, !felt.type
      constrain.eq %fieldless, %fieldless : !felt.type, !felt.type
      function.return
    }
  }
}

// CHECK-LABEL:   struct.def @Main {
// CHECK-NEXT:      function.def @compute(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !felt.type<"bn128">, %[[VAL_1:[0-9a-zA-Z_\.]+]]: !felt.type<"bn128">) -> !struct.type<@Main> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_2:[0-9a-zA-Z_\.]+]] = struct.new : <@Main>
// CHECK-NEXT:        function.return %[[VAL_2]] : !struct.type<@Main>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_3:[0-9a-zA-Z_\.]+]]: !struct.type<@Main>, %[[VAL_4:[0-9a-zA-Z_\.]+]]: !felt.type<"bn128">, %[[VAL_5:[0-9a-zA-Z_\.]+]]: !felt.type<"bn128">) attributes {function.allow_constraint, function.allow_non_native_field_ops} {
// CHECK-NEXT:        constrain.eq %[[VAL_4]], %[[VAL_4]] : !felt.type<"bn128">, !felt.type<"bn128">
// CHECK-NEXT:        constrain.eq %[[VAL_4]], %[[VAL_4]] : !felt.type<"bn128">, !felt.type<"bn128">
// CHECK-NEXT:        %[[VAL_6:[0-9a-zA-Z_\.]+]] = arith.constant 1 : index
// CHECK-NEXT:        %[[VAL_7:[0-9a-zA-Z_\.]+]] = cast.tofelt %[[VAL_6]] : index, !felt.type<"small">
// CHECK-NEXT:        constrain.eq %[[VAL_4]], %[[VAL_4]] : !felt.type<"bn128">, !felt.type<"bn128">
// CHECK-NEXT:        %[[VAL_8:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:        %[[VAL_9:[0-9a-zA-Z_\.]+]] = arith.constant 6 : index
// CHECK-NEXT:        %[[VAL_10:[0-9a-zA-Z_\.]+]] = cast.tofelt %[[VAL_8]] : index, !felt.type<"small">
// CHECK-NEXT:        %[[VAL_11:[0-9a-zA-Z_\.]+]] = cast.tofelt %[[VAL_9]] : index, !felt.type<"small">
// CHECK-NEXT:        %[[VAL_12:[0-9a-zA-Z_\.]+]] = arith.constant 7 : index
// CHECK-NEXT:        %[[VAL_13:[0-9a-zA-Z_\.]+]] = cast.tofelt sat %[[VAL_12]] : index, !felt.type<"small">
// CHECK-NEXT:        %[[VAL_14:[0-9a-zA-Z_\.]+]] = cast.tofelt wrap %[[VAL_12]] : index, !felt.type<"small">
// CHECK-NEXT:        %[[VAL_15:[0-9a-zA-Z_\.]+]] = cast.tofelt trunc %[[VAL_12]] : index, !felt.type<"small">
// CHECK-NEXT:        constrain.eq %[[VAL_13]], %[[VAL_13]] : !felt.type<"small">, !felt.type<"small">
// CHECK-NEXT:        constrain.eq %[[VAL_14]], %[[VAL_15]] : !felt.type<"small">, !felt.type<"small">
// CHECK-NEXT:        %[[VAL_16:[0-9a-zA-Z_\.]+]] = cast.tofelt wrap %[[VAL_6]] : index, !felt.type
// CHECK-NEXT:        constrain.eq %[[VAL_16]], %[[VAL_16]] : !felt.type, !felt.type
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }

// -----

// Only potentially failing assertions need a successful fold.
module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  struct.def @Main {
    function.def @compute(%x: !felt.type<"babybear">, %fieldless: !felt.type) -> !struct.type<@Main> {
      %self = struct.new : <@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>, %x: !felt.type<"babybear">, %fieldless: !felt.type) attributes {function.allow_non_native_field_ops} {
      // Infallible symbolic conversions and their dead users need not fold.
      %implicit = cast.toindex %x : !felt.type<"babybear">
      %explicit = cast.toindex assert %x : !felt.type<"babybear">
      %dead = arith.addi %implicit, %explicit : index
      // A live constant boolean cast also needs no range proof from folding,
      // which deliberately defers unspecified fields.
      %true = arith.constant true
      %boolean = cast.tofelt assert %true : i1
      constrain.eq %boolean, %fieldless : !felt.type, !felt.type
      function.return
    }
  }
}

// CHECK-LABEL:   struct.def @Main {
// CHECK-NEXT:      function.def @compute(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !felt.type<"babybear">, %[[VAL_1:[0-9a-zA-Z_\.]+]]: !felt.type) -> !struct.type<@Main> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_2:[0-9a-zA-Z_\.]+]] = struct.new : <@Main>
// CHECK-NEXT:        function.return %[[VAL_2]] : !struct.type<@Main>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_3:[0-9a-zA-Z_\.]+]]: !struct.type<@Main>, %[[VAL_4:[0-9a-zA-Z_\.]+]]: !felt.type<"babybear">, %[[VAL_5:[0-9a-zA-Z_\.]+]]: !felt.type) attributes {function.allow_constraint, function.allow_non_native_field_ops} {
// CHECK-NEXT:        %[[VAL_6:[0-9a-zA-Z_\.]+]] = arith.constant true
// CHECK-NEXT:        %[[VAL_7:[0-9a-zA-Z_\.]+]] = cast.tofelt %[[VAL_6]] : i1, !felt.type
// CHECK-NEXT:        constrain.eq %[[VAL_7]], %[[VAL_5]] : !felt.type, !felt.type
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
