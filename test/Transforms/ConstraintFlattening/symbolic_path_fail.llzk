// RUN: llzk-opt %s --llzk-flatten-constraints -split-input-file --verify-diagnostics -o /dev/null

// Reject a symbolic scalar array read index.
module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  struct.def @Main {
    struct.member @index : index
    function.def @compute(%x: !felt.type) -> !struct.type<@Main> {
      %self = struct.new : <@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>, %x: !felt.type) {
      %index = struct.readm %self[@index] : !struct.type<@Main>, index
      %local = array.new %x, %x : !array.type<2 x !felt.type>
      // expected-error @+1 {{array path requires compile-time indices}}
      %read = array.read %local[%index] : !array.type<2 x !felt.type>, !felt.type
      function.return
    }
  }
}

