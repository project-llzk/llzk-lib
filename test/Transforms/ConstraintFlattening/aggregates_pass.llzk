// RUN: llzk-opt %s --llzk-flatten-constraints -o %t
// RUN: FileCheck %s --match-full-lines < %t
// RUN: FileCheck %s --check-prefix=NOLOCAL < %t

// CHECK-LABEL: struct.def @Main {
// CHECK:      function.def @constrain(%[[VAL_7:[0-9a-zA-Z_\.]+]]: !struct.type<@Main>, %[[VAL_8:[0-9a-zA-Z_\.]+]]: !array.type<2,2 x !felt.type>) attributes {function.allow_constraint} {
// CHECK-NEXT:        %[[VAL_9:[0-9a-zA-Z_\.]+]] = arith.constant 1 : index
// CHECK-NEXT:        %[[VAL_10:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:        %[[VAL_11:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_8]]{{\[}}%[[VAL_9]], %[[VAL_10]]] : <2,2 x !felt.type>, !felt.type
// CHECK-NEXT:        %[[VAL_12:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:        %[[VAL_13:[0-9a-zA-Z_\.]+]] = arith.constant 1 : index
// CHECK-NEXT:        %[[VAL_14:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_8]]{{\[}}%[[VAL_12]], %[[VAL_13]]] : <2,2 x !felt.type>, !felt.type
// CHECK-NEXT:        %[[VAL_15:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_7]][@out] : <@Main>, !felt.type
// CHECK-NEXT:        %[[VAL_16:[0-9a-zA-Z_\.]+]] = felt.add %[[VAL_11]], %[[VAL_14]] : !felt.type, !felt.type
// CHECK-NEXT:        %[[VAL_17:[0-9a-zA-Z_\.]+]] = felt.add %[[VAL_16]], %[[VAL_14]] : !felt.type, !felt.type
// CHECK-NEXT:        constrain.eq %[[VAL_15]], %[[VAL_17]] : !felt.type, !felt.type
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }

// NOLOCAL-LABEL: struct.def @Main {
// NOLOCAL: function.def @constrain{{.*}}
// NOLOCAL-NOT: {{array\.(new|write|insert|extract)|pod\.(new|write)|scf\.|function\.call}}
// NOLOCAL: function.return

module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  function.def @mutate(%array: !array.type<2 x !felt.type>, %value: !felt.type) -> !felt.type {
    %zero = arith.constant 0 : index
    %localCopy = array.extract %array[] : !array.type<2 x !felt.type>
    array.write %localCopy[%zero] = %value : !array.type<2 x !felt.type>, !felt.type
    %read = array.read %localCopy[%zero] : !array.type<2 x !felt.type>, !felt.type
    function.return %read : !felt.type
  }
  struct.def @Main {
    struct.member @out : !felt.type {signal}
    function.def @compute(%input: !array.type<2,2 x !felt.type>) -> !struct.type<@Main> {
      %self = struct.new : <@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>, %input: !array.type<2,2 x !felt.type>) {
      %zero = arith.constant 0 : index
      %one = arith.constant 1 : index
      %length = array.len %input, %zero : !array.type<2,2 x !felt.type>
      %row = array.extract %input[%one] : !array.type<2,2 x !felt.type>
      %x = array.read %row[%zero] : !array.type<2 x !felt.type>, !felt.type
      %y = array.read %input[%zero, %one] : !array.type<2,2 x !felt.type>, !felt.type
      %local = array.new %x, %y : !array.type<2 x !felt.type>
      %changed = function.call @mutate(%local, %y) : (!array.type<2 x !felt.type>, !felt.type) -> !felt.type
      %original = array.read %local[%zero] : !array.type<2 x !felt.type>, !felt.type
      %pod = pod.new { @item = %original } : !pod.type<[@item: !felt.type]>
      pod.write %pod[@item] = %changed : !pod.type<[@item: !felt.type]>, !felt.type
      %copy = pod.read %pod[@item] : !pod.type<[@item: !felt.type]>, !felt.type
      %out = struct.readm %self[@out] : !struct.type<@Main>, !felt.type
      %sum = scf.for %i = %zero to %length step %one iter_args(%acc = %original) -> (!felt.type) {
        %next = felt.add %acc, %copy : !felt.type, !felt.type
        scf.yield %next : !felt.type
      }
      constrain.eq %out, %sum : !felt.type, !felt.type
      function.return
    }
  }
}
