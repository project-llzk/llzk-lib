// RUN: llzk-opt %s --llzk-expose-child-members --llzk-flatten-constraints -o %t
// RUN: FileCheck %s --match-full-lines < %t
// RUN: FileCheck %s --check-prefix=NOLOCAL < %t
// RUN: llzk-opt %t --llzk-flatten-constraints -o %t.again
// RUN: diff %t %t.again
// RUN: llzk-opt %s --llzk-monomorphize-templates --llzk-expose-child-members --llzk-flatten-constraints -o %t.explicit
// RUN: llzk-opt %s --llzk-constraint-flattening -o %t.pipeline
// RUN: diff %t.explicit %t.pipeline





// CHECK-LABEL: struct.def @Main {
// CHECK:      function.def @constrain(%[[VAL_14:[0-9a-zA-Z_\.]+]]: !struct.type<@Main>, %[[VAL_15:[0-9a-zA-Z_\.]+]]: !felt.type) attributes {function.allow_constraint} {
// CHECK-NEXT:        %[[VAL_16:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_14]][@children] : <@Main>, !array.type<2 x !struct.type<@Child>>
// CHECK-NEXT:        %[[VAL_17:[0-9a-zA-Z_\.]+]] = felt.const  2
// CHECK-NEXT:        %[[VAL_18:[0-9a-zA-Z_\.]+]] = felt.mul %[[VAL_15]], %[[VAL_17]] : !felt.type, !felt.type
// CHECK-NEXT:        %[[VAL_19:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:        %[[VAL_20:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_16]]{{\[}}%[[VAL_19]]] : <2 x !struct.type<@Child>>, !struct.type<@Child>
// CHECK-NEXT:        %[[VAL_21:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_20]][@signal] : <@Child>, !felt.type
// CHECK-NEXT:        constrain.eq %[[VAL_21]], %[[VAL_15]] : !felt.type, !felt.type
// CHECK-NEXT:        %[[VAL_22:[0-9a-zA-Z_\.]+]] = arith.constant 1 : index
// CHECK-NEXT:        %[[VAL_23:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_16]]{{\[}}%[[VAL_22]]] : <2 x !struct.type<@Child>>, !struct.type<@Child>
// CHECK-NEXT:        %[[VAL_24:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_23]][@signal] : <@Child>, !felt.type
// CHECK-NEXT:        constrain.eq %[[VAL_24]], %[[VAL_18]] : !felt.type, !felt.type
// CHECK-NEXT:        %[[VAL_25:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_14]][@out] : <@Main>, !felt.type
// CHECK-NEXT:        %[[VAL_26:[0-9a-zA-Z_\.]+]] = felt.add %[[VAL_15]], %[[VAL_15]] : !felt.type, !felt.type
// CHECK-NEXT:        %[[VAL_27:[0-9a-zA-Z_\.]+]] = felt.add %[[VAL_26]], %[[VAL_15]] : !felt.type, !felt.type
// CHECK-NEXT:        constrain.eq %[[VAL_25]], %[[VAL_27]] : !felt.type, !felt.type
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }

// NOLOCAL-LABEL: struct.def @Main {
// NOLOCAL: function.def @constrain{{.*}}
// NOLOCAL-NOT: {{array\.(new|write|insert|extract)|pod\.(new|write)|scf\.|function\.call}}
// NOLOCAL: function.return

module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  function.def @select(%x: !felt.type, %flag: i1) -> !felt.type {
    %value = scf.if %flag -> (!felt.type) {
      scf.yield %x : !felt.type
    } else {
      %two = felt.const 2
      %result = felt.mul %x, %two : !felt.type, !felt.type
      scf.yield %result : !felt.type
    }
    function.return %value : !felt.type
  }
  struct.def @Child {
    struct.member @signal : !felt.type {signal}
    struct.member @intermediate : !felt.type
    function.def @compute(%x: !felt.type) -> !struct.type<@Child> {
      %self = struct.new : <@Child>
      struct.writem %self[@signal] = %x : !struct.type<@Child>, !felt.type
      struct.writem %self[@intermediate] = %x : !struct.type<@Child>, !felt.type
      function.return %self : !struct.type<@Child>
    }
    function.def @constrain(%self: !struct.type<@Child>, %x: !felt.type) {
      %s = struct.readm %self[@signal] : !struct.type<@Child>, !felt.type
      // A dead non-signal expression must not acquire witness semantics.
      %dead = struct.readm %self[@intermediate] : !struct.type<@Child>, !felt.type
      %unused = felt.add %dead, %x : !felt.type, !felt.type
      constrain.eq %s, %x : !felt.type, !felt.type
      function.return
    }
  }
  struct.def @Main {
    struct.member @children : !array.type<2 x !struct.type<@Child>>
    struct.member @out : !felt.type {llzk.pub}
    function.def @compute(%x: !felt.type) -> !struct.type<@Main> {
      %self = struct.new : <@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>, %x: !felt.type) {
      %children = struct.readm %self[@children] : !struct.type<@Main>, !array.type<2 x !struct.type<@Child>>
      %zero = arith.constant 0 : index
      %two = arith.constant 2 : index
      %one = arith.constant 1 : index
      %true = arith.constant true
      %false = arith.constant false
      %a = function.call @select(%x, %true) : (!felt.type, i1) -> !felt.type
      %b = function.call @select(%x, %false) : (!felt.type, i1) -> !felt.type
      scf.for %i = %zero to %two step %one {
        %flag = arith.cmpi eq, %i, %zero : index
        // SSA-valued arith.select folding must resolve through this iteration.
        %selected = arith.select %flag, %a, %b : !felt.type
        %child = array.read %children[%i] : !array.type<2 x !struct.type<@Child>>, !struct.type<@Child>
        function.call @Child::@constrain(%child, %selected) : (!struct.type<@Child>, !felt.type) -> ()
      }
      %out = struct.readm %self[@out] : !struct.type<@Main>, !felt.type
      %result = scf.for %i = %zero to %two step %one iter_args(%acc = %x) -> (!felt.type) {
        %next = felt.add %acc, %x : !felt.type, !felt.type
        scf.yield %next : !felt.type
      }
      %final = scf.while (%i = %zero) : (index) -> index {
        %test = arith.cmpi slt, %i, %two : index
        scf.condition(%test) %i : index
      } do {
      ^bb0(%iv: index):
        %next = arith.addi %iv, %one : index
        scf.yield %next : index
      }
      %is_two = arith.cmpi eq, %final, %two : index
      bool.assert %is_two
      constrain.eq %out, %result : !felt.type, !felt.type
      function.return
    }
  }
}
