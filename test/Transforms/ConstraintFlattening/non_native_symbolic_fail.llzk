// RUN: llzk-opt %s --split-input-file --llzk-flatten-constraints --verify-diagnostics -o /dev/null

module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  struct.def @Main {
    function.def @compute(%x: !felt.type<"bn128">) -> !struct.type<@Main> {
      %self = struct.new : <@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>, %x: !felt.type<"bn128">) attributes {function.allow_non_native_field_ops} {
      %two = felt.const 2 : !felt.type<"bn128">
      %zero = felt.const 0 : !felt.type<"bn128">
      // expected-error @+1 {{lower non-native operations before constraint flattening}}
      %value = felt.shr %x, %two : !felt.type<"bn128">, !felt.type<"bn128">
      constrain.eq %value, %x : !felt.type<"bn128">, !felt.type<"bn128">
      function.return
    }
  }
}

