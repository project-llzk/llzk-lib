// REQUIRES: with-pcl
// RUN: llzk-opt --llzk-to-pcl -split-input-file -verify-diagnostics %s
// RUN: llzk-opt --llzk-to-pcl="mode=stubbed" -split-input-file -verify-diagnostics %s

// negative: an unused cast must still fail before modular conversion.
module attributes {llzk.lang} {
  struct.def @Main {
    struct.member @out : !felt.type<"koalabear"> {llzk.pub}
    function.def @compute() -> !struct.type<@Main> {
      %self = struct.new : <@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>) {
      %value = arith.constant -1 : index
      // expected-error@+1 {{cast.tofelt assert input is outside the field range [0, p-1]}}
      %unused = cast.tofelt assert %value : index, !felt.type<"koalabear">
      function.return
    }
  }
}

// -----

