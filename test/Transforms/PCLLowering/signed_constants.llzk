// REQUIRES: with-pcl
// RUN: llzk-opt -split-input-file -llzk-to-pcl %s | FileCheck --enable-var-scope %s

// Preserve signed index boundaries and both boolean values during PCL lowering.
module attributes {llzk.lang} {
  struct.def @NegativeIndex {
    struct.member @out : !felt.type<"koalabear"> {llzk.pub}
    function.def @compute() -> !struct.type<@NegativeIndex> {
      %self = struct.new : <@NegativeIndex>
      function.return %self : !struct.type<@NegativeIndex>
    }
    function.def @constrain(%self: !struct.type<@NegativeIndex>) {
      %constant = arith.constant -1 : index
      %felt = cast.tofelt %constant : index, !felt.type<"koalabear">
      %out = struct.readm %self[@out] : !struct.type<@NegativeIndex>, !felt.type<"koalabear">
      constrain.eq %out, %felt : !felt.type<"koalabear">, !felt.type<"koalabear">
      function.return
    }
  }
}
// CHECK-LABEL:    func.func @NegativeIndex() -> !pcl.felt {
// CHECK-NEXT:      %[[VAL_0:[0-9a-zA-Z_\.]+]] = pcl.const -1
// CHECK-NEXT:      %[[VAL_1:[0-9a-zA-Z_\.]+]] = pcl.var "out" true
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = pcl.eq %[[VAL_1]], %[[VAL_0]]
// CHECK-NEXT:      pcl.assert %[[VAL_2]]

// -----

