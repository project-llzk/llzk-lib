// REQUIRES: with-pcl
// RUN: llzk-opt -split-input-file -llzk-to-pcl %s | FileCheck --enable-var-scope %s

// Preserve in-range index boundaries and both boolean values during PCL lowering.
module attributes {llzk.lang} {
  struct.def @ZeroIndex {
    struct.member @out : !felt.type<"koalabear"> {llzk.pub}
    function.def @compute() -> !struct.type<@ZeroIndex> {
      %self = struct.new : <@ZeroIndex>
      function.return %self : !struct.type<@ZeroIndex>
    }
    function.def @constrain(%self: !struct.type<@ZeroIndex>) {
      %constant = arith.constant 0 : index
      %felt = cast.tofelt %constant : index, !felt.type<"koalabear">
      %out = struct.readm %self[@out] : !struct.type<@ZeroIndex>, !felt.type<"koalabear">
      constrain.eq %out, %felt : !felt.type<"koalabear">, !felt.type<"koalabear">
      function.return
    }
  }
}
// CHECK-LABEL: module attributes {pcl.prime = #pcl.prime<2130706433>} {
// CHECK-NEXT:    func.func @ZeroIndex() -> !pcl.felt {
// CHECK-NEXT:      %[[VAL_0:[0-9a-zA-Z_\.]+]] = pcl.const 0
// CHECK-NEXT:      %[[VAL_1:[0-9a-zA-Z_\.]+]] = pcl.var "out" true
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = pcl.eq %[[VAL_1]], %[[VAL_0]]
// CHECK-NEXT:      pcl.assert %[[VAL_2]]
// CHECK-NEXT:      return %[[VAL_1]] : !pcl.felt
// CHECK-NEXT:    }
// CHECK-NEXT:  }

