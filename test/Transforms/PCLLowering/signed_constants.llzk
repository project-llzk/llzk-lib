// -----

module attributes {llzk.lang} {
  struct.def @True {
    struct.member @out : !felt.type<"koalabear"> {llzk.pub}
    function.def @compute() -> !struct.type<@True> {
      %self = struct.new : <@True>
      function.return %self : !struct.type<@True>
    }
    function.def @constrain(%self: !struct.type<@True>) {
      %constant = arith.constant true
      %felt = cast.tofelt %constant : i1, !felt.type<"koalabear">
      %out = struct.readm %self[@out] : !struct.type<@True>, !felt.type<"koalabear">
      constrain.eq %out, %felt : !felt.type<"koalabear">, !felt.type<"koalabear">
      function.return
    }
  }
}
// CHECK-LABEL:    func.func @True() -> !pcl.felt {
// CHECK-NEXT:      %[[VAL_0:[0-9a-zA-Z_\.]+]] = pcl.true
// CHECK-NEXT:      %[[VAL_1:[0-9a-zA-Z_\.]+]] = pcl.asfelt %[[VAL_0]]
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = pcl.var "out" true
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = pcl.eq %[[VAL_2]], %[[VAL_1]]
// CHECK-NEXT:      pcl.assert %[[VAL_3]]

// -----

