// REQUIRES: with-pcl
// RUN: llzk-opt --llzk-full-pcl-lowering %s | FileCheck %s

// Preserve both component functions and their call rather than inlining B into A.
!F = !felt.type<"babybear">
module attributes {llzk.lang, llzk.main = !struct.type<@C::@D::@A>} {
  module @C {
    module @D {
      struct.def @B {
        struct.member @foo : !F {llzk.pub}
        struct.member @secret : !F
        function.def @compute(%in: !F) -> !struct.type<@C::@D::@B> {
          %self = struct.new : <@C::@D::@B>
          function.return %self : !struct.type<@C::@D::@B>
        }
        function.def @constrain(%self: !struct.type<@C::@D::@B>, %in: !F) {
          %foo = struct.readm %self[@foo] : !struct.type<@C::@D::@B>, !F
          %secret = struct.readm %self[@secret] : !struct.type<@C::@D::@B>, !F
          constrain.eq %secret, %in : !F, !F
          constrain.eq %foo, %secret : !F, !F
          function.return
        }
      }
      struct.def @A {
        struct.member @b : !struct.type<@C::@D::@B>
        struct.member @foo : !F
        struct.member @out : !F {llzk.pub}
        function.def @compute(%in: !F) -> !struct.type<@C::@D::@A> {
          %self = struct.new : <@C::@D::@A>
          function.return %self : !struct.type<@C::@D::@A>
        }
        function.def @constrain(%self: !struct.type<@C::@D::@A>, %in: !F) {
          %b = struct.readm %self[@b] : !struct.type<@C::@D::@A>, !struct.type<@C::@D::@B>
          function.call @C::@D::@B::@constrain(%b, %in) : (!struct.type<@C::@D::@B>, !F) -> ()
          %foo = struct.readm %self[@foo] : !struct.type<@C::@D::@A>, !F
          %out = struct.readm %self[@out] : !struct.type<@C::@D::@A>, !F
          %bfoo = struct.readm %b[@foo] : !struct.type<@C::@D::@B>, !F
          %again = struct.readm %self[@foo] : !struct.type<@C::@D::@A>, !F
          constrain.eq %foo, %bfoo : !F, !F
          constrain.eq %out, %again : !F, !F
          function.return
        }
      }
    }
  }
}

// CHECK-LABEL: module attributes {pcl.prime = #pcl.prime<2013265921>} {
// CHECK-NEXT:    func.func @"C::D::B"(%[[CHILD_INPUT:[0-9a-zA-Z_\.]+]]: !pcl.felt) -> !pcl.felt {
// CHECK-NEXT:      %[[CHILD_OUTPUT:[0-9a-zA-Z_\.]+]] = pcl.var "foo" true
// CHECK-NEXT:      %[[CHILD_SECRET:[0-9a-zA-Z_\.]+]] = pcl.var "secret" false
// CHECK-NEXT:      %[[CHILD_SECRET_EQ:[0-9a-zA-Z_\.]+]] = pcl.eq %[[CHILD_SECRET]], %[[CHILD_INPUT]]
// CHECK-NEXT:      pcl.assert %[[CHILD_SECRET_EQ]]
// CHECK-NEXT:      %[[CHILD_OUTPUT_EQ:[0-9a-zA-Z_\.]+]] = pcl.eq %[[CHILD_OUTPUT]], %[[CHILD_SECRET]]
// CHECK-NEXT:      pcl.assert %[[CHILD_OUTPUT_EQ]]
// CHECK-NEXT:      return %[[CHILD_OUTPUT]] : !pcl.felt
// CHECK-NEXT:    }
// CHECK-NEXT:    func.func @"C::D::A"(%[[PARENT_INPUT:[0-9a-zA-Z_\.]+]]: !pcl.felt) -> !pcl.felt {
// CHECK-NEXT:      %[[CHILD_RESULT:[0-9a-zA-Z_\.]+]] = call @"C::D::B"(%[[PARENT_INPUT]]) : (!pcl.felt) -> !pcl.felt
// CHECK-NEXT:      %[[CHILD_MEMBER:[0-9a-zA-Z_\.]+]] = pcl.var "b.foo" false
// CHECK-NEXT:      %[[CHILD_MEMBER_EQ:[0-9a-zA-Z_\.]+]] = pcl.eq %[[CHILD_MEMBER]], %[[CHILD_RESULT]]
// CHECK-NEXT:      pcl.assert %[[CHILD_MEMBER_EQ]]
// CHECK-NEXT:      %[[PARENT_FOO:[0-9a-zA-Z_\.]+]] = pcl.var "foo" false
// CHECK-NEXT:      %[[PARENT_OUTPUT:[0-9a-zA-Z_\.]+]] = pcl.var "out" true
// CHECK-NEXT:      %[[PARENT_FOO_EQ:[0-9a-zA-Z_\.]+]] = pcl.eq %[[PARENT_FOO]], %[[CHILD_MEMBER]]
// CHECK-NEXT:      pcl.assert %[[PARENT_FOO_EQ]]
// CHECK-NEXT:      %[[PARENT_OUTPUT_EQ:[0-9a-zA-Z_\.]+]] = pcl.eq %[[PARENT_OUTPUT]], %[[PARENT_FOO]]
// CHECK-NEXT:      pcl.assert %[[PARENT_OUTPUT_EQ]]
// CHECK-NEXT:      return %[[PARENT_OUTPUT]] : !pcl.felt
// CHECK-NEXT:    }
// CHECK-NEXT:  }
