// REQUIRES: with-pcl
// RUN: llzk-opt --llzk-to-pcl=mode=stubbed %s | FileCheck %s
// RUN: llzk-opt --llzk-to-pcl -verify-diagnostics %s

// Dynamic index assertions require stubs, including when the cast result is
// unused. Constant index and dynamic boolean assertions remain supported.
!F = !felt.type<"koalabear">
module attributes {llzk.lang} {
  function.def @convert(%value: index) -> !F attributes {function.allow_constraint} {
    // expected-error@+1 {{PCL lowering cannot preserve cast.tofelt assert for a non-constant index}}
    %felt = cast.tofelt assert %value : index, !F
    function.return %felt : !F
  }
  function.def @unused_cast(%value: index) attributes {function.allow_constraint} {
    %unused = cast.tofelt assert %value : index, !F
    function.return
  }
  function.def @constant_cast() -> !F attributes {function.allow_constraint} {
    %value = arith.constant 2130706432 : index
    %felt = cast.tofelt assert %value : index, !F
    function.return %felt : !F
  }
  function.def @bool_cast(%value: !F) -> !F attributes {function.allow_constraint} {
    %zero = felt.const 0 : !F
    %is_zero = bool.cmp eq(%value, %zero) : !F, !F
    %felt = cast.tofelt assert %is_zero : i1, !F
    function.return %felt : !F
  }
  struct.def @Main {
    struct.member @out : !F {llzk.pub}
    function.def @compute() -> !struct.type<@Main> {
      %self = struct.new : <@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>) {
      %zero = arith.constant 0 : index
      %felt = function.call @convert(%zero) : (index) -> !F
      function.call @unused_cast(%zero) : (index) -> ()
      %constant = function.call @constant_cast() : () -> !F
      %boolean = function.call @bool_cast(%felt) : (!F) -> !F
      constrain.eq %constant, %boolean : !F, !F
      %out = struct.readm %self[@out] : !struct.type<@Main>, !F
      constrain.eq %out, %felt : !F, !F
      function.return
    }
  }
}
// CHECK-LABEL: module attributes {pcl.prime = #pcl.prime<2130706433>} {
// CHECK-NEXT:    func.func private @convert(!pcl.felt) -> !pcl.felt
// CHECK-NEXT:    func.func private @unused_cast(!pcl.felt)
// CHECK-NEXT:    func.func @constant_cast() -> !pcl.felt {
// CHECK-NEXT:      %[[VAL_0:[0-9a-zA-Z_\.]+]] = pcl.const 2130706432
// CHECK-NEXT:      %[[VAL_1:[0-9a-zA-Z_\.]+]] = pcl.const 2130706432
// CHECK-NEXT:      return %[[VAL_1]] : !pcl.felt
// CHECK-NEXT:    }
// CHECK-NEXT:    func.func @bool_cast(%[[VAL_2:[0-9a-zA-Z_\.]+]]: !pcl.felt) -> !pcl.felt {
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = pcl.const 0
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = pcl.eq %[[VAL_2]], %[[VAL_3]]
// CHECK-NEXT:      %[[VAL_5:[0-9a-zA-Z_\.]+]] = pcl.asfelt %[[VAL_4]]
// CHECK-NEXT:      return %[[VAL_5]] : !pcl.felt
// CHECK-NEXT:    }
// CHECK-NEXT:    func.func @Main() -> !pcl.felt {
// CHECK-NEXT:      %[[VAL_6:[0-9a-zA-Z_\.]+]] = pcl.const 0
// CHECK-NEXT:      %[[VAL_7:[0-9a-zA-Z_\.]+]] = call @convert(%[[VAL_6]]) : (!pcl.felt) -> !pcl.felt
// CHECK-NEXT:      call @unused_cast(%[[VAL_6]]) : (!pcl.felt) -> ()
// CHECK-NEXT:      %[[VAL_8:[0-9a-zA-Z_\.]+]] = call @constant_cast() : () -> !pcl.felt
// CHECK-NEXT:      %[[VAL_9:[0-9a-zA-Z_\.]+]] = call @bool_cast(%[[VAL_7]]) : (!pcl.felt) -> !pcl.felt
// CHECK-NEXT:      %[[VAL_10:[0-9a-zA-Z_\.]+]] = pcl.eq %[[VAL_8]], %[[VAL_9]]
// CHECK-NEXT:      pcl.assert %[[VAL_10]]
// CHECK-NEXT:      %[[VAL_11:[0-9a-zA-Z_\.]+]] = pcl.var "out" true
// CHECK-NEXT:      %[[VAL_12:[0-9a-zA-Z_\.]+]] = pcl.eq %[[VAL_11]], %[[VAL_7]]
// CHECK-NEXT:      pcl.assert %[[VAL_12]]
// CHECK-NEXT:      return %[[VAL_11]] : !pcl.felt
// CHECK-NEXT:    }
// CHECK-NEXT:  }
