// REQUIRES: with-pcl
// RUN: llzk-opt -llzk-to-pcl %s > %t
// RUN: FileCheck --check-prefix=IR %s < %t
// RUN: llzk-translate -pcl-to-lisp -lisp-compressed-lines %t | FileCheck --check-prefix=LISP %s

// Exercise lowering and text export without canonicalization: signed literals
// in a specified field must use nonnegative representatives, including beyond
// 64 bits. Positive and negative values must retain their distinct meanings.
!B = !felt.type<"babybear">
module attributes {llzk.lang} {
  struct.def @SignedLiterals {
    struct.member @minus_one : !B {llzk.pub}
    struct.member @minus_42 : !B {llzk.pub}
    struct.member @large_negative : !B {llzk.pub}
    struct.member @large_positive : !B {llzk.pub}

    function.def @compute() -> !struct.type<@SignedLiterals> attributes {function.allow_witness} {
      %self = struct.new : <@SignedLiterals>
      function.return %self : !struct.type<@SignedLiterals>
    }

    function.def @constrain(%self: !struct.type<@SignedLiterals>) attributes {function.allow_constraint} {
      %minus_one = felt.const -1 : !B
      %minus_42 = felt.const -42 : !B
      %large_negative = felt.const -18446744073709551617 : !B
      %large_positive = felt.const 18446744073709551615 : !B
      %a = struct.readm %self[@minus_one] : !struct.type<@SignedLiterals>, !B
      %b = struct.readm %self[@minus_42] : !struct.type<@SignedLiterals>, !B
      %c = struct.readm %self[@large_negative] : !struct.type<@SignedLiterals>, !B
      %d = struct.readm %self[@large_positive] : !struct.type<@SignedLiterals>, !B
      constrain.eq %a, %minus_one : !B, !B
      constrain.eq %b, %minus_42 : !B, !B
      constrain.eq %c, %large_negative : !B, !B
      constrain.eq %d, %large_positive : !B, !B
      function.return
    }
  }
}


// IR-LABEL: module attributes {pcl.prime = #pcl.prime<2013265921>} {
// IR-NEXT:    func.func @SignedLiterals() -> (!pcl.felt, !pcl.felt, !pcl.felt, !pcl.felt) {
// IR-NEXT:      %[[VAL_0:[0-9a-zA-Z_\.]+]] = pcl.const 2013265920
// IR-NEXT:      %[[VAL_1:[0-9a-zA-Z_\.]+]] = pcl.const 2013265879
// IR-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = pcl.const 841097757
// IR-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = pcl.const 1172168162
// IR-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = pcl.var "minus_one" true
// IR-NEXT:      %[[VAL_5:[0-9a-zA-Z_\.]+]] = pcl.var "minus_42" true
// IR-NEXT:      %[[VAL_6:[0-9a-zA-Z_\.]+]] = pcl.var "large_negative" true
// IR-NEXT:      %[[VAL_7:[0-9a-zA-Z_\.]+]] = pcl.var "large_positive" true
// IR-NEXT:      %[[VAL_8:[0-9a-zA-Z_\.]+]] = pcl.eq %[[VAL_4]], %[[VAL_0]]
// IR-NEXT:      pcl.assert %[[VAL_8]]
// IR-NEXT:      %[[VAL_9:[0-9a-zA-Z_\.]+]] = pcl.eq %[[VAL_5]], %[[VAL_1]]
// IR-NEXT:      pcl.assert %[[VAL_9]]
// IR-NEXT:      %[[VAL_10:[0-9a-zA-Z_\.]+]] = pcl.eq %[[VAL_6]], %[[VAL_2]]
// IR-NEXT:      pcl.assert %[[VAL_10]]
// IR-NEXT:      %[[VAL_11:[0-9a-zA-Z_\.]+]] = pcl.eq %[[VAL_7]], %[[VAL_3]]
// IR-NEXT:      pcl.assert %[[VAL_11]]
// IR-NEXT:      return %[[VAL_4]], %[[VAL_5]], %[[VAL_6]], %[[VAL_7]] : !pcl.felt, !pcl.felt, !pcl.felt, !pcl.felt
// IR-NEXT:    }
// IR-NEXT:  }

// LISP-LABEL: (prime-number 2013265921)
// LISP-NEXT:  (begin-module SignedLiterals)
// LISP-NEXT:  (assert (= minus_one 2013265920))
// LISP-NEXT:  (assert (= minus_42 2013265879))
// LISP-NEXT:  (assert (= large_negative 841097757))
// LISP-NEXT:  (assert (= large_positive 1172168162))
// LISP-NEXT:  (output minus_one)
// LISP-NEXT:  (output minus_42)
// LISP-NEXT:  (output large_negative)
// LISP-NEXT:  (output large_positive)
