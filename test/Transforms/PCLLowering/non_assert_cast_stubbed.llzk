// REQUIRES: with-pcl
// RUN: sed 's/cast.tofelt sat/cast.tofelt wrap/g' %s > %t.wrap.llzk
// RUN: sed 's/cast.tofelt sat/cast.tofelt trunc/g' %s > %t.trunc.llzk
// RUN: llzk-opt --llzk-to-pcl=mode=stubbed %s 2>&1 | FileCheck %s --implicit-check-not='error:'
// RUN: llzk-opt --llzk-to-pcl=mode=stubbed %t.wrap.llzk 2>&1 | FileCheck %s --implicit-check-not='error:'
// RUN: llzk-opt --llzk-to-pcl=mode=stubbed %t.trunc.llzk 2>&1 | FileCheck %s --implicit-check-not='error:'
// RUN: llzk-opt --llzk-to-pcl -verify-diagnostics %s
// RUN: llzk-opt --llzk-to-pcl -verify-diagnostics %t.wrap.llzk
// RUN: llzk-opt --llzk-to-pcl -verify-diagnostics %t.trunc.llzk

// Unsupported dynamic casts in reachable free functions require stubs without
// analysis errors. Full conversion must still diagnose the unsupported cast.
!F = !felt.type<"koalabear">
module attributes {llzk.lang} {
  function.def @convert(%value: index) -> !F attributes {function.allow_constraint} {
    // expected-error@+1 {{failed to legalize operation 'cast.tofelt'}}
    %felt = cast.tofelt sat %value : index, !F
    function.return %felt : !F
  }
  struct.def @Main {
    struct.member @out : !F {llzk.pub}
    function.def @compute() -> !struct.type<@Main> {
      %self = struct.new : <@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>) {
      %zero = arith.constant 0 : index
      %felt = function.call @convert(%zero) : (index) -> !F
      %out = struct.readm %self[@out] : !struct.type<@Main>, !F
      constrain.eq %out, %felt : !F, !F
      function.return
    }
  }
}

// CHECK-LABEL: module attributes {pcl.prime = #pcl.prime<2130706433>} {
// CHECK-NEXT:    func.func private @convert(!pcl.felt) -> !pcl.felt
// CHECK-NEXT:    func.func @Main() -> !pcl.felt {
// CHECK-NEXT:      %[[VAL_0:[0-9a-zA-Z_\.]+]] = pcl.const 0
// CHECK-NEXT:      %[[VAL_1:[0-9a-zA-Z_\.]+]] = call @convert(%[[VAL_0]]) : (!pcl.felt) -> !pcl.felt
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = pcl.var "out" true
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = pcl.eq %[[VAL_2]], %[[VAL_1]]
// CHECK-NEXT:      pcl.assert %[[VAL_3]]
// CHECK-NEXT:      return %[[VAL_2]] : !pcl.felt
// CHECK-NEXT:    }
// CHECK-NEXT:  }
