// RUN: llzk-opt -llzk-constraint-flattening-r1cs-lowering='output-llzk=%t.llzk output-layout=%t.csv' %s -o %t.r1cs.mlir
// RUN: FileCheck %s < %t.r1cs.mlir
// RUN: FileCheck %s --check-prefix=PREPARE < %t.llzk
// RUN: FileCheck %s --check-prefix=CSV < %t.csv
// RUN: llzk-witgen %t.llzk --inputs %S/Inputs/array_degree.json --output-scope=full-witness | FileCheck %s --check-prefix=WITNESS

// Degree lowering must rebuild aggregate input reads in compute and include its
// generated signal in the layout before R1CS conversion.

!F = !felt.type<"babybear">
module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  struct.def @Main {
    struct.member @out : !F {llzk.pub}
    function.def @compute(
      %input: !array.type<2 x !F> {function.arg_name = "input"}
    ) -> !struct.type<@Main> {
      %self = struct.new : <@Main>
      %zero = arith.constant 0 : index
      %x = array.read %input[%zero] : !array.type<2 x !F>, !F
      %square = felt.mul %x, %x : !F, !F
      %cube = felt.mul %square, %x : !F, !F
      struct.writem %self[@out] = %cube : <@Main>, !F
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>, %input: !array.type<2 x !F>) {
      %zero = arith.constant 0 : index
      %x = array.read %input[%zero] : !array.type<2 x !F>, !F
      %square = felt.mul %x, %x : !F, !F
      %cube = felt.mul %square, %x : !F, !F
      %out = struct.readm %self[@out] : <@Main>, !F
      constrain.eq %out, %cube : !F, !F
      function.return
    }
  }
}

// CHECK-LABEL: module attributes {llzk.lang = "r1cs"} {
// CHECK-NEXT:    r1cs.circuit @Main inputs (%[[VAL_0:[0-9a-zA-Z_\.]+]]: !r1cs.signal, %[[VAL_1:[0-9a-zA-Z_\.]+]]: !r1cs.signal) {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = r1cs.def 1 : !r1cs.signal {pub = #r1cs.pub}
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = r1cs.def 4 : !r1cs.signal
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = r1cs.to_linear %[[VAL_0]] : !r1cs.signal to !r1cs.linear
// CHECK-NEXT:      %[[VAL_5:[0-9a-zA-Z_\.]+]] = r1cs.to_linear %[[VAL_3]] : !r1cs.signal to !r1cs.linear
// CHECK-NEXT:      r1cs.constrain %[[VAL_4]], %[[VAL_4]], %[[VAL_5]] : !r1cs.linear
// CHECK-NEXT:      %[[VAL_6:[0-9a-zA-Z_\.]+]] = r1cs.to_linear %[[VAL_2]] : !r1cs.signal to !r1cs.linear
// CHECK-NEXT:      r1cs.constrain %[[VAL_5]], %[[VAL_4]], %[[VAL_6]] : !r1cs.linear
// CHECK-NEXT:    } {r1cs.input_labels = array<i64: 2, 3>}
// CHECK-NEXT:  }

