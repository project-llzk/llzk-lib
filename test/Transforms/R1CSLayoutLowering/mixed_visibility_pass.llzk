// RUN: llzk-opt -llzk-constraint-flattening-r1cs-lowering='output-llzk=%t.llzk output-layout=%t.csv' %s -o %t.mlir
// RUN: FileCheck %s < %t.mlir
// RUN: llzk-opt %t.mlir -o %t.roundtrip.mlir
// RUN: diff %t.mlir %t.roundtrip.mlir
// RUN: llzk-opt %t.llzk -o /dev/null
// RUN: FileCheck %s --check-prefix=CSV < %t.csv
// RUN: llzk-translate --r1cs-to-binary --r1cs-prime=17 %t.mlir -o %t.r1cs
// RUN: od -An -v -t x1 %t.r1cs | tr -d ' \n' | FileCheck %s --check-prefix=BINARY

// LLZK layout order stays structural even when inputs and members interleave
// public and private visibility. R1CS IDs use the binary format's class order.
!F = !felt.type<"babybear">
module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  struct.def @Main {
    struct.member @scratch : !F {signal}
    struct.member @out : !F {llzk.pub}
    struct.member @other : !F {llzk.pub}
    function.def @compute(
      %secret: !F,
      %public: !F,
      %values: !array.type<2 x !F>
    ) -> !struct.type<@Main> {
      %self = struct.new : <@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(
      %self: !struct.type<@Main>,
      %secret: !F {function.arg_name = "secret"},
      %public: !F {function.arg_name = "pub,input", llzk.pub},
      %values: !array.type<2 x !F> {function.arg_name = "values"}
    ) {
      %one = arith.constant 1 : index
      %value = array.read %values[%one] : !array.type<2 x !F>, !F
      %partial = felt.add %secret, %public : !F, !F
      %sum = felt.add %partial, %value : !F, !F
      %out = struct.readm %self[@out] : <@Main>, !F
      constrain.eq %out, %sum : !F, !F
      function.return
    }
  }
}

// CHECK-LABEL: module attributes {llzk.lang = "r1cs"} {
// CHECK-NEXT:    r1cs.circuit @Main inputs (%[[VAL_0:[0-9a-zA-Z_\.]+]]: !r1cs.signal {pub = #r1cs.pub}, %[[VAL_1:[0-9a-zA-Z_\.]+]]: !r1cs.signal, %[[VAL_2:[0-9a-zA-Z_\.]+]]: !r1cs.signal, %[[VAL_3:[0-9a-zA-Z_\.]+]]: !r1cs.signal) {
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = r1cs.def 1 : !r1cs.signal {pub = #r1cs.pub}
// CHECK-NEXT:      %[[VAL_5:[0-9a-zA-Z_\.]+]] = r1cs.def 2 : !r1cs.signal {pub = #r1cs.pub}
// CHECK-NEXT:      %[[VAL_6:[0-9a-zA-Z_\.]+]] = r1cs.def 7 : !r1cs.signal
// CHECK-NEXT:      %[[VAL_7:[0-9a-zA-Z_\.]+]] = r1cs.const 0 : !r1cs.linear
// CHECK-NEXT:      %[[VAL_8:[0-9a-zA-Z_\.]+]] = r1cs.to_linear %[[VAL_1]] : !r1cs.signal to !r1cs.linear
// CHECK-NEXT:      %[[VAL_9:[0-9a-zA-Z_\.]+]] = r1cs.to_linear %[[VAL_0]] : !r1cs.signal to !r1cs.linear
// CHECK-NEXT:      %[[VAL_10:[0-9a-zA-Z_\.]+]] = r1cs.add %[[VAL_8]], %[[VAL_9]] : !r1cs.linear
// CHECK-NEXT:      %[[VAL_11:[0-9a-zA-Z_\.]+]] = r1cs.to_linear %[[VAL_3]] : !r1cs.signal to !r1cs.linear
// CHECK-NEXT:      %[[VAL_12:[0-9a-zA-Z_\.]+]] = r1cs.add %[[VAL_10]], %[[VAL_11]] : !r1cs.linear
// CHECK-NEXT:      %[[VAL_13:[0-9a-zA-Z_\.]+]] = r1cs.to_linear %[[VAL_4]] : !r1cs.signal to !r1cs.linear
// CHECK-NEXT:      %[[VAL_14:[0-9a-zA-Z_\.]+]] = r1cs.mul_const %[[VAL_13]], -1 : !r1cs.linear
// CHECK-NEXT:      %[[VAL_15:[0-9a-zA-Z_\.]+]] = r1cs.add %[[VAL_12]], %[[VAL_14]] : !r1cs.linear
// CHECK-NEXT:      r1cs.constrain %[[VAL_7]], %[[VAL_7]], %[[VAL_15]] : !r1cs.linear
// CHECK-NEXT:    } {r1cs.input_labels = array<i64: 3, 4, 5, 6>}
// CHECK-NEXT:  }

// CSV-LABEL: access_path,llzk_layout_id,r1cs_wire_id
// CSV-NEXT:  "arg[""secret""]",0,4
// CSV-NEXT:  "arg[""pub,input""]",1,3
// CSV-NEXT:  "arg[""values""][0]",2,5
// CSV-NEXT:  "arg[""values""][1]",3,6
// CSV-NEXT:  "main[""scratch""]",4,7
// CSV-NEXT:  "main[""out""]",5,1
// CSV-NEXT:  "main[""other""]",6,2

// BINARY-LABEL: 
