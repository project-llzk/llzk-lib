// RUN: llzk-opt -llzk-r1cs-lowering %s | FileCheck %s

// Shared expression roots use one auxiliary signal and cached wire conversions.
// Reusing a quadratic expression creates one auxiliary signal.

!F = !felt.type<"babybear">
module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  struct.def @Main {
    struct.member @out : !F {llzk.pub}
    function.def @compute(
      %a: !F {function.arg_name = "a"},
      %b: !F {function.arg_name = "b"},
      %c: !F {function.arg_name = "c"},
      %d: !F {function.arg_name = "d"}
    ) -> !struct.type<@Main> {
      %self = struct.new : <@Main>
      %ab = felt.mul %a, %b : !F, !F
      %cd = felt.mul %c, %d : !F, !F
      %sum = felt.add %ab, %cd : !F, !F
      struct.writem %self[@out] = %sum : <@Main>, !F
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>, %a: !F, %b: !F, %c: !F, %d: !F) {
      %ab = felt.mul %a, %b : !F, !F
      %cd = felt.mul %c, %d : !F, !F
      %sum = felt.add %ab, %cd : !F, !F
      %out = struct.readm %self[@out] : <@Main>, !F
      constrain.eq %sum, %out : !F, !F
      // Reuse the expression: preparation must create just one auxiliary signal.
      constrain.eq %sum, %out : !F, !F
      function.return
    }
  }
}

// CHECK-LABEL: module attributes {llzk.lang = "r1cs"} {
// CHECK-NEXT:    r1cs.circuit @Main inputs (%[[VAL_0:[0-9a-zA-Z_\.]+]]: !r1cs.signal, %[[VAL_1:[0-9a-zA-Z_\.]+]]: !r1cs.signal, %[[VAL_2:[0-9a-zA-Z_\.]+]]: !r1cs.signal, %[[VAL_3:[0-9a-zA-Z_\.]+]]: !r1cs.signal) {
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = r1cs.def 1 : !r1cs.signal {pub = #r1cs.pub}
// CHECK-NEXT:      %[[VAL_5:[0-9a-zA-Z_\.]+]] = r1cs.def 6 : !r1cs.signal
// CHECK-NEXT:      %[[VAL_6:[0-9a-zA-Z_\.]+]] = r1cs.to_linear %[[VAL_0]] : !r1cs.signal to !r1cs.linear
// CHECK-NEXT:      %[[VAL_7:[0-9a-zA-Z_\.]+]] = r1cs.to_linear %[[VAL_1]] : !r1cs.signal to !r1cs.linear
// CHECK-NEXT:      %[[VAL_8:[0-9a-zA-Z_\.]+]] = r1cs.to_linear %[[VAL_5]] : !r1cs.signal to !r1cs.linear
// CHECK-NEXT:      r1cs.constrain %[[VAL_6]], %[[VAL_7]], %[[VAL_8]] : !r1cs.linear
// CHECK-NEXT:      %[[VAL_9:[0-9a-zA-Z_\.]+]] = r1cs.to_linear %[[VAL_2]] : !r1cs.signal to !r1cs.linear
// CHECK-NEXT:      %[[VAL_10:[0-9a-zA-Z_\.]+]] = r1cs.to_linear %[[VAL_3]] : !r1cs.signal to !r1cs.linear
// CHECK-NEXT:      %[[VAL_11:[0-9a-zA-Z_\.]+]] = r1cs.to_linear %[[VAL_4]] : !r1cs.signal to !r1cs.linear
// CHECK-NEXT:      %[[VAL_12:[0-9a-zA-Z_\.]+]] = r1cs.mul_const %[[VAL_8]], -1 : !r1cs.linear
// CHECK-NEXT:      %[[VAL_13:[0-9a-zA-Z_\.]+]] = r1cs.add %[[VAL_11]], %[[VAL_12]] : !r1cs.linear
// CHECK-NEXT:      r1cs.constrain %[[VAL_9]], %[[VAL_10]], %[[VAL_13]] : !r1cs.linear
// CHECK-NEXT:      %[[VAL_14:[0-9a-zA-Z_\.]+]] = r1cs.mul_const %[[VAL_8]], -1 : !r1cs.linear
// CHECK-NEXT:      %[[VAL_15:[0-9a-zA-Z_\.]+]] = r1cs.add %[[VAL_11]], %[[VAL_14]] : !r1cs.linear
// CHECK-NEXT:      r1cs.constrain %[[VAL_9]], %[[VAL_10]], %[[VAL_15]] : !r1cs.linear
// CHECK-NEXT:    } {r1cs.input_labels = array<i64: 2, 3, 4, 5>}
// CHECK-NEXT:  }
