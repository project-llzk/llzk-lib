// RUN: llzk-opt -llzk-r1cs-lowering='output-llzk=%t.llzk output-layout=%t.csv' %s -o %t.r1cs.mlir
// RUN: FileCheck %s --check-prefix=CONVERT < %t.r1cs.mlir
// RUN: FileCheck %s --check-prefix=PREPARE < %t.llzk
// RUN: FileCheck %s --check-prefix=CSV < %t.csv
// RUN: llzk-translate --r1cs-to-binary --r1cs-prime=2013265921 %t.r1cs.mlir -o %t.r1cs
// RUN: od -An -v -t x1 %t.r1cs | tr -d ' \n' | FileCheck %s --check-prefix=BINARY
// RUN: llzk-witgen %t.llzk --inputs %S/Inputs/auxiliary.json --output-scope=full-witness | FileCheck %s --check-prefix=WITNESS

// Shared expression roots use one auxiliary signal and cached wire conversions.
// The same conversion emits LLZK with compute assignments, layout CSV, and R1CS.

!F = !felt.type<"babybear">
module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  struct.def @Main {
    struct.member @out : !F {llzk.pub}
    function.def @compute(
      %a: !F {function.arg_name = "a"},
      %b: !F {function.arg_name = "b"},
      %c: !F {function.arg_name = "c"},
      %d: !F {function.arg_name = "d"}
    ) -> !struct.type<@Main> {
      %self = struct.new : <@Main>
      %ab = felt.mul %a, %b : !F, !F
      %cd = felt.mul %c, %d : !F, !F
      %sum = felt.add %ab, %cd : !F, !F
      struct.writem %self[@out] = %sum : <@Main>, !F
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>, %a: !F, %b: !F, %c: !F, %d: !F) {
      %ab = felt.mul %a, %b : !F, !F
      %cd = felt.mul %c, %d : !F, !F
      %sum = felt.add %ab, %cd : !F, !F
      %out = struct.readm %self[@out] : <@Main>, !F
      constrain.eq %sum, %out : !F, !F
      // Reuse the expression: preparation must create just one auxiliary signal.
      constrain.eq %sum, %out : !F, !F
      function.return
    }
  }
}

