// RUN: llzk-opt %s --llzk-expose-child-members --split-input-file --verify-diagnostics -o /dev/null

// Missing referenced specialization

module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  poly.template @Child {
    poly.param @N : index
    struct.def @Child {
      struct.member @out : !felt.type {signal}
      function.def @compute() -> !struct.type<@Child::@Child<[@N]>> {
        %self = struct.new : <@Child::@Child<[@N]>>
        function.return %self : !struct.type<@Child::@Child<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@Child::@Child<[@N]>>) { function.return }
    }
  }
  struct.def @ConcreteChild {
    struct.member @out : !felt.type {signal}
    function.def @compute() -> !struct.type<@ConcreteChild> {
      %self = struct.new : <@ConcreteChild>
      function.return %self : !struct.type<@ConcreteChild>
    }
    function.def @constrain(%self: !struct.type<@ConcreteChild>) { function.return }
  } {poly.specialization_id = 1 : i64, poly.origin = @Child::@Child, poly.arguments = [0 : index]}
  struct.def @Main {
    // expected-error @+1 {{unknown struct specialization in child-member visibility family}}
    struct.member @items : !array.type<1 x !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>> {poly.family = [{indices = [0 : index], specialization = 2 : i64, type = !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>}]}
    function.def @compute() -> !struct.type<@Main> {
      %self = struct.new : <@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>) { function.return }
  }
}

// -----

// Ambiguous referenced specialization

module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  poly.template @Child {
    poly.param @N : index
    struct.def @Child {
      struct.member @out : !felt.type {signal}
      function.def @compute() -> !struct.type<@Child::@Child<[@N]>> {
        %self = struct.new : <@Child::@Child<[@N]>>
        function.return %self : !struct.type<@Child::@Child<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@Child::@Child<[@N]>>) { function.return }
    }
  }
  struct.def @ConcreteChild {
    struct.member @out : !felt.type {signal}
    function.def @compute() -> !struct.type<@ConcreteChild> {
      %self = struct.new : <@ConcreteChild>
      function.return %self : !struct.type<@ConcreteChild>
    }
    function.def @constrain(%self: !struct.type<@ConcreteChild>) { function.return }
  } {poly.specialization_id = 1 : i64, poly.origin = @Child::@Child, poly.arguments = [0 : index]}
  struct.def @Duplicate {
    struct.member @out : !felt.type {signal}
    function.def @compute() -> !struct.type<@Duplicate> {
      %self = struct.new : <@Duplicate>
      function.return %self : !struct.type<@Duplicate>
    }
    function.def @constrain(%self: !struct.type<@Duplicate>) { function.return }
  } {poly.specialization_id = 1 : i64}
  struct.def @Main {
    // expected-error @+1 {{ambiguous struct specialization in child-member visibility family}}
    struct.member @items : !array.type<1 x !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>> {poly.family = [{indices = [0 : index], specialization = 1 : i64, type = !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>}]}
    function.def @compute() -> !struct.type<@Main> {
      %self = struct.new : <@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>) { function.return }
  }
}

// -----

// Wrong specialization origin

module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  poly.template @Child {
    poly.param @N : index
    struct.def @Child {
      struct.member @out : !felt.type {signal}
      function.def @compute() -> !struct.type<@Child::@Child<[@N]>> {
        %self = struct.new : <@Child::@Child<[@N]>>
        function.return %self : !struct.type<@Child::@Child<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@Child::@Child<[@N]>>) { function.return }
    }
  }
  struct.def @ConcreteChild {
    struct.member @out : !felt.type {signal}
    function.def @compute() -> !struct.type<@ConcreteChild> {
      %self = struct.new : <@ConcreteChild>
      function.return %self : !struct.type<@ConcreteChild>
    }
    function.def @constrain(%self: !struct.type<@ConcreteChild>) { function.return }
  } {poly.specialization_id = 1 : i64, poly.origin = @Main, poly.arguments = [0 : index]}
  struct.def @Main {
    // expected-error @+1 {{struct specialization origin does not match child-member visibility family}}
    struct.member @items : !array.type<1 x !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>> {poly.family = [{indices = [0 : index], specialization = 1 : i64, type = !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>}]}
    function.def @compute() -> !struct.type<@Main> {
      %self = struct.new : <@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>) { function.return }
  }
}

// -----

// Missing family metadata

module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  poly.template @Child {
    poly.param @N : index
    struct.def @Child {
      struct.member @out : !felt.type
      function.def @compute() -> !struct.type<@Child::@Child<[@N]>> {
        %self = struct.new : <@Child::@Child<[@N]>>
        function.return %self : !struct.type<@Child::@Child<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@Child::@Child<[@N]>>) { function.return }
    }
  }
  struct.def @Main {
    // expected-error @+1 {{missing concrete struct family element for child-member visibility}}
    struct.member @items : !array.type<1 x !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>>
    function.def @compute() -> !struct.type<@Main> {
      %self = struct.new : <@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>) { function.return }
  }
}
