// RUN: llzk-opt --llzk-fuse-product-loops %s | FileCheck --enable-var-scope %s

module attributes {llzk.lang = "llzk"} {
  struct.def @A {
    struct.member @foo : !felt.type

    function.def @product(%condition: i1) -> !struct.type<@A> {
      %self = struct.new : <@A>

      %computed = scf.if %condition -> !felt.type {
        %zero = felt.const 0
        scf.yield {llzk.fusion_marker = "compute"} %zero : !felt.type
      } else {
        %one = felt.const 1
        scf.yield {llzk.fusion_marker = "compute"} %one : !felt.type
      } {llzk.fusion_marker = "if", product_source = "compute"}

      struct.writem %self[@foo] = %computed : <@A>, !felt.type

      scf.if %condition {
        %expected = felt.const 0
        constrain.eq %computed, %expected : !felt.type
        scf.yield {llzk.fusion_marker = "constrain"}
      } else {
        %expected = felt.const 1
        constrain.eq %computed, %expected : !felt.type
        scf.yield {llzk.fusion_marker = "constrain"}
      } {llzk.fusion_marker = "if", product_source = "constrain"}

      function.return %self : !struct.type<@A>
    }
  }
}

// CHECK-LABEL: module attributes {llzk.lang = "llzk"} {
// CHECK-NEXT:    struct.def @A {
// CHECK-NEXT:      struct.member @foo : !felt.type
// CHECK-NEXT:      function.def @product(%[[VAL_0:[0-9a-zA-Z_\.]+]]: i1) -> !struct.type<@A> attributes {function.allow_constraint, function.allow_witness} {
// CHECK-NEXT:        %[[VAL_1:[0-9a-zA-Z_\.]+]] = struct.new : <@A>
// CHECK-NEXT:        %[[VAL_2:[0-9a-zA-Z_\.]+]] = scf.if %[[VAL_0]] -> (!felt.type) {
// CHECK-NEXT:          %[[VAL_3:[0-9a-zA-Z_\.]+]] = felt.const  0
// CHECK-NEXT:          scf.yield {llzk.fusion_marker = "compute"} %[[VAL_3]] : !felt.type
// CHECK-NEXT:        } else {
// CHECK-NEXT:          %[[VAL_4:[0-9a-zA-Z_\.]+]] = felt.const  1
// CHECK-NEXT:          scf.yield {llzk.fusion_marker = "compute"} %[[VAL_4]] : !felt.type
// CHECK-NEXT:        } {llzk.fusion_marker = "if", product_source = "compute"}
// CHECK-NEXT:        struct.writem %[[VAL_1]][@foo] = %[[VAL_2]] : <@A>, !felt.type
// CHECK-NEXT:        scf.if %[[VAL_0]] {
// CHECK-NEXT:          %[[VAL_5:[0-9a-zA-Z_\.]+]] = felt.const  0
// CHECK-NEXT:          constrain.eq %[[VAL_2]], %[[VAL_5]] : !felt.type, !felt.type
// CHECK-NEXT:        } else {
// CHECK-NEXT:          %[[VAL_6:[0-9a-zA-Z_\.]+]] = felt.const  1
// CHECK-NEXT:          constrain.eq %[[VAL_2]], %[[VAL_6]] : !felt.type, !felt.type
// CHECK-NEXT:        } {llzk.fusion_marker = "if", product_source = "constrain"}
// CHECK-NEXT:        function.return %[[VAL_1]] : !struct.type<@A>
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }
