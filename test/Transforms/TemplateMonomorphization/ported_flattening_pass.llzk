// Ported from ../Flattening/instantiate_structs_pass_3.llzk, chunk 1.
// Add llzk.main; identically named structs in different templates remain distinct.
module attributes {test.scenario = "ported_same_named_structs", llzk.lang, llzk.main = !struct.type<@Main>} {
  poly.template @T1 {
    poly.param @C
    struct.def @MyStruct {
      function.def @compute() -> !struct.type<@T1::@MyStruct<[@C]>> {
        %self = struct.new : !struct.type<@T1::@MyStruct<[@C]>>
        function.return %self : !struct.type<@T1::@MyStruct<[@C]>>
      }
      function.def @constrain(%self: !struct.type<@T1::@MyStruct<[@C]>>) { function.return }
    }
  }
  poly.template @T2 {
    poly.param @C
    struct.def @MyStruct {
      function.def @compute() -> !struct.type<@T2::@MyStruct<[@C]>> {
        %self = struct.new : !struct.type<@T2::@MyStruct<[@C]>>
        function.return %self : !struct.type<@T2::@MyStruct<[@C]>>
      }
      function.def @constrain(%self: !struct.type<@T2::@MyStruct<[@C]>>) { function.return }
    }
  }
  struct.def @Main {
    struct.member @f1 : !struct.type<@T1::@MyStruct<[43]>>
    struct.member @f2 : !struct.type<@T2::@MyStruct<[43]>>
    function.def @compute() -> !struct.type<@Main> {
      %self = struct.new : !struct.type<@Main>
      %x = function.call @T1::@MyStruct::@compute() : () -> (!struct.type<@T1::@MyStruct<[43]>>)
      struct.writem %self[@f1] = %x : !struct.type<@Main>, !struct.type<@T1::@MyStruct<[43]>>
      %y = function.call @T2::@MyStruct::@compute() : () -> (!struct.type<@T2::@MyStruct<[43]>>)
      struct.writem %self[@f2] = %y : !struct.type<@Main>, !struct.type<@T2::@MyStruct<[43]>>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>) {
      function.return
    }
  }
}

