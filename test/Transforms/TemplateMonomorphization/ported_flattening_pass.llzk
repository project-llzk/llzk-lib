// Ported from ../Flattening/instantiate_from_main.llzk, chunk 2.
// A concrete main argument sets the array member dimension.
module attributes {test.scenario = "ported_main_concrete_argument", llzk.lang, llzk.main = !struct.type<@TFoo::@Foo<[27]>>} {
  poly.template @TFoo {
    poly.param @N : index
    struct.def @Foo {
      struct.member @x : !array.type<@N x !felt.type>
      function.def @compute() -> !struct.type<@TFoo::@Foo<[@N]>> {
        %self = struct.new : <@TFoo::@Foo<[@N]>>
        function.return %self : !struct.type<@TFoo::@Foo<[@N]>>
      }
      function.def @constrain(%arg0: !struct.type<@TFoo::@Foo<[@N]>>) {
        function.return
      }
    }
  }
}

