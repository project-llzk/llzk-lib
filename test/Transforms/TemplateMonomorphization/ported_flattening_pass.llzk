// Struct-instantiation cases ported from Flattening; each chunk identifies its source and adaptations.
// Each input adds test.scenario solely to give its FileCheck label a unique name.
// RUN: llzk-opt %s --split-input-file --llzk-monomorphize-templates | FileCheck %s --enable-var-scope
// RUN: llzk-opt %s --split-input-file --llzk-monomorphize-templates --llzk-monomorphize-templates | FileCheck %s --enable-var-scope

// Ported from ../Flattening/instantiate_from_main.llzk, chunk 1.
// Empty arguments instantiate Main once.
module attributes {test.scenario = "ported_main_empty_arguments", llzk.lang, llzk.main = !struct.type<@TBar::@Bar<[]>>} {
  poly.template @TBar {
    struct.def @Bar {
      struct.member @x : !array.type<5 x !felt.type>
      function.def @compute() -> !struct.type<@TBar::@Bar<[]>> {
        %self = struct.new : <@TBar::@Bar<[]>>
        function.return %self : !struct.type<@TBar::@Bar<[]>>
      }
      function.def @constrain(%arg0: !struct.type<@TBar::@Bar<[]>>) {
        function.return
      }
    }
  }
}

