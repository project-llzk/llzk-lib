// Ported from ../Flattening/nested_module_1.llzk, chunk 1.
// A member selects a specialization in an ordinary nested module.
module attributes {test.scenario = "ported_nested_module", llzk.main = !struct.type<@TMain::@Main<[]>>, llzk.lang} {
  module @Bar {
    poly.template @TFoo {
      poly.param @N : index
      struct.def @Foo {
        struct.member @x : !array.type<@N x !felt.type>
        function.def @compute() -> !struct.type<@Bar::@TFoo::@Foo<[@N]>> attributes {function.allow_witness} {
          %self = struct.new : <@Bar::@TFoo::@Foo<[@N]>>
          function.return %self : !struct.type<@Bar::@TFoo::@Foo<[@N]>>
        }
        function.def @constrain(%arg0: !struct.type<@Bar::@TFoo::@Foo<[@N]>>) attributes {function.allow_constraint} {
          function.return
        }
      }
    }
  }
  poly.template @TMain {
    struct.def @Main {
      struct.member @foo : !struct.type<@Bar::@TFoo::@Foo<[1]>>
      function.def @compute() -> !struct.type<@TMain::@Main<[]>> attributes {function.allow_witness} {
        %self = struct.new : <@TMain::@Main<[]>>
        function.return %self : !struct.type<@TMain::@Main<[]>>
      }
      function.def @constrain(%arg0: !struct.type<@TMain::@Main<[]>>) attributes {function.allow_constraint} {
        function.return
      }
    }
  }
}

