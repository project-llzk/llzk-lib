// RUN: llzk-opt %s --split-input-file --llzk-monomorphize-templates | FileCheck %s --enable-var-scope

// Struct substitution must recurse through POD records and array elements,
// including template expressions, empty PODs and the renamed self type.
module attributes {llzk.lang, llzk.main = !struct.type<@Parent::@Parent<[2]>>, test.scenario = "struct_pods"} {
  poly.template @Child {
    poly.param @N : index
    struct.def @Child {
      function.def @compute() -> !struct.type<@Child::@Child<[@N]>> {
        %self = struct.new : <@Child::@Child<[@N]>>
        function.return %self : !struct.type<@Child::@Child<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@Child::@Child<[@N]>>) {
        function.return
      }
    }
  }
  poly.template @Parent {
    poly.param @N : index
    poly.expr @Next {
      %n = poly.read_const @N : index
      %one = arith.constant 1 : index
      %sum = arith.addi %n, %one : index
      poly.yield %sum : index
    }
    struct.def @Parent {
      struct.member @state : !pod.type<[@first: !struct.type<@Child::@Child<[@N]>>, @nested: !pod.type<[@items: !array.type<@N x !pod.type<[@next: !struct.type<@Child::@Child<[@Next]>>]>>, @empty: !pod.type<[]>]>]>
      function.def @compute() -> !struct.type<@Parent::@Parent<[@N]>> {
        %state = pod.new : !pod.type<[@first: !struct.type<@Child::@Child<[@N]>>, @nested: !pod.type<[@items: !array.type<@N x !pod.type<[@next: !struct.type<@Child::@Child<[@Next]>>]>>, @empty: !pod.type<[]>]>]>
        %self = struct.new : <@Parent::@Parent<[@N]>>
        struct.writem %self[@state] = %state : <@Parent::@Parent<[@N]>>, !pod.type<[@first: !struct.type<@Child::@Child<[@N]>>, @nested: !pod.type<[@items: !array.type<@N x !pod.type<[@next: !struct.type<@Child::@Child<[@Next]>>]>>, @empty: !pod.type<[]>]>]>
        %owner = pod.new { @self = %self } : <[@self: !struct.type<@Parent::@Parent<[@N]>>]>
        %same = pod.read %owner[@self] : <[@self: !struct.type<@Parent::@Parent<[@N]>>]>, !struct.type<@Parent::@Parent<[@N]>>
        function.return %same : !struct.type<@Parent::@Parent<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@Parent::@Parent<[@N]>>) { function.return }
    }
  }
}

