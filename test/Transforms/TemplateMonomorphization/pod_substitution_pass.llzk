// CHECK-NEXT:        %[[VAL_15:[0-9a-zA-Z_\.]+]] = struct.new : <@Child__spec_1>
// CHECK-NEXT:        function.return %[[VAL_15]] : !struct.type<@Child__spec_1>
// CHECK-NEXT:      }
