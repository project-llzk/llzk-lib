// CHECK-NEXT:        %[[VAL_12:[0-9a-zA-Z_\.]+]] = pod.new { @self = %[[VAL_11]] }  : <[@self: !struct.type<@Parent__spec_0>]>
// CHECK-NEXT:        %[[VAL_13:[0-9a-zA-Z_\.]+]] = pod.read %[[VAL_12]][@self] : <[@self: !struct.type<@Parent__spec_0>]>, !struct.type<@Parent__spec_0>
// CHECK-NEXT:        function.return %[[VAL_13]] : !struct.type<@Parent__spec_0>
