// CHECK-NEXT:      }
// CHECK-NEXT:    } {poly.arguments = [3 : index], poly.origin = @Child::@Child, poly.specialization_id = 2 : i64}
// CHECK-NEXT:  }

// -----



// Free-function signatures and bodies use the other template type converter.
module attributes {llzk.lang, llzk.main = !struct.type<@Main>, test.scenario = "function_pods"} {
  poly.template @Child {
    poly.param @N : index
    struct.def @Child {
      function.def @compute() -> !struct.type<@Child::@Child<[@N]>> {
        %self = struct.new : <@Child::@Child<[@N]>>
        function.return %self : !struct.type<@Child::@Child<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@Child::@Child<[@N]>>) {
        function.return
      }
    }
  }
  poly.template @Helpers {
    poly.param @N : index
    poly.expr @Next {
      %n = poly.read_const @N : index
      %one = arith.constant 1 : index
      %sum = arith.addi %n, %one : index
      poly.yield %sum : index
    }
    function.def @make() -> !pod.type<[@first: !struct.type<@Child::@Child<[@N]>>, @nested: !pod.type<[@items: !array.type<@N x !pod.type<[@next: !struct.type<@Child::@Child<[@Next]>>]>>, @empty: !pod.type<[]>]>]> {
      %state = pod.new : !pod.type<[@first: !struct.type<@Child::@Child<[@N]>>, @nested: !pod.type<[@items: !array.type<@N x !pod.type<[@next: !struct.type<@Child::@Child<[@Next]>>]>>, @empty: !pod.type<[]>]>]>
      function.return %state : !pod.type<[@first: !struct.type<@Child::@Child<[@N]>>, @nested: !pod.type<[@items: !array.type<@N x !pod.type<[@next: !struct.type<@Child::@Child<[@Next]>>]>>, @empty: !pod.type<[]>]>]>
    }
  }
  struct.def @Main {
    struct.member @state : !pod.type<[@first: !struct.type<@Child::@Child<[2]>>, @nested: !pod.type<[@items: !array.type<2 x !pod.type<[@next: !struct.type<@Child::@Child<[3]>>]>>, @empty: !pod.type<[]>]>]>
    function.def @compute() -> !struct.type<@Main> {
      %state = function.call @Helpers::@make<[2]>() : () -> !pod.type<[@first: !struct.type<@Child::@Child<[2]>>, @nested: !pod.type<[@items: !array.type<2 x !pod.type<[@next: !struct.type<@Child::@Child<[3]>>]>>, @empty: !pod.type<[]>]>]>
      %self = struct.new : <@Main>
      struct.writem %self[@state] = %state : <@Main>, !pod.type<[@first: !struct.type<@Child::@Child<[2]>>, @nested: !pod.type<[@items: !array.type<2 x !pod.type<[@next: !struct.type<@Child::@Child<[3]>>]>>, @empty: !pod.type<[]>]>]>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>) { function.return }
  }
}

