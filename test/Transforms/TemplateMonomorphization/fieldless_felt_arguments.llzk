// CHECK:         struct.def @Main__spec_0 {
// CHECK-NEXT:      struct.member @fielded_literal : !struct.type<@Fielded__spec_1>
// CHECK-NEXT:      struct.member @fielded_forwarded : !struct.type<@Fielded__spec_1>
// CHECK-NEXT:      struct.member @fielded_raw : !struct.type<@Fielded__spec_1>
// CHECK-NEXT:      struct.member @fielded_global : !struct.type<@Fielded__spec_1>
// CHECK-NEXT:      struct.member @fieldless_raw : !struct.type<@Fieldless__spec_2>
// CHECK-NEXT:      struct.member @fieldless_global : !struct.type<@Fieldless__spec_2>
// CHECK-NEXT:      struct.member @fieldless_unreduced : !struct.type<@Fieldless__spec_3>
// CHECK-NEXT:      struct.member @untyped_fielded : !struct.type<@Untyped__spec_4>
// CHECK-NEXT:      struct.member @untyped_fieldless : !struct.type<@Untyped__spec_5>
// CHECK-NEXT:      struct.member @value : !felt.type<"babybear">
