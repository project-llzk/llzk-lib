// RUN: llzk-opt %s --llzk-const-global-propagation --llzk-monomorphize-templates --verify-diagnostics | FileCheck %s

// Verify felt specialization behavior across fielded, fieldless, and untyped parameters:
// - A fielded parameter reduces explicit fielded and fieldless arguments to the declared field.
// - A fieldless parameter preserves raw fieldless arguments without field coercion.
// - An untyped parameter keeps each input's field intact without collapsing across fields.
module attributes {llzk.lang, llzk.main = !struct.type<@Caller::@Main<[#felt<const 2013265924 : !felt.type<"babybear">>]>>} {
  global.def const @GlobalBabyBear : !felt.type<"babybear"> = 2013265924
  global.def const @GlobalFieldless : !felt.type = 3

  poly.template @FieldedChild {
    poly.param @N : !felt.type<"babybear">
    struct.def @Fielded {
      struct.member @value : !felt.type<"babybear">
      function.def @compute() -> !struct.type<@FieldedChild::@Fielded<[@N]>> {
        %n = poly.read_const @N : !felt.type<"babybear">
        %self = struct.new : !struct.type<@FieldedChild::@Fielded<[@N]>>
        struct.writem %self[@value] = %n : !struct.type<@FieldedChild::@Fielded<[@N]>>, !felt.type<"babybear">
        function.return %self : !struct.type<@FieldedChild::@Fielded<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@FieldedChild::@Fielded<[@N]>>) {
        %actual = struct.readm %self[@value] : !struct.type<@FieldedChild::@Fielded<[@N]>>, !felt.type<"babybear">
        %expected = poly.read_const @N : !felt.type<"babybear">
        constrain.eq %actual, %expected : !felt.type<"babybear">, !felt.type<"babybear">
        function.return
      }
    }
  }

  poly.template @FieldlessChild {
    poly.param @N : !felt.type
    struct.def @Fieldless {
      struct.member @value : !felt.type
      function.def @compute() -> !struct.type<@FieldlessChild::@Fieldless<[@N]>> {
        %n = poly.read_const @N : !felt.type
        %self = struct.new : !struct.type<@FieldlessChild::@Fieldless<[@N]>>
        struct.writem %self[@value] = %n : !struct.type<@FieldlessChild::@Fieldless<[@N]>>, !felt.type
        function.return %self : !struct.type<@FieldlessChild::@Fieldless<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@FieldlessChild::@Fieldless<[@N]>>) {
        %actual = struct.readm %self[@value] : !struct.type<@FieldlessChild::@Fieldless<[@N]>>, !felt.type
        %expected = poly.read_const @N : !felt.type
        constrain.eq %actual, %expected : !felt.type
        function.return
      }
    }
  }

  poly.template @UntypedChild {
    poly.param @N
    struct.def @Untyped {
      function.def @compute() -> !struct.type<@UntypedChild::@Untyped<[@N]>> {
        %self = struct.new : !struct.type<@UntypedChild::@Untyped<[@N]>>
        function.return %self : !struct.type<@UntypedChild::@Untyped<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@UntypedChild::@Untyped<[@N]>>) {
        function.return
      }
    }
  }

  poly.template @UntypedValueFunction {
    poly.param @N
    function.def @value() -> !felt.type<"babybear"> {
      %n = poly.read_const @N : !felt.type<"babybear">
      function.return %n : !felt.type<"babybear">
    }
  }

  poly.template @Caller {
    poly.param @N : !felt.type<"babybear">
    struct.def @Main {
      struct.member @fielded_literal : !struct.type<@FieldedChild::@Fielded<[#felt<const 2013265924 : !felt.type<"babybear">>]>>
      struct.member @fielded_forwarded : !struct.type<@FieldedChild::@Fielded<[@N]>>
      struct.member @fielded_raw : !struct.type<@FieldedChild::@Fielded<[#felt<const 3>]>>
      struct.member @fielded_global : !struct.type<@FieldedChild::@Fielded<[@GlobalBabyBear]>>
      struct.member @fieldless_raw : !struct.type<@FieldlessChild::@Fieldless<[#felt<const 3>]>>
      struct.member @fieldless_global : !struct.type<@FieldlessChild::@Fieldless<[@GlobalFieldless]>>
      struct.member @fieldless_unreduced : !struct.type<@FieldlessChild::@Fieldless<[#felt<const 2013265924>]>>
      struct.member @untyped_fielded : !struct.type<@UntypedChild::@Untyped<[@N]>>
      struct.member @untyped_fieldless : !struct.type<@UntypedChild::@Untyped<[#felt<const 3>]>>
      struct.member @value : !felt.type<"babybear">
      function.def @compute() -> !struct.type<@Caller::@Main<[@N]>> {
        %self = struct.new : !struct.type<@Caller::@Main<[@N]>>
        %value = function.call @UntypedValueFunction::@value<[@N]>() : () -> !felt.type<"babybear">
        struct.writem %self[@value] = %value : !struct.type<@Caller::@Main<[@N]>>, !felt.type<"babybear">
        function.return %self : !struct.type<@Caller::@Main<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@Caller::@Main<[@N]>>) {
        %actual = struct.readm %self[@value] : !struct.type<@Caller::@Main<[@N]>>, !felt.type<"babybear">
        %expected = felt.const 3 : <"babybear">
        constrain.eq %actual, %expected : !felt.type<"babybear">, !felt.type<"babybear">
        function.return
      }
    }
  }
}

