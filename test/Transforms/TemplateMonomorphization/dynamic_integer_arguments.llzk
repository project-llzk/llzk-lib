// RUN: llzk-opt %s --split-input-file --llzk-monomorphize-templates | FileCheck %s --enable-var-scope

// Numeric normalization keeps full precision and reduces known-field arguments
// before narrowing to index or using them as specialization keys.
module attributes {llzk.lang, llzk.main = !struct.type<@T::@Child<[#felt<const 9223372036854775807>]>>, test.scenario = "index_max"} {
  poly.template @T {
    poly.param @N : index
    struct.def @Child {
      function.def @compute() -> !struct.type<@T::@Child<[@N]>> {
        %n = poly.read_const @N : index
        %self = struct.new : !struct.type<@T::@Child<[@N]>>
        function.return %self : !struct.type<@T::@Child<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@T::@Child<[@N]>>) { function.return }
    }
  }
}
// CHECK-LABEL: module attributes {llzk.lang, llzk.main = !struct.type<@Child__spec_0>, test.scenario = "index_max"} {
// CHECK:        %[[VAL_3:[0-9a-zA-Z_\.]+]] = arith.constant 9223372036854775807 : index
// CHECK:    } {poly.arguments = [9223372036854775807 : index], poly.origin = @T::@Child, poly.specialization_id = 0 : i64}

// -----

module attributes {llzk.lang, llzk.main = !struct.type<@T::@Child<[#felt<const -1 : !felt.type<"babybear">>]>>, test.scenario = "reduced_index"} {
  poly.template @T {
    poly.param @N : index
    struct.def @Child {
      function.def @compute() -> !struct.type<@T::@Child<[@N]>> {
        %n = poly.read_const @N : index
        %self = struct.new : !struct.type<@T::@Child<[@N]>>
        function.return %self : !struct.type<@T::@Child<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@T::@Child<[@N]>>) { function.return }
    }
  }
}
// CHECK-LABEL: module attributes {llzk.lang, llzk.main = !struct.type<@Child__spec_0>, test.scenario = "reduced_index"} {
// CHECK:        %[[VAL_3:[0-9a-zA-Z_\.]+]] = arith.constant 2013265920 : index
// CHECK:    } {poly.arguments = [2013265920 : index], poly.origin = @T::@Child, poly.specialization_id = 0 : i64}

// -----

module attributes {llzk.lang, llzk.main = !struct.type<@T::@Child<[#felt<const -18446744073709551617>]>>, test.scenario = "reduced_felt"} {
  poly.template @T {
    poly.param @N : !felt.type<"babybear">
    struct.def @Child {
      function.def @compute() -> !struct.type<@T::@Child<[@N]>> {
        %n = poly.read_const @N : !felt.type<"babybear">
        %self = struct.new : !struct.type<@T::@Child<[@N]>>
        function.return %self : !struct.type<@T::@Child<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@T::@Child<[@N]>>) { function.return }
    }
  }
}
// CHECK-LABEL: module attributes {llzk.lang, llzk.main = !struct.type<@Child__spec_0>, test.scenario = "reduced_felt"} {
// CHECK:        %[[VAL_3:[0-9a-zA-Z_\.]+]] = felt.const  841097757 : <"babybear">
// CHECK:    } {poly.arguments = [#felt<const 841097757 : <"babybear">> : !felt.type<"babybear">], poly.origin = @T::@Child, poly.specialization_id = 0 : i64}
