// Folding 1 == 2 selects the else branch: instantiate Child<2>, but not Child<1>.
module attributes {test.scenario = "constant_branch", llzk.lang, llzk.main = !struct.type<@Main>} {
  poly.template @Child {
    poly.param @N : index
    struct.def @Child {
      function.def @compute() -> !struct.type<@Child::@Child<[@N]>> {
        %s = struct.new : !struct.type<@Child::@Child<[@N]>>
        function.return %s : !struct.type<@Child::@Child<[@N]>>
      }
      function.def @constrain(%s: !struct.type<@Child::@Child<[@N]>>) {
        function.return
      }
    }
  }
  struct.def @Main {
    function.def @compute() -> !struct.type<@Main> {
      %one = arith.constant 1 : index
      %two = arith.constant 2 : index
      %condition = arith.cmpi eq, %one, %two : index
      scf.if %condition {
        %a = function.call @Child::@Child::@compute() : () -> !struct.type<@Child::@Child<[1]>>
      } else {
        %b = function.call @Child::@Child::@compute() : () -> !struct.type<@Child::@Child<[2]>>
      }
      %s = struct.new : !struct.type<@Main>
      function.return %s : !struct.type<@Main>
    }
    function.def @constrain(%s: !struct.type<@Main>) {
      function.return
    }
  }
}

