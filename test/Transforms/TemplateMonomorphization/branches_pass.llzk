// Branch evaluation selects specializations and propagates yielded constants.
// RUN: llzk-opt %s --split-input-file --llzk-monomorphize-templates | FileCheck %s --enable-var-scope
// RUN: llzk-opt %s --split-input-file --llzk-monomorphize-templates --llzk-monomorphize-templates | FileCheck %s --enable-var-scope

// An unknown condition discovers Child<2> and Child<4>; a dead free-function call is skipped.
module attributes {test.scenario = "branches", llzk.lang, llzk.main = !struct.type<@Main>} {
  poly.template @Child {
    poly.param @N : index
    struct.def @Child {
      function.def @compute() -> !struct.type<@Child::@Child<[@N]>> {
        %s = struct.new : !struct.type<@Child::@Child<[@N]>>
        function.return %s : !struct.type<@Child::@Child<[@N]>>
      }
      function.def @constrain(%s: !struct.type<@Child::@Child<[@N]>>) {
        function.return
      }
    }
  }
  poly.template @Unsupported {
    poly.param @N : index
    function.def @f() { function.return }
  }
  struct.def @Main {
    function.def @compute(%input: !felt.type) -> !struct.type<@Main> {
      %zero = felt.const 0
      %condition = bool.cmp eq(%input, %zero)
      %false = arith.constant false
      scf.if %false {
        function.call @Unsupported::@f<[3]>() : () -> ()
      }
      scf.if %condition {
        %a = function.call @Child::@Child::@compute() : () -> !struct.type<@Child::@Child<[2]>>
      } else {
        %b = function.call @Child::@Child::@compute() : () -> !struct.type<@Child::@Child<[4]>>
      }
      %s = struct.new : !struct.type<@Main>
      function.return %s : !struct.type<@Main>
    }
    function.def @constrain(%s: !struct.type<@Main>, %input: !felt.type) {
      function.return
    }
  }
}

