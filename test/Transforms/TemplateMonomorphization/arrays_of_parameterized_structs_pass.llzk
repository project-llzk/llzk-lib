// Array dimensions and indices determine element specializations and affine call targets.
// RUN: llzk-opt %s --split-input-file --llzk-monomorphize-templates=max-evaluation-steps=20 | FileCheck %s --enable-var-scope
// RUN: llzk-opt %s --split-input-file --llzk-monomorphize-templates=max-evaluation-steps=20 --llzk-monomorphize-templates=max-evaluation-steps=20 | FileCheck %s --enable-var-scope

// Three array elements and a rolled affine call share Child<0>, Child<1>, and Child<2>.
module attributes {test.scenario = "array_of_parameterized_structs", llzk.lang, llzk.main = !struct.type<@Main>} {
  poly.template @Child {
    poly.param @N : index
    struct.def @Child {
      function.def @compute() -> !struct.type<@Child::@Child<[@N]>> {
        %s = struct.new : !struct.type<@Child::@Child<[@N]>>
        function.return %s : !struct.type<@Child::@Child<[@N]>>
      }
      function.def @constrain(%s: !struct.type<@Child::@Child<[@N]>>) {
        function.return
      }
    }
  }
  struct.def @Main {
    struct.member @children : !array.type<3 x !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>>
    function.def @compute() -> !struct.type<@Main> {
      %zero = arith.constant 0 : index
      %three = arith.constant 3 : index
      %one = arith.constant 1 : index
      scf.for %i = %zero to %three step %one {
        %child = function.call @Child::@Child::@compute(){(%i)} : () -> !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>
      }
      %s = struct.new : !struct.type<@Main>
      function.return %s : !struct.type<@Main>
    }
    function.def @constrain(%s: !struct.type<@Main>) {
      function.return
    }
  }
}

