// Template expressions determine concrete specialization parameters.
// RUN: llzk-opt %s --split-input-file --llzk-monomorphize-templates --verify-diagnostics | FileCheck %s --enable-var-scope
// RUN: llzk-opt %s --split-input-file --llzk-monomorphize-templates --llzk-monomorphize-templates --verify-diagnostics | FileCheck %s --enable-var-scope

// The true branch of Next computes N + 1; Parent<3> discovers Child<4> and Leaf<4>.
module attributes {test.scenario = "expressions", llzk.lang, llzk.main = !struct.type<@Parent::@Parent<[3]>>} {
  poly.template @Leaf {
    poly.param @N : index
    struct.def @Leaf {
      struct.member @values : !array.type<@N x !felt.type>
      function.def @compute() -> !struct.type<@Leaf::@Leaf<[@N]>> {
        %self = struct.new : !struct.type<@Leaf::@Leaf<[@N]>>
        function.return %self : !struct.type<@Leaf::@Leaf<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@Leaf::@Leaf<[@N]>>) {
        function.return
      }
    }
  }
  poly.template @Child {
    poly.param @N : index
    struct.def @Child {
      struct.member @leaf : !struct.type<@Leaf::@Leaf<[@N]>>
      function.def @compute() -> !struct.type<@Child::@Child<[@N]>> {
        %leaf = function.call @Leaf::@Leaf::@compute() : () -> !struct.type<@Leaf::@Leaf<[@N]>>
        %self = struct.new : !struct.type<@Child::@Child<[@N]>>
        function.return %self : !struct.type<@Child::@Child<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@Child::@Child<[@N]>>) {
        function.return
      }
    }
  }
  poly.template @Parent {
    poly.param @N : index
    poly.expr @Next {
      %n = poly.read_const @N : index
      %one = arith.constant 1 : index
      %yes = arith.constant true
      %v = scf.if %yes -> (index) {
        %sum = arith.addi %n, %one : index
        scf.yield %sum : index
      } else {
        scf.yield %n : index
      }
      poly.yield %v : index
    }
    struct.def @Parent {
      function.def @compute() -> !struct.type<@Parent::@Parent<[@N]>> {
        %a = function.call @Child::@Child::@compute() : () -> !struct.type<@Child::@Child<[@Next]>>
        %b = function.call @Child::@Child::@compute() : () -> !struct.type<@Child::@Child<[@Next]>>
        %self = struct.new : !struct.type<@Parent::@Parent<[@N]>>
        function.return %self : !struct.type<@Parent::@Parent<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@Parent::@Parent<[@N]>>) {
        function.return
      }
    }
  }
}

