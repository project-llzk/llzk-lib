// CHECK-NEXT:        struct.member @values : !array.type<@N x !felt.type>
// CHECK-NEXT:        function.def @compute() -> !struct.type<@Leaf::@Leaf<[@N]>> attributes {function.allow_witness} {
// CHECK-NEXT:          %[[VAL_0:[0-9a-zA-Z_\.]+]] = struct.new : <@Leaf::@Leaf<[@N]>>
