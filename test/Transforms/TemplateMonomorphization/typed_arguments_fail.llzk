module attributes {llzk.lang, llzk.main = !struct.type<@Main>, test.scenario = "untyped_negative_unknown_field"} {
  poly.template @ChildTemplate {
    poly.param @N
    struct.def @Child {
      function.def @compute() -> !struct.type<@ChildTemplate::@Child<[@N]>> {
        // expected-error@+1 {{cannot read negative template binding @N as felt without a known field modulus}}
