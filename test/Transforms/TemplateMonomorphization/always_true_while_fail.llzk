// RUN: llzk-opt %s --llzk-monomorphize-templates --split-input-file --verify-diagnostics -o /dev/null

// A literal true condition cannot be changed by any loop-carried value.
module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  struct.def @Main {
    function.def @compute() -> !struct.type<@Main> {
      %self = struct.new : !struct.type<@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>) {
      %true = arith.constant true
      // expected-error @+1 {{specialization discovery cannot execute an always-true while loop}}
      scf.while : () -> () {
        scf.condition(%true)
      } do {
        scf.yield
      }
      function.return
    }
  }
}

// -----

// A boundary predicate is invariant even when its operand is loop-carried.
module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  struct.def @Main {
    function.def @compute(%x: !felt.type<"bn128">) -> !struct.type<@Main> {
      %self = struct.new : !struct.type<@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>, %x: !felt.type<"bn128">) attributes {function.allow_non_native_field_ops} {
      %zero = felt.const 0 : !felt.type<"bn128">
      // expected-error @+1 {{specialization discovery cannot execute an always-true while loop}}
      %result = scf.while (%i = %x) : (!felt.type<"bn128">) -> !felt.type<"bn128"> {
        %condition = bool.cmp ge(%i, %zero) : !felt.type<"bn128">, !felt.type<"bn128">
        scf.condition(%condition) %i : !felt.type<"bn128">
      } do {
      ^bb0(%i: !felt.type<"bn128">):
        scf.yield %i : !felt.type<"bn128">
      }
      function.return
    }
  }
}
