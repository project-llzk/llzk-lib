// Parent<2> and Parent<4> keep separate bindings and discover Child<2> and Child<4>.
module attributes {test.scenario = "discovery_separate_bindings", llzk.lang, llzk.main = !struct.type<@Root>} {
  poly.template @Child {
    poly.param @N : index
    struct.def @Child {
      function.def @compute() -> !struct.type<@Child::@Child<[@N]>> {
        %s = struct.new : !struct.type<@Child::@Child<[@N]>>
        function.return %s : !struct.type<@Child::@Child<[@N]>>
      }
      function.def @constrain(%s: !struct.type<@Child::@Child<[@N]>>) {
        function.return
      }
    }
  }
  poly.template @Parent {
    poly.param @N : index
    poly.expr @Next {
      %n = poly.read_const @N : index
      %one = arith.constant 1 : index
      %next = arith.addi %n, %one : index
      poly.yield %next : index
    }
    struct.def @Parent {
      function.def @compute(%input: !felt.type) -> !struct.type<@Parent::@Parent<[@N]>> {
        %zero = arith.constant 0 : index
        %one = arith.constant 1 : index
        %n = poly.read_const @N : index
        scf.for %i = %zero to %n step %one {
          %child = function.call @Child::@Child::@compute(){(%n)} : () -> !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>
        }
        %self = struct.new : !struct.type<@Parent::@Parent<[@N]>>
        function.return %self : !struct.type<@Parent::@Parent<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@Parent::@Parent<[@N]>>, %input: !felt.type) {
        function.return
      }
    }
  }
  struct.def @Root {
    struct.member @two : !struct.type<@Parent::@Parent<[2]>>
    struct.member @four : !struct.type<@Parent::@Parent<[4]>>
    function.def @compute() -> !struct.type<@Root> {
      %self = struct.new : !struct.type<@Root>
      function.return %self : !struct.type<@Root>
    }
    function.def @constrain(%self: !struct.type<@Root>) {
      function.return
    }
  }
}

