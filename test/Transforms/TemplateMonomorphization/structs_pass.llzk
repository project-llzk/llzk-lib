// Wrapper<Child<3>> discovers nested type arguments and reuses Child<3> and Leaf<3>.
module attributes {test.scenario = "nested_arguments", llzk.lang, llzk.main = !struct.type<@Parent::@Parent<[3]>>} {
  poly.template @Leaf {
    poly.param @N : index
    struct.def @Leaf {
      struct.member @values : !array.type<@N x !felt.type>
      function.def @compute() -> !struct.type<@Leaf::@Leaf<[@N]>> {
        %self = struct.new : !struct.type<@Leaf::@Leaf<[@N]>>
        function.return %self : !struct.type<@Leaf::@Leaf<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@Leaf::@Leaf<[@N]>>) {
        function.return
      }
    }
  }
  poly.template @Child {
    poly.param @N : index
    struct.def @Child {
      struct.member @leaf : !struct.type<@Leaf::@Leaf<[@N]>>
      function.def @compute() -> !struct.type<@Child::@Child<[@N]>> {
        %leaf = function.call @Leaf::@Leaf::@compute() : () -> !struct.type<@Leaf::@Leaf<[@N]>>
        %self = struct.new : !struct.type<@Child::@Child<[@N]>>
        function.return %self : !struct.type<@Child::@Child<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@Child::@Child<[@N]>>) {
        function.return
      }
    }
  }
  poly.template @Wrapper {
    poly.param @T : !poly.tvar<@T>
    struct.def @Wrapper {
      struct.member @value : !poly.tvar<@T>
      function.def @compute() -> !struct.type<@Wrapper::@Wrapper<[@T]>> {
        %s = struct.new : !struct.type<@Wrapper::@Wrapper<[@T]>>
        function.return %s : !struct.type<@Wrapper::@Wrapper<[@T]>>
      }
      function.def @constrain(%s: !struct.type<@Wrapper::@Wrapper<[@T]>>) {
        function.return
      }
    }
  }
  poly.template @Parent {
    poly.param @N : index
    struct.def @Parent {
      struct.member @wrapper : !struct.type<@Wrapper::@Wrapper<[!struct.type<@Child::@Child<[@N]>>]>>
      function.def @compute() -> !struct.type<@Parent::@Parent<[@N]>> {
        %a = function.call @Child::@Child::@compute() : () -> !struct.type<@Child::@Child<[@N]>>
        %b = function.call @Child::@Child::@compute() : () -> !struct.type<@Child::@Child<[@N]>>
        %self = struct.new : !struct.type<@Parent::@Parent<[@N]>>
        function.return %self : !struct.type<@Parent::@Parent<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@Parent::@Parent<[@N]>>) {
        function.return
      }
    }
  }
}

