// Child in an ordinary nested module retains its namespace when specialized and called.
module attributes {test.scenario = "nested_module", llzk.lang, llzk.main = !struct.type<@Parent::@Parent<[3]>>} {
  poly.template @Leaf {
    poly.param @N : index
    struct.def @Leaf {
      struct.member @values : !array.type<@N x !felt.type>
      function.def @compute() -> !struct.type<@Leaf::@Leaf<[@N]>> {
        %self = struct.new : !struct.type<@Leaf::@Leaf<[@N]>>
        function.return %self : !struct.type<@Leaf::@Leaf<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@Leaf::@Leaf<[@N]>>) {
        function.return
      }
    }
  }
  module @Nested {
  poly.template @Child {
    poly.param @N : index
    struct.def @Child {
      struct.member @leaf : !struct.type<@Leaf::@Leaf<[@N]>>
      function.def @compute() -> !struct.type<@Nested::@Child::@Child<[@N]>> {
        %leaf = function.call @Leaf::@Leaf::@compute() : () -> !struct.type<@Leaf::@Leaf<[@N]>>
        %self = struct.new : !struct.type<@Nested::@Child::@Child<[@N]>>
        function.return %self : !struct.type<@Nested::@Child::@Child<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@Nested::@Child::@Child<[@N]>>) {
        function.return
      }
    }
  }
  }
  poly.template @Parent {
    poly.param @N : index
    struct.def @Parent {
      function.def @compute() -> !struct.type<@Parent::@Parent<[@N]>> {
        %a = function.call @Nested::@Child::@Child::@compute() : () -> !struct.type<@Nested::@Child::@Child<[@N]>>
        %b = function.call @Nested::@Child::@Child::@compute() : () -> !struct.type<@Nested::@Child::@Child<[@N]>>
        %self = struct.new : !struct.type<@Parent::@Parent<[@N]>>
        function.return %self : !struct.type<@Parent::@Parent<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@Parent::@Parent<[@N]>>) {
        function.return
      }
    }
  }
}

