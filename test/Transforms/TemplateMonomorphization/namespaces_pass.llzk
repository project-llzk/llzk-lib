// Same-named templates in separate roots stay distinct; insertion also avoids an existing clone name.
module attributes {test.scenario = "namespace_collisions", llzk.lang, llzk.main = !struct.type<@Main>} {
  poly.template @TFoo {
    poly.param @N : index
    struct.def @Foo {
      struct.member @outer_only : !array.type<@N x !felt.type>
      function.def @compute() -> !struct.type<@TFoo::@Foo<[@N]>> {
        %s = struct.new : !struct.type<@TFoo::@Foo<[@N]>>
        function.return %s : !struct.type<@TFoo::@Foo<[@N]>>
      }
      function.def @constrain(%s: !struct.type<@TFoo::@Foo<[@N]>>) { function.return }
    }
  }
  module @Bar attributes {llzk.lang} {
    poly.template @TFoo {
      poly.param @N : index
      struct.def @Foo {
        struct.member @bar_only : !array.type<@N x !felt.type>
        function.def @compute() -> !struct.type<@TFoo::@Foo<[@N]>> {
          %s = struct.new : !struct.type<@TFoo::@Foo<[@N]>>
          function.return %s : !struct.type<@TFoo::@Foo<[@N]>>
        }
        function.def @constrain(%s: !struct.type<@TFoo::@Foo<[@N]>>) { function.return }
      }
    }
    struct.def @Foo__spec_2 {
      function.def @compute() -> !struct.type<@Foo__spec_2> {
        %s = struct.new : !struct.type<@Foo__spec_2>
        function.return %s : !struct.type<@Foo__spec_2>
      }
      function.def @constrain(%s: !struct.type<@Foo__spec_2>) { function.return }
    }
  }
  struct.def @Main {
    struct.member @outer : !struct.type<@TFoo::@Foo<[1]>>
    struct.member @inner : !struct.type<@Bar::@TFoo::@Foo<[1]>>
    function.def @compute() -> !struct.type<@Main> {
      %a = function.call @TFoo::@Foo::@compute() : () -> !struct.type<@TFoo::@Foo<[1]>>
      %b = function.call @Bar::@TFoo::@Foo::@compute() : () -> !struct.type<@Bar::@TFoo::@Foo<[1]>>
      %s = struct.new : !struct.type<@Main>
      function.return %s : !struct.type<@Main>
    }
    function.def @constrain(%s: !struct.type<@Main>) {
      %a = struct.readm %s[@outer] : <@Main>, !struct.type<@TFoo::@Foo<[1]>>
      function.call @TFoo::@Foo::@constrain(%a) : (!struct.type<@TFoo::@Foo<[1]>>) -> ()
      %b = struct.readm %s[@inner] : <@Main>, !struct.type<@Bar::@TFoo::@Foo<[1]>>
      function.call @Bar::@TFoo::@Foo::@constrain(%b) : (!struct.type<@Bar::@TFoo::@Foo<[1]>>) -> ()
      function.return
    }
  }
}

