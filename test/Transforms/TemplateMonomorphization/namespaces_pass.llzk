// Specializations preserve symbol identity across lookup roots.
// RUN: llzk-opt %s --split-input-file --llzk-monomorphize-templates | FileCheck %s --enable-var-scope
// RUN: llzk-opt %s --split-input-file --llzk-monomorphize-templates --llzk-monomorphize-templates | FileCheck %s --enable-var-scope

// Outer and inner requests share Box<Foo<1>>; bindings and method callees use the destination root.
module @Top attributes {test.scenario = "namespace_arguments", llzk.lang, llzk.main = !struct.type<@Main>} {
  module @Bar attributes {llzk.lang} {
    poly.template @TFoo {
      poly.param @N : index
      struct.def @Foo {
        struct.member @value : !array.type<@N x !felt.type>
        function.def @compute() -> !struct.type<@TFoo::@Foo<[@N]>> {
          %s = struct.new : !struct.type<@TFoo::@Foo<[@N]>>
          function.return %s : !struct.type<@TFoo::@Foo<[@N]>>
        }
        function.def @constrain(%s: !struct.type<@TFoo::@Foo<[@N]>>) { function.return }
      }
    }
    poly.template @TBox {
      poly.param @T : !poly.tvar<@T>
      struct.def @Box {
        struct.member @value : !poly.tvar<@T>
        function.def @compute() -> !struct.type<@TBox::@Box<[@T]>> {
          %value = function.call @T::@compute() : () -> !poly.tvar<@T>
          %s = struct.new : !struct.type<@TBox::@Box<[@T]>>
          function.return %s : !struct.type<@TBox::@Box<[@T]>>
        }
        function.def @constrain(%s: !struct.type<@TBox::@Box<[@T]>>) { function.return }
      }
    }
    struct.def @Local {
      struct.member @box : !struct.type<@TBox::@Box<[!struct.type<@TFoo::@Foo<[1]>>]>>
      function.def @compute() -> !struct.type<@Local> {
        %box = function.call @TBox::@Box::@compute() : () -> !struct.type<@TBox::@Box<[!struct.type<@TFoo::@Foo<[1]>>]>>
        %s = struct.new : !struct.type<@Local>
        function.return %s : !struct.type<@Local>
      }
      function.def @constrain(%s: !struct.type<@Local>) { function.return }
    }
  }
  struct.def @Main {
    struct.member @box : !struct.type<@Bar::@TBox::@Box<[!struct.type<@Bar::@TFoo::@Foo<[1]>>]>>
    struct.member @local : !struct.type<@Bar::@Local>
    function.def @compute() -> !struct.type<@Main> {
      %box = function.call @Bar::@TBox::@Box::@compute() : () -> !struct.type<@Bar::@TBox::@Box<[!struct.type<@Bar::@TFoo::@Foo<[1]>>]>>
      %local = function.call @Bar::@Local::@compute() : () -> !struct.type<@Bar::@Local>
      %s = struct.new : !struct.type<@Main>
      function.return %s : !struct.type<@Main>
    }
    function.def @constrain(%s: !struct.type<@Main>) { function.return }
  }
}

