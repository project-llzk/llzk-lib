// -----

// A known empty array produces no specializations and an empty candidate list.
module attributes {llzk.lang, llzk.main = !struct.type<@Main>, test.scenario = "empty_array_call"} {
  poly.template @Child {
    poly.param @N : index
    struct.def @Child {
      function.def @compute() -> !struct.type<@Child::@Child<[@N]>> {
        %s = struct.new : !struct.type<@Child::@Child<[@N]>>
        function.return %s : !struct.type<@Child::@Child<[@N]>>
      }
      function.def @constrain(%s: !struct.type<@Child::@Child<[@N]>>) { function.return }
    }
  }
  struct.def @Main {
    struct.member @items : !array.type<0 x !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>>
    function.def @compute() -> !struct.type<@Main> {
      %s = struct.new : !struct.type<@Main>
      function.return %s : !struct.type<@Main>
    }
    function.def @constrain(%s: !struct.type<@Main>) {
      %items = struct.readm %s[@items] : <@Main>, !array.type<0 x !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>>
      %zero = arith.constant 0 : index
      %item = array.read %items[%zero] : !array.type<0 x !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>>, !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>
      function.call @Child::@Child::@constrain(%item) : (!struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>) -> ()
      function.return
    }
  }
}

