// Only the affine field of a POD array receives family entries; a concrete sibling does not.
module attributes {llzk.lang, llzk.main = !struct.type<@Main>, test.scenario = "pod_array"} {
  poly.template @Child {
    poly.param @N : index
    struct.def @Child {
      function.def @compute() -> !struct.type<@Child::@Child<[@N]>> {
        %s = struct.new : !struct.type<@Child::@Child<[@N]>>
        function.return %s : !struct.type<@Child::@Child<[@N]>>
      }
      function.def @constrain(%s: !struct.type<@Child::@Child<[@N]>>) { function.return }
    }
  }
  struct.def @Other {
    function.def @compute() -> !struct.type<@Other> {
      %s = struct.new : !struct.type<@Other>
      function.return %s : !struct.type<@Other>
    }
    function.def @constrain(%s: !struct.type<@Other>) { function.return }
  }
  struct.def @Main {
    struct.member @pods : !array.type<2 x !pod.type<[@comp: !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>, @side: !struct.type<@Other>]>>
    function.def @compute(%x: !felt.type) -> !struct.type<@Main> {
      %s = struct.new : !struct.type<@Main>
      function.return %s : !struct.type<@Main>
    }
    function.def @constrain(%s: !struct.type<@Main>, %x: !felt.type) attributes {function.allow_non_native_field_ops} {
      %i = cast.toindex %x : !felt.type
      %pods = struct.readm %s[@pods] : <@Main>, !array.type<2 x !pod.type<[@comp: !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>, @side: !struct.type<@Other>]>>
      %pod = array.read %pods[%i] : !array.type<2 x !pod.type<[@comp: !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>, @side: !struct.type<@Other>]>>, !pod.type<[@comp: !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>, @side: !struct.type<@Other>]>
      %item = pod.read %pod[@comp] : !pod.type<[@comp: !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>, @side: !struct.type<@Other>]>, !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>
      function.call @Child::@Child::@constrain(%item) : (!struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>) -> ()
      function.return
    }
  }
}

