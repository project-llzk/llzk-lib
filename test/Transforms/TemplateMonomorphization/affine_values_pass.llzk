// A two-input affine map in a POD record receives both dimensions of its enclosing array.
module attributes {llzk.lang, llzk.main = !struct.type<@Main>, test.scenario = "pod_array_2d"} {
  poly.template @Child {
    poly.param @N : index
    struct.def @Child {
      function.def @compute() -> !struct.type<@Child::@Child<[@N]>> {
        %s = struct.new : !struct.type<@Child::@Child<[@N]>>
        function.return %s : !struct.type<@Child::@Child<[@N]>>
      }
      function.def @constrain(%s: !struct.type<@Child::@Child<[@N]>>) { function.return }
    }
  }
  struct.def @Main {
    struct.member @pods : !array.type<2, 3 x !pod.type<[@comp: !struct.type<@Child::@Child<[affine_map<(i,j) -> (i*3+j)>]>>]>>
    function.def @compute(%x: !felt.type, %y: !felt.type) -> !struct.type<@Main> {
      %s = struct.new : !struct.type<@Main>
      function.return %s : !struct.type<@Main>
    }
    function.def @constrain(%s: !struct.type<@Main>, %x: !felt.type, %y: !felt.type) attributes {function.allow_non_native_field_ops} {
      %i = cast.toindex %x : !felt.type
      %j = cast.toindex %y : !felt.type
      %pods = struct.readm %s[@pods] : <@Main>, !array.type<2, 3 x !pod.type<[@comp: !struct.type<@Child::@Child<[affine_map<(i,j) -> (i*3+j)>]>>]>>
      %pod = array.read %pods[%i, %j] : !array.type<2, 3 x !pod.type<[@comp: !struct.type<@Child::@Child<[affine_map<(i,j) -> (i*3+j)>]>>]>>, !pod.type<[@comp: !struct.type<@Child::@Child<[affine_map<(i,j) -> (i*3+j)>]>>]>
      %item = pod.read %pod[@comp] : !pod.type<[@comp: !struct.type<@Child::@Child<[affine_map<(i,j) -> (i*3+j)>]>>]>, !struct.type<@Child::@Child<[affine_map<(i,j) -> (i*3+j)>]>>
      function.call @Child::@Child::@constrain(%item) : (!struct.type<@Child::@Child<[affine_map<(i,j) -> (i*3+j)>]>>) -> ()
      function.return
    }
  }
}

