// A plain struct nested in a call result keeps the same specialization on a second run.
module attributes {llzk.lang, llzk.main = !struct.type<@Main>, test.scenario = "plain_nested_call_argument"} {
  struct.def @Foo {
    function.def @compute() -> !struct.type<@Foo> {
      %self = struct.new : !struct.type<@Foo>
      function.return %self : !struct.type<@Foo>
    }
    function.def @constrain(%self: !struct.type<@Foo>) { function.return }
  }
  poly.template @P {
    poly.param @N : index
    poly.param @T : !poly.tvar<@T>
    struct.def @P {
      function.def @compute() -> !struct.type<@P::@P<[@N, @T]>> {
        %self = struct.new : !struct.type<@P::@P<[@N, @T]>>
        function.return %self : !struct.type<@P::@P<[@N, @T]>>
      }
      function.def @constrain(%self: !struct.type<@P::@P<[@N, @T]>>) { function.return }
    }
  }
  struct.def @Main {
    function.def @compute() -> !struct.type<@Main> {
      %three = arith.constant 3 : index
      %result = function.call @P::@P::@compute(){(%three)} : () -> !struct.type<@P::@P<[affine_map<(i) -> (i)>, !struct.type<@Foo>]>>
      %self = struct.new : !struct.type<@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>) { function.return }
  }
}

