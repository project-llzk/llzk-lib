// CHECK: poly.arguments = [], poly.origin = @Foo, poly.specialization_id = 1 : i64
// CHECK: struct.def @P__spec_2 {
// CHECK: poly.arguments = [3 : index, !struct.type<@Foo>], poly.origin = @P::@P, poly.specialization_id = 2 : i64

// -----

// A local array creates its own specializations, and a write preserves the rolled type.
module attributes {llzk.lang, llzk.main = !struct.type<@Main>, test.scenario = "local_array"} {
  poly.template @Child {
    poly.param @N : index
    struct.def @Child {
      function.def @compute() -> !struct.type<@Child::@Child<[@N]>> {
        %s = struct.new : !struct.type<@Child::@Child<[@N]>>
        function.return %s : !struct.type<@Child::@Child<[@N]>>
      }
      function.def @constrain(%s: !struct.type<@Child::@Child<[@N]>>) { function.return }
    }
  }
  struct.def @Main {
    function.def @compute() -> !struct.type<@Main> {
      %items = array.new : !array.type<2 x !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>>
      %zero = arith.constant 0 : index
      %child = function.call @Child::@Child::@compute(){(%zero)} : () -> !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>
      array.write %items[%zero] = %child : !array.type<2 x !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>>, !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>
      %s = struct.new : !struct.type<@Main>
      function.return %s : !struct.type<@Main>
    }
    function.def @constrain(%s: !struct.type<@Main>) {
      function.return
    }
  }
}

