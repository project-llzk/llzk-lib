// Arrays of length two and five with the same element type contribute a five-target union to a constrain call.
module attributes {llzk.lang, llzk.main = !struct.type<@Main>, test.scenario = "two_arrays"} {
  poly.template @Child {
    poly.param @N : index
    struct.def @Child {
      function.def @compute() -> !struct.type<@Child::@Child<[@N]>> {
        %s = struct.new : !struct.type<@Child::@Child<[@N]>>
        function.return %s : !struct.type<@Child::@Child<[@N]>>
      }
      function.def @constrain(%s: !struct.type<@Child::@Child<[@N]>>) { function.return }
    }
  }
  struct.def @Main {
    struct.member @short : !array.type<2 x !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>>
    struct.member @long : !array.type<5 x !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>>
    function.def @compute(%x: !felt.type) -> !struct.type<@Main> {
      %s = struct.new : !struct.type<@Main>
      function.return %s : !struct.type<@Main>
    }
    function.def @constrain(%s: !struct.type<@Main>, %x: !felt.type) attributes {function.allow_non_native_field_ops} {
      %i = cast.toindex %x : !felt.type
      %short = struct.readm %s[@short] : <@Main>, !array.type<2 x !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>>
      %item = array.read %short[%i] : !array.type<2 x !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>>, !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>
      function.call @Child::@Child::@constrain(%item) : (!struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>) -> ()
      function.return
    }
  }
}

