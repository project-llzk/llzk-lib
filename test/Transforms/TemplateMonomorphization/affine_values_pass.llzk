// Affine struct values in arrays, PODs, and rolled calls.
// RUN: llzk-opt %s --split-input-file --llzk-monomorphize-templates | FileCheck %s --enable-var-scope
// RUN: llzk-opt %s --split-input-file --llzk-monomorphize-templates --llzk-monomorphize-templates | FileCheck %s --enable-var-scope

// Reading a declared array keeps its element type rolled while recording both specializations.
module attributes {llzk.lang, llzk.main = !struct.type<@Main>, test.scenario = "declared_read"} {
  poly.template @Child {
    poly.param @N : index
    struct.def @Child {
      function.def @compute() -> !struct.type<@Child::@Child<[@N]>> {
        %s = struct.new : !struct.type<@Child::@Child<[@N]>>
        function.return %s : !struct.type<@Child::@Child<[@N]>>
      }
      function.def @constrain(%s: !struct.type<@Child::@Child<[@N]>>) { function.return }
    }
  }
  struct.def @Main {
    struct.member @items : !array.type<2 x !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>>
    function.def @compute() -> !struct.type<@Main> {
      %s = struct.new : !struct.type<@Main>
      function.return %s : !struct.type<@Main>
    }
    function.def @constrain(%s: !struct.type<@Main>) {
      %items = struct.readm %s[@items] : <@Main>, !array.type<2 x !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>>
      function.return
    }
  }
}

