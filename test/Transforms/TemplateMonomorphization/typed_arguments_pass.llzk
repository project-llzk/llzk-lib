// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    } {poly.arguments = [2013265920 : index], poly.origin = @ChildTemplate::@Child, poly.specialization_id = 1 : i64}
// CHECK-NEXT:    struct.def @Child__spec_2 {
