// CHECK-NEXT:      struct.member @truth : !struct.type<@Child__spec_2>
// CHECK-NEXT:      function.def @compute() -> !struct.type<@Parent__spec_0> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_9:[0-9a-zA-Z_\.]+]] = felt.const  2013265920 : <"babybear">
// CHECK-NEXT:        %[[VAL_10:[0-9a-zA-Z_\.]+]] = felt.const  3 : <"babybear">
// CHECK-NEXT:        %[[VAL_11:[0-9a-zA-Z_\.]+]] = arith.constant true
// CHECK-NEXT:        %[[VAL_12:[0-9a-zA-Z_\.]+]] = struct.new : <@Parent__spec_0>
// CHECK-NEXT:        function.return %[[VAL_12]] : !struct.type<@Parent__spec_0>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_13:[0-9a-zA-Z_\.]+]]: !struct.type<@Parent__spec_0>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    } {poly.arguments = [-1 : index, #felt<const 3 : <"babybear">> : !felt.type<"babybear">, !felt.type<"babybear">, 1 : index], poly.origin = @ParentTemplate::@Parent, poly.specialization_id = 0 : i64}
// CHECK-NEXT:    struct.def @Child__spec_1 {
// CHECK-NEXT:      struct.member @arr : !array.type<2013265920 x i1>
