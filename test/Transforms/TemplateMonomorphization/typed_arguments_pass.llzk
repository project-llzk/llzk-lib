// CHECK-NEXT:        function.return %[[VAL_16]] : !struct.type<@Child__spec_2>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_17:[0-9a-zA-Z_\.]+]]: !struct.type<@Child__spec_2>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    } {poly.arguments = [1 : index], poly.origin = @ChildTemplate::@Child, poly.specialization_id = 2 : i64}
// CHECK-NEXT:  }
