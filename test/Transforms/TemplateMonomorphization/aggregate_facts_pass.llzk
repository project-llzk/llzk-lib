// RUN: llzk-opt %s --llzk-monomorphize-templates | FileCheck %s --match-full-lines

// Known local aggregate fields retain value-copy semantics across loop iterations.
module attributes {llzk.lang, llzk.main = !struct.type<@Parent::@Parent<[3]>>} {
  poly.template @Child {
    poly.param @N : index
    struct.def @Child {
      function.def @compute() -> !struct.type<@Child::@Child<[@N]>> {
        %s = struct.new : !struct.type<@Child::@Child<[@N]>>
        function.return %s : !struct.type<@Child::@Child<[@N]>>
      }
      function.def @constrain(%s: !struct.type<@Child::@Child<[@N]>>) {
        function.return
      }
    }
  }
  poly.template @Parent {
    poly.param @N : index
    poly.expr @Next {
      %n = poly.read_const @N : index
      %one = arith.constant 1 : index
      %next = arith.addi %n, %one : index
      poly.yield %next : index
    }
    struct.def @Parent {
      function.def @compute(%input: !felt.type) -> !struct.type<@Parent::@Parent<[@N]>> {
        %zero = arith.constant 0 : index
        %one = arith.constant 1 : index
        %two = arith.constant 2 : index
        %slots = array.new : !array.type<1 x !pod.type<[@n: index]>>
        scf.for %i = %zero to %two step %one {
          %pod = pod.new { @n = %i } : !pod.type<[@n: index]>
          array.write %slots[%zero] = %pod : !array.type<1 x !pod.type<[@n: index]>>, !pod.type<[@n: index]>
          %copy = array.read %slots[%zero] : !array.type<1 x !pod.type<[@n: index]>>, !pod.type<[@n: index]>
          pod.write %copy[@n] = %two : !pod.type<[@n: index]>, index
          %original = array.read %slots[%zero] : !array.type<1 x !pod.type<[@n: index]>>, !pod.type<[@n: index]>
          %value = pod.read %original[@n] : !pod.type<[@n: index]>, index
          %child = function.call @Child::@Child::@compute(){(%value)} : () -> !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>
        }
        %self = struct.new : !struct.type<@Parent::@Parent<[@N]>>
        function.return %self : !struct.type<@Parent::@Parent<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@Parent::@Parent<[@N]>>, %input: !felt.type) {
        function.return
      }
    }
  }
}


// CHECK: #[[$ATTR_0:[0-9a-zA-Z_\.]+]] = affine_map<(d0) -> (d0)>

// CHECK-LABEL: module attributes {llzk.lang, llzk.main = !struct.type<@Parent__spec_0>} {
