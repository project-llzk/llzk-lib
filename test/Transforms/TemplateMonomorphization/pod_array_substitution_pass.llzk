// -----

// Free-function specialization shares constructor rewrites; scalar initializers stay inline.
module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  poly.template @Helpers {
    poly.param @T : !poly.tvar<@T>
    function.def @make(%a: !poly.tvar<@T>, %b: !poly.tvar<@T>) -> index {
      %array = array.new %a, %b, %a, %b : !array.type<2,2 x !poly.tvar<@T>> {test.allocation = "function"}
      %result = arith.constant 0 : index
      function.return %result : index
    }
  }
  struct.def @Main {
    function.def @compute() -> !struct.type<@Main> {
      %zero = arith.constant 0 : index
      %one = arith.constant 1 : index
      %a = array.new %zero, %one, %zero : !array.type<3 x index>
      %b = array.new %one, %zero, %one : !array.type<3 x index>
      %array = function.call @Helpers::@make<[!array.type<3 x index>]>(%a, %b) : (!array.type<3 x index>, !array.type<3 x index>) -> index
      %scalar = function.call @Helpers::@make<[index]>(%zero, %one) : (index, index) -> index
      %self = struct.new : <@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>) { function.return }
  }
}

