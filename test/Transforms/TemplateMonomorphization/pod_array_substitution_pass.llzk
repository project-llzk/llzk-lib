// RUN: llzk-opt %s --split-input-file --llzk-monomorphize-templates | FileCheck %s --enable-var-scope

// Array-valued type arguments must flatten inside POD fields in struct bodies.
// Scalar accesses and initialized constructors must preserve subarrays after rank expansion.
// One- and two-dimensional outer shapes preserve row-major order and allocation attributes.
// Uninitialized and scalar-element allocations keep their existing behavior.
module attributes {llzk.lang, llzk.main = !struct.type<@Box::@Box<[2, !array.type<3,4 x index>]>>} {
  poly.template @Box {
    poly.param @N : index
    poly.param @T : !poly.tvar<@T>
    struct.def @Box {
      struct.member @state : !pod.type<[@items: !array.type<@N x !poly.tvar<@T>>]>
      function.def @compute() -> !struct.type<@Box::@Box<[@N, @T]>> {
        %state = pod.new : !pod.type<[@items: !array.type<@N x !poly.tvar<@T>>]>
        %items = pod.read %state[@items] : <[@items: !array.type<@N x !poly.tvar<@T>>]>, !array.type<@N x !poly.tvar<@T>>
        %zero = arith.constant 0 : index
        %item = array.read %items[%zero] : !array.type<@N x !poly.tvar<@T>>, !poly.tvar<@T>
        array.write %items[%zero] = %item : !array.type<@N x !poly.tvar<@T>>, !poly.tvar<@T>
        %one = arith.constant 1 : index
        %other = array.read %items[%one] : !array.type<@N x !poly.tvar<@T>>, !poly.tvar<@T>
        %pair = array.new %item, %other : !array.type<2 x !poly.tvar<@T>> {test.allocation = "pair"}
        %matrix = array.new %item, %other, %item, %other : !array.type<2,2 x !poly.tvar<@T>> {test.allocation = "matrix"}
        %empty = array.new : !array.type<2 x !poly.tvar<@T>>
        %scalar = array.new %zero, %one : !array.type<2 x index>
        %constructed = pod.new { @pair = %pair, @matrix = %matrix, @empty = %empty } : <[@pair: !array.type<2 x !poly.tvar<@T>>, @matrix: !array.type<2,2 x !poly.tvar<@T>>, @empty: !array.type<2 x !poly.tvar<@T>>]>
        %self = struct.new : <@Box::@Box<[@N, @T]>>
        struct.writem %self[@state] = %state : <@Box::@Box<[@N, @T]>>, !pod.type<[@items: !array.type<@N x !poly.tvar<@T>>]>
        function.return %self : !struct.type<@Box::@Box<[@N, @T]>>
      }
      function.def @constrain(%self: !struct.type<@Box::@Box<[@N, @T]>>) { function.return }
    }
  }
}

