// RUN: llzk-opt %s --llzk-monomorphize-templates | FileCheck %s

// Array-valued type arguments must flatten inside POD fields in struct bodies.
// Scalar reads and writes must become subarray extracts and inserts after rank expansion.
module attributes {llzk.lang, llzk.main = !struct.type<@Box::@Box<[2, !array.type<3,4 x index>]>>} {
  poly.template @Box {
    poly.param @N : index
    poly.param @T : !poly.tvar<@T>
    struct.def @Box {
      struct.member @state : !pod.type<[@items: !array.type<@N x !poly.tvar<@T>>]>
      function.def @compute() -> !struct.type<@Box::@Box<[@N, @T]>> {
        %state = pod.new : !pod.type<[@items: !array.type<@N x !poly.tvar<@T>>]>
        %items = pod.read %state[@items] : <[@items: !array.type<@N x !poly.tvar<@T>>]>, !array.type<@N x !poly.tvar<@T>>
        %zero = arith.constant 0 : index
        %item = array.read %items[%zero] : !array.type<@N x !poly.tvar<@T>>, !poly.tvar<@T>
        array.write %items[%zero] = %item : !array.type<@N x !poly.tvar<@T>>, !poly.tvar<@T>
        %self = struct.new : <@Box::@Box<[@N, @T]>>
        struct.writem %self[@state] = %state : <@Box::@Box<[@N, @T]>>, !pod.type<[@items: !array.type<@N x !poly.tvar<@T>>]>
        function.return %self : !struct.type<@Box::@Box<[@N, @T]>>
      }
      function.def @constrain(%self: !struct.type<@Box::@Box<[@N, @T]>>) { function.return }
    }
  }
}

// CHECK-LABEL: module attributes {llzk.lang, llzk.main = !struct.type<@Box__spec_0>} {
// CHECK-NEXT:    poly.template @Box {
// CHECK-NEXT:      poly.param @N : index
// CHECK-NEXT:      poly.param @T : !poly.tvar<@T>
// CHECK-NEXT:      struct.def @Box {
// CHECK-NEXT:        struct.member @state : !pod.type<[@items: !array.type<@N x !poly.tvar<@T>>]>
// CHECK-NEXT:        function.def @compute() -> !struct.type<@Box::@Box<[@N, @T]>> attributes {function.allow_witness} {
// CHECK-NEXT:          %[[VAL_0:[0-9a-zA-Z_\.]+]] = pod.new : <[@items: !array.type<@N x !poly.tvar<@T>>]>
// CHECK-NEXT:          %[[VAL_1:[0-9a-zA-Z_\.]+]] = pod.read %[[VAL_0]][@items] : <[@items: !array.type<@N x !poly.tvar<@T>>]>, !array.type<@N x !poly.tvar<@T>>
// CHECK-NEXT:          %[[VAL_2:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:          %[[VAL_3:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_1]]{{\[}}%[[VAL_2]]] : <@N x !poly.tvar<@T>>, !poly.tvar<@T>
// CHECK-NEXT:          array.write %[[VAL_1]]{{\[}}%[[VAL_2]]] = %[[VAL_3]] : <@N x !poly.tvar<@T>>, !poly.tvar<@T>
// CHECK-NEXT:          %[[VAL_4:[0-9a-zA-Z_\.]+]] = struct.new : <@Box::@Box<[@N, @T]>>
// CHECK-NEXT:          struct.writem %[[VAL_4]][@state] = %[[VAL_0]] : <@Box::@Box<[@N, @T]>>, !pod.type<[@items: !array.type<@N x !poly.tvar<@T>>]>
// CHECK-NEXT:          function.return %[[VAL_4]] : !struct.type<@Box::@Box<[@N, @T]>>
// CHECK-NEXT:        }
// CHECK-NEXT:        function.def @constrain(%[[VAL_5:[0-9a-zA-Z_\.]+]]: !struct.type<@Box::@Box<[@N, @T]>>) attributes {function.allow_constraint} {
// CHECK-NEXT:          function.return
// CHECK-NEXT:        }
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    struct.def @Box__spec_0 {
// CHECK-NEXT:      struct.member @state : !pod.type<[@items: !array.type<2,3,4 x index>]>
// CHECK-NEXT:      function.def @compute() -> !struct.type<@Box__spec_0> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_6:[0-9a-zA-Z_\.]+]] = pod.new : <[@items: !array.type<2,3,4 x index>]>
// CHECK-NEXT:        %[[VAL_7:[0-9a-zA-Z_\.]+]] = pod.read %[[VAL_6]][@items] : <[@items: !array.type<2,3,4 x index>]>, !array.type<2,3,4 x index>
// CHECK-NEXT:        %[[VAL_8:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:        %[[VAL_9:[0-9a-zA-Z_\.]+]] = array.extract %[[VAL_7]]{{\[}}%[[VAL_8]]] : <2,3,4 x index>
// CHECK-NEXT:        array.insert %[[VAL_7]]{{\[}}%[[VAL_8]]] = %[[VAL_9]] : <2,3,4 x index>, <3,4 x index>
// CHECK-NEXT:        %[[VAL_10:[0-9a-zA-Z_\.]+]] = struct.new : <@Box__spec_0>
// CHECK-NEXT:        struct.writem %[[VAL_10]][@state] = %[[VAL_6]] : <@Box__spec_0>, !pod.type<[@items: !array.type<2,3,4 x index>]>
// CHECK-NEXT:        function.return %[[VAL_10]] : !struct.type<@Box__spec_0>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_11:[0-9a-zA-Z_\.]+]]: !struct.type<@Box__spec_0>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    } {poly.arguments = [2 : index, !array.type<3,4 x index>], poly.origin = @Box::@Box, poly.specialization_id = 0 : i64}
// CHECK-NEXT:  }
