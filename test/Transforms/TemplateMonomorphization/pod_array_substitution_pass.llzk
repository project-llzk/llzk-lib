// RUN: llzk-opt %s --llzk-monomorphize-templates | FileCheck %s

// Array-valued type arguments must flatten inside POD fields in struct bodies.
module attributes {llzk.lang, llzk.main = !struct.type<@Box::@Box<[2, !array.type<3,4 x index>]>>} {
  poly.template @Box {
    poly.param @N : index
    poly.param @T : !poly.tvar<@T>
    struct.def @Box {
      struct.member @state : !pod.type<[@items: !array.type<@N x !poly.tvar<@T>>]>
      function.def @compute() -> !struct.type<@Box::@Box<[@N, @T]>> {
        %state = pod.new : !pod.type<[@items: !array.type<@N x !poly.tvar<@T>>]>
        %self = struct.new : <@Box::@Box<[@N, @T]>>
        struct.writem %self[@state] = %state : <@Box::@Box<[@N, @T]>>, !pod.type<[@items: !array.type<@N x !poly.tvar<@T>>]>
        function.return %self : !struct.type<@Box::@Box<[@N, @T]>>
      }
      function.def @constrain(%self: !struct.type<@Box::@Box<[@N, @T]>>) { function.return }
    }
  }
}

// CHECK-LABEL: module attributes {llzk.lang, llzk.main = !struct.type<@Box__spec_0>} {
// CHECK-NEXT:    poly.template @Box {
// CHECK-NEXT:      poly.param @N : index
// CHECK-NEXT:      poly.param @T : !poly.tvar<@T>
// CHECK-NEXT:      struct.def @Box {
// CHECK-NEXT:        struct.member @state : !pod.type<[@items: !array.type<@N x !poly.tvar<@T>>]>
// CHECK-NEXT:        function.def @compute() -> !struct.type<@Box::@Box<[@N, @T]>> attributes {function.allow_witness} {
// CHECK-NEXT:          %[[VAL_0:[0-9a-zA-Z_\.]+]] = pod.new : <[@items: !array.type<@N x !poly.tvar<@T>>]>
// CHECK-NEXT:          %[[VAL_1:[0-9a-zA-Z_\.]+]] = struct.new : <@Box::@Box<[@N, @T]>>
// CHECK-NEXT:          struct.writem %[[VAL_1]][@state] = %[[VAL_0]] : <@Box::@Box<[@N, @T]>>, !pod.type<[@items: !array.type<@N x !poly.tvar<@T>>]>
// CHECK-NEXT:          function.return %[[VAL_1]] : !struct.type<@Box::@Box<[@N, @T]>>
// CHECK-NEXT:        }
// CHECK-NEXT:        function.def @constrain(%[[VAL_2:[0-9a-zA-Z_\.]+]]: !struct.type<@Box::@Box<[@N, @T]>>) attributes {function.allow_constraint} {
// CHECK-NEXT:          function.return
// CHECK-NEXT:        }
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    struct.def @Box__spec_0 {
// CHECK-NEXT:      struct.member @state : !pod.type<[@items: !array.type<2,3,4 x index>]>
// CHECK-NEXT:      function.def @compute() -> !struct.type<@Box__spec_0> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_3:[0-9a-zA-Z_\.]+]] = pod.new : <[@items: !array.type<2,3,4 x index>]>
// CHECK-NEXT:        %[[VAL_4:[0-9a-zA-Z_\.]+]] = struct.new : <@Box__spec_0>
// CHECK-NEXT:        struct.writem %[[VAL_4]][@state] = %[[VAL_3]] : <@Box__spec_0>, !pod.type<[@items: !array.type<2,3,4 x index>]>
// CHECK-NEXT:        function.return %[[VAL_4]] : !struct.type<@Box__spec_0>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_5:[0-9a-zA-Z_\.]+]]: !struct.type<@Box__spec_0>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    } {poly.arguments = [2 : index, !array.type<3,4 x index>], poly.origin = @Box::@Box, poly.specialization_id = 0 : i64}
// CHECK-NEXT:  }
