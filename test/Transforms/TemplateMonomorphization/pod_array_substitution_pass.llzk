// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    struct.def @Box__spec_0 {
// CHECK-NEXT:      struct.member @state : !pod.type<[@items: !array.type<2,3,4 x index>]>
// CHECK-NEXT:      function.def @compute() -> !struct.type<@Box__spec_0> attributes {function.allow_witness} {
