// Loop evaluation propagates carried values and results into specializations.
// RUN: llzk-opt %s --split-input-file --llzk-monomorphize-templates | FileCheck %s --enable-var-scope
// RUN: llzk-opt %s --split-input-file --llzk-monomorphize-templates --llzk-monomorphize-templates | FileCheck %s --enable-var-scope

// A zero-iteration while evaluates its condition region and skips its body.
module attributes {llzk.lang, llzk.main = !struct.type<@Main>, test.scenario = "while_zero"} {
  poly.template @Child {
    poly.param @N : index
    struct.def @Child {
      function.def @compute() -> !struct.type<@Child::@Child<[@N]>> {
        %self = struct.new : !struct.type<@Child::@Child<[@N]>>
        function.return %self : !struct.type<@Child::@Child<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@Child::@Child<[@N]>>) { function.return }
    }
  }
  struct.def @Main {
    function.def @compute(%unknown: !felt.type) -> !struct.type<@Main> attributes {function.allow_non_native_field_ops} {
      %zero = arith.constant 0 : index
      %result = scf.while (%i = %zero) : (index) -> index {
        %child = function.call @Child::@Child::@compute(){(%i)} : () -> !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>
        %condition = arith.cmpi slt, %i, %zero : index
        scf.condition(%condition) %i : index
      } do {
      ^bb0(%i: index):
        %unknown_index = cast.toindex %unknown : !felt.type
        %unreachable = function.call @Child::@Child::@compute(){(%unknown_index)} : () -> !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>
        scf.yield %i : index
      }
      %self = struct.new : !struct.type<@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>, %unknown: !felt.type) { function.return }
  }
}

// CHECK-LABEL: module attributes {llzk.lang, llzk.main = !struct.type<@Main__spec_0>, test.scenario = "while_zero"} {
// CHECK: struct.def @Main__spec_0 {
// CHECK: poly.family_specializations = [1]
// CHECK: struct.def @Child__spec_1 {
// CHECK: poly.arguments = [0 : index], poly.origin = @Child::@Child, poly.specialization_id = 1 : i64

// -----

// A while carries values through both regions and discovers each reached child.
module attributes {llzk.lang, llzk.main = !struct.type<@Main>, test.scenario = "while_carried"} {
  poly.template @Child {
    poly.param @N : index
    struct.def @Child {
      function.def @compute() -> !struct.type<@Child::@Child<[@N]>> {
        %self = struct.new : !struct.type<@Child::@Child<[@N]>>
        function.return %self : !struct.type<@Child::@Child<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@Child::@Child<[@N]>>) { function.return }
    }
  }
  struct.def @Main {
    function.def @compute() -> !struct.type<@Main> {
      %zero = arith.constant 0 : index
      %one = arith.constant 1 : index
      %three = arith.constant 3 : index
      %result = scf.while (%i = %zero) : (index) -> index {
        %condition = arith.cmpi slt, %i, %three : index
        %forwarded = arith.addi %i, %one : index
        scf.condition(%condition) %forwarded : index
      } do {
      ^bb0(%i: index):
        %child = function.call @Child::@Child::@compute(){(%i)} : () -> !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>
        scf.yield %i : index
      }
      %last = function.call @Child::@Child::@compute(){(%result)} : () -> !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>
      %self = struct.new : !struct.type<@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>) { function.return }
  }
}

// CHECK-LABEL: module attributes {llzk.lang, llzk.main = !struct.type<@Main__spec_0>, test.scenario = "while_carried"} {
// CHECK: struct.def @Main__spec_0 {
// CHECK: poly.family_specializations = [1, 2, 3]
// CHECK: poly.family_specializations = [4]
// CHECK: struct.def @Child__spec_1 {
// CHECK: poly.arguments = [1 : index], poly.origin = @Child::@Child, poly.specialization_id = 1 : i64
// CHECK: struct.def @Child__spec_2 {
// CHECK: poly.arguments = [2 : index], poly.origin = @Child::@Child, poly.specialization_id = 2 : i64
// CHECK: struct.def @Child__spec_3 {
// CHECK: poly.arguments = [3 : index], poly.origin = @Child::@Child, poly.specialization_id = 3 : i64
// CHECK: struct.def @Child__spec_4 {
// CHECK: poly.arguments = [4 : index], poly.origin = @Child::@Child, poly.specialization_id = 4 : i64

// -----

// Carried values discover Child<1..3>; the loop result selects Child<4> in the true branch.
module attributes {test.scenario = "discovery_loop_results", llzk.lang, llzk.main = !struct.type<@Parent::@Parent<[3]>>} {
  poly.template @Child {
    poly.param @N : index
    struct.def @Child {
      function.def @compute() -> !struct.type<@Child::@Child<[@N]>> {
        %s = struct.new : !struct.type<@Child::@Child<[@N]>>
        function.return %s : !struct.type<@Child::@Child<[@N]>>
      }
      function.def @constrain(%s: !struct.type<@Child::@Child<[@N]>>) {
        function.return
      }
    }
  }
  poly.template @Parent {
    poly.param @N : index
    poly.expr @Next {
      %n = poly.read_const @N : index
      %one = arith.constant 1 : index
      %next = arith.addi %n, %one : index
      poly.yield %next : index
    }
    struct.def @Parent {
      function.def @compute(%input: !felt.type) -> !struct.type<@Parent::@Parent<[@N]>> {
        %felt_zero = felt.const 0
        %condition = bool.cmp eq(%input, %felt_zero)
        %unknown_zero = arith.constant 0 : index
        %unknown_one = arith.constant 1 : index
        %unknown = scf.if %condition -> index {
          scf.yield %unknown_zero : index
        } else {
          scf.yield %unknown_one : index
        }
        %zero = arith.constant 0 : index
        %one = arith.constant 1 : index
        %n = poly.read_const @N : index
        %next = poly.read_const @Next : index
        %out = scf.for %i = %zero to %n step %one iter_args(%v = %one) -> index {
          %child = function.call @Child::@Child::@compute(){(%v)} : () -> !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>
          %incr = arith.addi %v, %one : index
          scf.yield %incr : index
        }
        %same = arith.cmpi eq, %out, %next : index
        scf.if %same {
          %child = function.call @Child::@Child::@compute(){(%out)} : () -> !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>
        } else {
          %child = function.call @Child::@Child::@compute(){(%unknown)} : () -> !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>
        }
        %self = struct.new : !struct.type<@Parent::@Parent<[@N]>>
        function.return %self : !struct.type<@Parent::@Parent<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@Parent::@Parent<[@N]>>, %input: !felt.type) {
        function.return
      }
    }
  }
}

