// RUN: llzk-opt %s --split-input-file --llzk-monomorphize-templates --verify-diagnostics -o /dev/null

// Unknown POD allocation extents must not permit a known element access.
module attributes {llzk.lang, llzk.main = !struct.type<@Parent::@Parent<[3]>>} {
  poly.template @Child {
    poly.param @N : index
    struct.def @Child {
      function.def @compute() -> !struct.type<@Child::@Child<[@N]>> {
        %s = struct.new : !struct.type<@Child::@Child<[@N]>>
        function.return %s : !struct.type<@Child::@Child<[@N]>>
      }
      function.def @constrain(%s: !struct.type<@Child::@Child<[@N]>>) {
        function.return
      }
    }
  }
  poly.template @Parent {
    poly.param @N : index
    poly.expr @Next {
      %n = poly.read_const @N : index
      %one = arith.constant 1 : index
      %next = arith.addi %n, %one : index
      poly.yield %next : index
    }
    struct.def @Parent {
      function.def @compute(%input: !felt.type) -> !struct.type<@Parent::@Parent<[@N]>> attributes {function.allow_non_native_field_ops} {
        %zero = arith.constant 0 : index
        %one = arith.constant 1 : index
        %two = arith.constant 2 : index
        %unknown = cast.toindex %input : !felt.type
        %holder = pod.new (%unknown) : !pod.type<[@a: !array.type<affine_map<(d0) -> (d0)> x index>]>
        %items = pod.read %holder[@a] : !pod.type<[@a: !array.type<affine_map<(d0) -> (d0)> x index>]>, !array.type<affine_map<(d0) -> (d0)> x index>
        array.write %items[%zero] = %two : !array.type<affine_map<(d0) -> (d0)> x index>, index
        %value = array.read %items[%zero] : !array.type<affine_map<(d0) -> (d0)> x index>, index
        // expected-error @+1 {{monomorphize-templates: cannot resolve affine struct specialization argument}}
        %child = function.call @Child::@Child::@compute(){(%value)} : () -> !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>
        %self = struct.new : !struct.type<@Parent::@Parent<[@N]>>
        function.return %self : !struct.type<@Parent::@Parent<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@Parent::@Parent<[@N]>>, %input: !felt.type) {
        function.return
      }
    }
  }
}
// -----

// Zero POD allocation extents must not permit a known element access.
module attributes {llzk.lang, llzk.main = !struct.type<@Parent::@Parent<[3]>>} {
  poly.template @Child {
    poly.param @N : index
    struct.def @Child {
      function.def @compute() -> !struct.type<@Child::@Child<[@N]>> {
        %s = struct.new : !struct.type<@Child::@Child<[@N]>>
        function.return %s : !struct.type<@Child::@Child<[@N]>>
      }
      function.def @constrain(%s: !struct.type<@Child::@Child<[@N]>>) {
        function.return
      }
    }
  }
  poly.template @Parent {
    poly.param @N : index
    poly.expr @Next {
      %n = poly.read_const @N : index
      %one = arith.constant 1 : index
      %next = arith.addi %n, %one : index
      poly.yield %next : index
    }
    struct.def @Parent {
      function.def @compute(%input: !felt.type) -> !struct.type<@Parent::@Parent<[@N]>> attributes {function.allow_non_native_field_ops} {
        %zero = arith.constant 0 : index
        %one = arith.constant 1 : index
        %two = arith.constant 2 : index
        %unknown = cast.toindex %input : !felt.type
        %holder = pod.new (%zero) : !pod.type<[@a: !array.type<affine_map<(d0) -> (d0)> x index>]>
        %items = pod.read %holder[@a] : !pod.type<[@a: !array.type<affine_map<(d0) -> (d0)> x index>]>, !array.type<affine_map<(d0) -> (d0)> x index>
        array.write %items[%zero] = %two : !array.type<affine_map<(d0) -> (d0)> x index>, index
        %value = array.read %items[%zero] : !array.type<affine_map<(d0) -> (d0)> x index>, index
        // expected-error @+1 {{monomorphize-templates: cannot resolve affine struct specialization argument}}
        %child = function.call @Child::@Child::@compute(){(%value)} : () -> !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>
        %self = struct.new : !struct.type<@Parent::@Parent<[@N]>>
        function.return %self : !struct.type<@Parent::@Parent<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@Parent::@Parent<[@N]>>, %input: !felt.type) {
        function.return
      }
    }
  }
}
