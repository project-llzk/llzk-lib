// RUN: llzk-opt %s --llzk-monomorphize-templates | FileCheck %s --match-full-lines

// Runtime loops with no dependent specialization requests need no execution.
module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  function.def @loop(%input: !felt.type) {
    %zero = arith.constant 0 : index
    %felt_zero = felt.const 0
    %condition = bool.cmp eq(%input, %felt_zero)
    %result = scf.while (%i = %zero) : (index) -> index {
      scf.condition(%condition) %i : index
    } do {
    ^bb0(%i: index):
      scf.yield %i : index
    }
    function.return
  }
  struct.def @Main {
    function.def @compute(%input: !felt.type) -> !struct.type<@Main> {
      function.call @loop(%input) : (!felt.type) -> ()
      %self = struct.new : !struct.type<@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>, %input: !felt.type) { function.return }
  }
}

// CHECK-LABEL: module attributes {llzk.lang, llzk.main = !struct.type<@Main__spec_0>} {
// CHECK-NEXT:    function.def @loop(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !felt.type) {
// CHECK-NEXT:      %[[VAL_1:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = felt.const  0
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = bool.cmp eq(%[[VAL_0]], %[[VAL_2]]) : !felt.type, !felt.type
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = scf.while (%[[VAL_5:[0-9a-zA-Z_\.]+]] = %[[VAL_1]]) : (index) -> index {
// CHECK-NEXT:        scf.condition(%[[VAL_3]]) %[[VAL_5]] : index
// CHECK-NEXT:      } do {
// CHECK-NEXT:      ^bb0(%[[VAL_6:[0-9a-zA-Z_\.]+]]: index):
// CHECK-NEXT:        scf.yield %[[VAL_6]] : index
// CHECK-NEXT:      }
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:    struct.def @Main {
// CHECK-NEXT:      function.def @compute(%[[VAL_7:[0-9a-zA-Z_\.]+]]: !felt.type) -> !struct.type<@Main> attributes {function.allow_witness} {
// CHECK-NEXT:        function.call @loop(%[[VAL_7]]) : (!felt.type) -> ()
// CHECK-NEXT:        %[[VAL_8:[0-9a-zA-Z_\.]+]] = struct.new : <@Main>
// CHECK-NEXT:        function.return %[[VAL_8]] : !struct.type<@Main>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_9:[0-9a-zA-Z_\.]+]]: !struct.type<@Main>, %[[VAL_10:[0-9a-zA-Z_\.]+]]: !felt.type) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    struct.def @Main__spec_0 {
// CHECK-NEXT:      function.def @compute(%[[VAL_11:[0-9a-zA-Z_\.]+]]: !felt.type) -> !struct.type<@Main__spec_0> attributes {function.allow_witness} {
// CHECK-NEXT:        function.call @loop__spec_0(%[[VAL_11]]) : (!felt.type) -> ()
// CHECK-NEXT:        %[[VAL_12:[0-9a-zA-Z_\.]+]] = struct.new : <@Main__spec_0>
// CHECK-NEXT:        function.return %[[VAL_12]] : !struct.type<@Main__spec_0>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_13:[0-9a-zA-Z_\.]+]]: !struct.type<@Main__spec_0>, %[[VAL_14:[0-9a-zA-Z_\.]+]]: !felt.type) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    } {poly.arguments = [], poly.origin = @Main, poly.specialization_id = 0 : i64}
// CHECK-NEXT:    function.def @loop__spec_0(%[[VAL_15:[0-9a-zA-Z_\.]+]]: !felt.type) attributes {poly.arguments = [], poly.origin = @loop} {
// CHECK-NEXT:      %[[VAL_16:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:      %[[VAL_17:[0-9a-zA-Z_\.]+]] = felt.const  0
// CHECK-NEXT:      %[[VAL_18:[0-9a-zA-Z_\.]+]] = bool.cmp eq(%[[VAL_15]], %[[VAL_17]]) : !felt.type, !felt.type
// CHECK-NEXT:      %[[VAL_19:[0-9a-zA-Z_\.]+]] = scf.while (%[[VAL_20:[0-9a-zA-Z_\.]+]] = %[[VAL_16]]) : (index) -> index {
// CHECK-NEXT:        scf.condition(%[[VAL_18]]) %[[VAL_20]] : index
// CHECK-NEXT:      } do {
// CHECK-NEXT:      ^bb0(%[[VAL_21:[0-9a-zA-Z_\.]+]]: index):
// CHECK-NEXT:        scf.yield %[[VAL_21]] : index
// CHECK-NEXT:      }
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:  }
