// Configured evaluation and specialization limits produce diagnostics.
// RUN: llzk-opt %s --split-input-file '--llzk-monomorphize-templates=max-evaluation-steps=20 max-specializations=2' --verify-diagnostics

// A nonterminating while exhausts the shared evaluation budget.
module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  struct.def @Main {
    function.def @compute() -> !struct.type<@Main> {
      %zero = arith.constant 0 : index
      %true = arith.constant true
      scf.while (%i = %zero) : (index) -> index {
        scf.condition(%true) %i : index
      } do {
      ^bb0(%i: index):
        // expected-error@+1 {{step limit exceeded}}
        scf.yield %i : index
      }
      %self = struct.new : !struct.type<@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>) { function.return }
  }
}

// -----

// Struct and free-function clones share the specialization limit.
module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  function.def @first() { function.return }
  function.def @second() { function.return }
  struct.def @Main {
    function.def @compute() -> !struct.type<@Main> {
      function.call @first() : () -> ()
      // expected-error@+1 {{template monomorphization specialization limit exceeded}}
      function.call @second() : () -> ()
      %self = struct.new : !struct.type<@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>) { function.return }
  }
}

// -----

// A 100-iteration loop exceeds the configured 20-step evaluation budget.
module attributes {llzk.lang, llzk.main = !struct.type<@Parent::@Parent<[3]>>} {
  poly.template @Child {
    poly.param @N : index
    struct.def @Child {
      function.def @compute() -> !struct.type<@Child::@Child<[@N]>> {
        %s = struct.new : !struct.type<@Child::@Child<[@N]>>
        function.return %s : !struct.type<@Child::@Child<[@N]>>
      }
      function.def @constrain(%s: !struct.type<@Child::@Child<[@N]>>) {
        function.return
      }
    }
  }
  poly.template @Parent {
    poly.param @N : index
    poly.expr @Next {
      %n = poly.read_const @N : index
      %one = arith.constant 1 : index
      %next = arith.addi %n, %one : index
      poly.yield %next : index
    }
    struct.def @Parent {
      function.def @compute(%input: !felt.type) -> !struct.type<@Parent::@Parent<[@N]>> {
        %zero = arith.constant 0 : index
        %one = arith.constant 1 : index
        %many = arith.constant 100 : index
        scf.for %i = %zero to %many step %one {
          // expected-error@+1 {{step limit exceeded}}
          %child = function.call @Child::@Child::@compute(){(%i)} : () -> !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>
        }
        %self = struct.new : !struct.type<@Parent::@Parent<[@N]>>
        function.return %self : !struct.type<@Parent::@Parent<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@Parent::@Parent<[@N]>>, %input: !felt.type) {
        function.return
      }
    }
  }
}

// -----

// Main and three Child specializations exceed the configured two-specialization limit.
module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  poly.template @Child {
    poly.param @N : index
    struct.def @Child {
      function.def @compute() -> !struct.type<@Child::@Child<[@N]>> {
        %s = struct.new : !struct.type<@Child::@Child<[@N]>>
        function.return %s : !struct.type<@Child::@Child<[@N]>>
      }
      function.def @constrain(%s: !struct.type<@Child::@Child<[@N]>>) {
        function.return
      }
    }
  }
  struct.def @Main {
    // expected-error@+1 {{template monomorphization specialization limit exceeded}}
    struct.member @children : !array.type<3 x !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>>
    function.def @compute() -> !struct.type<@Main> {
      %zero = arith.constant 0 : index
      %three = arith.constant 3 : index
      %one = arith.constant 1 : index
      scf.for %i = %zero to %three step %one {
        %child = function.call @Child::@Child::@compute(){(%i)} : () -> !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>
      }
      %s = struct.new : !struct.type<@Main>
      function.return %s : !struct.type<@Main>
    }
    function.def @constrain(%s: !struct.type<@Main>) {
      function.return
    }
  }
}

// -----

// Template expressions and methods each fit, but together exceed 20 steps.
module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  poly.template @TChild {
    poly.param @N : index
    poly.expr @E {
      %e0 = arith.constant 0 : index
      %e1 = arith.constant 1 : index
      %e2 = arith.constant 2 : index
      %e3 = arith.constant 3 : index
      %e4 = arith.constant 4 : index
      %e5 = arith.constant 5 : index
      %e6 = arith.constant 6 : index
      %e7 = arith.constant 7 : index
      %e8 = arith.constant 8 : index
      %e9 = arith.constant 9 : index
      poly.yield %e0 : index
    }
    struct.def @Child {
      function.def @compute() -> !struct.type<@TChild::@Child<[@N]>> {
        %m0 = arith.constant 0 : index
        %m1 = arith.constant 1 : index
        %m2 = arith.constant 2 : index
        %m3 = arith.constant 3 : index
        %m4 = arith.constant 4 : index
        %m5 = arith.constant 5 : index
        %m6 = arith.constant 6 : index
        %m7 = arith.constant 7 : index
        %m8 = arith.constant 8 : index
        // expected-error@+1 {{step limit exceeded}}
        %m9 = arith.constant 9 : index
        %self = struct.new : !struct.type<@TChild::@Child<[@N]>>
        function.return %self : !struct.type<@TChild::@Child<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@TChild::@Child<[@N]>>) {
        function.return
      }
    }
  }
  struct.def @Main {
    struct.member @child : !struct.type<@TChild::@Child<[0 : index]>>
    function.def @compute() -> !struct.type<@Main> {
      %self = struct.new : !struct.type<@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>) { function.return }
  }
}
