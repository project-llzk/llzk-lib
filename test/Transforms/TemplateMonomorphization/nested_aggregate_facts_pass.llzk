// RUN: llzk-opt %s --llzk-monomorphize-templates | FileCheck %s --match-full-lines

// Resolve a stored round parameter only when a mutable nested countdown reaches zero.
module attributes {llzk.lang, llzk.main = !struct.type<@Parent::@Parent<[3]>>} {
  poly.template @Child {
    poly.param @N : index
    struct.def @Child {
      function.def @compute() -> !struct.type<@Child::@Child<[@N]>> {
        %s = struct.new : !struct.type<@Child::@Child<[@N]>>
        function.return %s : !struct.type<@Child::@Child<[@N]>>
      }
      function.def @constrain(%s: !struct.type<@Child::@Child<[@N]>>) {
        function.return
      }
    }
  }
  poly.template @Parent {
    poly.param @N : index
    poly.expr @Next {
      %n = poly.read_const @N : index
      %one = arith.constant 1 : index
      %next = arith.addi %n, %one : index
      poly.yield %next : index
    }
    struct.def @Parent {
      function.def @compute(%input: !felt.type) -> !struct.type<@Parent::@Parent<[@N]>> {
        %zero = arith.constant 0 : index
        %one = arith.constant 1 : index
        %two = arith.constant 2 : index
        %slots = array.new : !array.type<2 x !pod.type<[@count: index, @params: !pod.type<[@r: index]>]>>
        scf.for %i = %zero to %two step %one {
          %params = pod.new { @r = %i } : !pod.type<[@r: index]>
          %pod = pod.new { @count = %two, @params = %params } : !pod.type<[@count: index, @params: !pod.type<[@r: index]>]>
          array.write %slots[%i] = %pod : !array.type<2 x !pod.type<[@count: index, @params: !pod.type<[@r: index]>]>>, !pod.type<[@count: index, @params: !pod.type<[@r: index]>]>
          scf.for %j = %zero to %two step %one {
            %copy = array.read %slots[%i] : !array.type<2 x !pod.type<[@count: index, @params: !pod.type<[@r: index]>]>>, !pod.type<[@count: index, @params: !pod.type<[@r: index]>]>
            %count = pod.read %copy[@count] : !pod.type<[@count: index, @params: !pod.type<[@r: index]>]>, index
            %next = arith.subi %count, %one : index
            pod.write %copy[@count] = %next : !pod.type<[@count: index, @params: !pod.type<[@r: index]>]>, index
            %ready = arith.cmpi eq, %next, %zero : index
            scf.if %ready {
              %p = pod.read %copy[@params] : !pod.type<[@count: index, @params: !pod.type<[@r: index]>]>, !pod.type<[@r: index]>
              %value = pod.read %p[@r] : !pod.type<[@r: index]>, index
              %child = function.call @Child::@Child::@compute(){(%value)} : () -> !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>
            }
            array.write %slots[%i] = %copy : !array.type<2 x !pod.type<[@count: index, @params: !pod.type<[@r: index]>]>>, !pod.type<[@count: index, @params: !pod.type<[@r: index]>]>
          }
        }
        %self = struct.new : !struct.type<@Parent::@Parent<[@N]>>
        function.return %self : !struct.type<@Parent::@Parent<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@Parent::@Parent<[@N]>>, %input: !felt.type) {
        function.return
      }
    }
  }
}


// CHECK: #[[$ATTR_0:[0-9a-zA-Z_\.]+]] = affine_map<(d0) -> (d0)>

