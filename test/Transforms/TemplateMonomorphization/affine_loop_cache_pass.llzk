// Repeated visits to the same array-valued read enumerate its family once.
// RUN: llzk-opt %s --llzk-monomorphize-templates=max-evaluation-steps=60 | FileCheck %s
// RUN: llzk-opt %s --llzk-monomorphize-templates=max-evaluation-steps=60 --llzk-monomorphize-templates=max-evaluation-steps=60 | FileCheck %s

module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  poly.template @Child {
    poly.param @N : index
    struct.def @Child {
      function.def @compute() -> !struct.type<@Child::@Child<[@N]>> {
        %s = struct.new : !struct.type<@Child::@Child<[@N]>>
        function.return %s : !struct.type<@Child::@Child<[@N]>>
      }
      function.def @constrain(%s: !struct.type<@Child::@Child<[@N]>>) { function.return }
    }
  }
  struct.def @Main {
    struct.member @items : !array.type<8 x !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>>
    function.def @compute() -> !struct.type<@Main> {
      %s = struct.new : !struct.type<@Main>
      function.return %s : !struct.type<@Main>
    }
    function.def @constrain(%s: !struct.type<@Main>) {
      %zero = arith.constant 0 : index
      %eight = arith.constant 8 : index
      %one = arith.constant 1 : index
      scf.for %i = %zero to %eight step %one {
        %items = struct.readm %s[@items] : <@Main>, !array.type<8 x !struct.type<@Child::@Child<[affine_map<(i) -> (i)>]>>>
      }
      function.return
    }
  }
}

