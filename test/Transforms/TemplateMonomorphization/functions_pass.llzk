// CHECK:        struct.def @Main__spec_0 {
// CHECK:          function.call @size__spec_0(
// CHECK:        function.def @size__spec_0(%{{[0-9a-zA-Z_\.]+}}: !array.type<3 x !felt.type>) -> index attributes {poly.arguments = [3 : index], poly.origin = @Outer::@size} {
// CHECK:          function.call @size__spec_1() : () -> index
// CHECK:        function.def @size__spec_1() -> index attributes {poly.arguments = [3 : index], poly.origin = @Inner::@size} {
// CHECK:          arith.constant 3 : index
// CHECK-NOT:    function.def @size__spec_2

