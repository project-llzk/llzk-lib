// The call signature infers a parameter and a nested free call inherits it.
module attributes {llzk.lang, llzk.main = !struct.type<@Main>, test.scenario = "inferred"} {
  poly.template @Inner {
    poly.param @N : index
    function.def @size() -> index {
      %size = poly.read_const @N : index
      function.return %size : index
    }
  }
  poly.template @Outer {
    poly.param @N : index
    function.def @size(%values: !array.type<@N x !felt.type>) -> index {
      %size = function.call @Inner::@size<[@N]>() : () -> index
      function.return %size : index
    }
  }
  struct.def @Main {
    function.def @compute(%values: !array.type<3 x !felt.type>) -> !struct.type<@Main> {
      %size = function.call @Outer::@size(%values) : (!array.type<3 x !felt.type>) -> index
      %self = struct.new : !struct.type<@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>, %values: !array.type<3 x !felt.type>) { function.return }
  }
}

