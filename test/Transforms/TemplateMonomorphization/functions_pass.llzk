// Reachable free-function templates use concrete arguments and share their clones.
// RUN: llzk-opt %s --split-input-file --llzk-monomorphize-templates | FileCheck %s --enable-var-scope
// RUN: llzk-opt %s --split-input-file --llzk-monomorphize-templates --llzk-monomorphize-templates | FileCheck %s --enable-var-scope

// An explicit function parameter reaches a nested struct and repeated calls reuse one clone.
module attributes {llzk.lang, llzk.main = !struct.type<@Main>, test.scenario = "explicit"} {
  poly.template @ChildTemplate {
    poly.param @N : index
    struct.def @Child {
      function.def @compute() -> !struct.type<@ChildTemplate::@Child<[@N]>> {
        %self = struct.new : !struct.type<@ChildTemplate::@Child<[@N]>>
        function.return %self : !struct.type<@ChildTemplate::@Child<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@ChildTemplate::@Child<[@N]>>) { function.return }
    }
  }
  poly.template @Functions {
    poly.param @N : index
    function.def @make() -> !struct.type<@ChildTemplate::@Child<[@N]>> attributes {function.allow_witness} {
      %child = function.call @ChildTemplate::@Child::@compute() : () -> !struct.type<@ChildTemplate::@Child<[@N]>>
      function.return %child : !struct.type<@ChildTemplate::@Child<[@N]>>
    }
  }
  struct.def @Main {
    function.def @compute() -> !struct.type<@Main> {
      %a = function.call @Functions::@make<[2]>() : () -> !struct.type<@ChildTemplate::@Child<[2]>>
      %b = function.call @Functions::@make<[2]>() : () -> !struct.type<@ChildTemplate::@Child<[2]>>
      %self = struct.new : !struct.type<@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>) { function.return }
  }
}

