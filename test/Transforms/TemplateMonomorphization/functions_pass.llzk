// Infer an explicit wildcard from the call signature while preserving the other parameter.
module attributes {llzk.lang, llzk.main = !struct.type<@Main>, test.scenario = "signature_wildcard"} {
  poly.template @Pick {
    poly.param @T : !poly.tvar<@T>
    poly.param @Tag : index
    function.def @id(%value: !poly.tvar<@T>) -> !poly.tvar<@T> {
      function.return %value : !poly.tvar<@T>
    }
  }
  struct.def @Main {
    function.def @compute() -> !struct.type<@Main> {
      %value = arith.constant 4 : index
      %a = function.call @Pick::@id<[?, 7]>(%value) : (index) -> index
      %b = function.call @Pick::@id<[index, 7]>(%value) : (index) -> index
      %self = struct.new : !struct.type<@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>) { function.return }
  }
}

// CHECK-LABEL: module attributes {llzk.lang, llzk.main = !struct.type<@Main__spec_0>, test.scenario = "signature_wildcard"} {
// CHECK:      struct.def @Main__spec_0 {
// CHECK:          function.call @id__spec_0(
// CHECK:          function.call @id__spec_0(
// CHECK:      function.def @id__spec_0(%{{[0-9a-zA-Z_\.]+}}: index) -> index attributes {poly.arguments = [index, 7 : index], poly.origin = @Pick::@id} {
// CHECK-NOT:  function.def @id__spec_1

// -----

// Recursive calls stop when the template condition becomes false.
module attributes {llzk.lang, llzk.main = !struct.type<@Main>, test.scenario = "bounded_recursion"} {
  poly.template @Rec {
    poly.param @N : index
    poly.expr @Next {
      %n = poly.read_const @N : index
      %one = arith.constant 1 : index
      %next = arith.addi %n, %one : index
      poly.yield %next : index
    }
    function.def @f() -> index {
      %n = poly.read_const @N : index
      %limit = arith.constant 3 : index
      %continue = arith.cmpi ult, %n, %limit : index
      %result = scf.if %continue -> (index) {
        %next = function.call @Rec::@f<[@Next]>() : () -> index
        scf.yield %next : index
      } else {
        scf.yield %n : index
      }
      function.return %result : index
    }
  }
  struct.def @Main {
    function.def @compute() -> !struct.type<@Main> {
      %value = function.call @Rec::@f<[0]>() : () -> index
      %self = struct.new : !struct.type<@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>) { function.return }
  }
}

