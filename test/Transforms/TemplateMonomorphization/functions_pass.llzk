// A dead call does not require evaluating the callee's unknown loop bound.
module attributes {llzk.lang, llzk.main = !struct.type<@Main>, test.scenario = "dead_function"} {
  function.def @loop(%n: index) {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    scf.for %i = %zero to %n step %one {
      scf.yield
    }
    function.return
  }
  struct.def @Main {
    function.def @compute() -> !struct.type<@Main> {
      %false = arith.constant false
      %five = arith.constant 5 : index
      scf.if %false {
        function.call @loop(%five) : (index) -> ()
        scf.yield
      }
      %self = struct.new : !struct.type<@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>) { function.return }
  }
}

// CHECK-LABEL: module attributes {llzk.lang, llzk.main = !struct.type<@Main__spec_0>, test.scenario = "dead_function"} {
// CHECK:        function.def @loop(%{{[0-9a-zA-Z_\.]+}}: index) {
// CHECK:        struct.def @Main__spec_0 {
// CHECK:          function.call @loop(
// CHECK-NOT:    function.def @loop__spec_0

