// A type argument is re-spelled for a free-function clone in a nested root.
module attributes {llzk.lang, llzk.main = !struct.type<@Main>, test.scenario = "namespaced_type"} {
  module @Bar attributes {llzk.lang} {
    struct.def @Foo {
      function.def @compute() -> !struct.type<@Foo> {
        %self = struct.new : !struct.type<@Foo>
        function.return %self : !struct.type<@Foo>
      }
      function.def @constrain(%self: !struct.type<@Foo>) { function.return }
    }
    poly.template @Identity {
      poly.param @T : !poly.tvar<@T>
      function.def @id(%value: !poly.tvar<@T>) -> !poly.tvar<@T> {
        function.return %value : !poly.tvar<@T>
      }
    }
  }
  struct.def @Main {
    function.def @compute() -> !struct.type<@Main> {
      %foo = function.call @Bar::@Foo::@compute() : () -> !struct.type<@Bar::@Foo>
      %value = function.call @Bar::@Identity::@id<[!struct.type<@Bar::@Foo>]>(%foo) : (!struct.type<@Bar::@Foo>) -> !struct.type<@Bar::@Foo>
      %self = struct.new : !struct.type<@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>) { function.return }
  }
}

// CHECK-LABEL: module attributes {llzk.lang, llzk.main = !struct.type<@Main__spec_0>, test.scenario = "namespaced_type"} {
// CHECK:      module @Bar attributes {llzk.lang} {
// CHECK:        struct.def @Foo__spec_1 {
// CHECK:        function.def @id__spec_0(%{{[0-9a-zA-Z_\.]+}}: !struct.type<@Foo__spec_1>) -> !struct.type<@Foo__spec_1> attributes {poly.arguments = [!struct.type<@Bar::@Foo>], poly.origin = @Bar::@Identity::@id} {
// CHECK:      struct.def @Main__spec_0 {
// CHECK:        function.call @Bar::@id__spec_0(
// CHECK-NOT:  function.def @id__spec_1

