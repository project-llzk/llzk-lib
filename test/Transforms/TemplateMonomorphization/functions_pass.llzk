// CHECK:        struct.def @Main__spec_0 {
// CHECK:          function.call @f__spec_0() : () -> index
// CHECK:        function.def @f__spec_0() -> index attributes {poly.arguments = [0 : index], poly.origin = @Rec::@f} {
// CHECK:          function.call @f__spec_1() : () -> index
// CHECK:        function.def @f__spec_1() -> index attributes {poly.arguments = [1 : index], poly.origin = @Rec::@f} {
// CHECK:          function.call @f__spec_2() : () -> index
// CHECK:        function.def @f__spec_2() -> index attributes {poly.arguments = [2 : index], poly.origin = @Rec::@f} {
// CHECK:          function.call @f__spec_3() : () -> index
// CHECK:        function.def @f__spec_3() -> index attributes {poly.arguments = [3 : index], poly.origin = @Rec::@f} {
// CHECK:          function.call @Rec::@f<[4]>() : () -> index
// CHECK-NOT:    function.def @f__spec_4

