// CHECK:        struct.def @Main__spec_0 {
// CHECK:          function.call @make__spec_0() : () -> !struct.type<@Child__spec_1>
// CHECK:          function.call @make__spec_0() : () -> !struct.type<@Child__spec_1>
// CHECK:        struct.def @Child__spec_1 {
// CHECK:        function.def @make__spec_0() -> !struct.type<@Child__spec_1> attributes {function.allow_witness, poly.arguments = [2 : index], poly.origin = @Functions::@make} {
// CHECK:          function.call @Child__spec_1::@compute() : () -> !struct.type<@Child__spec_1>
// CHECK-NOT:    function.def @make__spec_1

// -----

// Infer a parameter through a struct type spelled relative to the callee's nested root.
module attributes {llzk.lang, llzk.main = !struct.type<@Main>, test.scenario = "namespaced_inference"} {
  module @Bar attributes {llzk.lang} {
    poly.template @BoxTemplate {
      poly.param @N : index
      struct.def @Box {
        function.def @compute() -> !struct.type<@BoxTemplate::@Box<[@N]>> {
          %self = struct.new : !struct.type<@BoxTemplate::@Box<[@N]>>
          function.return %self : !struct.type<@BoxTemplate::@Box<[@N]>>
        }
        function.def @constrain(%self: !struct.type<@BoxTemplate::@Box<[@N]>>) { function.return }
      }
    }
    poly.template @Use {
      poly.param @N : index
      function.def @size(%box: !struct.type<@BoxTemplate::@Box<[@N]>>) -> index {
        %n = poly.read_const @N : index
        function.return %n : index
      }
    }
  }
  struct.def @Main {
    function.def @compute() -> !struct.type<@Main> {
      %box = function.call @Bar::@BoxTemplate::@Box::@compute() : () -> !struct.type<@Bar::@BoxTemplate::@Box<[2]>>
      %size = function.call @Bar::@Use::@size(%box) : (!struct.type<@Bar::@BoxTemplate::@Box<[2]>>) -> index
      %self = struct.new : !struct.type<@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>) { function.return }
  }
}

