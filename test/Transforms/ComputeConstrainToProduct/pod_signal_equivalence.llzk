// RUN: llzk-opt -split-input-file --llzk-compute-constrain-to-product="root-struct=Root" %s | FileCheck --enable-var-scope %s

!Inputs = !pod.type<[@value: !felt.type]>

module attributes {llzk.lang} {
  struct.def @SameRecord {
    function.def @compute(%input: !felt.type) -> !struct.type<@SameRecord> {
      %self = struct.new : !struct.type<@SameRecord>
      function.return %self : !struct.type<@SameRecord>
    }
    function.def @constrain(%self: !struct.type<@SameRecord>, %input: !felt.type) {
      function.return
    }
  }

  struct.def @Root {
    struct.member @child : !struct.type<@SameRecord>
    function.def @compute(%inputs: !Inputs) -> !struct.type<@Root> {
      %self = struct.new : !struct.type<@Root>
      %input = pod.read %inputs[@value] : !Inputs, !felt.type
      %child = function.call @SameRecord::@compute(%input) : (!felt.type) -> !struct.type<@SameRecord>
      struct.writem %self[@child] = %child : !struct.type<@Root>, !struct.type<@SameRecord>
      function.return %self : !struct.type<@Root>
    }
    function.def @constrain(%self: !struct.type<@Root>, %inputs: !Inputs) {
      %child = struct.readm %self[@child] : !struct.type<@Root>, !struct.type<@SameRecord>
      %input = pod.read %inputs[@value] : !Inputs, !felt.type
      function.call @SameRecord::@constrain(%child, %input) : (!struct.type<@SameRecord>, !felt.type) -> ()
      function.return
    }
  }
}

// CHECK-LABEL: struct.def @Root {
// CHECK:         function.def @product
// CHECK:           function.call @SameRecord::@product(

// -----

!Inputs = !pod.type<[@value: !felt.type]>

module attributes {llzk.lang} {
  struct.def @ClobberedRecord {
    function.def @compute(%input: !felt.type) -> !struct.type<@ClobberedRecord> {
      %self = struct.new : !struct.type<@ClobberedRecord>
      function.return %self : !struct.type<@ClobberedRecord>
    }
    function.def @constrain(%self: !struct.type<@ClobberedRecord>, %input: !felt.type) {
      function.return
