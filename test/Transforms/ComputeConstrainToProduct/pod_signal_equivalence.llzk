  }

  struct.def @Root {
    struct.member @child : !struct.type<@ClobberedRecord>
    function.def @compute(%inputs: !Inputs, %replacement: !felt.type) -> !struct.type<@Root> {
      %self = struct.new : !struct.type<@Root>
      %input = pod.read %inputs[@value] : !Inputs, !felt.type
      %child = function.call @ClobberedRecord::@compute(%input) : (!felt.type) -> !struct.type<@ClobberedRecord>
      struct.writem %self[@child] = %child : !struct.type<@Root>, !struct.type<@ClobberedRecord>
      function.return %self : !struct.type<@Root>
    }
    function.def @constrain(
        %self: !struct.type<@Root>, %inputs: !Inputs, %replacement: !felt.type) {
      %child = struct.readm %self[@child] : !struct.type<@Root>, !struct.type<@ClobberedRecord>
      pod.write %inputs[@value] = %replacement : !Inputs, !felt.type
      %input = pod.read %inputs[@value] : !Inputs, !felt.type
      function.call @ClobberedRecord::@constrain(%child, %input) : (!struct.type<@ClobberedRecord>, !felt.type) -> ()
      function.return
    }
  }
}

