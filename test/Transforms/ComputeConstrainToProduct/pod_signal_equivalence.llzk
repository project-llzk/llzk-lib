!Inputs = !pod.type<[@value: !felt.type]>

module attributes {llzk.lang} {
  struct.def @StructSnapshot {
    function.def @compute(%input: !felt.type) -> !struct.type<@StructSnapshot> {
      %self = struct.new : !struct.type<@StructSnapshot>
      function.return %self : !struct.type<@StructSnapshot>
    }
    function.def @constrain(%self: !struct.type<@StructSnapshot>, %input: !felt.type) {
      function.return
    }
  }

  struct.def @Root {
    struct.member @saved : !Inputs
    struct.member @child : !struct.type<@StructSnapshot>
    function.def @compute(%inputs: !Inputs) -> !struct.type<@Root> {
      %self = struct.new : !struct.type<@Root>
      %input = pod.read %inputs[@value] : !Inputs, !felt.type
      struct.writem %self[@saved] = %inputs : !struct.type<@Root>, !Inputs
      %child = function.call @StructSnapshot::@compute(%input) : (!felt.type) -> !struct.type<@StructSnapshot>
      struct.writem %self[@child] = %child : !struct.type<@Root>, !struct.type<@StructSnapshot>
      function.return %self : !struct.type<@Root>
    }
    function.def @constrain(%self: !struct.type<@Root>, %inputs: !Inputs) {
      %child = struct.readm %self[@child] : !struct.type<@Root>, !struct.type<@StructSnapshot>
      %copy = struct.readm %self[@saved] : !struct.type<@Root>, !Inputs
      %input = pod.read %copy[@value] : !Inputs, !felt.type
      function.call @StructSnapshot::@constrain(%child, %input) : (!struct.type<@StructSnapshot>, !felt.type) -> ()
      function.return
    }
  }
}

