!Inputs = !pod.type<[@value: !felt.type]>

module attributes {llzk.lang} {
  struct.def @DistinctPods {
    function.def @compute(%input: !felt.type) -> !struct.type<@DistinctPods> {
      %self = struct.new : !struct.type<@DistinctPods>
      function.return %self : !struct.type<@DistinctPods>
    }
    function.def @constrain(%self: !struct.type<@DistinctPods>, %input: !felt.type) {
      function.return
    }
  }

  struct.def @Root {
    struct.member @child : !struct.type<@DistinctPods>
    function.def @compute(%value: !felt.type) -> !struct.type<@Root> {
      %self = struct.new : !struct.type<@Root>
      %inputs = pod.new { @value = %value } : !Inputs
      %input = pod.read %inputs[@value] : !Inputs, !felt.type
      %child = function.call @DistinctPods::@compute(%input) : (!felt.type) -> !struct.type<@DistinctPods>
      struct.writem %self[@child] = %child : !struct.type<@Root>, !struct.type<@DistinctPods>
      function.return %self : !struct.type<@Root>
    }
    function.def @constrain(%self: !struct.type<@Root>, %value: !felt.type) {
      %child = struct.readm %self[@child] : !struct.type<@Root>, !struct.type<@DistinctPods>
      %inputs = pod.new { @value = %value } : !Inputs
      %input = pod.read %inputs[@value] : !Inputs, !felt.type
      function.call @DistinctPods::@constrain(%child, %input) : (!struct.type<@DistinctPods>, !felt.type) -> ()
      function.return
