// CHECK:         function.def @product
// CHECK-NOT:       function.call @AliasedMemberWrite::@product(
// CHECK:           function.call @AliasedMemberWrite::@compute(
// CHECK:           struct.writem
// CHECK:           function.call @AliasedMemberWrite::@constrain(
