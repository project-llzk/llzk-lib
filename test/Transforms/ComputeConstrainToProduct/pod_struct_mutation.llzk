// RUN: llzk-opt --llzk-compute-constrain-to-product %s | FileCheck %s

// A POD record retains the same component handle while the component changes.
// Moving Child::constrain to the compute call would observe value 0 instead of 1.
!State = !struct.type<@Main>
!Handles = !pod.type<[@state: !State]>
module attributes {llzk.lang} {
  struct.def @Child {
    function.def @compute(%state: !State) -> !struct.type<@Child> {
      %self = struct.new : !struct.type<@Child>
      function.return %self : !struct.type<@Child>
    }
    function.def @constrain(%self: !struct.type<@Child>, %state: !State) {
      %value = struct.readm %state[@value] : !State, !felt.type
      %one = felt.const 1
      constrain.eq %value, %one : !felt.type
      function.return
    }
  }
  struct.def @Main {
    struct.member @value : !felt.type {llzk.pub}
    struct.member @child : !struct.type<@Child>
    struct.member @handles : !Handles
    function.def @compute() -> !struct.type<@Main> {
      %self = struct.new : !struct.type<@Main>
      %handles = pod.new { @state = %self } : !Handles
      // Save a POD snapshot for constrain; the copied handle still refers to self.
      struct.writem %self[@handles] = %handles : !State, !Handles
      %state = pod.read %handles[@state] : !Handles, !State
      %zero = felt.const 0
      struct.writem %self[@value] = %zero : !State, !felt.type
      %child = function.call @Child::@compute(%state) : (!State) -> !struct.type<@Child>
      struct.writem %self[@child] = %child : !struct.type<@Main>, !struct.type<@Child>
      // Mutate through the original allocation without changing the POD record.
      %one = felt.const 1
      struct.writem %self[@value] = %one : !State, !felt.type
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>) {
      %child = struct.readm %self[@child] : !struct.type<@Main>, !struct.type<@Child>
      %handles = struct.readm %self[@handles] : !State, !Handles
      %state = pod.read %handles[@state] : !Handles, !State
      function.call @Child::@constrain(%child, %state) : (!struct.type<@Child>, !State) -> ()
      function.return
    }
  }
}

// CHECK-LABEL: struct.def @Main {
// CHECK: function.def @product() -> !struct.type<@Main> attributes {function.allow_constraint, function.allow_witness, llzk.derived} {
// CHECK-NEXT: %[[VAL_6:[0-9a-zA-Z_.-]+]] = struct.new : <@Main> {product_source = "compute"}
// CHECK-NEXT: %[[VAL_7:[0-9a-zA-Z_.-]+]] = pod.new { @state = %[[VAL_6]] }  : <[@state: !struct.type<@Main>]> {product_source = "compute"}
// CHECK-NEXT: struct.writem %[[VAL_6]][@handles] = %[[VAL_7]] : <@Main>, !pod.type<[@state: !struct.type<@Main>]> {product_source = "compute"}
// CHECK-NEXT: %[[VAL_8:[0-9a-zA-Z_.-]+]] = pod.read %[[VAL_7]][@state] : <[@state: !struct.type<@Main>]>, !struct.type<@Main> {product_source = "compute"}
// CHECK-NEXT: %[[VAL_9:[0-9a-zA-Z_.-]+]] = felt.const  0 {product_source = "compute"}
// CHECK-NEXT: struct.writem %[[VAL_6]][@value] = %[[VAL_9]] : <@Main>, !felt.type {product_source = "compute"}
// CHECK-NEXT: %[[VAL_10:[0-9a-zA-Z_.-]+]] = function.call @Child::@compute(%[[VAL_8]]) : (!struct.type<@Main>) -> !struct.type<@Child>  {product_source = "compute"}
// CHECK-NEXT: struct.writem %[[VAL_6]][@child] = %[[VAL_10]] : <@Main>, !struct.type<@Child> {product_source = "compute"}
// CHECK-NEXT: %[[VAL_11:[0-9a-zA-Z_.-]+]] = felt.const  1 {product_source = "compute"}
// CHECK-NEXT: struct.writem %[[VAL_6]][@value] = %[[VAL_11]] : <@Main>, !felt.type {product_source = "compute"}
// CHECK-NEXT: %[[VAL_12:[0-9a-zA-Z_.-]+]] = struct.readm %[[VAL_6]][@child] : <@Main>, !struct.type<@Child> {product_source = "constrain"}
// CHECK-NEXT: %[[VAL_13:[0-9a-zA-Z_.-]+]] = struct.readm %[[VAL_6]][@handles] : <@Main>, !pod.type<[@state: !struct.type<@Main>]> {product_source = "constrain"}
// CHECK-NEXT: %[[VAL_14:[0-9a-zA-Z_.-]+]] = pod.read %[[VAL_13]][@state] : <[@state: !struct.type<@Main>]>, !struct.type<@Main> {product_source = "constrain"}
// CHECK-NEXT: function.call @Child::@constrain(%[[VAL_12]], %[[VAL_14]]) : (!struct.type<@Child>, !struct.type<@Main>) -> ()  {product_source = "constrain"}
// CHECK-NEXT: function.return %[[VAL_6]] : !struct.type<@Main>
