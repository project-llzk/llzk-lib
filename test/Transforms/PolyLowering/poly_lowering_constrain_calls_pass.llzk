// A write to independent local storage must not block input reconstruction.
module attributes {llzk.lang} {
  function.def @mutate(%data: !array.type<1 x !felt.type>, %x: !felt.type) {
    %idx = arith.constant 0 : index
    array.write %data[%idx] = %x : !array.type<1 x !felt.type>, !felt.type
    function.return
  }
  struct.def @DisjointConstrainWrite {
    function.def @compute(%input: !array.type<1 x !felt.type>, %x: !felt.type) -> !struct.type<@DisjointConstrainWrite> {
      %self = struct.new : <@DisjointConstrainWrite>
      function.return %self : !struct.type<@DisjointConstrainWrite>
    }
    function.def @constrain(%self: !struct.type<@DisjointConstrainWrite>, %input: !array.type<1 x !felt.type>, %x: !felt.type) {
      %idx = arith.constant 0 : index
      %local = array.new %x : !array.type<1 x !felt.type>
      array.write %local[%idx] = %x : !array.type<1 x !felt.type>, !felt.type
      %value = array.read %input[%idx] : !array.type<1 x !felt.type>, !felt.type
      %square = felt.mul %value, %value : !felt.type, !felt.type
      %fourth = felt.mul %square, %square : !felt.type, !felt.type
      constrain.eq %x, %fourth : !felt.type
      function.return
    }
  }
}

