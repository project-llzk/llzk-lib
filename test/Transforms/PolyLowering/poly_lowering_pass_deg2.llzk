// Tests that polynomials are lowered to degree 1 before being passed into constraint calls
module attributes {llzk.lang, llzk.main = !struct.type<@ModC1>} {
  struct.def @ModC2 {
    struct.member @val: !felt.type {llzk.pub}
    function.def @compute(%a: !felt.type, %b: !felt.type) -> !struct.type<@ModC2> {
      %self = struct.new : !struct.type<@ModC2>
      struct.writem %self[@val] = %a : !struct.type<@ModC2>, !felt.type
      function.return %self : !struct.type<@ModC2>
    }

    function.def @constrain(%self: !struct.type<@ModC2>, %a: !felt.type, %b: !felt.type) {
      %z = felt.mul %a, %b
      %0 = felt.mul %z, %z
      %1 = felt.mul %z, %a
      constrain.eq %0, %z : !felt.type
      constrain.eq %0, %1 : !felt.type

      function.return
    }
  }

  struct.def @ModC1 {
    struct.member @mod2: !struct.type<@ModC2>
    struct.member @val2: !felt.type
    function.def @compute(%a: !felt.type, %b: !felt.type) -> !struct.type<@ModC1> {
      %self = struct.new : !struct.type<@ModC1>
      function.return %self : !struct.type<@ModC1>
    }

    function.def @constrain(%self: !struct.type<@ModC1>, %a: !felt.type, %b: !felt.type) {
      %z = felt.mul %a, %b
      %0 = felt.mul %z, %z
      %1 = felt.mul %z, %a
      %2 = struct.readm %self[@mod2] : !struct.type<@ModC1>, !struct.type<@ModC2>
      function.call @ModC2::@constrain(%2, %0, %1) : (!struct.type<@ModC2>, !felt.type, !felt.type) -> ()
      %3 = struct.readm %self[@mod2] : !struct.type<@ModC1>, !struct.type<@ModC2>
      %4 = struct.readm %3[@val]: !struct.type<@ModC2>, !felt.type
      %5 = felt.mul %4, %4
      %6 = felt.mul %5, %5
      %7 = struct.readm %self[@val2] : !struct.type<@ModC1>, !felt.type
      constrain.eq %7, %6 : !felt.type
      function.return
    }
  }
}
