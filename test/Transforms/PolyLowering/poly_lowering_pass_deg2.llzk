// Tests that polynomials are lowered to degree 1 before being passed into constraint calls
module attributes {llzk.lang, llzk.main = !struct.type<@ModA1>} {
  struct.def @ModA2 {
    function.def @compute(%a: !felt.type, %b: !felt.type) -> !struct.type<@ModA2> {
      %self = struct.new : !struct.type<@ModA2>
      function.return %self : !struct.type<@ModA2>
    }

    function.def @constrain(%self: !struct.type<@ModA2>, %a: !felt.type, %b: !felt.type) {
      %z = felt.mul %a, %b
      %0 = felt.mul %z, %z
      %1 = felt.mul %z, %a
      constrain.eq %0, %z : !felt.type
      constrain.eq %0, %1 : !felt.type

      function.return
    }
  }

  struct.def @ModA1 {
    struct.member @mod2: !struct.type<@ModA2>
    function.def @compute(%a: !felt.type, %b: !felt.type) -> !struct.type<@ModA1> {
      %self = struct.new : !struct.type<@ModA1>
      function.return %self : !struct.type<@ModA1>
    }

    function.def @constrain(%self: !struct.type<@ModA1>, %a: !felt.type, %b: !felt.type) {
      %z = felt.mul %a, %b
      %0 = felt.mul %z, %z
      %1 = felt.mul %z, %a
      %2 = struct.readm %self[@mod2] : !struct.type<@ModA1>, !struct.type<@ModA2>
      function.call @ModA2::@constrain(%2, %0, %1) : (!struct.type<@ModA2>, !felt.type, !felt.type) -> ()
      function.return
    }
  }
}
