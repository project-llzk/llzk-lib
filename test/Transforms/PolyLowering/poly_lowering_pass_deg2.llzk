// Like the prior test but with call to `@ModB2::@compute`.
module attributes {llzk.lang, llzk.main = !struct.type<@ModB1>} {
  struct.def @ModB2 {
    function.def @compute(%a: !felt.type, %b: !felt.type) -> !struct.type<@ModB2> {
      %self = struct.new : !struct.type<@ModB2>
      function.return %self : !struct.type<@ModB2>
    }

    function.def @constrain(%self: !struct.type<@ModB2>, %a: !felt.type, %b: !felt.type) {
      %z = felt.mul %a, %b
      %0 = felt.mul %z, %z
      %1 = felt.mul %z, %a
      constrain.eq %0, %z : !felt.type
      constrain.eq %0, %1 : !felt.type

      function.return
    }
  }

  struct.def @ModB1 {
    struct.member @mod2: !struct.type<@ModB2>
    function.def @compute(%a: !felt.type, %b: !felt.type) -> !struct.type<@ModB1> {
      %self = struct.new : !struct.type<@ModB1>
      %mod2 = function.call @ModB2::@compute(%a, %b) : (!felt.type, !felt.type) -> !struct.type<@ModB2>
      struct.writem %self[@mod2] = %mod2 : <@ModB1>, !struct.type<@ModB2>
      function.return %self : !struct.type<@ModB1>
    }

    function.def @constrain(%self: !struct.type<@ModB1>, %a: !felt.type, %b: !felt.type) {
      %z = felt.mul %a, %b
      %0 = felt.mul %z, %z
      %1 = felt.mul %z, %a
      %2 = struct.readm %self[@mod2] : !struct.type<@ModB1>, !struct.type<@ModB2>
      function.call @ModB2::@constrain(%2, %0, %1) : (!struct.type<@ModB2>, !felt.type, !felt.type) -> ()
      function.return
    }
  }
}
