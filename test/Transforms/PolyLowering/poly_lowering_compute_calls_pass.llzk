// RUN: llzk-opt -split-input-file -llzk-poly-lowering-pass="max-degree=2" --verify-each %s | FileCheck --enable-var-scope %s

// A helper receiving an independent local aggregate must not reject input reads.
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @mutate(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !array.type<1 x !felt.type>, %[[VAL_1:[0-9a-zA-Z_\.]+]]: !felt.type) {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:      array.write %[[VAL_0]]{{\[}}%[[VAL_2]]] = %[[VAL_1]] : <1 x !felt.type>, !felt.type
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:    struct.def @IndependentHelperArgument {
// CHECK-NEXT:      function.def @compute(%[[VAL_3:[0-9a-zA-Z_\.]+]]: !array.type<1 x !felt.type>, %[[VAL_4:[0-9a-zA-Z_\.]+]]: !felt.type) -> !struct.type<@IndependentHelperArgument> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_5:[0-9a-zA-Z_\.]+]] = struct.new : <@IndependentHelperArgument>
// CHECK-NEXT:        %[[VAL_6:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:        %[[VAL_7:[0-9a-zA-Z_\.]+]] = array.new %[[VAL_4]] : <1 x !felt.type>
// CHECK-NEXT:        function.call @mutate(%[[VAL_7]], %[[VAL_4]]) : (!array.type<1 x !felt.type>, !felt.type) -> ()
// CHECK-NEXT:        %[[VAL_8:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:        %[[VAL_9:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_3]]{{\[}}%[[VAL_8]]] : <1 x !felt.type>, !felt.type
// CHECK-NEXT:        %[[VAL_10:[0-9a-zA-Z_\.]+]] = felt.mul %[[VAL_9]], %[[VAL_9]] : !felt.type, !felt.type
// CHECK-NEXT:        struct.writem %[[VAL_5]][@__llzk_poly_lowering_pass_aux_member_0] = %[[VAL_10]] : <@IndependentHelperArgument>, !felt.type
// CHECK-NEXT:        function.return %[[VAL_5]] : !struct.type<@IndependentHelperArgument>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_11:[0-9a-zA-Z_\.]+]]: !struct.type<@IndependentHelperArgument>, %[[VAL_12:[0-9a-zA-Z_\.]+]]: !array.type<1 x !felt.type>, %[[VAL_13:[0-9a-zA-Z_\.]+]]: !felt.type) attributes {function.allow_constraint} {
// CHECK-NEXT:        %[[VAL_14:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:        %[[VAL_15:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_12]]{{\[}}%[[VAL_14]]] : <1 x !felt.type>, !felt.type
// CHECK-NEXT:        %[[VAL_16:[0-9a-zA-Z_\.]+]] = felt.mul %[[VAL_15]], %[[VAL_15]] : !felt.type, !felt.type
// CHECK-NEXT:        %[[VAL_17:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_11]][@__llzk_poly_lowering_pass_aux_member_0] : <@IndependentHelperArgument>, !felt.type
// CHECK-NEXT:        constrain.eq %[[VAL_17]], %[[VAL_16]] : !felt.type, !felt.type
// CHECK-NEXT:        %[[VAL_18:[0-9a-zA-Z_\.]+]] = felt.mul %[[VAL_17]], %[[VAL_17]] : !felt.type, !felt.type
// CHECK-NEXT:        constrain.eq %[[VAL_13]], %[[VAL_18]] : !felt.type, !felt.type
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:      struct.member @__llzk_poly_lowering_pass_aux_member_0 : !felt.type
// CHECK-NEXT:    }
// CHECK-NEXT:  }
module attributes {llzk.lang} {
  function.def @mutate(%data: !array.type<1 x !felt.type>, %x: !felt.type) {
    %idx = arith.constant 0 : index
    array.write %data[%idx] = %x : !array.type<1 x !felt.type>, !felt.type
    function.return
  }
  struct.def @IndependentHelperArgument {
    function.def @compute(%input: !array.type<1 x !felt.type>, %x: !felt.type) -> !struct.type<@IndependentHelperArgument> {
      %self = struct.new : <@IndependentHelperArgument>
      %idx = arith.constant 0 : index
      %local = array.new %x : !array.type<1 x !felt.type>
      function.call @mutate(%local, %x) : (!array.type<1 x !felt.type>, !felt.type) -> ()
      function.return %self : !struct.type<@IndependentHelperArgument>
    }
    function.def @constrain(%self: !struct.type<@IndependentHelperArgument>, %input: !array.type<1 x !felt.type>, %x: !felt.type) {
      %idx = arith.constant 0 : index
      %value = array.read %input[%idx] : !array.type<1 x !felt.type>, !felt.type
      %square = felt.mul %value, %value : !felt.type, !felt.type
      %fourth = felt.mul %square, %square : !felt.type, !felt.type
      constrain.eq %x, %fourth : !felt.type
      function.return
    }
  }
}

// -----

// A read-only compute helper must not block return-side reconstruction.
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @mutate(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !array.type<1 x !felt.type>, %[[VAL_1:[0-9a-zA-Z_\.]+]]: !felt.type) {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_0]]{{\[}}%[[VAL_2]]] : <1 x !felt.type>, !felt.type
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:    struct.def @ReadOnlyComputeHelper {
// CHECK-NEXT:      function.def @compute(%[[VAL_4:[0-9a-zA-Z_\.]+]]: !array.type<1 x !felt.type>, %[[VAL_5:[0-9a-zA-Z_\.]+]]: !felt.type) -> !struct.type<@ReadOnlyComputeHelper> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_6:[0-9a-zA-Z_\.]+]] = struct.new : <@ReadOnlyComputeHelper>
// CHECK-NEXT:        function.call @mutate(%[[VAL_4]], %[[VAL_5]]) : (!array.type<1 x !felt.type>, !felt.type) -> ()
// CHECK-NEXT:        %[[VAL_7:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:        %[[VAL_8:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_4]]{{\[}}%[[VAL_7]]] : <1 x !felt.type>, !felt.type
// CHECK-NEXT:        %[[VAL_9:[0-9a-zA-Z_\.]+]] = felt.mul %[[VAL_8]], %[[VAL_8]] : !felt.type, !felt.type
// CHECK-NEXT:        struct.writem %[[VAL_6]][@__llzk_poly_lowering_pass_aux_member_0] = %[[VAL_9]] : <@ReadOnlyComputeHelper>, !felt.type
// CHECK-NEXT:        function.return %[[VAL_6]] : !struct.type<@ReadOnlyComputeHelper>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_10:[0-9a-zA-Z_\.]+]]: !struct.type<@ReadOnlyComputeHelper>, %[[VAL_11:[0-9a-zA-Z_\.]+]]: !array.type<1 x !felt.type>, %[[VAL_12:[0-9a-zA-Z_\.]+]]: !felt.type) attributes {function.allow_constraint} {
// CHECK-NEXT:        %[[VAL_13:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:        %[[VAL_14:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_11]]{{\[}}%[[VAL_13]]] : <1 x !felt.type>, !felt.type
// CHECK-NEXT:        %[[VAL_15:[0-9a-zA-Z_\.]+]] = felt.mul %[[VAL_14]], %[[VAL_14]] : !felt.type, !felt.type
// CHECK-NEXT:        %[[VAL_16:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_10]][@__llzk_poly_lowering_pass_aux_member_0] : <@ReadOnlyComputeHelper>, !felt.type
// CHECK-NEXT:        constrain.eq %[[VAL_16]], %[[VAL_15]] : !felt.type, !felt.type
// CHECK-NEXT:        %[[VAL_17:[0-9a-zA-Z_\.]+]] = felt.mul %[[VAL_16]], %[[VAL_16]] : !felt.type, !felt.type
// CHECK-NEXT:        constrain.eq %[[VAL_12]], %[[VAL_17]] : !felt.type, !felt.type
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:      struct.member @__llzk_poly_lowering_pass_aux_member_0 : !felt.type
// CHECK-NEXT:    }
// CHECK-NEXT:  }
module attributes {llzk.lang} {
  function.def @mutate(%data: !array.type<1 x !felt.type>, %x: !felt.type) {
    %idx = arith.constant 0 : index
    %ignored = array.read %data[%idx] : !array.type<1 x !felt.type>, !felt.type
    function.return
  }
  struct.def @ReadOnlyComputeHelper {
    function.def @compute(%input: !array.type<1 x !felt.type>, %x: !felt.type) -> !struct.type<@ReadOnlyComputeHelper> {
      %self = struct.new : <@ReadOnlyComputeHelper>
      function.call @mutate(%input, %x) : (!array.type<1 x !felt.type>, !felt.type) -> ()
      function.return %self : !struct.type<@ReadOnlyComputeHelper>
    }
    function.def @constrain(%self: !struct.type<@ReadOnlyComputeHelper>, %input: !array.type<1 x !felt.type>, %x: !felt.type) {
      %idx = arith.constant 0 : index
      %value = array.read %input[%idx] : !array.type<1 x !felt.type>, !felt.type
      %square = felt.mul %value, %value : !felt.type, !felt.type
      %fourth = felt.mul %square, %square : !felt.type, !felt.type
      constrain.eq %x, %fourth : !felt.type
      function.return
    }
  }
}
