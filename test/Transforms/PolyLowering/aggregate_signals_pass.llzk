// RUN: llzk-opt -llzk-poly-lowering-pass='main-only=true max-degree=2' %s | FileCheck %s --check-prefix=MAIN
// RUN: llzk-opt -llzk-poly-lowering-pass='mark-auxiliary-signals=true max-degree=2' %s | FileCheck %s --check-prefix=ALL

// Factor aggregate reads into signal auxiliaries and rebuild those reads in compute.
// Main-only lowering leaves the other component's cubic constraint unchanged.
!F = !felt.type<"babybear">
!P = !pod.type<[@value: !F]>
module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  struct.def @Main {
    struct.member @out : !F {llzk.pub}
    struct.member @record : !P {signal}
    function.def @compute(%input: !array.type<2,2 x !F>) -> !struct.type<@Main> {
      %self = struct.new : <@Main>
      %zero = arith.constant 0 : index
      %slice = array.extract %input[%zero] : !array.type<2,2 x !F>
      %x = array.read %slice[%zero] : !array.type<2 x !F>, !F
      %record = pod.new : !P
      pod.write %record[@value] = %x : !P, !F
      struct.writem %self[@record] = %record : <@Main>, !P
      %sum = felt.add %x, %x : !F, !F
      %square = felt.mul %sum, %sum : !F, !F
      %cube = felt.mul %square, %sum : !F, !F
      struct.writem %self[@out] = %cube : <@Main>, !F
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>, %input: !array.type<2,2 x !F>) {
      %zero = arith.constant 0 : index
      %slice = array.extract %input[%zero] : !array.type<2,2 x !F>
      %x = array.read %slice[%zero] : !array.type<2 x !F>, !F
      %record = struct.readm %self[@record] : <@Main>, !P
      %value = pod.read %record[@value] : !P, !F
      %sum = felt.add %x, %value : !F, !F
      %square = felt.mul %sum, %sum : !F, !F
      %cube = felt.mul %square, %sum : !F, !F
      %out = struct.readm %self[@out] : <@Main>, !F
      constrain.eq %out, %cube : !F, !F
      function.return
    }
  }
  struct.def @Unselected {
    struct.member @out : !F {llzk.pub}
    function.def @compute(%x: !F) -> !struct.type<@Unselected> {
      %self = struct.new : <@Unselected>
      function.return %self : !struct.type<@Unselected>
    }
    function.def @constrain(%self: !struct.type<@Unselected>, %x: !F) {
      %square = felt.mul %x, %x : !F, !F
      %cube = felt.mul %square, %x : !F, !F
      %out = struct.readm %self[@out] : <@Unselected>, !F
      constrain.eq %out, %cube : !F, !F
      function.return
    }
  }
}

