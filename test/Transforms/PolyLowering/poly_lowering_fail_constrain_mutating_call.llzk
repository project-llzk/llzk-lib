// Calls can change storage without producing any SSA value in the read chain.
module attributes {llzk.lang} {
  struct.def @UnknownComputeMutation {
    function.def @compute(%input: !array.type<1 x !felt.type>, %x: !felt.type) -> !struct.type<@UnknownComputeMutation> {
      %self = struct.new : <@UnknownComputeMutation>
      "test.mutate"(%input) : (!array.type<1 x !felt.type>) -> ()
      function.return %self : !struct.type<@UnknownComputeMutation>
    }
    // expected-error@+1 {{cannot rebuild aggregate argument in compute-side auxiliary expression: compute may mutate the input storage}}
    function.def @constrain(%self: !struct.type<@UnknownComputeMutation>, %input: !array.type<1 x !felt.type>, %x: !felt.type) {
      %idx = arith.constant 0 : index
      %value = array.read %input[%idx] : !array.type<1 x !felt.type>, !felt.type
      %square = felt.mul %value, %value : !felt.type, !felt.type
      %fourth = felt.mul %square, %square : !felt.type, !felt.type
      constrain.eq %x, %fourth : !felt.type
      function.return
    }
  }
}

// -----

// Calls can change storage without producing any SSA value in the read chain.
module attributes {llzk.lang} {
  function.def @mutate(%data: !array.type<1 x !felt.type>, %x: !felt.type) {
    %idx = arith.constant 0 : index
    array.write %data[%idx] = %x : !array.type<1 x !felt.type>, !felt.type
    function.return
  }
  struct.def @OpaqueComputeStorage {
    function.def @compute(%input: !array.type<1 x !felt.type>, %x: !felt.type) -> !struct.type<@OpaqueComputeStorage> {
      %self = struct.new : <@OpaqueComputeStorage>
      %idx = arith.constant 0 : index
      %local = array.new %x : !array.type<1 x !felt.type>
      %opaque = "test.opaque_storage"(%local) : (!array.type<1 x !felt.type>) -> !array.type<1 x !felt.type>
      array.write %opaque[%idx] = %x : !array.type<1 x !felt.type>, !felt.type
      function.return %self : !struct.type<@OpaqueComputeStorage>
    }
    // expected-error@+1 {{cannot rebuild aggregate argument in compute-side auxiliary expression: compute may mutate the input storage}}
    function.def @constrain(%self: !struct.type<@OpaqueComputeStorage>, %input: !array.type<1 x !felt.type>, %x: !felt.type) {
      %idx = arith.constant 0 : index
      %value = array.read %input[%idx] : !array.type<1 x !felt.type>, !felt.type
      %square = felt.mul %value, %value : !felt.type, !felt.type
      %fourth = felt.mul %square, %square : !felt.type, !felt.type
      constrain.eq %x, %fourth : !felt.type
      function.return
    }
  }
}

// -----

// Distinct component arguments may be handles to the same instance.
module attributes {llzk.lang} {
  struct.def @Payload {
    struct.member @value : !felt.type {llzk.pub}
    function.def @compute() -> !struct.type<@Payload> {
      %self = struct.new : <@Payload>
      function.return %self : !struct.type<@Payload>
    }
    function.def @constrain(%self: !struct.type<@Payload>) {
      function.return
    }
  }
  function.def private @opaque(%data: !struct.type<@Payload>) attributes {extern}
  struct.def @ComponentHandles {
    function.def @compute(%a: !struct.type<@Payload>, %b: !struct.type<@Payload>, %x: !felt.type) -> !struct.type<@ComponentHandles> {
      %self = struct.new : <@ComponentHandles>
      function.call @opaque(%b) : (!struct.type<@Payload>) -> ()
      function.return %self : !struct.type<@ComponentHandles>
    }
    // expected-error@+1 {{cannot rebuild aggregate argument in compute-side auxiliary expression: compute may mutate the input storage}}
    function.def @constrain(%self: !struct.type<@ComponentHandles>, %a: !struct.type<@Payload>, %b: !struct.type<@Payload>, %x: !felt.type) {
      %value = struct.readm %a[@value] : <@Payload>, !felt.type
      %square = felt.mul %value, %value : !felt.type, !felt.type
      %fourth = felt.mul %square, %square : !felt.type, !felt.type
      constrain.eq %x, %fourth : !felt.type
      function.return
    }
  }
}
