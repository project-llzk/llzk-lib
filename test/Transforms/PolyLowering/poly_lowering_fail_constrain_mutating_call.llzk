// -----

// Calls can change storage without producing any SSA value in the read chain.
module attributes {llzk.lang} {
  function.def @mutate(%data: !array.type<1 x !felt.type>, %x: !felt.type) {
    %idx = arith.constant 0 : index
    array.write %data[%idx] = %x : !array.type<1 x !felt.type>, !felt.type
    function.return
  }
  struct.def @ConstrainMutatedView {
    function.def @compute(%input: !array.type<1,1 x !felt.type>, %x: !felt.type) -> !struct.type<@ConstrainMutatedView> {
      %self = struct.new : <@ConstrainMutatedView>
      function.return %self : !struct.type<@ConstrainMutatedView>
    }
    function.def @constrain(%self: !struct.type<@ConstrainMutatedView>, %input: !array.type<1,1 x !felt.type>, %x: !felt.type) {
      %idx = arith.constant 0 : index
      %view = array.extract %input[%idx] : !array.type<1,1 x !felt.type>
      function.call @mutate(%view, %x) : (!array.type<1 x !felt.type>, !felt.type) -> ()
      // expected-error@+1 {{cannot rebuild storage read in compute-side auxiliary expression: storage may have been mutated; aggregate mutations cannot be replayed}}
      %value = array.read %input[%idx, %idx] : !array.type<1,1 x !felt.type>, !felt.type
      %square = felt.mul %value, %value : !felt.type, !felt.type
      %fourth = felt.mul %square, %square : !felt.type, !felt.type
      constrain.eq %x, %fourth : !felt.type
      function.return
    }
  }
}

