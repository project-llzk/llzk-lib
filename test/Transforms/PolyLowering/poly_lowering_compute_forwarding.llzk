// RUN: llzk-opt -llzk-poly-lowering-pass="max-degree=2" --verify-each %s | FileCheck %s

module attributes {llzk.lang} {
  // Resolve the correct result of nested region forwarding. The unrelated local
  // allocation is harmless, and rebuilt reads must follow the final member write.
  struct.def @IfForward {
    struct.member @value : !felt.type
    function.def @compute(%cond: i1, %a: !felt.type) -> !struct.type<@IfForward> {
      %self = struct.new : !struct.type<@IfForward>
      %unused = struct.new : !struct.type<@IfForward>
      struct.writem %self[@value] = %a : !struct.type<@IfForward>, !felt.type
      %flag, %forwarded = scf.if %cond -> (i1, !struct.type<@IfForward>) {
        %nested = scf.if %cond -> (!struct.type<@IfForward>) {
          scf.yield %self : !struct.type<@IfForward>
        } else {
          scf.yield %self : !struct.type<@IfForward>
        }
        scf.yield %cond, %nested : i1, !struct.type<@IfForward>
      } else {
        scf.yield %cond, %self : i1, !struct.type<@IfForward>
      }
      %updated = felt.mul %a, %a : !felt.type, !felt.type
      struct.writem %self[@value] = %updated : !struct.type<@IfForward>, !felt.type
      function.return %forwarded : !struct.type<@IfForward>
    }
    function.def @constrain(%self: !struct.type<@IfForward>, %cond: i1, %a: !felt.type) {
      %value = struct.readm %self[@value] : !struct.type<@IfForward>, !felt.type
      %product = felt.mul %value, %a : !felt.type, !felt.type
      %cube = felt.mul %product, %a : !felt.type, !felt.type
      constrain.eq %cube, %a : !felt.type
      function.return
    }
  }

  // Both edges of one predecessor forward the same allocation. A backedge
  // preserves it, and both returns reuse the resolved block argument.
  struct.def @CfgForward {
    function.def @compute(%cond: i1, %a: !felt.type) -> !struct.type<@CfgForward> {
      %self = struct.new : !struct.type<@CfgForward>
      cf.cond_br %cond, ^loop(%cond, %self : i1, !struct.type<@CfgForward>), ^loop(%cond, %self : i1, !struct.type<@CfgForward>)
    ^loop(%flag: i1, %forwarded: !struct.type<@CfgForward>):
      cf.cond_br %flag, ^loop(%flag, %forwarded : i1, !struct.type<@CfgForward>), ^exit
    ^exit:
      cf.cond_br %cond, ^left, ^right
    ^left:
      function.return %forwarded : !struct.type<@CfgForward>
    ^right:
      function.return %forwarded : !struct.type<@CfgForward>
    }
    function.def @constrain(%self: !struct.type<@CfgForward>, %cond: i1, %a: !felt.type) {
      %square = felt.mul %a, %a : !felt.type, !felt.type
      %cube = felt.mul %square, %a : !felt.type, !felt.type
      constrain.eq %cube, %a : !felt.type
      function.return
    }
  }

  // Region entry arguments, loop backedges, zero-trip inputs, and region results
  // all participate in the same forwarding proof.
  struct.def @LoopForward {
    function.def @compute(%cond: i1, %a: !felt.type) -> !struct.type<@LoopForward> {
      %self = struct.new : !struct.type<@LoopForward>
      %c0 = arith.constant 0 : index
      %c1 = arith.constant 1 : index
      %for = scf.for %i = %c0 to %c1 step %c1 iter_args(%iter = %self) -> (!struct.type<@LoopForward>) {
        scf.yield %iter : !struct.type<@LoopForward>
      }
      %while = scf.while (%before = %for) : (!struct.type<@LoopForward>) -> !struct.type<@LoopForward> {
        scf.condition(%cond) %before : !struct.type<@LoopForward>
      } do {
      ^bb0(%after: !struct.type<@LoopForward>):
        scf.yield %after : !struct.type<@LoopForward>
      }
      %forwarded = scf.execute_region -> !struct.type<@LoopForward> {
        cf.br ^yield(%while : !struct.type<@LoopForward>)
      ^yield(%value: !struct.type<@LoopForward>):
        scf.yield %value : !struct.type<@LoopForward>
      }
      function.return %forwarded : !struct.type<@LoopForward>
    }
    function.def @constrain(%self: !struct.type<@LoopForward>, %cond: i1, %a: !felt.type) {
      %square = felt.mul %a, %a : !felt.type, !felt.type
      %cube = felt.mul %square, %a : !felt.type, !felt.type
      constrain.eq %cube, %a : !felt.type
      function.return
    }
  }

  // Uniqueness is per return, not per function.
  struct.def @SeparateReturns {
    function.def @compute(%cond: i1, %a: !felt.type) -> !struct.type<@SeparateReturns> {
      cf.cond_br %cond, ^left, ^right
    ^left:
      %left = struct.new : !struct.type<@SeparateReturns>
      function.return %left : !struct.type<@SeparateReturns>
    ^right:
      %right = struct.new : !struct.type<@SeparateReturns>
      function.return %right : !struct.type<@SeparateReturns>
    }
    function.def @constrain(%self: !struct.type<@SeparateReturns>, %cond: i1, %a: !felt.type) {
      %square = felt.mul %a, %a : !felt.type, !felt.type
      %cube = felt.mul %square, %a : !felt.type, !felt.type
      constrain.eq %cube, %a : !felt.type
      function.return
    }
  }
}

