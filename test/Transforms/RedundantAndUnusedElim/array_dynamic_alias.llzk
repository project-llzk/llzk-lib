module attributes {llzk.lang} {
  // An exclusive arm must not erase the pre-region write observed by the
  // sibling arm's surviving dynamic read.
  function.def @sibling_region_dynamic_read(%idx: index, %cond: i1) -> !felt.type {
    %zero = felt.const 0
    %one = felt.const 1
    %two = felt.const 2
    %arr = array.new %zero, %zero : !array.type<2 x !felt.type>
    %i0 = arith.constant 0 : index
    array.write %arr[%i0] = %one : !array.type<2 x !felt.type>, !felt.type
    %result = scf.if %cond -> !felt.type {
      array.write %arr[%i0] = %two : !array.type<2 x !felt.type>, !felt.type
      scf.yield %two : !felt.type
    } else {
      %observed = array.read %arr[%idx] : !array.type<2 x !felt.type>, !felt.type
      scf.yield %observed : !felt.type
    }
    function.return %result : !felt.type
  }
}

