module attributes {llzk.lang} {
  // A dynamic suffix can observe a write below a constant prefix, so the later
  // overwrite must not erase the earlier write.
  function.def @mixed_constant_prefix_dynamic_suffix(%idx: index) -> !felt.type {
    %one = felt.const 1
    %two = felt.const 2
    %arr = array.new : !array.type<2,2 x !felt.type>
    %i0 = arith.constant 0 : index
    array.write %arr[%i0, %i0] = %one :
        !array.type<2,2 x !felt.type>, !felt.type
    %observed = array.read %arr[%i0, %idx] :
        !array.type<2,2 x !felt.type>, !felt.type
    array.write %arr[%i0, %i0] = %two :
        !array.type<2,2 x !felt.type>, !felt.type
    function.return %observed : !felt.type
  }

  // A dynamic extract may observe writes in the selected aggregate subtree, so
  // the later overwrite must not erase the earlier write.
  function.def @dynamic_extract_preserves_subtree_write(%idx: index) -> !felt.type {
    %one = felt.const 1
    %two = felt.const 2
    %matrix = array.new : !array.type<2,2 x !felt.type>
    %i0 = arith.constant 0 : index
    array.write %matrix[%i0, %i0] = %one :
        !array.type<2,2 x !felt.type>, !felt.type
    %row = array.extract %matrix[%idx] : !array.type<2,2 x !felt.type>
    array.write %matrix[%i0, %i0] = %two :
        !array.type<2,2 x !felt.type>, !felt.type
    %observed = array.read %row[%i0] :
        !array.type<2 x !felt.type>, !felt.type
    function.return %observed : !felt.type
  }
}

