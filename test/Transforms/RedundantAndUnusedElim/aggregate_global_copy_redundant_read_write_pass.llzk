// -----

// Verify globals deep-copy POD values on reads and writes.
module attributes {llzk.lang} {
  global.def @pod : !pod.type<[@value: index]>

  function.def @pod_source_copy(%one: index, %two: index) -> index
      attributes {function.allow_witness} {
    %pod = pod.new { @value = %one } : !pod.type<[@value: index]>
    global.write @pod = %pod : !pod.type<[@value: index]>
    pod.write %pod[@value] = %two : !pod.type<[@value: index]>, index
    %loaded = global.read @pod : !pod.type<[@value: index]>
    %value = pod.read %loaded[@value] : !pod.type<[@value: index]>, index
    function.return %value : index
  }

  function.def @pod_read_copy(%one: index, %two: index) -> (index, index)
      attributes {function.allow_witness} {
    %pod = pod.new { @value = %one } : !pod.type<[@value: index]>
    global.write @pod = %pod : !pod.type<[@value: index]>
    %loaded = global.read @pod : !pod.type<[@value: index]>
    pod.write %loaded[@value] = %two : !pod.type<[@value: index]>, index
    %source = pod.read %pod[@value] : !pod.type<[@value: index]>, index
    %again = global.read @pod : !pod.type<[@value: index]>
    %stored = pod.read %again[@value] : !pod.type<[@value: index]>, index
    function.return %source, %stored : index, index
  }
}
