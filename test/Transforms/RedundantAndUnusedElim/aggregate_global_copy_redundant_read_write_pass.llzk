// Verify struct member writes copy an aggregate source after it is mutated.
module attributes {llzk.lang} {
  struct.def @Box {
    struct.member @value : !array.type<1 x index>
    struct.member @result : index

    function.def @compute(%one: index, %two: index) -> !struct.type<@Box>
        attributes {function.allow_witness} {
      %self = struct.new : !struct.type<@Box>
      %source = array.new %one : !array.type<1 x index>
      %index = arith.constant 0 : index
      struct.writem %self[@value] = %source : !struct.type<@Box>, !array.type<1 x index>
      array.write %source[%index] = %two : !array.type<1 x index>, index
      struct.writem %self[@value] = %source : !struct.type<@Box>, !array.type<1 x index>
      %stored = struct.readm %self[@value] : !struct.type<@Box>, !array.type<1 x index>
      %value = array.read %stored[%index] : !array.type<1 x index>, index
      struct.writem %self[@result] = %value : !struct.type<@Box>, index
      function.return %self : !struct.type<@Box>
    }

    function.def @constrain(%self: !struct.type<@Box>, %one: index, %two: index) {
      function.return
    }
  }
}
