// CHECK-NEXT:    function.def @pod_source_copy(%[[VAL_0:[0-9a-zA-Z_\.]+]]: index, %[[VAL_1:[0-9a-zA-Z_\.]+]]: index) -> index attributes {function.allow_witness} {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = pod.new { @value = %[[VAL_0]] }  : <[@value: index]>
// CHECK-NEXT:      global.write @pod = %[[VAL_2]] : !pod.type<[@value: index]>
