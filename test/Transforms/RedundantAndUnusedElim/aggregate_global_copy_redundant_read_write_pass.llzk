// CHECK-NEXT:      global.write @array = %[[VAL_14]] : !array.type<1 x index>
// CHECK-NEXT:      %[[VAL_15:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:      function.return %[[VAL_13]] : index
