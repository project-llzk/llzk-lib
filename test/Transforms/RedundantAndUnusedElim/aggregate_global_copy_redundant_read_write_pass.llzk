// CHECK-NEXT:        %[[VAL_9:[0-9a-zA-Z_\.]+]] = pod.new : <[@value: !struct.type<@Payload>]>
// CHECK-NEXT:        pod.write %[[VAL_9]][@value] = %[[VAL_7]] : <[@value: !struct.type<@Payload>]>, !struct.type<@Payload>
// CHECK-NEXT:        %[[VAL_10:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_7]][@field] : <@Payload>, index
// CHECK-NEXT:        struct.writem %[[VAL_8]][@result] = %[[VAL_10]] : <@PodForward>, index
// CHECK-NEXT:        function.return %[[VAL_8]] : !struct.type<@PodForward>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_11:[0-9a-zA-Z_\.]+]]: !struct.type<@PodForward>, %[[VAL_12:[0-9a-zA-Z_\.]+]]: !struct.type<@Payload>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    struct.def @InterveningSourceMutation {
// CHECK-NEXT:      struct.member @value : !pod.type<[@field: index]>
// CHECK-NEXT:      struct.member @result : index
// CHECK-NEXT:      function.def @compute(%[[MUT_ONE:[0-9a-zA-Z_\.]+]]: index, %[[MUT_TWO:[0-9a-zA-Z_\.]+]]: index) -> !struct.type<@InterveningSourceMutation> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[MUT_SELF:[0-9a-zA-Z_\.]+]] = struct.new : <@InterveningSourceMutation>
// CHECK-NEXT:        %[[MUT_SOURCE:[0-9a-zA-Z_\.]+]] = pod.new { @field = %[[MUT_ONE]] }  : <[@field: index]>
// CHECK-NEXT:        struct.writem %[[MUT_SELF]][@value] = %[[MUT_SOURCE]] : <@InterveningSourceMutation>, !pod.type<[@field: index]>
// CHECK-NEXT:        pod.write %[[MUT_SOURCE]][@field] = %[[MUT_TWO]] : <[@field: index]>, index
// CHECK-NEXT:        function.return %[[MUT_SELF]] : !struct.type<@InterveningSourceMutation>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[MUT_CONSTRAINT_SELF:[0-9a-zA-Z_\.]+]]: !struct.type<@InterveningSourceMutation>, %[[MUT_CONSTRAINT_ONE:[0-9a-zA-Z_\.]+]]: index, %[[MUT_CONSTRAINT_TWO:[0-9a-zA-Z_\.]+]]: index) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    function.def @global_forward(%[[VAL_13:[0-9a-zA-Z_\.]+]]: index) -> index attributes {function.allow_witness} {
