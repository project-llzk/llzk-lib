// Verify a mutation through one aggregate read result prevents reuse of another read result.
module attributes {llzk.lang} {
  struct.def @ReadCopy {
    struct.member @array : !array.type<1 x index>
    struct.member @result : index

    function.def @compute(%value: index) -> !struct.type<@ReadCopy>
        attributes {function.allow_witness} {
      %self = struct.new : !struct.type<@ReadCopy>
      %first = struct.readm %self[@array] : !struct.type<@ReadCopy>, !array.type<1 x index>
      %index = arith.constant 0 : index
      array.write %first[%index] = %value : !array.type<1 x index>, index
      %second = struct.readm %self[@array] : !struct.type<@ReadCopy>, !array.type<1 x index>
      %result = array.read %second[%index] : !array.type<1 x index>, index
      struct.writem %self[@result] = %result : !struct.type<@ReadCopy>, index
      function.return %self : !struct.type<@ReadCopy>
    }

    function.def @constrain(%self: !struct.type<@ReadCopy>, %value: index) {
      function.return
    }
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    struct.def @ReadCopy {
// CHECK-NEXT:      struct.member @array : !array.type<1 x index>
// CHECK-NEXT:      struct.member @result : index
// CHECK-NEXT:      function.def @compute(%[[VAL_0:[0-9a-zA-Z_\.]+]]: index) -> !struct.type<@ReadCopy> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_1:[0-9a-zA-Z_\.]+]] = struct.new : <@ReadCopy>
// CHECK-NEXT:        %[[VAL_2:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_1]][@array] : <@ReadCopy>, !array.type<1 x index>
// CHECK-NEXT:        %[[VAL_3:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:        array.write %[[VAL_2]]{{\[}}%[[VAL_3]]] = %[[VAL_0]] : <1 x index>, index
// CHECK-NEXT:        %[[VAL_4:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_1]][@array] : <@ReadCopy>, !array.type<1 x index>
// CHECK-NEXT:        %[[VAL_5:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_4]]{{\[}}%[[VAL_3]]] : <1 x index>, index
// CHECK-NEXT:        struct.writem %[[VAL_1]][@result] = %[[VAL_5]] : <@ReadCopy>, index
// CHECK-NEXT:        function.return %[[VAL_1]] : !struct.type<@ReadCopy>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_6:[0-9a-zA-Z_\.]+]]: !struct.type<@ReadCopy>, %[[VAL_7:[0-9a-zA-Z_\.]+]]: index) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

// Verify array.insert copies the source again after that source is mutated.
module attributes {llzk.lang} {
  function.def @array_insert_rewrite_after_mutation(%one: index, %two: index) -> index
      attributes {function.allow_witness} {
    %source = array.new %one : !array.type<1 x index>
    %target = array.new : !array.type<1,1 x index>
    %index = arith.constant 0 : index
    array.insert %target[%index] = %source : !array.type<1,1 x index>, !array.type<1 x index>
    array.write %source[%index] = %two : !array.type<1 x index>, index
    array.insert %target[%index] = %source : !array.type<1,1 x index>, !array.type<1 x index>
    %stored = array.extract %target[%index] : !array.type<1,1 x index>
    %value = array.read %stored[%index] : !array.type<1 x index>, index
    function.return %value : index
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @array_insert_rewrite_after_mutation(%[[VAL_0:[0-9a-zA-Z_\.]+]]: index, %[[VAL_1:[0-9a-zA-Z_\.]+]]: index) -> index attributes {function.allow_witness} {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = array.new %[[VAL_0]] : <1 x index>
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = array.new  : <1,1 x index>
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:      array.write %[[VAL_2]]{{\[}}%[[VAL_4]]] = %[[VAL_1]] : <1 x index>, index
// CHECK-NEXT:      array.insert %[[VAL_3]]{{\[}}%[[VAL_4]]] = %[[VAL_2]] : <1,1 x index>, <1 x index>
// CHECK-NEXT:      function.return %[[VAL_1]] : index
// CHECK-NEXT:    }
// CHECK-NEXT:  }

