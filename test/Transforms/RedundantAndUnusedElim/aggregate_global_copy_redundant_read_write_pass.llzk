// RUN: llzk-opt -split-input-file -llzk-duplicate-read-write-elim %s | FileCheck --enable-var-scope %s

// Verify global array writes and reads preserve independent copied state.
module attributes {llzk.lang} {
  global.def @array : !array.type<1 x index>

  function.def @array_source_copy(%one: index, %two: index) -> index
      attributes {function.allow_witness} {
    %array = array.new %one : !array.type<1 x index>
    global.write @array = %array : !array.type<1 x index>
    %index = arith.constant 0 : index
    array.write %array[%index] = %two : !array.type<1 x index>, index
    %loaded = global.read @array : !array.type<1 x index>
    %value = array.read %loaded[%index] : !array.type<1 x index>, index
    function.return %value : index
  }

  function.def @array_read_copy(%one: index, %two: index) -> (index, index)
      attributes {function.allow_witness} {
    %array = array.new %one : !array.type<1 x index>
    global.write @array = %array : !array.type<1 x index>
    %index = arith.constant 0 : index
    %loaded = global.read @array : !array.type<1 x index>
    array.write %loaded[%index] = %two : !array.type<1 x index>, index
    %source = array.read %array[%index] : !array.type<1 x index>, index
    %again = global.read @array : !array.type<1 x index>
    %stored = array.read %again[%index] : !array.type<1 x index>, index
    function.return %source, %stored : index, index
  }

  function.def @array_rewrite_after_mutation(%one: index, %two: index)
      attributes {function.allow_witness} {
    %array = array.new %one : !array.type<1 x index>
    global.write @array = %array : !array.type<1 x index>
    %index = arith.constant 0 : index
    array.write %array[%index] = %two : !array.type<1 x index>, index
    global.write @array = %array : !array.type<1 x index>
    function.return
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    global.def @array : !array.type<1 x index>
// CHECK-NEXT:    function.def @array_source_copy(%[[VAL_0:[0-9a-zA-Z_\.]+]]: index, %[[VAL_1:[0-9a-zA-Z_\.]+]]: index) -> index attributes {function.allow_witness} {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = array.new %[[VAL_0]] : <1 x index>
// CHECK-NEXT:      global.write @array = %[[VAL_2]] : !array.type<1 x index>
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:      array.write %[[VAL_2]]{{\[}}%[[VAL_3]]] = %[[VAL_1]] : <1 x index>, index
// CHECK-NEXT:      function.return %[[VAL_0]] : index
// CHECK-NEXT:    }
// CHECK-NEXT:    function.def @array_read_copy(%[[VAL_4:[0-9a-zA-Z_\.]+]]: index, %[[VAL_5:[0-9a-zA-Z_\.]+]]: index) -> (index, index) attributes {function.allow_witness} {
// CHECK-NEXT:      %[[VAL_6:[0-9a-zA-Z_\.]+]] = array.new %[[VAL_4]] : <1 x index>
// CHECK-NEXT:      global.write @array = %[[VAL_6]] : !array.type<1 x index>
// CHECK-NEXT:      %[[VAL_7:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:      %[[VAL_8:[0-9a-zA-Z_\.]+]] = global.read @array : !array.type<1 x index>
// CHECK-NEXT:      array.write %[[VAL_8]]{{\[}}%[[VAL_7]]] = %[[VAL_5]] : <1 x index>, index
// CHECK-NEXT:      function.return %[[VAL_4]], %[[VAL_4]] : index, index
// CHECK-NEXT:    }
// CHECK-NEXT:    function.def @array_rewrite_after_mutation(%[[VAL_9:[0-9a-zA-Z_\.]+]]: index, %[[VAL_10:[0-9a-zA-Z_\.]+]]: index) attributes {function.allow_witness} {
// CHECK-NEXT:      %[[VAL_11:[0-9a-zA-Z_\.]+]] = array.new %[[VAL_9]] : <1 x index>
// CHECK-NEXT:      %[[VAL_12:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:      array.write %[[VAL_11]]{{\[}}%[[VAL_12]]] = %[[VAL_10]] : <1 x index>, index
// CHECK-NEXT:      global.write @array = %[[VAL_11]] : !array.type<1 x index>
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

// Verify immutable aggregate snapshots can be forwarded through struct, POD, and global reads.
module attributes {llzk.lang} {
  global.def @array : !array.type<1 x index>

  struct.def @StructForward {
    struct.member @value : !pod.type<[@field: index]>
    struct.member @result : index

    function.def @compute(%input: index) -> !struct.type<@StructForward>
        attributes {function.allow_witness} {
      %self = struct.new : !struct.type<@StructForward>
      %source = pod.new : !pod.type<[@field: index]>
      pod.write %source[@field] = %input : !pod.type<[@field: index]>, index
      struct.writem %self[@value] = %source : !struct.type<@StructForward>, !pod.type<[@field: index]>
      %loaded = struct.readm %self[@value] : !struct.type<@StructForward>, !pod.type<[@field: index]>
      %field = pod.read %loaded[@field] : !pod.type<[@field: index]>, index
      struct.writem %self[@result] = %field : !struct.type<@StructForward>, index
      function.return %self : !struct.type<@StructForward>
    }

    function.def @constrain(%self: !struct.type<@StructForward>, %input: index) {
      function.return
    }
  }

  struct.def @Payload {
    struct.member @field : index {llzk.pub}
    function.def @compute() -> !struct.type<@Payload> {
      %self = struct.new : !struct.type<@Payload>
      function.return %self : !struct.type<@Payload>
    }
    function.def @constrain(%self: !struct.type<@Payload>) { function.return }
  }

  struct.def @PodForward {
    struct.member @result : index

    function.def @compute(%source: !struct.type<@Payload>) -> !struct.type<@PodForward>
        attributes {function.allow_witness} {
      %self = struct.new : !struct.type<@PodForward>
      %pod = pod.new : !pod.type<[@value: !struct.type<@Payload>]>
      pod.write %pod[@value] = %source : !pod.type<[@value: !struct.type<@Payload>]>, !struct.type<@Payload>
      %loaded = pod.read %pod[@value] : !pod.type<[@value: !struct.type<@Payload>]>, !struct.type<@Payload>
      %field = struct.readm %loaded[@field] : !struct.type<@Payload>, index
      struct.writem %self[@result] = %field : !struct.type<@PodForward>, index
      function.return %self : !struct.type<@PodForward>
    }

    function.def @constrain(%self: !struct.type<@PodForward>, %source: !struct.type<@Payload>) {
      function.return
    }
  }

  struct.def @InterveningSourceMutation {
    struct.member @value : !pod.type<[@field: index]>
    struct.member @result : index

    function.def @compute(%one: index, %two: index) -> !struct.type<@InterveningSourceMutation>
        attributes {function.allow_witness} {
      %self = struct.new : !struct.type<@InterveningSourceMutation>
      %source = pod.new { @field = %one } : !pod.type<[@field: index]>
      struct.writem %self[@value] = %source : !struct.type<@InterveningSourceMutation>, !pod.type<[@field: index]>
      pod.write %source[@field] = %two : !pod.type<[@field: index]>, index
      %loaded = struct.readm %self[@value] : !struct.type<@InterveningSourceMutation>, !pod.type<[@field: index]>
      struct.writem %self[@value] = %loaded : !struct.type<@InterveningSourceMutation>, !pod.type<[@field: index]>
      function.return %self : !struct.type<@InterveningSourceMutation>
    }

    function.def @constrain(%self: !struct.type<@InterveningSourceMutation>, %one: index, %two: index) {
      function.return
    }
  }

  function.def @global_forward(%input: index) -> index attributes {function.allow_witness} {
    %source = array.new %input : !array.type<1 x index>
    global.write @array = %source : !array.type<1 x index>
    %loaded = global.read @array : !array.type<1 x index>
    %index = arith.constant 0 : index
    %field = array.read %loaded[%index] : !array.type<1 x index>, index
    function.return %field : index
  }
}
