// -----

// Verify POD record writes copy an aggregate source after it is mutated.
module attributes {llzk.lang} {
  function.def @pod_write_rewrite_after_mutation(%one: index, %two: index) -> index
      attributes {function.allow_witness} {
    %source = array.new %one : !array.type<1 x index>
    %pod = pod.new { @value = %source } : !pod.type<[@value: !array.type<1 x index>]>
    %index = arith.constant 0 : index
    array.write %source[%index] = %two : !array.type<1 x index>, index
    pod.write %pod[@value] = %source : !pod.type<[@value: !array.type<1 x index>]>, !array.type<1 x index>
    %stored = pod.read %pod[@value] : !pod.type<[@value: !array.type<1 x index>]>, !array.type<1 x index>
    %value = array.read %stored[%index] : !array.type<1 x index>, index
    function.return %value : index
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @pod_write_rewrite_after_mutation(%[[VAL_0:[0-9a-zA-Z_\.]+]]: index, %[[VAL_1:[0-9a-zA-Z_\.]+]]: index) -> index attributes {function.allow_witness} {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = array.new %[[VAL_0]] : <1 x index>
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = pod.new { @value = %[[VAL_2]] }  : <[@value: !array.type<1 x index>]>
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:      array.write %[[VAL_2]]{{\[}}%[[VAL_4]]] = %[[VAL_1]] : <1 x index>, index
// CHECK-NEXT:      pod.write %[[VAL_3]][@value] = %[[VAL_2]] : <[@value: !array.type<1 x index>]>, !array.type<1 x index>
// CHECK-NEXT:      function.return %[[VAL_1]] : index
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

// Verify globals deep-copy structs and their nested array members on reads and writes.
module attributes {llzk.lang} {
  global.def @source_box : !struct.type<@SourceBox>
  global.def @read_box : !struct.type<@ReadBox>

  struct.def @SourceBox {
    struct.member @array : !array.type<1 x index>
    struct.member @result : index

    function.def @compute(%one: index, %two: index) -> !struct.type<@SourceBox>
        attributes {function.allow_witness} {
      %self = struct.new : !struct.type<@SourceBox>
      %array = array.new %one : !array.type<1 x index>
      struct.writem %self[@array] = %array : !struct.type<@SourceBox>, !array.type<1 x index>
      global.write @source_box = %self : !struct.type<@SourceBox>
      %index = arith.constant 0 : index
      array.write %array[%index] = %two : !array.type<1 x index>, index
      %loaded = global.read @source_box : !struct.type<@SourceBox>
      %loaded_array = struct.readm %loaded[@array] : !struct.type<@SourceBox>, !array.type<1 x index>
      %value = array.read %loaded_array[%index] : !array.type<1 x index>, index
      struct.writem %self[@result] = %value : !struct.type<@SourceBox>, index
      function.return %self : !struct.type<@SourceBox>
    }

    function.def @constrain(%self: !struct.type<@SourceBox>, %one: index, %two: index) {
      function.return
    }
  }

  struct.def @ReadBox {
    struct.member @value : index
    struct.member @source_result : index
    struct.member @stored_result : index

    function.def @compute(%one: index, %two: index) -> !struct.type<@ReadBox>
        attributes {function.allow_witness} {
      %self = struct.new : !struct.type<@ReadBox>
      struct.writem %self[@value] = %one : !struct.type<@ReadBox>, index
      global.write @read_box = %self : !struct.type<@ReadBox>
      %loaded = global.read @read_box : !struct.type<@ReadBox>
      struct.writem %loaded[@value] = %two : !struct.type<@ReadBox>, index
      %source = struct.readm %self[@value] : !struct.type<@ReadBox>, index
      %again = global.read @read_box : !struct.type<@ReadBox>
      %stored = struct.readm %again[@value] : !struct.type<@ReadBox>, index
      struct.writem %self[@source_result] = %source : !struct.type<@ReadBox>, index
      struct.writem %self[@stored_result] = %stored : !struct.type<@ReadBox>, index
      function.return %self : !struct.type<@ReadBox>
    }

    function.def @constrain(%self: !struct.type<@ReadBox>, %one: index, %two: index) {
      function.return
    }
  }
}
