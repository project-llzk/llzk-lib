// CHECK-NEXT:    global.def @array : !array.type<1 x index>
// CHECK-NEXT:    struct.def @StructForward {
// CHECK-NEXT:      struct.member @value : !pod.type<[@field: index]>
// CHECK-NEXT:      struct.member @result : index
// CHECK-NEXT:      function.def @compute(%[[VAL_0:[0-9a-zA-Z_\.]+]]: index) -> !struct.type<@StructForward> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_1:[0-9a-zA-Z_\.]+]] = struct.new : <@StructForward>
// CHECK-NEXT:        %[[VAL_2:[0-9a-zA-Z_\.]+]] = pod.new : <[@field: index]>
// CHECK-NEXT:        pod.write %[[VAL_2]][@field] = %[[VAL_0]] : <[@field: index]>, index
// CHECK-NEXT:        struct.writem %[[VAL_1]][@value] = %[[VAL_2]] : <@StructForward>, !pod.type<[@field: index]>
// CHECK-NEXT:        struct.writem %[[VAL_1]][@result] = %[[VAL_0]] : <@StructForward>, index
