module attributes {llzk.lang} {
  // A distinct dynamic read may equal the dynamic alias index at runtime.
  function.def @distinct_dynamic_read_observes_dynamic_aggregate_alias(
      %insert_idx: index, %read_idx: index
  ) -> !felt.type {
    %one = felt.const 1
    %two = felt.const 2
    %row = array.new : !array.type<2 x !felt.type>
    %matrix = array.new : !array.type<2,2 x !felt.type>
    %i0 = arith.constant 0 : index
    array.write %row[%i0] = %one : !array.type<2 x !felt.type>, !felt.type
    array.insert %matrix[%insert_idx] = %row :
        !array.type<2,2 x !felt.type>, !array.type<2 x !felt.type>
    %observed = array.read %matrix[%read_idx, %i0] :
        !array.type<2,2 x !felt.type>, !felt.type
    array.write %row[%i0] = %two : !array.type<2 x !felt.type>, !felt.type
    function.return %observed : !felt.type
  }
}
