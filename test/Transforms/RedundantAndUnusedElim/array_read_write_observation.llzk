module attributes {llzk.lang} {
  struct.def @Element {
    struct.member @value : !felt.type
    struct.member @result : !felt.type
    // array.read can return an aggregate, so the selected member subtree is live.
    function.def @compute(%idx: index) -> !struct.type<@Element> {
      %self = struct.new : !struct.type<@Element>
      %one = felt.const 1
      %two = felt.const 2
      struct.writem %self[@value] = %one : !struct.type<@Element>, !felt.type
      %arr = array.new %self, %self : !array.type<2 x !struct.type<@Element>>
      %selected = array.read %arr[%idx] :
          !array.type<2 x !struct.type<@Element>>, !struct.type<@Element>
      %observed = struct.readm %selected[@value] :
          !struct.type<@Element>, !felt.type
      struct.writem %self[@value] = %two : !struct.type<@Element>, !felt.type
      struct.writem %self[@result] = %observed : !struct.type<@Element>, !felt.type
      function.return %self : !struct.type<@Element>
    }
    function.def @constrain(%self: !struct.type<@Element>, %idx: index) { function.return }
  }
}
