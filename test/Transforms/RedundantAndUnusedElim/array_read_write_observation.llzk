// -----
module attributes {llzk.lang} {
  // A live read through an untracked region result may still alias the source array.
  function.def @scf_result_array_alias_preserves_prior_write(
      %idx: index, %cond: i1
  ) -> !felt.type {
    %zero = felt.const 0
    %one = felt.const 1
    %two = felt.const 2
    %arr = array.new %zero, %zero : !array.type<2 x !felt.type>
    %alias = scf.if %cond -> (!array.type<2 x !felt.type>) {
      scf.yield %arr : !array.type<2 x !felt.type>
    } else {
      scf.yield %arr : !array.type<2 x !felt.type>
    }
    %i0 = arith.constant 0 : index
    array.write %arr[%i0] = %one : !array.type<2 x !felt.type>, !felt.type
    %observed = array.read %alias[%idx] : !array.type<2 x !felt.type>, !felt.type
    array.write %arr[%i0] = %two : !array.type<2 x !felt.type>, !felt.type
    function.return %observed : !felt.type
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @scf_result_array_alias_preserves_prior_write(%[[VAL_0:[0-9a-zA-Z_\.]+]]: index, %[[VAL_1:[0-9a-zA-Z_\.]+]]: i1) -> !felt.type {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = felt.const  0
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = felt.const  1
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = felt.const  2
// CHECK-NEXT:      %[[VAL_5:[0-9a-zA-Z_\.]+]] = array.new %[[VAL_2]], %[[VAL_2]] : <2 x !felt.type>
// CHECK-NEXT:      %[[VAL_6:[0-9a-zA-Z_\.]+]] = scf.if %[[VAL_1]] -> (!array.type<2 x !felt.type>) {
// CHECK-NEXT:        scf.yield %[[VAL_5]] : !array.type<2 x !felt.type>
// CHECK-NEXT:      } else {
// CHECK-NEXT:        scf.yield %[[VAL_5]] : !array.type<2 x !felt.type>
