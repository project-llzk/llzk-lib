module attributes {llzk.lang} {
  // A write in one branch cannot delete a pre-branch write observed by the
  // opposite branch.
  function.def @opposite_branch_read_preserves_prior_write(
      %idx: index, %cond: i1
  ) -> !felt.type {
    %zero = felt.const 0
    %one = felt.const 1
    %two = felt.const 2
    %arr = array.new %zero, %zero : !array.type<2 x !felt.type>
    %i0 = arith.constant 0 : index
    array.write %arr[%i0] = %one : !array.type<2 x !felt.type>, !felt.type
    %observed = scf.if %cond -> !felt.type {
      array.write %arr[%i0] = %two : !array.type<2 x !felt.type>, !felt.type
      scf.yield %two : !felt.type
    } else {
      %branch_observed = array.read %arr[%idx] :
          !array.type<2 x !felt.type>, !felt.type
      scf.yield %branch_observed : !felt.type
    }
    function.return %observed : !felt.type
  }
}
