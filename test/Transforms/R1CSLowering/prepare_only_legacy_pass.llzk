// RUN: llzk-opt %s --llzk-r1cs-prepare -o %t
// RUN: llzk-opt %t --llzk-r1cs-lowering | FileCheck %s
module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  struct.def @Main {
    function.def @compute(%x: !felt.type, %y: !felt.type) -> !struct.type<@Main> {
      %s = struct.new : <@Main>
      function.return %s : !struct.type<@Main>
    }
    function.def @constrain(%s: !struct.type<@Main>, %x: !felt.type, %y: !felt.type) {
      %a = felt.mul %x, %x : !felt.type, !felt.type
      %b = felt.mul %y, %y : !felt.type, !felt.type
      constrain.eq %a, %b : !felt.type
      function.return
    }
  }
}

