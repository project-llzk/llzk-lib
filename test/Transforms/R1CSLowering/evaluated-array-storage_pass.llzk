// CHECK-LABEL: module attributes {llzk.lang, llzk.main = !struct.type<@__llzk_spec_0>, poly.evaluated_main = @__llzk_spec_0, r1cs.main = @__llzk_spec_0__r1cs} {
// CHECK-NEXT:    r1cs.circuit @__llzk_spec_0__r1cs inputs (%[[VAL_0:[0-9a-zA-Z_\.]+]]: !r1cs.signal {pub = #r1cs.pub}, %[[VAL_1:[0-9a-zA-Z_\.]+]]: !r1cs.signal {pub = #r1cs.pub}) attributes {poly.wire_bindings = [{path = [0, "out"], public = true, wire = 1 : i64}, {path = [1, 0 : index], public = true, wire = 2 : i64}, {path = [1, 1 : index], public = true, wire = 3 : i64}, {path = [0, "children", 0 : index, "out"], public = false, wire = 4 : i64}, {path = [0, "children", 1 : index, "out"], public = false, wire = 5 : i64}]} {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = r1cs.def 1 : !r1cs.signal {pub = #r1cs.pub}
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = r1cs.def 2 : !r1cs.signal
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = r1cs.def 3 : !r1cs.signal
// CHECK-NEXT:      %[[VAL_5:[0-9a-zA-Z_\.]+]] = r1cs.to_linear %[[VAL_0]] : !r1cs.signal to !r1cs.linear
// CHECK-NEXT:      %[[VAL_6:[0-9a-zA-Z_\.]+]] = r1cs.to_linear %[[VAL_3]] : !r1cs.signal to !r1cs.linear
// CHECK-NEXT:      r1cs.constrain %[[VAL_5]], %[[VAL_5]], %[[VAL_6]] : !r1cs.linear
// CHECK-NEXT:      %[[VAL_7:[0-9a-zA-Z_\.]+]] = r1cs.to_linear %[[VAL_1]] : !r1cs.signal to !r1cs.linear
// CHECK-NEXT:      %[[VAL_8:[0-9a-zA-Z_\.]+]] = r1cs.to_linear %[[VAL_4]] : !r1cs.signal to !r1cs.linear
// CHECK-NEXT:      r1cs.constrain %[[VAL_7]], %[[VAL_7]], %[[VAL_8]] : !r1cs.linear
// CHECK-NEXT:      %[[VAL_9:[0-9a-zA-Z_\.]+]] = r1cs.to_linear %[[VAL_2]] : !r1cs.signal to !r1cs.linear
// CHECK-NEXT:      r1cs.constrain %[[VAL_6]], %[[VAL_8]], %[[VAL_9]] : !r1cs.linear
// CHECK-NEXT:    }
