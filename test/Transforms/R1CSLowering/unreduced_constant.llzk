// RUN: llzk-opt --llzk-r1cs-lowering %s | FileCheck %s

// Without prior canonicalization, lowering reduces BabyBear literals 2013265928
// and -1 to 7 and 2013265920, while fieldless literals retain their signed raw
// values as R1CS coefficients. Check all four emitted constraints; reduction of
// raw coefficients modulo the export prime occurs later, during binary export.
module attributes {llzk.lang, llzk.main = !struct.type<@ReducedConstant>} {
  struct.def @ReducedConstant {
    struct.member @out : !felt.type<"babybear"> {llzk.pub}
    struct.member @negative : !felt.type<"babybear"> {llzk.pub}
    struct.member @fieldless : !felt.type {llzk.pub}
    struct.member @fieldless_negative : !felt.type {llzk.pub}
    function.def @compute() -> !struct.type<@ReducedConstant> {
      %self = struct.new : !struct.type<@ReducedConstant>
      %out = felt.const 2013265928 : !felt.type<"babybear">
      struct.writem %self[@out] = %out : !struct.type<@ReducedConstant>, !felt.type<"babybear">
      %negative = felt.const -1 : !felt.type<"babybear">
      struct.writem %self[@negative] = %negative : !struct.type<@ReducedConstant>, !felt.type<"babybear">
      %fieldless = felt.const 2013265928 : !felt.type
      struct.writem %self[@fieldless] = %fieldless : !struct.type<@ReducedConstant>, !felt.type
      %fieldless_negative = felt.const -1 : !felt.type
      struct.writem %self[@fieldless_negative] = %fieldless_negative : !struct.type<@ReducedConstant>, !felt.type
      function.return %self : !struct.type<@ReducedConstant>
    }
    function.def @constrain(%self: !struct.type<@ReducedConstant>) {
      %out = struct.readm %self[@out] : !struct.type<@ReducedConstant>, !felt.type<"babybear">
      %out_constant = felt.const 2013265928 : !felt.type<"babybear">
      constrain.eq %out, %out_constant : !felt.type<"babybear">
      %negative = struct.readm %self[@negative] : !struct.type<@ReducedConstant>, !felt.type<"babybear">
      %negative_constant = felt.const -1 : !felt.type<"babybear">
      constrain.eq %negative, %negative_constant : !felt.type<"babybear">
      %fieldless = struct.readm %self[@fieldless] : !struct.type<@ReducedConstant>, !felt.type
      %fieldless_constant = felt.const 2013265928 : !felt.type
      constrain.eq %fieldless, %fieldless_constant : !felt.type
      %fieldless_negative = struct.readm %self[@fieldless_negative] : !struct.type<@ReducedConstant>, !felt.type
      %fieldless_negative_constant = felt.const -1 : !felt.type
      constrain.eq %fieldless_negative, %fieldless_negative_constant : !felt.type
      function.return
    }
  }
}
// CHECK-LABEL: module attributes {llzk.lang = "r1cs"} {
// CHECK-NEXT:    r1cs.circuit @ReducedConstant {
// CHECK-NEXT:      %[[VAL_0:[0-9a-zA-Z_\.]+]] = r1cs.def 1 : !r1cs.signal {pub = #r1cs.pub}
// CHECK-NEXT:      %[[VAL_1:[0-9a-zA-Z_\.]+]] = r1cs.def 2 : !r1cs.signal {pub = #r1cs.pub}
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = r1cs.def 3 : !r1cs.signal {pub = #r1cs.pub}
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = r1cs.def 4 : !r1cs.signal {pub = #r1cs.pub}
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = r1cs.const 0 : !r1cs.linear
// CHECK-NEXT:      %[[VAL_5:[0-9a-zA-Z_\.]+]] = r1cs.const 0 : !r1cs.linear
// CHECK-NEXT:      %[[VAL_6:[0-9a-zA-Z_\.]+]] = r1cs.const 7 : !r1cs.linear
// CHECK-NEXT:      %[[VAL_7:[0-9a-zA-Z_\.]+]] = r1cs.to_linear %[[VAL_0]] : !r1cs.signal to !r1cs.linear
// CHECK-NEXT:      %[[VAL_8:[0-9a-zA-Z_\.]+]] = r1cs.mul_const %[[VAL_7]], -1 : !r1cs.linear
// CHECK-NEXT:      %[[VAL_9:[0-9a-zA-Z_\.]+]] = r1cs.add %[[VAL_6]], %[[VAL_8]] : !r1cs.linear
// CHECK-NEXT:      r1cs.constrain %[[VAL_4]], %[[VAL_5]], %[[VAL_9]] : !r1cs.linear
// CHECK-NEXT:      %[[VAL_10:[0-9a-zA-Z_\.]+]] = r1cs.const 0 : !r1cs.linear
// CHECK-NEXT:      %[[VAL_11:[0-9a-zA-Z_\.]+]] = r1cs.const 0 : !r1cs.linear
// CHECK-NEXT:      %[[VAL_12:[0-9a-zA-Z_\.]+]] = r1cs.const 2013265920 : !r1cs.linear
// CHECK-NEXT:      %[[VAL_13:[0-9a-zA-Z_\.]+]] = r1cs.to_linear %[[VAL_1]] : !r1cs.signal to !r1cs.linear
// CHECK-NEXT:      %[[VAL_14:[0-9a-zA-Z_\.]+]] = r1cs.mul_const %[[VAL_13]], -1 : !r1cs.linear
// CHECK-NEXT:      %[[VAL_15:[0-9a-zA-Z_\.]+]] = r1cs.add %[[VAL_12]], %[[VAL_14]] : !r1cs.linear
// CHECK-NEXT:      r1cs.constrain %[[VAL_10]], %[[VAL_11]], %[[VAL_15]] : !r1cs.linear
// CHECK-NEXT:      %[[VAL_16:[0-9a-zA-Z_\.]+]] = r1cs.const 0 : !r1cs.linear
// CHECK-NEXT:      %[[VAL_17:[0-9a-zA-Z_\.]+]] = r1cs.const 0 : !r1cs.linear
// CHECK-NEXT:      %[[VAL_18:[0-9a-zA-Z_\.]+]] = r1cs.const 2013265928 : !r1cs.linear
// CHECK-NEXT:      %[[VAL_19:[0-9a-zA-Z_\.]+]] = r1cs.to_linear %[[VAL_2]] : !r1cs.signal to !r1cs.linear
// CHECK-NEXT:      %[[VAL_20:[0-9a-zA-Z_\.]+]] = r1cs.mul_const %[[VAL_19]], -1 : !r1cs.linear
// CHECK-NEXT:      %[[VAL_21:[0-9a-zA-Z_\.]+]] = r1cs.add %[[VAL_18]], %[[VAL_20]] : !r1cs.linear
// CHECK-NEXT:      r1cs.constrain %[[VAL_16]], %[[VAL_17]], %[[VAL_21]] : !r1cs.linear
// CHECK-NEXT:      %[[VAL_22:[0-9a-zA-Z_\.]+]] = r1cs.const 0 : !r1cs.linear
// CHECK-NEXT:      %[[VAL_23:[0-9a-zA-Z_\.]+]] = r1cs.const 0 : !r1cs.linear
// CHECK-NEXT:      %[[VAL_24:[0-9a-zA-Z_\.]+]] = r1cs.const -1 : !r1cs.linear
// CHECK-NEXT:      %[[VAL_25:[0-9a-zA-Z_\.]+]] = r1cs.to_linear %[[VAL_3]] : !r1cs.signal to !r1cs.linear
// CHECK-NEXT:      %[[VAL_26:[0-9a-zA-Z_\.]+]] = r1cs.mul_const %[[VAL_25]], -1 : !r1cs.linear
// CHECK-NEXT:      %[[VAL_27:[0-9a-zA-Z_\.]+]] = r1cs.add %[[VAL_24]], %[[VAL_26]] : !r1cs.linear
// CHECK-NEXT:      r1cs.constrain %[[VAL_22]], %[[VAL_23]], %[[VAL_27]] : !r1cs.linear
// CHECK-NEXT:    }
// CHECK-NEXT:  }
