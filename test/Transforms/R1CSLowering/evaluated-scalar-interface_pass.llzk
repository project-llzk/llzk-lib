// RUN: llzk-opt %s --llzk-monomorphize --llzk-evaluate-constraints --llzk-full-r1cs-lowering | FileCheck %s
// Private input precedes public input in the signature; wire order remains public first.
module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  struct.def @Main {
    struct.member @out : !felt.type<"babybear"> {llzk.pub}
    function.def @compute(%secret: !felt.type<"babybear">, %visible: !felt.type<"babybear"> {llzk.pub}) -> !struct.type<@Main> {
      %self = struct.new : <@Main>
      %value = felt.mul %secret, %visible : !felt.type<"babybear">, !felt.type<"babybear">
      struct.writem %self[@out] = %value : !struct.type<@Main>, !felt.type<"babybear">
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>, %secret: !felt.type<"babybear">, %visible: !felt.type<"babybear"> {llzk.pub}) {
      %value = felt.mul %secret, %visible : !felt.type<"babybear">, !felt.type<"babybear">
      %out = struct.readm %self[@out] : !struct.type<@Main>, !felt.type<"babybear">
      constrain.eq %out, %value : !felt.type<"babybear">
      function.return
    }
  }
}

