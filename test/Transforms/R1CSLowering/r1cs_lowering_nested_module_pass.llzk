// RUN: llzk-opt -llzk-r1cs-lowering %s | FileCheck %s

// Resolve a main component nested inside a module before creating wires.

module attributes {llzk.lang, llzk.main = !struct.type<@Main::@Main>} {
  module @Main {
    struct.def @Main {
      struct.member @out : !felt.type {llzk.pub}
      function.def @compute(%input: !felt.type) -> !struct.type<@Main::@Main> attributes {function.allow_witness} {
        %self = struct.new : <@Main::@Main>
        struct.writem %self[@out] = %input : <@Main::@Main>, !felt.type
        function.return %self : !struct.type<@Main::@Main>
      }
      function.def @constrain(%self: !struct.type<@Main::@Main>, %input: !felt.type) attributes {function.allow_constraint} {
        %out = struct.readm %self[@out] : <@Main::@Main>, !felt.type
        constrain.eq %out, %input : !felt.type
        function.return
      }
    }
  }
}

// CHECK-LABEL: module attributes {llzk.lang = "r1cs"} {
// CHECK-NEXT:    r1cs.circuit @Main inputs (%[[VAL_0:[0-9a-zA-Z_\.]+]]: !r1cs.signal) {
// CHECK-NEXT:      %[[VAL_1:[0-9a-zA-Z_\.]+]] = r1cs.def 1 : !r1cs.signal {pub = #r1cs.pub}
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = r1cs.const 0 : !r1cs.linear
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = r1cs.const 0 : !r1cs.linear
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = r1cs.to_linear %[[VAL_0]] : !r1cs.signal to !r1cs.linear
// CHECK-NEXT:      %[[VAL_5:[0-9a-zA-Z_\.]+]] = r1cs.to_linear %[[VAL_1]] : !r1cs.signal to !r1cs.linear
// CHECK-NEXT:      %[[VAL_6:[0-9a-zA-Z_\.]+]] = r1cs.mul_const %[[VAL_5]], -1 : !r1cs.linear
// CHECK-NEXT:      %[[VAL_7:[0-9a-zA-Z_\.]+]] = r1cs.add %[[VAL_4]], %[[VAL_6]] : !r1cs.linear
// CHECK-NEXT:      r1cs.constrain %[[VAL_2]], %[[VAL_3]], %[[VAL_7]] : !r1cs.linear
// CHECK-NEXT:    } {r1cs.input_labels = array<i64: 2>}
// CHECK-NEXT:  }
