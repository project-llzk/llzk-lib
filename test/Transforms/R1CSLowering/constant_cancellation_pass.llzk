// CHECK-NEXT:      %[[VAL_1:[0-9a-zA-Z_\.]+]] = r1cs.const  0 : i64 : !r1cs.linear
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = r1cs.to_linear %[[VAL_0]] : !r1cs.signal to !r1cs.linear
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = r1cs.mul_const %[[VAL_2]],  0 : i64 : !r1cs.linear
// CHECK-NEXT:      r1cs.constrain %[[VAL_1]], %[[VAL_1]], %[[VAL_3]] : !r1cs.linear
// CHECK-NEXT:    }
