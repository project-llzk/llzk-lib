// RUN: llzk-opt %s --llzk-full-r1cs-lowering | FileCheck %s
// Reads of different array elements must use distinct wires.
module attributes {llzk.lang, llzk.main = !struct.type<@Main>, poly.evaluated_main = @Main} {
  struct.def @Child {
    struct.member @value : !felt.type {llzk.pub}
    function.def @compute() -> !struct.type<@Child> {
      %self = struct.new : <@Child>
      function.return %self : !struct.type<@Child>
    }
    function.def @constrain(%self: !struct.type<@Child>) {
      function.return
    }
  }
  struct.def @Main {
    struct.member @children : !array.type<2 x !struct.type<@Child>> {poly.original_public = false}
    function.def @compute(%x: !felt.type) -> !struct.type<@Main> {
      %self = struct.new : <@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>, %x: !felt.type) attributes {poly.evaluated} {
      %zero = arith.constant 0 : index
      %one = arith.constant 1 : index
      %children = struct.readm %self[@children] : !struct.type<@Main>, !array.type<2 x !struct.type<@Child>>
      %child0 = array.read %children[%zero] : !array.type<2 x !struct.type<@Child>>, !struct.type<@Child>
      %a = struct.readm %child0[@value] : !struct.type<@Child>, !felt.type {poly.signal_binding = {path = [0, "children", 0 : index, "value"], public = false}}
      %child1 = array.read %children[%one] : !array.type<2 x !struct.type<@Child>>, !struct.type<@Child>
      %again = struct.readm %child1[@value] : !struct.type<@Child>, !felt.type {poly.signal_binding = {path = [0, "children", 1 : index, "value"], public = false}}
      %square = felt.mul %a, %again
      constrain.eq %square, %x : !felt.type
      function.return
    }
  }
}


// NOTE: Assertions have been autogenerated by scripts/generate-test-checks.py

// The script is designed to make adding checks to
// a test case fast, it is *not* designed to be authoritative
// about what constitutes a good test! The CHECK should be
// minimized and named to reflect the test intent.


// CHECK-LABEL: module attributes {llzk.lang, llzk.main = !struct.type<@Main>, poly.evaluated_main = @Main, r1cs.main = @Main__r1cs} {
// CHECK-NEXT:    r1cs.circuit @Main__r1cs inputs (%[[VAL_0:[0-9a-zA-Z_\.]+]]: !r1cs.signal) attributes {poly.wire_bindings = [{path = [1], public = false, wire = 1 : i64}, {path = [0, "children", 0 : index, "value"], public = false, wire = 2 : i64}, {path = [0, "children", 1 : index, "value"], public = false, wire = 3 : i64}]} {
// CHECK-NEXT:      %[[VAL_1:[0-9a-zA-Z_\.]+]] = r1cs.def 1 : !r1cs.signal
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = r1cs.def 2 : !r1cs.signal
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = r1cs.to_linear %[[VAL_1]] : !r1cs.signal to !r1cs.linear
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = r1cs.to_linear %[[VAL_2]] : !r1cs.signal to !r1cs.linear
// CHECK-NEXT:      %[[VAL_5:[0-9a-zA-Z_\.]+]] = r1cs.to_linear %[[VAL_0]] : !r1cs.signal to !r1cs.linear
// CHECK-NEXT:      r1cs.constrain %[[VAL_3]], %[[VAL_4]], %[[VAL_5]] : !r1cs.linear
// CHECK-NEXT:    }
