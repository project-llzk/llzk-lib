// RUN: llzk-opt %s -llzk-monomorphize | FileCheck %s
// RUN: llzk-opt %s --pass-pipeline="builtin.module(llzk-monomorphize,llzk-monomorphize)" | FileCheck %s
module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  poly.template @Child {
    poly.param @N : index
    struct.def @Child {
      struct.member @x : !array.type<@N x !felt.type>
      function.def @compute() -> !struct.type<@Child::@Child<[@N]>> {
        %s = struct.new : !struct.type<@Child::@Child<[@N]>>
        function.return %s : !struct.type<@Child::@Child<[@N]>>
      }
      function.def @constrain(%s: !struct.type<@Child::@Child<[@N]>>) {
        function.return
      }
    }
  }
  poly.template @Helper {
    poly.param @N : index
    function.def @f() -> index {
      %n = poly.read_const @N : index
      function.return %n : index
    }
  }
  struct.def @Main {
    function.def @compute() -> !struct.type<@Main> {
      %s = struct.new : !struct.type<@Main>
      %zero = arith.constant 0 : index
      %one = arith.constant 1 : index
      %ten = arith.constant 10 : index
      scf.for %i = %zero to %ten step %one {
        %a = function.call @Child::@Child::@compute() : () -> !struct.type<@Child::@Child<[2]>>
        %b = function.call @Child::@Child::@compute() : () -> !struct.type<@Child::@Child<[2]>>
        %c = function.call @Child::@Child::@compute() : () -> !struct.type<@Child::@Child<[3]>>
        %n = function.call @Helper::@f<[2]>() : () -> index
        %m = function.call @Helper::@f<[2]>() : () -> index
      }
      %r = scf.while (%v = %zero) : (index) -> index {
        %cond = arith.cmpi slt, %v, %ten : index
        scf.condition(%cond) %v : index
      } do {
      ^bb0(%v: index):
        %next = arith.addi %v, %one : index
        scf.yield %next : index
      }
      function.return %s : !struct.type<@Main>
    }
    function.def @constrain(%s: !struct.type<@Main>) {
      function.return
    }
  }
}

