// RUN: llzk-opt %s -llzk-monomorphize | FileCheck %s
// Circom emits nested component types in POD records, field-valued constructor
// arguments, and dimension expressions with index/field casts. Preserve the
// templates while resolving all three in the specialized definitions.
module attributes {llzk.lang, llzk.main = !struct.type<@Parent::@Parent<[4]>>} {
  poly.template @Child {
    poly.param @N : index
    struct.def @Child {
      struct.member @values : !array.type<@N x !felt.type<"bn128">>
      function.def @compute() -> !struct.type<@Child::@Child<[@N]>> {
        %s = struct.new : !struct.type<@Child::@Child<[@N]>>
        function.return %s : !struct.type<@Child::@Child<[@N]>>
      }
      function.def @constrain(%s: !struct.type<@Child::@Child<[@N]>>) { function.return }
    }
  }
  poly.template @Parent {
    poly.param @N : index
    poly.expr @Rounds {
      %n = poly.read_const @N : index
      %f = cast.tofelt %n : index, !felt.type<"bn128">
      %one = felt.const 1 : <"bn128">
      %sub = felt.sub %f, %one : !felt.type<"bn128">, !felt.type<"bn128">
      %size = cast.toindex %sub : !felt.type<"bn128">
      poly.yield %size : index
    }
    poly.expr @Width {
      %index = poly.read_const @N : index
      %n = cast.tofelt %index : index, !felt.type<"bn128">
      %one = felt.const 1 : <"bn128">
      %add = felt.add %n, %one : !felt.type<"bn128">, !felt.type<"bn128">
      poly.yield %add : !felt.type<"bn128">
    }
    struct.def @Parent {
      struct.member @rounds : !array.type<@Rounds x !felt.type<"bn128">>
      struct.member @record : !pod.type<[@child: !struct.type<@Child::@Child<[@Width]>>]>
      function.def @compute() -> !struct.type<@Parent::@Parent<[@N]>> {
        %n = poly.read_const @Rounds : index
        %a = function.call @Child::@Child::@compute() : () -> !struct.type<@Child::@Child<[@Width]>>
        %b = function.call @Child::@Child::@compute() : () -> !struct.type<@Child::@Child<[@Width]>>
        %record = pod.new { @child = %a } : <[@child: !struct.type<@Child::@Child<[@Width]>>]>
        %s = struct.new : !struct.type<@Parent::@Parent<[@N]>>
        function.return %s : !struct.type<@Parent::@Parent<[@N]>>
      }
      function.def @constrain(%s: !struct.type<@Parent::@Parent<[@N]>>) { function.return }
    }
  }
}

