// RUN: llzk-opt -llzk-full-r1cs-lowering %s | FileCheck %s

// CHECK-LABEL: module attributes {llzk.lang = "r1cs"} {
// CHECK-NEXT:    r1cs.circuit @Add inputs (
// CHECK-COUNT-2:   r1cs.def
// CHECK-COUNT-2:   r1cs.constrain
// CHECK-NOT:       scf.
// CHECK-NOT:       array.
module attributes {llzk.lang = "circom", llzk.main = !struct.type<@Add>} {
  struct.def @Add {
      struct.member @out : !array.type<2 x !felt.type<"bn128">> {llzk.pub}
      function.def @compute(%a: !array.type<2 x !felt.type<"bn128">>, %b: !array.type<2 x !felt.type<"bn128">>) -> !struct.type<@Add> attributes {function.allow_non_native_field_ops, function.allow_witness} {
        %self = struct.new : <@Add>
        %out = llzk.nondet : !array.type<2 x !felt.type<"bn128">>
        %zero = felt.const 0 : <"bn128">
        %unused = scf.while (%i = %zero) : (!felt.type<"bn128">) -> !felt.type<"bn128"> {
          %two = felt.const 2 : <"bn128">
          %cond = bool.cmp lt(%i, %two) : !felt.type<"bn128">, !felt.type<"bn128">
          scf.condition(%cond) %i : !felt.type<"bn128">
        } do {
        ^bb0(%i: !felt.type<"bn128">):
          %idx = cast.toindex %i : !felt.type<"bn128">
          %av = array.read %a[%idx] : <2 x !felt.type<"bn128">>, !felt.type<"bn128">
          %bv = array.read %b[%idx] : <2 x !felt.type<"bn128">>, !felt.type<"bn128">
          %sum = felt.add %av, %bv : !felt.type<"bn128">, !felt.type<"bn128">
          array.write %out[%idx] = %sum : <2 x !felt.type<"bn128">>, !felt.type<"bn128">
          %one = felt.const 1 : <"bn128">
          %next = felt.add %i, %one : !felt.type<"bn128">, !felt.type<"bn128">
          scf.yield %next : !felt.type<"bn128">
        }
        struct.writem %self[@out] = %out : <@Add>, !array.type<2 x !felt.type<"bn128">>
        function.return %self : !struct.type<@Add>
      }
      function.def @constrain(%self: !struct.type<@Add>, %a: !array.type<2 x !felt.type<"bn128">>, %b: !array.type<2 x !felt.type<"bn128">>) attributes {function.allow_constraint, function.allow_non_native_field_ops} {
        %out = struct.readm %self[@out] : <@Add>, !array.type<2 x !felt.type<"bn128">>
        %zero = felt.const 0 : <"bn128">
        %unused = scf.while (%i = %zero) : (!felt.type<"bn128">) -> !felt.type<"bn128"> {
          %two = felt.const 2 : <"bn128">
          %cond = bool.cmp lt(%i, %two) : !felt.type<"bn128">, !felt.type<"bn128">
          scf.condition(%cond) %i : !felt.type<"bn128">
        } do {
        ^bb0(%i: !felt.type<"bn128">):
          %idx = cast.toindex %i : !felt.type<"bn128">
          %av = array.read %a[%idx] : <2 x !felt.type<"bn128">>, !felt.type<"bn128">
          %bv = array.read %b[%idx] : <2 x !felt.type<"bn128">>, !felt.type<"bn128">
          %sum = felt.add %av, %bv : !felt.type<"bn128">, !felt.type<"bn128">
          %ov = array.read %out[%idx] : <2 x !felt.type<"bn128">>, !felt.type<"bn128">
          constrain.eq %ov, %sum : !felt.type<"bn128">, !felt.type<"bn128">
          %one = felt.const 1 : <"bn128">
          %next = felt.add %i, %one : !felt.type<"bn128">, !felt.type<"bn128">
          scf.yield %next : !felt.type<"bn128">
        }
        function.return
      }
  }
}
