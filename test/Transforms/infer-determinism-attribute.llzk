// RUN: llzk-opt %s --infer-determinism-attribute --verify-diagnostics | FileCheck %s

// Verify inference, preservation, and removal of llzk.deterministic.
// Unannotated non-deterministic functions must not produce diagnostics.
module attributes {llzk.lang} {
  global.def const @constant : !felt.type = 7
  global.def @mutable : !felt.type
  // Local struct reads and constant globals are repeatable.
  struct.def @LocalUnmarked {
    struct.member @value : !felt.type {llzk.pub}
    function.def @compute(%x: !felt.type) -> !struct.type<@LocalUnmarked> {
      %self = struct.new : !struct.type<@LocalUnmarked>
      struct.writem %self[@value] = %x : !struct.type<@LocalUnmarked>, !felt.type
      %local = struct.readm %self[@value] : !struct.type<@LocalUnmarked>, !felt.type
      %constant = global.read const @constant : !felt.type
      %result = felt.add %local, %constant : !felt.type
      struct.writem %self[@value] = %result : !struct.type<@LocalUnmarked>, !felt.type
      function.return %self : !struct.type<@LocalUnmarked>
    }
    function.def @constrain(%self: !struct.type<@LocalUnmarked>, %x: !felt.type) {
      function.return
    }
  }

  // Local struct reads and constant globals are repeatable.
  struct.def @LocalMarked {
    struct.member @value : !felt.type {llzk.pub}
    function.def @compute(%x: !felt.type) -> !struct.type<@LocalMarked> attributes {llzk.deterministic} {
      %self = struct.new : !struct.type<@LocalMarked>
      struct.writem %self[@value] = %x : !struct.type<@LocalMarked>, !felt.type
      %local = struct.readm %self[@value] : !struct.type<@LocalMarked>, !felt.type
      %constant = global.read const @constant : !felt.type
      %result = felt.add %local, %constant : !felt.type
      struct.writem %self[@value] = %result : !struct.type<@LocalMarked>, !felt.type
      function.return %self : !struct.type<@LocalMarked>
    }
    function.def @constrain(%self: !struct.type<@LocalMarked>, %x: !felt.type) {
      function.return
    }
  }

  function.def private @external_unmarked(!felt.type) -> !felt.type
  function.def private @external_marked(!felt.type) -> !felt.type attributes {llzk.deterministic}

  function.def @felt_arithmetic_unmarked(%x: !felt.type) -> !felt.type {
    %one = felt.const 1
    %sum = felt.add %x, %one : !felt.type
    %result = felt.mul %sum, %x : !felt.type
    function.return %result : !felt.type
  }

  function.def @felt_arithmetic_marked(%x: !felt.type) -> !felt.type attributes {llzk.deterministic} {
    %one = felt.const 1
    %sum = felt.add %x, %one : !felt.type
    %result = felt.mul %sum, %x : !felt.type
    function.return %result : !felt.type
  }

  function.def @mutable_global_unmarked() -> !felt.type {
    %result = global.read @mutable : !felt.type
    function.return %result : !felt.type
  }

  // expected-warning@+1 {{removing llzk.deterministic applied to non-deterministic function}}
  function.def @mutable_global_marked() -> !felt.type attributes {llzk.deterministic} {
    // expected-note@+1 {{non-constant global read}}
    %result = global.read @mutable : !felt.type
    function.return %result : !felt.type
  }

  function.def @non_self_read_unmarked(%other: !struct.type<@LocalUnmarked>) -> !felt.type {
    %result = struct.readm %other[@value] : !struct.type<@LocalUnmarked>, !felt.type
    function.return %result : !felt.type
  }

  // expected-warning@+1 {{removing llzk.deterministic applied to non-deterministic function}}
  function.def @non_self_read_marked(%other: !struct.type<@LocalUnmarked>) -> !felt.type attributes {llzk.deterministic} {
    // expected-note@+1 {{non-self struct member read}}
    %result = struct.readm %other[@value] : !struct.type<@LocalUnmarked>, !felt.type
    function.return %result : !felt.type
  }

  function.def @ram_load_unmarked(%address: index) -> !felt.type attributes {function.allow_witness} {
    %result = ram.load %address : !felt.type
    function.return %result : !felt.type
  }

  // expected-warning@+1 {{removing llzk.deterministic applied to non-deterministic function}}
  function.def @ram_load_marked(%address: index) -> !felt.type attributes {function.allow_witness, llzk.deterministic} {
    // expected-note@+1 {{RAM load}}
    %result = ram.load %address : !felt.type
    function.return %result : !felt.type
  }

}

