// CHECK-NEXT:      %[[VAL_20:[0-9a-zA-Z_.-]+]] = felt.add %[[VAL_18]], %[[VAL_19]] : !felt.type, !felt.type
// CHECK-NEXT:      %[[VAL_21:[0-9a-zA-Z_.-]+]] = felt.mul %[[VAL_20]], %[[VAL_18]] : !felt.type, !felt.type
