// CHECK-NEXT:    global.def const @constant : !felt.type =  7
// CHECK-NEXT:    global.def @mutable : !felt.type
// CHECK-NEXT:    struct.def @LocalUnmarked {
// CHECK-NEXT:      struct.member @value : !felt.type {llzk.pub}
// CHECK-NEXT:      function.def @compute(%[[VAL_0:[0-9a-zA-Z_.-]+]]: !felt.type) -> !struct.type<@LocalUnmarked> attributes {function.allow_witness, llzk.deterministic} {
// CHECK-NEXT:        %[[VAL_1:[0-9a-zA-Z_.-]+]] = struct.new : <@LocalUnmarked>
// CHECK-NEXT:        struct.writem %[[VAL_1]][@value] = %[[VAL_0]] : <@LocalUnmarked>, !felt.type
// CHECK-NEXT:        %[[VAL_2:[0-9a-zA-Z_.-]+]] = struct.readm %[[VAL_1]][@value] : <@LocalUnmarked>, !felt.type
// CHECK-NEXT:        %[[VAL_3:[0-9a-zA-Z_.-]+]] = global.read const @constant : !felt.type
// CHECK-NEXT:        %[[VAL_4:[0-9a-zA-Z_.-]+]] = felt.add %[[VAL_2]], %[[VAL_3]] : !felt.type, !felt.type
// CHECK-NEXT:        struct.writem %[[VAL_1]][@value] = %[[VAL_4]] : <@LocalUnmarked>, !felt.type
// CHECK-NEXT:        function.return %[[VAL_1]] : !struct.type<@LocalUnmarked>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_5:[0-9a-zA-Z_.-]+]]: !struct.type<@LocalUnmarked>, %[[VAL_6:[0-9a-zA-Z_.-]+]]: !felt.type) attributes {function.allow_constraint, llzk.deterministic} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    struct.def @LocalMarked {
// CHECK-NEXT:      struct.member @value : !felt.type {llzk.pub}
// CHECK-NEXT:      function.def @compute(%[[VAL_7:[0-9a-zA-Z_.-]+]]: !felt.type) -> !struct.type<@LocalMarked> attributes {function.allow_witness, llzk.deterministic} {
// CHECK-NEXT:        %[[VAL_8:[0-9a-zA-Z_.-]+]] = struct.new : <@LocalMarked>
// CHECK-NEXT:        struct.writem %[[VAL_8]][@value] = %[[VAL_7]] : <@LocalMarked>, !felt.type
// CHECK-NEXT:        %[[VAL_9:[0-9a-zA-Z_.-]+]] = struct.readm %[[VAL_8]][@value] : <@LocalMarked>, !felt.type
// CHECK-NEXT:        %[[VAL_10:[0-9a-zA-Z_.-]+]] = global.read const @constant : !felt.type
// CHECK-NEXT:        %[[VAL_11:[0-9a-zA-Z_.-]+]] = felt.add %[[VAL_9]], %[[VAL_10]] : !felt.type, !felt.type
// CHECK-NEXT:        struct.writem %[[VAL_8]][@value] = %[[VAL_11]] : <@LocalMarked>, !felt.type
// CHECK-NEXT:        function.return %[[VAL_8]] : !struct.type<@LocalMarked>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_12:[0-9a-zA-Z_.-]+]]: !struct.type<@LocalMarked>, %[[VAL_13:[0-9a-zA-Z_.-]+]]: !felt.type) attributes {function.allow_constraint, llzk.deterministic} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    function.def private @external_unmarked(!felt.type) -> !felt.type
// CHECK-NEXT:    function.def private @external_marked(!felt.type) -> !felt.type attributes {llzk.deterministic}
// CHECK-NEXT:    function.def @felt_arithmetic_unmarked(%[[VAL_14:[0-9a-zA-Z_.-]+]]: !felt.type) -> !felt.type attributes {llzk.deterministic} {
// CHECK-NEXT:      %[[VAL_15:[0-9a-zA-Z_.-]+]] = felt.const  1
// CHECK-NEXT:      %[[VAL_16:[0-9a-zA-Z_.-]+]] = felt.add %[[VAL_14]], %[[VAL_15]] : !felt.type, !felt.type
// CHECK-NEXT:      %[[VAL_17:[0-9a-zA-Z_.-]+]] = felt.mul %[[VAL_16]], %[[VAL_14]] : !felt.type, !felt.type
// CHECK-NEXT:      function.return %[[VAL_17]] : !felt.type
