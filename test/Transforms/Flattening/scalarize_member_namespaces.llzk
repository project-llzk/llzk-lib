// CHECK-NEXT:      struct.writem %[[VAL_4]][@cells_0] = %[[VAL_7]] : <@Holder>, !struct.type<@TCell_0_Cell>
// CHECK-NEXT:      struct.writem %[[VAL_4]][@cells_1] = %[[VAL_8]] : <@Holder>, !struct.type<@TCell_1_Cell>
// CHECK-NEXT:      function.return %[[VAL_4]] : !struct.type<@Holder>
