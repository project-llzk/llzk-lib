// Keep expandable generic initializers consistent with externally read split members.
#id = affine_map<(i) -> (i)>
module attributes {llzk.lang} {
  module @Lib attributes {llzk.lang} {
    poly.template @TCell {
      poly.param @N : index
      struct.def @Cell {
        struct.member @value : !felt.type {llzk.pub}
        function.def @compute() -> !struct.type<@TCell::@Cell<[@N]>> {
          %self = struct.new : !struct.type<@TCell::@Cell<[@N]>>
          function.return %self : !struct.type<@TCell::@Cell<[@N]>>
        }
        function.def @constrain(%self: !struct.type<@TCell::@Cell<[@N]>>) { function.return }
      }
    }
    struct.def @Holder {
      struct.member @cells : !array.type<2 x !struct.type<@TCell::@Cell<[#id]>>> {llzk.pub}
      function.def @compute() -> !struct.type<@Holder> {
        %self = struct.new : !struct.type<@Holder>
        %zero = arith.constant 0 : index
        %one = arith.constant 1 : index
        %a = array.new : !array.type<2 x !struct.type<@TCell::@Cell<[#id]>>>
        %cell0 = function.call @TCell::@Cell::@compute() : () -> !struct.type<@TCell::@Cell<[0]>>
        %cell1 = function.call @TCell::@Cell::@compute() : () -> !struct.type<@TCell::@Cell<[1]>>
        array.write %a[%zero] = %cell0 : !array.type<2 x !struct.type<@TCell::@Cell<[#id]>>>, !struct.type<@TCell::@Cell<[0]>>
        array.write %a[%one] = %cell1 : !array.type<2 x !struct.type<@TCell::@Cell<[#id]>>>, !struct.type<@TCell::@Cell<[1]>>
        struct.writem %self[@cells] = %a : !struct.type<@Holder>, !array.type<2 x !struct.type<@TCell::@Cell<[#id]>>>
        %generic0 = llzk.nondet : !struct.type<@TCell::@Cell<[#id]>>
        %generic1 = llzk.nondet : !struct.type<@TCell::@Cell<[#id]>>
        %items = array.new %generic0, %generic1 : <2 x !struct.type<@TCell::@Cell<[#id]>>>
        struct.writem %self[@cells] = %items : <@Holder>, !array.type<2 x !struct.type<@TCell::@Cell<[#id]>>>
        function.return %self : !struct.type<@Holder>
      }
      function.def @constrain(%self: !struct.type<@Holder>) { function.return }
    }
  }
  function.def @consume(%x: !struct.type<@Lib::@TCell::@Cell<[0]>>) { function.return }
  function.def @test() attributes {function.allow_witness} {
    %zero = arith.constant 0 : index
    %holder = function.call @Lib::@Holder::@compute() : () -> !struct.type<@Lib::@Holder>
    %cells = struct.readm %holder[@cells] : !struct.type<@Lib::@Holder>, !array.type<2 x !struct.type<@Lib::@TCell::@Cell<[#id]>>>
    %cell = array.read %cells[%zero] : !array.type<2 x !struct.type<@Lib::@TCell::@Cell<[#id]>>>, !struct.type<@Lib::@TCell::@Cell<[#id]>>
    function.call @consume(%cell) : (!struct.type<@Lib::@TCell::@Cell<[#id]>>) -> ()
    function.return
  }
}
