// CHECK-NEXT:    struct.member @cells_0 : !struct.type<@TCell_0_Cell> {llzk.pub}
// CHECK-NEXT:    struct.member @cells_1 : !struct.type<@TCell_1_Cell> {llzk.pub}
// CHECK-NEXT:    function.def @compute() -> !struct.type<@Holder> attributes {function.allow_witness} {
