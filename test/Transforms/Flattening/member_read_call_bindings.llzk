// CHECK-NEXT:        struct.member @left : !struct.type<@Lib::@Marker> {column}
// CHECK-NEXT:        struct.member @right : !struct.type<@Lib::@Marker> {column}
// CHECK-NEXT:        function.def @compute(%[[VAL_6:[0-9a-zA-Z_.-]+]]: !struct.type<@Lib::@Marker>) -> !struct.type<@Caller::@Holder<[@T]>> attributes {function.allow_witness} {
// CHECK-NEXT:          %[[VAL_7:[0-9a-zA-Z_.-]+]] = struct.new : <@Caller::@Holder<[@T]>>
// CHECK-NEXT:          struct.writem %[[VAL_7]][@left] = %[[VAL_6]] : <@Caller::@Holder<[@T]>>, !struct.type<@Lib::@Marker>
// CHECK-NEXT:          struct.writem %[[VAL_7]][@right] = %[[VAL_6]] : <@Caller::@Holder<[@T]>>, !struct.type<@Lib::@Marker>
// CHECK-NEXT:          %[[VAL_8:[0-9a-zA-Z_.-]+]] = struct.readm %[[VAL_7]][@left] : <@Caller::@Holder<[@T]>>, !struct.type<@Lib::@Marker>
// CHECK-NEXT:          %[[VAL_9:[0-9a-zA-Z_.-]+]] = struct.readm %[[VAL_7]][@right] : <@Caller::@Holder<[@T]>>, !struct.type<@Lib::@Marker>
// CHECK-NEXT:          function.call @Lib::@consume(%[[VAL_8]], %[[VAL_9]]) : (!struct.type<@Lib::@Marker>, !struct.type<@Lib::@Marker>) -> ()
// CHECK-NEXT:          function.return %[[VAL_7]] : !struct.type<@Caller::@Holder<[@T]>>
// CHECK-NEXT:        }
// CHECK-NEXT:        function.def @constrain(%[[VAL_10:[0-9a-zA-Z_.-]+]]: !struct.type<@Caller::@Holder<[@T]>>, %[[VAL_11:[0-9a-zA-Z_.-]+]]: !struct.type<@Lib::@Marker>) attributes {function.allow_constraint} {
// CHECK-NEXT:          function.return
// CHECK-NEXT:        }
// CHECK-NEXT:      }
