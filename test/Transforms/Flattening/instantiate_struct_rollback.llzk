// RUN: sed '/^\/\/ CHECK/d' %s | llzk-opt -split-input-file -llzk-flatten -verify-diagnostics - 2>&1 | FileCheck --enable-var-scope %s

// Failed full and partial struct specializations must erase their generated definitions without
// preventing later independent specializations.
module attributes {llzk.lang} {
  poly.template @BrokenStruct {
    poly.param @Num

    struct.def @Value {
      struct.member @value : !felt.type<"bn128"> {column, llzk.pub}

      function.def @compute() -> !struct.type<@BrokenStruct::@Value<[@Num]>> {
        // expected-error@+2 {{'poly.read_const' op felt constant #felt<const 35 : <"babybear">> : !felt.type<"babybear"> is incompatible with converted result type '!felt.type<"bn128">'}}
        // expected-error@+1 {{failed to legalize operation 'poly.read_const'}}
        %value = poly.read_const @Num : !felt.type<"bn128">
        %self = struct.new : !struct.type<@BrokenStruct::@Value<[@Num]>>
        struct.writem %self[@value] = %value : !struct.type<@BrokenStruct::@Value<[@Num]>>, !felt.type<"bn128">
        function.return %self : !struct.type<@BrokenStruct::@Value<[@Num]>>
      }

      function.def @constrain(%self: !struct.type<@BrokenStruct::@Value<[@Num]>>) {
        function.return
      }
    }
  }

  struct.def @Use {
    struct.member @inner : !struct.type<@BrokenStruct::@Value<[#felt<const 35 : !felt.type<"babybear">>]>>

    function.def @compute() -> !struct.type<@Use> {
      %self = struct.new : !struct.type<@Use>
      function.return %self : !struct.type<@Use>
    }

    function.def @constrain(%self: !struct.type<@Use>) {
      function.return
    }
  }
}

// A failed generated-struct conversion must not leave its inserted owner in the module.
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    poly.template @BrokenStruct {
// CHECK-NEXT:      poly.param @Num
// CHECK-NEXT:      struct.def @Value {
// CHECK-NEXT:        struct.member @value : !felt.type<"bn128"> {column, llzk.pub}
// CHECK-NEXT:        function.def @compute() -> !struct.type<@BrokenStruct::@Value<[@Num]>> attributes {function.allow_witness} {
// CHECK-NEXT:          %[[VAL_0:[0-9a-zA-Z_\.]+]] = poly.read_const @Num : !felt.type<"bn128">
// CHECK-NEXT:          %[[VAL_1:[0-9a-zA-Z_\.]+]] = struct.new : <@BrokenStruct::@Value<[@Num]>>
// CHECK-NEXT:          struct.writem %[[VAL_1]][@value] = %[[VAL_0]] : <@BrokenStruct::@Value<[@Num]>>, !felt.type<"bn128">
// CHECK-NEXT:          function.return %[[VAL_1]] : !struct.type<@BrokenStruct::@Value<[@Num]>>
// CHECK-NEXT:        }
// CHECK-NEXT:        function.def @constrain(%[[VAL_2:[0-9a-zA-Z_\.]+]]: !struct.type<@BrokenStruct::@Value<[@Num]>>) attributes {function.allow_constraint} {
// CHECK-NEXT:          function.return
// CHECK-NEXT:        }
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    struct.def @Use {
// CHECK-NEXT:      struct.member @inner : !struct.type<@BrokenStruct::@Value<[#felt<const 35 : <"babybear">>]>>
// CHECK-NEXT:      function.def @compute() -> !struct.type<@Use> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_3:[0-9a-zA-Z_\.]+]] = struct.new : <@Use>
// CHECK-NEXT:        function.return %[[VAL_3]] : !struct.type<@Use>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_4:[0-9a-zA-Z_\.]+]]: !struct.type<@Use>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }
// CHECK:  // -----

// -----

module attributes {llzk.lang} {
  poly.template @BrokenPartial {
    poly.param @Num
    poly.param @Offset : index

    struct.def @Value {
      struct.member @value : !felt.type<"bn128"> {column, llzk.pub}

      function.def @compute() -> !struct.type<@BrokenPartial::@Value<[@Num, @Offset]>> {
        // expected-error@+2 {{'poly.read_const' op felt constant #felt<const 35 : <"babybear">> : !felt.type<"babybear"> is incompatible with converted result type '!felt.type<"bn128">'}}
        // expected-error@+1 {{failed to legalize operation 'poly.read_const'}}
        %value = poly.read_const @Num : !felt.type<"bn128">
        %self = struct.new : !struct.type<@BrokenPartial::@Value<[@Num, @Offset]>>
        struct.writem %self[@value] = %value : !struct.type<@BrokenPartial::@Value<[@Num, @Offset]>>, !felt.type<"bn128">
        function.return %self : !struct.type<@BrokenPartial::@Value<[@Num, @Offset]>>
      }

      function.def @constrain(%self: !struct.type<@BrokenPartial::@Value<[@Num, @Offset]>>) {
        function.return
      }
    }
  }

  poly.template @Bridge {
    poly.param @Offset : index

    struct.def @Wrapper {
      struct.member @inner : !struct.type<@BrokenPartial::@Value<[#felt<const 35 : !felt.type<"babybear">>, @Offset]>>

      function.def @compute() -> !struct.type<@Bridge::@Wrapper<[@Offset]>> {
        %self = struct.new : !struct.type<@Bridge::@Wrapper<[@Offset]>>
        function.return %self : !struct.type<@Bridge::@Wrapper<[@Offset]>>
      }

      function.def @constrain(%self: !struct.type<@Bridge::@Wrapper<[@Offset]>>) {
        function.return
      }
    }
  }

  struct.def @BadUse {
    struct.member @inner : !struct.type<@Bridge::@Wrapper<[7]>>

    function.def @compute() -> !struct.type<@BadUse> {
      %self = struct.new : !struct.type<@BadUse>
      function.return %self : !struct.type<@BadUse>
    }

    function.def @constrain(%self: !struct.type<@BadUse>) {
      function.return
    }
  }

  // A later valid specialization must still succeed after the earlier partial specialization
  // fails.
  poly.template @GoodStruct {
    poly.param @N : index

    struct.def @Value {
      struct.member @value : index

      function.def @compute() -> !struct.type<@GoodStruct::@Value<[@N]>> {
        %self = struct.new : !struct.type<@GoodStruct::@Value<[@N]>>
        function.return %self : !struct.type<@GoodStruct::@Value<[@N]>>
      }

      function.def @constrain(%self: !struct.type<@GoodStruct::@Value<[@N]>>) {
        function.return
      }
    }
  }

  struct.def @GoodUse {
    struct.member @inner : !struct.type<@GoodStruct::@Value<[7]>>

    function.def @compute() -> !struct.type<@GoodUse> {
      %self = struct.new : !struct.type<@GoodUse>
      function.return %self : !struct.type<@GoodUse>
    }

    function.def @constrain(%self: !struct.type<@GoodUse>) {
      function.return
    }
  }
}

// A failed partial conversion must not leave its generated template. The later specialization
// proves that the same cloner remains usable after rollback.
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    poly.template @BrokenPartial {
// CHECK-NEXT:      poly.param @Num
// CHECK-NEXT:      poly.param @Offset : index
// CHECK-NEXT:      struct.def @Value {
// CHECK-NEXT:        struct.member @value : !felt.type<"bn128"> {column, llzk.pub}
// CHECK-NEXT:        function.def @compute() -> !struct.type<@BrokenPartial::@Value<[@Num, @Offset]>> attributes {function.allow_witness} {
// CHECK-NEXT:          %[[VAL_0:[0-9a-zA-Z_\.]+]] = poly.read_const @Num : !felt.type<"bn128">
// CHECK-NEXT:          %[[VAL_1:[0-9a-zA-Z_\.]+]] = struct.new : <@BrokenPartial::@Value<[@Num, @Offset]>>
// CHECK-NEXT:          struct.writem %[[VAL_1]][@value] = %[[VAL_0]] : <@BrokenPartial::@Value<[@Num, @Offset]>>, !felt.type<"bn128">
// CHECK-NEXT:          function.return %[[VAL_1]] : !struct.type<@BrokenPartial::@Value<[@Num, @Offset]>>
// CHECK-NEXT:        }
// CHECK-NEXT:        function.def @constrain(%[[VAL_2:[0-9a-zA-Z_\.]+]]: !struct.type<@BrokenPartial::@Value<[@Num, @Offset]>>) attributes {function.allow_constraint} {
// CHECK-NEXT:          function.return
// CHECK-NEXT:        }
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    struct.def @Bridge_7_Wrapper {
// CHECK-NEXT:      struct.member @inner : !struct.type<@BrokenPartial::@Value<[#felt<const 35 : <"babybear">>, 7]>>
// CHECK-NEXT:      function.def @compute() -> !struct.type<@Bridge_7_Wrapper> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_3:[0-9a-zA-Z_\.]+]] = struct.new : <@Bridge_7_Wrapper>
// CHECK-NEXT:        function.return %[[VAL_3]] : !struct.type<@Bridge_7_Wrapper>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_4:[0-9a-zA-Z_\.]+]]: !struct.type<@Bridge_7_Wrapper>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    struct.def @BadUse {
// CHECK-NEXT:      struct.member @inner : !struct.type<@Bridge_7_Wrapper>
// CHECK-NEXT:      function.def @compute() -> !struct.type<@BadUse> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_5:[0-9a-zA-Z_\.]+]] = struct.new : <@BadUse>
// CHECK-NEXT:        function.return %[[VAL_5]] : !struct.type<@BadUse>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_6:[0-9a-zA-Z_\.]+]]: !struct.type<@BadUse>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    struct.def @GoodStruct_7_Value {
// CHECK-NEXT:      struct.member @value : index
// CHECK-NEXT:      function.def @compute() -> !struct.type<@GoodStruct_7_Value> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_7:[0-9a-zA-Z_\.]+]] = struct.new : <@GoodStruct_7_Value>
// CHECK-NEXT:        function.return %[[VAL_7]] : !struct.type<@GoodStruct_7_Value>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_8:[0-9a-zA-Z_\.]+]]: !struct.type<@GoodStruct_7_Value>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    struct.def @GoodUse {
// CHECK-NEXT:      struct.member @inner : !struct.type<@GoodStruct_7_Value>
// CHECK-NEXT:      function.def @compute() -> !struct.type<@GoodUse> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_9:[0-9a-zA-Z_\.]+]] = struct.new : <@GoodUse>
// CHECK-NEXT:        function.return %[[VAL_9]] : !struct.type<@GoodUse>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_10:[0-9a-zA-Z_\.]+]]: !struct.type<@GoodUse>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }
