// RUN: llzk-opt -split-input-file -llzk-flatten -verify-diagnostics %s

#id = affine_map<(i) -> (i)>
module attributes {llzk.lang} {
  poly.template @TCell {
    poly.param @N : index

    struct.def @Cell {
      struct.member @value : !felt.type {column}

      function.def @compute() -> !struct.type<@TCell::@Cell<[@N]>> {
        %self = struct.new : !struct.type<@TCell::@Cell<[@N]>>
        function.return %self : !struct.type<@TCell::@Cell<[@N]>>
      }

      function.def @constrain(%self: !struct.type<@TCell::@Cell<[@N]>>) {
        function.return
      }
    }
  }

  function.def @consume0(%value: !struct.type<@TCell::@Cell<[0]>>) {
    function.return
  }

  function.def @consumeArray1(%values: !array.type<2 x !struct.type<@TCell::@Cell<[1]>>>) {
    function.return
  }

  function.def @shared_read() attributes {function.allow_witness} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %shared = llzk.nondet : !struct.type<@TCell::@Cell<[#id]>>
    %item1 = function.call @TCell::@Cell::@compute() : () -> !struct.type<@TCell::@Cell<[1]>>
    %item2 = function.call @TCell::@Cell::@compute() : () -> !struct.type<@TCell::@Cell<[2]>>

    // The inline initializer specializes index zero to Cell<0>.
    %first = array.new %shared, %shared, %shared : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>
    array.write %first[%c1] = %item1 : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>, !struct.type<@TCell::@Cell<[1]>>
    array.write %first[%c2] = %item2 : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>, !struct.type<@TCell::@Cell<[2]>>
    %firstRead = array.read %first[%c0] : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>, !struct.type<@TCell::@Cell<[#id]>>
    function.call @consume0(%firstRead) : (!struct.type<@TCell::@Cell<[#id]>>) -> ()

    // Explicit writes leave index zero's cached type generic. Its replacement must
    // nevertheless use the same Cell<0> witness as the first candidate.
    %second = array.new : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>
    array.write %second[%c0] = %shared : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>, !struct.type<@TCell::@Cell<[#id]>>
    array.write %second[%c1] = %item1 : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>, !struct.type<@TCell::@Cell<[1]>>
    array.write %second[%c2] = %item2 : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>, !struct.type<@TCell::@Cell<[2]>>
    // expected-error@+1 {{cannot scalarize heterogeneous array read because its index-specific value type is incompatible with an array initializer}}
    %secondRead = array.read %second[%c0] : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>, !struct.type<@TCell::@Cell<[#id]>>
    // expected-note@+1 {{array initializer requires exactly}}
    %escape = array.new %secondRead, %secondRead : !array.type<2 x !struct.type<@TCell::@Cell<[#id]>>>
    function.call @consumeArray1(%escape) : (!array.type<2 x !struct.type<@TCell::@Cell<[#id]>>>) -> ()
    function.return
  }
}

// -----

// The conflicting read must also be rejected when its array is visited first.
#id = affine_map<(i) -> (i)>
module attributes {llzk.lang} {
  poly.template @TCell {
    poly.param @N : index

    struct.def @Cell {
      struct.member @value : !felt.type {column}

      function.def @compute() -> !struct.type<@TCell::@Cell<[@N]>> {
        %self = struct.new : !struct.type<@TCell::@Cell<[@N]>>
        function.return %self : !struct.type<@TCell::@Cell<[@N]>>
      }

      function.def @constrain(%self: !struct.type<@TCell::@Cell<[@N]>>) {
        function.return
      }
    }
  }

  function.def @consume0(%value: !struct.type<@TCell::@Cell<[0]>>) {
    function.return
  }

  function.def @consumeArray1(%values: !array.type<2 x !struct.type<@TCell::@Cell<[1]>>>) {
    function.return
  }

  function.def @shared_read() attributes {function.allow_witness} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %shared = llzk.nondet : !struct.type<@TCell::@Cell<[#id]>>
    %item1 = function.call @TCell::@Cell::@compute() : () -> !struct.type<@TCell::@Cell<[1]>>
    %item2 = function.call @TCell::@Cell::@compute() : () -> !struct.type<@TCell::@Cell<[2]>>

    // Explicit writes leave index zero's cached type generic. Its replacement must
    // nevertheless use the same Cell<0> witness as the first candidate.
    %second = array.new : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>
    array.write %second[%c0] = %shared : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>, !struct.type<@TCell::@Cell<[#id]>>
    array.write %second[%c1] = %item1 : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>, !struct.type<@TCell::@Cell<[1]>>
    array.write %second[%c2] = %item2 : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>, !struct.type<@TCell::@Cell<[2]>>
    // expected-error@+1 {{cannot scalarize heterogeneous array read because its index-specific value type is incompatible with an array initializer}}
    %secondRead = array.read %second[%c0] : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>, !struct.type<@TCell::@Cell<[#id]>>
    // expected-note@+1 {{array initializer requires exactly}}
    %escape = array.new %secondRead, %secondRead : !array.type<2 x !struct.type<@TCell::@Cell<[#id]>>>
    // The inline initializer specializes index zero to Cell<0>.
    %first = array.new %shared, %shared, %shared : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>
    array.write %first[%c1] = %item1 : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>, !struct.type<@TCell::@Cell<[1]>>
    array.write %first[%c2] = %item2 : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>, !struct.type<@TCell::@Cell<[2]>>
    %firstRead = array.read %first[%c0] : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>, !struct.type<@TCell::@Cell<[#id]>>
    function.call @consume0(%firstRead) : (!struct.type<@TCell::@Cell<[#id]>>) -> ()

    function.call @consumeArray1(%escape) : (!array.type<2 x !struct.type<@TCell::@Cell<[#id]>>>) -> ()
    function.return
  }
}
