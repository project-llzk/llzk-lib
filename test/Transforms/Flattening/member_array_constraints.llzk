// RUN: llzk-opt -llzk-flatten %s | FileCheck %s

// Both source paths must check equality and containment consumers of inferred array reads.
!Holder = !struct.type<@Template::@Holder<[@T]>>
module attributes {llzk.lang} {
  poly.template @Template {
    poly.param @T
    struct.def @Holder {
      struct.member @items : !array.type<1 x !poly.tvar<@T>> {column}
      function.def @compute(%value: !felt.type, %table: !array.type<2 x !felt.type>) -> !Holder {
        %self = struct.new : !Holder
        %items = array.new %value : !array.type<1 x !felt.type>
        struct.writem %self[@items] = %items : !Holder, !array.type<1 x !felt.type>
        function.return %self : !Holder
      }
      function.def @constrain(%self: !Holder, %value: !felt.type, %table: !array.type<2 x !felt.type>) {
        %c0 = arith.constant 0 : index
        %items = struct.readm %self[@items] : !Holder, !array.type<1 x !poly.tvar<@T>>
        %item = array.read %items[%c0] : !array.type<1 x !poly.tvar<@T>>, !poly.tvar<@T>
        constrain.eq %item, %value : !poly.tvar<@T>, !felt.type
        constrain.in %table, %item : !array.type<2 x !felt.type>, !poly.tvar<@T>
        function.return
      }
    }
    function.def @allocation(%value: !felt.type, %table: !array.type<2 x !felt.type>) attributes {function.allow_constraint} {
      %c0 = arith.constant 0 : index
      %items = array.new : !array.type<1 x !poly.tvar<@T>>
      array.write %items[%c0] = %value : !array.type<1 x !poly.tvar<@T>>, !felt.type
      %item = array.read %items[%c0] : !array.type<1 x !poly.tvar<@T>>, !poly.tvar<@T>
      constrain.eq %item, %value : !poly.tvar<@T>, !felt.type
      constrain.in %table, %item : !array.type<2 x !felt.type>, !poly.tvar<@T>
      function.return
    }
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    poly.template @Template {
// CHECK-NEXT:      poly.param @T
// CHECK-NEXT:      struct.def @Holder {
// CHECK-NEXT:        struct.member @items : !array.type<1 x !felt.type> {column}
// CHECK-NEXT:        function.def @compute(%[[VAL_0:[0-9a-zA-Z_.-]+]]: !felt.type, %[[VAL_1:[0-9a-zA-Z_.-]+]]: !array.type<2 x !felt.type>) -> !struct.type<@Template::@Holder<[@T]>> attributes {function.allow_witness} {
// CHECK-NEXT:          %[[VAL_2:[0-9a-zA-Z_.-]+]] = struct.new : <@Template::@Holder<[@T]>>
// CHECK-NEXT:          %[[VAL_3:[0-9a-zA-Z_.-]+]] = array.new %[[VAL_0]] : <1 x !felt.type>
// CHECK-NEXT:          struct.writem %[[VAL_2]][@items] = %[[VAL_3]] : <@Template::@Holder<[@T]>>, !array.type<1 x !felt.type>
// CHECK-NEXT:          function.return %[[VAL_2]] : !struct.type<@Template::@Holder<[@T]>>
// CHECK-NEXT:        }
// CHECK-NEXT:        function.def @constrain(%[[VAL_4:[0-9a-zA-Z_.-]+]]: !struct.type<@Template::@Holder<[@T]>>, %[[VAL_5:[0-9a-zA-Z_.-]+]]: !felt.type, %[[VAL_6:[0-9a-zA-Z_.-]+]]: !array.type<2 x !felt.type>) attributes {function.allow_constraint} {
// CHECK-NEXT:          %[[VAL_7:[0-9a-zA-Z_.-]+]] = arith.constant 0 : index
// CHECK-NEXT:          %[[VAL_8:[0-9a-zA-Z_.-]+]] = struct.readm %[[VAL_4]][@items] : <@Template::@Holder<[@T]>>, !array.type<1 x !felt.type>
// CHECK-NEXT:          %[[VAL_9:[0-9a-zA-Z_.-]+]] = array.read %[[VAL_8]]{{\[}}%[[VAL_7]]] : <1 x !felt.type>, !felt.type
// CHECK-NEXT:          constrain.eq %[[VAL_9]], %[[VAL_5]] : !felt.type, !felt.type
// CHECK-NEXT:          constrain.in %[[VAL_6]], %[[VAL_9]] : <2 x !felt.type>, !felt.type
// CHECK-NEXT:          function.return
// CHECK-NEXT:        }
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @allocation(%[[VAL_10:[0-9a-zA-Z_.-]+]]: !felt.type, %[[VAL_11:[0-9a-zA-Z_.-]+]]: !array.type<2 x !felt.type>) attributes {function.allow_constraint} {
// CHECK-NEXT:        %[[VAL_12:[0-9a-zA-Z_.-]+]] = arith.constant 0 : index
// CHECK-NEXT:        %[[VAL_13:[0-9a-zA-Z_.-]+]] = array.new  : <1 x !felt.type>
// CHECK-NEXT:        array.write %[[VAL_13]]{{\[}}%[[VAL_12]]] = %[[VAL_10]] : <1 x !felt.type>, !felt.type
// CHECK-NEXT:        %[[VAL_14:[0-9a-zA-Z_.-]+]] = array.read %[[VAL_13]]{{\[}}%[[VAL_12]]] : <1 x !felt.type>, !felt.type
// CHECK-NEXT:        constrain.eq %[[VAL_14]], %[[VAL_10]] : !felt.type, !felt.type
// CHECK-NEXT:        constrain.in %[[VAL_11]], %[[VAL_14]] : <2 x !felt.type>, !felt.type
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }
