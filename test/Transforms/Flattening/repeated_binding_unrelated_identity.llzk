// GENERIC-NEXT:        function.def @compute(%[[VAL_2:[0-9a-zA-Z_.-]+]]: !felt.type) -> !struct.type<@UnchangedUnrelatedSymbol::@Holder<[@T, @U, @V]>> attributes {function.allow_witness} {
