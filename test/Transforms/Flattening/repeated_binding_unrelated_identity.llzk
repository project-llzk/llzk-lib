// GENERIC-NEXT:        function.def @compute() -> !struct.type<@"Pair_f_\1A"::@Pair<[@Y]>> attributes {function.allow_witness} {
// GENERIC-NEXT:          %[[VAL_0:[0-9a-zA-Z_.-]+]] = struct.new : <@"Pair_f_\1A"::@Pair<[@Y]>>
// GENERIC-NEXT:          function.return %[[VAL_0]] : !struct.type<@"Pair_f_\1A"::@Pair<[@Y]>>
// GENERIC-NEXT:        }
