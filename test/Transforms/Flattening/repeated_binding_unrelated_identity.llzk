// RUN: llzk-opt -llzk-flatten %s | FileCheck %s

// Unchanged unrelated parameters permit a partially concrete candidate to specialize.
module attributes {llzk.lang} {
  poly.template @Pair {
    poly.param @X
    poly.param @Y
    struct.def @Pair {
      struct.member @first : !poly.tvar<@X>
      struct.member @second : !poly.tvar<@Y>
      function.def @compute() -> !struct.type<@Pair::@Pair<[@X, @Y]>> {
        %self = struct.new : !struct.type<@Pair::@Pair<[@X, @Y]>>
        function.return %self : !struct.type<@Pair::@Pair<[@X, @Y]>>
      }
      function.def @constrain(%self: !struct.type<@Pair::@Pair<[@X, @Y]>>) { function.return }
    }
  }
  poly.template @UnchangedUnrelatedSymbol {
    poly.param @T
    poly.param @U
    poly.param @V
    struct.def @Holder {
      struct.member @first : !poly.tvar<@T>
      struct.member @second : !struct.type<@Pair::@Pair<[@T, @U]>>
      struct.member @source : !struct.type<@Pair::@Pair<[!felt.type, @U]>>
      function.def @compute(%a: !felt.type) -> !struct.type<@UnchangedUnrelatedSymbol::@Holder<[@T, @U, @V]>> {
        %self = struct.new : !struct.type<@UnchangedUnrelatedSymbol::@Holder<[@T, @U, @V]>>
        struct.writem %self[@first] = %a : !struct.type<@UnchangedUnrelatedSymbol::@Holder<[@T, @U, @V]>>, !felt.type
        %b = struct.readm %self[@source] : !struct.type<@UnchangedUnrelatedSymbol::@Holder<[@T, @U, @V]>>, !struct.type<@Pair::@Pair<[!felt.type, @U]>>
        struct.writem %self[@second] = %b : !struct.type<@UnchangedUnrelatedSymbol::@Holder<[@T, @U, @V]>>, !struct.type<@Pair::@Pair<[!felt.type, @U]>>
        function.return %self : !struct.type<@UnchangedUnrelatedSymbol::@Holder<[@T, @U, @V]>>
      }
      function.def @constrain(%self: !struct.type<@UnchangedUnrelatedSymbol::@Holder<[@T, @U, @V]>>, %a: !felt.type) {
        function.return
      }
    }
  }

  function.def @entry(%input: !felt.type) -> !struct.type<@UnchangedUnrelatedSymbol::@Holder<[!felt.type, index, !felt.type]>> attributes {function.allow_witness} {
    %result = function.call @UnchangedUnrelatedSymbol::@Holder::@compute(%input) : (!felt.type) -> !struct.type<@UnchangedUnrelatedSymbol::@Holder<[!felt.type, index, !felt.type]>>
    function.return %result : !struct.type<@UnchangedUnrelatedSymbol::@Holder<[!felt.type, index, !felt.type]>>
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    poly.template @"Pair_f_\1A" {
// CHECK-NEXT:      poly.param @Y
// CHECK-NEXT:      struct.def @Pair {
// CHECK-NEXT:        struct.member @first : !felt.type
// CHECK-NEXT:        struct.member @second : !poly.tvar<@Y>
// CHECK-NEXT:        function.def @compute() -> !struct.type<@"Pair_f_\1A"::@Pair<[@Y]>> attributes {function.allow_witness} {
// CHECK-NEXT:          %[[VAL_0:[0-9a-zA-Z_.-]+]] = struct.new : <@"Pair_f_\1A"::@Pair<[@Y]>>
// CHECK-NEXT:          function.return %[[VAL_0]] : !struct.type<@"Pair_f_\1A"::@Pair<[@Y]>>
// CHECK-NEXT:        }
// CHECK-NEXT:        function.def @constrain(%[[VAL_1:[0-9a-zA-Z_.-]+]]: !struct.type<@"Pair_f_\1A"::@Pair<[@Y]>>) attributes {function.allow_constraint} {
// CHECK-NEXT:          function.return
// CHECK-NEXT:        }
// CHECK-NEXT:      }
// CHECK-NEXT:    } {poly.name_pattern = ["Pair_f_", ""]}
// CHECK-NEXT:    struct.def @Pair_f_i_Pair {
// CHECK-NEXT:      struct.member @first : !felt.type
// CHECK-NEXT:      struct.member @second : index
// CHECK-NEXT:      function.def @compute() -> !struct.type<@Pair_f_i_Pair> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_2:[0-9a-zA-Z_.-]+]] = struct.new : <@Pair_f_i_Pair>
// CHECK-NEXT:        function.return %[[VAL_2]] : !struct.type<@Pair_f_i_Pair>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_3:[0-9a-zA-Z_.-]+]]: !struct.type<@Pair_f_i_Pair>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    struct.def @UnchangedUnrelatedSymbol_f_i_f_Holder {
// CHECK-NEXT:      struct.member @first : !felt.type
// CHECK-NEXT:      struct.member @second : !struct.type<@Pair_f_i_Pair>
// CHECK-NEXT:      struct.member @source : !struct.type<@Pair_f_i_Pair>
// CHECK-NEXT:      function.def @compute(%[[VAL_4:[0-9a-zA-Z_.-]+]]: !felt.type) -> !struct.type<@UnchangedUnrelatedSymbol_f_i_f_Holder> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_5:[0-9a-zA-Z_.-]+]] = struct.new : <@UnchangedUnrelatedSymbol_f_i_f_Holder>
// CHECK-NEXT:        struct.writem %[[VAL_5]][@first] = %[[VAL_4]] : <@UnchangedUnrelatedSymbol_f_i_f_Holder>, !felt.type
// CHECK-NEXT:        %[[VAL_6:[0-9a-zA-Z_.-]+]] = struct.readm %[[VAL_5]][@source] : <@UnchangedUnrelatedSymbol_f_i_f_Holder>, !struct.type<@Pair_f_i_Pair>
// CHECK-NEXT:        struct.writem %[[VAL_5]][@second] = %[[VAL_6]] : <@UnchangedUnrelatedSymbol_f_i_f_Holder>, !struct.type<@Pair_f_i_Pair>
// CHECK-NEXT:        function.return %[[VAL_5]] : !struct.type<@UnchangedUnrelatedSymbol_f_i_f_Holder>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_7:[0-9a-zA-Z_.-]+]]: !struct.type<@UnchangedUnrelatedSymbol_f_i_f_Holder>, %[[VAL_8:[0-9a-zA-Z_.-]+]]: !felt.type) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    function.def @entry(%[[VAL_9:[0-9a-zA-Z_.-]+]]: !felt.type) -> !struct.type<@UnchangedUnrelatedSymbol_f_i_f_Holder> attributes {function.allow_witness} {
// CHECK-NEXT:      %[[VAL_10:[0-9a-zA-Z_.-]+]] = function.call @UnchangedUnrelatedSymbol_f_i_f_Holder::@compute(%[[VAL_9]]) : (!felt.type) -> !struct.type<@UnchangedUnrelatedSymbol_f_i_f_Holder>
// CHECK-NEXT:      function.return %[[VAL_10]] : !struct.type<@UnchangedUnrelatedSymbol_f_i_f_Holder>
// CHECK-NEXT:    }
// CHECK-NEXT:  }
