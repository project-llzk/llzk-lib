// DEFAULT-NEXT:    function.def @ExprOnlyFunc_value() -> index {
// DEFAULT-NEXT:      %[[FUNC_VALUE:[0-9a-zA-Z_\.]+]] = arith.constant 42 : index
// DEFAULT-NEXT:      function.return %[[FUNC_VALUE]] : index
// DEFAULT-NEXT:    }
// DEFAULT-NEXT:    function.def @main() -> index {
// DEFAULT-NEXT:      %[[MAIN_VALUE:[0-9a-zA-Z_\.]+]] = function.call @ExprOnlyFunc_value() : () -> index
// DEFAULT-NEXT:      function.return %[[MAIN_VALUE]] : index
// DEFAULT-NEXT:    }
// DEFAULT-NEXT:  }
// DEFAULT:  // {{[-][-][-][-][-]}}

