// RUN: llzk-opt -split-input-file -llzk-flatten %s | FileCheck --enable-var-scope %s --check-prefix=DEFAULT
// RUN: llzk-opt -split-input-file -llzk-flatten=cleanup=disabled %s | FileCheck --enable-var-scope %s --check-prefix=DISABLED

// A zero-parameter function template still specializes when its target-used expression is
// concrete. Expression materialization is independent of poly.param substitution.
module attributes {llzk.lang} {
  poly.template @ExprOnlyFunc {
    poly.expr @Value {
      %value = arith.constant 42 : index
      poly.yield %value : index
    }
    function.def @value() -> index {
      %value = poly.read_const @Value : index
      function.return %value : index
    }
  }

  function.def @main() -> index {
    %value = function.call @ExprOnlyFunc::@value() : () -> index
    function.return %value : index
  }
}

