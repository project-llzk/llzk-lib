// -----

// An expression-only struct is specialized from a type without a parameter list.
module attributes {llzk.lang, llzk.main = !struct.type<@ExprOnlyStructNoList::@Value>} {
  poly.template @ExprOnlyStructNoList {
    poly.expr @Result {
      %value = arith.constant 7 : index
      poly.yield %value : index
    }
    struct.def @Value {
      struct.member @result : index
      function.def @compute() -> !struct.type<@ExprOnlyStructNoList::@Value> {
        %result = poly.read_const @Result : index
        %self = struct.new : <@ExprOnlyStructNoList::@Value>
        struct.writem %self[@result] = %result : !struct.type<@ExprOnlyStructNoList::@Value>, index
        function.return %self : !struct.type<@ExprOnlyStructNoList::@Value>
      }
      function.def @constrain(%self: !struct.type<@ExprOnlyStructNoList::@Value>) {
        function.return
      }
    }
  }

  struct.def @Holder {
    struct.member @value : !struct.type<@ExprOnlyStructNoList::@Value>
    function.def @compute() -> !struct.type<@Holder> {
      %self = struct.new : <@Holder>
      %value = function.call @ExprOnlyStructNoList::@Value::@compute() : () -> !struct.type<@ExprOnlyStructNoList::@Value>
      struct.writem %self[@value] = %value : !struct.type<@Holder>, !struct.type<@ExprOnlyStructNoList::@Value>
      function.return %self : !struct.type<@Holder>
    }
    function.def @constrain(%self: !struct.type<@Holder>) {
      function.return
    }
  }
}

