// An explicit empty argument list exercises the same expression-only struct through the
// non-null ArrayAttr path that must not assert when the definition has no poly.param operations.
module attributes {llzk.lang, llzk.main = !struct.type<@ExprOnlyStructExplicit::@Value<[]>>} {
  poly.template @ExprOnlyStructExplicit {
    poly.expr @Result {
      %value = arith.constant 9 : index
      poly.yield %value : index
    }
    struct.def @Value {
      struct.member @result : index
      function.def @compute() -> !struct.type<@ExprOnlyStructExplicit::@Value> {
        %result = poly.read_const @Result : index
        %self = struct.new : <@ExprOnlyStructExplicit::@Value>
        struct.writem %self[@result] = %result : !struct.type<@ExprOnlyStructExplicit::@Value>, index
        function.return %self : !struct.type<@ExprOnlyStructExplicit::@Value>
      }
      function.def @constrain(%self: !struct.type<@ExprOnlyStructExplicit::@Value>) {
        function.return
      }
    }
  }

  struct.def @Holder {
    struct.member @value : !struct.type<@ExprOnlyStructExplicit::@Value<[]>>
    function.def @compute() -> !struct.type<@Holder> {
      %self = struct.new : <@Holder>
      %value = function.call @ExprOnlyStructExplicit::@Value::@compute() : () -> !struct.type<@ExprOnlyStructExplicit::@Value<[]>>
      struct.writem %self[@value] = %value : !struct.type<@Holder>, !struct.type<@ExprOnlyStructExplicit::@Value<[]>>
      function.return %self : !struct.type<@Holder>
    }
    function.def @constrain(%self: !struct.type<@Holder>) {
      function.return
    }
  }
}

