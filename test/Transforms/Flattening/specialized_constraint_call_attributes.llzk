// CHECK-NEXT:        "function.def"() <{function_type = (!array.type<@N x !felt.type>) -> !struct.type<@TCell::@Cell<[@N]>>, sym_name = "compute"}> ({
// CHECK-NEXT:        ^bb0(%[[VAL_4:[0-9a-zA-Z_.-]+]]: !array.type<@N x !felt.type>):
// CHECK-NEXT:          %[[VAL_5:[0-9a-zA-Z_.-]+]] = "struct.new"() : () -> !struct.type<@TCell::@Cell<[@N]>>
// CHECK-NEXT:          "function.return"(%[[VAL_5]]) : (!struct.type<@TCell::@Cell<[@N]>>) -> ()
// CHECK-NEXT:        }) {function.allow_witness} : () -> ()
// CHECK-NEXT:        "function.def"() <{function_type = (!struct.type<@TCell::@Cell<[@N]>>, !array.type<@N x !felt.type>) -> (), sym_name = "constrain"}> ({
