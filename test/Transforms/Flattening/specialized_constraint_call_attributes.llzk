// CHECK-NEXT:        }) {function.allow_constraint} : () -> ()
// CHECK-NEXT:      }) : () -> ()
// CHECK-NEXT:    }) : () -> ()
// CHECK-NEXT:    "function.def"() <{function_type = (!array.type<#[[$ATTR_0]] x !felt.type>) -> (), sym_name = "generic_constraint_signature"}> ({
// CHECK-NEXT:    ^bb0(%[[VAL_8:[0-9a-zA-Z_.-]+]]: !array.type<#[[$ATTR_0]] x !felt.type>):
// CHECK-NEXT:      %[[VAL_9:[0-9a-zA-Z_.-]+]] = "llzk.nondet"() : () -> !struct.type<@TCell::@Cell<[#[[$ATTR_0]]]>>
// CHECK-NEXT:      %[[VAL_10:[0-9a-zA-Z_.-]+]] = "llzk.nondet"() : () -> !struct.type<@TCell_0_Cell>
// CHECK-NEXT:      "function.call"(%[[VAL_10]], %[[VAL_8]]) <{arg_attrs = [{test.role = "witness"}, {test.role = "values"}], callee = @TCell_0_Cell::@constrain, mapOpGroupSizes = array<i32>, numDimsPerMap = array<i32>, operandSegmentSizes = array<i32: 2, 0>, res_attrs = []}> {product_source = "scalarized"} : (!struct.type<@TCell_0_Cell>, !array.type<#[[$ATTR_0]] x !felt.type>) -> ()
// CHECK-NEXT:      %[[VAL_11:[0-9a-zA-Z_.-]+]] = "llzk.nondet"() : () -> !struct.type<@TCell::@Cell<[#[[$ATTR_0]]]>>
