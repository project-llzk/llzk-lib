// CHECK-NEXT:      "function.def"() <{function_type = (!array.type<0 x !felt.type>) -> !struct.type<@TCell_0_Cell>, sym_name = "compute"}> ({
// CHECK-NEXT:      ^bb0(%[[VAL_0:[0-9a-zA-Z_.-]+]]: !array.type<0 x !felt.type>):
// CHECK-NEXT:        %[[VAL_1:[0-9a-zA-Z_.-]+]] = "struct.new"() : () -> !struct.type<@TCell_0_Cell>
// CHECK-NEXT:        "function.return"(%[[VAL_1]]) : (!struct.type<@TCell_0_Cell>) -> ()
// CHECK-NEXT:      }) {function.allow_witness} : () -> ()
// CHECK-NEXT:      "function.def"() <{function_type = (!struct.type<@TCell_0_Cell>, !array.type<0 x !felt.type>) -> (), sym_name = "constrain"}> ({
// CHECK-NEXT:      ^bb0(%[[VAL_2:[0-9a-zA-Z_.-]+]]: !struct.type<@TCell_0_Cell>, %[[VAL_3:[0-9a-zA-Z_.-]+]]: !array.type<0 x !felt.type>):
// CHECK-NEXT:        "function.return"() : () -> ()
