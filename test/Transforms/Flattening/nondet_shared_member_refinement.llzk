// A symbolic dimension can remain unifiable without an integer/affine common refinement.
#id = affine_map<(i) -> (i)>
module attributes {llzk.lang} {
  poly.template @TPair {
    poly.param @A : index
    poly.param @B : index
    struct.def @Pair {
      struct.member @value : !felt.type {column}
      function.def @compute() -> !struct.type<@TPair::@Pair<[@A, @B]>> {
        %self = struct.new : !struct.type<@TPair::@Pair<[@A, @B]>>
        function.return %self : !struct.type<@TPair::@Pair<[@A, @B]>>
      }
      function.def @constrain(%self: !struct.type<@TPair::@Pair<[@A, @B]>>) { function.return }
    }
  }
  poly.template @Outer {
    poly.param @N : index
    struct.def @Holder {
      struct.member @first : !struct.type<@TPair::@Pair<[0, @N]>> {column}
      struct.member @second : !struct.type<@TPair::@Pair<[0, @N]>> {column}
      function.def @compute() -> !struct.type<@Outer::@Holder<[@N]>> {
        %self = struct.new : !struct.type<@Outer::@Holder<[@N]>>
        %shared = llzk.nondet : !struct.type<@TPair::@Pair<[0, #id]>> {product_source = "shared", test.marker = 42 : i64}
        struct.writem %self[@first] = %shared : !struct.type<@Outer::@Holder<[@N]>>, !struct.type<@TPair::@Pair<[0, #id]>>
        struct.writem %self[@second] = %shared : !struct.type<@Outer::@Holder<[@N]>>, !struct.type<@TPair::@Pair<[0, #id]>>
        function.return %self : !struct.type<@Outer::@Holder<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@Outer::@Holder<[@N]>>) { function.return }
    }
  }
}

