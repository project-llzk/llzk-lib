// Unresolved type-valued parameters remain valid when no concrete conflict is known.
module attributes {llzk.lang} {
  poly.template @TPair {
    poly.param @A
    poly.param @B
    struct.def @Pair {
      struct.member @value : !felt.type {column}
      function.def @compute() -> !struct.type<@TPair::@Pair<[@A, @B]>> {
        %self = struct.new : !struct.type<@TPair::@Pair<[@A, @B]>>
        function.return %self : !struct.type<@TPair::@Pair<[@A, @B]>>
      }
      function.def @constrain(%self: !struct.type<@TPair::@Pair<[@A, @B]>>) { function.return }
    }
  }
  poly.template @Outer {
    poly.param @N
    poly.param @M
    poly.param @U
    struct.def @Holder {
      struct.member @first : !struct.type<@TPair::@Pair<[!poly.tvar<@M>, !poly.tvar<@U>]>> {column}
      struct.member @second : !struct.type<@TPair::@Pair<[!poly.tvar<@M>, !poly.tvar<@U>]>> {column}
      function.def @compute() -> !struct.type<@Outer::@Holder<[@N, @M, @U]>> {
        %self = struct.new : !struct.type<@Outer::@Holder<[@N, @M, @U]>>
        %shared = llzk.nondet : !struct.type<@TPair::@Pair<[!poly.tvar<@N>, !poly.tvar<@U>]>> {product_source = "shared", test.marker = 42 : i64}
        struct.writem %self[@first] = %shared : !struct.type<@Outer::@Holder<[@N, @M, @U]>>, !struct.type<@TPair::@Pair<[!poly.tvar<@N>, !poly.tvar<@U>]>>
        struct.writem %self[@second] = %shared : !struct.type<@Outer::@Holder<[@N, @M, @U]>>, !struct.type<@TPair::@Pair<[!poly.tvar<@N>, !poly.tvar<@U>]>>
        function.return %self : !struct.type<@Outer::@Holder<[@N, @M, @U]>>
      }
      function.def @constrain(%self: !struct.type<@Outer::@Holder<[@N, @M, @U]>>) { function.return }
    }
  }
}

