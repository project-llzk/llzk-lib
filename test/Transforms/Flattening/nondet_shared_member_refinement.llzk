// All three member requirements contribute to one common witness refinement.
#id = affine_map<(i) -> (i)>
module attributes {llzk.lang} {
  poly.template @TPair {
    poly.param @A : index
    poly.param @B : index
    poly.param @C : index
    poly.param @D : index
    struct.def @Pair {
      struct.member @value : !felt.type {column}
      function.def @compute() -> !struct.type<@TPair::@Pair<[@A, @B, @C, @D]>> {
        %self = struct.new : !struct.type<@TPair::@Pair<[@A, @B, @C, @D]>>
        function.return %self : !struct.type<@TPair::@Pair<[@A, @B, @C, @D]>>
      }
      function.def @constrain(%self: !struct.type<@TPair::@Pair<[@A, @B, @C, @D]>>) { function.return }
    }
  }
  struct.def @Holder {
    struct.member @first : !struct.type<@TPair::@Pair<[#id, 1, #id, #id]>> {column}
    struct.member @second : !struct.type<@TPair::@Pair<[#id, #id, 2, #id]>> {column}
    struct.member @third : !struct.type<@TPair::@Pair<[#id, #id, #id, 3]>> {column}
    function.def @compute() -> !struct.type<@Holder> {
      %self = struct.new : !struct.type<@Holder>
      %shared = llzk.nondet : !struct.type<@TPair::@Pair<[0, #id, #id, #id]>> {product_source = "shared", test.marker = 42 : i64}
      struct.writem %self[@first] = %shared : !struct.type<@Holder>, !struct.type<@TPair::@Pair<[0, #id, #id, #id]>>
      struct.writem %self[@second] = %shared : !struct.type<@Holder>, !struct.type<@TPair::@Pair<[0, #id, #id, #id]>>
      struct.writem %self[@third] = %shared : !struct.type<@Holder>, !struct.type<@TPair::@Pair<[0, #id, #id, #id]>>
      function.return %self : !struct.type<@Holder>
    }
    function.def @constrain(%self: !struct.type<@Holder>) { function.return }
  }
}

