// CHECK-SAME:                               %[[VAL_0:[0-9a-zA-Z_\.]+]]: !felt.type<"babybear">,
// CHECK-SAME:                               %[[VAL_1:[0-9a-zA-Z_\.]+]]: !felt.type<"babybear">,
// CHECK-SAME:                               %[[VAL_2:[0-9a-zA-Z_\.]+]]: i1) -> !felt.type<"babybear"> {
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = felt.add %[[VAL_0]], %[[VAL_1]] : !felt.type<"babybear">, !felt.type<"babybear">
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = felt.add %[[VAL_3]], %[[VAL_1]] : !felt.type<"babybear">, !felt.type<"babybear">
// CHECK-NEXT:      %[[VAL_5:[0-9a-zA-Z_\.]+]] = felt.add %[[VAL_4]], %[[VAL_1]] : !felt.type<"babybear">, !felt.type<"babybear">
// CHECK-NEXT:      function.return %[[VAL_5]] : !felt.type<"babybear">
// CHECK-NEXT:    }

  // Nested annotated loops preserve captures of their containing regions' arguments.
  function.def @nested(%seed: index, %cond: i1) -> index {
    %result = scf.while (%outer = %seed) : (index) -> index {
      scf.condition(%cond) %outer : index
    } do {
    ^bb0(%outer: index):
      %inner_result = scf.while (%inner = %outer) : (index) -> index {
        scf.condition(%cond) %inner : index
      } do {
      ^bb1(%inner: index):
        %next = arith.addi %inner, %outer : index
        scf.yield %next : index
      } attributes {llzk.loopbounds = #llzk.loopbounds<0 to 2 step 1>}
      scf.yield %inner_result : index
    } attributes {llzk.loopbounds = #llzk.loopbounds<0 to 2 step 1>}
    function.return %result : index
  }
