// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = arith.addi %[[VAL_2]], %[[VAL_0]] : index
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = arith.addi %[[VAL_3]], %[[VAL_3]] : index
// CHECK-NEXT:      %[[VAL_5:[0-9a-zA-Z_\.]+]] = arith.addi %[[VAL_4]], %[[VAL_3]] : index
// CHECK-NEXT:      function.return %[[VAL_5]] : index
// CHECK-NEXT:    }

  // Even when no body executes, result types need not match the initial-value types.
  function.def @zero_different_types(%seed: index) -> !felt.type<"babybear"> {
    %false = arith.constant false
    %result = scf.while (%state = %seed) : (index) -> !felt.type<"babybear"> {
      %felt = cast.tofelt %state : index, !felt.type<"babybear">
      scf.condition(%false) %felt : !felt.type<"babybear">
    } do {
    ^bb0(%checked: !felt.type<"babybear">):
      scf.yield %seed : index
    } attributes {llzk.loopbounds = #llzk.loopbounds<0 to 0 step 1>}
    function.return %result : !felt.type<"babybear">
  }
