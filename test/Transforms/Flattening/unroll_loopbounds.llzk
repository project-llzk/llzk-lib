// CHECK-SAME:                                       %[[VAL_0:[0-9a-zA-Z_\.]+]]: index) -> !felt.type<"babybear"> {
// CHECK-NEXT:      %[[VAL_1:[0-9a-zA-Z_\.]+]] = cast.tofelt %[[VAL_0]] : index, !felt.type<"babybear">
// CHECK-NEXT:      function.return %[[VAL_1]] : !felt.type<"babybear">
// CHECK-NEXT:    }

  // Without an annotation, the while loop remains rolled.
  function.def @unannotated(%seed: index, %cond: i1) -> index {
    %one = arith.constant 1 : index
    %result = scf.while (%state = %seed) : (index) -> index {
      scf.condition(%cond) %state : index
    } do {
    ^bb0(%state: index):
      %next = arith.addi %state, %one : index
      scf.yield %next : index
    }
    function.return %result : index
  }
