// RUN: llzk-opt -llzk-flatten %s | FileCheck %s
// RUN: llzk-opt -llzk-flatten %s | llzk-opt -llzk-flatten | FileCheck %s

// A partial family uses root-relative names inside Lib and qualified names at an outer call.
module attributes {llzk.lang} {
  module @Lib attributes {llzk.lang} {
    poly.template @Pair {
      poly.param @A
      poly.param @B
      struct.def @Pair {
        struct.member @first : !poly.tvar<@A>
        struct.member @second : !poly.tvar<@B>
        function.def @compute() -> !struct.type<@Pair::@Pair<[@A, @B]>> {
          %self = struct.new : !struct.type<@Pair::@Pair<[@A, @B]>>
          function.return %self : !struct.type<@Pair::@Pair<[@A, @B]>>
        }
        function.def @constrain(%self: !struct.type<@Pair::@Pair<[@A, @B]>>) { function.return }
      }
    }
    poly.template @RepeatedStructIdentity {
      poly.param @T
      struct.def @Holder {
        struct.member @pair : !struct.type<@Pair::@Pair<[@T, @T]>>
        function.def @compute(%input: !struct.type<@Pair::@Pair<[@T, !felt.type]>>) -> !struct.type<@RepeatedStructIdentity::@Holder<[@T]>> {
          %self = struct.new : !struct.type<@RepeatedStructIdentity::@Holder<[@T]>>
          struct.writem %self[@pair] = %input : !struct.type<@RepeatedStructIdentity::@Holder<[@T]>>, !struct.type<@Pair::@Pair<[@T, !felt.type]>>
          function.return %self : !struct.type<@RepeatedStructIdentity::@Holder<[@T]>>
        }
        function.def @constrain(%self: !struct.type<@RepeatedStructIdentity::@Holder<[@T]>>, %input: !struct.type<@Pair::@Pair<[@T, !felt.type]>>) { function.return }
      }
    }
  }

  poly.template @Client {
    poly.param @T
    function.def @forward(%input: !struct.type<@Lib::@Pair::@Pair<[@T, !felt.type]>>) -> !struct.type<@Lib::@RepeatedStructIdentity::@Holder<[@T]>> attributes {function.allow_witness} {
      %self = function.call @Lib::@RepeatedStructIdentity::@Holder::@compute(%input) : (!struct.type<@Lib::@Pair::@Pair<[@T, !felt.type]>>) -> !struct.type<@Lib::@RepeatedStructIdentity::@Holder<[@T]>>
      function.return %self : !struct.type<@Lib::@RepeatedStructIdentity::@Holder<[@T]>>
    }
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    module @Lib attributes {llzk.lang} {
// CHECK-NEXT:      poly.template @Pair {
// CHECK-NEXT:        poly.param @A
// CHECK-NEXT:        poly.param @B
// CHECK-NEXT:        struct.def @Pair {
// CHECK-NEXT:          struct.member @first : !poly.tvar<@A>
// CHECK-NEXT:          struct.member @second : !poly.tvar<@B>
// CHECK-NEXT:          function.def @compute() -> !struct.type<@Pair::@Pair<[@A, @B]>> attributes {function.allow_witness} {
// CHECK-NEXT:            %[[VAL_0:[0-9a-zA-Z_.-]+]] = struct.new : <@Pair::@Pair<[@A, @B]>>
// CHECK-NEXT:            function.return %[[VAL_0]] : !struct.type<@Pair::@Pair<[@A, @B]>>
// CHECK-NEXT:          }
// CHECK-NEXT:          function.def @constrain(%[[VAL_1:[0-9a-zA-Z_.-]+]]: !struct.type<@Pair::@Pair<[@A, @B]>>) attributes {function.allow_constraint} {
// CHECK-NEXT:            function.return
// CHECK-NEXT:          }
// CHECK-NEXT:        }
// CHECK-NEXT:      }
// CHECK-NEXT:      poly.template @RepeatedStructIdentity {
// CHECK-NEXT:        poly.param @T
// CHECK-NEXT:        struct.def @Holder {
// CHECK-NEXT:          struct.member @pair : !struct.type<@Pair::@Pair<[@T, @T]>>
// CHECK-NEXT:          function.def @compute(%[[VAL_2:[0-9a-zA-Z_.-]+]]: !struct.type<@Pair::@Pair<[@T, !felt.type]>>) -> !struct.type<@RepeatedStructIdentity::@Holder<[@T]>> attributes {function.allow_witness} {
// CHECK-NEXT:            %[[VAL_3:[0-9a-zA-Z_.-]+]] = struct.new : <@RepeatedStructIdentity::@Holder<[@T]>>
// CHECK-NEXT:            struct.writem %[[VAL_3]][@pair] = %[[VAL_2]] : <@RepeatedStructIdentity::@Holder<[@T]>>, !struct.type<@Pair::@Pair<[@T, !felt.type]>>
// CHECK-NEXT:            function.return %[[VAL_3]] : !struct.type<@RepeatedStructIdentity::@Holder<[@T]>>
// CHECK-NEXT:          }
// CHECK-NEXT:          function.def @constrain(%[[VAL_4:[0-9a-zA-Z_.-]+]]: !struct.type<@RepeatedStructIdentity::@Holder<[@T]>>, %[[VAL_5:[0-9a-zA-Z_.-]+]]: !struct.type<@Pair::@Pair<[@T, !felt.type]>>) attributes {function.allow_constraint} {
// CHECK-NEXT:            function.return
// CHECK-NEXT:          }
// CHECK-NEXT:        }
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    poly.template @Client {
// CHECK-NEXT:      poly.param @T
// CHECK-NEXT:      function.def @forward(%[[VAL_6:[0-9a-zA-Z_.-]+]]: !struct.type<@Lib::@Pair::@Pair<[@T, !felt.type]>>) -> !struct.type<@Lib::@RepeatedStructIdentity::@Holder<[@T]>> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_7:[0-9a-zA-Z_.-]+]] = function.call @Lib::@RepeatedStructIdentity::@Holder::@compute(%[[VAL_6]]) : (!struct.type<@Lib::@Pair::@Pair<[@T, !felt.type]>>) -> !struct.type<@Lib::@RepeatedStructIdentity::@Holder<[@T]>>
// CHECK-NEXT:        function.return %[[VAL_7]] : !struct.type<@Lib::@RepeatedStructIdentity::@Holder<[@T]>>
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }
