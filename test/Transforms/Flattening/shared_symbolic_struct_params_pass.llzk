// An unrelated symbolic integer argument must not block the shared type binding.
module attributes {llzk.lang} {
  poly.template @NumericBox {
    poly.param @N : index
    poly.param @X
    struct.def @NumericBox {
      struct.member @values : !array.type<@N x !poly.tvar<@X>>
      function.def @compute() -> !struct.type<@NumericBox::@NumericBox<[@N, @X]>> {
        %self = struct.new : !struct.type<@NumericBox::@NumericBox<[@N, @X]>>
        function.return %self : !struct.type<@NumericBox::@NumericBox<[@N, @X]>>
      }
      function.def @constrain(%self: !struct.type<@NumericBox::@NumericBox<[@N, @X]>>) { function.return }
    }
  }
  poly.template @NumericSymbol {
    poly.param @T
    poly.param @N : index
    poly.param @V
    struct.def @Holder {
      struct.member @first : !poly.tvar<@T>
      struct.member @second : !struct.type<@NumericBox::@NumericBox<[@N, @T]>>
      struct.member @source : !struct.type<@NumericBox::@NumericBox<[@N, !felt.type]>>
      function.def @compute(%a: !felt.type) -> !struct.type<@NumericSymbol::@Holder<[@T, @N, @V]>> {
        %self = struct.new : !struct.type<@NumericSymbol::@Holder<[@T, @N, @V]>>
        struct.writem %self[@first] = %a : !struct.type<@NumericSymbol::@Holder<[@T, @N, @V]>>, !felt.type
        %b = struct.readm %self[@source] : !struct.type<@NumericSymbol::@Holder<[@T, @N, @V]>>, !struct.type<@NumericBox::@NumericBox<[@N, !felt.type]>>
        struct.writem %self[@second] = %b : !struct.type<@NumericSymbol::@Holder<[@T, @N, @V]>>, !struct.type<@NumericBox::@NumericBox<[@N, !felt.type]>>
        function.return %self : !struct.type<@NumericSymbol::@Holder<[@T, @N, @V]>>
      }
      function.def @constrain(%self: !struct.type<@NumericSymbol::@Holder<[@T, @N, @V]>>, %a: !felt.type) {
        function.return
      }
    }
  }
}

