// A type-valued symbolic argument must preserve the same binding as a bare symbol.
module attributes {llzk.lang} {
  poly.template @Box {
    poly.param @X
    struct.def @Box {
      struct.member @value : !poly.tvar<@X>
      function.def @compute() -> !struct.type<@Box::@Box<[@X]>> {
        %self = struct.new : !struct.type<@Box::@Box<[@X]>>
        function.return %self : !struct.type<@Box::@Box<[@X]>>
      }
      function.def @constrain(%self: !struct.type<@Box::@Box<[@X]>>) { function.return }
    }
  }
  poly.template @WrittenTypedSymbol {
    poly.param @T
    poly.param @U
    poly.param @V
    struct.def @Holder {
      struct.member @first : !poly.tvar<@T>
      struct.member @second : !struct.type<@Box::@Box<[@T]>>
      struct.member @source : !struct.type<@Box::@Box<[!poly.tvar<@V>]>>
      function.def @compute(%a: !felt.type) -> !struct.type<@WrittenTypedSymbol::@Holder<[@T, @U, @V]>> {
        %self = struct.new : !struct.type<@WrittenTypedSymbol::@Holder<[@T, @U, @V]>>
        struct.writem %self[@first] = %a : !struct.type<@WrittenTypedSymbol::@Holder<[@T, @U, @V]>>, !felt.type
        %b = struct.readm %self[@source] : !struct.type<@WrittenTypedSymbol::@Holder<[@T, @U, @V]>>, !struct.type<@Box::@Box<[!poly.tvar<@V>]>>
        struct.writem %self[@second] = %b : !struct.type<@WrittenTypedSymbol::@Holder<[@T, @U, @V]>>, !struct.type<@Box::@Box<[!poly.tvar<@V>]>>
        function.return %self : !struct.type<@WrittenTypedSymbol::@Holder<[@T, @U, @V]>>
      }
      function.def @constrain(%self: !struct.type<@WrittenTypedSymbol::@Holder<[@T, @U, @V]>>, %a: !felt.type) {
        function.return
      }
    }
  }
}

