// An unrelated symbolic struct argument must not block this member refinement.
module attributes {llzk.lang} {
  poly.template @Box {
    poly.param @X
    struct.def @Box {
      struct.member @value : !poly.tvar<@X>
      function.def @compute() -> !struct.type<@Box::@Box<[@X]>> {
        %self = struct.new : !struct.type<@Box::@Box<[@X]>>
        function.return %self : !struct.type<@Box::@Box<[@X]>>
      }
      function.def @constrain(%self: !struct.type<@Box::@Box<[@X]>>) { function.return }
    }
  }
  poly.template @UnrelatedBareSymbol {
    poly.param @T
    poly.param @U
    poly.param @V
    struct.def @Holder {
      struct.member @first : !poly.tvar<@T>
      struct.member @second : !struct.type<@Box::@Box<[@U]>>
      struct.member @source : !struct.type<@Box::@Box<[@V]>>
      function.def @compute(%a: !felt.type) -> !struct.type<@UnrelatedBareSymbol::@Holder<[@T, @U, @V]>> {
        %self = struct.new : !struct.type<@UnrelatedBareSymbol::@Holder<[@T, @U, @V]>>
        struct.writem %self[@first] = %a : !struct.type<@UnrelatedBareSymbol::@Holder<[@T, @U, @V]>>, !felt.type
        %b = struct.readm %self[@source] : !struct.type<@UnrelatedBareSymbol::@Holder<[@T, @U, @V]>>, !struct.type<@Box::@Box<[@V]>>
        struct.writem %self[@second] = %b : !struct.type<@UnrelatedBareSymbol::@Holder<[@T, @U, @V]>>, !struct.type<@Box::@Box<[@V]>>
        function.return %self : !struct.type<@UnrelatedBareSymbol::@Holder<[@T, @U, @V]>>
      }
      function.def @constrain(%self: !struct.type<@UnrelatedBareSymbol::@Holder<[@T, @U, @V]>>, %a: !felt.type) {
        function.return
      }
    }
  }
}

