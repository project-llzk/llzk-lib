// RUN: llzk-opt -llzk-flatten -verify-diagnostics %s | FileCheck --enable-var-scope %s

// Regression test: the flattening type converter must recursively instantiate
// parameterized struct types stored in POD records, including PODs produced by
// llzk.nondet.
module attributes {llzk.lang} {
  poly.template @TComponent {
    poly.param @N : index
    struct.def @Component {
      function.def @compute() -> !struct.type<@TComponent::@Component<[@N]>> {
        %self = struct.new : !struct.type<@TComponent::@Component<[@N]>>
        function.return %self : !struct.type<@TComponent::@Component<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@TComponent::@Component<[@N]>>) {
        function.return
      }
    }
  }

  struct.def @Main {
    function.def @compute() -> !struct.type<@Main> {
      %pod = llzk.nondet : !pod.type<[@comp: !struct.type<@TComponent::@Component<[252]>>]>
      %component = function.call @TComponent::@Component::@compute() : () -> !struct.type<@TComponent::@Component<[252]>>
      pod.write %pod[@comp] = %component : !pod.type<[@comp: !struct.type<@TComponent::@Component<[252]>>]>, !struct.type<@TComponent::@Component<[252]>>
      %self = struct.new : !struct.type<@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>) {
      function.return
    }
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    struct.def @TComponent_252_Component {
// CHECK-NEXT:      function.def @compute() -> !struct.type<@TComponent_252_Component> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_0:[0-9a-zA-Z_\.]+]] = struct.new : <@TComponent_252_Component>
// CHECK-NEXT:        function.return %[[VAL_0]] : !struct.type<@TComponent_252_Component>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_1:[0-9a-zA-Z_\.]+]]: !struct.type<@TComponent_252_Component>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    struct.def @Main {
// CHECK-NEXT:      function.def @compute() -> !struct.type<@Main> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_2:[0-9a-zA-Z_\.]+]] = llzk.nondet : !pod.type<[@comp: !struct.type<@TComponent_252_Component>]>
// CHECK-NEXT:        %[[VAL_3:[0-9a-zA-Z_\.]+]] = function.call @TComponent_252_Component::@compute() : () -> !struct.type<@TComponent_252_Component>
// CHECK-NEXT:        pod.write %[[VAL_2]][@comp] = %[[VAL_3]] : <[@comp: !struct.type<@TComponent_252_Component>]>, !struct.type<@TComponent_252_Component>
// CHECK-NEXT:        %[[VAL_4:[0-9a-zA-Z_\.]+]] = struct.new : <@Main>
// CHECK-NEXT:        function.return %[[VAL_4]] : !struct.type<@Main>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_5:[0-9a-zA-Z_\.]+]]: !struct.type<@Main>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }
