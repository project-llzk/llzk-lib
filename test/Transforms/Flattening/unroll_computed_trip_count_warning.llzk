// RUN: llzk-opt -split-input-file -llzk-flatten -verify-diagnostics %s | FileCheck --enable-var-scope %s

// Computed trip-count overflow warns and preserves the loop, just like annotated overflow.
module attributes {llzk.lang} {
  function.def @signed_trip_count_overflow(%a: !felt.type, %b: !felt.type) attributes {function.allow_constraint} {
    %zero = arith.constant 0 : i128
    %bound = arith.constant 18446744073709551616 : i128
    %one = arith.constant 1 : i128
    // expected-warning @+1 {{computed loop trip count does not fit in uint64_t}}
    scf.for %iv = %zero to %bound step %one : i128 {
      constrain.eq %a, %b : !felt.type, !felt.type
    }
    function.return
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @signed_trip_count_overflow(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !felt.type, %[[VAL_1:[0-9a-zA-Z_\.]+]]: !felt.type) attributes {function.allow_constraint} {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = arith.constant 0 : i128
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = arith.constant 18446744073709551616 : i128
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = arith.constant 1 : i128
// CHECK-NEXT:      scf.for %[[VAL_5:[0-9a-zA-Z_\.]+]] = %[[VAL_2]] to %[[VAL_3]] step %[[VAL_4]]  : i128 {
// CHECK-NEXT:        constrain.eq %[[VAL_0]], %[[VAL_1]] : !felt.type, !felt.type
// CHECK-NEXT:      }
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

module attributes {llzk.lang} {
  function.def @unsigned_trip_count_overflow(%a: !felt.type, %b: !felt.type) attributes {function.allow_constraint} {
    %zero = arith.constant 0 : i128
    %bound = arith.constant 18446744073709551616 : i128
    %one = arith.constant 1 : i128
    // expected-warning @+1 {{computed loop trip count does not fit in uint64_t}}
    scf.for unsigned %iv = %zero to %bound step %one : i128 {
      constrain.eq %a, %b : !felt.type, !felt.type
    }
    function.return
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @unsigned_trip_count_overflow(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !felt.type, %[[VAL_1:[0-9a-zA-Z_\.]+]]: !felt.type) attributes {function.allow_constraint} {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = arith.constant 0 : i128
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = arith.constant 18446744073709551616 : i128
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = arith.constant 1 : i128
// CHECK-NEXT:      scf.for unsigned %[[VAL_5:[0-9a-zA-Z_\.]+]] = %[[VAL_2]] to %[[VAL_3]] step %[[VAL_4]]  : i128 {
// CHECK-NEXT:        constrain.eq %[[VAL_0]], %[[VAL_1]] : !felt.type, !felt.type
// CHECK-NEXT:      }
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

// A wide induction type alone is not overflow: UINT64_MAX fits and is subject
// to the ordinary expansion limit instead.
module attributes {llzk.lang} {
  function.def @trip_count_fits_uint64(%a: !felt.type, %b: !felt.type) attributes {function.allow_constraint} {
    %zero = arith.constant 0 : i128
    %bound = arith.constant 18446744073709551615 : i128
    %one = arith.constant 1 : i128
    // expected-warning @+1 {{loop trip count 18446744073709551615 exceeds max-unroll limit of 10000}}
    scf.for %iv = %zero to %bound step %one : i128 {
      constrain.eq %a, %b : !felt.type, !felt.type
    }
    function.return
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @trip_count_fits_uint64(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !felt.type, %[[VAL_1:[0-9a-zA-Z_\.]+]]: !felt.type) attributes {function.allow_constraint} {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = arith.constant 0 : i128
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = arith.constant 18446744073709551615 : i128
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = arith.constant 1 : i128
// CHECK-NEXT:      scf.for %[[VAL_5:[0-9a-zA-Z_\.]+]] = %[[VAL_2]] to %[[VAL_3]] step %[[VAL_4]]  : i128 {
// CHECK-NEXT:        constrain.eq %[[VAL_0]], %[[VAL_1]] : !felt.type, !felt.type
// CHECK-NEXT:      }
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:  }
