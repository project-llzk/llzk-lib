// RUN: llzk-opt -split-input-file -llzk-flatten %s | FileCheck %s

// A compatible insert must compare the complete refined read with the selected destination.
#id = affine_map<(i) -> (i)>
module attributes {llzk.lang} {
  poly.template @TCellOneIndex {
    poly.param @N : index
    struct.def @Cell {
      struct.member @value : !felt.type {column}
      function.def @compute() -> !struct.type<@TCellOneIndex::@Cell<[@N]>> {
        %self = struct.new : !struct.type<@TCellOneIndex::@Cell<[@N]>>
        function.return %self : !struct.type<@TCellOneIndex::@Cell<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@TCellOneIndex::@Cell<[@N]>>) {
        function.return
      }
    }
  }
  struct.def @HolderOneIndex {
    struct.member @row : !array.type<3 x !struct.type<@TCellOneIndex::@Cell<[#id]>>> {column}
    struct.member @grid : !array.type<2,3 x !struct.type<@TCellOneIndex::@Cell<[0]>>> {column}
    function.def @compute() -> !struct.type<@HolderOneIndex> {
      %self = struct.new : !struct.type<@HolderOneIndex>
      %index = arith.constant 0 : index
      %item0 = function.call @TCellOneIndex::@Cell::@compute() : () -> !struct.type<@TCellOneIndex::@Cell<[0]>>
      %row0 = array.new %item0, %item0, %item0 : !array.type<3 x !struct.type<@TCellOneIndex::@Cell<[0]>>>
      struct.writem %self[@row] = %row0 : !struct.type<@HolderOneIndex>, !array.type<3 x !struct.type<@TCellOneIndex::@Cell<[0]>>>
      %read = struct.readm %self[@row] : !struct.type<@HolderOneIndex>, !array.type<3 x !struct.type<@TCellOneIndex::@Cell<[#id]>>>
      %destination = array.new : !array.type<2,3 x !struct.type<@TCellOneIndex::@Cell<[0]>>>
      array.insert %destination[%index] = %read : !array.type<2,3 x !struct.type<@TCellOneIndex::@Cell<[0]>>>, !array.type<3 x !struct.type<@TCellOneIndex::@Cell<[#id]>>>
      struct.writem %self[@grid] = %destination : !struct.type<@HolderOneIndex>, !array.type<2,3 x !struct.type<@TCellOneIndex::@Cell<[0]>>>
      function.return %self : !struct.type<@HolderOneIndex>
    }
    function.def @constrain(%self: !struct.type<@HolderOneIndex>) {
      function.return
    }
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    struct.def @TCellOneIndex_0_Cell {
// CHECK-NEXT:      struct.member @value : !felt.type {column}
// CHECK-NEXT:      function.def @compute() -> !struct.type<@TCellOneIndex_0_Cell> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_0:[0-9a-zA-Z_.-]+]] = struct.new : <@TCellOneIndex_0_Cell>
// CHECK-NEXT:        function.return %[[VAL_0]] : !struct.type<@TCellOneIndex_0_Cell>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_1:[0-9a-zA-Z_.-]+]]: !struct.type<@TCellOneIndex_0_Cell>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    struct.def @HolderOneIndex {
// CHECK-NEXT:      struct.member @row : !array.type<3 x !struct.type<@TCellOneIndex_0_Cell>> {column}
// CHECK-NEXT:      struct.member @grid : !array.type<2,3 x !struct.type<@TCellOneIndex_0_Cell>> {column}
// CHECK-NEXT:      function.def @compute() -> !struct.type<@HolderOneIndex> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_2:[0-9a-zA-Z_.-]+]] = arith.constant 0 : index
// CHECK-NEXT:        %[[VAL_3:[0-9a-zA-Z_.-]+]] = struct.new : <@HolderOneIndex>
// CHECK-NEXT:        %[[VAL_4:[0-9a-zA-Z_.-]+]] = function.call @TCellOneIndex_0_Cell::@compute() : () -> !struct.type<@TCellOneIndex_0_Cell>
// CHECK-NEXT:        %[[VAL_5:[0-9a-zA-Z_.-]+]] = array.new %[[VAL_4]], %[[VAL_4]], %[[VAL_4]] : <3 x !struct.type<@TCellOneIndex_0_Cell>>
// CHECK-NEXT:        struct.writem %[[VAL_3]][@row] = %[[VAL_5]] : <@HolderOneIndex>, !array.type<3 x !struct.type<@TCellOneIndex_0_Cell>>
// CHECK-NEXT:        %[[VAL_6:[0-9a-zA-Z_.-]+]] = struct.readm %[[VAL_3]][@row] : <@HolderOneIndex>, !array.type<3 x !struct.type<@TCellOneIndex_0_Cell>>
// CHECK-NEXT:        %[[VAL_7:[0-9a-zA-Z_.-]+]] = array.new  : <2,3 x !struct.type<@TCellOneIndex_0_Cell>>
// CHECK-NEXT:        array.insert %[[VAL_7]]{{\[}}%[[VAL_2]]] = %[[VAL_6]] : <2,3 x !struct.type<@TCellOneIndex_0_Cell>>, <3 x !struct.type<@TCellOneIndex_0_Cell>>
// CHECK-NEXT:        struct.writem %[[VAL_3]][@grid] = %[[VAL_7]] : <@HolderOneIndex>, !array.type<2,3 x !struct.type<@TCellOneIndex_0_Cell>>
// CHECK-NEXT:        function.return %[[VAL_3]] : !struct.type<@HolderOneIndex>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_8:[0-9a-zA-Z_.-]+]]: !struct.type<@HolderOneIndex>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

// Multiple insertion indices select only destination dimensions; preserve both read dimensions.
#id = affine_map<(i) -> (i)>
module attributes {llzk.lang} {
  poly.template @TCellTwoIndices {
    poly.param @N : index
    struct.def @Cell {
      struct.member @value : !felt.type {column}
      function.def @compute() -> !struct.type<@TCellTwoIndices::@Cell<[@N]>> {
        %self = struct.new : !struct.type<@TCellTwoIndices::@Cell<[@N]>>
        function.return %self : !struct.type<@TCellTwoIndices::@Cell<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@TCellTwoIndices::@Cell<[@N]>>) {
        function.return
      }
    }
  }
  struct.def @HolderTwoIndices {
    struct.member @row : !array.type<2,3 x !struct.type<@TCellTwoIndices::@Cell<[#id]>>> {column}
    struct.member @grid : !array.type<1,1,2,3 x !struct.type<@TCellTwoIndices::@Cell<[0]>>> {column}
    function.def @compute() -> !struct.type<@HolderTwoIndices> {
      %self = struct.new : !struct.type<@HolderTwoIndices>
      %index = arith.constant 0 : index
      %item0 = function.call @TCellTwoIndices::@Cell::@compute() : () -> !struct.type<@TCellTwoIndices::@Cell<[0]>>
      %row0 = array.new %item0, %item0, %item0, %item0, %item0, %item0 : !array.type<2,3 x !struct.type<@TCellTwoIndices::@Cell<[0]>>>
      struct.writem %self[@row] = %row0 : !struct.type<@HolderTwoIndices>, !array.type<2,3 x !struct.type<@TCellTwoIndices::@Cell<[0]>>>
      %read = struct.readm %self[@row] : !struct.type<@HolderTwoIndices>, !array.type<2,3 x !struct.type<@TCellTwoIndices::@Cell<[#id]>>>
      %destination = array.new : !array.type<1,1,2,3 x !struct.type<@TCellTwoIndices::@Cell<[0]>>>
      array.insert %destination[%index, %index] = %read : !array.type<1,1,2,3 x !struct.type<@TCellTwoIndices::@Cell<[0]>>>, !array.type<2,3 x !struct.type<@TCellTwoIndices::@Cell<[#id]>>>
      struct.writem %self[@grid] = %destination : !struct.type<@HolderTwoIndices>, !array.type<1,1,2,3 x !struct.type<@TCellTwoIndices::@Cell<[0]>>>
      function.return %self : !struct.type<@HolderTwoIndices>
    }
    function.def @constrain(%self: !struct.type<@HolderTwoIndices>) {
      function.return
    }
  }
}
