// CHECK-NEXT:      struct.member @grid : !array.type<2,4 x !felt.type> {column}
// CHECK-NEXT:      function.def @compute() -> !struct.type<@HolderIncompatibleShape> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_0:[0-9a-zA-Z_.-]+]] = arith.constant 0 : index
// CHECK-NEXT:        %[[VAL_1:[0-9a-zA-Z_.-]+]] = struct.new : <@HolderIncompatibleShape>
// CHECK-NEXT:        %[[VAL_2:[0-9a-zA-Z_.-]+]] = array.new  : <3 x !felt.type>
// CHECK-NEXT:        struct.writem %[[VAL_1]][@row] = %[[VAL_2]] : <@HolderIncompatibleShape>, !array.type<3 x !felt.type>
// CHECK-NEXT:        %[[VAL_3:[0-9a-zA-Z_.-]+]] = struct.readm %[[VAL_1]][@row] : <@HolderIncompatibleShape>, !array.type<#[[$ATTR_0]] x !felt.type>
// CHECK-NEXT:        %[[VAL_4:[0-9a-zA-Z_.-]+]] = array.new  : <2,4 x !felt.type>
// CHECK-NEXT:        array.insert %[[VAL_4]]{{\[}}%[[VAL_0]]] = %[[VAL_3]] : <2,4 x !felt.type>, <#[[$ATTR_0]] x !felt.type>
// CHECK-NEXT:        struct.writem %[[VAL_1]][@grid] = %[[VAL_4]] : <@HolderIncompatibleShape>, !array.type<2,4 x !felt.type>
// CHECK-NEXT:        function.return %[[VAL_1]] : !struct.type<@HolderIncompatibleShape>
