// -----

// An affine dimension is initially compatible with the destination, but refinement must
// decline when the concrete source shape conflicts with the selected destination shape.
#id = affine_map<(i) -> (i)>
module attributes {llzk.lang} {
  struct.def @HolderIncompatibleShape {
    struct.member @row : !array.type<#id x !felt.type> {column}
    struct.member @grid : !array.type<2,4 x !felt.type> {column}
    function.def @compute() -> !struct.type<@HolderIncompatibleShape> {
      %self = struct.new : !struct.type<@HolderIncompatibleShape>
      %index = arith.constant 0 : index
      %row0 = array.new : !array.type<3 x !felt.type>
      struct.writem %self[@row] = %row0 : !struct.type<@HolderIncompatibleShape>, !array.type<3 x !felt.type>
      %read = struct.readm %self[@row] : !struct.type<@HolderIncompatibleShape>, !array.type<#id x !felt.type>
      %destination = array.new : !array.type<2,4 x !felt.type>
      array.insert %destination[%index] = %read : !array.type<2,4 x !felt.type>, !array.type<#id x !felt.type>
      struct.writem %self[@grid] = %destination : !struct.type<@HolderIncompatibleShape>, !array.type<2,4 x !felt.type>
      function.return %self : !struct.type<@HolderIncompatibleShape>
    }
    function.def @constrain(%self: !struct.type<@HolderIncompatibleShape>) {
      function.return
    }
  }
}
// CHECK: #[[$ATTR_0:[0-9a-zA-Z_.-]+]] = affine_map<(d0) -> (d0)>

