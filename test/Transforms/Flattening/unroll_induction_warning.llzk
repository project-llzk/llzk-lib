// CHECK-NEXT:          %[[VAL_48:[0-9a-zA-Z_\.]+]] = arith.addi %[[VAL_47]], %[[VAL_46]] : i8
// CHECK-NEXT:          scf.yield %[[VAL_48]] : i8
// CHECK-NEXT:        } {llzk.loopbounds = #llzk.loopbounds<128 to 129 step 1>}
// CHECK-NEXT:        scf.yield %[[VAL_45]] : i8
// CHECK-NEXT:      } else {
// CHECK-NEXT:        scf.yield %[[VAL_43]] : i8
// CHECK-NEXT:      }
// CHECK-NEXT:      %[[VAL_49:[0-9a-zA-Z_\.]+]] = arith.index_cast %[[VAL_44]] : i8 to index
// CHECK-NEXT:      function.return %[[VAL_49]] : index
// CHECK-NEXT:    }
// CHECK-NEXT:    function.def @unmaterialized_values(%[[VAL_50:[0-9a-zA-Z_\.]+]]: index, %[[VAL_51:[0-9a-zA-Z_\.]+]]: index, %[[VAL_52:[0-9a-zA-Z_\.]+]]: index, %[[VAL_53:[0-9a-zA-Z_\.]+]]: index) -> index {
// CHECK-NEXT:      %[[VAL_54:[0-9a-zA-Z_\.]+]] = arith.index_cast %[[VAL_53]] : index to i8
// CHECK-NEXT:      %[[VAL_55:[0-9a-zA-Z_\.]+]] = arith.constant 1 : i8
// CHECK-NEXT:      %[[VAL_56:[0-9a-zA-Z_\.]+]] = arith.addi %[[VAL_54]], %[[VAL_55]] : i8
// CHECK-NEXT:      %[[VAL_57:[0-9a-zA-Z_\.]+]] = arith.addi %[[VAL_56]], %[[VAL_55]] : i8
// CHECK-NEXT:      %[[VAL_58:[0-9a-zA-Z_\.]+]] = arith.index_cast %[[VAL_57]] : i8 to index
