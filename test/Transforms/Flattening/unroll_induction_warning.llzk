// CHECK-NEXT:      %[[VAL_41:[0-9a-zA-Z_\.]+]] = arith.constant 0 : i8
// CHECK-NEXT:      %[[VAL_42:[0-9a-zA-Z_\.]+]] = arith.constant 1 : i8
