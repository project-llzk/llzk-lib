// CHECK-NEXT:        %[[VAL_4:[0-9a-zA-Z_\.]+]] = struct.new : <@TCell_2_Cell>
// CHECK-NEXT:        function.return %[[VAL_4]] : !struct.type<@TCell_2_Cell>
// CHECK-NEXT:      }
