// CHECK-NEXT:        }
// CHECK-NEXT:        function.def @constrain(%[[VAL_7:[0-9a-zA-Z_\.]+]]: !struct.type<@TCell::@Cell<[@N]>>) attributes {function.allow_constraint} {
