// CHECK-NEXT:    struct.def @TPair_0_0_Pair {
// CHECK-NEXT:      struct.member @value : !felt.type {column}
// CHECK-NEXT:      function.def @compute() -> !struct.type<@TPair_0_0_Pair> attributes {function.allow_witness} {
