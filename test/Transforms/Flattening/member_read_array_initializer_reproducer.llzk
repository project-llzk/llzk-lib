// CHECK-NEXT:        %[[VAL_3:[0-9a-zA-Z_\.]+]] = function.call @TCell_0_Cell::@compute() : () -> !struct.type<@TCell_0_Cell>
// CHECK-NEXT:        struct.writem %[[VAL_2]][@item] = %[[VAL_3]] : <@Holder>, !struct.type<@TCell_0_Cell>
// CHECK-NEXT:        function.return %[[VAL_2]] : !struct.type<@Holder>
