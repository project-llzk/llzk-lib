// RUN: llzk-opt -split-input-file -llzk-flatten -verify-diagnostics %s
// RUN: not llzk-opt -split-input-file -llzk-flatten -mlir-print-ir-after-failure %s 2>&1 | FileCheck %s --check-prefix=ATOMIC --enable-var-scope

// Reject a concrete result incompatible with the selected member before retagging its receiver.
#id = affine_map<(i) -> (i)>
module attributes {llzk.lang} {
  poly.template @TCell {
    poly.param @N : index
    struct.def @Cell {
      struct.member @value : !felt.type {llzk.pub}
      function.def @compute() -> !struct.type<@TCell::@Cell<[@N]>> {
        %self = struct.new : !struct.type<@TCell::@Cell<[@N]>>
        function.return %self : !struct.type<@TCell::@Cell<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@TCell::@Cell<[@N]>>) { function.return }
    }
  }
  poly.template @TBox {
    poly.param @N : index
    struct.def @Box {
      struct.member @cell : !struct.type<@TCell::@Cell<[@N]>> {llzk.pub}
      function.def @compute() -> !struct.type<@TBox::@Box<[@N]>> {
        %self = struct.new : !struct.type<@TBox::@Box<[@N]>>
        function.return %self : !struct.type<@TBox::@Box<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@TBox::@Box<[@N]>>) { function.return }
    }
  }
  function.def @consume(%arg: !struct.type<@TCell::@Cell<[1]>>) { function.return }
  struct.def @Holder {
    struct.member @boxes : !array.type<1 x !struct.type<@TBox::@Box<[#id]>>>
    function.def @compute() -> !struct.type<@Holder> {
      %self = struct.new : !struct.type<@Holder>
      %zero = arith.constant 0 : index
      %box0 = function.call @TBox::@Box::@compute() : () -> !struct.type<@TBox::@Box<[0]>>
      %values = array.new %box0 : !array.type<1 x !struct.type<@TBox::@Box<[0]>>>
      struct.writem %self[@boxes] = %values : !struct.type<@Holder>, !array.type<1 x !struct.type<@TBox::@Box<[0]>>>
      %boxes = struct.readm %self[@boxes] : !struct.type<@Holder>, !array.type<1 x !struct.type<@TBox::@Box<[#id]>>>
      %box = array.read %boxes[%zero] : !array.type<1 x !struct.type<@TBox::@Box<[#id]>>>, !struct.type<@TBox::@Box<[#id]>>
      // expected-error@+2 {{cannot refine receiver because its selected member is incompatible with the read or its users}}
      // expected-note@+1 {{proposed receiver type}}
      %cell = struct.readm %box[@cell] : !struct.type<@TBox::@Box<[#id]>>, !struct.type<@TCell::@Cell<[1]>>
      function.call @consume(%cell) : (!struct.type<@TCell::@Cell<[1]>>) -> ()
      function.return %self : !struct.type<@Holder>
    }
    function.def @constrain(%self: !struct.type<@Holder>) { function.return }
  }
}

