// Validate shared call bindings across every pending nested-member result.
#id = affine_map<(i) -> (i)>
module attributes {llzk.lang} {
  poly.template @TCell {
    poly.param @N : index
    struct.def @Cell {
      struct.member @value : !felt.type {llzk.pub}
      function.def @compute() -> !struct.type<@TCell::@Cell<[@N]>> {
        %self = struct.new : !struct.type<@TCell::@Cell<[@N]>>
        function.return %self : !struct.type<@TCell::@Cell<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@TCell::@Cell<[@N]>>) { function.return }
    }
  }
  poly.template @TBox {
    poly.param @N : index
    struct.def @Box {
      struct.member @cell : !struct.type<@TCell::@Cell<[@N]>> {llzk.pub}
      function.def @compute() -> !struct.type<@TBox::@Box<[@N]>> {
        %self = struct.new : !struct.type<@TBox::@Box<[@N]>>
        function.return %self : !struct.type<@TBox::@Box<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@TBox::@Box<[@N]>>) { function.return }
    }
  }
  poly.template @Match {
    poly.param @T
    function.def @consume(%a: !poly.tvar<@T>, %b: !poly.tvar<@T>) { function.return }
  }
  struct.def @Holder {
    struct.member @left : !array.type<1 x !struct.type<@TBox::@Box<[#id]>>>
    struct.member @right : !array.type<1 x !struct.type<@TBox::@Box<[#id]>>>
    function.def @compute() -> !struct.type<@Holder> {
      %self = struct.new : !struct.type<@Holder>
      %zero = arith.constant 0 : index
      %box0 = function.call @TBox::@Box::@compute() : () -> !struct.type<@TBox::@Box<[0]>>
      %leftValues = array.new %box0 : !array.type<1 x !struct.type<@TBox::@Box<[0]>>>
      struct.writem %self[@left] = %leftValues : !struct.type<@Holder>, !array.type<1 x !struct.type<@TBox::@Box<[0]>>>
      %leftBoxes = struct.readm %self[@left] : !struct.type<@Holder>, !array.type<1 x !struct.type<@TBox::@Box<[#id]>>>
      %leftBox = array.read %leftBoxes[%zero] : !array.type<1 x !struct.type<@TBox::@Box<[#id]>>>, !struct.type<@TBox::@Box<[#id]>>
      // expected-note@+1 {{member read would refine to}}
      %leftCell = struct.readm %leftBox[@cell] : !struct.type<@TBox::@Box<[#id]>>, !struct.type<@TCell::@Cell<[#id]>>
      %box1 = function.call @TBox::@Box::@compute() : () -> !struct.type<@TBox::@Box<[1]>>
      %rightValues = array.new %box1 : !array.type<1 x !struct.type<@TBox::@Box<[1]>>>
      struct.writem %self[@right] = %rightValues : !struct.type<@Holder>, !array.type<1 x !struct.type<@TBox::@Box<[1]>>>
      %rightBoxes = struct.readm %self[@right] : !struct.type<@Holder>, !array.type<1 x !struct.type<@TBox::@Box<[#id]>>>
      %rightBox = array.read %rightBoxes[%zero] : !array.type<1 x !struct.type<@TBox::@Box<[#id]>>>, !struct.type<@TBox::@Box<[#id]>>
      // expected-note@+1 {{member read would refine to}}
      %rightCell = struct.readm %rightBox[@cell] : !struct.type<@TBox::@Box<[#id]>>, !struct.type<@TCell::@Cell<[#id]>>
      // expected-error@+2 {{cannot refine member reads because the complete call signature has conflicting template bindings}}
      // expected-note@+1 {{proposed call signature}}
      function.call @Match::@consume(%leftCell, %rightCell) : (!struct.type<@TCell::@Cell<[#id]>>, !struct.type<@TCell::@Cell<[#id]>>) -> ()
      function.return %self : !struct.type<@Holder>
    }
    function.def @constrain(%self: !struct.type<@Holder>) { function.return }
  }
}

