// Keep compatible unresolved receiver bindings while refining the selected member.
#id = affine_map<(i) -> (i)>
module attributes {llzk.lang} {
  poly.template @TCell {
    poly.param @N : index
    struct.def @Cell {
      struct.member @value : !felt.type {llzk.pub}
      function.def @compute() -> !struct.type<@TCell::@Cell<[@N]>> {
        %self = struct.new : !struct.type<@TCell::@Cell<[@N]>>
        function.return %self : !struct.type<@TCell::@Cell<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@TCell::@Cell<[@N]>>) { function.return }
    }
  }
  poly.template @TBox {
    poly.param @N : index
    poly.param @M : index
    struct.def @Box {
      struct.member @cell : !struct.type<@TCell::@Cell<[@N]>> {llzk.pub}
      function.def @compute() -> !struct.type<@TBox::@Box<[@N, @M]>> {
        %self = struct.new : !struct.type<@TBox::@Box<[@N, @M]>>
        function.return %self : !struct.type<@TBox::@Box<[@N, @M]>>
      }
      function.def @constrain(%self: !struct.type<@TBox::@Box<[@N, @M]>>) { function.return }
    }
  }
  function.def @consume(%arg: !struct.type<@TCell::@Cell<[0]>>) { function.return }
  struct.def @Holder {
    struct.member @boxes : !array.type<1 x !struct.type<@TBox::@Box<[#id, #id]>>>
    function.def @compute(%idx: index) -> !struct.type<@Holder> {
      %self = struct.new : !struct.type<@Holder>
      %zero = arith.constant 0 : index
      %box0 = function.call @TBox::@Box::@compute() {(%idx)} : () -> !struct.type<@TBox::@Box<[0, #id]>>
      %values = array.new %box0 : !array.type<1 x !struct.type<@TBox::@Box<[0, #id]>>>
      struct.writem %self[@boxes] = %values : !struct.type<@Holder>, !array.type<1 x !struct.type<@TBox::@Box<[0, #id]>>>
      %boxes = struct.readm %self[@boxes] : !struct.type<@Holder>, !array.type<1 x !struct.type<@TBox::@Box<[#id, #id]>>>
      %box = array.read %boxes[%zero] : !array.type<1 x !struct.type<@TBox::@Box<[#id, #id]>>>, !struct.type<@TBox::@Box<[#id, #id]>>
      %cell = struct.readm %box[@cell] : !struct.type<@TBox::@Box<[#id, #id]>>, !struct.type<@TCell::@Cell<[#id]>>
      function.call @consume(%cell) : (!struct.type<@TCell::@Cell<[#id]>>) -> ()
      function.return %self : !struct.type<@Holder>
    }
    function.def @constrain(%self: !struct.type<@Holder>, %idx: index) { function.return }
  }
}

