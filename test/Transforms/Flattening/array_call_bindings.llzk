// CHECK-NEXT:        %[[VAL_4:[0-9a-zA-Z_.-]+]] = arith.constant 0 : index
// CHECK-NEXT:        %[[VAL_5:[0-9a-zA-Z_.-]+]] = array.new  : <1 x !felt.type>
// CHECK-NEXT:        %[[VAL_6:[0-9a-zA-Z_.-]+]] = array.new  : <1 x !felt.type>
