// RUN: llzk-opt -split-input-file -llzk-flatten %s | FileCheck %s --enable-var-scope

// Matching shared allocation bindings specialize together.
module attributes {llzk.lang} {
  poly.template @Consume {
    poly.param @T
    function.def @consume(%a: !array.type<1 x !poly.tvar<@T>>, %b: !array.type<1 x !poly.tvar<@T>>) { function.return }
  }
  poly.template @Caller {
    poly.param @T
    function.def @caller(%a: !felt.type, %b: !felt.type) {
      %aa = array.new : !array.type<1 x !poly.tvar<@T>>
      %bb = array.new : !array.type<1 x !poly.tvar<@T>>
      %c0 = arith.constant 0 : index
      array.write %aa[%c0] = %a : !array.type<1 x !poly.tvar<@T>>, !felt.type
      array.write %bb[%c0] = %b : !array.type<1 x !poly.tvar<@T>>, !felt.type
      function.call @Consume::@consume(%aa, %bb) : (!array.type<1 x !poly.tvar<@T>>, !array.type<1 x !poly.tvar<@T>>) -> ()
      function.return
    }
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK:      function.def @caller(%[[VAL_2:[0-9a-zA-Z_.-]+]]: !felt.type, %[[VAL_3:[0-9a-zA-Z_.-]+]]: !felt.type) {
// CHECK-NEXT:        %[[VAL_4:[0-9a-zA-Z_.-]+]] = arith.constant 0 : index
// CHECK-NEXT:        %[[VAL_5:[0-9a-zA-Z_.-]+]] = array.new  : <1 x !felt.type>
// CHECK-NEXT:        %[[VAL_6:[0-9a-zA-Z_.-]+]] = array.new  : <1 x !felt.type>
// CHECK-NEXT:        array.write %[[VAL_5]]{{\[}}%[[VAL_4]]] = %[[VAL_2]] : <1 x !felt.type>, !felt.type
// CHECK-NEXT:        array.write %[[VAL_6]]{{\[}}%[[VAL_4]]] = %[[VAL_3]] : <1 x !felt.type>, !felt.type
// CHECK-NEXT:        function.call @Consume_f_consume(%[[VAL_5]], %[[VAL_6]]) : (!array.type<1 x !felt.type>, !array.type<1 x !felt.type>) -> ()

// -----

// Preserve compatible allocation refinements inferred from typed reads.
module attributes {llzk.lang} {
  poly.template @Consume {
    poly.param @T
    function.def @consume(%a: !array.type<1 x !poly.tvar<@T>>, %b: !array.type<1 x !poly.tvar<@T>>) { function.return }
  }
  poly.template @Caller {
    poly.param @T
    function.def @caller(%a: !felt.type, %b: !felt.type) attributes {function.allow_constraint} {
      %aa = array.new : !array.type<1 x !poly.tvar<@T>>
      %bb = array.new : !array.type<1 x !poly.tvar<@T>>
      %c0 = arith.constant 0 : index
      %ra = array.read %aa[%c0] : !array.type<1 x !poly.tvar<@T>>, !felt.type
      constrain.eq %ra, %a : !felt.type, !felt.type
      %rb = array.read %bb[%c0] : !array.type<1 x !poly.tvar<@T>>, !felt.type
      constrain.eq %rb, %b : !felt.type, !felt.type
      function.call @Consume::@consume(%aa, %bb) : (!array.type<1 x !poly.tvar<@T>>, !array.type<1 x !poly.tvar<@T>>) -> ()
      function.return
    }
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK:      function.def @caller(%[[VAL_2:[0-9a-zA-Z_.-]+]]: !felt.type, %[[VAL_3:[0-9a-zA-Z_.-]+]]: !felt.type) attributes {function.allow_constraint} {
// CHECK-NEXT:        %[[VAL_4:[0-9a-zA-Z_.-]+]] = arith.constant 0 : index
// CHECK-NEXT:        %[[VAL_5:[0-9a-zA-Z_.-]+]] = array.new  : <1 x !felt.type>
// CHECK-NEXT:        %[[VAL_6:[0-9a-zA-Z_.-]+]] = array.new  : <1 x !felt.type>
// CHECK-NEXT:        %[[VAL_7:[0-9a-zA-Z_.-]+]] = array.read %[[VAL_5]]{{\[}}%[[VAL_4]]] : <1 x !felt.type>, !felt.type
// CHECK-NEXT:        constrain.eq %[[VAL_7]], %[[VAL_2]] : !felt.type, !felt.type
// CHECK-NEXT:        %[[VAL_8:[0-9a-zA-Z_.-]+]] = array.read %[[VAL_6]]{{\[}}%[[VAL_4]]] : <1 x !felt.type>, !felt.type
// CHECK-NEXT:        constrain.eq %[[VAL_8]], %[[VAL_3]] : !felt.type, !felt.type
// CHECK-NEXT:        function.call @Consume_f_consume(%[[VAL_5]], %[[VAL_6]]) : (!array.type<1 x !felt.type>, !array.type<1 x !felt.type>) -> ()

// -----

// Independent callee bindings may specialize differently.
module attributes {llzk.lang} {
  poly.template @Consume {
    poly.param @U
    poly.param @T
    function.def @consume(%a: !array.type<1 x !poly.tvar<@T>>, %b: !array.type<1 x !poly.tvar<@U>>) { function.return }
  }
  poly.template @Caller {
    poly.param @T
    function.def @caller(%a: !felt.type, %b: index) {
      %aa = array.new : !array.type<1 x !poly.tvar<@T>>
      %bb = array.new : !array.type<1 x !poly.tvar<@T>>
      %c0 = arith.constant 0 : index
      array.write %aa[%c0] = %a : !array.type<1 x !poly.tvar<@T>>, !felt.type
      array.write %bb[%c0] = %b : !array.type<1 x !poly.tvar<@T>>, index
      function.call @Consume::@consume(%aa, %bb) : (!array.type<1 x !poly.tvar<@T>>, !array.type<1 x !poly.tvar<@T>>) -> ()
      function.return
    }
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK:      function.def @caller(%[[VAL_2:[0-9a-zA-Z_.-]+]]: !felt.type, %[[VAL_3:[0-9a-zA-Z_.-]+]]: index) {
// CHECK-NEXT:        %[[VAL_4:[0-9a-zA-Z_.-]+]] = arith.constant 0 : index
// CHECK-NEXT:        %[[VAL_5:[0-9a-zA-Z_.-]+]] = array.new  : <1 x !felt.type>
// CHECK-NEXT:        %[[VAL_6:[0-9a-zA-Z_.-]+]] = array.new  : <1 x index>
// CHECK-NEXT:        array.write %[[VAL_5]]{{\[}}%[[VAL_4]]] = %[[VAL_2]] : <1 x !felt.type>, !felt.type
// CHECK-NEXT:        array.write %[[VAL_6]]{{\[}}%[[VAL_4]]] = %[[VAL_3]] : <1 x index>, index
// CHECK-NEXT:        function.call @Consume_i_f_consume(%[[VAL_5]], %[[VAL_6]]) : (!array.type<1 x !felt.type>, !array.type<1 x index>) -> ()

// -----

// Matching inferred element reads preserve call compatibility.
module attributes {llzk.lang} {
  poly.template @Consume {
    poly.param @T
    function.def @consume(%a: !poly.tvar<@T>, %b: !poly.tvar<@T>) { function.return }
  }
  poly.template @Caller {
    poly.param @T
    function.def @caller(%a: !felt.type, %b: !felt.type) {
      %aa = array.new : !array.type<1 x !poly.tvar<@T>>
      %bb = array.new : !array.type<1 x !poly.tvar<@T>>
      %c0 = arith.constant 0 : index
      array.write %aa[%c0] = %a : !array.type<1 x !poly.tvar<@T>>, !felt.type
      array.write %bb[%c0] = %b : !array.type<1 x !poly.tvar<@T>>, !felt.type
      %ra = array.read %aa[%c0] : !array.type<1 x !poly.tvar<@T>>, !poly.tvar<@T>
      %rb = array.read %bb[%c0] : !array.type<1 x !poly.tvar<@T>>, !poly.tvar<@T>
      function.call @Consume::@consume(%ra, %rb) : (!poly.tvar<@T>, !poly.tvar<@T>) -> ()
      function.return
    }
  }
}

