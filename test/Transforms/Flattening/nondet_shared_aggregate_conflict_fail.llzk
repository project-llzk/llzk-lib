// RUN: llzk-opt -llzk-flatten -split-input-file -verify-diagnostics %s

// array conflict.
module attributes {llzk.lang} {
  struct.def @Holder {
    // expected-note@+1 {{first required type: '!array.type<1 x !felt.type>'}}
    struct.member @first : !array.type<1 x !felt.type>
    // expected-note@+1 {{conflicting required type: '!array.type<2 x !felt.type>'}}
    struct.member @second : !array.type<2 x !felt.type>
    function.def @compute() -> !struct.type<@Holder> {
      %self = struct.new : !struct.type<@Holder>
      // expected-error@+1 {{cannot refine shared nondeterministic witness because member writes require incompatible types}}
      %shared = llzk.nondet : !array.type<? x !felt.type> {product_source = "shared", test.marker = 42 : i64}
      struct.writem %self[@first] = %shared : !struct.type<@Holder>, !array.type<? x !felt.type>
      struct.writem %self[@second] = %shared : !struct.type<@Holder>, !array.type<? x !felt.type>
      function.return %self : !struct.type<@Holder>
    }
    function.def @constrain(%self: !struct.type<@Holder>) { function.return }
  }
}

// -----

// array conflict reverse.
module attributes {llzk.lang} {
  struct.def @Holder {
    // expected-note@+1 {{conflicting required type: '!array.type<1 x !felt.type>'}}
    struct.member @first : !array.type<1 x !felt.type>
    // expected-note@+1 {{first required type: '!array.type<2 x !felt.type>'}}
    struct.member @second : !array.type<2 x !felt.type>
    function.def @compute() -> !struct.type<@Holder> {
      %self = struct.new : !struct.type<@Holder>
      // expected-error@+1 {{cannot refine shared nondeterministic witness because member writes require incompatible types}}
      %shared = llzk.nondet : !array.type<? x !felt.type> {product_source = "shared", test.marker = 42 : i64}
      struct.writem %self[@second] = %shared : !struct.type<@Holder>, !array.type<? x !felt.type>
      struct.writem %self[@first] = %shared : !struct.type<@Holder>, !array.type<? x !felt.type>
      function.return %self : !struct.type<@Holder>
    }
    function.def @constrain(%self: !struct.type<@Holder>) { function.return }
  }
}

