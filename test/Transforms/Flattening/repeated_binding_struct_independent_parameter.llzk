// RUN: split-file %s %t
// RUN: llzk-opt -llzk-flatten %t/generic.llzk > %t/flattened.llzk
// RUN: FileCheck %s --check-prefix=GENERIC < %t/flattened.llzk
// RUN: python3 %S/Inputs/append_module_body.py %t/generic.llzk %t/felt.llzk > %t/direct-felt.llzk
// RUN: llzk-opt -llzk-flatten %t/direct-felt.llzk | FileCheck %s --check-prefix=FELT
// RUN: python3 %S/Inputs/append_module_body.py %t/flattened.llzk %t/felt.llzk > %t/staged-felt.llzk
// RUN: llzk-opt -llzk-flatten %t/staged-felt.llzk | FileCheck %s --check-prefix=FELT
// RUN: python3 %S/Inputs/append_module_body.py %t/generic.llzk %t/index.llzk > %t/direct-index.llzk
// RUN: not llzk-opt -llzk-flatten %t/direct-index.llzk 2>&1 | FileCheck %s --check-prefix=INDEX
// RUN: python3 %S/Inputs/append_module_body.py %t/flattened.llzk %t/index.llzk > %t/staged-index.llzk
// RUN: not llzk-opt -llzk-flatten %t/staged-index.llzk 2>&1 | FileCheck %s --check-prefix=INDEX

//--- generic.llzk
// Both partial struct families need protection when an independent integer argument is concrete.
// The inner and outer parameters intentionally share the name T.
module attributes {llzk.lang} {
  poly.template @Pair {
    poly.param @T
    poly.param @B
    poly.param @N : index
    struct.def @Pair {
      struct.member @first : !poly.tvar<@T>
      struct.member @second : !poly.tvar<@B>
      struct.member @values : !array.type<@N x !felt.type>
      function.def @compute() -> !struct.type<@Pair::@Pair<[@T, @B, @N]>> {
        %self = struct.new : !struct.type<@Pair::@Pair<[@T, @B, @N]>>
        function.return %self : !struct.type<@Pair::@Pair<[@T, @B, @N]>>
      }
      function.def @constrain(%self: !struct.type<@Pair::@Pair<[@T, @B, @N]>>) { function.return }
    }
  }
  poly.template @RepeatedStructIdentity {
    poly.param @T
    struct.def @Holder {
      struct.member @pair : !struct.type<@Pair::@Pair<[@T, @T, 8]>>
      function.def @compute() -> !struct.type<@RepeatedStructIdentity::@Holder<[@T]>> {
        %self = struct.new : !struct.type<@RepeatedStructIdentity::@Holder<[@T]>>
        %input = llzk.nondet : !struct.type<@Pair::@Pair<[@T, !felt.type, 8]>>
        struct.writem %self[@pair] = %input : !struct.type<@RepeatedStructIdentity::@Holder<[@T]>>, !struct.type<@Pair::@Pair<[@T, !felt.type, 8]>>
        function.return %self : !struct.type<@RepeatedStructIdentity::@Holder<[@T]>>
      }
      function.def @constrain(%self: !struct.type<@RepeatedStructIdentity::@Holder<[@T]>>) { function.return }
    }
  }
}
