// CHECK-NEXT:        struct.writem %[[VAL_0]][@first] = %[[VAL_1]] : <@Holder>, !array.type<2 x !pod.type<[@inner: !pod.type<[@rows: !array.type<1,2 x !felt.type>]>]>>
// CHECK-NEXT:        struct.writem %[[VAL_0]][@second] = %[[VAL_1]] : <@Holder>, !array.type<2 x !pod.type<[@inner: !pod.type<[@rows: !array.type<1,2 x !felt.type>]>]>>
// CHECK-NEXT:        function.return %[[VAL_0]] : !struct.type<@Holder>
