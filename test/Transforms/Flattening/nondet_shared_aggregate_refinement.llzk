// nested complementary: all writes retain one witness and its metadata.
module attributes {llzk.lang} {
  struct.def @Holder {
    struct.member @first : !array.type<2 x !pod.type<[@inner: !pod.type<[@rows: !array.type<1,? x !felt.type>]>]>>
    struct.member @second : !array.type<2 x !pod.type<[@inner: !pod.type<[@rows: !array.type<?,2 x !felt.type>]>]>>
    function.def @compute() -> !struct.type<@Holder> {
      %self = struct.new : !struct.type<@Holder>
      %shared = llzk.nondet : !array.type<2 x !pod.type<[@inner: !pod.type<[@rows: !array.type<?,? x !felt.type>]>]>> {product_source = "shared", test.marker = 42 : i64}
      struct.writem %self[@first] = %shared : !struct.type<@Holder>, !array.type<2 x !pod.type<[@inner: !pod.type<[@rows: !array.type<?,? x !felt.type>]>]>>
      struct.writem %self[@second] = %shared : !struct.type<@Holder>, !array.type<2 x !pod.type<[@inner: !pod.type<[@rows: !array.type<?,? x !felt.type>]>]>>
      function.return %self : !struct.type<@Holder>
    }
    function.def @constrain(%self: !struct.type<@Holder>) { function.return }
  }
}

