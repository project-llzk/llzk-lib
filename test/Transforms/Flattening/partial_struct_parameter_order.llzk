// RUN: llzk-opt -llzk-flatten -verify-diagnostics %s | FileCheck %s

// Struct instantiation first binds N, leaving T and U unresolved. Function
// instantiation then binds T to felt and U to index in the residual template.
// Distinct field types expose any reversal of the remaining parameter order.
module attributes {llzk.lang} {
  poly.template @Pair {
    poly.param @T
    poly.param @U
    poly.param @N : index
    struct.def @Pair {
      struct.member @first : !poly.tvar<@T>
      struct.member @second : !poly.tvar<@U>
      struct.member @values : !array.type<@N x !felt.type>
      function.def @compute() -> !struct.type<@Pair::@Pair<[@T, @U, @N]>> {
        %self = struct.new : !struct.type<@Pair::@Pair<[@T, @U, @N]>>
        function.return %self : !struct.type<@Pair::@Pair<[@T, @U, @N]>>
      }
      function.def @constrain(%self: !struct.type<@Pair::@Pair<[@T, @U, @N]>>) { function.return }
    }
  }
  poly.template @Factory {
    poly.param @T
    poly.param @U
    function.def @make() attributes {function.allow_witness} {
      %pair = function.call @Pair::@Pair::@compute() : () -> !struct.type<@Pair::@Pair<[@T, @U, 8]>>
      function.return
    }
  }
  function.def @entry() attributes {function.allow_witness} {
    function.call @Factory::@make<[!felt.type, index]>() : () -> ()
    function.return
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    struct.def @Pair_f_i_8_Pair {
// CHECK-NEXT:      struct.member @first : !felt.type
// CHECK-NEXT:      struct.member @second : index
// CHECK-NEXT:      struct.member @values : !array.type<8 x !felt.type>
// CHECK-NEXT:      function.def @compute() -> !struct.type<@Pair_f_i_8_Pair> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_0:[0-9a-zA-Z_.-]+]] = struct.new : <@Pair_f_i_8_Pair>
// CHECK-NEXT:        function.return %[[VAL_0]] : !struct.type<@Pair_f_i_8_Pair>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_1:[0-9a-zA-Z_.-]+]]: !struct.type<@Pair_f_i_8_Pair>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    function.def @Factory_f_i_make() attributes {function.allow_witness} {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_.-]+]] = function.call @Pair_f_i_8_Pair::@compute() : () -> !struct.type<@Pair_f_i_8_Pair>
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:    function.def @entry() attributes {function.allow_witness} {
// CHECK-NEXT:      function.call @Factory_f_i_make() : () -> ()
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:  }
