// RUN: llzk-opt -split-input-file -llzk-flatten %s | FileCheck %s --enable-var-scope
// RUN: llzk-opt -split-input-file -llzk-flatten -llzk-flatten %s | FileCheck %s --enable-var-scope

// Body evidence must select Lib::Cell even when the outer root has another Cell.
module attributes {llzk.lang} {
  module @Lib attributes {llzk.lang} {
    struct.def @Cell {
      function.def @compute() -> !struct.type<@Cell> {
        %self = struct.new : !struct.type<@Cell>
        function.return %self : !struct.type<@Cell>
      }
      function.def @constrain(%self: !struct.type<@Cell>) { function.return }
    }
    function.def @consume(%cell: !struct.type<@Cell>) { function.return }
    poly.template @Inner {
      poly.param @U : !poly.tvar<@U>
      function.def @id(%arg: !poly.tvar<@U>) {
        %cast = poly.unifiable_cast %arg : (!poly.tvar<@U>) -> !struct.type<@Cell>
        function.call @consume(%cast) : (!struct.type<@Cell>) -> ()
        function.return
      }
    }
  }
  struct.def @Cell {
    struct.member @outer_only : index {llzk.pub}
    function.def @compute() -> !struct.type<@Cell> {
      %self = struct.new : !struct.type<@Cell>
      function.return %self : !struct.type<@Cell>
    }
    function.def @constrain(%self: !struct.type<@Cell>) { function.return }
  }
  poly.template @Outer {
    poly.param @T : !poly.tvar<@T>
    function.def @wrap() {
      %arg = llzk.nondet : !poly.tvar<@T>
      function.call @Lib::@Inner::@id<[@T]>(%arg) : (!poly.tvar<@T>) -> ()
      function.return
    }
  }
  function.def @test() {
    function.call @Outer::@wrap<[?]>() : () -> ()
    function.return
  }
}
// CHECK-LABEL: function.def @"Inner_!s<@Cell>_id"(
// CHECK-SAME:  %[[VAL_3:[0-9a-zA-Z_.-]+]]: !struct.type<@Cell>) {
// CHECK-NEXT:    %[[VAL_4:[0-9a-zA-Z_.-]+]] = poly.unifiable_cast %[[VAL_3]] : (!struct.type<@Cell>) -> !struct.type<@Cell>
// CHECK-NEXT:    function.call @consume(%[[VAL_4]]) : (!struct.type<@Cell>) -> ()
// CHECK-NEXT:    function.return
// CHECK-NEXT:  }
// CHECK-LABEL: struct.def @Cell {
// CHECK-NEXT:    struct.member @outer_only : index {llzk.pub}
// CHECK-NEXT:    function.def @compute() -> !struct.type<@Cell> attributes {function.allow_witness} {
// CHECK-NEXT:      %[[VAL_5:[0-9a-zA-Z_.-]+]] = struct.new : <@Cell>
// CHECK-NEXT:      function.return %[[VAL_5]] : !struct.type<@Cell>
// CHECK-NEXT:    }
// CHECK-NEXT:    function.def @constrain(%[[VAL_6:[0-9a-zA-Z_.-]+]]: !struct.type<@Cell>) attributes {function.allow_constraint} {
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:  }
// CHECK-LABEL: function.def @"Outer_!s<@Lib::@Cell>_wrap"() {
// CHECK-NEXT:    %[[VAL_7:[0-9a-zA-Z_.-]+]] = llzk.nondet : !struct.type<@Lib::@Cell>
// CHECK-NEXT:    function.call @Lib::@"Inner_!s<@Cell>_id"(%[[VAL_7]]) : (!struct.type<@Lib::@Cell>) -> ()
// CHECK-NEXT:    function.return
// CHECK-NEXT:  }
// CHECK-LABEL: function.def @test() {
// CHECK-NEXT:    function.call @"Outer_!s<@Lib::@Cell>_wrap"() : () -> ()
// CHECK-NEXT:    function.return
// CHECK-NEXT:  }

