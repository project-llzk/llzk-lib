// A POD with no index-dependent fields remains a homogeneous array.
#id = affine_map<(i) -> (i)>
#next = affine_map<(i) -> (i + 1)>
module attributes {llzk.lang} {
  struct.def @Holder {
    struct.member @items : !array.type<2 x !pod.type<[@rows: !array.type<3 x !felt.type>, @tag: index]>> {test.member = "items"}
    function.def @compute() -> !struct.type<@Holder> {
      %self = struct.new : !struct.type<@Holder>
      %first = llzk.nondet : !pod.type<[@rows: !array.type<3 x !felt.type>, @tag: index]> {product_source = "first", test.marker = 0 : i64}
      %second = llzk.nondet : !pod.type<[@rows: !array.type<3 x !felt.type>, @tag: index]> {product_source = "second", test.marker = 1 : i64}
      %array = array.new %first, %second : !array.type<2 x !pod.type<[@rows: !array.type<3 x !felt.type>, @tag: index]>>
      struct.writem %self[@items] = %array : !struct.type<@Holder>, !array.type<2 x !pod.type<[@rows: !array.type<3 x !felt.type>, @tag: index]>>
      function.return %self : !struct.type<@Holder>
    }
    function.def @constrain(%self: !struct.type<@Holder>) { function.return }
  }
}

