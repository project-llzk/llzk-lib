// RUN: llzk-opt -llzk-flatten -split-input-file %s | FileCheck --enable-var-scope %s

// Initializer-only POD elements specialize their nested struct at each outer array index.
#id = affine_map<(i) -> (i)>
#next = affine_map<(i) -> (i + 1)>
module attributes {llzk.lang} {
  poly.template @TCell {
    poly.param @N : index
    struct.def @Cell {
      struct.member @value : !felt.type {column}
      function.def @compute() -> !struct.type<@TCell::@Cell<[@N]>> {
        %self = struct.new : !struct.type<@TCell::@Cell<[@N]>>
        function.return %self : !struct.type<@TCell::@Cell<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@TCell::@Cell<[@N]>>) { function.return }
    }
  }
  struct.def @Holder {
    struct.member @items : !array.type<2 x !pod.type<[@cell: !struct.type<@TCell::@Cell<[#id]>>, @tag: index]>> {test.member = "items"}
    function.def @compute() -> !struct.type<@Holder> {
      %self = struct.new : !struct.type<@Holder>
      %first = llzk.nondet : !pod.type<[@cell: !struct.type<@TCell::@Cell<[#id]>>, @tag: index]> {product_source = "first", test.marker = 0 : i64}
      %second = llzk.nondet : !pod.type<[@cell: !struct.type<@TCell::@Cell<[#id]>>, @tag: index]> {product_source = "second", test.marker = 1 : i64}
      %array = array.new %first, %second : !array.type<2 x !pod.type<[@cell: !struct.type<@TCell::@Cell<[#id]>>, @tag: index]>>
      struct.writem %self[@items] = %array : !struct.type<@Holder>, !array.type<2 x !pod.type<[@cell: !struct.type<@TCell::@Cell<[#id]>>, @tag: index]>>
      function.return %self : !struct.type<@Holder>
    }
    function.def @constrain(%self: !struct.type<@Holder>) { function.return }
  }
}

