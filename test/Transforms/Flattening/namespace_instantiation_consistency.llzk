// CHECK:        struct.member @value : !felt.type {llzk.pub}
// CHECK:        struct.def @Box {
// CHECK:          struct.member @cell : !struct.type<@TCell_0_Cell> {llzk.pub}
// CHECK:    struct.def @Holder {
// CHECK-NEXT:      struct.member @boxes : !array.type<1 x !struct.type<@Lib::@"TBox_0_\1A"::@Box<[#[[$ATTR_0]]]>>>
// CHECK-NEXT:      function.def @compute(%[[VAL_5:[0-9a-zA-Z_.-]+]]: index) -> !struct.type<@Holder> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_6:[0-9a-zA-Z_.-]+]] = arith.constant 0 : index
// CHECK-NEXT:        %[[VAL_7:[0-9a-zA-Z_.-]+]] = struct.new : <@Holder>
// CHECK-NEXT:        %[[VAL_8:[0-9a-zA-Z_.-]+]] = function.call @Lib::@"TBox_0_\1A"::@Box::@compute() {(%[[VAL_5]])} : () -> !struct.type<@Lib::@"TBox_0_\1A"::@Box<[#[[$ATTR_0]]]>>
// CHECK-NEXT:        %[[VAL_9:[0-9a-zA-Z_.-]+]] = array.new %[[VAL_8]] : <1 x !struct.type<@Lib::@"TBox_0_\1A"::@Box<[#[[$ATTR_0]]]>>>
// CHECK-NEXT:        struct.writem %[[VAL_7]][@boxes] = %[[VAL_9]] : <@Holder>, !array.type<1 x !struct.type<@Lib::@"TBox_0_\1A"::@Box<[#[[$ATTR_0]]]>>>
// CHECK-NEXT:        %[[VAL_10:[0-9a-zA-Z_.-]+]] = struct.readm %[[VAL_7]][@boxes] : <@Holder>, !array.type<1 x !struct.type<@Lib::@"TBox_0_\1A"::@Box<[#[[$ATTR_0]]]>>>
// CHECK-NEXT:        %[[VAL_11:[0-9a-zA-Z_.-]+]] = array.read %[[VAL_10]]{{\[}}%[[VAL_6]]] : <1 x !struct.type<@Lib::@"TBox_0_\1A"::@Box<[#[[$ATTR_0]]]>>>, !struct.type<@Lib::@"TBox_0_\1A"::@Box<[#[[$ATTR_0]]]>>
// CHECK-NEXT:        %[[VAL_12:[0-9a-zA-Z_.-]+]] = struct.readm %[[VAL_11]][@cell] : <@Lib::@"TBox_0_\1A"::@Box<[#[[$ATTR_0]]]>>, !struct.type<@Lib::@TCell_0_Cell>
// CHECK-NEXT:        function.call @consume(%[[VAL_12]]) : (!struct.type<@Lib::@TCell_0_Cell>) -> ()
// CHECK-NEXT:        function.return %[[VAL_7]] : !struct.type<@Holder>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_13:[0-9a-zA-Z_.-]+]]: !struct.type<@Holder>, %[[VAL_14:[0-9a-zA-Z_.-]+]]: index) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
#id = affine_map<(i) -> (i)>
module attributes {llzk.lang} {
  module @Lib attributes {llzk.lang} {
  poly.template @TCell {
    poly.param @N : index
    struct.def @Cell {
      struct.member @value : !felt.type {llzk.pub}
      function.def @compute() -> !struct.type<@TCell::@Cell<[@N]>> {
        %self = struct.new : !struct.type<@TCell::@Cell<[@N]>>
        function.return %self : !struct.type<@TCell::@Cell<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@TCell::@Cell<[@N]>>) { function.return }
    }
  }
  poly.template @TBox {
    poly.param @N : index
    poly.param @M : index
    struct.def @Box {
      struct.member @cell : !struct.type<@TCell::@Cell<[@N]>> {llzk.pub}
      function.def @compute() -> !struct.type<@TBox::@Box<[@N, @M]>> {
        %self = struct.new : !struct.type<@TBox::@Box<[@N, @M]>>
        function.return %self : !struct.type<@TBox::@Box<[@N, @M]>>
      }
      function.def @constrain(%self: !struct.type<@TBox::@Box<[@N, @M]>>) { function.return }
    }
  }
  }
  function.def @consume(%arg: !struct.type<@Lib::@TCell::@Cell<[0]>>) { function.return }
  struct.def @Holder {
    struct.member @boxes : !array.type<1 x !struct.type<@Lib::@TBox::@Box<[#id, #id]>>>
    function.def @compute(%idx: index) -> !struct.type<@Holder> {
      %self = struct.new : !struct.type<@Holder>
      %zero = arith.constant 0 : index
      %box0 = function.call @Lib::@TBox::@Box::@compute() {(%idx)} : () -> !struct.type<@Lib::@TBox::@Box<[0, #id]>>
      %values = array.new %box0 : !array.type<1 x !struct.type<@Lib::@TBox::@Box<[0, #id]>>>
      struct.writem %self[@boxes] = %values : !struct.type<@Holder>, !array.type<1 x !struct.type<@Lib::@TBox::@Box<[0, #id]>>>
      %boxes = struct.readm %self[@boxes] : !struct.type<@Holder>, !array.type<1 x !struct.type<@Lib::@TBox::@Box<[#id, #id]>>>
      %box = array.read %boxes[%zero] : !array.type<1 x !struct.type<@Lib::@TBox::@Box<[#id, #id]>>>, !struct.type<@Lib::@TBox::@Box<[#id, #id]>>
      %cell = struct.readm %box[@cell] : !struct.type<@Lib::@TBox::@Box<[#id, #id]>>, !struct.type<@Lib::@TCell::@Cell<[0]>>
      function.call @consume(%cell) : (!struct.type<@Lib::@TCell::@Cell<[0]>>) -> ()
      function.return %self : !struct.type<@Holder>
    }
    function.def @constrain(%self: !struct.type<@Holder>, %idx: index) { function.return }
  }
}
