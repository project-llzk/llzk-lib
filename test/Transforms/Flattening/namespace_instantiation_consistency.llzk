// Refinement inside a nested root uses the same history as scoped conversion.
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK:    module @Local attributes {llzk.lang} {
// CHECK:      struct.def @TCell_0_Cell {
// CHECK:        struct.member @value : !felt.type {llzk.pub}
// CHECK:      struct.def @TBox_0_Box {
// CHECK:        struct.member @cell : !struct.type<@TCell_0_Cell> {llzk.pub}
// CHECK:      struct.def @Holder {
// CHECK-NEXT:        struct.member @boxes : !array.type<1 x !struct.type<@TBox_0_Box>>
// CHECK-NEXT:        function.def @compute() -> !struct.type<@Holder> attributes {function.allow_witness} {
// CHECK-NEXT:          %[[VAL_5:[0-9a-zA-Z_.-]+]] = arith.constant 0 : index
// CHECK-NEXT:          %[[VAL_6:[0-9a-zA-Z_.-]+]] = struct.new : <@Holder>
// CHECK-NEXT:          %[[VAL_7:[0-9a-zA-Z_.-]+]] = function.call @TBox_0_Box::@compute() : () -> !struct.type<@TBox_0_Box>
// CHECK-NEXT:          %[[VAL_8:[0-9a-zA-Z_.-]+]] = array.new %[[VAL_7]] : <1 x !struct.type<@TBox_0_Box>>
// CHECK-NEXT:          struct.writem %[[VAL_6]][@boxes] = %[[VAL_8]] : <@Holder>, !array.type<1 x !struct.type<@TBox_0_Box>>
// CHECK-NEXT:          %[[VAL_9:[0-9a-zA-Z_.-]+]] = struct.readm %[[VAL_6]][@boxes] : <@Holder>, !array.type<1 x !struct.type<@TBox_0_Box>>
// CHECK-NEXT:          %[[VAL_10:[0-9a-zA-Z_.-]+]] = array.read %[[VAL_9]]{{\[}}%[[VAL_5]]] : <1 x !struct.type<@TBox_0_Box>>, !struct.type<@TBox_0_Box>
// CHECK-NEXT:          %[[VAL_11:[0-9a-zA-Z_.-]+]] = struct.readm %[[VAL_10]][@cell] : <@TBox_0_Box>, !struct.type<@TCell_0_Cell>
// CHECK-NEXT:          function.call @consume(%[[VAL_11]]) : (!struct.type<@TCell_0_Cell>) -> ()
// CHECK-NEXT:          function.return %[[VAL_6]] : !struct.type<@Holder>
// CHECK-NEXT:        }
// CHECK-NEXT:        function.def @constrain(%[[VAL_12:[0-9a-zA-Z_.-]+]]: !struct.type<@Holder>) attributes {function.allow_constraint} {
// CHECK-NEXT:          function.return
// CHECK-NEXT:        }
// CHECK-NEXT:      }
#id = affine_map<(i) -> (i)>
module attributes {llzk.lang} {
module @Local attributes {llzk.lang} {
  poly.template @TCell {
    poly.param @N : index
    struct.def @Cell {
      struct.member @value : !felt.type {llzk.pub}
      function.def @compute() -> !struct.type<@TCell::@Cell<[@N]>> {
        %self = struct.new : !struct.type<@TCell::@Cell<[@N]>>
        function.return %self : !struct.type<@TCell::@Cell<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@TCell::@Cell<[@N]>>) { function.return }
    }
  }
  poly.template @TBox {
    poly.param @N : index
    struct.def @Box {
      struct.member @cell : !struct.type<@TCell::@Cell<[@N]>> {llzk.pub}
      function.def @compute() -> !struct.type<@TBox::@Box<[@N]>> {
        %self = struct.new : !struct.type<@TBox::@Box<[@N]>>
        function.return %self : !struct.type<@TBox::@Box<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@TBox::@Box<[@N]>>) { function.return }
    }
  }
  function.def @consume(%arg: !struct.type<@TCell::@Cell<[0]>>) { function.return }
  struct.def @Holder {
    struct.member @boxes : !array.type<1 x !struct.type<@TBox::@Box<[#id]>>>
    function.def @compute() -> !struct.type<@Holder> {
      %self = struct.new : !struct.type<@Holder>
      %zero = arith.constant 0 : index
      %box0 = function.call @TBox::@Box::@compute() : () -> !struct.type<@TBox::@Box<[0]>>
      %values = array.new %box0 : !array.type<1 x !struct.type<@TBox::@Box<[0]>>>
      struct.writem %self[@boxes] = %values : !struct.type<@Holder>, !array.type<1 x !struct.type<@TBox::@Box<[0]>>>
      %boxes = struct.readm %self[@boxes] : !struct.type<@Holder>, !array.type<1 x !struct.type<@TBox::@Box<[#id]>>>
      %box = array.read %boxes[%zero] : !array.type<1 x !struct.type<@TBox::@Box<[#id]>>>, !struct.type<@TBox::@Box<[#id]>>
      %cell = struct.readm %box[@cell] : !struct.type<@TBox::@Box<[#id]>>, !struct.type<@TCell::@Cell<[0]>>
      function.call @consume(%cell) : (!struct.type<@TCell::@Cell<[0]>>) -> ()
      function.return %self : !struct.type<@Holder>
    }
    function.def @constrain(%self: !struct.type<@Holder>) { function.return }
  }
}

}

