#id = affine_map<(i) -> (i)>
module attributes {llzk.lang} {
  module @Lib attributes {llzk.lang} {
  poly.template @TCell {
    poly.param @N : index
    struct.def @Cell {
      struct.member @value : !felt.type {llzk.pub}
      function.def @compute() -> !struct.type<@TCell::@Cell<[@N]>> {
        %self = struct.new : !struct.type<@TCell::@Cell<[@N]>>
        function.return %self : !struct.type<@TCell::@Cell<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@TCell::@Cell<[@N]>>) { function.return }
    }
  }
  poly.template @TBox {
    poly.param @T
    struct.def @Box {
      struct.member @cell : !poly.tvar<@T> {llzk.pub}
      function.def @compute(%cell: !poly.tvar<@T>) -> !struct.type<@TBox::@Box<[@T]>> {
        %self = struct.new : !struct.type<@TBox::@Box<[@T]>>
        struct.writem %self[@cell] = %cell : !struct.type<@TBox::@Box<[@T]>>, !poly.tvar<@T>
        function.return %self : !struct.type<@TBox::@Box<[@T]>>
      }
      function.def @constrain(%self: !struct.type<@TBox::@Box<[@T]>>, %cell: !poly.tvar<@T>) { function.return }
    }
  }
  }
  function.def @caller() attributes {function.allow_witness} {
    %cell = function.call @Lib::@TCell::@Cell::@compute() : () -> !struct.type<@Lib::@TCell::@Cell<[0]>>
    %box = function.call @Lib::@TBox::@Box::@compute(%cell) : (!struct.type<@Lib::@TCell::@Cell<[0]>>) -> !struct.type<@Lib::@TBox::@Box<[!struct.type<@Lib::@TCell::@Cell<[0]>>]>>
    function.return
