// Partial instances share local and qualified names without losing unresolved parameters.
// CHECK: #[[$ATTR_0:[0-9a-zA-Z_.-]+]] = affine_map<(d0) -> (d0)>
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK:    module @Lib attributes {llzk.lang} {
