// Nested struct arguments and compute callees normalize together.
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    module @Lib attributes {llzk.lang} {
// CHECK-NEXT:      struct.def @TCell_0_Cell {
// CHECK-NEXT:        struct.member @value : !felt.type {llzk.pub}
// CHECK-NEXT:        function.def @compute() -> !struct.type<@TCell_0_Cell> attributes {function.allow_witness} {
// CHECK-NEXT:          %[[VAL_0:[0-9a-zA-Z_.-]+]] = struct.new : <@TCell_0_Cell>
// CHECK-NEXT:          function.return %[[VAL_0]] : !struct.type<@TCell_0_Cell>
// CHECK-NEXT:        }
// CHECK-NEXT:        function.def @constrain(%[[VAL_1:[0-9a-zA-Z_.-]+]]: !struct.type<@TCell_0_Cell>) attributes {function.allow_constraint} {
// CHECK-NEXT:          function.return
// CHECK-NEXT:        }
// CHECK-NEXT:      }
