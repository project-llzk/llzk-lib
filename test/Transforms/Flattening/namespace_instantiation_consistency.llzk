// CHECK-NEXT:      %[[VAL_7:[0-9a-zA-Z_.-]+]] = function.call @Lib::@"TBox_!s<@TCell_0_Cell>_Box"::@compute(%[[VAL_6]]) : (!struct.type<@Lib::@TCell_0_Cell>) -> !struct.type<@Lib::@"TBox_!s<@TCell_0_Cell>_Box">
// CHECK-NEXT:      function.return
