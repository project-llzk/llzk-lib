// Inferred and explicit external type arguments reuse a declaration-local function clone.
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK:    module @Lib attributes {llzk.lang} {
// CHECK:      struct.def @TCell_0_Cell {
// CHECK:        struct.member @value : !felt.type {column}
// CHECK:      function.def @"Match_!s<@TCell_0_Cell>_consume"(%[[VAL_2:[0-9a-zA-Z_.-]+]]: !struct.type<@TCell_0_Cell>, %[[VAL_3:[0-9a-zA-Z_.-]+]]: !struct.type<@TCell_0_Cell>, %[[VAL_4:[0-9a-zA-Z_.-]+]]: !struct.type<@TCell_0_Cell>) {
// CHECK:    struct.def @Holder {
// CHECK-NEXT:      struct.member @left : !struct.type<@Lib::@TCell_0_Cell> {column}
// CHECK-NEXT:      function.def @compute() -> !struct.type<@Holder> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_5:[0-9a-zA-Z_.-]+]] = struct.new : <@Holder>
// CHECK-NEXT:        %[[VAL_6:[0-9a-zA-Z_.-]+]] = function.call @Lib::@TCell_0_Cell::@compute() : () -> !struct.type<@Lib::@TCell_0_Cell>
// CHECK-NEXT:        %[[VAL_7:[0-9a-zA-Z_.-]+]] = function.call @Lib::@TCell_0_Cell::@compute() : () -> !struct.type<@Lib::@TCell_0_Cell>
// CHECK-NEXT:        struct.writem %[[VAL_5]][@left] = %[[VAL_6]] : <@Holder>, !struct.type<@Lib::@TCell_0_Cell>
// CHECK-NEXT:        %[[VAL_8:[0-9a-zA-Z_.-]+]] = struct.readm %[[VAL_5]][@left] : <@Holder>, !struct.type<@Lib::@TCell_0_Cell>
// CHECK-NEXT:        function.call @Lib::@"Match_!s<@TCell_0_Cell>_consume"(%[[VAL_8]], %[[VAL_7]], %[[VAL_7]]) : (!struct.type<@Lib::@TCell_0_Cell>, !struct.type<@Lib::@TCell_0_Cell>, !struct.type<@Lib::@TCell_0_Cell>) -> ()
// CHECK-NEXT:        function.call @Lib::@"Match_!s<@TCell_0_Cell>_consume"(%[[VAL_8]], %[[VAL_7]], %[[VAL_7]]) : (!struct.type<@Lib::@TCell_0_Cell>, !struct.type<@Lib::@TCell_0_Cell>, !struct.type<@Lib::@TCell_0_Cell>) -> ()
// CHECK-NEXT:        function.return %[[VAL_5]] : !struct.type<@Holder>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_9:[0-9a-zA-Z_.-]+]]: !struct.type<@Holder>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
#id = affine_map<(i) -> (i)>
module attributes {llzk.lang} {
  module @Lib attributes {llzk.lang} {
  poly.template @TCell {
    poly.param @N : index

    struct.def @Cell {
      struct.member @value : !felt.type {column}

      function.def @compute() -> !struct.type<@TCell::@Cell<[@N]>> {
        %self = struct.new : !struct.type<@TCell::@Cell<[@N]>>
        function.return %self : !struct.type<@TCell::@Cell<[@N]>>
      }

      function.def @constrain(%self: !struct.type<@TCell::@Cell<[@N]>>) {
        function.return
      }
    }
  }

  poly.template @Match {
    poly.param @T : !poly.tvar<@T>
    function.def @consume(%a: !poly.tvar<@T>, %b: !poly.tvar<@T>, %known: !struct.type<@TCell::@Cell<[0]>>) {
      function.return
    }
  }

  }
  struct.def @Holder {
    struct.member @left : !struct.type<@Lib::@TCell::@Cell<[#id]>> {column}
    function.def @compute() -> !struct.type<@Holder> {
      %self = struct.new : !struct.type<@Holder>
      %zero = function.call @Lib::@TCell::@Cell::@compute() : () -> !struct.type<@Lib::@TCell::@Cell<[0]>>
      %one = function.call @Lib::@TCell::@Cell::@compute() : () -> !struct.type<@Lib::@TCell::@Cell<[0]>>
      struct.writem %self[@left] = %zero : !struct.type<@Holder>, !struct.type<@Lib::@TCell::@Cell<[0]>>
      %left = struct.readm %self[@left] : !struct.type<@Holder>, !struct.type<@Lib::@TCell::@Cell<[#id]>>
      function.call @Lib::@Match::@consume(%left, %one, %one) : (!struct.type<@Lib::@TCell::@Cell<[#id]>>, !struct.type<@Lib::@TCell::@Cell<[0]>>, !struct.type<@Lib::@TCell::@Cell<[0]>>) -> ()
      function.call @Lib::@Match::@consume<[!struct.type<@Lib::@TCell::@Cell<[0]>>]>(%left, %one, %one) : (!struct.type<@Lib::@TCell::@Cell<[#id]>>, !struct.type<@Lib::@TCell::@Cell<[0]>>, !struct.type<@Lib::@TCell::@Cell<[0]>>) -> ()
      function.return %self : !struct.type<@Holder>
    }
    function.def @constrain(%self: !struct.type<@Holder>) { function.return }
  }
}

