// RUN: llzk-opt -split-input-file -llzk-flatten %s | FileCheck --enable-var-scope %s
// RUN: llzk-opt -split-input-file -llzk-flatten -llzk-flatten %s | FileCheck --enable-var-scope %s

// Equal family names in different language roots retain separate cache identities.
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK:    module @Lib attributes {llzk.lang, llzk.main = !struct.type<@TCell_0_Cell>} {
// CHECK:      struct.def @TCell_0_Cell {
// CHECK:        struct.member @value : !felt.type {llzk.pub}
// CHECK:      struct.def @TBox_0_Box {
// CHECK:        struct.member @cell : !struct.type<@TCell_0_Cell> {llzk.pub}
// CHECK:    module @Other attributes {llzk.lang} {
// CHECK:      struct.def @TCell_0_Cell {
// CHECK:        struct.member @value : index {llzk.pub}
// CHECK:      struct.def @TBox_0_Box {
// CHECK:        struct.member @cell : !struct.type<@TCell_0_Cell> {llzk.pub}
// CHECK:    struct.def @Holder {
// CHECK-NEXT:      struct.member @boxes : !array.type<1 x !struct.type<@Lib::@TBox_0_Box>>
// CHECK-NEXT:      function.def @compute() -> !struct.type<@Holder> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_9:[0-9a-zA-Z_.-]+]] = arith.constant 0 : index
// CHECK-NEXT:        %[[VAL_10:[0-9a-zA-Z_.-]+]] = struct.new : <@Holder>
// CHECK-NEXT:        %[[VAL_11:[0-9a-zA-Z_.-]+]] = function.call @Lib::@TBox_0_Box::@compute() : () -> !struct.type<@Lib::@TBox_0_Box>
// CHECK-NEXT:        %[[VAL_12:[0-9a-zA-Z_.-]+]] = array.new %[[VAL_11]] : <1 x !struct.type<@Lib::@TBox_0_Box>>
// CHECK-NEXT:        struct.writem %[[VAL_10]][@boxes] = %[[VAL_12]] : <@Holder>, !array.type<1 x !struct.type<@Lib::@TBox_0_Box>>
// CHECK-NEXT:        %[[VAL_13:[0-9a-zA-Z_.-]+]] = struct.readm %[[VAL_10]][@boxes] : <@Holder>, !array.type<1 x !struct.type<@Lib::@TBox_0_Box>>
// CHECK-NEXT:        %[[VAL_14:[0-9a-zA-Z_.-]+]] = array.read %[[VAL_13]]{{\[}}%[[VAL_9]]] : <1 x !struct.type<@Lib::@TBox_0_Box>>, !struct.type<@Lib::@TBox_0_Box>
// CHECK-NEXT:        %[[VAL_15:[0-9a-zA-Z_.-]+]] = struct.readm %[[VAL_14]][@cell] : <@Lib::@TBox_0_Box>, !struct.type<@Lib::@TCell_0_Cell>
// CHECK-NEXT:        function.call @consume(%[[VAL_15]]) : (!struct.type<@Lib::@TCell_0_Cell>) -> ()
// CHECK-NEXT:        function.return %[[VAL_10]] : !struct.type<@Holder>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_16:[0-9a-zA-Z_.-]+]]: !struct.type<@Holder>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK:    struct.def @OtherHolder {
// CHECK-NEXT:      struct.member @boxes : !array.type<1 x !struct.type<@Other::@TBox_0_Box>>
// CHECK-NEXT:      function.def @compute() -> !struct.type<@OtherHolder> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_18:[0-9a-zA-Z_.-]+]] = arith.constant 0 : index
// CHECK-NEXT:        %[[VAL_19:[0-9a-zA-Z_.-]+]] = struct.new : <@OtherHolder>
// CHECK-NEXT:        %[[VAL_20:[0-9a-zA-Z_.-]+]] = function.call @Other::@TBox_0_Box::@compute() : () -> !struct.type<@Other::@TBox_0_Box>
// CHECK-NEXT:        %[[VAL_21:[0-9a-zA-Z_.-]+]] = array.new %[[VAL_20]] : <1 x !struct.type<@Other::@TBox_0_Box>>
// CHECK-NEXT:        struct.writem %[[VAL_19]][@boxes] = %[[VAL_21]] : <@OtherHolder>, !array.type<1 x !struct.type<@Other::@TBox_0_Box>>
// CHECK-NEXT:        %[[VAL_22:[0-9a-zA-Z_.-]+]] = struct.readm %[[VAL_19]][@boxes] : <@OtherHolder>, !array.type<1 x !struct.type<@Other::@TBox_0_Box>>
// CHECK-NEXT:        %[[VAL_23:[0-9a-zA-Z_.-]+]] = array.read %[[VAL_22]]{{\[}}%[[VAL_18]]] : <1 x !struct.type<@Other::@TBox_0_Box>>, !struct.type<@Other::@TBox_0_Box>
// CHECK-NEXT:        %[[VAL_24:[0-9a-zA-Z_.-]+]] = struct.readm %[[VAL_23]][@cell] : <@Other::@TBox_0_Box>, !struct.type<@Other::@TCell_0_Cell>
// CHECK-NEXT:        function.call @other_consume(%[[VAL_24]]) : (!struct.type<@Other::@TCell_0_Cell>) -> ()
// CHECK-NEXT:        function.return %[[VAL_19]] : !struct.type<@OtherHolder>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_25:[0-9a-zA-Z_.-]+]]: !struct.type<@OtherHolder>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
#id = affine_map<(i) -> (i)>
module attributes {llzk.lang} {
  module @Lib attributes {llzk.lang, llzk.main = !struct.type<@TCell::@Cell<[0]>>} {
  poly.template @TCell {
    poly.param @N : index
    struct.def @Cell {
      struct.member @value : !felt.type {llzk.pub}
      function.def @compute() -> !struct.type<@TCell::@Cell<[@N]>> {
        %self = struct.new : !struct.type<@TCell::@Cell<[@N]>>
        function.return %self : !struct.type<@TCell::@Cell<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@TCell::@Cell<[@N]>>) { function.return }
    }
  }
  poly.template @TBox {
    poly.param @N : index
    struct.def @Box {
      struct.member @cell : !struct.type<@TCell::@Cell<[@N]>> {llzk.pub}
      function.def @compute() -> !struct.type<@TBox::@Box<[@N]>> {
        %self = struct.new : !struct.type<@TBox::@Box<[@N]>>
        function.return %self : !struct.type<@TBox::@Box<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@TBox::@Box<[@N]>>) { function.return }
    }
  }
  }
  module @Other attributes {llzk.lang} {
  poly.template @TCell {
    poly.param @N : index
    struct.def @Cell {
      struct.member @value : index {llzk.pub}
      function.def @compute() -> !struct.type<@TCell::@Cell<[@N]>> {
        %self = struct.new : !struct.type<@TCell::@Cell<[@N]>>
        function.return %self : !struct.type<@TCell::@Cell<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@TCell::@Cell<[@N]>>) { function.return }
    }
  }
  poly.template @TBox {
    poly.param @N : index
    struct.def @Box {
      struct.member @cell : !struct.type<@TCell::@Cell<[@N]>> {llzk.pub}
      function.def @compute() -> !struct.type<@TBox::@Box<[@N]>> {
        %self = struct.new : !struct.type<@TBox::@Box<[@N]>>
        function.return %self : !struct.type<@TBox::@Box<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@TBox::@Box<[@N]>>) { function.return }
    }
  }
  }
  function.def @consume(%arg: !struct.type<@Lib::@TCell::@Cell<[0]>>) { function.return }
  struct.def @Holder {
    struct.member @boxes : !array.type<1 x !struct.type<@Lib::@TBox::@Box<[#id]>>>
    function.def @compute() -> !struct.type<@Holder> {
      %self = struct.new : !struct.type<@Holder>
      %zero = arith.constant 0 : index
      %box0 = function.call @Lib::@TBox::@Box::@compute() : () -> !struct.type<@Lib::@TBox::@Box<[0]>>
      %values = array.new %box0 : !array.type<1 x !struct.type<@Lib::@TBox::@Box<[0]>>>
      struct.writem %self[@boxes] = %values : !struct.type<@Holder>, !array.type<1 x !struct.type<@Lib::@TBox::@Box<[0]>>>
      %boxes = struct.readm %self[@boxes] : !struct.type<@Holder>, !array.type<1 x !struct.type<@Lib::@TBox::@Box<[#id]>>>
      %box = array.read %boxes[%zero] : !array.type<1 x !struct.type<@Lib::@TBox::@Box<[#id]>>>, !struct.type<@Lib::@TBox::@Box<[#id]>>
      %cell = struct.readm %box[@cell] : !struct.type<@Lib::@TBox::@Box<[#id]>>, !struct.type<@Lib::@TCell::@Cell<[0]>>
      function.call @consume(%cell) : (!struct.type<@Lib::@TCell::@Cell<[0]>>) -> ()
      function.return %self : !struct.type<@Holder>
    }
    function.def @constrain(%self: !struct.type<@Holder>) { function.return }
  }  function.def @other_consume(%arg: !struct.type<@Other::@TCell::@Cell<[0]>>) { function.return }
  struct.def @OtherHolder {
    struct.member @boxes : !array.type<1 x !struct.type<@Other::@TBox::@Box<[#id]>>>
    function.def @compute() -> !struct.type<@OtherHolder> {
      %self = struct.new : !struct.type<@OtherHolder>
      %zero = arith.constant 0 : index
      %box0 = function.call @Other::@TBox::@Box::@compute() : () -> !struct.type<@Other::@TBox::@Box<[0]>>
      %values = array.new %box0 : !array.type<1 x !struct.type<@Other::@TBox::@Box<[0]>>>
      struct.writem %self[@boxes] = %values : !struct.type<@OtherHolder>, !array.type<1 x !struct.type<@Other::@TBox::@Box<[0]>>>
      %boxes = struct.readm %self[@boxes] : !struct.type<@OtherHolder>, !array.type<1 x !struct.type<@Other::@TBox::@Box<[#id]>>>
      %box = array.read %boxes[%zero] : !array.type<1 x !struct.type<@Other::@TBox::@Box<[#id]>>>, !struct.type<@Other::@TBox::@Box<[#id]>>
      %cell = struct.readm %box[@cell] : !struct.type<@Other::@TBox::@Box<[#id]>>, !struct.type<@Other::@TCell::@Cell<[0]>>
      function.call @other_consume(%cell) : (!struct.type<@Other::@TCell::@Cell<[0]>>) -> ()
      function.return %self : !struct.type<@OtherHolder>
    }
    function.def @constrain(%self: !struct.type<@OtherHolder>) { function.return }
  }
}

