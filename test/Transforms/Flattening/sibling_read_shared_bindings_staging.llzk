// RUN: split-file %s %t
// RUN: llzk-opt -llzk-flatten %t/conflict.llzk > %t/conflict-flat.llzk
// RUN: FileCheck %s --check-prefix=CONFLICT < %t/conflict-flat.llzk
// RUN: python3 %S/Inputs/append_module_body.py %t/conflict.llzk %t/index.llzk > %t/conflict-direct.llzk
// RUN: not llzk-opt -llzk-flatten %t/conflict-direct.llzk 2>&1 | FileCheck %s --check-prefix=INDEX
// RUN: python3 %S/Inputs/append_module_body.py %t/conflict-flat.llzk %t/index.llzk > %t/conflict-staged.llzk
// RUN: not llzk-opt -llzk-flatten %t/conflict-staged.llzk 2>&1 | FileCheck %s --check-prefix=INDEX
// RUN: llzk-opt -llzk-flatten %t/unused.llzk > %t/unused-flat.llzk
// RUN: FileCheck %s --check-prefix=UNUSED < %t/unused-flat.llzk
// RUN: python3 %S/Inputs/append_module_body.py %t/unused.llzk %t/index.llzk > %t/unused-direct.llzk
// RUN: not llzk-opt -llzk-flatten %t/unused-direct.llzk 2>&1 | FileCheck %s --check-prefix=INDEX
// RUN: python3 %S/Inputs/append_module_body.py %t/unused-flat.llzk %t/index.llzk > %t/unused-staged.llzk
// RUN: not llzk-opt -llzk-flatten %t/unused-staged.llzk 2>&1 | FileCheck %s --check-prefix=INDEX
// RUN: llzk-opt -llzk-flatten %t/compatible.llzk > %t/compatible-flat.llzk
// RUN: FileCheck %s --check-prefix=COMPATIBLE < %t/compatible-flat.llzk
// RUN: python3 %S/Inputs/append_module_body.py %t/compatible.llzk %t/felt.llzk > %t/compatible-direct.llzk
// RUN: llzk-opt -llzk-flatten %t/compatible-direct.llzk | FileCheck %s --check-prefix=FELT
// RUN: python3 %S/Inputs/append_module_body.py %t/compatible-flat.llzk %t/felt.llzk > %t/compatible-staged.llzk
// RUN: llzk-opt -llzk-flatten %t/compatible-staged.llzk | FileCheck %s --check-prefix=FELT

//--- conflict.llzk
// The index consumer constrains the sibling T; generic flattening must preserve the first write's felt binding.
module attributes {llzk.lang} {
  function.def @consumeIndex(%value: index) { function.return }
  poly.template @SharedRead {
    poly.param @T
    struct.def @Holder {
      struct.member @first : !poly.tvar<@T>
      struct.member @second : !poly.tvar<@T>
      function.def @compute(%input: !felt.type) -> !struct.type<@SharedRead::@Holder<[@T]>> {
        %self = struct.new : !struct.type<@SharedRead::@Holder<[@T]>>
        struct.writem %self[@first] = %input : !struct.type<@SharedRead::@Holder<[@T]>>, !felt.type
        function.return %self : !struct.type<@SharedRead::@Holder<[@T]>>
      }
      function.def @constrain(%self: !struct.type<@SharedRead::@Holder<[@T]>>, %input: !felt.type) {
        %read = struct.readm %self[@second] : !struct.type<@SharedRead::@Holder<[@T]>>, !poly.tvar<@T>
        function.call @consumeIndex(%read) : (!poly.tvar<@T>) -> ()
        function.return
      }
    }
  }
}

