//--- unused.llzk
// Even if an unused read is erased, the sibling declaration must retain its equality with the first member.
module attributes {llzk.lang} {
  function.def @consumeIndex(%value: index) { function.return }
  poly.template @SharedRead {
    poly.param @T
    struct.def @Holder {
      struct.member @first : !poly.tvar<@T>
      struct.member @second : !poly.tvar<@T>
      function.def @compute(%input: !felt.type) -> !struct.type<@SharedRead::@Holder<[@T]>> {
        %self = struct.new : !struct.type<@SharedRead::@Holder<[@T]>>
        struct.writem %self[@first] = %input : !struct.type<@SharedRead::@Holder<[@T]>>, !felt.type
        function.return %self : !struct.type<@SharedRead::@Holder<[@T]>>
      }
      function.def @constrain(%self: !struct.type<@SharedRead::@Holder<[@T]>>, %input: !felt.type) {
        %read = struct.readm %self[@second] : !struct.type<@SharedRead::@Holder<[@T]>>, !poly.tvar<@T>
        function.return
      }
    }
  }
}

