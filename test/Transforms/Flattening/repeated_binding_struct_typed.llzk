//--- index.llzk
  function.def @entry() -> !struct.type<@RepeatedStructIdentity::@Holder<[index]>> attributes {function.allow_witness} {
    %result = function.call @RepeatedStructIdentity::@Holder::@compute() : () -> !struct.type<@RepeatedStructIdentity::@Holder<[index]>>
    function.return %result : !struct.type<@RepeatedStructIdentity::@Holder<[index]>>
  }
}
