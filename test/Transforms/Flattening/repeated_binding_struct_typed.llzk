// FELT-NEXT:        function.def @compute() -> !struct.type<@"Pair_\1A_f"::@Pair<[@A]>> attributes {function.allow_witness} {
// FELT-NEXT:          %[[VAL_0:[0-9a-zA-Z_.-]+]] = struct.new : <@"Pair_\1A_f"::@Pair<[@A]>>
