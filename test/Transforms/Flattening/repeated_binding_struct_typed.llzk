// RUN: split-file %s %t
// RUN: cat %t/generic.llzk %t/felt.llzk > %t/complete-felt.llzk
// RUN: llzk-opt -llzk-flatten %t/complete-felt.llzk | FileCheck %s --check-prefix=FELT
// RUN: cat %t/generic.llzk %t/index.llzk > %t/complete-index.llzk
// RUN: not llzk-opt -llzk-flatten %t/complete-index.llzk 2>&1 | FileCheck %s --check-prefix=INDEX

// Assemble each complete module before flattening; all instantiation sites are visible.

//--- generic.llzk
// Bare struct parameter identities retain the same repeated binding as POD type variables.
module attributes {llzk.lang} {
  poly.template @Pair {
    poly.param @A
    poly.param @B
    struct.def @Pair {
      struct.member @first : !poly.tvar<@A>
      struct.member @second : !poly.tvar<@B>
      function.def @compute() -> !struct.type<@Pair::@Pair<[@A, @B]>> {
        %self = struct.new : !struct.type<@Pair::@Pair<[@A, @B]>>
        function.return %self : !struct.type<@Pair::@Pair<[@A, @B]>>
      }
      function.def @constrain(%self: !struct.type<@Pair::@Pair<[@A, @B]>>) { function.return }
    }
  }
  poly.template @RepeatedStructIdentity {
    poly.param @T
    struct.def @Holder {
      struct.member @pair : !struct.type<@Pair::@Pair<[!poly.tvar<@T>, !poly.tvar<@T>]>>
      function.def @compute() -> !struct.type<@RepeatedStructIdentity::@Holder<[@T]>> {
        %self = struct.new : !struct.type<@RepeatedStructIdentity::@Holder<[@T]>>
        %input = llzk.nondet : !struct.type<@Pair::@Pair<[!poly.tvar<@T>, !felt.type]>>
        struct.writem %self[@pair] = %input : !struct.type<@RepeatedStructIdentity::@Holder<[@T]>>, !struct.type<@Pair::@Pair<[!poly.tvar<@T>, !felt.type]>>
        function.return %self : !struct.type<@RepeatedStructIdentity::@Holder<[@T]>>
      }
      function.def @constrain(%self: !struct.type<@RepeatedStructIdentity::@Holder<[@T]>>) { function.return }
    }
  }

//--- felt.llzk
  function.def @entry() -> !struct.type<@RepeatedStructIdentity::@Holder<[!felt.type]>> attributes {function.allow_witness} {
    %result = function.call @RepeatedStructIdentity::@Holder::@compute() : () -> !struct.type<@RepeatedStructIdentity::@Holder<[!felt.type]>>
    function.return %result : !struct.type<@RepeatedStructIdentity::@Holder<[!felt.type]>>
  }
}
