// RUN: llzk-opt -split-input-file -llzk-flatten="max-unroll=2" -verify-diagnostics %s | FileCheck --enable-var-scope %s

// Skipped annotations must not fall through to computed unrolling or folding.
module attributes {llzk.lang} {
  function.def @originally_zero(%a: !felt.type, %b: !felt.type) attributes {function.allow_constraint} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    // expected-warning @+1 {{loop trip count 3 exceeds max-unroll limit of 2; leaving loop unchanged}}
    scf.for %iv = %zero to %zero step %one {
      constrain.eq %a, %b : !felt.type, !felt.type
    } {llzk.loopbounds = #llzk.loopbounds<0 to 3 step 1>}
    function.return
  }

  // This loop still unrolls and forces another fixpoint round, without repeating warnings.
  function.def @within_limit(%a: !felt.type, %b: !felt.type) attributes {function.allow_constraint} {
    %zero = arith.constant 0 : index
    %two = arith.constant 2 : index
    %one = arith.constant 1 : index
    scf.for %iv = %zero to %two step %one {
      constrain.eq %a, %b : !felt.type, !felt.type
    }
    function.return
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @originally_zero(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !felt.type, %[[VAL_1:[0-9a-zA-Z_\.]+]]: !felt.type) attributes {function.allow_constraint} {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = arith.constant 1 : index
// CHECK-NEXT:      scf.for %[[VAL_4:[0-9a-zA-Z_\.]+]] = %[[VAL_2]] to %[[VAL_2]] step %[[VAL_3]] {
// CHECK-NEXT:        constrain.eq %[[VAL_0]], %[[VAL_1]] : !felt.type, !felt.type
// CHECK-NEXT:      } {llzk.loopbounds = #llzk.loopbounds<0 to 3 step 1>}
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:    function.def @within_limit(%[[VAL_5:[0-9a-zA-Z_\.]+]]: !felt.type, %[[VAL_6:[0-9a-zA-Z_\.]+]]: !felt.type) attributes {function.allow_constraint} {
// CHECK-NEXT:      constrain.eq %[[VAL_5]], %[[VAL_6]] : !felt.type, !felt.type
// CHECK-NEXT:      constrain.eq %[[VAL_5]], %[[VAL_6]] : !felt.type, !felt.type
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

module attributes {llzk.lang} {
  function.def @originally_one(%a: !felt.type, %b: !felt.type) attributes {function.allow_constraint} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    // expected-warning @+1 {{llzk.loopbounds trip count does not fit in uint64_t; leaving loop unchanged}}
    scf.for %iv = %zero to %one step %one {
      constrain.eq %a, %b : !felt.type, !felt.type
    } {llzk.loopbounds = #llzk.loopbounds<0 to 18446744073709551616 step 1>}
    function.return
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @originally_one(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !felt.type, %[[VAL_1:[0-9a-zA-Z_\.]+]]: !felt.type) attributes {function.allow_constraint} {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = arith.constant 1 : index
// CHECK-NEXT:      scf.for %[[VAL_4:[0-9a-zA-Z_\.]+]] = %[[VAL_2]] to %[[VAL_3]] step %[[VAL_3]] {
// CHECK-NEXT:        constrain.eq %[[VAL_0]], %[[VAL_1]] : !felt.type, !felt.type
// CHECK-NEXT:      } {llzk.loopbounds = #llzk.loopbounds<0 to 18446744073709551616 step 1>}
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

module attributes {llzk.lang} {
  function.def @originally_false(%a: !felt.type, %b: !felt.type) attributes {function.allow_constraint} {
    %false = arith.constant false
    // expected-warning @+1 {{loop trip count 3 exceeds max-unroll limit of 2; leaving loop unchanged}}
    scf.while : () -> () {
      scf.condition(%false)
    } do {
      constrain.eq %a, %b : !felt.type, !felt.type
      scf.yield
    } attributes {llzk.loopbounds = #llzk.loopbounds<0 to 3 step 1>}
    function.return
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @originally_false(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !felt.type, %[[VAL_1:[0-9a-zA-Z_\.]+]]: !felt.type) attributes {function.allow_constraint} {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = arith.constant false
// CHECK-NEXT:      scf.while : () -> () {
// CHECK-NEXT:        scf.condition(%[[VAL_2]])
// CHECK-NEXT:      } do {
// CHECK-NEXT:        constrain.eq %[[VAL_0]], %[[VAL_1]] : !felt.type, !felt.type
// CHECK-NEXT:        scf.yield
// CHECK-NEXT:      } attributes {llzk.loopbounds = #llzk.loopbounds<0 to 3 step 1>}
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

// Enclosing control flow must not fold away a preserved loop.
module attributes {llzk.lang} {
  function.def @under_false_if(%a: !felt.type, %b: !felt.type) attributes {function.allow_constraint} {
    %zero = arith.constant 0 : index
    %three = arith.constant 3 : index
    %one = arith.constant 1 : index
    %false = arith.constant false
    scf.if %false {
      // expected-warning @+1 {{loop trip count 3 exceeds max-unroll limit of 2; leaving loop unchanged}}
      scf.for %iv = %zero to %three step %one {
        constrain.eq %a, %b : !felt.type, !felt.type
      }
    }
    function.return
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @under_false_if(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !felt.type, %[[VAL_1:[0-9a-zA-Z_\.]+]]: !felt.type) attributes {function.allow_constraint} {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = arith.constant 3 : index
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = arith.constant 1 : index
// CHECK-NEXT:      %[[VAL_5:[0-9a-zA-Z_\.]+]] = arith.constant false
// CHECK-NEXT:      scf.if %[[VAL_5]] {
// CHECK-NEXT:        scf.for %[[VAL_6:[0-9a-zA-Z_\.]+]] = %[[VAL_2]] to %[[VAL_3]] step %[[VAL_4]] {
// CHECK-NEXT:          constrain.eq %[[VAL_0]], %[[VAL_1]] : !felt.type, !felt.type
// CHECK-NEXT:        }
// CHECK-NEXT:      }
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

// Preserve nested loop bodies without expanding either enclosing or enclosed loops.
module attributes {llzk.lang} {
  function.def @nested(%a: !felt.type, %b: !felt.type) attributes {function.allow_constraint} {
    %zero = arith.constant 0 : index
    %two = arith.constant 2 : index
    %three = arith.constant 3 : index
    %one = arith.constant 1 : index
    scf.for %i = %zero to %two step %one {
      // expected-warning @+1 {{loop trip count 3 exceeds max-unroll limit of 2; leaving loop unchanged}}
      scf.for %j = %zero to %three step %one {
        scf.for %k = %zero to %two step %one {
          constrain.eq %a, %b : !felt.type, !felt.type
        } {llzk.loopbounds = #llzk.loopbounds<0 to 2 step 1>}
      }
    } {llzk.loopbounds = #llzk.loopbounds<0 to 2 step 1>}
    function.return
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @nested(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !felt.type, %[[VAL_1:[0-9a-zA-Z_\.]+]]: !felt.type) attributes {function.allow_constraint} {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = arith.constant 2 : index
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = arith.constant 3 : index
// CHECK-NEXT:      %[[VAL_5:[0-9a-zA-Z_\.]+]] = arith.constant 1 : index
// CHECK-NEXT:      scf.for %[[VAL_6:[0-9a-zA-Z_\.]+]] = %[[VAL_2]] to %[[VAL_3]] step %[[VAL_5]] {
// CHECK-NEXT:        scf.for %[[VAL_7:[0-9a-zA-Z_\.]+]] = %[[VAL_2]] to %[[VAL_4]] step %[[VAL_5]] {
// CHECK-NEXT:          scf.for %[[VAL_8:[0-9a-zA-Z_\.]+]] = %[[VAL_2]] to %[[VAL_3]] step %[[VAL_5]] {
// CHECK-NEXT:            constrain.eq %[[VAL_0]], %[[VAL_1]] : !felt.type, !felt.type
// CHECK-NEXT:          } {llzk.loopbounds = #llzk.loopbounds<0 to 2 step 1>}
// CHECK-NEXT:        }
// CHECK-NEXT:      } {llzk.loopbounds = #llzk.loopbounds<0 to 2 step 1>}
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

// Even empty computed loops should warn and survive the greedy driver's DCE.
module attributes {llzk.lang} {
  function.def @empty_computed() {
    %zero = arith.constant 0 : i128
    %bound = arith.constant 18446744073709551616 : i128
    %one = arith.constant 1 : i128
    // expected-warning @+1 {{computed loop trip count does not fit in uint64_t; leaving loop unchanged}}
    scf.for %iv = %zero to %bound step %one : i128 {
    }
    function.return
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @empty_computed() {
// CHECK-NEXT:      %[[VAL_0:[0-9a-zA-Z_\.]+]] = arith.constant 0 : i128
// CHECK-NEXT:      %[[VAL_1:[0-9a-zA-Z_\.]+]] = arith.constant 18446744073709551616 : i128
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = arith.constant 1 : i128
// CHECK-NEXT:      scf.for %[[VAL_3:[0-9a-zA-Z_\.]+]] = %[[VAL_0]] to %[[VAL_1]] step %[[VAL_2]]  : i128 {
// CHECK-NEXT:      }
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

// The source array's element type becomes concrete outside the preserved loop.
// Inside it, Step 4 must instantiate the local array's affine dimension, and Step 5
// must propagate the concrete element type through both reads and the local array.
module attributes {llzk.lang} {
  poly.template @ArrayTypes {
    poly.param @T
    function.def @preserved_array_types(%value: !felt.type) attributes {function.allow_constraint} {
      %zero = arith.constant 0 : index
      %one = arith.constant 1 : index
      %three = arith.constant 3 : index
      %size = arith.addi %one, %three : index
      %source = array.new : !array.type<1 x !poly.tvar<@T>>
      array.write %source[%zero] = %value : !array.type<1 x !poly.tvar<@T>>, !felt.type
      // expected-warning @+1 {{loop trip count 3 exceeds max-unroll limit of 2; leaving loop unchanged}}
      scf.for %iv = %zero to %three step %one {
        %element = array.read %source[%zero] : !array.type<1 x !poly.tvar<@T>>, !poly.tvar<@T>
        %local = array.new{(%size)} : !array.type<affine_map<(n) -> (n)> x !poly.tvar<@T>>
        array.write %local[%iv] = %element : !array.type<affine_map<(n) -> (n)> x !poly.tvar<@T>>, !poly.tvar<@T>
        %read = array.read %local[%iv] : !array.type<affine_map<(n) -> (n)> x !poly.tvar<@T>>, !poly.tvar<@T>
        constrain.eq %read, %value : !poly.tvar<@T>, !felt.type
      }
      function.return
    }
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    poly.template @ArrayTypes {
// CHECK-NEXT:      poly.param @T
// CHECK-NEXT:      function.def @preserved_array_types(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !felt.type) attributes {function.allow_constraint} {
// CHECK-NEXT:        %[[VAL_1:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:        %[[VAL_2:[0-9a-zA-Z_\.]+]] = arith.constant 1 : index
// CHECK-NEXT:        %[[VAL_3:[0-9a-zA-Z_\.]+]] = arith.constant 3 : index
// CHECK-NEXT:        %[[VAL_4:[0-9a-zA-Z_\.]+]] = array.new  : <1 x !felt.type>
// CHECK-NEXT:        array.write %[[VAL_4]]{{\[}}%[[VAL_1]]] = %[[VAL_0]] : <1 x !felt.type>, !felt.type
// CHECK-NEXT:        scf.for %[[VAL_5:[0-9a-zA-Z_\.]+]] = %[[VAL_1]] to %[[VAL_3]] step %[[VAL_2]] {
// CHECK-NEXT:          %[[VAL_6:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_4]]{{\[}}%[[VAL_1]]] : <1 x !felt.type>, !felt.type
// CHECK-NEXT:          %[[VAL_7:[0-9a-zA-Z_\.]+]] = array.new  : <4 x !felt.type>
// CHECK-NEXT:          array.write %[[VAL_7]]{{\[}}%[[VAL_5]]] = %[[VAL_6]] : <4 x !felt.type>, !felt.type
// CHECK-NEXT:          %[[VAL_8:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_7]]{{\[}}%[[VAL_5]]] : <4 x !felt.type>, !felt.type
// CHECK-NEXT:          constrain.eq %[[VAL_8]], %[[VAL_0]] : !felt.type, !felt.type
// CHECK-NEXT:        }
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }
