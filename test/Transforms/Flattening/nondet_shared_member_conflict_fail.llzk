// The opposite order cannot commit the other partial refinement.
#id = affine_map<(i) -> (i)>
module attributes {llzk.lang} {
  poly.template @TPair {
    poly.param @A : index
    poly.param @B : index
    struct.def @Pair {
      struct.member @value : !felt.type {column}
      function.def @compute() -> !struct.type<@TPair::@Pair<[@A, @B]>> {
