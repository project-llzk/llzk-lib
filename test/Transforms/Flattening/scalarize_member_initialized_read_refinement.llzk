// CHECK-NEXT:          %[[VAL_4:[0-9a-zA-Z_\.]+]] = struct.new : <@TCell::@Cell<[@N]>>
// CHECK-NEXT:          function.return %[[VAL_4]] : !struct.type<@TCell::@Cell<[@N]>>
// CHECK-NEXT:        }
