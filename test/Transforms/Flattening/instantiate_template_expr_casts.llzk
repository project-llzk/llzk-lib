// RUN: llzk-opt -llzk-flatten -verify-diagnostics %s | FileCheck --enable-var-scope %s

// Regression test: instantiate a `poly.expr` with index-to-felt and felt-to-index
// casts when its result specifies an array dimension.
module attributes {llzk.lang} {
  poly.template @T {
    poly.param @n : index
    poly.expr @n_plus_one {
      %one = felt.const 1 : <"bn128">
      %n = poly.read_const @n : index
      %n_felt = cast.tofelt %n : index, !felt.type<"bn128">
      %sum = felt.add %n_felt, %one : !felt.type<"bn128">, !felt.type<"bn128">
      %result = cast.toindex %sum : !felt.type<"bn128">
      poly.yield %result : index
    }
    struct.def @T {
      struct.member @values : !array.type<@n_plus_one x !felt.type<"bn128">>
      function.def @compute() -> !struct.type<@T::@T<[@n]>> {
        %self = struct.new : !struct.type<@T::@T<[@n]>>
        function.return %self : !struct.type<@T::@T<[@n]>>
      }
      function.def @constrain(%self: !struct.type<@T::@T<[@n]>>) {
        function.return
      }
    }
  }

  struct.def @Main {
    struct.member @child : !struct.type<@T::@T<[2]>>
    function.def @compute() -> !struct.type<@Main> {
      %self = struct.new : !struct.type<@Main>
      %child = function.call @T::@T::@compute() : () -> !struct.type<@T::@T<[2]>>
      struct.writem %self[@child] = %child : !struct.type<@Main>, !struct.type<@T::@T<[2]>>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>) {
      function.return
    }
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    struct.def @T_2_T {
// CHECK-NEXT:      struct.member @values : !array.type<3 x !felt.type<"bn128">>
// CHECK-NEXT:      function.def @compute() -> !struct.type<@T_2_T> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_0:[0-9a-zA-Z_\.]+]] = struct.new : <@T_2_T>
// CHECK-NEXT:        function.return %[[VAL_0]] : !struct.type<@T_2_T>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_1:[0-9a-zA-Z_\.]+]]: !struct.type<@T_2_T>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    struct.def @Main {
// CHECK-NEXT:      struct.member @child : !struct.type<@T_2_T>
// CHECK-NEXT:      function.def @compute() -> !struct.type<@Main> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_2:[0-9a-zA-Z_\.]+]] = struct.new : <@Main>
// CHECK-NEXT:        %[[VAL_3:[0-9a-zA-Z_\.]+]] = function.call @T_2_T::@compute() : () -> !struct.type<@T_2_T>
// CHECK-NEXT:        struct.writem %[[VAL_2]][@child] = %[[VAL_3]] : <@Main>, !struct.type<@T_2_T>
// CHECK-NEXT:        function.return %[[VAL_2]] : !struct.type<@Main>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_4:[0-9a-zA-Z_\.]+]]: !struct.type<@Main>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }
