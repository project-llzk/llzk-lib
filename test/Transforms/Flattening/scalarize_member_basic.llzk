      array.write %source[%c1] = %source1 : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>, !struct.type<@TCell::@Cell<[0]>>
      array.write %source[%c2] = %source2 : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>, !struct.type<@TCell::@Cell<[1]>>
      %generic_first = array.read %source[%c0] : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>, !struct.type<@TCell::@Cell<[#id]>>

      %local = array.new : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>
