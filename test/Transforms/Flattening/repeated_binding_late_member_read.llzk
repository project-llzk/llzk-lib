// RUN: split-file %s %t
// RUN: llzk-opt -llzk-flatten %t/generic.llzk > %t/flattened.llzk
// RUN: FileCheck %s --check-prefix=GENERIC < %t/flattened.llzk
// RUN: python3 %S/Inputs/append_module_body.py %t/generic.llzk %t/felt.llzk > %t/direct-felt.llzk
// RUN: llzk-opt -llzk-flatten %t/direct-felt.llzk | FileCheck %s --check-prefix=FELT
// RUN: python3 %S/Inputs/append_module_body.py %t/flattened.llzk %t/felt.llzk > %t/staged-felt.llzk
// RUN: llzk-opt -llzk-flatten %t/staged-felt.llzk | FileCheck %s --check-prefix=FELT
// RUN: python3 %S/Inputs/append_module_body.py %t/generic.llzk %t/index.llzk > %t/direct-index.llzk
// RUN: not llzk-opt -llzk-flatten %t/direct-index.llzk 2>&1 | FileCheck %s --check-prefix=INDEX
// RUN: python3 %S/Inputs/append_module_body.py %t/flattened.llzk %t/index.llzk > %t/staged-index.llzk
// RUN: not llzk-opt -llzk-flatten %t/staged-index.llzk 2>&1 | FileCheck %s --check-prefix=INDEX

//--- generic.llzk
// Source-member propagation reveals the writer binding after nominal instantiation runs.
module attributes {llzk.lang} {
  poly.template @Pair {
    poly.param @A
    poly.param @B
    struct.def @Pair {
      struct.member @first : !poly.tvar<@A>
      struct.member @second : !poly.tvar<@B>
      function.def @compute() -> !struct.type<@Pair::@Pair<[@A, @B]>> {
        %self = struct.new : !struct.type<@Pair::@Pair<[@A, @B]>>
        function.return %self : !struct.type<@Pair::@Pair<[@A, @B]>>
      }
      function.def @constrain(%self: !struct.type<@Pair::@Pair<[@A, @B]>>) { function.return }
    }
  }
  poly.template @LateMember {
    poly.param @T
    poly.param @U
    struct.def @Holder {
      struct.member @pair : !struct.type<@Pair::@Pair<[@T, @T]>>
      struct.member @source : !struct.type<@Pair::@Pair<[@T, @U]>>
      function.def @compute(%input: !struct.type<@Pair::@Pair<[@T, !felt.type]>>) -> !struct.type<@LateMember::@Holder<[@T, @U]>> {
        %self = struct.new : !struct.type<@LateMember::@Holder<[@T, @U]>>
        struct.writem %self[@source] = %input : !struct.type<@LateMember::@Holder<[@T, @U]>>, !struct.type<@Pair::@Pair<[@T, !felt.type]>>
        %read = struct.readm %self[@source] : !struct.type<@LateMember::@Holder<[@T, @U]>>, !struct.type<@Pair::@Pair<[@T, @U]>>
        struct.writem %self[@pair] = %read : !struct.type<@LateMember::@Holder<[@T, @U]>>, !struct.type<@Pair::@Pair<[@T, @U]>>
        function.return %self : !struct.type<@LateMember::@Holder<[@T, @U]>>
      }
      function.def @constrain(%self: !struct.type<@LateMember::@Holder<[@T, @U]>>, %input: !struct.type<@Pair::@Pair<[@T, !felt.type]>>) { function.return }
    }
  }
}
