//--- index.llzk
  function.def @entry(%input: !struct.type<@Pair::@Pair<[index, !felt.type]>>) -> !struct.type<@LateMember::@Holder<[index, !felt.type]>> attributes {function.allow_witness} {
    %result = function.call @LateMember::@Holder::@compute(%input) : (!struct.type<@Pair::@Pair<[index, !felt.type]>>) -> !struct.type<@LateMember::@Holder<[index, !felt.type]>>
    function.return %result : !struct.type<@LateMember::@Holder<[index, !felt.type]>>
  }
}
