// RUN: llzk-opt -llzk-flatten -verify-diagnostics %s | FileCheck %s

// A concrete member write can refine this generic read to Cell<0>, but the read also feeds a cast
// with independently concrete Cell<1> output. Because the cast result has a non-member-write
// consumer, its result cannot be retagged to repair that refinement. Keep the member/read generic
// so the cast remains valid.
module attributes {llzk.lang} {
  poly.template @TCell {
    poly.param @N : index

    struct.def @Cell {
      struct.member @value : !felt.type {column}

      function.def @compute() -> !struct.type<@TCell::@Cell<[@N]>> {
        %self = struct.new : !struct.type<@TCell::@Cell<[@N]>>
        function.return %self : !struct.type<@TCell::@Cell<[@N]>>
      }

      function.def @constrain(%self: !struct.type<@TCell::@Cell<[@N]>>) {
        function.return
      }
    }
  }

  function.def @consume1(%value: !struct.type<@TCell::@Cell<[1]>>) {
    function.return
  }

  poly.template @THolder {
    poly.param @T

    struct.def @Holder {
      struct.member @value : !poly.tvar<@T> {column}

      function.def @compute() -> !struct.type<@THolder::@Holder<[@T]>> {
        %self = struct.new : !struct.type<@THolder::@Holder<[@T]>>
        %item0 = function.call @TCell::@Cell::@compute() : () -> !struct.type<@TCell::@Cell<[0]>>
        struct.writem %self[@value] = %item0 : !struct.type<@THolder::@Holder<[@T]>>, !struct.type<@TCell::@Cell<[0]>>
        %read = struct.readm %self[@value] : !struct.type<@THolder::@Holder<[@T]>>, !poly.tvar<@T>
        %as1 = poly.unifiable_cast %read : (!poly.tvar<@T>) -> !struct.type<@TCell::@Cell<[1]>>
        function.call @consume1(%as1) : (!struct.type<@TCell::@Cell<[1]>>) -> ()
        function.return %self : !struct.type<@THolder::@Holder<[@T]>>
      }

      function.def @constrain(%self: !struct.type<@THolder::@Holder<[@T]>>) {
        function.return
      }
    }
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    struct.def @TCell_1_Cell {
// CHECK-NEXT:      struct.member @value : !felt.type {column}
// CHECK-NEXT:      function.def @compute() -> !struct.type<@TCell_1_Cell> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_0:[0-9a-zA-Z_\.]+]] = struct.new : <@TCell_1_Cell>
// CHECK-NEXT:        function.return %[[VAL_0]] : !struct.type<@TCell_1_Cell>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_1:[0-9a-zA-Z_\.]+]]: !struct.type<@TCell_1_Cell>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    struct.def @TCell_0_Cell {
// CHECK-NEXT:      struct.member @value : !felt.type {column}
// CHECK-NEXT:      function.def @compute() -> !struct.type<@TCell_0_Cell> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_2:[0-9a-zA-Z_\.]+]] = struct.new : <@TCell_0_Cell>
// CHECK-NEXT:        function.return %[[VAL_2]] : !struct.type<@TCell_0_Cell>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_3:[0-9a-zA-Z_\.]+]]: !struct.type<@TCell_0_Cell>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    function.def @consume1(%[[VAL_4:[0-9a-zA-Z_\.]+]]: !struct.type<@TCell_1_Cell>) {
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:    poly.template @THolder {
// CHECK-NEXT:      poly.param @T
// CHECK-NEXT:      struct.def @Holder {
// CHECK-NEXT:        struct.member @value : !poly.tvar<@T> {column}
// CHECK-NEXT:        function.def @compute() -> !struct.type<@THolder::@Holder<[@T]>> attributes {function.allow_witness} {
// CHECK-NEXT:          %[[VAL_5:[0-9a-zA-Z_\.]+]] = struct.new : <@THolder::@Holder<[@T]>>
// CHECK-NEXT:          %[[VAL_6:[0-9a-zA-Z_\.]+]] = function.call @TCell_0_Cell::@compute() : () -> !struct.type<@TCell_0_Cell>
// CHECK-NEXT:          struct.writem %[[VAL_5]][@value] = %[[VAL_6]] : <@THolder::@Holder<[@T]>>, !struct.type<@TCell_0_Cell>
// CHECK-NEXT:          %[[VAL_7:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_5]][@value] : <@THolder::@Holder<[@T]>>, !poly.tvar<@T>
// CHECK-NEXT:          %[[VAL_8:[0-9a-zA-Z_\.]+]] = poly.unifiable_cast %[[VAL_7]] : (!poly.tvar<@T>) -> !struct.type<@TCell_1_Cell>
// CHECK-NEXT:          function.call @consume1(%[[VAL_8]]) : (!struct.type<@TCell_1_Cell>) -> ()
// CHECK-NEXT:          function.return %[[VAL_5]] : !struct.type<@THolder::@Holder<[@T]>>
// CHECK-NEXT:        }
// CHECK-NEXT:        function.def @constrain(%[[VAL_9:[0-9a-zA-Z_\.]+]]: !struct.type<@THolder::@Holder<[@T]>>) attributes {function.allow_constraint} {
// CHECK-NEXT:          function.return
// CHECK-NEXT:        }
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }
