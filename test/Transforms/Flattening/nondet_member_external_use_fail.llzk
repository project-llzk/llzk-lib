// RUN: llzk-opt -llzk-flatten -split-input-file -verify-diagnostics %s

// A generic witness cannot satisfy a concrete member and a conflicting ordinary call.
#id = affine_map<(i) -> (i)>
module attributes {llzk.lang} {
  poly.template @TCell {
    poly.param @N : index
    struct.def @Cell {
      struct.member @value : !felt.type {llzk.pub}
      function.def @compute() -> !struct.type<@TCell::@Cell<[@N]>> {
        %self = struct.new : !struct.type<@TCell::@Cell<[@N]>>
        function.return %self : !struct.type<@TCell::@Cell<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@TCell::@Cell<[@N]>>) { function.return }
    }
  }
  function.def @consume(%arg: !struct.type<@TCell::@Cell<[1]>>) { function.return }
  struct.def @Holder {
    // expected-note@+1 {{conflicting required type:}}
    struct.member @item : !struct.type<@TCell::@Cell<[0]>>
    function.def @compute() -> !struct.type<@Holder> {
      %self = struct.new : !struct.type<@Holder>
      // expected-error@+1 {{cannot refine nondeterministic witness because an external call requires an incompatible type}}
      %value = llzk.nondet : !struct.type<@TCell::@Cell<[#id]>>
      struct.writem %self[@item] = %value : !struct.type<@Holder>, !struct.type<@TCell::@Cell<[#id]>>
      // expected-note@+1 {{first required type:}}
      function.call @consume(%value) : (!struct.type<@TCell::@Cell<[#id]>>) -> ()
      function.return %self : !struct.type<@Holder>
    }
    function.def @constrain(%self: !struct.type<@Holder>) { function.return }
  }
}

// -----

// Partial instantiation must check non-first call arguments, regardless of use order.
#id = affine_map<(i) -> (i)>
module attributes {llzk.lang} {
  poly.template @TCell {
    poly.param @N : index
    poly.param @M : index
    struct.def @Cell {
      struct.member @value : !felt.type {llzk.pub}
      function.def @compute() -> !struct.type<@TCell::@Cell<[@N, @M]>> {
        %self = struct.new : !struct.type<@TCell::@Cell<[@N, @M]>>
        function.return %self : !struct.type<@TCell::@Cell<[@N, @M]>>
      }
      function.def @constrain(%self: !struct.type<@TCell::@Cell<[@N, @M]>>) { function.return }
    }
  }
  function.def @consume(%unused: index, %arg: !struct.type<@TCell::@Cell<[1, 8]>>) { function.return }
  struct.def @Holder {
    // expected-note@+1 {{conflicting required type:}}
    struct.member @item : !struct.type<@TCell::@Cell<[0, 8]>>
    function.def @compute() -> !struct.type<@Holder> {
      %self = struct.new : !struct.type<@Holder>
      // expected-error@+1 {{cannot refine nondeterministic witness because an external call requires an incompatible type}}
      %value = llzk.nondet : !struct.type<@TCell::@Cell<[#id, 8]>>
      %unused = arith.constant 0 : index
      // expected-note@+1 {{first required type:}}
      function.call @consume(%unused, %value) : (index, !struct.type<@TCell::@Cell<[#id, 8]>>) -> ()
      struct.writem %self[@item] = %value : !struct.type<@Holder>, !struct.type<@TCell::@Cell<[#id, 8]>>
      function.return %self : !struct.type<@Holder>
    }
    function.def @constrain(%self: !struct.type<@Holder>) { function.return }
  }
}

// -----

// An additional member refinement must not strand an external array initializer.
#id = affine_map<(i) -> (i)>
module attributes {llzk.lang} {
  poly.template @TCell {
    poly.param @N : index
    poly.param @M : index
    struct.def @Cell {
      struct.member @value : !felt.type {llzk.pub}
      function.def @compute() -> !struct.type<@TCell::@Cell<[@N, @M]>> {
        %self = struct.new : !struct.type<@TCell::@Cell<[@N, @M]>>
        function.return %self : !struct.type<@TCell::@Cell<[@N, @M]>>
      }
      function.def @constrain(%self: !struct.type<@TCell::@Cell<[@N, @M]>>) { function.return }
    }
  }
  struct.def @Holder {
    struct.member @item : !struct.type<@TCell::@Cell<[0, 8]>>
    function.def @compute() -> !struct.type<@Holder> {
      %self = struct.new : !struct.type<@Holder>
      // expected-error@+1 {{cannot refine nondeterministic witness from member writes because it has an unsupported external use}}
      %value = llzk.nondet : !struct.type<@TCell::@Cell<[#id, 8]>>
      struct.writem %self[@item] = %value : !struct.type<@Holder>, !struct.type<@TCell::@Cell<[#id, 8]>>
      // expected-note@+1 {{source witness is also used here}}
      %array = array.new %value : !array.type<1 x !struct.type<@TCell::@Cell<[#id, 8]>>>
      function.return %self : !struct.type<@Holder>
    }
    function.def @constrain(%self: !struct.type<@Holder>) { function.return }
  }
}

// -----

// Skipping a nondet map operand must not skip the conflicting ordinary argument of that call.
#id = affine_map<(i) -> (i)>
module attributes {llzk.lang} {
  poly.template @TCell {
    poly.param @N : index
    struct.def @Cell {
      struct.member @value : !felt.type {llzk.pub}
      function.def @compute() -> !struct.type<@TCell::@Cell<[@N]>> {
        %self = struct.new : !struct.type<@TCell::@Cell<[@N]>>
        function.return %self : !struct.type<@TCell::@Cell<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@TCell::@Cell<[@N]>>) { function.return }
    }
  }
  poly.template @TConsumer {
    poly.param @N : index
    struct.def @Consumer {
      function.def @compute(%arg: !struct.type<@TCell::@Cell<[1]>>) -> !struct.type<@TConsumer::@Consumer<[@N]>> {
        %self = struct.new : !struct.type<@TConsumer::@Consumer<[@N]>>
        function.return %self : !struct.type<@TConsumer::@Consumer<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@TConsumer::@Consumer<[@N]>>, %arg: !struct.type<@TCell::@Cell<[1]>>) { function.return }
    }
  }
  struct.def @Holder {
    // expected-note@+1 {{conflicting required type:}}
    struct.member @item : !struct.type<@TCell::@Cell<[0]>>
    function.def @compute() -> !struct.type<@Holder> {
      %self = struct.new : !struct.type<@Holder>
      %n = llzk.nondet : index
      // expected-error@+1 {{cannot refine nondeterministic witness because an external call requires an incompatible type}}
      %value = llzk.nondet : !struct.type<@TCell::@Cell<[#id]>>
      struct.writem %self[@item] = %value : !struct.type<@Holder>, !struct.type<@TCell::@Cell<[#id]>>
      // expected-note@+1 {{first required type:}}
      %consumer = function.call @TConsumer::@Consumer::@compute(%value){(%n)} : (!struct.type<@TCell::@Cell<[#id]>>) -> !struct.type<@TConsumer::@Consumer<[#id]>>
      function.return %self : !struct.type<@Holder>
    }
    function.def @constrain(%self: !struct.type<@Holder>) { function.return }
  }
}
