// RUN: llzk-opt -llzk-flatten -split-input-file %s | FileCheck --enable-var-scope %s

// A shape-only observation before element writes must not disqualify the candidate.
// Both dimensions fold independently, and the width constant preserves provenance.
#width = affine_map<(i, j) -> (i + j + 1)>
!Element = !pod.type<[@values: !array.type<#width x !felt.type>]>
module attributes {llzk.lang} {
  struct.def @Holder {
    struct.member @items : !array.type<1,2 x !Element>
    struct.member @height : index
    struct.member @width : index
    function.def @compute(%first: !pod.type<[@values: !array.type<1 x !felt.type>]>, %second: !pod.type<[@values: !array.type<2 x !felt.type>]>) -> !struct.type<@Holder> {
      %self = struct.new : !struct.type<@Holder>
      %c0 = arith.constant 0 : index
      %c1 = arith.constant 1 : index
      %array = array.new : !array.type<1,2 x !Element>
      %height = array.len %array, %c0 : !array.type<1,2 x !Element>
      array.write %array[%c0, %c0] = %first : !array.type<1,2 x !Element>, !pod.type<[@values: !array.type<1 x !felt.type>]>
      array.write %array[%c0, %c1] = %second : !array.type<1,2 x !Element>, !pod.type<[@values: !array.type<2 x !felt.type>]>
      %width = array.len %array, %c1 : !array.type<1,2 x !Element> {product_source = "width"}
      struct.writem %self[@height] = %height : !struct.type<@Holder>, index
      struct.writem %self[@width] = %width : !struct.type<@Holder>, index
      struct.writem %self[@items] = %array : !struct.type<@Holder>, !array.type<1,2 x !Element>
      function.return %self : !struct.type<@Holder>
    }
    function.def @constrain(%self: !struct.type<@Holder>, %first: !pod.type<[@values: !array.type<1 x !felt.type>]>, %second: !pod.type<[@values: !array.type<2 x !felt.type>]>) { function.return }
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    struct.def @Holder {
// CHECK-NEXT:      struct.member @items_0 : !pod.type<[@values: !array.type<1 x !felt.type>]>
// CHECK-NEXT:      struct.member @items_1 : !pod.type<[@values: !array.type<2 x !felt.type>]>
// CHECK-NEXT:      struct.member @height : index
// CHECK-NEXT:      struct.member @width : index
// CHECK-NEXT:      function.def @compute(%[[VAL_0:[0-9a-zA-Z_.-]+]]: !pod.type<[@values: !array.type<1 x !felt.type>]>, %[[VAL_1:[0-9a-zA-Z_.-]+]]: !pod.type<[@values: !array.type<2 x !felt.type>]>) -> !struct.type<@Holder> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_2:[0-9a-zA-Z_.-]+]] = arith.constant {product_source = "width"} 2 : index
// CHECK-NEXT:        %[[VAL_3:[0-9a-zA-Z_.-]+]] = arith.constant 1 : index
// CHECK-NEXT:        %[[VAL_4:[0-9a-zA-Z_.-]+]] = struct.new : <@Holder>
// CHECK-NEXT:        struct.writem %[[VAL_4]][@height] = %[[VAL_3]] : <@Holder>, index
// CHECK-NEXT:        struct.writem %[[VAL_4]][@width] = %[[VAL_2]] : <@Holder>, index
// CHECK-NEXT:        struct.writem %[[VAL_4]][@items_0] = %[[VAL_0]] : <@Holder>, !pod.type<[@values: !array.type<1 x !felt.type>]>
// CHECK-NEXT:        struct.writem %[[VAL_4]][@items_1] = %[[VAL_1]] : <@Holder>, !pod.type<[@values: !array.type<2 x !felt.type>]>
// CHECK-NEXT:        function.return %[[VAL_4]] : !struct.type<@Holder>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_5:[0-9a-zA-Z_.-]+]]: !struct.type<@Holder>, %[[VAL_6:[0-9a-zA-Z_.-]+]]: !pod.type<[@values: !array.type<1 x !felt.type>]>, %[[VAL_7:[0-9a-zA-Z_.-]+]]: !pod.type<[@values: !array.type<2 x !felt.type>]>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

// Initialized heterogeneous candidates support the same constant-dimension observations.
#width = affine_map<(i, j) -> (i + j + 1)>
!Element = !pod.type<[@values: !array.type<#width x !felt.type>]>
module attributes {llzk.lang} {
  struct.def @InitializedLength {
    struct.member @items : !array.type<2,1 x !Element>
    struct.member @length : index
    function.def @compute() -> !struct.type<@InitializedLength> {
      %self = struct.new : !struct.type<@InitializedLength>
      %c0 = arith.constant 0 : index
      %first = llzk.nondet : !Element
      %second = llzk.nondet : !Element
      %array = array.new %first, %second : !array.type<2,1 x !Element>
      %length = array.len %array, %c0 : !array.type<2,1 x !Element> {product_source = "initialized"}
      struct.writem %self[@length] = %length : !struct.type<@InitializedLength>, index
      struct.writem %self[@items] = %array : !struct.type<@InitializedLength>, !array.type<2,1 x !Element>
      function.return %self : !struct.type<@InitializedLength>
    }
    function.def @constrain(%self: !struct.type<@InitializedLength>) { function.return }
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    struct.def @InitializedLength {
// CHECK-NEXT:      struct.member @items_0 : !pod.type<[@values: !array.type<1 x !felt.type>]>
// CHECK-NEXT:      struct.member @items_1 : !pod.type<[@values: !array.type<2 x !felt.type>]>
// CHECK-NEXT:      struct.member @length : index
