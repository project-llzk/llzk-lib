// CHECK-NEXT:        function.return %[[VAL_1]] : !struct.type<@InitializedLength>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_4:[0-9a-zA-Z_.-]+]]: !struct.type<@InitializedLength>) attributes {function.allow_constraint} {
