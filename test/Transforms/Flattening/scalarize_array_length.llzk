// -----

// A dynamic dimension is not guessed; preserve the allocation and its observations.
#width = affine_map<(i, j) -> (i + j + 1)>
!Element = !pod.type<[@values: !array.type<#width x !felt.type>]>
module attributes {llzk.lang} {
  struct.def @DynamicLength {
    struct.member @items : !array.type<1,2 x !Element>
    struct.member @height : index
    struct.member @width : index
    function.def @compute(%dim: index, %first: !pod.type<[@values: !array.type<1 x !felt.type>]>, %second: !pod.type<[@values: !array.type<2 x !felt.type>]>) -> !struct.type<@DynamicLength> {
      %self = struct.new : !struct.type<@DynamicLength>
      %c0 = arith.constant 0 : index
      %c1 = arith.constant 1 : index
      %array = array.new : !array.type<1,2 x !Element>
      %height = array.len %array, %dim : !array.type<1,2 x !Element> {product_source = "height"}
      array.write %array[%c0, %c0] = %first : !array.type<1,2 x !Element>, !pod.type<[@values: !array.type<1 x !felt.type>]>
      array.write %array[%c0, %c1] = %second : !array.type<1,2 x !Element>, !pod.type<[@values: !array.type<2 x !felt.type>]>
      %width = array.len %array, %c1 : !array.type<1,2 x !Element> {product_source = "width"}
      struct.writem %self[@height] = %height : !struct.type<@DynamicLength>, index
      struct.writem %self[@width] = %width : !struct.type<@DynamicLength>, index
      struct.writem %self[@items] = %array : !struct.type<@DynamicLength>, !array.type<1,2 x !Element>
      function.return %self : !struct.type<@DynamicLength>
    }
    function.def @constrain(%self: !struct.type<@DynamicLength>, %dim: index, %first: !pod.type<[@values: !array.type<1 x !felt.type>]>, %second: !pod.type<[@values: !array.type<2 x !felt.type>]>) { function.return }
  }
}

// CHECK: #[[$ATTR_0:[0-9a-zA-Z_.-]+]] = affine_map<(d0, d1) -> (d0 + d1 + 1)>

