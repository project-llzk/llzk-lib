// CHECK-NEXT:        array.write %[[VAL_6]]{{\[}}%[[VAL_4]], %[[VAL_4]]] = %[[VAL_1]] : <1,2 x !pod.type<[@values: !array.type<#[[$ATTR_0]] x !felt.type>]>>, !pod.type<[@values: !array.type<1 x !felt.type>]>
// CHECK-NEXT:        array.write %[[VAL_6]]{{\[}}%[[VAL_4]], %[[VAL_3]]] = %[[VAL_2]] : <1,2 x !pod.type<[@values: !array.type<#[[$ATTR_0]] x !felt.type>]>>, !pod.type<[@values: !array.type<2 x !felt.type>]>
// CHECK-NEXT:        %[[VAL_8:[0-9a-zA-Z_.-]+]] = array.len %[[VAL_6]], %[[VAL_3]] : <1,2 x !pod.type<[@values: !array.type<#[[$ATTR_0]] x !felt.type>]>> {product_source = "width"}
// CHECK-NEXT:        struct.writem %[[VAL_5]][@height] = %[[VAL_7]] : <@DynamicLength>, index
// CHECK-NEXT:        struct.writem %[[VAL_5]][@width] = %[[VAL_8]] : <@DynamicLength>, index
// CHECK-NEXT:        struct.writem %[[VAL_5]][@items] = %[[VAL_6]] : <@DynamicLength>, !array.type<1,2 x !pod.type<[@values: !array.type<#[[$ATTR_0]] x !felt.type>]>>
// CHECK-NEXT:        function.return %[[VAL_5]] : !struct.type<@DynamicLength>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_9:[0-9a-zA-Z_.-]+]]: !struct.type<@DynamicLength>, %[[VAL_10:[0-9a-zA-Z_.-]+]]: index, %[[VAL_11:[0-9a-zA-Z_.-]+]]: !pod.type<[@values: !array.type<1 x !felt.type>]>, %[[VAL_12:[0-9a-zA-Z_.-]+]]: !pod.type<[@values: !array.type<2 x !felt.type>]>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

// A live length must not leave a generic array behind when its Cell elements instantiate.
#id = affine_map<(i) -> (i)>
!Cell = !struct.type<@TCell::@Cell<[#id]>>
module attributes {llzk.lang} {
  poly.template @TCell {
    poly.param @N : index
    struct.def @Cell {
      struct.member @value : !felt.type {column, llzk.pub}
      function.def @compute() -> !struct.type<@TCell::@Cell<[@N]>> {
        %self = struct.new : !struct.type<@TCell::@Cell<[@N]>>
        function.return %self : !struct.type<@TCell::@Cell<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@TCell::@Cell<[@N]>>) { function.return }
    }
  }
  struct.def @CellLength {
    struct.member @items : !array.type<2 x !Cell> {column}
    struct.member @length : index
    function.def @compute() -> !struct.type<@CellLength> {
      %self = struct.new : !struct.type<@CellLength>
      %c0 = arith.constant 0 : index
      %c1 = arith.constant 1 : index
      %array = array.new : !array.type<2 x !Cell>
      %first = function.call @TCell::@Cell::@compute() : () -> !struct.type<@TCell::@Cell<[0]>>
      %second = function.call @TCell::@Cell::@compute() : () -> !struct.type<@TCell::@Cell<[1]>>
      array.write %array[%c0] = %first : !array.type<2 x !Cell>, !struct.type<@TCell::@Cell<[0]>>
      array.write %array[%c1] = %second : !array.type<2 x !Cell>, !struct.type<@TCell::@Cell<[1]>>
      %length = array.len %array, %c0 : !array.type<2 x !Cell>
      struct.writem %self[@length] = %length : !struct.type<@CellLength>, index
      struct.writem %self[@items] = %array : !struct.type<@CellLength>, !array.type<2 x !Cell>
      function.return %self : !struct.type<@CellLength>
    }
    function.def @constrain(%self: !struct.type<@CellLength>) { function.return }
  }
}

