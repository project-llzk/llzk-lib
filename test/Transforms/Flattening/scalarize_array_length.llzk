// CHECK-NEXT:        %[[VAL_0:[0-9a-zA-Z_.-]+]] = arith.constant {product_source = "initialized"} 2 : index
// CHECK-NEXT:        %[[VAL_1:[0-9a-zA-Z_.-]+]] = struct.new : <@InitializedLength>
// CHECK-NEXT:        %[[VAL_2:[0-9a-zA-Z_.-]+]] = llzk.nondet : !pod.type<[@values: !array.type<1 x !felt.type>]>
