// RUN: llzk-opt -llzk-flatten -verify-each=false %s -o /dev/null
// RUN: llzk-opt -llzk-flatten -verify-diagnostics %s

// The input equality unifies while both allocations have generic element types.
// Independent writes refine the allocations in the same batch to felt and index
// arrays. Flattening completes (with verification disabled), but post-pass IR
// verification must reject the resulting equality between incompatible types.
module attributes {llzk.lang} {
  poly.template @Caller {
    poly.param @T
    function.def @caller(%a: !felt.type, %b: index) attributes {function.allow_constraint} {
      %aa = array.new : !array.type<1 x !poly.tvar<@T>>
      %bb = array.new : !array.type<1 x !poly.tvar<@T>>
      %c0 = arith.constant 0 : index
      array.write %aa[%c0] = %a : !array.type<1 x !poly.tvar<@T>>, !felt.type
      array.write %bb[%c0] = %b : !array.type<1 x !poly.tvar<@T>>, index
      // expected-error@+1 {{'constrain.eq' op failed to verify that rhs type matches with lhs type}}
      constrain.eq %aa, %bb : !array.type<1 x !poly.tvar<@T>>, !array.type<1 x !poly.tvar<@T>>
      function.return
    }
  }
}
