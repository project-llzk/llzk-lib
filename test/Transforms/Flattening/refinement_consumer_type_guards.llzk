// RUN: llzk-opt -split-input-file -llzk-flatten -verify-diagnostics %s | FileCheck %s

module attributes {llzk.lang} {
  function.def @consume3x3(%value: !array.type<3,3 x !felt.type>) {
    function.return
  }

  struct.def @Holder {
    struct.member @items : !array.type<?,? x !felt.type> {column}

    function.def @compute() -> !struct.type<@Holder> {
      %self = struct.new : !struct.type<@Holder>
      %source = array.new : !array.type<2,2 x !felt.type>
      %first = poly.unifiable_cast %source : (!array.type<2,2 x !felt.type>) -> !array.type<2,? x !felt.type>
      %second = poly.unifiable_cast %source : (!array.type<2,2 x !felt.type>) -> !array.type<?,2 x !felt.type>
      // The complementary writes refine @items to 2 x 2.
      struct.writem %self[@items] = %first : !struct.type<@Holder>, !array.type<2,? x !felt.type>
      struct.writem %self[@items] = %second : !struct.type<@Holder>, !array.type<?,2 x !felt.type>
      // This generic read instead feeds a call whose declared parameter requires 3 x 3.
      %read = struct.readm %self[@items] : !struct.type<@Holder>, !array.type<?,? x !felt.type>
      function.call @consume3x3(%read) : (!array.type<?,? x !felt.type>) -> ()
      function.return %self : !struct.type<@Holder>
    }

    function.def @constrain(%self: !struct.type<@Holder>) {
      function.return
    }
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @consume3x3(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !array.type<3,3 x !felt.type>) {
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:    struct.def @Holder {
// CHECK-NEXT:      struct.member @items : !array.type<?,? x !felt.type> {column}
// CHECK-NEXT:      function.def @compute() -> !struct.type<@Holder> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_1:[0-9a-zA-Z_\.]+]] = struct.new : <@Holder>
// CHECK-NEXT:        %[[VAL_2:[0-9a-zA-Z_\.]+]] = array.new  : <2,2 x !felt.type>
// CHECK-NEXT:        %[[VAL_3:[0-9a-zA-Z_\.]+]] = poly.unifiable_cast %[[VAL_2]] : (!array.type<2,2 x !felt.type>) -> !array.type<?,? x !felt.type>
// CHECK-NEXT:        %[[VAL_4:[0-9a-zA-Z_\.]+]] = poly.unifiable_cast %[[VAL_2]] : (!array.type<2,2 x !felt.type>) -> !array.type<?,? x !felt.type>
// CHECK-NEXT:        struct.writem %[[VAL_1]][@items] = %[[VAL_3]] : <@Holder>, !array.type<?,? x !felt.type>
// CHECK-NEXT:        struct.writem %[[VAL_1]][@items] = %[[VAL_4]] : <@Holder>, !array.type<?,? x !felt.type>
// CHECK-NEXT:        %[[VAL_5:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_1]][@items] : <@Holder>, !array.type<?,? x !felt.type>
// CHECK-NEXT:        function.call @consume3x3(%[[VAL_5]]) : (!array.type<?,? x !felt.type>) -> ()
// CHECK-NEXT:        function.return %[[VAL_1]] : !struct.type<@Holder>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_6:[0-9a-zA-Z_\.]+]]: !struct.type<@Holder>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

// A generic member read can participate in constrain.eq with an independently concrete value.
// Refining the member to array<0> must not retag the read, because constrain.eq's other operand
// remains array<1> and is not updated by member-read propagation.
module attributes {llzk.lang} {
  poly.template @THolder {
    poly.param @T

    struct.def @Holder {
      struct.member @value : !poly.tvar<@T> {column}

      function.def @compute() -> !struct.type<@THolder::@Holder<[@T]>> {
        %self = struct.new : !struct.type<@THolder::@Holder<[@T]>>
        %zero = array.new : !array.type<0 x !felt.type>
        struct.writem %self[@value] = %zero : !struct.type<@THolder::@Holder<[@T]>>, !array.type<0 x !felt.type>
        function.return %self : !struct.type<@THolder::@Holder<[@T]>>
      }

      function.def @constrain(%self: !struct.type<@THolder::@Holder<[@T]>>) {
        %read = struct.readm %self[@value] : !struct.type<@THolder::@Holder<[@T]>>, !poly.tvar<@T>
        %one = array.new : !array.type<1 x !felt.type>
        constrain.eq %read, %one : !poly.tvar<@T>, !array.type<1 x !felt.type>
        function.return
      }
    }
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    poly.template @THolder {
// CHECK-NEXT:      poly.param @T
// CHECK-NEXT:      struct.def @Holder {
// CHECK-NEXT:        struct.member @value : !poly.tvar<@T> {column}
// CHECK-NEXT:        function.def @compute() -> !struct.type<@THolder::@Holder<[@T]>> attributes {function.allow_witness} {
// CHECK-NEXT:          %[[VAL_0:[0-9a-zA-Z_\.]+]] = struct.new : <@THolder::@Holder<[@T]>>
// CHECK-NEXT:          %[[VAL_1:[0-9a-zA-Z_\.]+]] = array.new  : <0 x !felt.type>
// CHECK-NEXT:          struct.writem %[[VAL_0]][@value] = %[[VAL_1]] : <@THolder::@Holder<[@T]>>, !array.type<0 x !felt.type>
// CHECK-NEXT:          function.return %[[VAL_0]] : !struct.type<@THolder::@Holder<[@T]>>
// CHECK-NEXT:        }
// CHECK-NEXT:        function.def @constrain(%[[VAL_2:[0-9a-zA-Z_\.]+]]: !struct.type<@THolder::@Holder<[@T]>>) attributes {function.allow_constraint} {
// CHECK-NEXT:          %[[VAL_3:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_2]][@value] : <@THolder::@Holder<[@T]>>, !poly.tvar<@T>
// CHECK-NEXT:          %[[VAL_4:[0-9a-zA-Z_\.]+]] = array.new  : <1 x !felt.type>
// CHECK-NEXT:          constrain.eq %[[VAL_3]], %[[VAL_4]] : !poly.tvar<@T>, !array.type<1 x !felt.type>
// CHECK-NEXT:          function.return
// CHECK-NEXT:        }
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

// A concrete member write can refine this generic read to Cell<0>, but the read also feeds a cast
// with independently concrete Cell<1> output. Because the cast result has a non-member-write
// consumer, its result cannot be retagged to repair that refinement. Keep the member/read generic
// so the cast remains valid.
module attributes {llzk.lang} {
  poly.template @TCell {
    poly.param @N : index

    struct.def @Cell {
      struct.member @value : !felt.type {column}

      function.def @compute() -> !struct.type<@TCell::@Cell<[@N]>> {
        %self = struct.new : !struct.type<@TCell::@Cell<[@N]>>
        function.return %self : !struct.type<@TCell::@Cell<[@N]>>
      }

      function.def @constrain(%self: !struct.type<@TCell::@Cell<[@N]>>) {
        function.return
      }
    }
  }

  function.def @consume1(%value: !struct.type<@TCell::@Cell<[1]>>) {
    function.return
  }

  poly.template @THolder {
    poly.param @T

    struct.def @Holder {
      struct.member @value : !poly.tvar<@T> {column}

      function.def @compute() -> !struct.type<@THolder::@Holder<[@T]>> {
        %self = struct.new : !struct.type<@THolder::@Holder<[@T]>>
        %item0 = function.call @TCell::@Cell::@compute() : () -> !struct.type<@TCell::@Cell<[0]>>
        struct.writem %self[@value] = %item0 : !struct.type<@THolder::@Holder<[@T]>>, !struct.type<@TCell::@Cell<[0]>>
        %read = struct.readm %self[@value] : !struct.type<@THolder::@Holder<[@T]>>, !poly.tvar<@T>
        %as1 = poly.unifiable_cast %read : (!poly.tvar<@T>) -> !struct.type<@TCell::@Cell<[1]>>
        function.call @consume1(%as1) : (!struct.type<@TCell::@Cell<[1]>>) -> ()
        function.return %self : !struct.type<@THolder::@Holder<[@T]>>
      }

      function.def @constrain(%self: !struct.type<@THolder::@Holder<[@T]>>) {
        function.return
      }
    }
  }
}
