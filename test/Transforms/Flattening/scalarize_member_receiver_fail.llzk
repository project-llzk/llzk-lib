// RUN: llzk-opt -llzk-flatten -split-input-file -verify-diagnostics %s

// A concrete member result must agree with the receiver selected for this index.
#id = affine_map<(i) -> (i)>
module attributes {llzk.lang} {
  poly.template @TCell {
    poly.param @N : index
    struct.def @Cell {
      struct.member @value : !felt.type {llzk.pub}
      function.def @compute() -> !struct.type<@TCell::@Cell<[@N]>> {
        %self = struct.new : !struct.type<@TCell::@Cell<[@N]>>
        function.return %self : !struct.type<@TCell::@Cell<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@TCell::@Cell<[@N]>>) { function.return }
    }
  }
  poly.template @TBox {
    poly.param @N : index
    struct.def @Box {
      struct.member @cell : !struct.type<@TCell::@Cell<[@N]>> {llzk.pub}
      function.def @compute() -> !struct.type<@TBox::@Box<[@N]>> {
        %self = struct.new : !struct.type<@TBox::@Box<[@N]>>
        function.return %self : !struct.type<@TBox::@Box<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@TBox::@Box<[@N]>>) { function.return }
    }
  }
  function.def @consume(%arg: !struct.type<@TCell::@Cell<[1]>>) { function.return }
  function.def @entry() attributes {function.allow_witness} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %box0 = function.call @TBox::@Box::@compute() : () -> !struct.type<@TBox::@Box<[0]>>
    %box1 = function.call @TBox::@Box::@compute() : () -> !struct.type<@TBox::@Box<[1]>>
    %boxes = array.new : !array.type<2 x !struct.type<@TBox::@Box<[#id]>>>
    array.write %boxes[%zero] = %box0 : !array.type<2 x !struct.type<@TBox::@Box<[#id]>>>, !struct.type<@TBox::@Box<[0]>>
    array.write %boxes[%one] = %box1 : !array.type<2 x !struct.type<@TBox::@Box<[#id]>>>, !struct.type<@TBox::@Box<[1]>>
    // expected-error@+1 {{cannot scalarize heterogeneous array read because its index-specific receiver type is incompatible with a member read}}
    %box = array.read %boxes[%zero] : !array.type<2 x !struct.type<@TBox::@Box<[#id]>>>, !struct.type<@TBox::@Box<[#id]>>
    // expected-note@+1 {{member read requires}}
    %cell = struct.readm %box[@cell] : !struct.type<@TBox::@Box<[#id]>>, !struct.type<@TCell::@Cell<[1]>>
    function.call @consume(%cell) : (!struct.type<@TCell::@Cell<[1]>>) -> ()
    function.return
  }
}

// -----

// A generic member result must also remain compatible with its downstream consumers.
#id = affine_map<(i) -> (i)>
module attributes {llzk.lang} {
  poly.template @TCell {
    poly.param @N : index
    struct.def @Cell {
      struct.member @value : !felt.type {llzk.pub}
      function.def @compute() -> !struct.type<@TCell::@Cell<[@N]>> {
        %self = struct.new : !struct.type<@TCell::@Cell<[@N]>>
        function.return %self : !struct.type<@TCell::@Cell<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@TCell::@Cell<[@N]>>) { function.return }
    }
  }
  poly.template @TBox {
    poly.param @N : index
    struct.def @Box {
      struct.member @cell : !struct.type<@TCell::@Cell<[@N]>> {llzk.pub}
      function.def @compute() -> !struct.type<@TBox::@Box<[@N]>> {
        %self = struct.new : !struct.type<@TBox::@Box<[@N]>>
        function.return %self : !struct.type<@TBox::@Box<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@TBox::@Box<[@N]>>) { function.return }
    }
  }
  function.def @consume(%arg: !struct.type<@TCell::@Cell<[1]>>) { function.return }
  function.def @entry() attributes {function.allow_witness} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %box0 = function.call @TBox::@Box::@compute() : () -> !struct.type<@TBox::@Box<[0]>>
    %box1 = function.call @TBox::@Box::@compute() : () -> !struct.type<@TBox::@Box<[1]>>
    %boxes = array.new : !array.type<2 x !struct.type<@TBox::@Box<[#id]>>>
    array.write %boxes[%zero] = %box0 : !array.type<2 x !struct.type<@TBox::@Box<[#id]>>>, !struct.type<@TBox::@Box<[0]>>
    array.write %boxes[%one] = %box1 : !array.type<2 x !struct.type<@TBox::@Box<[#id]>>>, !struct.type<@TBox::@Box<[1]>>
    // expected-error@+1 {{cannot scalarize heterogeneous array read because its index-specific receiver type is incompatible with a member read}}
    %box = array.read %boxes[%zero] : !array.type<2 x !struct.type<@TBox::@Box<[#id]>>>, !struct.type<@TBox::@Box<[#id]>>
    // expected-note@+1 {{member read requires}}
    %cell = struct.readm %box[@cell] : !struct.type<@TBox::@Box<[#id]>>, !struct.type<@TCell::@Cell<[#id]>>
    function.call @consume(%cell) : (!struct.type<@TCell::@Cell<[#id]>>) -> ()
    function.return
  }
}
