// An unrelated generic write provides no concrete binding and must not block this refinement.
module attributes {llzk.lang} {
  poly.template @UnrelatedGeneric {
    poly.param @T
    poly.param @U
    poly.param @V
    struct.def @Holder {
      struct.member @first : !poly.tvar<@T>
      struct.member @second : !array.type<1 x !poly.tvar<@U>>
      struct.member @source : !poly.tvar<@V>
      function.def @compute(%a: !felt.type) -> !struct.type<@UnrelatedGeneric::@Holder<[@T, @U, @V]>> {
        %self = struct.new : !struct.type<@UnrelatedGeneric::@Holder<[@T, @U, @V]>>
        struct.writem %self[@first] = %a : !struct.type<@UnrelatedGeneric::@Holder<[@T, @U, @V]>>, !felt.type
        %b = struct.readm %self[@source] : !struct.type<@UnrelatedGeneric::@Holder<[@T, @U, @V]>>, !poly.tvar<@V>
        struct.writem %self[@second] = %b : !struct.type<@UnrelatedGeneric::@Holder<[@T, @U, @V]>>, !poly.tvar<@V>
        function.return %self : !struct.type<@UnrelatedGeneric::@Holder<[@T, @U, @V]>>
      }
      function.def @constrain(%self: !struct.type<@UnrelatedGeneric::@Holder<[@T, @U, @V]>>, %a: !felt.type) {
        function.return
      }
    }
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    poly.template @UnrelatedGeneric {
// CHECK-NEXT:      poly.param @T
// CHECK-NEXT:      poly.param @U
// CHECK-NEXT:      poly.param @V
// CHECK-NEXT:      struct.def @Holder {
// CHECK-NEXT:        struct.member @first : !felt.type
// CHECK-NEXT:        struct.member @second : !array.type<1 x !poly.tvar<@U>>
// CHECK-NEXT:        struct.member @source : !poly.tvar<@V>
// CHECK-NEXT:        function.def @compute(%[[VAL_0:[0-9a-zA-Z_.-]+]]: !felt.type) -> !struct.type<@UnrelatedGeneric::@Holder<[@T, @U, @V]>> attributes {function.allow_witness} {
// CHECK-NEXT:          %[[VAL_1:[0-9a-zA-Z_.-]+]] = struct.new : <@UnrelatedGeneric::@Holder<[@T, @U, @V]>>
// CHECK-NEXT:          struct.writem %[[VAL_1]][@first] = %[[VAL_0]] : <@UnrelatedGeneric::@Holder<[@T, @U, @V]>>, !felt.type
// CHECK-NEXT:          %[[VAL_2:[0-9a-zA-Z_.-]+]] = struct.readm %[[VAL_1]][@source] : <@UnrelatedGeneric::@Holder<[@T, @U, @V]>>, !poly.tvar<@V>
// CHECK-NEXT:          struct.writem %[[VAL_1]][@second] = %[[VAL_2]] : <@UnrelatedGeneric::@Holder<[@T, @U, @V]>>, !poly.tvar<@V>
// CHECK-NEXT:          function.return %[[VAL_1]] : !struct.type<@UnrelatedGeneric::@Holder<[@T, @U, @V]>>
// CHECK-NEXT:        }
// CHECK-NEXT:        function.def @constrain(%[[VAL_3:[0-9a-zA-Z_.-]+]]: !struct.type<@UnrelatedGeneric::@Holder<[@T, @U, @V]>>, %[[VAL_4:[0-9a-zA-Z_.-]+]]: !felt.type) attributes {function.allow_constraint} {
// CHECK-NEXT:          function.return
// CHECK-NEXT:        }
// CHECK-NEXT:      }
// CHECK-NEXT:    }
