// An unknown unrelated field inside a related POD must not block the shared T binding.
module attributes {llzk.lang} {
  poly.template @UnrelatedNestedGeneric {
    poly.param @T
    poly.param @U
    poly.param @V
    struct.def @Holder {
      struct.member @first : !poly.tvar<@T>
      struct.member @second : !pod.type<[@first: !poly.tvar<@T>, @second: !array.type<1 x !poly.tvar<@U>>]>
      struct.member @source : !pod.type<[@first: !felt.type, @second: !poly.tvar<@V>]>
      function.def @compute(%a: !felt.type) -> !struct.type<@UnrelatedNestedGeneric::@Holder<[@T, @U, @V]>> {
        %self = struct.new : !struct.type<@UnrelatedNestedGeneric::@Holder<[@T, @U, @V]>>
        struct.writem %self[@first] = %a : !struct.type<@UnrelatedNestedGeneric::@Holder<[@T, @U, @V]>>, !felt.type
        %b = struct.readm %self[@source] : !struct.type<@UnrelatedNestedGeneric::@Holder<[@T, @U, @V]>>, !pod.type<[@first: !felt.type, @second: !poly.tvar<@V>]>
        struct.writem %self[@second] = %b : !struct.type<@UnrelatedNestedGeneric::@Holder<[@T, @U, @V]>>, !pod.type<[@first: !felt.type, @second: !poly.tvar<@V>]>
        function.return %self : !struct.type<@UnrelatedNestedGeneric::@Holder<[@T, @U, @V]>>
      }
      function.def @constrain(%self: !struct.type<@UnrelatedNestedGeneric::@Holder<[@T, @U, @V]>>, %a: !felt.type) {
        function.return
