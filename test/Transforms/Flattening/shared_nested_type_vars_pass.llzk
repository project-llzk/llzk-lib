// Repeated POD occurrences with equal bindings remain valid.
module attributes {llzk.lang} {
  poly.template @RepeatedPodConsistent {
    poly.param @T
    struct.def @Holder {
      struct.member @member0 : !pod.type<[@first: !poly.tvar<@T>, @second: !poly.tvar<@T>]>
      function.def @compute(%v0: !pod.type<[@first: !felt.type, @second: !felt.type]>) -> !struct.type<@RepeatedPodConsistent::@Holder<[@T]>> {
        %self = struct.new : !struct.type<@RepeatedPodConsistent::@Holder<[@T]>>
        struct.writem %self[@member0] = %v0 : !struct.type<@RepeatedPodConsistent::@Holder<[@T]>>, !pod.type<[@first: !felt.type, @second: !felt.type]>
        function.return %self : !struct.type<@RepeatedPodConsistent::@Holder<[@T]>>
      }
      function.def @constrain(%self: !struct.type<@RepeatedPodConsistent::@Holder<[@T]>>, %v0: !pod.type<[@first: !felt.type, @second: !felt.type]>) {
        function.return
      }
    }
  }
}

