// Bare type-valued struct parameters share their binding with nested array elements.
module attributes {llzk.lang} {
  poly.template @Box {
    poly.param @U
    struct.def @Box {
      struct.member @value : !poly.tvar<@U>
      function.def @compute() -> !struct.type<@Box::@Box<[@U]>> {
        %self = struct.new : !struct.type<@Box::@Box<[@U]>>
        function.return %self : !struct.type<@Box::@Box<[@U]>>
      }
      function.def @constrain(%self: !struct.type<@Box::@Box<[@U]>>) { function.return }
    }
  }
  poly.template @StructConsistent {
    poly.param @T
    struct.def @Holder {
      struct.member @member0 : !struct.type<@Box::@Box<[@T]>>
      struct.member @member1 : !array.type<2 x !poly.tvar<@T>>
      function.def @compute(%v0: !struct.type<@Box::@Box<[!felt.type]>>, %v1: !array.type<2 x !felt.type>) -> !struct.type<@StructConsistent::@Holder<[@T]>> {
        %self = struct.new : !struct.type<@StructConsistent::@Holder<[@T]>>
        struct.writem %self[@member0] = %v0 : !struct.type<@StructConsistent::@Holder<[@T]>>, !struct.type<@Box::@Box<[!felt.type]>>
        struct.writem %self[@member1] = %v1 : !struct.type<@StructConsistent::@Holder<[@T]>>, !array.type<2 x !felt.type>
        function.return %self : !struct.type<@StructConsistent::@Holder<[@T]>>
      }
      function.def @constrain(%self: !struct.type<@StructConsistent::@Holder<[@T]>>, %v0: !struct.type<@Box::@Box<[!felt.type]>>, %v1: !array.type<2 x !felt.type>) {
        function.return
      }
    }
  }
}

