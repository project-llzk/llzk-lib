// A related aggregate write still has generic type V, so defer the shared T refinement until its binding is known.
module attributes {llzk.lang} {
  poly.template @RelatedGeneric {
    poly.param @T
    poly.param @V
    struct.def @Holder {
      struct.member @first : !poly.tvar<@T>
      struct.member @second : !array.type<1 x !poly.tvar<@T>>
      struct.member @source : !poly.tvar<@V>
      function.def @compute(%a: !felt.type) -> !struct.type<@RelatedGeneric::@Holder<[@T, @V]>> {
        %self = struct.new : !struct.type<@RelatedGeneric::@Holder<[@T, @V]>>
        struct.writem %self[@first] = %a : !struct.type<@RelatedGeneric::@Holder<[@T, @V]>>, !felt.type
        %b = struct.readm %self[@source] : !struct.type<@RelatedGeneric::@Holder<[@T, @V]>>, !poly.tvar<@V>
        struct.writem %self[@second] = %b : !struct.type<@RelatedGeneric::@Holder<[@T, @V]>>, !poly.tvar<@V>
        function.return %self : !struct.type<@RelatedGeneric::@Holder<[@T, @V]>>
      }
      function.def @constrain(%self: !struct.type<@RelatedGeneric::@Holder<[@T, @V]>>, %a: !felt.type) {
        function.return
      }
    }
  }
}

