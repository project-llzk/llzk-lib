// CHECK-NEXT:    poly.template @DifferentArrayShapes {
// CHECK-NEXT:      poly.param @T
// CHECK-NEXT:      struct.def @Holder {
// CHECK-NEXT:        struct.member @member0 : !array.type<1 x !felt.type>
// CHECK-NEXT:        struct.member @member1 : !array.type<2 x !felt.type>
// CHECK-NEXT:        function.def @compute(%[[VAL_0:[0-9a-zA-Z_.-]+]]: !array.type<1 x !felt.type>, %[[VAL_1:[0-9a-zA-Z_.-]+]]: !array.type<2 x !felt.type>) -> !struct.type<@DifferentArrayShapes::@Holder<[@T]>> attributes {function.allow_witness} {
// CHECK-NEXT:          %[[VAL_2:[0-9a-zA-Z_.-]+]] = struct.new : <@DifferentArrayShapes::@Holder<[@T]>>
// CHECK-NEXT:          struct.writem %[[VAL_2]][@member0] = %[[VAL_0]] : <@DifferentArrayShapes::@Holder<[@T]>>, !array.type<1 x !felt.type>
// CHECK-NEXT:          struct.writem %[[VAL_2]][@member1] = %[[VAL_1]] : <@DifferentArrayShapes::@Holder<[@T]>>, !array.type<2 x !felt.type>
// CHECK-NEXT:          function.return %[[VAL_2]] : !struct.type<@DifferentArrayShapes::@Holder<[@T]>>
// CHECK-NEXT:        }
// CHECK-NEXT:        function.def @constrain(%[[VAL_3:[0-9a-zA-Z_.-]+]]: !struct.type<@DifferentArrayShapes::@Holder<[@T]>>, %[[VAL_4:[0-9a-zA-Z_.-]+]]: !array.type<1 x !felt.type>, %[[VAL_5:[0-9a-zA-Z_.-]+]]: !array.type<2 x !felt.type>) attributes {function.allow_constraint} {
// CHECK-NEXT:          function.return
// CHECK-NEXT:        }
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }

