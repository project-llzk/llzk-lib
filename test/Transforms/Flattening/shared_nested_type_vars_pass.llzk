// One binding can appear both directly and inside an aggregate.
module attributes {llzk.lang} {
  poly.template @NestedDirectConsistent {
    poly.param @T
    struct.def @Holder {
      struct.member @member0 : !array.type<2 x !poly.tvar<@T>>
      struct.member @member1 : !poly.tvar<@T>
      function.def @compute(%v0: !array.type<2 x !felt.type>, %v1: !felt.type) -> !struct.type<@NestedDirectConsistent::@Holder<[@T]>> {
        %self = struct.new : !struct.type<@NestedDirectConsistent::@Holder<[@T]>>
        struct.writem %self[@member0] = %v0 : !struct.type<@NestedDirectConsistent::@Holder<[@T]>>, !array.type<2 x !felt.type>
        struct.writem %self[@member1] = %v1 : !struct.type<@NestedDirectConsistent::@Holder<[@T]>>, !felt.type
        function.return %self : !struct.type<@NestedDirectConsistent::@Holder<[@T]>>
      }
      function.def @constrain(%self: !struct.type<@NestedDirectConsistent::@Holder<[@T]>>, %v0: !array.type<2 x !felt.type>, %v1: !felt.type) {
        function.return
      }
    }
  }
}

