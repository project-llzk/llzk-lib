// Distinct parameters remain independent.
module attributes {llzk.lang} {
  poly.template @IndependentVariables {
    poly.param @T
    poly.param @U
    struct.def @Holder {
      struct.member @member0 : !array.type<1 x !poly.tvar<@T>>
      struct.member @member1 : !array.type<2 x !poly.tvar<@U>>
      function.def @compute(%v0: !array.type<1 x !felt.type>, %v1: !array.type<2 x index>) -> !struct.type<@IndependentVariables::@Holder<[@T, @U]>> {
        %self = struct.new : !struct.type<@IndependentVariables::@Holder<[@T, @U]>>
        struct.writem %self[@member0] = %v0 : !struct.type<@IndependentVariables::@Holder<[@T, @U]>>, !array.type<1 x !felt.type>
        struct.writem %self[@member1] = %v1 : !struct.type<@IndependentVariables::@Holder<[@T, @U]>>, !array.type<2 x index>
        function.return %self : !struct.type<@IndependentVariables::@Holder<[@T, @U]>>
      }
      function.def @constrain(%self: !struct.type<@IndependentVariables::@Holder<[@T, @U]>>, %v0: !array.type<1 x !felt.type>, %v1: !array.type<2 x index>) {
        function.return
      }
    }
  }
}

