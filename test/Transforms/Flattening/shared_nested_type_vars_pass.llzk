// A namespaced concrete struct named T is not a reference to the template parameter T.
module attributes {llzk.lang} {
  module @Other {
    struct.def @T {
      function.def @compute() -> !struct.type<@Other::@T> {
        %self = struct.new : !struct.type<@Other::@T>
        function.return %self : !struct.type<@Other::@T>
      }
      function.def @constrain(%self: !struct.type<@Other::@T>) { function.return }
    }
  }
  poly.template @UnrelatedStructNamedT {
    poly.param @T
    poly.param @V
    struct.def @Holder {
      struct.member @first : !poly.tvar<@T>
      struct.member @second : !struct.type<@Other::@T>
      struct.member @source : !poly.tvar<@V>
      function.def @compute(%a: !felt.type) -> !struct.type<@UnrelatedStructNamedT::@Holder<[@T, @V]>> {
        %self = struct.new : !struct.type<@UnrelatedStructNamedT::@Holder<[@T, @V]>>
        struct.writem %self[@first] = %a : !struct.type<@UnrelatedStructNamedT::@Holder<[@T, @V]>>, !felt.type
        %b = struct.readm %self[@source] : !struct.type<@UnrelatedStructNamedT::@Holder<[@T, @V]>>, !poly.tvar<@V>
        struct.writem %self[@second] = %b : !struct.type<@UnrelatedStructNamedT::@Holder<[@T, @V]>>, !poly.tvar<@V>
        function.return %self : !struct.type<@UnrelatedStructNamedT::@Holder<[@T, @V]>>
      }
      function.def @constrain(%self: !struct.type<@UnrelatedStructNamedT::@Holder<[@T, @V]>>, %a: !felt.type) {
        function.return
      }
    }
  }
}

