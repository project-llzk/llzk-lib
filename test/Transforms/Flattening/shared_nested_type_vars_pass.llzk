// RUN: llzk-opt -split-input-file -llzk-flatten -verify-diagnostics %s | FileCheck %s --enable-var-scope

// Surrounding array shapes may differ while the shared element binding agrees.
module attributes {llzk.lang} {
  poly.template @DifferentArrayShapes {
    poly.param @T
    struct.def @Holder {
      struct.member @member0 : !array.type<1 x !poly.tvar<@T>>
      struct.member @member1 : !array.type<2 x !poly.tvar<@T>>
      function.def @compute(%v0: !array.type<1 x !felt.type>, %v1: !array.type<2 x !felt.type>) -> !struct.type<@DifferentArrayShapes::@Holder<[@T]>> {
        %self = struct.new : !struct.type<@DifferentArrayShapes::@Holder<[@T]>>
        struct.writem %self[@member0] = %v0 : !struct.type<@DifferentArrayShapes::@Holder<[@T]>>, !array.type<1 x !felt.type>
        struct.writem %self[@member1] = %v1 : !struct.type<@DifferentArrayShapes::@Holder<[@T]>>, !array.type<2 x !felt.type>
        function.return %self : !struct.type<@DifferentArrayShapes::@Holder<[@T]>>
      }
      function.def @constrain(%self: !struct.type<@DifferentArrayShapes::@Holder<[@T]>>, %v0: !array.type<1 x !felt.type>, %v1: !array.type<2 x !felt.type>) {
        function.return
      }
    }
  }
}

