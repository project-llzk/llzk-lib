// An unchanged U binding in the candidate must not make unrelated generic U writes block T.
module attributes {llzk.lang} {
  poly.template @UnchangedCandidateVariable {
    poly.param @T
    poly.param @U
    poly.param @V
    struct.def @Holder {
      struct.member @first : !pod.type<[@first: !poly.tvar<@T>, @second: !poly.tvar<@U>]>
      struct.member @second : !array.type<1 x !poly.tvar<@U>>
      struct.member @source : !poly.tvar<@V>
      function.def @compute(%a: !pod.type<[@first: !felt.type, @second: !poly.tvar<@U>]>) -> !struct.type<@UnchangedCandidateVariable::@Holder<[@T, @U, @V]>> {
        %self = struct.new : !struct.type<@UnchangedCandidateVariable::@Holder<[@T, @U, @V]>>
        struct.writem %self[@first] = %a : !struct.type<@UnchangedCandidateVariable::@Holder<[@T, @U, @V]>>, !pod.type<[@first: !felt.type, @second: !poly.tvar<@U>]>
        %b = struct.readm %self[@source] : !struct.type<@UnchangedCandidateVariable::@Holder<[@T, @U, @V]>>, !poly.tvar<@V>
        struct.writem %self[@second] = %b : !struct.type<@UnchangedCandidateVariable::@Holder<[@T, @U, @V]>>, !poly.tvar<@V>
        function.return %self : !struct.type<@UnchangedCandidateVariable::@Holder<[@T, @U, @V]>>
      }
      function.def @constrain(%self: !struct.type<@UnchangedCandidateVariable::@Holder<[@T, @U, @V]>>, %a: !pod.type<[@first: !felt.type, @second: !poly.tvar<@U>]>) {
        function.return
      }
    }
  }
}

