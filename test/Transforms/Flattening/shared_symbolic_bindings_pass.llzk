// An unchanged U binding and an unrelated symbolic write must not delay refinement of T.
module attributes {llzk.lang} {
  poly.template @UnrelatedIdentity {
    poly.param @T
    poly.param @U
    poly.param @V
    struct.def @Holder {
      struct.member @first : !poly.tvar<@T>
      struct.member @second : !pod.type<[@known: !poly.tvar<@T>, @identity: !poly.tvar<@U>]>
      struct.member @unrelated : !poly.tvar<@U>
      struct.member @source : !poly.tvar<@V>
      function.def @compute(%a: !felt.type, %pair: !pod.type<[@known: !felt.type, @identity: !poly.tvar<@U>]>) -> !struct.type<@UnrelatedIdentity::@Holder<[@T, @U, @V]>> {
        %self = struct.new : !struct.type<@UnrelatedIdentity::@Holder<[@T, @U, @V]>>
        struct.writem %self[@first] = %a : !struct.type<@UnrelatedIdentity::@Holder<[@T, @U, @V]>>, !felt.type
        struct.writem %self[@second] = %pair : !struct.type<@UnrelatedIdentity::@Holder<[@T, @U, @V]>>, !pod.type<[@known: !felt.type, @identity: !poly.tvar<@U>]>
        %other = struct.readm %self[@source] : !struct.type<@UnrelatedIdentity::@Holder<[@T, @U, @V]>>, !poly.tvar<@V>
        struct.writem %self[@unrelated] = %other : !struct.type<@UnrelatedIdentity::@Holder<[@T, @U, @V]>>, !poly.tvar<@V>
        function.return %self : !struct.type<@UnrelatedIdentity::@Holder<[@T, @U, @V]>>
      }
      function.def @constrain(%self: !struct.type<@UnrelatedIdentity::@Holder<[@T, @U, @V]>>, %a: !felt.type, %pair: !pod.type<[@known: !felt.type, @identity: !poly.tvar<@U>]>) { function.return }
    }
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    poly.template @UnrelatedIdentity {
// CHECK-NEXT:      poly.param @T
// CHECK-NEXT:      poly.param @U
// CHECK-NEXT:      poly.param @V
// CHECK-NEXT:      struct.def @Holder {
// CHECK-NEXT:        struct.member @first : !felt.type
// CHECK-NEXT:        struct.member @second : !pod.type<[@known: !felt.type, @identity: !poly.tvar<@U>]>
// CHECK-NEXT:        struct.member @unrelated : !poly.tvar<@U>
// CHECK-NEXT:        struct.member @source : !poly.tvar<@V>
// CHECK-NEXT:        function.def @compute(%[[VAL_0:[0-9a-zA-Z_.-]+]]: !felt.type, %[[VAL_1:[0-9a-zA-Z_.-]+]]: !pod.type<[@known: !felt.type, @identity: !poly.tvar<@U>]>) -> !struct.type<@UnrelatedIdentity::@Holder<[@T, @U, @V]>> attributes {function.allow_witness} {
// CHECK-NEXT:          %[[VAL_2:[0-9a-zA-Z_.-]+]] = struct.new : <@UnrelatedIdentity::@Holder<[@T, @U, @V]>>
// CHECK-NEXT:          struct.writem %[[VAL_2]][@first] = %[[VAL_0]] : <@UnrelatedIdentity::@Holder<[@T, @U, @V]>>, !felt.type
// CHECK-NEXT:          struct.writem %[[VAL_2]][@second] = %[[VAL_1]] : <@UnrelatedIdentity::@Holder<[@T, @U, @V]>>, !pod.type<[@known: !felt.type, @identity: !poly.tvar<@U>]>
// CHECK-NEXT:          %[[VAL_3:[0-9a-zA-Z_.-]+]] = struct.readm %[[VAL_2]][@source] : <@UnrelatedIdentity::@Holder<[@T, @U, @V]>>, !poly.tvar<@V>
// CHECK-NEXT:          struct.writem %[[VAL_2]][@unrelated] = %[[VAL_3]] : <@UnrelatedIdentity::@Holder<[@T, @U, @V]>>, !poly.tvar<@V>
// CHECK-NEXT:          function.return %[[VAL_2]] : !struct.type<@UnrelatedIdentity::@Holder<[@T, @U, @V]>>
// CHECK-NEXT:        }
// CHECK-NEXT:        function.def @constrain(%[[VAL_4:[0-9a-zA-Z_.-]+]]: !struct.type<@UnrelatedIdentity::@Holder<[@T, @U, @V]>>, %[[VAL_5:[0-9a-zA-Z_.-]+]]: !felt.type, %[[VAL_6:[0-9a-zA-Z_.-]+]]: !pod.type<[@known: !felt.type, @identity: !poly.tvar<@U>]>) attributes {function.allow_constraint} {
// CHECK-NEXT:          function.return
// CHECK-NEXT:        }
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }
