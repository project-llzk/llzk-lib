// Delayed pod bindings must still refine when both writes resolve to the same type.
module attributes {llzk.lang} {
  poly.template @DelayedPodCompatible {
    poly.param @T
    poly.param @V
    struct.def @Holder {
      struct.member @first : !poly.tvar<@T>
      struct.member @second : !pod.type<[@value: !poly.tvar<@T>]>
      struct.member @source : !pod.type<[@value: !poly.tvar<@V>]>
      function.def @compute(%a: !felt.type, %b: !pod.type<[@value: !felt.type]>) -> !struct.type<@DelayedPodCompatible::@Holder<[@T, @V]>> {
        %self = struct.new : !struct.type<@DelayedPodCompatible::@Holder<[@T, @V]>>
        struct.writem %self[@first] = %a : !struct.type<@DelayedPodCompatible::@Holder<[@T, @V]>>, !felt.type
        struct.writem %self[@source] = %b : !struct.type<@DelayedPodCompatible::@Holder<[@T, @V]>>, !pod.type<[@value: !felt.type]>
        %v = struct.readm %self[@source] : !struct.type<@DelayedPodCompatible::@Holder<[@T, @V]>>, !pod.type<[@value: !poly.tvar<@V>]>
        struct.writem %self[@second] = %v : !struct.type<@DelayedPodCompatible::@Holder<[@T, @V]>>, !pod.type<[@value: !poly.tvar<@V>]>
        function.return %self : !struct.type<@DelayedPodCompatible::@Holder<[@T, @V]>>
      }
      function.def @constrain(%self: !struct.type<@DelayedPodCompatible::@Holder<[@T, @V]>>, %a: !felt.type, %b: !pod.type<[@value: !felt.type]>) {
        function.return
      }
    }
  }
}
