// RUN: llzk-opt -split-input-file -llzk-flatten -verify-diagnostics %s

// Inferred T must agree across every argument before cloning.
module attributes {llzk.lang} {
  poly.template @Match {
    poly.param @T : !poly.tvar<@T>
    // expected-note@+1 {{target function declared here}}
    function.def @consume(%a: !poly.tvar<@T>, %b: !poly.tvar<@T>) { function.return }
  }
  function.def @caller(%a: !felt.type, %b: i1) {
    // expected-error@+1 {{cannot instantiate function because the complete call signature has conflicting template bindings at operand number 1}}
    function.call @Match::@consume(%a, %b) : (!felt.type, i1) -> ()
    function.return
  }
}

// -----

// A wildcard T must also agree with the call result.
module attributes {llzk.lang} {
  poly.template @Match {
    poly.param @T : !poly.tvar<@T>
    // expected-note@+1 {{target function declared here}}
    function.def @consume(%a: !poly.tvar<@T>) -> !poly.tvar<@T> { function.return %a : !poly.tvar<@T> }
  }
  function.def @caller(%a: !felt.type, %b: i1) {
    // expected-error@+1 {{cannot instantiate function because the complete call signature has conflicting template bindings at result number 0}}
    %result = function.call @Match::@consume<[?]>(%a) : (!felt.type) -> i1
    function.return
  }
}

// -----

// Repeated dimensions within one argument share a binding.
module attributes {llzk.lang} {
  poly.template @Callee {
    poly.param @N : index
    // expected-note@+1 {{target function declared here}}
    function.def @consume(%value: !array.type<@N,@N x !felt.type>) { function.return }
  }
  function.def @caller(%value: !array.type<8,9 x !felt.type>) {
    // expected-error@+1 {{cannot instantiate function because the complete call signature has conflicting template bindings at operand number 0}}
    function.call @Callee::@consume(%value) : (!array.type<8,9 x !felt.type>) -> ()
    function.return
  }
}

// -----

// Defer the generic/concrete binding until member propagation exposes the conflict.
#id = affine_map<(i) -> (i)>
module attributes {llzk.lang} {
  poly.template @TCell {
    poly.param @N : index

    struct.def @Cell {
      struct.member @value : !felt.type {column}

      function.def @compute() -> !struct.type<@TCell::@Cell<[@N]>> {
        %self = struct.new : !struct.type<@TCell::@Cell<[@N]>>
        function.return %self : !struct.type<@TCell::@Cell<[@N]>>
      }

      function.def @constrain(%self: !struct.type<@TCell::@Cell<[@N]>>) {
        function.return
      }
    }
  }

  poly.template @Match {
    poly.param @T : !poly.tvar<@T>
    function.def @consume(%a: !poly.tvar<@T>, %b: !poly.tvar<@T>) {
      function.return
    }
  }

  struct.def @Holder {
    struct.member @left : !struct.type<@TCell::@Cell<[#id]>> {column}
    function.def @compute() -> !struct.type<@Holder> {
      %self = struct.new : !struct.type<@Holder>
      %zero = function.call @TCell::@Cell::@compute() : () -> !struct.type<@TCell::@Cell<[0]>>
      %one = function.call @TCell::@Cell::@compute() : () -> !struct.type<@TCell::@Cell<[1]>>
      struct.writem %self[@left] = %zero : !struct.type<@Holder>, !struct.type<@TCell::@Cell<[0]>>
      // expected-note@+1 {{member read would refine to}}
      %left = struct.readm %self[@left] : !struct.type<@Holder>, !struct.type<@TCell::@Cell<[#id]>>
      // expected-error@+2 {{cannot refine member reads because the complete call signature has conflicting template bindings at operand number 1}}
      // expected-note@+1 {{proposed call signature}}
      function.call @Match::@consume(%left, %one) : (!struct.type<@TCell::@Cell<[#id]>>, !struct.type<@TCell::@Cell<[1]>>) -> ()
      function.return %self : !struct.type<@Holder>
    }
    function.def @constrain(%self: !struct.type<@Holder>) { function.return }
  }
}

// -----

// The same deferral must preserve the result requirement.
#id = affine_map<(i) -> (i)>
module attributes {llzk.lang} {
  poly.template @TCell {
    poly.param @N : index

    struct.def @Cell {
      struct.member @value : !felt.type {column}

      function.def @compute() -> !struct.type<@TCell::@Cell<[@N]>> {
        %self = struct.new : !struct.type<@TCell::@Cell<[@N]>>
        function.return %self : !struct.type<@TCell::@Cell<[@N]>>
      }

      function.def @constrain(%self: !struct.type<@TCell::@Cell<[@N]>>) {
        function.return
      }
    }
  }

  poly.template @Match {
    poly.param @T : !poly.tvar<@T>
    function.def @consume(%a: !poly.tvar<@T>) -> !poly.tvar<@T> {
      function.return %a : !poly.tvar<@T>
    }
  }

  struct.def @Holder {
    struct.member @left : !struct.type<@TCell::@Cell<[#id]>> {column}
    function.def @compute() -> !struct.type<@Holder> {
      %self = struct.new : !struct.type<@Holder>
      %zero = function.call @TCell::@Cell::@compute() : () -> !struct.type<@TCell::@Cell<[0]>>
      struct.writem %self[@left] = %zero : !struct.type<@Holder>, !struct.type<@TCell::@Cell<[0]>>
      // expected-note@+1 {{member read would refine to}}
      %left = struct.readm %self[@left] : !struct.type<@Holder>, !struct.type<@TCell::@Cell<[#id]>>
      // expected-error@+2 {{cannot refine member reads because the complete call signature has conflicting template bindings at result number 0}}
      // expected-note@+1 {{proposed call signature}}
      %result = function.call @Match::@consume(%left) : (!struct.type<@TCell::@Cell<[#id]>>) -> !struct.type<@TCell::@Cell<[1]>>
      function.return %self : !struct.type<@Holder>
    }
    function.def @constrain(%self: !struct.type<@Holder>) { function.return }
  }
}

// -----

// Aliases connecting multiple callee variables must retain their transitive constraints.
module attributes {llzk.lang} {
  poly.template @Match {
    poly.param @T
    poly.param @U
    // expected-note@+1 {{target function declared here}}
    function.def @consume(%a: !poly.tvar<@T>, %b: !poly.tvar<@T>, %c: !poly.tvar<@U>, %d: !poly.tvar<@U>) { function.return }
  }
  poly.template @Caller {
    poly.param @S
    function.def @caller(%a: !felt.type, %shared: !poly.tvar<@S>, %d: index) {
      // expected-error@+1 {{cannot instantiate function because the complete call signature has conflicting template bindings at operand number 3}}
      function.call @Match::@consume(%a, %shared, %shared, %d) : (!felt.type, !poly.tvar<@S>, !poly.tvar<@S>, index) -> ()
      function.return
    }
  }
}
