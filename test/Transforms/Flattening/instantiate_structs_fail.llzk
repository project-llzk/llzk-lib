// RUN: llzk-opt -split-input-file -llzk-flatten -verify-diagnostics %s

module attributes {llzk.lang} {
  poly.template @TUnpack {
    poly.param @N
    poly.param @P
    poly.param @Aff : index

    struct.def @Unpack {
      // expected-note@+1 {{target function declared here}}
      function.def @compute(%arg0: !array.type<@Aff x !felt.type>) -> !struct.type<@TUnpack::@Unpack<[@N, @P, @Aff]>> {
        %self = struct.new : !struct.type<@TUnpack::@Unpack<[@N, @P, @Aff]>>
        function.return %self : !struct.type<@TUnpack::@Unpack<[@N, @P, @Aff]>>
      }
      function.def @constrain(%arg0: !struct.type<@TUnpack::@Unpack<[@N, @P, @Aff]>>, %arg1: !array.type<@Aff x !felt.type>) { function.return }
    }
  }
  struct.def @User1 {
    function.def @compute() -> !struct.type<@User1> {
      %0 = felt.const 42
      %1 = felt.const 99

      %arr = array.new %0, %1 : !array.type<2 x !felt.type>
      %a = arith.constant 8 : index
      %b = arith.constant 2 : index
      // expected-error@+1 {{cannot instantiate struct call because the complete call signature has conflicting template bindings}}
      %s = function.call @TUnpack::@Unpack::@compute(%arr) {()[%a, %b]}
        : (!array.type<2 x !felt.type>) -> !struct.type<@TUnpack::@Unpack<[8, 2, affine_map<()[s0, s1] -> (s0 floordiv s1)>]>>
      %self = struct.new : !struct.type<@User1>
      function.return %self : !struct.type<@User1>
    }
    function.def @constrain(%arg0: !struct.type<@User1>) { function.return }
  }
}
