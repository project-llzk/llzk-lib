// RUN: llzk-opt -split-input-file -llzk-flatten %s | FileCheck --enable-var-scope %s

// Split member reads passed to one shared binding refine together.
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK:    struct.def @Holder {
// CHECK-NEXT:      struct.member @items_0 : !struct.type<@TCell_0_Cell>
// CHECK-NEXT:      struct.member @items_1 : !struct.type<@TCell_0_Cell>
// CHECK-NEXT:      struct.member @items_2 : !struct.type<@TCell_1_Cell>
// CHECK-NEXT:      function.def @compute() -> !struct.type<@Holder> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_6:[0-9a-zA-Z_.-]+]] = struct.new : <@Holder>
// CHECK-NEXT:        %[[VAL_7:[0-9a-zA-Z_.-]+]] = function.call @TCell_0_Cell::@compute() : () -> !struct.type<@TCell_0_Cell>
// CHECK-NEXT:        %[[VAL_8:[0-9a-zA-Z_.-]+]] = function.call @TCell_1_Cell::@compute() : () -> !struct.type<@TCell_1_Cell>
// CHECK-NEXT:        struct.writem %[[VAL_6]][@items_0] = %[[VAL_7]] : <@Holder>, !struct.type<@TCell_0_Cell>
// CHECK-NEXT:        struct.writem %[[VAL_6]][@items_1] = %[[VAL_7]] : <@Holder>, !struct.type<@TCell_0_Cell>
// CHECK-NEXT:        struct.writem %[[VAL_6]][@items_2] = %[[VAL_8]] : <@Holder>, !struct.type<@TCell_1_Cell>
// CHECK-NEXT:        %[[VAL_9:[0-9a-zA-Z_.-]+]] = struct.readm %[[VAL_6]][@items_1] : <@Holder>, !struct.type<@TCell_0_Cell>
// CHECK-NEXT:        %[[VAL_10:[0-9a-zA-Z_.-]+]] = struct.readm %[[VAL_6]][@items_0] : <@Holder>, !struct.type<@TCell_0_Cell>
// CHECK-NEXT:        function.call @"Match_!s<@TCell_0_Cell>_consume"(%[[VAL_10]], %[[VAL_9]]) : (!struct.type<@TCell_0_Cell>, !struct.type<@TCell_0_Cell>) -> ()
// CHECK-NEXT:        function.return %[[VAL_6]] : !struct.type<@Holder>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_11:[0-9a-zA-Z_.-]+]]: !struct.type<@Holder>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
#id = affine_map<(i) -> (i)>
module attributes {llzk.lang} {
  poly.template @TCell {
    poly.param @N : index

    struct.def @Cell {
      struct.member @value : !felt.type {column}

      function.def @compute() -> !struct.type<@TCell::@Cell<[@N]>> {
        %self = struct.new : !struct.type<@TCell::@Cell<[@N]>>
        function.return %self : !struct.type<@TCell::@Cell<[@N]>>
      }

      function.def @constrain(%self: !struct.type<@TCell::@Cell<[@N]>>) {
        function.return
      }
    }
  }

  poly.template @Match {
    poly.param @T
    function.def @consume(%a: !poly.tvar<@T>, %b: !poly.tvar<@T>) { function.return }
  }
  struct.def @Holder {
    struct.member @items : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>
    function.def @compute() -> !struct.type<@Holder> {
      %self = struct.new : !struct.type<@Holder>
      %c0 = arith.constant 0 : index
      %c1 = arith.constant 1 : index
      %c2 = arith.constant 2 : index
      %zero = function.call @TCell::@Cell::@compute() : () -> !struct.type<@TCell::@Cell<[0]>>
      %one = function.call @TCell::@Cell::@compute() : () -> !struct.type<@TCell::@Cell<[1]>>
      %items = array.new : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>
      array.write %items[%c0] = %zero : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>, !struct.type<@TCell::@Cell<[0]>>
      array.write %items[%c1] = %zero : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>, !struct.type<@TCell::@Cell<[0]>>
      array.write %items[%c2] = %one : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>, !struct.type<@TCell::@Cell<[1]>>
      struct.writem %self[@items] = %items : !struct.type<@Holder>, !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>
      %values = struct.readm %self[@items] : !struct.type<@Holder>, !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>
      %a = array.read %values[%c0] : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>, !struct.type<@TCell::@Cell<[#id]>>
      %b = array.read %values[%c1] : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>, !struct.type<@TCell::@Cell<[#id]>>
      function.call @Match::@consume(%a, %b) : (!struct.type<@TCell::@Cell<[#id]>>, !struct.type<@TCell::@Cell<[#id]>>) -> ()
      function.return %self : !struct.type<@Holder>
    }
    function.def @constrain(%self: !struct.type<@Holder>) { function.return }
  }
}

// -----

// A local candidate read and a split-member read share the same pending signature.
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK:    struct.def @Holder {
// CHECK-NEXT:      struct.member @items_0 : !struct.type<@TCell_0_Cell>
// CHECK-NEXT:      struct.member @items_1 : !struct.type<@TCell_0_Cell>
// CHECK-NEXT:      struct.member @items_2 : !struct.type<@TCell_1_Cell>
// CHECK-NEXT:      function.def @compute() -> !struct.type<@Holder> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_6:[0-9a-zA-Z_.-]+]] = struct.new : <@Holder>
// CHECK-NEXT:        %[[VAL_7:[0-9a-zA-Z_.-]+]] = function.call @TCell_0_Cell::@compute() : () -> !struct.type<@TCell_0_Cell>
// CHECK-NEXT:        %[[VAL_8:[0-9a-zA-Z_.-]+]] = function.call @TCell_1_Cell::@compute() : () -> !struct.type<@TCell_1_Cell>
// CHECK-NEXT:        struct.writem %[[VAL_6]][@items_0] = %[[VAL_7]] : <@Holder>, !struct.type<@TCell_0_Cell>
// CHECK-NEXT:        struct.writem %[[VAL_6]][@items_1] = %[[VAL_7]] : <@Holder>, !struct.type<@TCell_0_Cell>
// CHECK-NEXT:        struct.writem %[[VAL_6]][@items_2] = %[[VAL_8]] : <@Holder>, !struct.type<@TCell_1_Cell>
// CHECK-NEXT:        %[[VAL_9:[0-9a-zA-Z_.-]+]] = struct.readm %[[VAL_6]][@items_0] : <@Holder>, !struct.type<@TCell_0_Cell>
// CHECK-NEXT:        function.call @"Match_!s<@TCell_0_Cell>_consume"(%[[VAL_9]], %[[VAL_7]]) : (!struct.type<@TCell_0_Cell>, !struct.type<@TCell_0_Cell>) -> ()
// CHECK-NEXT:        function.return %[[VAL_6]] : !struct.type<@Holder>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_10:[0-9a-zA-Z_.-]+]]: !struct.type<@Holder>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
#id = affine_map<(i) -> (i)>
module attributes {llzk.lang} {
  poly.template @TCell {
    poly.param @N : index

    struct.def @Cell {
      struct.member @value : !felt.type {column}

      function.def @compute() -> !struct.type<@TCell::@Cell<[@N]>> {
        %self = struct.new : !struct.type<@TCell::@Cell<[@N]>>
        function.return %self : !struct.type<@TCell::@Cell<[@N]>>
      }

      function.def @constrain(%self: !struct.type<@TCell::@Cell<[@N]>>) {
        function.return
      }
    }
  }

  poly.template @Match {
    poly.param @T
    function.def @consume(%a: !poly.tvar<@T>, %b: !poly.tvar<@T>) { function.return }
  }
  struct.def @Holder {
    struct.member @items : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>
    function.def @compute() -> !struct.type<@Holder> {
      %self = struct.new : !struct.type<@Holder>
      %c0 = arith.constant 0 : index
      %c1 = arith.constant 1 : index
      %c2 = arith.constant 2 : index
      %zero = function.call @TCell::@Cell::@compute() : () -> !struct.type<@TCell::@Cell<[0]>>
      %one = function.call @TCell::@Cell::@compute() : () -> !struct.type<@TCell::@Cell<[1]>>
      %items = array.new : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>
      array.write %items[%c0] = %zero : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>, !struct.type<@TCell::@Cell<[0]>>
      array.write %items[%c1] = %zero : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>, !struct.type<@TCell::@Cell<[0]>>
      array.write %items[%c2] = %one : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>, !struct.type<@TCell::@Cell<[1]>>
      struct.writem %self[@items] = %items : !struct.type<@Holder>, !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>
      %values = struct.readm %self[@items] : !struct.type<@Holder>, !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>
      %a = array.read %values[%c0] : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>, !struct.type<@TCell::@Cell<[#id]>>
      %b = array.read %items[%c1] : !array.type<3 x !struct.type<@TCell::@Cell<[#id]>>>, !struct.type<@TCell::@Cell<[#id]>>
      function.call @Match::@consume(%a, %b) : (!struct.type<@TCell::@Cell<[#id]>>, !struct.type<@TCell::@Cell<[#id]>>) -> ()
      function.return %self : !struct.type<@Holder>
