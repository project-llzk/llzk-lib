//--- index.llzk
  function.def @entry(%input: !array.type<2 x !pod.type<[@a: !array.type<3 x index>, @b: !array.type<3 x !felt.type>]>>) -> !struct.type<@RepeatedIdentity::@Holder<[index]>> attributes {function.allow_witness} {
    %result = function.call @RepeatedIdentity::@Holder::@compute(%input) : (!array.type<2 x !pod.type<[@a: !array.type<3 x index>, @b: !array.type<3 x !felt.type>]>>) -> !struct.type<@RepeatedIdentity::@Holder<[index]>>
