// RUN: split-file %s %t
// RUN: cat %t/generic.llzk %t/felt.llzk > %t/complete-felt.llzk
// RUN: llzk-opt -llzk-flatten %t/complete-felt.llzk | FileCheck %s --check-prefix=FELT
// RUN: cat %t/generic.llzk %t/index.llzk > %t/complete-index.llzk
// RUN: not llzk-opt -llzk-flatten %t/complete-index.llzk 2>&1 | FileCheck %s --check-prefix=INDEX

// Assemble each complete module before flattening; all instantiation sites are visible.

//--- generic.llzk
// Repeated bindings retain their relationship through nested array and POD shapes.
module attributes {llzk.lang} {
  poly.template @RepeatedIdentity {
    poly.param @T
    struct.def @Holder {
      struct.member @pair : !array.type<2 x !pod.type<[@a: !array.type<3 x !poly.tvar<@T>>, @b: !array.type<3 x !poly.tvar<@T>>]>>
      function.def @compute(%input: !array.type<2 x !pod.type<[@a: !array.type<3 x !poly.tvar<@T>>, @b: !array.type<3 x !felt.type>]>>) -> !struct.type<@RepeatedIdentity::@Holder<[@T]>> {
        %self = struct.new : !struct.type<@RepeatedIdentity::@Holder<[@T]>>
        struct.writem %self[@pair] = %input : !struct.type<@RepeatedIdentity::@Holder<[@T]>>, !array.type<2 x !pod.type<[@a: !array.type<3 x !poly.tvar<@T>>, @b: !array.type<3 x !felt.type>]>>
        function.return %self : !struct.type<@RepeatedIdentity::@Holder<[@T]>>
      }
      function.def @constrain(%self: !struct.type<@RepeatedIdentity::@Holder<[@T]>>, %input: !array.type<2 x !pod.type<[@a: !array.type<3 x !poly.tvar<@T>>, @b: !array.type<3 x !felt.type>]>>) { function.return }
    }
  }

//--- felt.llzk
  function.def @entry(%input: !array.type<2 x !pod.type<[@a: !array.type<3 x !felt.type>, @b: !array.type<3 x !felt.type>]>>) -> !struct.type<@RepeatedIdentity::@Holder<[!felt.type]>> attributes {function.allow_witness} {
    %result = function.call @RepeatedIdentity::@Holder::@compute(%input) : (!array.type<2 x !pod.type<[@a: !array.type<3 x !felt.type>, @b: !array.type<3 x !felt.type>]>>) -> !struct.type<@RepeatedIdentity::@Holder<[!felt.type]>>
    function.return %result : !struct.type<@RepeatedIdentity::@Holder<[!felt.type]>>
  }
}
