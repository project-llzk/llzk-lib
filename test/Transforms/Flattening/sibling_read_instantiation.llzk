// RUN: split-file %s %t
// RUN: cat %t/conflict.llzk %t/index.llzk > %t/conflict-complete.llzk
// RUN: not llzk-opt -llzk-flatten %t/conflict-complete.llzk 2>&1 | FileCheck %s --check-prefix=INDEX
// RUN: cat %t/unused.llzk %t/index.llzk > %t/unused-complete.llzk
// RUN: not llzk-opt -llzk-flatten %t/unused-complete.llzk 2>&1 | FileCheck %s --check-prefix=INDEX
// RUN: cat %t/compatible.llzk %t/felt.llzk > %t/compatible-complete.llzk
// RUN: llzk-opt -llzk-flatten %t/compatible-complete.llzk | FileCheck %s --check-prefix=FELT

// All concrete callers are present before flattening begins.

//--- conflict.llzk
// An index instantiation conflicts with the felt write and is rejected.
module attributes {llzk.lang} {
  function.def @consumeIndex(%value: index) { function.return }
  poly.template @SharedRead {
    poly.param @T
    struct.def @Holder {
      struct.member @first : !poly.tvar<@T>
      struct.member @second : !poly.tvar<@T>
      function.def @compute(%input: !felt.type) -> !struct.type<@SharedRead::@Holder<[@T]>> {
        %self = struct.new : !struct.type<@SharedRead::@Holder<[@T]>>
        struct.writem %self[@first] = %input : !struct.type<@SharedRead::@Holder<[@T]>>, !felt.type
        function.return %self : !struct.type<@SharedRead::@Holder<[@T]>>
      }
      function.def @constrain(%self: !struct.type<@SharedRead::@Holder<[@T]>>, %input: !felt.type) {
        %read = struct.readm %self[@second] : !struct.type<@SharedRead::@Holder<[@T]>>, !poly.tvar<@T>
        function.call @consumeIndex(%read) : (!poly.tvar<@T>) -> ()
        function.return
      }
    }
  }

//--- unused.llzk
// The conflicting instantiation is rejected even when the sibling read is unused.
module attributes {llzk.lang} {
  function.def @consumeIndex(%value: index) { function.return }
  poly.template @SharedRead {
    poly.param @T
    struct.def @Holder {
      struct.member @first : !poly.tvar<@T>
      struct.member @second : !poly.tvar<@T>
      function.def @compute(%input: !felt.type) -> !struct.type<@SharedRead::@Holder<[@T]>> {
        %self = struct.new : !struct.type<@SharedRead::@Holder<[@T]>>
        struct.writem %self[@first] = %input : !struct.type<@SharedRead::@Holder<[@T]>>, !felt.type
        function.return %self : !struct.type<@SharedRead::@Holder<[@T]>>
      }
      function.def @constrain(%self: !struct.type<@SharedRead::@Holder<[@T]>>, %input: !felt.type) {
        %read = struct.readm %self[@second] : !struct.type<@SharedRead::@Holder<[@T]>>, !poly.tvar<@T>
        function.return
      }
    }
  }

//--- compatible.llzk
// A felt instantiation agrees with both the write and the sibling read.
module attributes {llzk.lang} {
  function.def @consumeFelt(%value: !felt.type) { function.return }
  poly.template @SharedRead {
    poly.param @T
    struct.def @Holder {
      struct.member @first : !poly.tvar<@T>
      struct.member @second : !poly.tvar<@T>
      function.def @compute(%input: !felt.type) -> !struct.type<@SharedRead::@Holder<[@T]>> {
        %self = struct.new : !struct.type<@SharedRead::@Holder<[@T]>>
        struct.writem %self[@first] = %input : !struct.type<@SharedRead::@Holder<[@T]>>, !felt.type
        function.return %self : !struct.type<@SharedRead::@Holder<[@T]>>
      }
      function.def @constrain(%self: !struct.type<@SharedRead::@Holder<[@T]>>, %input: !felt.type) {
        %read = struct.readm %self[@second] : !struct.type<@SharedRead::@Holder<[@T]>>, !felt.type
        function.call @consumeFelt(%read) : (!felt.type) -> ()
        function.return
      }
    }
  }

//--- index.llzk
  function.def @entry(%input: !felt.type) -> !struct.type<@SharedRead::@Holder<[index]>> attributes {function.allow_witness} {
    %self = function.call @SharedRead::@Holder::@compute(%input) : (!felt.type) -> !struct.type<@SharedRead::@Holder<[index]>>
    function.return %self : !struct.type<@SharedRead::@Holder<[index]>>
  }
}
// INDEX: error: 'struct.writem' op has wrong type; expected 'index', got '!felt.type'

//--- felt.llzk
  function.def @entry(%input: !felt.type) -> !struct.type<@SharedRead::@Holder<[!felt.type]>> attributes {function.allow_witness} {
    %self = function.call @SharedRead::@Holder::@compute(%input) : (!felt.type) -> !struct.type<@SharedRead::@Holder<[!felt.type]>>
    function.return %self : !struct.type<@SharedRead::@Holder<[!felt.type]>>
  }
}

