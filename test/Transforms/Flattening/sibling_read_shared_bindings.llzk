// CHECK-NEXT:    function.def @consumeIndex(%[[VAL_0:[0-9a-zA-Z_.-]+]]: index) {
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:    poly.template @SharedRead {
// CHECK-NEXT:      poly.param @T
// CHECK-NEXT:      poly.param @N : index
