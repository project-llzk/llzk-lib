// CHECK-NEXT:    function.def @consumeFelt(%[[VAL_0:[0-9a-zA-Z_.-]+]]: !array.type<2 x !felt.type>) {
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:    poly.template @SharedRead {
