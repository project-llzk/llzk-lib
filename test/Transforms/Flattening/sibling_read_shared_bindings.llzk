// -----

// A sibling read using unrelated U does not prevent refining T.
module attributes {llzk.lang} {
  function.def @consumeIndex(%value: index) { function.return }
  poly.template @SharedRead {
    poly.param @T
    poly.param @U
    struct.def @Holder {
      struct.member @first : !poly.tvar<@T>
      struct.member @second : !poly.tvar<@U>
      function.def @compute(%input: !felt.type) -> !struct.type<@SharedRead::@Holder<[@T, @U]>> {
        %self = struct.new : !struct.type<@SharedRead::@Holder<[@T, @U]>>
        struct.writem %self[@first] = %input : !struct.type<@SharedRead::@Holder<[@T, @U]>>, !felt.type
        function.return %self : !struct.type<@SharedRead::@Holder<[@T, @U]>>
      }
      function.def @constrain(%self: !struct.type<@SharedRead::@Holder<[@T, @U]>>, %input: !felt.type) {
        %read = struct.readm %self[@second] : !struct.type<@SharedRead::@Holder<[@T, @U]>>, !poly.tvar<@U>
        function.call @consumeIndex(%read) : (!poly.tvar<@U>) -> ()
        function.return
      }
    }
  }
}

