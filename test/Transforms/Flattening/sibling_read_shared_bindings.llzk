// CHECK-NEXT:          function.call @consumeIndex(%[[VAL_5]]) : (!poly.tvar<@T>) -> ()
// CHECK-NEXT:          function.return
// CHECK-NEXT:        }
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }

