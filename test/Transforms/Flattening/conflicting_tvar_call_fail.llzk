// RUN: llzk-opt -llzk-flatten -verify-diagnostics %s

// Concrete substitutions expose the conflict that is deferred by call verification.
module attributes {llzk.lang} {
  poly.template @T2 {
    poly.param @T : !poly.tvar<@T>
    // expected-note@+1 {{target function declared here}}
    function.def @f(%a: !poly.tvar<@T>, %b: !poly.tvar<@T>) { function.return }
  }

  struct.def @Caller {
    function.def @compute() -> !struct.type<@Caller> {
      %self = struct.new : !struct.type<@Caller>
      %x = felt.const 0 : !felt.type
      %y = arith.constant 0 : index
      // expected-error@+1 {{cannot instantiate function because the complete call signature has conflicting template bindings}}
      function.call @T2::@f<[!felt.type]>(%x, %y) : (!felt.type, index) -> ()
      function.return %self : !struct.type<@Caller>
    }

    function.def @constrain(%self: !struct.type<@Caller>) { function.return }
  }
}
