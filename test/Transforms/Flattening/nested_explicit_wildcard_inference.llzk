// RUN: llzk-opt -split-input-file -llzk-flatten -verify-diagnostics %s | FileCheck --enable-var-scope %s

// Infer outer T from the nested result type even when the nested argument list explicitly
// requests inference with ?. Both templates must specialize to felt.
module attributes {llzk.lang} {
  struct.def @Main {
    function.def @compute() -> !struct.type<@Main> {
      %self = struct.new : !struct.type<@Main>
      function.call @Outer::@wrap<[?]>() : () -> ()
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>) {
      function.return
    }
  }
  poly.template @Inner {
    poly.param @U : !poly.tvar<@U>
    function.def @id(%arg: !poly.tvar<@U>) -> !poly.tvar<@U> {
      function.return %arg : !poly.tvar<@U>
    }
  }
  poly.template @Outer {
    poly.param @T : !poly.tvar<@T>
    function.def @wrap() {
      %arg = llzk.nondet : !poly.tvar<@T>
      %res = function.call @Inner::@id<[?]>(%arg) : (!poly.tvar<@T>) -> !felt.type
      function.return
    }
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    struct.def @Main {
// CHECK-NEXT:      function.def @compute() -> !struct.type<@Main> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_0:[0-9a-zA-Z_.-]+]] = struct.new : <@Main>
// CHECK-NEXT:        function.call @Outer_f_wrap() : () -> ()
// CHECK-NEXT:        function.return %[[VAL_0]] : !struct.type<@Main>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_1:[0-9a-zA-Z_.-]+]]: !struct.type<@Main>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    function.def @Inner_f_id(%[[VAL_2:[0-9a-zA-Z_.-]+]]: !felt.type) -> !felt.type {
// CHECK-NEXT:      function.return %[[VAL_2]] : !felt.type
// CHECK-NEXT:    }
// CHECK-NEXT:    function.def @Outer_f_wrap() {
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_.-]+]] = llzk.nondet : !felt.type
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_.-]+]] = function.call @Inner_f_id(%[[VAL_3]]) : (!felt.type) -> !felt.type
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

// An unresolved enclosing symbol in the nested argument list has the same signature
// evidence as an explicit wildcard and must not suppress inference.
module attributes {llzk.lang} {
  struct.def @Main {
    function.def @compute() -> !struct.type<@Main> {
      %self = struct.new : !struct.type<@Main>
      function.call @Outer::@wrap<[?]>() : () -> ()
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>) {
      function.return
    }
  }
  poly.template @Inner {
    poly.param @U : !poly.tvar<@U>
    function.def @id(%arg: !poly.tvar<@U>) -> !poly.tvar<@U> {
      function.return %arg : !poly.tvar<@U>
    }
  }
  poly.template @Outer {
    poly.param @T : !poly.tvar<@T>
    function.def @wrap() {
      %arg = llzk.nondet : !poly.tvar<@T>
      %res = function.call @Inner::@id<[@T]>(%arg) : (!poly.tvar<@T>) -> !felt.type
      function.return
    }
  }
}
