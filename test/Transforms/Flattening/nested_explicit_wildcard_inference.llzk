// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

// Infer outer T from a concrete nested operand when the result carries the unresolved
// outer variable. Operand and result evidence must work in both directions.
module attributes {llzk.lang} {
  struct.def @Main {
    function.def @compute() -> !struct.type<@Main> {
      %self = struct.new : !struct.type<@Main>
      function.call @Outer::@wrap<[?]>() : () -> ()
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>) {
      function.return
    }
  }
  poly.template @Inner {
    poly.param @U : !poly.tvar<@U>
    function.def @id(%arg: !poly.tvar<@U>) -> !poly.tvar<@U> {
      function.return %arg : !poly.tvar<@U>
    }
  }
  poly.template @Outer {
    poly.param @T : !poly.tvar<@T>
    function.def @wrap() {
      %arg = llzk.nondet : !felt.type
      %res = function.call @Inner::@id<[?]>(%arg) : (!felt.type) -> !poly.tvar<@T>
      function.return
    }
  }
}
