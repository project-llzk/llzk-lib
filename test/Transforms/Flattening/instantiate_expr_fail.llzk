// RUN: llzk-opt -split-input-file -llzk-flatten -verify-diagnostics %s 2>&1 | FileCheck --enable-var-scope %s

// A concrete expression referenced by a struct specialization fails when its body cannot fold.
module attributes {llzk.lang, llzk.main = !struct.type<@StructExpr::@Value<[5]>>} {
  poly.template @StructExpr {
    poly.param @N : index
    poly.expr @NestedN {
      // expected-error@+1 {{'scf.execute_region' op cannot fold concrete template expression}}
      %value = scf.execute_region -> index {
        %n = poly.read_const @N : index
        scf.yield %n : index
      }
      poly.yield %value : index
    }
    struct.def @Value {
      function.def @compute() -> !struct.type<@StructExpr::@Value<[@N]>> {
        %value = poly.read_const @NestedN : index
        %self = struct.new : <@StructExpr::@Value<[@N]>>
        function.return %self : !struct.type<@StructExpr::@Value<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@StructExpr::@Value<[@N]>>) {
        function.return
      }
    }
  }
}

// -----

// The same non-foldable expression fails when referenced by a free-function specialization.
module attributes {llzk.lang} {
  poly.template @FunctionExpr {
    poly.param @N : index
    poly.expr @NestedN {
      // expected-error@+1 {{'scf.execute_region' op cannot fold concrete template expression}}
      %value = scf.execute_region -> index {
        %n = poly.read_const @N : index
        scf.yield %n : index
      }
      poly.yield %value : index
    }
    function.def @value() -> index {
      %value = poly.read_const @NestedN : index
      function.return %value : index
    }
  }

  struct.def @Main {
    function.def @compute() -> !struct.type<@Main> {
      %self = struct.new : <@Main>
      // expected-error@+1 {{failure while evaluating template expressions}}
      %value = function.call @FunctionExpr::@value<[5]>() : () -> index
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>) {
      function.return
    }
  }
}

// -----

// A successful zero-result fold must not discard an assertion nested in the folded operation.
module attributes {llzk.lang, llzk.main = !struct.type<@EffectfulExpr::@Value>} {
  poly.template @EffectfulExpr {
    poly.expr @Result {
      %condition = arith.constant false
      %one = arith.constant true
      %negated = arith.xori %condition, %one : i1
      // expected-error@+1 {{'scf.if' op cannot evaluate concrete template expression with memory effects or unsafe speculation}}
      scf.if %negated {
        %false = arith.constant false
        bool.assert %false, "must not be discarded"
      } else {
      }
      %result = arith.constant 7 : index
      poly.yield %result : index
    }
    struct.def @Value {
      function.def @compute() -> !struct.type<@EffectfulExpr::@Value> {
        %result = poly.read_const @Result : index
        %self = struct.new : !struct.type<@EffectfulExpr::@Value>
        function.return %self : !struct.type<@EffectfulExpr::@Value>
      }
      function.def @constrain(%self: !struct.type<@EffectfulExpr::@Value>) {
        function.return
      }
    }
  }
}

// Verify the command-level pass failure after the split-local diagnostics.
// CHECK: llzk-flatten failed while instantiating the main struct
