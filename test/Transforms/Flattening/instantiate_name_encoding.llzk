module attributes {
  llzk.fields = [
    #felt.field<"x\1A", 101>,
    #felt.field<"x%1A", 101>
  ],
  llzk.lang
} {
  poly.template @T {
    poly.param @N : !felt.type

    function.def @value() -> index {
      %value = arith.constant 7 : index
      function.return %value : index
    }
  }

  function.def @main() -> index {
    %first = function.call @T::@value<[#felt<const 35 : !felt.type<"x\1A">>]>() : () -> index
    %second = function.call @T::@value<[#felt<const 35 : !felt.type<"x%1A">>]>() : () -> index
    function.return %second : index
  }
}

