// CHECK-NEXT:    function.def @main() -> index {
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = function.call @"T_!s<@S\1A>_\1A"::@compute<[?]>() : () -> index
