// RUN: llzk-opt -split-input-file -llzk-flatten=cleanup=disabled %s | FileCheck --enable-var-scope %s

module attributes {llzk.lang} {
  // Every marker byte belongs to the source spelling, not to an open parameter slot.
  poly.template @"T\1A\1A\1A\1A\1A\1A" {
    poly.param @A : index
    poly.param @B : index
    poly.param @C : index
    function.def @compute() -> index {
      %n = poly.read_const @A : index
      function.return %n : index
    }
  }

  function.def @main() -> index {
    %got = function.call @"T\1A\1A\1A\1A\1A\1A"::@compute<[35, 89, 7]>() : () -> index
    function.return %got : index
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @"T\1A\1A\1A\1A\1A\1A_35_89_7_compute"() -> index {
// CHECK-NEXT:      %[[VAL_0:[0-9a-zA-Z_\.]+]] = arith.constant 35 : index
// CHECK-NEXT:      function.return %[[VAL_0]] : index
// CHECK-NEXT:    }
// CHECK-NEXT:    poly.template @"T\1A\1A\1A\1A\1A\1A" {
// CHECK-NEXT:      poly.param @A : index
// CHECK-NEXT:      poly.param @B : index
// CHECK-NEXT:      poly.param @C : index
// CHECK-NEXT:      function.def @compute() -> index {
// CHECK-NEXT:        %[[VAL_1:[0-9a-zA-Z_\.]+]] = poly.read_const @A : index
// CHECK-NEXT:        function.return %[[VAL_1]] : index
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    function.def @main() -> index {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = function.call @"T\1A\1A\1A\1A\1A\1A_35_89_7_compute"() : () -> index
// CHECK-NEXT:      function.return %[[VAL_2]] : index
// CHECK-NEXT:    }
// CHECK-NEXT:  }

