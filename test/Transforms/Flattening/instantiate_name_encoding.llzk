module attributes {llzk.lang} {
  // A full instantiation renders concrete values in parameter order.
  poly.template @T {
    poly.param @A : index
    poly.param @B : index
    function.def @compute() -> index {
      %a = poly.read_const @A : index
      function.return %a : index
    }
  }

  function.def @main() -> index {
    %got = function.call @T::@compute<[89, 13]>() : () -> index
    function.return %got : index
  }
}

