// -----

module attributes {llzk.lang} {
  // A marker byte inside a stored literal chunk remains literal during refinement.
  poly.template @physical_name {
    poly.param @N : index
    function.def @compute() -> index {
      %n = poly.read_const @N : index
      function.return %n : index
    }
  } {poly.name_pattern = ["Logical\1A_", "_tail"]}

  function.def @main() -> index {
    %got = function.call @physical_name::@compute<[89]>() : () -> index
    function.return %got : index
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @"Logical\1A_89_tail_compute"() -> index {
// CHECK-NEXT:      %[[VAL_0:[0-9a-zA-Z_\.]+]] = arith.constant 89 : index
// CHECK-NEXT:      function.return %[[VAL_0]] : index
// CHECK-NEXT:    }
// CHECK-NEXT:    poly.template @physical_name {
// CHECK-NEXT:      poly.param @N : index
// CHECK-NEXT:      function.def @compute() -> index {
// CHECK-NEXT:        %[[VAL_1:[0-9a-zA-Z_\.]+]] = poly.read_const @N : index
// CHECK-NEXT:        function.return %[[VAL_1]] : index
// CHECK-NEXT:      }
// CHECK-NEXT:    } {poly.name_pattern = ["Logical\1A_", "_tail"]}
// CHECK-NEXT:    function.def @main() -> index {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = function.call @"Logical\1A_89_tail_compute"() : () -> index
// CHECK-NEXT:      function.return %[[VAL_2]] : index
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

module attributes {llzk.lang} {
  // Repeated exact requests reuse the converted member, while a colliding source shell is renamed.
  poly.template @"T_35_\1A" {
    poly.param @Other : index
    function.def @occupied() -> index {
      %zero = arith.constant 0 : index
      function.return %zero : index
    }
  }

  poly.template @T {
    poly.param @A : index
    poly.param @B : !poly.tvar<@B>
    function.def @compute() -> index {
      %a = poly.read_const @A : index
      function.return %a : index
    }
    function.def @other() {
      function.return
    }
  }

  function.def @main() -> index {
    %first = function.call @T::@compute<[35, ?]>() : () -> index
    %second = function.call @T::@compute<[35, ?]>() : () -> index
    function.call @T::@other<[35, ?]>() : () -> ()
    function.return %second : index
  }
}

