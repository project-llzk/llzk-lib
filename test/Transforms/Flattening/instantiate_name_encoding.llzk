module attributes {llzk.lang} {
  // A previously partial template is refined from `poly.name_pattern` chunks, not from its
  // The name of a partially instantiated template is refined from `poly.name_pattern` chunks,
  // not from its physical name.
  poly.template @"T_89_\1A" {
    poly.param @B : index
    function.def @compute() -> index {
      %b = poly.read_const @B : index
      function.return %b : index
    }
  } {poly.name_pattern = ["T_89_", ""]}

  function.def @main() -> index {
    %got = function.call @"T_89_\1A"::@compute<[13]>() : () -> index
    function.return %got : index
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @T_89_13_compute() -> index {
// CHECK-NEXT:      %[[VAL_0:[0-9a-zA-Z_\.]+]] = arith.constant 13 : index
// CHECK-NEXT:      function.return %[[VAL_0]] : index
// CHECK-NEXT:    }
// CHECK-NEXT:    poly.template @"T_89_\1A" {
// CHECK-NEXT:      poly.param @B : index
// CHECK-NEXT:      function.def @compute() -> index {
// CHECK-NEXT:        %[[VAL_1:[0-9a-zA-Z_\.]+]] = poly.read_const @B : index
// CHECK-NEXT:        function.return %[[VAL_1]] : index
// CHECK-NEXT:      }
// CHECK-NEXT:    } {poly.name_pattern = ["T_89_", ""]}
// CHECK-NEXT:    function.def @main() -> index {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = function.call @T_89_13_compute() : () -> index
// CHECK-NEXT:      function.return %[[VAL_2]] : index
// CHECK-NEXT:    }
// CHECK-NEXT:  }

