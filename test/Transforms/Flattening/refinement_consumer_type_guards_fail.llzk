// RUN: llzk-opt -split-input-file -llzk-flatten -verify-diagnostics %s

#id = affine_map<(i) -> (i)>
module attributes {llzk.lang} {
  poly.template @TCell {
    poly.param @N : index
    struct.def @Cell {
      struct.member @value : !felt.type {column}
      function.def @compute() -> !struct.type<@TCell::@Cell<[@N]>> {
        %self = struct.new : !struct.type<@TCell::@Cell<[@N]>>
        function.return %self : !struct.type<@TCell::@Cell<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@TCell::@Cell<[@N]>>) {
        function.return
      }
    }
  }

  struct.def @Holder {
    struct.member @items : !array.type<2 x !struct.type<@TCell::@Cell<[#id]>>> {column}
    struct.member @wrong : !struct.type<@TCell::@Cell<[1]>> {column}

    function.def @compute() -> !struct.type<@Holder> {
      %self = struct.new : !struct.type<@Holder>
      %c0 = arith.constant 0 : index
      %c1 = arith.constant 1 : index
      %local = array.new : !array.type<2 x !struct.type<@TCell::@Cell<[#id]>>>
      %item0 = function.call @TCell::@Cell::@compute() : () -> !struct.type<@TCell::@Cell<[0]>>
      %item1 = function.call @TCell::@Cell::@compute() : () -> !struct.type<@TCell::@Cell<[1]>>
      array.write %local[%c0] = %item0 : !array.type<2 x !struct.type<@TCell::@Cell<[#id]>>>, !struct.type<@TCell::@Cell<[0]>>
      array.write %local[%c1] = %item1 : !array.type<2 x !struct.type<@TCell::@Cell<[#id]>>>, !struct.type<@TCell::@Cell<[1]>>
      // The generic read is valid before scalarization, but its concrete index-zero value cannot
      // replace this use, which requires Cell<1>.
      // expected-error@+1 {{cannot scalarize heterogeneous array read because its index-specific value type is incompatible with a member write}}
      %read0 = array.read %local[%c0] : !array.type<2 x !struct.type<@TCell::@Cell<[#id]>>>, !struct.type<@TCell::@Cell<[#id]>>
      // expected-note@+1 {{member write requires '!struct.type<@TCell_1_Cell>', but this read is replaced with '!struct.type<@TCell_0_Cell>'}}
      struct.writem %self[@wrong] = %read0 : !struct.type<@Holder>, !struct.type<@TCell::@Cell<[#id]>>
      struct.writem %self[@items] = %local : !struct.type<@Holder>, !array.type<2 x !struct.type<@TCell::@Cell<[#id]>>>
      function.return %self : !struct.type<@Holder>
    }

    function.def @constrain(%self: !struct.type<@Holder>) {
      function.return
    }
  }
}

// -----

// A direct member read used as an array.extract base must not retag the extract result when a
// downstream call independently requires Cell<1>. Keep the member read generic instead.
#id = affine_map<(i) -> (i)>
module attributes {llzk.lang} {
  poly.template @TCellDirectExtract {
    poly.param @N : index

    // expected-warning@+1 {{Parameterized definition still has uses!}}
    struct.def @Cell {
      struct.member @value : !felt.type {column}

      function.def @compute() -> !struct.type<@TCellDirectExtract::@Cell<[@N]>> {
        %self = struct.new : !struct.type<@TCellDirectExtract::@Cell<[@N]>>
        function.return %self : !struct.type<@TCellDirectExtract::@Cell<[@N]>>
      }

      function.def @constrain(%self: !struct.type<@TCellDirectExtract::@Cell<[@N]>>) {
        function.return
      }
    }
  }

  function.def @consumeExtract1(%value: !array.type<2 x !struct.type<@TCellDirectExtract::@Cell<[1]>>>) {
    function.return
  }

  struct.def @DirectExtractHolder {
    struct.member @items : !array.type<1,2 x !struct.type<@TCellDirectExtract::@Cell<[#id]>>> {column}

    function.def @compute() -> !struct.type<@DirectExtractHolder> {
      %self = struct.new : !struct.type<@DirectExtractHolder>
      %index = arith.constant 0 : index
      %item0 = function.call @TCellDirectExtract::@Cell::@compute() : () -> !struct.type<@TCellDirectExtract::@Cell<[0]>>
      %items0 = array.new %item0, %item0 : !array.type<1,2 x !struct.type<@TCellDirectExtract::@Cell<[0]>>>
      // The extract result's concrete downstream consumer keeps this read generic, so this
      // otherwise refining member write is diagnosed after template instantiation.
      // expected-error@+1 {{'struct.writem' op has wrong type; expected '!array.type<1,2 x !struct.type<@TCellDirectExtract::@Cell<[affine_map<(d0) -> (d0)>]>>>', got '!array.type<1,2 x !struct.type<@TCellDirectExtract_0_Cell>>'}}
      struct.writem %self[@items] = %items0 : !struct.type<@DirectExtractHolder>, !array.type<1,2 x !struct.type<@TCellDirectExtract::@Cell<[0]>>>
      %read = struct.readm %self[@items] : !struct.type<@DirectExtractHolder>, !array.type<1,2 x !struct.type<@TCellDirectExtract::@Cell<[#id]>>>
      %row = array.extract %read[%index] : !array.type<1,2 x !struct.type<@TCellDirectExtract::@Cell<[#id]>>>
      function.call @consumeExtract1(%row) : (!array.type<2 x !struct.type<@TCellDirectExtract::@Cell<[#id]>>>) -> ()
      function.return %self : !struct.type<@DirectExtractHolder>
    }

    function.def @constrain(%self: !struct.type<@DirectExtractHolder>) {
      function.return
    }
  }
}

// -----

// A direct member read used as an array.insert rvalue must not be retagged to Cell<0> when its
// independently typed destination requires Cell<1>. The generic source is intentionally retained
// and therefore diagnosed after template instantiation.
#id = affine_map<(i) -> (i)>
module attributes {llzk.lang} {
  poly.template @TCellDirectInsert {
    poly.param @N : index

    // expected-warning@+1 {{Parameterized definition still has uses!}}
    struct.def @Cell {
      struct.member @value : !felt.type {column}

      function.def @compute() -> !struct.type<@TCellDirectInsert::@Cell<[@N]>> {
        %self = struct.new : !struct.type<@TCellDirectInsert::@Cell<[@N]>>
        function.return %self : !struct.type<@TCellDirectInsert::@Cell<[@N]>>
      }

      function.def @constrain(%self: !struct.type<@TCellDirectInsert::@Cell<[@N]>>) {
        function.return
      }
    }
  }

  struct.def @DirectInsertHolder {
    struct.member @items : !array.type<1,2 x !struct.type<@TCellDirectInsert::@Cell<[#id]>>> {column}

    function.def @compute() -> !struct.type<@DirectInsertHolder> {
      %self = struct.new : !struct.type<@DirectInsertHolder>
      %index = arith.constant 0 : index
      %item0 = function.call @TCellDirectInsert::@Cell::@compute() : () -> !struct.type<@TCellDirectInsert::@Cell<[0]>>
      %items0 = array.new %item0, %item0 : !array.type<1,2 x !struct.type<@TCellDirectInsert::@Cell<[0]>>>
      struct.writem %self[@items] = %items0 : !struct.type<@DirectInsertHolder>, !array.type<1,2 x !struct.type<@TCellDirectInsert::@Cell<[0]>>>
      %read = struct.readm %self[@items] : !struct.type<@DirectInsertHolder>, !array.type<1,2 x !struct.type<@TCellDirectInsert::@Cell<[#id]>>>
      %destination = array.new : !array.type<1,1,2 x !struct.type<@TCellDirectInsert::@Cell<[1]>>>
      // expected-error@+1 {{'array.insert' op incorrect array element type; expected: '!struct.type<@TCellDirectInsert_1_Cell>', found: '!struct.type<@TCellDirectInsert::@Cell<[affine_map<(d0) -> (d0)>]>>'}}
      array.insert %destination[%index] = %read : !array.type<1,1,2 x !struct.type<@TCellDirectInsert::@Cell<[1]>>>, !array.type<1,2 x !struct.type<@TCellDirectInsert::@Cell<[#id]>>>
      function.return %self : !struct.type<@DirectInsertHolder>
    }

    function.def @constrain(%self: !struct.type<@DirectInsertHolder>) {
      function.return
    }
  }
}

