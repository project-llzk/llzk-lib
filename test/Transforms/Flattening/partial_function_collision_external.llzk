// CHECK-NEXT:        function.def @relay(%[[VAL_18:[0-9a-zA-Z_.-]+]]: !array.type<@A,@B x !felt.type>) -> !felt.type {
// CHECK-NEXT:          %[[VAL_19:[0-9a-zA-Z_.-]+]] = function.call @lib::@"Callee_8_\1A"::@helper(%[[VAL_18]]) : (!array.type<@A,@B x !felt.type>) -> !felt.type
// CHECK-NEXT:          %[[VAL_20:[0-9a-zA-Z_.-]+]] = function.call @lib::@Callee::@helper(%[[VAL_18]]) : (!array.type<@A,@B x !felt.type>) -> !felt.type
// CHECK-NEXT:          %[[VAL_21:[0-9a-zA-Z_.-]+]] = felt.add %[[VAL_19]], %[[VAL_20]] : !felt.type, !felt.type
// CHECK-NEXT:          function.return %[[VAL_21]] : !felt.type
// CHECK-NEXT:        }
// CHECK-NEXT:      }
// CHECK-NEXT:      poly.template @Caller {
// CHECK-NEXT:        poly.param @N : index
// CHECK-NEXT:        function.def @g(%[[VAL_22:[0-9a-zA-Z_.-]+]]: !array.type<8,@N x !felt.type>) -> !felt.type {
// CHECK-NEXT:          %[[VAL_23:[0-9a-zA-Z_.-]+]] = function.call @lib::@"Callee_8_\1A_0"::@f(%[[VAL_22]]) : (!array.type<8,@N x !felt.type>) -> !felt.type
// CHECK-NEXT:          function.return %[[VAL_23]] : !felt.type
// CHECK-NEXT:        }
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }
