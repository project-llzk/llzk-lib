// RUN: llzk-opt -split-input-file -llzk-flatten %s | FileCheck --enable-var-scope %s

// A partial template collision must rename calls to copied siblings while preserving an
// external call whose template component has the same spelling in a different module.
module attributes {llzk.lang} {
  module @other {
    module @"Callee_8_\1A" {
      function.def @g(%value: !felt.type) -> !felt.type {
        function.return %value : !felt.type
      }
    }
  }
  module @lib {
    // This name is the preferred name for the partial instantiation of @Callee below.
    poly.template @"Callee_8_\1A" {
      poly.param @B : index

      function.def @helper(%input: !array.type<8,@B x !felt.type>) -> !felt.type {
        %zero = arith.constant 0 : index
        %result = array.read %input[%zero, %zero] : !array.type<8,@B x !felt.type>, !felt.type
        function.return %result : !felt.type
      }
    }

    poly.template @Callee {
      poly.param @A : index
      poly.param @B : index

      function.def @helper(%input: !array.type<@A,@B x !felt.type>) -> !felt.type {
        %one = arith.constant 1 : index
        %result = array.read %input[%one, %one] : !array.type<@A,@B x !felt.type>, !felt.type
        function.return %result : !felt.type
      }

      function.def @f(%input: !array.type<@A,@B x !felt.type>) -> !felt.type {
        %result = function.call @lib::@Callee::@helper(%input) : (!array.type<@A,@B x !felt.type>) -> !felt.type
        %external = function.call @other::@"Callee_8_\1A"::@g(%result) : (!felt.type) -> !felt.type
        function.return %external : !felt.type
      }
    }

    poly.template @Caller {
      poly.param @N : index

      function.def @g(%input: !array.type<8,@N x !felt.type>) -> !felt.type {
        %result = function.call @lib::@Callee::@f(%input) : (!array.type<8,@N x !felt.type>) -> !felt.type
        function.return %result : !felt.type
      }
    }
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    module @other {
// CHECK-NEXT:      module @"Callee_8_\1A" {
// CHECK-NEXT:        function.def @g(%[[VAL_0:[0-9a-zA-Z_.-]+]]: !felt.type) -> !felt.type {
// CHECK-NEXT:          function.return %[[VAL_0]] : !felt.type
// CHECK-NEXT:        }
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    module @lib {
// CHECK-NEXT:      poly.template @"Callee_8_\1A" {
// CHECK-NEXT:        poly.param @B : index
// CHECK-NEXT:        function.def @helper(%[[VAL_1:[0-9a-zA-Z_.-]+]]: !array.type<8,@B x !felt.type>) -> !felt.type {
// CHECK-NEXT:          %[[VAL_2:[0-9a-zA-Z_.-]+]] = arith.constant 0 : index
// CHECK-NEXT:          %[[VAL_3:[0-9a-zA-Z_.-]+]] = array.read %[[VAL_1]]{{\[}}%[[VAL_2]], %[[VAL_2]]] : <8,@B x !felt.type>, !felt.type
// CHECK-NEXT:          function.return %[[VAL_3]] : !felt.type
// CHECK-NEXT:        }
// CHECK-NEXT:      }
// CHECK-NEXT:      poly.template @"Callee_8_\1A_0" {
// CHECK-NEXT:        poly.param @B : index
// CHECK-NEXT:        function.def @f(%[[VAL_4:[0-9a-zA-Z_.-]+]]: !array.type<8,@B x !felt.type>) -> !felt.type {
// CHECK-NEXT:          %[[VAL_5:[0-9a-zA-Z_.-]+]] = function.call @lib::@"Callee_8_\1A_0"::@helper(%[[VAL_4]]) : (!array.type<8,@B x !felt.type>) -> !felt.type
// CHECK-NEXT:          %[[VAL_6:[0-9a-zA-Z_.-]+]] = function.call @other::@"Callee_8_\1A"::@g(%[[VAL_5]]) : (!felt.type) -> !felt.type
// CHECK-NEXT:          function.return %[[VAL_6]] : !felt.type
// CHECK-NEXT:        }
// CHECK-NEXT:        function.def @helper(%[[VAL_7:[0-9a-zA-Z_.-]+]]: !array.type<8,@B x !felt.type>) -> !felt.type {
// CHECK-NEXT:          %[[VAL_8:[0-9a-zA-Z_.-]+]] = arith.constant 1 : index
// CHECK-NEXT:          %[[VAL_9:[0-9a-zA-Z_.-]+]] = array.read %[[VAL_7]]{{\[}}%[[VAL_8]], %[[VAL_8]]] : <8,@B x !felt.type>, !felt.type
// CHECK-NEXT:          function.return %[[VAL_9]] : !felt.type
// CHECK-NEXT:        }
// CHECK-NEXT:      } {poly.name_pattern = ["Callee_8_", ""]}
// CHECK-NEXT:      poly.template @Callee {
// CHECK-NEXT:        poly.param @A : index
// CHECK-NEXT:        poly.param @B : index
// CHECK-NEXT:        function.def @helper(%[[VAL_10:[0-9a-zA-Z_.-]+]]: !array.type<@A,@B x !felt.type>) -> !felt.type {
// CHECK-NEXT:          %[[VAL_11:[0-9a-zA-Z_.-]+]] = arith.constant 1 : index
// CHECK-NEXT:          %[[VAL_12:[0-9a-zA-Z_.-]+]] = array.read %[[VAL_10]]{{\[}}%[[VAL_11]], %[[VAL_11]]] : <@A,@B x !felt.type>, !felt.type
// CHECK-NEXT:          function.return %[[VAL_12]] : !felt.type
// CHECK-NEXT:        }
// CHECK-NEXT:      }
// CHECK-NEXT:      poly.template @Caller {
// CHECK-NEXT:        poly.param @N : index
// CHECK-NEXT:        function.def @g(%[[VAL_13:[0-9a-zA-Z_.-]+]]: !array.type<8,@N x !felt.type>) -> !felt.type {
// CHECK-NEXT:          %[[VAL_14:[0-9a-zA-Z_.-]+]] = function.call @lib::@"Callee_8_\1A_0"::@f(%[[VAL_13]]) : (!array.type<8,@N x !felt.type>) -> !felt.type
// CHECK-NEXT:          function.return %[[VAL_14]] : !felt.type
// CHECK-NEXT:        }
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

// Calls to an existing template with the partial template's exact provisional path must remain
// external, including inside a copied sibling. Matching only the qualified path is insufficient:
// the external and copied @helper functions have the same signature but different behavior.
// The external helper receives its own partial instantiation; both calls must stay distinct.
module attributes {llzk.lang} {
  module @lib {
    poly.template @"Callee_8_\1A" {
      poly.param @A : index
      poly.param @B : index

      function.def @helper(%input: !array.type<@A,@B x !felt.type>) -> !felt.type {
        %zero = arith.constant 0 : index
        %result = array.read %input[%zero, %zero] : !array.type<@A,@B x !felt.type>, !felt.type
        function.return %result : !felt.type
      }
    }

    poly.template @Callee {
      poly.param @A : index
      poly.param @B : index

      function.def @helper(%input: !array.type<@A,@B x !felt.type>) -> !felt.type {
        %one = arith.constant 1 : index
        %result = array.read %input[%one, %one] : !array.type<@A,@B x !felt.type>, !felt.type
        function.return %result : !felt.type
      }

      function.def @relay(%input: !array.type<@A,@B x !felt.type>) -> !felt.type {
        %external = function.call @lib::@"Callee_8_\1A"::@helper(%input) : (!array.type<@A,@B x !felt.type>) -> !felt.type
        %sibling = function.call @lib::@Callee::@helper(%input) : (!array.type<@A,@B x !felt.type>) -> !felt.type
        %result = felt.add %external, %sibling
        function.return %result : !felt.type
      }

      function.def @f(%input: !array.type<@A,@B x !felt.type>) -> !felt.type {
        %result = function.call @lib::@Callee::@relay(%input) : (!array.type<@A,@B x !felt.type>) -> !felt.type
        function.return %result : !felt.type
      }
    }

    poly.template @Caller {
      poly.param @N : index

      function.def @g(%input: !array.type<8,@N x !felt.type>) -> !felt.type {
        %result = function.call @lib::@Callee::@f(%input) : (!array.type<8,@N x !felt.type>) -> !felt.type
        function.return %result : !felt.type
      }
    }
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    module @lib {
// CHECK-NEXT:      poly.template @"Callee_8_\1A_8_\1A" {
// CHECK-NEXT:        poly.param @B : index
// CHECK-NEXT:        function.def @helper(%[[VAL_0:[0-9a-zA-Z_.-]+]]: !array.type<8,@B x !felt.type>) -> !felt.type {
// CHECK-NEXT:          %[[VAL_1:[0-9a-zA-Z_.-]+]] = arith.constant 0 : index
// CHECK-NEXT:          %[[VAL_2:[0-9a-zA-Z_.-]+]] = array.read %[[VAL_0]]{{\[}}%[[VAL_1]], %[[VAL_1]]] : <8,@B x !felt.type>, !felt.type
// CHECK-NEXT:          function.return %[[VAL_2]] : !felt.type
// CHECK-NEXT:        }
// CHECK-NEXT:      } {poly.name_pattern = ["Callee_8_\1A_8_", ""]}
// CHECK-NEXT:      poly.template @"Callee_8_\1A" {
// CHECK-NEXT:        poly.param @A : index
// CHECK-NEXT:        poly.param @B : index
// CHECK-NEXT:        function.def @helper(%[[VAL_3:[0-9a-zA-Z_.-]+]]: !array.type<@A,@B x !felt.type>) -> !felt.type {
// CHECK-NEXT:          %[[VAL_4:[0-9a-zA-Z_.-]+]] = arith.constant 0 : index
// CHECK-NEXT:          %[[VAL_5:[0-9a-zA-Z_.-]+]] = array.read %[[VAL_3]]{{\[}}%[[VAL_4]], %[[VAL_4]]] : <@A,@B x !felt.type>, !felt.type
// CHECK-NEXT:          function.return %[[VAL_5]] : !felt.type
// CHECK-NEXT:        }
// CHECK-NEXT:      }
// CHECK-NEXT:      poly.template @"Callee_8_\1A_0" {
// CHECK-NEXT:        poly.param @B : index
// CHECK-NEXT:        function.def @f(%[[VAL_6:[0-9a-zA-Z_.-]+]]: !array.type<8,@B x !felt.type>) -> !felt.type {
// CHECK-NEXT:          %[[VAL_7:[0-9a-zA-Z_.-]+]] = function.call @lib::@"Callee_8_\1A_0"::@relay(%[[VAL_6]]) : (!array.type<8,@B x !felt.type>) -> !felt.type
// CHECK-NEXT:          function.return %[[VAL_7]] : !felt.type
// CHECK-NEXT:        }
// CHECK-NEXT:        function.def @relay(%[[VAL_8:[0-9a-zA-Z_.-]+]]: !array.type<8,@B x !felt.type>) -> !felt.type {
// CHECK-NEXT:          %[[VAL_9:[0-9a-zA-Z_.-]+]] = function.call @lib::@"Callee_8_\1A_8_\1A"::@helper(%[[VAL_8]]) : (!array.type<8,@B x !felt.type>) -> !felt.type
// CHECK-NEXT:          %[[VAL_10:[0-9a-zA-Z_.-]+]] = function.call @lib::@"Callee_8_\1A_0"::@helper(%[[VAL_8]]) : (!array.type<8,@B x !felt.type>) -> !felt.type
// CHECK-NEXT:          %[[VAL_11:[0-9a-zA-Z_.-]+]] = felt.add %[[VAL_9]], %[[VAL_10]] : !felt.type, !felt.type
// CHECK-NEXT:          function.return %[[VAL_11]] : !felt.type
// CHECK-NEXT:        }
// CHECK-NEXT:        function.def @helper(%[[VAL_12:[0-9a-zA-Z_.-]+]]: !array.type<8,@B x !felt.type>) -> !felt.type {
// CHECK-NEXT:          %[[VAL_13:[0-9a-zA-Z_.-]+]] = arith.constant 1 : index
// CHECK-NEXT:          %[[VAL_14:[0-9a-zA-Z_.-]+]] = array.read %[[VAL_12]]{{\[}}%[[VAL_13]], %[[VAL_13]]] : <8,@B x !felt.type>, !felt.type
// CHECK-NEXT:          function.return %[[VAL_14]] : !felt.type
// CHECK-NEXT:        }
// CHECK-NEXT:      } {poly.name_pattern = ["Callee_8_", ""]}
// CHECK-NEXT:      poly.template @Callee {
// CHECK-NEXT:        poly.param @A : index
// CHECK-NEXT:        poly.param @B : index
// CHECK-NEXT:        function.def @helper(%[[VAL_15:[0-9a-zA-Z_.-]+]]: !array.type<@A,@B x !felt.type>) -> !felt.type {
// CHECK-NEXT:          %[[VAL_16:[0-9a-zA-Z_.-]+]] = arith.constant 1 : index
// CHECK-NEXT:          %[[VAL_17:[0-9a-zA-Z_.-]+]] = array.read %[[VAL_15]]{{\[}}%[[VAL_16]], %[[VAL_16]]] : <@A,@B x !felt.type>, !felt.type
// CHECK-NEXT:          function.return %[[VAL_17]] : !felt.type
