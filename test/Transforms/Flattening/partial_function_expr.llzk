// CHECK-NEXT:        %[[VAL_2:[0-9a-zA-Z_\.]+]] = arith.addi %[[VAL_1]], %[[VAL_0]] : index
// CHECK-NEXT:        poly.yield %[[VAL_2]] : index
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @f(%[[VAL_3:[0-9a-zA-Z_\.]+]]: !array.type<8,@B x !felt.type>) -> !felt.type attributes {test.signature_type = !array.type<@Length x !felt.type>} {
