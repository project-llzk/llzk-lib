// RUN: split-file %s %t
// RUN: cat %t/generic.llzk %t/felt.llzk > %t/complete-felt.llzk
// RUN: llzk-opt -llzk-flatten %t/complete-felt.llzk | FileCheck %s --check-prefix=FELT
// RUN: cat %t/generic.llzk %t/index.llzk > %t/complete-index.llzk
// RUN: not llzk-opt -llzk-flatten %t/complete-index.llzk 2>&1 | FileCheck %s --check-prefix=INDEX

// Assemble each complete module before flattening; all instantiation sites are visible.

//--- generic.llzk
// A repeated T identity must keep its relationship with the other occurrence of T.
module attributes {llzk.lang} {
  poly.template @RepeatedIdentity {
    poly.param @T
    struct.def @Holder {
      struct.member @pair : !pod.type<[@a: !poly.tvar<@T>, @b: !poly.tvar<@T>]>
      function.def @compute(%input: !pod.type<[@a: !poly.tvar<@T>, @b: !felt.type]>) -> !struct.type<@RepeatedIdentity::@Holder<[@T]>> {
        %self = struct.new : !struct.type<@RepeatedIdentity::@Holder<[@T]>>
        struct.writem %self[@pair] = %input : !struct.type<@RepeatedIdentity::@Holder<[@T]>>, !pod.type<[@a: !poly.tvar<@T>, @b: !felt.type]>
        function.return %self : !struct.type<@RepeatedIdentity::@Holder<[@T]>>
      }
      function.def @constrain(%self: !struct.type<@RepeatedIdentity::@Holder<[@T]>>, %input: !pod.type<[@a: !poly.tvar<@T>, @b: !felt.type]>) { function.return }
    }
  }

//--- felt.llzk
  function.def @entry(%input: !pod.type<[@a: !felt.type, @b: !felt.type]>) -> !struct.type<@RepeatedIdentity::@Holder<[!felt.type]>> attributes {function.allow_witness} {
    %result = function.call @RepeatedIdentity::@Holder::@compute(%input) : (!pod.type<[@a: !felt.type, @b: !felt.type]>) -> !struct.type<@RepeatedIdentity::@Holder<[!felt.type]>>
    function.return %result : !struct.type<@RepeatedIdentity::@Holder<[!felt.type]>>
  }
}
