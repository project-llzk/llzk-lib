// FELT-NEXT:    struct.def @RepeatedIdentity_f_Holder {
// FELT-NEXT:      struct.member @pair : !pod.type<[@a: !felt.type, @b: !felt.type]>
// FELT-NEXT:      function.def @compute(%[[VAL_0:[0-9a-zA-Z_.-]+]]: !pod.type<[@a: !felt.type, @b: !felt.type]>) -> !struct.type<@RepeatedIdentity_f_Holder> attributes {function.allow_witness} {
// FELT-NEXT:        %[[VAL_1:[0-9a-zA-Z_.-]+]] = struct.new : <@RepeatedIdentity_f_Holder>
