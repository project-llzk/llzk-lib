//--- index.llzk
  function.def @entry(%input: !pod.type<[@a: index, @b: !felt.type]>) -> !struct.type<@RepeatedIdentity::@Holder<[index]>> attributes {function.allow_witness} {
    %result = function.call @RepeatedIdentity::@Holder::@compute(%input) : (!pod.type<[@a: index, @b: !felt.type]>) -> !struct.type<@RepeatedIdentity::@Holder<[index]>>
    function.return %result : !struct.type<@RepeatedIdentity::@Holder<[index]>>
  }
}
