// RUN: llzk-opt -llzk-flatten=cleanup=disabled %s | FileCheck %s

// Both body substitution and template-expression evaluation promote IntegerAttr bindings to
// felt literals. Keep their signedness after helper extraction. Wide mathematical values use
// FeltConstAttr; integer template parameters retain the existing index/i1 restrictions.
module attributes {llzk.lang} {
  poly.template @IntegerValues {
    poly.param @N : !felt.type<"babybear">
    poly.expr @Copy {
      %n = poly.read_const @N : !felt.type<"babybear">
      poly.yield %n : !felt.type<"babybear">
    }
    function.def @values() -> (!felt.type<"babybear">, !felt.type<"babybear">) {
      %direct = poly.read_const @N : !felt.type<"babybear">
      %expr = poly.read_const @Copy : !felt.type<"babybear">
      function.return %direct, %expr : !felt.type<"babybear">, !felt.type<"babybear">
    }
  }
  function.def @main() {
    %negative:2 = function.call @IntegerValues::@values<[-3]>() : () -> (!felt.type<"babybear">, !felt.type<"babybear">)
    %wide:2 = function.call @IntegerValues::@values<[#felt<const -18446744073709551617 : !felt.type<"babybear">>]>() : () -> (!felt.type<"babybear">, !felt.type<"babybear">)
    %unsigned:2 = function.call @IntegerValues::@values<[255 : ui8]>() : () -> (!felt.type<"babybear">, !felt.type<"babybear">)
    %boolean:2 = function.call @IntegerValues::@values<[true]>() : () -> (!felt.type<"babybear">, !felt.type<"babybear">)
    function.return
  }
}

// CHECK-LABEL:   function.def @"IntegerValues_-3_values"() -> (!felt.type<"babybear">, !felt.type<"babybear">) {
// CHECK-NEXT:      %[[VAL_0:[0-9a-zA-Z_\.\-]+]] = felt.const  -3 : <"babybear">
// CHECK-NEXT:      function.return %[[VAL_0]], %[[VAL_0]] : !felt.type<"babybear">, !felt.type<"babybear">
// CHECK-NEXT:    }

// CHECK-LABEL:   function.def @"IntegerValues_f<-18446744073709551617:8:babybear>_values"() -> (!felt.type<"babybear">, !felt.type<"babybear">) {
// CHECK-NEXT:      %[[VAL_0:[0-9a-zA-Z_\.\-]+]] = felt.const  -18446744073709551617 : <"babybear">
// CHECK-NEXT:      function.return %[[VAL_0]], %[[VAL_0]] : !felt.type<"babybear">, !felt.type<"babybear">
// CHECK-NEXT:    }

// CHECK-LABEL:   function.def @IntegerValues_255_values() -> (!felt.type<"babybear">, !felt.type<"babybear">) {
// CHECK-NEXT:      %[[VAL_0:[0-9a-zA-Z_\.\-]+]] = felt.const  255 : <"babybear">
// CHECK-NEXT:      function.return %[[VAL_0]], %[[VAL_0]] : !felt.type<"babybear">, !felt.type<"babybear">
// CHECK-NEXT:    }

// CHECK-LABEL:   function.def @IntegerValues_1_values() -> (!felt.type<"babybear">, !felt.type<"babybear">) {
// CHECK-NEXT:      %[[VAL_0:[0-9a-zA-Z_\.\-]+]] = felt.const  1 : <"babybear">
// CHECK-NEXT:      function.return %[[VAL_0]], %[[VAL_0]] : !felt.type<"babybear">, !felt.type<"babybear">
// CHECK-NEXT:    }
