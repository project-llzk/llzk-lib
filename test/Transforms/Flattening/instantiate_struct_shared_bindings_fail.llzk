// RUN: llzk-opt -split-input-file -llzk-flatten -verify-diagnostics %s

// Repeated compute arguments must agree.
module attributes {llzk.lang} {
  poly.template @Family {
    poly.param @T
    struct.def @Box {
      struct.member @value : !poly.tvar<@T>
      // expected-note@+1 {{target function declared here}}
      function.def @compute(%a: !poly.tvar<@T>, %b: !poly.tvar<@T>) -> !struct.type<@Family::@Box<[@T]>> {
        %self = struct.new : !struct.type<@Family::@Box<[@T]>>
        function.return %self : !struct.type<@Family::@Box<[@T]>>
      }
      function.def @constrain(%self: !struct.type<@Family::@Box<[@T]>>, %a: !poly.tvar<@T>, %b: !poly.tvar<@T>) { function.return }
    }
  }
  poly.template @Caller {
    poly.param @S
    function.def @caller(%a: !felt.type, %b: index) attributes {function.allow_witness} {
      // expected-error@+1 {{cannot instantiate struct call because the complete call signature has conflicting template bindings}}
      %result = function.call @Family::@Box::@compute(%a, %b) : (!felt.type, index) -> !struct.type<@Family::@Box<[@S]>>
      function.return
    }
  }
}

// -----

// The compute result constrains the same binding as its arguments.
module attributes {llzk.lang} {
  poly.template @Family {
    poly.param @T
    struct.def @Box {
      struct.member @value : !poly.tvar<@T>
      // expected-note@+1 {{target function declared here}}
      function.def @compute(%a: !poly.tvar<@T>, %b: !poly.tvar<@T>) -> !struct.type<@Family::@Box<[@T]>> {
        %self = struct.new : !struct.type<@Family::@Box<[@T]>>
        function.return %self : !struct.type<@Family::@Box<[@T]>>
      }
      function.def @constrain(%self: !struct.type<@Family::@Box<[@T]>>, %a: !poly.tvar<@T>, %b: !poly.tvar<@T>) { function.return }
    }
  }
  poly.template @Caller {
    poly.param @S
    function.def @caller(%a: !felt.type, %b: !felt.type) attributes {function.allow_witness} {
      // expected-error@+1 {{cannot instantiate struct call because the complete call signature has conflicting template bindings}}
      %result = function.call @Family::@Box::@compute(%a, %b) : (!felt.type, !felt.type) -> !struct.type<@Family::@Box<[index]>>
      function.return
    }
  }
}

// -----

// Aliases between caller and callee variables propagate conflicts.
module attributes {llzk.lang} {
  poly.template @Family {
    poly.param @T
    poly.param @U
    struct.def @Box {
      struct.member @value : !poly.tvar<@T>
      // expected-note@+1 {{target function declared here}}
      function.def @compute(%a: !poly.tvar<@T>, %b: !poly.tvar<@T>, %c: !poly.tvar<@U>, %d: !poly.tvar<@U>) -> !struct.type<@Family::@Box<[@T, @U]>> {
        %self = struct.new : !struct.type<@Family::@Box<[@T, @U]>>
        function.return %self : !struct.type<@Family::@Box<[@T, @U]>>
      }
      function.def @constrain(%self: !struct.type<@Family::@Box<[@T, @U]>>, %a: !poly.tvar<@T>, %b: !poly.tvar<@T>, %c: !poly.tvar<@U>, %d: !poly.tvar<@U>) { function.return }
    }
  }
  poly.template @Caller {
    poly.param @S
    function.def @caller(%a: !felt.type, %shared: !poly.tvar<@S>, %d: index) attributes {function.allow_witness} {
      // expected-error@+1 {{cannot instantiate struct call because the complete call signature has conflicting template bindings}}
      %result = function.call @Family::@Box::@compute(%a, %shared, %shared, %d) : (!felt.type, !poly.tvar<@S>, !poly.tvar<@S>, index) -> !struct.type<@Family::@Box<[@S, @S]>>
      function.return
    }
  }
}

// -----

// Constrain methods require the same complete-signature validation.
module attributes {llzk.lang} {
  poly.template @Family {
    poly.param @T
    struct.def @Box {
      struct.member @value : !poly.tvar<@T>
      function.def @compute(%a: !poly.tvar<@T>, %b: !poly.tvar<@T>) -> !struct.type<@Family::@Box<[@T]>> {
        %self = struct.new : !struct.type<@Family::@Box<[@T]>>
        function.return %self : !struct.type<@Family::@Box<[@T]>>
      }
      // expected-note@+1 {{target function declared here}}
      function.def @constrain(%self: !struct.type<@Family::@Box<[@T]>>, %a: !poly.tvar<@T>, %b: !poly.tvar<@T>) { function.return }
    }
  }
  poly.template @Caller {
    poly.param @S
    function.def @caller(%self: !struct.type<@Family::@Box<[@S]>>, %a: !felt.type, %b: index) attributes {function.allow_constraint} {
      // expected-error@+1 {{cannot instantiate struct call because the complete call signature has conflicting template bindings}}
      function.call @Family::@Box::@constrain(%self, %a, %b) : (!struct.type<@Family::@Box<[@S]>>, !felt.type, index) -> ()
      function.return
    }
  }
}

// -----

// Result affine operands do not hide conflicting repeated dimensions.
module attributes {llzk.lang} {
  poly.template @Family {
    poly.param @T : index
    struct.def @Box {
      struct.member @value : !felt.type
      // expected-note@+1 {{target function declared here}}
      function.def @compute(%a: !array.type<@T x !felt.type>, %b: !array.type<@T x !felt.type>) -> !struct.type<@Family::@Box<[@T]>> {
        %self = struct.new : !struct.type<@Family::@Box<[@T]>>
        function.return %self : !struct.type<@Family::@Box<[@T]>>
      }
      function.def @constrain(%self: !struct.type<@Family::@Box<[@T]>>, %a: !array.type<@T x !felt.type>, %b: !array.type<@T x !felt.type>) { function.return }
    }
  }
  poly.template @Caller {
    poly.param @S
    function.def @caller(%a: !array.type<8 x !felt.type>, %b: !array.type<9 x !felt.type>, %n: index) attributes {function.allow_witness} {
      // expected-error@+1 {{cannot instantiate struct call because the complete call signature has conflicting template bindings}}
      %result = function.call @Family::@Box::@compute(%a, %b) {(%n)} : (!array.type<8 x !felt.type>, !array.type<9 x !felt.type>) -> !struct.type<@Family::@Box<[affine_map<(i) -> (i)>]>>
      function.return
    }
  }
}
