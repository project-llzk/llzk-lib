// One: expression and function reads share boolean materialization diagnostics.
module attributes {llzk.lang} {
  poly.template @Callee {
    poly.param @A
    poly.param @B : index
    poly.param @C
    poly.expr @Number {
      %flag = poly.read_const @A : i1
      %value = poly.read_const @A : index {product_source = "expression-integer"}
      %b = poly.read_const @B : index
      %sum = arith.addi %b, %value : index
      %difference = arith.subi %b, %value : index
      %result = arith.select %flag, %sum, %difference : index
      poly.yield %result : index
    }
    function.def @f(%input: !array.type<@B x !felt.type>) -> (index, i1) {
      %number = poly.read_const @Number : index
      %flag = poly.read_const @C : i1 {product_source = "function-boolean"}
      function.return %number, %flag : index, i1
    }
  }
  poly.template @Caller {
    poly.param @N : index
    function.def @g(%input: !array.type<@N x !felt.type>) -> (index, i1) {
      %number, %flag = function.call @Callee::@f<[1, @N, 1]>(%input) : (!array.type<@N x !felt.type>) -> (index, i1)
      function.return %number, %flag : index, i1
    }
  }
}
