// CHECK-NEXT:        function.return %[[VAL_5]], %[[VAL_4]] : index, i1
// CHECK-NEXT:      }
// CHECK-NEXT:    } {poly.name_pattern = ["Callee_1_", "_1"]}
// CHECK-NEXT:    poly.template @Caller {
// CHECK-NEXT:      poly.param @N : index
// CHECK-NEXT:      function.def @g(%[[VAL_6:[0-9a-zA-Z_.-]+]]: !array.type<@N x !felt.type>) -> (index, i1) {
// CHECK-NEXT:        %[[VAL_7:[0-9a-zA-Z_.-]+]]:2 = function.call @"Callee_1_\1A_1"::@f<[@N]>(%[[VAL_6]]) : (!array.type<@N x !felt.type>) -> (index, i1)
// CHECK-NEXT:        function.return %[[VAL_7]]#0, %[[VAL_7]]#1 : index, i1
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }
