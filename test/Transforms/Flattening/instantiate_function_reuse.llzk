// CHECK-NEXT:      %[[VAL_7:[0-9a-zA-Z_\.]+]] = function.call @"T_35_\1A_0"::@compute<[?]>() : () -> index
// CHECK-NEXT:      %[[VAL_8:[0-9a-zA-Z_\.]+]] = function.call @"T_36_\1A"::@compute<[?]>() : () -> index
// CHECK-NEXT:      %[[VAL_9:[0-9a-zA-Z_\.]+]] = function.call @"T_36_\1A"::@compute<[?]>() : () -> index
// CHECK-NEXT:      %[[VAL_10:[0-9a-zA-Z_\.]+]] = function.call @"T_35_\1A_1"::@other<[?]>() : () -> index
