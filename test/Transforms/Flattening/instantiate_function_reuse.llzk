// CHECK-NEXT:        %[[VAL_18:[0-9a-zA-Z_\.]+]] = function.call @"Seam_f<35:5:bn128>_\1A"::@value<[@M]>() : () -> !felt.type<"bn128">
// CHECK-NEXT:        %[[VAL_19:[0-9a-zA-Z_\.]+]] = function.call @"Seam_f<35:5:bn128>_\1A"::@value<[@M]>() : () -> !felt.type<"bn128">
