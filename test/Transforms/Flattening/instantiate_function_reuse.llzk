// CHECK-NEXT:      %[[VAL_5:[0-9a-zA-Z_\.]+]] = arith.constant 99 : index
// CHECK-NEXT:      function.return %[[VAL_5]] : index
// CHECK-NEXT:    }
// CHECK-NEXT:    function.def @main() -> index {
// CHECK-NEXT:      %[[VAL_6:[0-9a-zA-Z_\.]+]] = function.call @T_35_compute_0() : () -> index
// CHECK-NEXT:      %[[VAL_7:[0-9a-zA-Z_\.]+]] = function.call @T_35_compute_0() : () -> index
// CHECK-NEXT:      %[[VAL_8:[0-9a-zA-Z_\.]+]] = function.call @T_36_compute() : () -> index
// CHECK-NEXT:      %[[VAL_9:[0-9a-zA-Z_\.]+]] = function.call @T_36_compute() : () -> index
// CHECK-NEXT:      %[[VAL_10:[0-9a-zA-Z_\.]+]] = function.call @T_35_other() : () -> index
// CHECK-NEXT:      %[[VAL_11:[0-9a-zA-Z_\.]+]] = function.call @T_35_other() : () -> index
// CHECK-NEXT:      function.return %[[VAL_11]] : index
