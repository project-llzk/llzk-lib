// -----

// A concrete outer call specializes its nested target, while a direct call with another binding
// retains a distinct specialization of that target.
module attributes {llzk.lang} {
  poly.template @template_g1 {
    poly.param @N : index

    function.def @f(%inp: !array.type<8,@N x !felt.type>) -> !felt.type {
      %c0 = arith.constant 0 : index
      %2 = array.read %inp[%c0, %c0] : !array.type<8,@N x !felt.type>, !felt.type
      function.return %2 : !felt.type
    }
  }

  poly.template @template_g2 {
    poly.param @N : index
    poly.param @M : index
    poly.param @T : !poly.tvar<@T>

    function.def @f(%inp: !array.type<@N,@M x !poly.tvar<@T>>) -> !poly.tvar<@T> {
      // The outer signature has more dimensions than the nested target, but both still unify.
      %2 = function.call @template_g1::@f(%inp) : (!array.type<@N,@M x !poly.tvar<@T>>) -> !poly.tvar<@T>
      function.return %2 : !poly.tvar<@T>
    }
  }

  struct.def @Main {
    function.def @compute(%y: !array.type<8,12 x !felt.type>, %z: !array.type<8,9 x !felt.type>) -> !struct.type<@Main> {
      %self = struct.new : !struct.type<@Main>
      function.call @template_g1::@f(%y) : (!array.type<8,12 x !felt.type>) -> !felt.type
      function.call @template_g2::@f(%z) : (!array.type<8,9 x !felt.type>) -> !felt.type
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>, %y: !array.type<8,12 x !felt.type>, %z: !array.type<8,9 x !felt.type>) {
      function.return
    }
  }
}

