// RUN: llzk-opt -split-input-file -llzk-flatten -verify-diagnostics %s | FileCheck --enable-var-scope %s

// Signature unification creates concrete free-function clones and materializes their parameter
// reads.
module attributes {llzk.lang} {
  poly.template @template_f1 {
    poly.param @N : index

    function.def @f(%inp: !array.type<8,5,@N x !felt.type>) -> !array.type<@N x !felt.type> {
      %c0 = arith.constant 0 : index
      %2 = array.extract %inp[%c0, %c0] : !array.type<8,5,@N x !felt.type>
      function.return %2 : !array.type<@N x !felt.type>
    }
  }

  poly.template @template_f2 {
    poly.param @N : index

    function.def @f(%inp: !array.type<8,@N x !felt.type>) -> !felt.type {
      %c0 = arith.constant 0 : index
      %2 = array.read %inp[%c0, %c0] : !array.type<8,@N x !felt.type>, !felt.type
      %3 = poly.read_const @N : index
      %4 = cast.tofelt %3 : index, !felt.type
      %5 = felt.add %2, %4 : !felt.type
      function.return %5 : !felt.type
    }
  }

  struct.def @Main {
    function.def @compute(%z: !array.type<8,5,9 x !felt.type>, %y: !array.type<8,12 x !felt.type>) -> !struct.type<@Main> {
      %self = struct.new : !struct.type<@Main>
      function.call @template_f1::@f(%z) : (!array.type<8,5,9 x !felt.type>) -> (!array.type<9 x !felt.type>)
      function.call @template_f2::@f(%y) : (!array.type<8,12 x !felt.type>) -> (!felt.type)
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>, %z: !array.type<8,5,9 x !felt.type>, %y: !array.type<8,12 x !felt.type>) {
      function.return
    }
  }
}

