// -----

// A nested call with one concrete and one symbolic dimension creates a reduced callee template and
// retargets the outer body to that partial specialization.
module attributes {llzk.lang} {
  poly.template @template_h1 {
    poly.param @A : index
    poly.param @B : index

    function.def @f(%inp: !array.type<@A,@B x !felt.type>) -> !felt.type {
      %c0 = arith.constant 0 : index
      %r = array.read %inp[%c0, %c0] : !array.type<@A,@B x !felt.type>, !felt.type
      function.return %r : !felt.type
    }
  }

  poly.template @template_h2 {
    poly.param @N : index

    function.def @g(%inp: !array.type<8,@N x !felt.type>) -> !felt.type {
      %r = function.call @template_h1::@f(%inp) : (!array.type<8,@N x !felt.type>) -> !felt.type
      function.return %r : !felt.type
    }
  }
}

