// CHECK-NEXT:        %[[VAL_4:[0-9a-zA-Z_\.]+]] = function.call @"template_h1_8_\1A"::@f(%[[VAL_3]]) : (!array.type<8,@N x !felt.type>) -> !felt.type
// CHECK-NEXT:        function.return %[[VAL_4]] : !felt.type
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }
