// Include inferred subarray extracts in the same call plan.
module attributes {llzk.lang} {
  poly.template @Consume {
    poly.param @T
    function.def @consume(%a: !array.type<1 x !poly.tvar<@T>>, %b: !array.type<1 x !poly.tvar<@T>>) { function.return }
  }
  poly.template @Caller {
    poly.param @T
    function.def @caller(%a: !felt.type, %b: index) {
      %aa = array.new : !array.type<1,1 x !poly.tvar<@T>>
      %bb = array.new : !array.type<1,1 x !poly.tvar<@T>>
      %c0 = arith.constant 0 : index
      array.write %aa[%c0, %c0] = %a : !array.type<1,1 x !poly.tvar<@T>>, !felt.type
      array.write %bb[%c0, %c0] = %b : !array.type<1,1 x !poly.tvar<@T>>, index
      // expected-note@+1 {{array value would refine to}}
      %ra = array.extract %aa[%c0] : !array.type<1,1 x !poly.tvar<@T>>
      // expected-note@+1 {{array value would refine to}}
      %rb = array.extract %bb[%c0] : !array.type<1,1 x !poly.tvar<@T>>
      // expected-error@+2 {{cannot refine arrays because the complete call signature has conflicting template bindings}}
      // expected-note@+1 {{proposed call signature}}
      function.call @Consume::@consume(%ra, %rb) : (!array.type<1 x !poly.tvar<@T>>, !array.type<1 x !poly.tvar<@T>>) -> ()
      function.return
    }
  }
}

