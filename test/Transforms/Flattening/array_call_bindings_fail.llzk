// -----

// Validate independently typed reads through the same allocation plan.
module attributes {llzk.lang} {
  poly.template @Consume {
    poly.param @T
    function.def @consume(%a: !array.type<1 x !poly.tvar<@T>>, %b: !array.type<1 x !poly.tvar<@T>>) { function.return }
  }
  poly.template @Caller {
    poly.param @T
    function.def @caller(%a: !felt.type, %b: index) attributes {function.allow_constraint} {
      // expected-note@+1 {{array value would refine to}}
      %aa = array.new : !array.type<1 x !poly.tvar<@T>>
      // expected-note@+1 {{array value would refine to}}
      %bb = array.new : !array.type<1 x !poly.tvar<@T>>
      %c0 = arith.constant 0 : index
      %ra = array.read %aa[%c0] : !array.type<1 x !poly.tvar<@T>>, !felt.type
      constrain.eq %ra, %a : !felt.type, !felt.type
      %rb = array.read %bb[%c0] : !array.type<1 x !poly.tvar<@T>>, index
      constrain.eq %rb, %b : index, index
      // expected-error@+2 {{cannot refine arrays because the complete call signature has conflicting template bindings}}
      // expected-note@+1 {{proposed call signature}}
      function.call @Consume::@consume(%aa, %bb) : (!array.type<1 x !poly.tvar<@T>>, !array.type<1 x !poly.tvar<@T>>) -> ()
      function.return
    }
  }
}

