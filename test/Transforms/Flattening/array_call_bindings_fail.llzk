// -----

// Include array initializers derived from pending member reads.

// Pending definitions and reads must be rejected together, before either becomes concrete.
#id = affine_map<(i) -> (i)>
module attributes {llzk.lang} {
  poly.template @TCell {
    poly.param @N : index

    struct.def @Cell {
      struct.member @value : !felt.type {column}

      function.def @compute() -> !struct.type<@TCell::@Cell<[@N]>> {
        %self = struct.new : !struct.type<@TCell::@Cell<[@N]>>
        function.return %self : !struct.type<@TCell::@Cell<[@N]>>
      }

      function.def @constrain(%self: !struct.type<@TCell::@Cell<[@N]>>) {
        function.return
      }
    }
  }

  poly.template @Match {
    poly.param @T : !poly.tvar<@T>
    function.def @consume(%a: !array.type<1 x !poly.tvar<@T>>, %b: !array.type<1 x !poly.tvar<@T>>) {
      function.return
    }
  }

  struct.def @Holder {
    struct.member @left : !struct.type<@TCell::@Cell<[#id]>> {column}
    struct.member @right : !struct.type<@TCell::@Cell<[#id]>> {column}
    function.def @compute() -> !struct.type<@Holder> {
      %self = struct.new : !struct.type<@Holder>
      %zero = function.call @TCell::@Cell::@compute() : () -> !struct.type<@TCell::@Cell<[0]>>
      %one = function.call @TCell::@Cell::@compute() : () -> !struct.type<@TCell::@Cell<[1]>>
      struct.writem %self[@left] = %zero : !struct.type<@Holder>, !struct.type<@TCell::@Cell<[0]>>
      struct.writem %self[@right] = %one : !struct.type<@Holder>, !struct.type<@TCell::@Cell<[1]>>
      %left = struct.readm %self[@left] : !struct.type<@Holder>, !struct.type<@TCell::@Cell<[#id]>>
      %right = struct.readm %self[@right] : !struct.type<@Holder>, !struct.type<@TCell::@Cell<[#id]>>
      // expected-note@+1 {{member read would refine to}}
      %aa = array.new %left : !array.type<1 x !struct.type<@TCell::@Cell<[#id]>>>
      // expected-note@+1 {{member read would refine to}}
      %bb = array.new %right : !array.type<1 x !struct.type<@TCell::@Cell<[#id]>>>
      // expected-error@+2 {{cannot refine member reads because the complete call signature has conflicting template bindings}}
      // expected-note@+1 {{proposed call signature}}
      function.call @Match::@consume(%aa, %bb) : (!array.type<1 x !struct.type<@TCell::@Cell<[#id]>>>, !array.type<1 x !struct.type<@TCell::@Cell<[#id]>>>) -> ()
      function.return %self : !struct.type<@Holder>
    }
    function.def @constrain(%self: !struct.type<@Holder>) { function.return }
  }
}



