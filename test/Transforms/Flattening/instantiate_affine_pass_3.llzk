// RUN: llzk-opt -split-input-file -llzk-flatten -verify-diagnostics %s | FileCheck %s
// RUN: llzk-opt -split-input-file -verify-diagnostics %s

#id = affine_map<(i)->(i)>
!ToFelt = !struct.type<@TToFelt::@ToFelt<[#id]>>
module attributes {llzk.lang} {
  poly.template @TToFelt {
    poly.param @A : !felt.type<"bn128">

    struct.def @ToFelt {
      struct.member @out : !felt.type<"bn128">
      function.def @compute() -> !struct.type<@TToFelt::@ToFelt<[@A]>> {
        %self = struct.new : !struct.type<@TToFelt::@ToFelt<[@A]>>
        %a = poly.read_const @A : !felt.type<"bn128">
        struct.writem %self[@out] = %a : !struct.type<@TToFelt::@ToFelt<[@A]>>, !felt.type<"bn128">
        function.return %self: !struct.type<@TToFelt::@ToFelt<[@A]>>
      }

      function.def @constrain(%self: !struct.type<@TToFelt::@ToFelt<[@A]>>) { function.return }
    }
  }

  poly.template @TComponentA {
    poly.param @T

    struct.def @ComponentA {
      function.def @compute(%inp: !struct.type<@TToFelt::@ToFelt<[@T]>>) -> !struct.type<@TComponentA::@ComponentA<[@T]>> {
        %self = struct.new : !struct.type<@TComponentA::@ComponentA<[@T]>>
        function.return %self : !struct.type<@TComponentA::@ComponentA<[@T]>>
      }

      function.def @constrain(%self: !struct.type<@TComponentA::@ComponentA<[@T]>>, %inp: !struct.type<@TToFelt::@ToFelt<[@T]>>) { function.return }
    }
  }

  struct.def @ComponentB {
    function.def @compute() -> !struct.type<@ComponentB> {
      // In real code, this should be loop induction variable
      %n = arith.constant 2 : index
      %in = function.call @TToFelt::@ToFelt::@compute(){(%n)} : () -> !ToFelt
      %out = function.call @TComponentA::@ComponentA::@compute(%in) : (!ToFelt) -> !struct.type<@TComponentA::@ComponentA<[2]>>

      %self = struct.new : !struct.type<@ComponentB>
      function.return %self : !struct.type<@ComponentB>
    }

    function.def @constrain(%self: !struct.type<@ComponentB>) { function.return }
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    struct.def @TToFelt_2_ToFelt {
// CHECK-NEXT:      struct.member @out : !felt.type<"bn128">
// CHECK-NEXT:      function.def @compute() -> !struct.type<@TToFelt_2_ToFelt> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_0:[0-9a-zA-Z_\.]+]] = felt.const  2 : <"bn128">
// CHECK-NEXT:        %[[VAL_1:[0-9a-zA-Z_\.]+]] = struct.new : <@TToFelt_2_ToFelt>
// CHECK-NEXT:        struct.writem %[[VAL_1]][@out] = %[[VAL_0]] : <@TToFelt_2_ToFelt>, !felt.type<"bn128">
// CHECK-NEXT:        function.return %[[VAL_1]] : !struct.type<@TToFelt_2_ToFelt>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_2:[0-9a-zA-Z_\.]+]]: !struct.type<@TToFelt_2_ToFelt>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    struct.def @TComponentA_2_ComponentA {
// CHECK-NEXT:      function.def @compute(%[[VAL_3:[0-9a-zA-Z_\.]+]]: !struct.type<@TToFelt_2_ToFelt>) -> !struct.type<@TComponentA_2_ComponentA> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_4:[0-9a-zA-Z_\.]+]] = struct.new : <@TComponentA_2_ComponentA>
// CHECK-NEXT:        function.return %[[VAL_4]] : !struct.type<@TComponentA_2_ComponentA>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_5:[0-9a-zA-Z_\.]+]]: !struct.type<@TComponentA_2_ComponentA>, %[[VAL_6:[0-9a-zA-Z_\.]+]]: !struct.type<@TToFelt_2_ToFelt>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    struct.def @ComponentB {
// CHECK-NEXT:      function.def @compute() -> !struct.type<@ComponentB> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_7:[0-9a-zA-Z_\.]+]] = function.call @TToFelt_2_ToFelt::@compute() : () -> !struct.type<@TToFelt_2_ToFelt>
// CHECK-NEXT:        %[[VAL_8:[0-9a-zA-Z_\.]+]] = function.call @TComponentA_2_ComponentA::@compute(%[[VAL_7]]) : (!struct.type<@TToFelt_2_ToFelt>) -> !struct.type<@TComponentA_2_ComponentA>
// CHECK-NEXT:        %[[VAL_9:[0-9a-zA-Z_\.]+]] = struct.new : <@ComponentB>
// CHECK-NEXT:        function.return %[[VAL_9]] : !struct.type<@ComponentB>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_10:[0-9a-zA-Z_\.]+]]: !struct.type<@ComponentB>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }
