// RUN: llzk-opt %s --llzk-monomorphize --llzk-evaluate-constraints | %python %S/ir_helpers.py | FileCheck %s
module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  struct.def @Child {
    struct.member @a : !felt.type {llzk.pub}
    struct.member @b : !felt.type {llzk.pub}
    function.def @compute() -> !struct.type<@Child> {
      %s = struct.new : <@Child>
      function.return %s : !struct.type<@Child>
    }
    function.def @constrain(%s: !struct.type<@Child>) {
      function.return
    }
  }
  struct.def @Main {
    struct.member @children : !array.type<1 x !struct.type<@Child>>
    function.def @compute() -> !struct.type<@Main> {
      %s = struct.new : <@Main>
      function.return %s : !struct.type<@Main>
    }
    function.def @constrain(%s: !struct.type<@Main>) {
      %zero = arith.constant 0 : index
      %children = struct.readm %s[@children] : !struct.type<@Main>, !array.type<1 x !struct.type<@Child>>
      %child = array.read %children[%zero] : !array.type<1 x !struct.type<@Child>>, !struct.type<@Child>
      %a = struct.readm %child[@a] : !struct.type<@Child>, !felt.type
      %b = struct.readm %child[@b] : !struct.type<@Child>, !felt.type
      constrain.eq %a, %b : !felt.type
      function.return
    }
  }
}

