// RUN: llzk-opt %s --llzk-monomorphize --llzk-evaluate-constraints | %python %S/ir_helpers.py | FileCheck %s
// RUN: python %S/check-cleanup-preservation.py llzk-opt %s
module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  function.def @pure(%x: !felt.type, %c: i1) -> !felt.type {
    %r = scf.if %c -> (!felt.type) {
      %a = felt.mul %x, %x
      scf.yield %a : !felt.type
    } else {
      scf.yield %x : !felt.type
    }
    function.return %r : !felt.type
  }
  function.def @wrapper(%x: !felt.type, %c: i1) -> !felt.type {
    %r = function.call @pure(%x, %c) : (!felt.type, i1) -> !felt.type
    function.return %r : !felt.type
  }
  function.def @effect(%x: !felt.type) -> !felt.type attributes {function.allow_constraint} {
    constrain.eq %x, %x : !felt.type
    function.return %x : !felt.type
  }
  function.def @select(%c: i1, %a: index, %b: index, %x: !felt.type) attributes {function.allow_constraint} {
    %bound = arith.select %c, %a, %b : index
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    scf.for %i = %zero to %bound step %one {
      constrain.eq %x, %x : !felt.type
    }
    function.return
  }
  struct.def @Main {
    function.def @compute(%x: !felt.type) -> !struct.type<@Main> {
      %s = struct.new : <@Main>
      function.return %s : !struct.type<@Main>
    }
    function.def @constrain(%s: !struct.type<@Main>, %x: !felt.type) attributes {function.allow_constraint} {
      %z = felt.const 0
      %c = bool.cmp eq(%x, %z) : !felt.type, !felt.type
      scf.if %c {} else {}
      %unused = function.call @wrapper(%x, %c) : (!felt.type, i1) -> !felt.type
      %sign = scf.if %c -> (!felt.type) {
        %neg = felt.neg %unused
        scf.yield %neg : !felt.type
      } else {
        scf.yield %unused : !felt.type
      }
      %effect = function.call @effect(%x) : (!felt.type) -> !felt.type
      %true = arith.constant true
      %two = arith.constant 2 : index
      %three = arith.constant 3 : index
      function.call @select(%true, %two, %three, %x) : (i1, index, index, !felt.type) -> ()
      function.return
    }
  }
}

