// RUN: %python %S/check-preservation.py llzk-opt %s
// RUN: llzk-opt %s --llzk-monomorphize --llzk-evaluate-constraints | %python %S/ir_helpers.py | FileCheck %s
module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  struct.def @Child {
    struct.member @out : !felt.type {llzk.pub}
    function.def @compute(%x: !felt.type) -> !struct.type<@Child> {
      %s = struct.new : <@Child>
      struct.writem %s[@out] = %x : !struct.type<@Child>, !felt.type
      function.return %s : !struct.type<@Child>
    }
    function.def @constrain(%s: !struct.type<@Child>, %x: !felt.type) {
      %out = struct.readm %s[@out] : !struct.type<@Child>, !felt.type
      constrain.eq %out, %x : !felt.type
      function.return
    }
  }
  struct.def @Main {
    struct.member @children : !array.type<2 x !struct.type<@Child>>
    function.def @compute(%x: !felt.type) -> !struct.type<@Main> {
      %s = struct.new : <@Main>
      function.return %s : !struct.type<@Main>
    }
    function.def @constrain(%s: !struct.type<@Main>, %x: !felt.type) {
      %a = struct.readm %s[@children] : !struct.type<@Main>, !array.type<2 x !struct.type<@Child>>
      %zero = arith.constant 0 : index
      %one = arith.constant 1 : index
      %two = arith.constant 2 : index
      %sum = scf.for %i = %zero to %two step %one iter_args(%acc = %x) -> (!felt.type) {
        %child = array.read %a[%i] : !array.type<2 x !struct.type<@Child>>, !struct.type<@Child>
        %square = felt.mul %acc, %acc
        function.call @Child::@constrain(%child, %square) : (!struct.type<@Child>, !felt.type) -> ()
        scf.yield %square : !felt.type
      }
      function.return
    }
  }
}

