// RUN: llzk-opt %s --llzk-monomorphize --llzk-evaluate-constraints | %python %S/ir_helpers.py | FileCheck %s
// RUN: llzk-translate %s --llzk-to-r1cs -o %t.r1cs

// Whole-array subcomponent assignments, multidimensional equality, and slices
// must become scalar equations without changing the frontend's aggregate IR.
!F = !felt.type<"goldilocks">
!A = !array.type<3 x !F>
!M = !array.type<2,3 x !F>
module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  struct.def @Child {
    struct.member @out : !A {llzk.pub}
    function.def @compute(%input: !A) -> !struct.type<@Child> {
      %self = struct.new : <@Child>
      struct.writem %self[@out] = %input : <@Child>, !A
      function.return %self : !struct.type<@Child>
    }
    function.def @constrain(%self: !struct.type<@Child>, %input: !A) {
      %out = struct.readm %self[@out] : <@Child>, !A
      constrain.eq %out, %input : !A, !A
      function.return
    }
  }
  struct.def @Main {
    struct.member @child : !struct.type<@Child>
    struct.member @out : !M {llzk.pub}
    function.def @compute(%input: !M) -> !struct.type<@Main> {
      %self = struct.new : <@Main>
      %one = arith.constant 1 : index
      %row = array.extract %input[%one] : !M
      %child = function.call @Child::@compute(%row) : (!A) -> !struct.type<@Child>
      struct.writem %self[@child] = %child : <@Main>, !struct.type<@Child>
      struct.writem %self[@out] = %input : <@Main>, !M
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>, %input: !M) {
      %one = arith.constant 1 : index
      %row = array.extract %input[%one] : !M
      %child = struct.readm %self[@child] : <@Main>, !struct.type<@Child>
      function.call @Child::@constrain(%child, %row) : (!struct.type<@Child>, !A) -> ()
      %out = struct.readm %self[@out] : <@Main>, !M
      constrain.eq %out, %input : !M, !M
      %slice = array.extract %out[%one] : !M
      constrain.eq %slice, %row : !A, !A
      function.return
    }
  }
}

