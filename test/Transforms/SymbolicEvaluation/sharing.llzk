// CHECK-NEXT:      constrain.eq %[[VAL_1]], %[[VAL_2]] : !felt.type, !felt.type {poly.call_stack = [], poly.loop_indices = [], poly.source_operation = 20 : i64}
// CHECK-NEXT:      function.return
