// RUN: llzk-opt %s --llzk-monomorphize --llzk-evaluate-constraints | FileCheck %s
module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  struct.def @Main {
    struct.member @out : !felt.type {llzk.pub}
    function.def @compute(%x: !felt.type) -> !struct.type<@Main> {
      %s = struct.new : <@Main>
      function.return %s : !struct.type<@Main>
    }
    function.def @constrain(%s: !struct.type<@Main>, %x: !felt.type) {
      %out = struct.readm %s[@out] : !struct.type<@Main>, !felt.type
      %a = felt.mul %x, %x
      %b = felt.mul %x, %x
      constrain.eq %out, %a : !felt.type
      constrain.eq %out, %b : !felt.type
      function.return
    }
  }
}

