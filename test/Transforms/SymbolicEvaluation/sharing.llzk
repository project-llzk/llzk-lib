// RUN: llzk-opt %s --llzk-monomorphize --llzk-evaluate-constraints | %python %S/ir_helpers.py | FileCheck %s
module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  struct.def @Main {
    struct.member @out : !felt.type {llzk.pub}
    function.def @compute(%x: !felt.type) -> !struct.type<@Main> {
      %s = struct.new : <@Main>
      function.return %s : !struct.type<@Main>
    }
    function.def @constrain(%s: !struct.type<@Main>, %x: !felt.type) {
      %out = struct.readm %s[@out] : !struct.type<@Main>, !felt.type
      %a = felt.mul %x, %x
      %b = felt.mul %x, %x
      constrain.eq %out, %a : !felt.type
      constrain.eq %out, %b : !felt.type
      function.return
    }
  }
}

// NOTE: Assertions have been autogenerated by scripts/generate-test-checks.py

// CHECK-LABEL: module {
// CHECK-NEXT:      function.def @constrain(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !struct.type<@__llzk_spec_0>, %[[VAL_1:[0-9a-zA-Z_\.]+]]: !felt.type) attributes {function.allow_constraint, function.allow_non_native_field_ops, poly.evaluated, poly.instances = [{id = 0 : i64, path = [0], specialization = 0 : i64}], poly.signal_bindings = [{instance = 0 : i64, member_path = [1], path = [1], public = false}, {instance = 0 : i64, member_path = ["out"], path = [0, "out"], public = true}], poly.source = @Main::@constrain} {
// CHECK-NEXT:        %[[VAL_2:[0-9a-zA-Z_\.]+]] = felt.mul %[[VAL_1]], %[[VAL_1]] : !felt.type, !felt.type
// CHECK-NEXT:        %[[VAL_3:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_0]][@out] : <@__llzk_spec_0>, !felt.type {poly.signal_binding = {instance = 0 : i64, member_path = ["out"], path = [0, "out"], public = true}}
// CHECK-NEXT:        constrain.eq %[[VAL_3]], %[[VAL_2]] : !felt.type, !felt.type {poly.call_stack = [], poly.loop_indices = [], poly.source_operation = 19 : i64}
// CHECK-NEXT:        constrain.eq %[[VAL_3]], %[[VAL_2]] : !felt.type, !felt.type {poly.call_stack = [], poly.loop_indices = [], poly.source_operation = 20 : i64}
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:  }
