// RUN: llzk-opt %s --llzk-monomorphize --llzk-evaluate-constraints=report=true -o %t 2>%t.log
// RUN: python %S/check-inverse-cache.py %t.log %t
module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  function.def @check(%x: !felt.type<"babybear">) attributes {function.allow_constraint, function.allow_non_native_field_ops} {
    %one = felt.const 1 : <"babybear">
    %inverse = felt.inv %x : !felt.type<"babybear">
    %product = felt.mul %x, %inverse : !felt.type<"babybear">, !felt.type<"babybear">
    constrain.eq %product, %one : !felt.type<"babybear">
    function.return
  }
  struct.def @Main {
    function.def @compute() -> !struct.type<@Main> {
      %s = struct.new : <@Main>
      function.return %s : !struct.type<@Main>
    }
    function.def @constrain(%s: !struct.type<@Main>) attributes {function.allow_non_native_field_ops} {
      %one = arith.constant 1 : index
      %end = arith.constant 8194 : index
      scf.for %i = %one to %end step %one {
        %x = cast.tofelt %i : index, !felt.type<"babybear">
        function.call @check(%x) : (!felt.type<"babybear">) -> ()
      }
      %retained = felt.const 2 : <"babybear">
      %first = felt.const 1 : <"babybear">
      function.call @check(%retained) : (!felt.type<"babybear">) -> ()
      function.call @check(%first) : (!felt.type<"babybear">) -> ()
      function.return
    }
  }
}
