// RUN: llzk-opt %s --llzk-monomorphize --llzk-evaluate-constraints | %python %S/ir_helpers.py | FileCheck %s
// Every position in a 2-by-3 field selects a different pair of parameters:
// tiles[i,j] : Tile<i+1, j+2>.
// This illustrates definition discovery, not witness computation or field initialization.
#rows = affine_map<(i, j) -> (i + 1)>
#cols = affine_map<(i, j) -> (j + 2)>
module attributes {llzk.lang, llzk.main = !struct.type<@Board>} {
  poly.template @Tile {
    poly.param @Rows : index
    poly.param @Cols : index
    struct.def @Tile {
      struct.member @cells : !array.type<@Rows, @Cols x !felt.type>
      function.def @compute() -> !struct.type<@Tile::@Tile<[@Rows, @Cols]>> {
        %tile = struct.new : !struct.type<@Tile::@Tile<[@Rows, @Cols]>>
        function.return %tile : !struct.type<@Tile::@Tile<[@Rows, @Cols]>>
      }
      function.def @constrain(%tile: !struct.type<@Tile::@Tile<[@Rows, @Cols]>>) {
        %rows = poly.read_const @Rows : index
        %cols = poly.read_const @Cols : index
        %zero = arith.constant 0 : index
        %one = arith.constant 1 : index
        %f = felt.const 1
        %cells = struct.readm %tile[@cells] : !struct.type<@Tile::@Tile<[@Rows, @Cols]>>, !array.type<@Rows, @Cols x !felt.type>
        scf.for %i = %zero to %rows step %one {
          scf.for %j = %zero to %cols step %one {
            %v = array.read %cells[%i, %j] : !array.type<@Rows, @Cols x !felt.type>, !felt.type
            constrain.eq %v, %f : !felt.type
          }
        }
        function.return
      }
    }
  }
  struct.def @Board {
    struct.member @tiles : !array.type<2, 3 x !struct.type<@Tile::@Tile<[#rows, #cols]>>>
    function.def @compute() -> !struct.type<@Board> {
      %board = struct.new : !struct.type<@Board>
      %zero = arith.constant 0 : index
      %one = arith.constant 1 : index
      %two = arith.constant 2 : index
      %three = arith.constant 3 : index
      scf.for %i = %zero to %two step %one {
        scf.for %j = %zero to %three step %one {
          %tile = function.call @Tile::@Tile::@compute() {(%i, %j), (%i, %j)} : () -> !struct.type<@Tile::@Tile<[#rows, #cols]>>
        }
      }
      function.return %board : !struct.type<@Board>
    }
    function.def @constrain(%board: !struct.type<@Board>) {
      %tiles = struct.readm %board[@tiles] : !struct.type<@Board>, !array.type<2, 3 x !struct.type<@Tile::@Tile<[#rows, #cols]>>>
      %zero = arith.constant 0 : index
      %one = arith.constant 1 : index
      %two = arith.constant 2 : index
      %three = arith.constant 3 : index
      scf.for %i = %zero to %two step %one {
        scf.for %j = %zero to %three step %one {
          %tile = array.read %tiles[%i, %j] : !array.type<2, 3 x !struct.type<@Tile::@Tile<[#rows, #cols]>>>, !struct.type<@Tile::@Tile<[#rows, #cols]>>
          function.call @Tile::@Tile::@constrain(%tile) : (!struct.type<@Tile::@Tile<[#rows, #cols]>>) -> ()
        }
      }
      function.return
    }
  }
}

