// RUN: llzk-opt %s --llzk-monomorphize --llzk-evaluate-constraints=report=true 2>%t.log | %python %S/ir_helpers.py | FileCheck %s
// RUN: python %S/check-inverse-cache.py %t.log
module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  function.def @divide(%a: !felt.type<"bn128">, %b: !felt.type<"bn128">) -> !felt.type<"bn128"> attributes {function.allow_non_native_field_ops} {
    %r = felt.div %a, %b : !felt.type<"bn128">, !felt.type<"bn128">
    function.return %r : !felt.type<"bn128">
  }
  function.def @inverse(%b: !felt.type<"bn128">) -> !felt.type<"bn128"> attributes {function.allow_non_native_field_ops} {
    %r = felt.inv %b : !felt.type<"bn128">
    function.return %r : !felt.type<"bn128">
  }
  function.def @other(%b: !felt.type<"goldilocks">) -> !felt.type<"goldilocks"> attributes {function.allow_non_native_field_ops} {
    %r = felt.inv %b : !felt.type<"goldilocks">
    function.return %r : !felt.type<"goldilocks">
  }
  function.def @alias(%b: !felt.type<"bn254">) -> !felt.type<"bn254"> attributes {function.allow_non_native_field_ops} {
    %r = felt.inv %b : !felt.type<"bn254">
    function.return %r : !felt.type<"bn254">
  }
  struct.def @Main {
    function.def @compute() -> !struct.type<@Main> {
      %s = struct.new : <@Main>
      function.return %s : !struct.type<@Main>
    }
    function.def @constrain(%s: !struct.type<@Main>) attributes {function.allow_non_native_field_ops} {
      // Keep denominators dynamic during monomorphization so evaluation exercises the cache.
      %begin = arith.constant 2 : index
      %end = arith.constant 3 : index
      %step = arith.constant 1 : index
      scf.for %i = %begin to %end step %step {
        %two = cast.tofelt %i : index, !felt.type<"bn128">
        %ten = felt.const 10 : <"bn128">
        %twelve = felt.const 12 : <"bn128">
        %five = felt.const 5 : <"bn128">
        %six = felt.const 6 : <"bn128">
        %half = felt.const 10944121435919637611123202872628637544274182200208017171849102093287904247809 : <"bn128">
        %a = function.call @divide(%ten, %two) : (!felt.type<"bn128">, !felt.type<"bn128">) -> !felt.type<"bn128">
        %b = function.call @divide(%twelve, %two) : (!felt.type<"bn128">, !felt.type<"bn128">) -> !felt.type<"bn128">
        %c = function.call @inverse(%two) : (!felt.type<"bn128">) -> !felt.type<"bn128">
        constrain.eq %a, %five : !felt.type<"bn128">
        constrain.eq %b, %six : !felt.type<"bn128">
        constrain.eq %c, %half : !felt.type<"bn128">
        %goldtwo = cast.tofelt %i : index, !felt.type<"goldilocks">
        %goldhalf = felt.const 9223372034707292161 : <"goldilocks">
        %d = function.call @other(%goldtwo) : (!felt.type<"goldilocks">) -> !felt.type<"goldilocks">
        constrain.eq %d, %goldhalf : !felt.type<"goldilocks">
        %aliastwo = cast.tofelt %i : index, !felt.type<"bn254">
        %aliashalf = felt.const 10944121435919637611123202872628637544274182200208017171849102093287904247809 : <"bn254">
        %e = function.call @alias(%aliastwo) : (!felt.type<"bn254">) -> !felt.type<"bn254">
        constrain.eq %e, %aliashalf : !felt.type<"bn254">
        // Undefined inverse of zero must follow normal folding, never enter the cache.
        %zeroIndex = arith.subi %i, %i : index
        %zero = cast.tofelt %zeroIndex : index, !felt.type<"bn128">
        %z1 = function.call @inverse(%zero) : (!felt.type<"bn128">) -> !felt.type<"bn128">
        %z2 = function.call @inverse(%zero) : (!felt.type<"bn128">) -> !felt.type<"bn128">
        constrain.eq %z1, %z2 : !felt.type<"bn128">
      }
      function.return
    }
  }
}

