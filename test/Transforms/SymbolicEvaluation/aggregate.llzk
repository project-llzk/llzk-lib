// RUN: llzk-opt %s --llzk-monomorphize --llzk-evaluate-constraints | FileCheck %s
module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  global.def const @matrix : !array.type<2,2 x !felt.type> = [1, 2, 3, 4]
  struct.def @Main {
    function.def @compute() -> !struct.type<@Main> {
      %s = struct.new : <@Main>
      function.return %s : !struct.type<@Main>
    }
    function.def @constrain(%s: !struct.type<@Main>) {
      %zero = arith.constant 0 : index
      %one = arith.constant 1 : index
      %two = arith.constant 2 : index
      %a = felt.const 11
      %b = felt.const 17
      %c = felt.const 23
      %d = felt.const 29
      %matrix = array.new %a, %b, %c, %d : <2,2 x !felt.type>
      %row = array.extract %matrix[%one] : <2,2 x !felt.type>
      array.write %row[%zero] = %b : <2 x !felt.type>, !felt.type
      %old = array.read %matrix[%one, %zero] : <2,2 x !felt.type>, !felt.type
      constrain.eq %old, %c : !felt.type
      %new = array.read %row[%zero] : <2 x !felt.type>, !felt.type
      constrain.eq %new, %b : !felt.type
      %global = global.read const @matrix : !array.type<2,2 x !felt.type>
      %sum:2 = scf.while (%i = %zero, %acc = %a) : (index, !felt.type) -> (index, !felt.type) {
        %cond = arith.cmpi slt, %i, %two : index
        scf.condition(%cond) %i, %acc : index, !felt.type
      } do {
      ^bb0(%i: index, %acc: !felt.type):
        %v = array.read %global[%one, %i] : <2,2 x !felt.type>, !felt.type
        %next = felt.add %acc, %v
        %j = arith.addi %i, %one : index
        scf.yield %j, %next : index, !felt.type
      }
      %expected = felt.const 18
      constrain.eq %sum#1, %expected : !felt.type
      function.return
    }
  }
}

