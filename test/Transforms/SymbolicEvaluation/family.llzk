// RUN: llzk-opt %s --llzk-monomorphize --llzk-evaluate-constraints | FileCheck %s
// Four array positions select four different Lane specializations:
// lanes[i] : Lane<2*i + 1>, for i = 0, 1, 2, 3.
// This illustrates definition discovery, not witness computation or field initialization.
#width = affine_map<(i) -> (2 * i + 1)>
module attributes {llzk.lang, llzk.main = !struct.type<@Bank>} {
  poly.template @Lane {
    poly.param @Width : index
    struct.def @Lane {
      struct.member @values : !array.type<@Width x !felt.type>
      function.def @compute() -> !struct.type<@Lane::@Lane<[@Width]>> {
        %lane = struct.new : !struct.type<@Lane::@Lane<[@Width]>>
        function.return %lane : !struct.type<@Lane::@Lane<[@Width]>>
      }
      function.def @constrain(%lane: !struct.type<@Lane::@Lane<[@Width]>>) {
        %n = poly.read_const @Width : index
        %zero = arith.constant 0 : index
        %one = arith.constant 1 : index
        %values = struct.readm %lane[@values] : !struct.type<@Lane::@Lane<[@Width]>>, !array.type<@Width x !felt.type>
        %f = felt.const 1
        scf.for %i = %zero to %n step %one {
          %v = array.read %values[%i] : !array.type<@Width x !felt.type>, !felt.type
          constrain.eq %v, %f : !felt.type
        }
        function.return
      }
    }
  }
  struct.def @Bank {
    struct.member @lanes : !array.type<4 x !struct.type<@Lane::@Lane<[#width]>>>
    function.def @compute() -> !struct.type<@Bank> {
      %bank = struct.new : !struct.type<@Bank>
      %zero = arith.constant 0 : index
      %one = arith.constant 1 : index
      %four = arith.constant 4 : index
      scf.for %i = %zero to %four step %one {
        %lane = function.call @Lane::@Lane::@compute() {(%i)} : () -> !struct.type<@Lane::@Lane<[#width]>>
      }
      function.return %bank : !struct.type<@Bank>
    }
    function.def @constrain(%bank: !struct.type<@Bank>) {
      %lanes = struct.readm %bank[@lanes] : !struct.type<@Bank>, !array.type<4 x !struct.type<@Lane::@Lane<[#width]>>>
      %zero = arith.constant 0 : index
      %one = arith.constant 1 : index
      %four = arith.constant 4 : index
      scf.for %i = %zero to %four step %one {
        %lane = array.read %lanes[%i] : !array.type<4 x !struct.type<@Lane::@Lane<[#width]>>>, !struct.type<@Lane::@Lane<[#width]>>
        function.call @Lane::@Lane::@constrain(%lane) : (!struct.type<@Lane::@Lane<[#width]>>) -> ()
      }
      function.return
    }
  }
}

