// RUN: llzk-opt -split-input-file --canonicalize -llzk-array-to-scalar %s | FileCheck --enable-var-scope %s

!F = !felt.type<"bn254">
module attributes {llzk.lang} {
  struct.def @A {
    struct.member @foo : !array.type<2 x !F>
    function.def @product(%inp : !array.type<2 x !F>)  -> !struct.type<@A> attributes {function.allow_non_native_field_ops} {
      %self = struct.new : <@A>
      %fc0 = felt.const 0 : !F
      %fc1 = felt.const 1 : !F

      %foo = array.new : !array.type<2 x !F>

      %c0 = cast.toindex %fc0 : !F
      %c1 = cast.toindex %fc1 : !F

      %x = array.read %inp[%c0] : !array.type<2 x !F>, !F
      %y = array.read %inp[%c1] : !array.type<2 x !F>, !F

      %a = felt.add %x, %y : !F, !F
      %b = felt.sub %x, %y : !F, !F

      array.write %foo[%c0] = %a : !array.type<2 x !F>, !F
      array.write %foo[%c1] = %b : !array.type<2 x !F>, !F

      struct.writem %self[@foo] = %foo : <@A>, !array.type<2 x !F>

      function.return %self : !struct.type<@A>
    }
  }
}

// CHECK-LABEL:    struct.def @A {
// CHECK-NEXT:      struct.member @foo_0 : !felt.type<"bn254">
// CHECK-NEXT:      struct.member @foo_1 : !felt.type<"bn254">
// CHECK-NEXT:      function.def @product(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !felt.type<"bn254">, %[[VAL_1:[0-9a-zA-Z_\.]+]]: !felt.type<"bn254">) -> !struct.type<@A> attributes {function.allow_constraint, function.allow_non_native_field_ops, function.allow_witness} {
// CHECK-NEXT:        %[[VAL_2:[0-9a-zA-Z_\.]+]] = struct.new : <@A>
// CHECK-NEXT:        %[[VAL_3:[0-9a-zA-Z_\.]+]] = felt.add %[[VAL_0]], %[[VAL_1]] : !felt.type<"bn254">, !felt.type<"bn254">
// CHECK-NEXT:        %[[VAL_4:[0-9a-zA-Z_\.]+]] = felt.sub %[[VAL_0]], %[[VAL_1]] : !felt.type<"bn254">, !felt.type<"bn254">
// CHECK-DAG:         struct.writem %[[VAL_2]][@foo_1] = %[[VAL_4]] : <@A>, !felt.type<"bn254">
// CHECK-DAG:         struct.writem %[[VAL_2]][@foo_0] = %[[VAL_3]] : <@A>, !felt.type<"bn254">
// CHECK-NEXT:        function.return %[[VAL_2]] : !struct.type<@A>
// CHECK-NEXT:      }
// CHECK-NEXT:    }
