// RUN: llzk-opt -split-input-file -llzk-straight-line-static-array-promotion %s | FileCheck %s

module attributes {llzk.lang} {
  function.def @many_straight_line_slots(
      %v0: index, %v1: index, %v2: index, %v3: index,
      %v4: index, %v5: index, %v6: index, %v7: index) -> index {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c3 = arith.constant 3 : index
    %c4 = arith.constant 4 : index
    %c5 = arith.constant 5 : index
    %c6 = arith.constant 6 : index
    %c7 = arith.constant 7 : index
    %array = array.new : !array.type<8 x index>
    array.write %array[%c0] = %v0 : !array.type<8 x index>, index
    array.write %array[%c1] = %v1 : !array.type<8 x index>, index
    array.write %array[%c2] = %v2 : !array.type<8 x index>, index
    array.write %array[%c3] = %v3 : !array.type<8 x index>, index
    array.write %array[%c4] = %v4 : !array.type<8 x index>, index
    array.write %array[%c5] = %v5 : !array.type<8 x index>, index
    array.write %array[%c6] = %v6 : !array.type<8 x index>, index
    array.write %array[%c7] = %v7 : !array.type<8 x index>, index
    %r0 = array.read %array[%c0] : !array.type<8 x index>, index
    %r1 = array.read %array[%c1] : !array.type<8 x index>, index
    %r2 = array.read %array[%c2] : !array.type<8 x index>, index
    %r3 = array.read %array[%c3] : !array.type<8 x index>, index
    %r4 = array.read %array[%c4] : !array.type<8 x index>, index
    %r5 = array.read %array[%c5] : !array.type<8 x index>, index
    %r6 = array.read %array[%c6] : !array.type<8 x index>, index
    %r7 = array.read %array[%c7] : !array.type<8 x index>, index
    %s0 = arith.addi %r0, %r1 : index
    %s1 = arith.addi %r2, %r3 : index
    %s2 = arith.addi %r4, %r5 : index
    %s3 = arith.addi %r6, %r7 : index
    %s4 = arith.addi %s0, %s1 : index
    %s5 = arith.addi %s2, %s3 : index
    %result = arith.addi %s4, %s5 : index
    function.return %result : index
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @many_straight_line_slots(%[[VAL_0:[0-9a-zA-Z_\.]+]]: index, %[[VAL_1:[0-9a-zA-Z_\.]+]]: index, %[[VAL_2:[0-9a-zA-Z_\.]+]]: index, %[[VAL_3:[0-9a-zA-Z_\.]+]]: index, %[[VAL_4:[0-9a-zA-Z_\.]+]]: index, %[[VAL_5:[0-9a-zA-Z_\.]+]]: index, %[[VAL_6:[0-9a-zA-Z_\.]+]]: index, %[[VAL_7:[0-9a-zA-Z_\.]+]]: index) -> index {
// CHECK-NEXT:      %[[VAL_8:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:      %[[VAL_9:[0-9a-zA-Z_\.]+]] = arith.constant 1 : index
// CHECK-NEXT:      %[[VAL_10:[0-9a-zA-Z_\.]+]] = arith.constant 2 : index
// CHECK-NEXT:      %[[VAL_11:[0-9a-zA-Z_\.]+]] = arith.constant 3 : index
// CHECK-NEXT:      %[[VAL_12:[0-9a-zA-Z_\.]+]] = arith.constant 4 : index
// CHECK-NEXT:      %[[VAL_13:[0-9a-zA-Z_\.]+]] = arith.constant 5 : index
// CHECK-NEXT:      %[[VAL_14:[0-9a-zA-Z_\.]+]] = arith.constant 6 : index
// CHECK-NEXT:      %[[VAL_15:[0-9a-zA-Z_\.]+]] = arith.constant 7 : index
// CHECK-NEXT:      %[[VAL_16:[0-9a-zA-Z_\.]+]] = arith.addi %[[VAL_0]], %[[VAL_1]] : index
// CHECK-NEXT:      %[[VAL_17:[0-9a-zA-Z_\.]+]] = arith.addi %[[VAL_2]], %[[VAL_3]] : index
// CHECK-NEXT:      %[[VAL_18:[0-9a-zA-Z_\.]+]] = arith.addi %[[VAL_4]], %[[VAL_5]] : index
// CHECK-NEXT:      %[[VAL_19:[0-9a-zA-Z_\.]+]] = arith.addi %[[VAL_6]], %[[VAL_7]] : index
// CHECK-NEXT:      %[[VAL_20:[0-9a-zA-Z_\.]+]] = arith.addi %[[VAL_16]], %[[VAL_17]] : index
// CHECK-NEXT:      %[[VAL_21:[0-9a-zA-Z_\.]+]] = arith.addi %[[VAL_18]], %[[VAL_19]] : index
// CHECK-NEXT:      %[[VAL_22:[0-9a-zA-Z_\.]+]] = arith.addi %[[VAL_20]], %[[VAL_21]] : index
// CHECK-NEXT:      function.return %[[VAL_22]] : index
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

module attributes {llzk.lang} {
  function.def @nested_execute_region(%value: index) -> index {
    %c0 = arith.constant 0 : index
    %array = array.new : !array.type<1 x index>
    %result = scf.execute_region -> index {
      array.write %array[%c0] = %value : !array.type<1 x index>, index
      %read = array.read %array[%c0] : !array.type<1 x index>, index
      scf.yield %read : index
    }
    function.return %result : index
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @nested_execute_region(%[[VAL_0:[0-9a-zA-Z_\.]+]]: index) -> index {
// CHECK-NEXT:      %[[VAL_1:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = scf.execute_region -> index {
// CHECK-NEXT:        scf.yield %[[VAL_0]] : index
// CHECK-NEXT:      }
// CHECK-NEXT:      function.return %[[VAL_2]] : index
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

module attributes {llzk.lang} {
  function.def @inside_loop_body(%upper: index, %value: index) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    scf.for %i = %c0 to %upper step %c1 {
      %array = array.new : !array.type<1 x index>
      array.write %array[%c0] = %value : !array.type<1 x index>, index
      %read = array.read %array[%c0] : !array.type<1 x index>, index
    }
    function.return
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @inside_loop_body(%[[VAL_0:[0-9a-zA-Z_\.]+]]: index, %[[VAL_1:[0-9a-zA-Z_\.]+]]: index) {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = arith.constant 1 : index
// CHECK-NEXT:      scf.for %[[VAL_4:[0-9a-zA-Z_\.]+]] = %[[VAL_2]] to %[[VAL_0]] step %[[VAL_3]] {
// CHECK-NEXT:      }
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

module attributes {llzk.lang} {
  function.def @reject_access_through_if(%condition: i1, %value: index) {
    %c0 = arith.constant 0 : index
    %array = array.new : !array.type<1 x index>
    scf.if %condition {
      array.write %array[%c0] = %value : !array.type<1 x index>, index
      %read = array.read %array[%c0] : !array.type<1 x index>, index
    }
    function.return
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @reject_access_through_if(%[[VAL_0:[0-9a-zA-Z_\.]+]]: i1, %[[VAL_1:[0-9a-zA-Z_\.]+]]: index) {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = array.new  : <1 x index>
// CHECK-NEXT:      scf.if %[[VAL_0]] {
// CHECK-NEXT:        array.write %[[VAL_3]]{{\[}}%[[VAL_2]]] = %[[VAL_1]] : <1 x index>, index
// CHECK-NEXT:        %[[VAL_4:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_3]]{{\[}}%[[VAL_2]]] : <1 x index>, index
// CHECK-NEXT:      }
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

module attributes {llzk.lang} {
  function.def private @use_index(%value: index)

  function.def @reject_execute_region_backedge(%condition: i1) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %array = array.new : !array.type<1 x index>
    scf.execute_region {
      cf.br ^loop
    ^loop:
      %read = array.read %array[%c0] : !array.type<1 x index>, index
      %next = arith.addi %read, %c1 : index
      array.write %array[%c0] = %next : !array.type<1 x index>, index
      function.call @use_index(%read) : (index) -> ()
      cf.cond_br %condition, ^loop, ^exit
    ^exit:
      scf.yield
    }
    function.return
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def private @use_index(index)
// CHECK-NEXT:    function.def @reject_execute_region_backedge(%[[VAL_0:[0-9a-zA-Z_\.]+]]: i1) {
// CHECK-NEXT:      %[[VAL_1:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = arith.constant 1 : index
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = array.new  : <1 x index>
// CHECK-NEXT:      scf.execute_region {
// CHECK-NEXT:        cf.br ^bb1
// CHECK-NEXT:      ^bb1:
// CHECK-NEXT:        %[[VAL_4:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_3]]{{\[}}%[[VAL_1]]] : <1 x index>, index
// CHECK-NEXT:        %[[VAL_5:[0-9a-zA-Z_\.]+]] = arith.addi %[[VAL_4]], %[[VAL_2]] : index
// CHECK-NEXT:        array.write %[[VAL_3]]{{\[}}%[[VAL_1]]] = %[[VAL_5]] : <1 x index>, index
// CHECK-NEXT:        function.call @use_index(%[[VAL_4]]) : (index) -> ()
// CHECK-NEXT:        cf.cond_br %[[VAL_0]], ^bb1, ^bb2
// CHECK-NEXT:      ^bb2:
// CHECK-NEXT:        scf.yield
// CHECK-NEXT:      }
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

module attributes {llzk.lang} {
  function.def @reject_access_through_loop(%upper: index, %value: index) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %array = array.new : !array.type<1 x index>
    scf.for %i = %c0 to %upper step %c1 {
      array.write %array[%c0] = %value : !array.type<1 x index>, index
      %read = array.read %array[%c0] : !array.type<1 x index>, index
    }
    function.return
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @reject_access_through_loop(%[[VAL_0:[0-9a-zA-Z_\.]+]]: index, %[[VAL_1:[0-9a-zA-Z_\.]+]]: index) {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = arith.constant 1 : index
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = array.new  : <1 x index>
