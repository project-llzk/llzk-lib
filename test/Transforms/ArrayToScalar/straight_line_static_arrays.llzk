// CHECK-NEXT:        %[[VAL_6:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_4]]{{\[}}%[[VAL_2]]] : <1 x index>, index
// CHECK-NEXT:      }
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

module attributes {llzk.lang} {
  function.def @reject_different_access_blocks(%value: index) -> index {
    %c0 = arith.constant 0 : index
    %array = array.new : !array.type<1 x index>
    scf.execute_region {
      array.write %array[%c0] = %value : !array.type<1 x index>, index
      scf.yield
    }
    %result = scf.execute_region -> index {
      %read = array.read %array[%c0] : !array.type<1 x index>, index
      scf.yield %read : index
    }
    function.return %result : index
  }
}

