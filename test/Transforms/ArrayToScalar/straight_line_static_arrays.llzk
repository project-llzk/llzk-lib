// CHECK-NEXT:    function.def @reject_different_access_blocks(%[[VAL_0:[0-9a-zA-Z_\.]+]]: index) -> index {
// CHECK-NEXT:      %[[VAL_1:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = array.new  : <1 x index>
// CHECK-NEXT:      scf.execute_region {
// CHECK-NEXT:        array.write %[[VAL_2]]{{\[}}%[[VAL_1]]] = %[[VAL_0]] : <1 x index>, index
// CHECK-NEXT:        scf.yield
// CHECK-NEXT:      }
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = scf.execute_region -> index {
