// CHECK-NEXT:        scf.yield %[[VAL_4]] : index
// CHECK-NEXT:      }
// CHECK-NEXT:      function.return %[[VAL_3]] : index
// CHECK-NEXT:    }
// CHECK-NEXT:  }
