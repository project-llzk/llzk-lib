// RUN: llzk-opt -split-input-file -llzk-array-to-scalar %s | FileCheck --enable-var-scope %s

!F = !felt.type
module attributes {llzk.lang} {
  function.def @branch_dominated_write(%arg1: !F, %arg2: !F, %cond: i1) -> !F {
    %c0 = arith.constant 0 : index
    %array = array.new : !array.type<1 x !F>
    array.write %array[%c0] = %arg1 : !array.type<1 x !F>, !F
    %result = scf.if %cond -> !F {
      %sum = felt.add %arg1, %arg2 : !F, !F
      %read = array.read %array[%c0] : !array.type<1 x !F>, !F
      %out = felt.add %sum, %read : !F, !F
      scf.yield %out : !F
    } else {
      %sum = felt.add %arg2, %arg2 : !F, !F
      %read = array.read %array[%c0] : !array.type<1 x !F>, !F
      %out = felt.add %sum, %read : !F, !F
      scf.yield %out : !F
    }
    function.return %result : !F
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @branch_dominated_write(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !felt.type, %[[VAL_1:[0-9a-zA-Z_\.]+]]: !felt.type, %[[VAL_2:[0-9a-zA-Z_\.]+]]: i1) -> !felt.type {
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = scf.if %[[VAL_2]] -> (!felt.type) {
// CHECK-NEXT:        %[[VAL_4:[0-9a-zA-Z_\.]+]] = felt.add %[[VAL_0]], %[[VAL_1]] : !felt.type, !felt.type
// CHECK-NEXT:        %[[VAL_5:[0-9a-zA-Z_\.]+]] = felt.add %[[VAL_4]], %[[VAL_0]] : !felt.type, !felt.type
// CHECK-NEXT:        scf.yield %[[VAL_5]] : !felt.type
// CHECK-NEXT:      } else {
// CHECK-NEXT:        %[[VAL_6:[0-9a-zA-Z_\.]+]] = felt.add %[[VAL_1]], %[[VAL_1]] : !felt.type, !felt.type
// CHECK-NEXT:        %[[VAL_7:[0-9a-zA-Z_\.]+]] = felt.add %[[VAL_6]], %[[VAL_0]] : !felt.type, !felt.type
// CHECK-NEXT:        scf.yield %[[VAL_7]] : !felt.type
// CHECK-NEXT:      }
// CHECK-NEXT:      function.return %[[VAL_3]] : !felt.type
// CHECK-NEXT:    }
// CHECK-NEXT:  }
// -----

!F = !felt.type
module attributes {llzk.lang} {
  function.def @do_not_forward_after_branch_write(%arg1: !F, %arg2: !F, %cond: i1) -> !F {
    %c0 = arith.constant 0 : index
    %array = array.new : !array.type<1 x !F>
    array.write %array[%c0] = %arg1 : !array.type<1 x !F>, !F
    %result = scf.if %cond -> !F {
      array.write %array[%c0] = %arg2 : !array.type<1 x !F>, !F
      %read = array.read %array[%c0] : !array.type<1 x !F>, !F
      scf.yield %read : !F
    } else {
      array.write %array[%c0] = %arg2 : !array.type<1 x !F>, !F
      %read = array.read %array[%c0] : !array.type<1 x !F>, !F
      scf.yield %read : !F
    }
    function.return %result : !F
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @do_not_forward_after_branch_write(
// CHECK-SAME:    %[[VAL_0:[0-9a-zA-Z_\.]+]]: !felt.type,
// CHECK-SAME:    %[[VAL_1:[0-9a-zA-Z_\.]+]]: !felt.type,
// CHECK-SAME:    %[[VAL_2:[0-9a-zA-Z_\.]+]]: i1) -> !felt.type {
// CHECK-NEXT:      function.return %[[VAL_1]] : !felt.type
// CHECK-NEXT:    }
// CHECK-NEXT:  }
