// RUN: llzk-opt -split-input-file -llzk-pod-to-scalar -llzk-array-to-scalar -verify-diagnostics %s | FileCheck --enable-var-scope %s

// An affine payload projection must not bypass the unsupported POD read copy.
#inner = affine_map<()[s0] -> (s0 + 1)>
!Inner = !array.type<#inner x index>
!Elem = !pod.type<[@vals: !Inner]>
!Outer = !pod.type<[@items: !array.type<2 x !Elem>]>
module attributes {llzk.lang} {
  function.def @read_unwritten_affine_leaf(%i: index, %j: index) -> index {
    %p = llzk.nondet : !Outer
    %items = pod.read %p[@items] : !Outer, !array.type<2 x !Elem>
    // expected-error@+1 {{cannot copy nested array leaf: dynamic or symbolic payload arrays cannot be copied independently}}
    %item = array.read %items[%i] : !array.type<2 x !Elem>, !Elem
    %vals = pod.read %item[@vals] : !Elem, !Inner
    %x = array.read %vals[%j] : !Inner, index
    function.return %x : index
  }
}
// -----

module attributes {llzk.lang} {
  function.def @len_empty_leaf_static_arg_after_array_to_scalar(
      %arr: !array.type<4 x !pod.type<[]>>
  ) -> index {
    %dim = arith.constant 0 : index
    %len = array.len %arr, %dim : !array.type<4 x !pod.type<[]>>
    function.return %len : index
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @len_empty_leaf_static_arg_after_array_to_scalar(%[[ARR:[0-9a-zA-Z_\.]+]]: !array.type<4 x none>) -> index {
// CHECK-NEXT:      %[[LEN:[0-9a-zA-Z_\.]+]] = arith.constant 4 : index
// CHECK-NEXT:      function.return %[[LEN]] : index
// CHECK-NEXT:    }
// CHECK-NEXT:  }
