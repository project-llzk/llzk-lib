// RUN: llzk-opt -llzk-inline-free-functions %s | FileCheck --enable-var-scope %s

// A root free function containing a normal MLIR call cannot be cloned into a
// struct method without rebasing the callee. The struct's @compute method would
// otherwise capture the root func.func @compute reference.
module attributes {llzk.lang} {
  func.func @compute(%x: !felt.type) -> !felt.type {
    return %x : !felt.type
  }

  function.def @helper(%x: !felt.type) -> !felt.type {
    %result = func.call @compute(%x) : (!felt.type) -> !felt.type
    function.return %result : !felt.type
  }

  struct.def @Main {
    struct.member @out : !felt.type {llzk.pub}

    function.def @compute(%x: !felt.type) -> !struct.type<@Main> {
      %self = struct.new : !struct.type<@Main>
      function.return %self : !struct.type<@Main>
    }

    function.def @constrain(%self: !struct.type<@Main>, %x: !felt.type) {
      %result = function.call @helper(%x) : (!felt.type) -> !felt.type
      %out = struct.readm %self[@out] : !struct.type<@Main>, !felt.type
      constrain.eq %out, %result : !felt.type, !felt.type
      function.return
    }
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    func.func @compute(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !felt.type) -> !felt.type {
// CHECK-NEXT:      return %[[VAL_0]] : !felt.type
// CHECK-NEXT:    }
// CHECK-NEXT:    function.def @helper(%[[VAL_1:[0-9a-zA-Z_\.]+]]: !felt.type) -> !felt.type {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = func.call @compute(%[[VAL_1]]) : (!felt.type) -> !felt.type
// CHECK-NEXT:      function.return %[[VAL_2]] : !felt.type
// CHECK-NEXT:    }
// CHECK-NEXT:    struct.def @Main {
// CHECK-NEXT:      struct.member @out : !felt.type {llzk.pub}
// CHECK-NEXT:      function.def @compute(%[[VAL_3:[0-9a-zA-Z_\.]+]]: !felt.type) -> !struct.type<@Main> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_4:[0-9a-zA-Z_\.]+]] = struct.new : <@Main>
// CHECK-NEXT:        function.return %[[VAL_4]] : !struct.type<@Main>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_5:[0-9a-zA-Z_\.]+]]: !struct.type<@Main>, %[[VAL_6:[0-9a-zA-Z_\.]+]]: !felt.type) attributes {function.allow_constraint} {
// CHECK-NEXT:        %[[VAL_7:[0-9a-zA-Z_\.]+]] = function.call @helper(%[[VAL_6]]) : (!felt.type) -> !felt.type
// CHECK-NEXT:        %[[VAL_8:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_5]][@out] : <@Main>, !felt.type
// CHECK-NEXT:        constrain.eq %[[VAL_8]], %[[VAL_7]] : !felt.type, !felt.type
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }
