// RUN: llzk-opt -llzk-inline-free-functions %s | FileCheck --enable-var-scope %s

// Functions in nested modules can be inlined when their symbol references can
// be resolved from the root. Functions that use symbols from the nested scope
// stay unchanged until cross-scope references can be rebased.
module attributes {llzk.lang} {
  global.def const @offset : !felt.type = 1
  function.def private @blackbox(%x: !felt.type) -> !felt.type
  func.func @compute(%x: !felt.type) -> !felt.type {
    return %x : !felt.type
  }
  func.func private @shadowed(%x: !felt.type) -> !felt.type

  // Even though @compute resolves at the root here, it would be captured by
  // Main::compute after cloning. Unsupported MLIR symbol users stay uninlined.
  function.def @root_ref_helper(%x: !felt.type) -> !felt.type {
    %result = func.call @compute(%x) : (!felt.type) -> !felt.type
    function.return %result : !felt.type
  }

  struct.def @Payload {
    function.def @product() -> !struct.type<@Payload> {
      %self = struct.new : !struct.type<@Payload>
      function.return %self : !struct.type<@Payload>
    }
  }

  poly.template @Target {
    poly.param @Q
    function.def private @sink()
  }

  module @lib {
    global.def const @offset : !felt.type = 2
    function.def private @blackbox(%x: !felt.type) -> !felt.type

    function.def @helper(%x: !felt.type) -> !felt.type {
      %offset = global.read const @offset : !felt.type
      %adjusted = felt.add %x, %offset : !felt.type, !felt.type
      %result = function.call @blackbox(%adjusted) : (!felt.type) -> !felt.type
      function.return %result : !felt.type
    }

    function.def @read_public_member(%component: !struct.type<@Main>) -> !felt.type {
      %value = struct.readm %component[@out] : !struct.type<@Main>, !felt.type
      function.return %value : !felt.type
    }
  }

  module @shadow {
    func.func private @shadowed(%x: !felt.type) -> !felt.type

    function.def @helper(%x: !felt.type) -> !felt.type {
      %result = func.call @shadowed(%x) : (!felt.type) -> !felt.type
      function.return %result : !felt.type
    }
  }

  module @types {
    struct.def @Payload {
      function.def @product() -> !struct.type<@types::@Payload> {
        %self = struct.new : !struct.type<@types::@Payload>
        function.return %self : !struct.type<@types::@Payload>
      }
    }

    // StructType names use root lookup, so this type denotes the root Payload
    // despite the nested definition with the same name.
    function.def @identity_payload(%payload: !struct.type<@Payload>) -> !struct.type<@Payload> {
      function.return %payload : !struct.type<@Payload>
    }
  }

  poly.template @Template {
    poly.param @N

    function.def @helper_with_symbol(%x: !felt.type) -> !felt.type {
      %n = poly.read_const @N : !felt.type
      %result = felt.add %x, %n : !felt.type, !felt.type
      function.return %result : !felt.type
    }

    function.def @helper_with_property_symbol() {
      function.call @Target::@sink<[@N]>() : () -> ()
      function.return
    }
  }

  struct.def @Main {
    struct.member @out : !felt.type {llzk.pub}
    function.def @compute(%x: !felt.type, %payload: !struct.type<@Payload>) -> !struct.type<@Main> {
      %self = struct.new : !struct.type<@Main>
      %same_payload = function.call @types::@identity_payload(%payload) : (!struct.type<@Payload>) -> !struct.type<@Payload>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>, %x: !felt.type, %payload: !struct.type<@Payload>) {
      %r = function.call @lib::@helper(%x) : (!felt.type) -> !felt.type
      %nested = function.call @Template::@helper_with_symbol<[1]>(%x) : (!felt.type) -> !felt.type
      function.call @Template::@helper_with_property_symbol<[1]>() : () -> ()
      %shadowed = function.call @shadow::@helper(%x) : (!felt.type) -> !felt.type
      %root_ref = function.call @root_ref_helper(%x) : (!felt.type) -> !felt.type
      %out = struct.readm %self[@out] : !struct.type<@Main>, !felt.type
      %member = function.call @lib::@read_public_member(%self) : (!struct.type<@Main>) -> !felt.type
      constrain.eq %out, %r : !felt.type, !felt.type
      constrain.eq %r, %nested : !felt.type, !felt.type
      constrain.eq %nested, %shadowed : !felt.type, !felt.type
      constrain.eq %shadowed, %root_ref : !felt.type, !felt.type
      constrain.eq %member, %out : !felt.type, !felt.type
      function.return
    }
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    global.def const @offset : !felt.type =  1
// CHECK-NEXT:    function.def private @blackbox(!felt.type) -> !felt.type
// CHECK-NEXT:    func.func @compute(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !felt.type) -> !felt.type {
// CHECK-NEXT:      return %[[VAL_0]] : !felt.type
// CHECK-NEXT:    }
// CHECK-NEXT:    func.func private @shadowed(!felt.type) -> !felt.type
// CHECK-NEXT:    function.def @root_ref_helper(%[[VAL_1:[0-9a-zA-Z_\.]+]]: !felt.type) -> !felt.type {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = func.call @compute(%[[VAL_1]]) : (!felt.type) -> !felt.type
// CHECK-NEXT:      function.return %[[VAL_2]] : !felt.type
// CHECK-NEXT:    }
// CHECK-NEXT:    struct.def @Payload {
// CHECK-NEXT:      function.def @product() -> !struct.type<@Payload> attributes {function.allow_constraint, function.allow_witness} {
// CHECK-NEXT:        %[[VAL_3:[0-9a-zA-Z_\.]+]] = struct.new : <@Payload>
// CHECK-NEXT:        function.return %[[VAL_3]] : !struct.type<@Payload>
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    poly.template @Target {
// CHECK-NEXT:      poly.param @Q
// CHECK-NEXT:      function.def private @sink()
// CHECK-NEXT:    }
// CHECK-NEXT:    module @lib {
// CHECK-NEXT:      global.def const @offset : !felt.type =  2
// CHECK-NEXT:      function.def private @blackbox(!felt.type) -> !felt.type
// CHECK-NEXT:      function.def @helper(%[[VAL_4:[0-9a-zA-Z_\.]+]]: !felt.type) -> !felt.type {
// CHECK-NEXT:        %[[VAL_5:[0-9a-zA-Z_\.]+]] = global.read const @offset : !felt.type
// CHECK-NEXT:        %[[VAL_6:[0-9a-zA-Z_\.]+]] = felt.add %[[VAL_4]], %[[VAL_5]] : !felt.type, !felt.type
// CHECK-NEXT:        %[[VAL_7:[0-9a-zA-Z_\.]+]] = function.call @blackbox(%[[VAL_6]]) : (!felt.type) -> !felt.type
// CHECK-NEXT:        function.return %[[VAL_7]] : !felt.type
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @read_public_member(%[[VAL_8:[0-9a-zA-Z_\.]+]]: !struct.type<@Main>) -> !felt.type {
// CHECK-NEXT:        %[[VAL_9:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_8]][@out] : <@Main>, !felt.type
// CHECK-NEXT:        function.return %[[VAL_9]] : !felt.type
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    module @shadow {
// CHECK-NEXT:      func.func private @shadowed(!felt.type) -> !felt.type
// CHECK-NEXT:      function.def @helper(%[[VAL_10:[0-9a-zA-Z_\.]+]]: !felt.type) -> !felt.type {
// CHECK-NEXT:        %[[VAL_11:[0-9a-zA-Z_\.]+]] = func.call @shadowed(%[[VAL_10]]) : (!felt.type) -> !felt.type
// CHECK-NEXT:        function.return %[[VAL_11]] : !felt.type
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    module @types {
// CHECK-NEXT:      struct.def @Payload {
// CHECK-NEXT:        function.def @product() -> !struct.type<@types::@Payload> attributes {function.allow_constraint, function.allow_witness} {
// CHECK-NEXT:          %[[VAL_12:[0-9a-zA-Z_\.]+]] = struct.new : <@types::@Payload>
// CHECK-NEXT:          function.return %[[VAL_12]] : !struct.type<@types::@Payload>
// CHECK-NEXT:        }
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @identity_payload(%[[VAL_13:[0-9a-zA-Z_\.]+]]: !struct.type<@Payload>) -> !struct.type<@Payload> {
// CHECK-NEXT:        function.return %[[VAL_13]] : !struct.type<@Payload>
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    poly.template @Template {
// CHECK-NEXT:      poly.param @N
// CHECK-NEXT:      function.def @helper_with_symbol(%[[VAL_14:[0-9a-zA-Z_\.]+]]: !felt.type) -> !felt.type {
// CHECK-NEXT:        %[[VAL_15:[0-9a-zA-Z_\.]+]] = poly.read_const @N : !felt.type
// CHECK-NEXT:        %[[VAL_16:[0-9a-zA-Z_\.]+]] = felt.add %[[VAL_14]], %[[VAL_15]] : !felt.type, !felt.type
// CHECK-NEXT:        function.return %[[VAL_16]] : !felt.type
