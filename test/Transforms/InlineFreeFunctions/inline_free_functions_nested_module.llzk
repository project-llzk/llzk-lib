// CHECK-NEXT:      function.def @constrain(%[[VAL_20:[0-9a-zA-Z_\.]+]]: !struct.type<@Main>, %[[VAL_21:[0-9a-zA-Z_\.]+]]: !felt.type, %[[VAL_22:[0-9a-zA-Z_\.]+]]: !struct.type<@Payload>) attributes {function.allow_constraint} {
// CHECK-NEXT:        %[[VAL_23:[0-9a-zA-Z_\.]+]] = global.read const @offset : !felt.type
// CHECK-NEXT:        %[[VAL_24:[0-9a-zA-Z_\.]+]] = felt.add %[[VAL_21]], %[[VAL_23]] : !felt.type, !felt.type
// CHECK-NEXT:        %[[VAL_25:[0-9a-zA-Z_\.]+]] = function.call @blackbox(%[[VAL_24]]) : (!felt.type) -> !felt.type
// CHECK-NEXT:        %[[VAL_26:[0-9a-zA-Z_\.]+]] = function.call @Template::@helper_with_symbol<[1]>(%[[VAL_21]]) : (!felt.type) -> !felt.type
// CHECK-NEXT:        function.call @Template::@helper_with_property_symbol<[1]>() : () -> ()
// CHECK-NEXT:        %[[VAL_27:[0-9a-zA-Z_\.]+]] = function.call @shadow::@helper(%[[VAL_21]]) : (!felt.type) -> !felt.type
// CHECK-NEXT:        %[[VAL_28:[0-9a-zA-Z_\.]+]] = function.call @root_ref_helper(%[[VAL_21]]) : (!felt.type) -> !felt.type
// CHECK-NEXT:        %[[VAL_29:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_20]][@out] : <@Main>, !felt.type
// CHECK-NEXT:        %[[VAL_30:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_20]][@out] : <@Main>, !felt.type
// CHECK-NEXT:        constrain.eq %[[VAL_29]], %[[VAL_25]] : !felt.type, !felt.type
// CHECK-NEXT:        constrain.eq %[[VAL_25]], %[[VAL_26]] : !felt.type, !felt.type
// CHECK-NEXT:        constrain.eq %[[VAL_26]], %[[VAL_27]] : !felt.type, !felt.type
// CHECK-NEXT:        constrain.eq %[[VAL_27]], %[[VAL_28]] : !felt.type, !felt.type
// CHECK-NEXT:        constrain.eq %[[VAL_30]], %[[VAL_29]] : !felt.type, !felt.type
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }
