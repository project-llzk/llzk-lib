// RUN: llzk-opt --llzk-compute-constrain-to-product="root-struct=A" --llzk-fuse-product-control-flow %s | FileCheck --enable-var-scope %s

module attributes {llzk.lang = "llzk"} {
    poly.template @TA {
      poly.param @N : index

      struct.def @A {
          struct.member @arr : !array.type<@N x !felt.type>

          function.def @compute(%as: !array.type<@N x !felt.type>) -> !struct.type<@TA::@A<[@N]>> {
              %self = struct.new : <@TA::@A<[@N]>>

              %N = poly.read_const @N : index
              %c0 = arith.constant 0 : index
              %c1 = arith.constant 1 : index

              %arr = array.new : !array.type<@N x !felt.type>

              scf.for %i = %c0 to %N step %c1 {
                  %sum0 = felt.const 0
                  %sum = scf.for %j = %i to %N step %c1 iter_args(%iter_sum = %sum0) -> !felt.type {
                      %a_j = array.read %as[%j] : !array.type<@N x !felt.type>, !felt.type
                      %0 = felt.add %iter_sum, %a_j
                      scf.yield %0 : !felt.type
                  }
                  array.write %arr[%i] = %sum : !array.type<@N x !felt.type>, !felt.type
                  scf.yield
              }

              struct.writem %self[@arr] = %arr : !struct.type<@TA::@A<[@N]>>, !array.type<@N x !felt.type>
              function.return %self : !struct.type<@TA::@A<[@N]>>
          }
          function.def @constrain(%self : !struct.type<@TA::@A<[@N]>>, %as: !array.type<@N x !felt.type>) {
              %N = poly.read_const @N : index
              %c0 = arith.constant 0 : index
              %c1 = arith.constant 1 : index

              %arr = struct.readm %self[@arr] : !struct.type<@TA::@A<[@N]>>, !array.type<@N x !felt.type>

              scf.for %i = %c0 to %N step %c1 {
                  %j = arith.addi %i, %c1 : index

                  %arr_i = array.read %arr[%i] : !array.type<@N x !felt.type>, !felt.type
                  %arr_j = array.read %arr[%j] : !array.type<@N x !felt.type>, !felt.type
                  %a = array.read %as[%i] : !array.type<@N x !felt.type>, !felt.type
                  %diff = felt.sub %arr_j, %arr_i
                  constrain.eq %a, %diff : !felt.type
                  scf.yield
              }

              function.return
          }
      }
    }
}

// The constrain-side struct/array reads between the loops are not pure, so the source loops
// must remain separate even though their induction controls match.
// CHECK-LABEL: module attributes {llzk.lang = "llzk"} {
// CHECK-NEXT:    poly.template @TA {
// CHECK-NEXT:      poly.param @N : index
// CHECK-NEXT:      struct.def @A {
// CHECK-NEXT:        struct.member @arr : !array.type<@N x !felt.type>
// CHECK-NEXT:        function.def @product(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !array.type<@N x !felt.type>) -> !struct.type<@TA::@A<[@N]>> attributes {function.allow_constraint, function.allow_witness, llzk.derived} {
// CHECK-NEXT:          %[[VAL_1:[0-9a-zA-Z_\.]+]] = struct.new : <@TA::@A<[@N]>> {product_source = "compute"}
// CHECK-NEXT:          %[[VAL_2:[0-9a-zA-Z_\.]+]] = poly.read_const @N : index {product_source = "compute"}
// CHECK-NEXT:          %[[VAL_3:[0-9a-zA-Z_\.]+]] = arith.constant {product_source = "compute"} 0 : index
// CHECK-NEXT:          %[[VAL_4:[0-9a-zA-Z_\.]+]] = arith.constant {product_source = "compute"} 1 : index
// CHECK-NEXT:          %[[VAL_5:[0-9a-zA-Z_\.]+]] = array.new  : <@N x !felt.type>  {product_source = "compute"}
// CHECK-NEXT:          scf.for %[[VAL_6:[0-9a-zA-Z_\.]+]] = %[[VAL_3]] to %[[VAL_2]] step %[[VAL_4]] {
// CHECK-NEXT:            %[[VAL_7:[0-9a-zA-Z_\.]+]] = felt.const  0 {product_source = "compute"}
// CHECK-NEXT:            %[[VAL_8:[0-9a-zA-Z_\.]+]] = scf.for %[[VAL_9:[0-9a-zA-Z_\.]+]] = %[[VAL_6]] to %[[VAL_2]] step %[[VAL_4]] iter_args(%[[VAL_10:[0-9a-zA-Z_\.]+]] = %[[VAL_7]]) -> (!felt.type) {
// CHECK-NEXT:              %[[VAL_11:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_0]]{{\[}}%[[VAL_9]]] : <@N x !felt.type>, !felt.type {product_source = "compute"}
// CHECK-NEXT:              %[[VAL_12:[0-9a-zA-Z_\.]+]] = felt.add %[[VAL_10]], %[[VAL_11]] : !felt.type, !felt.type {product_source = "compute"}
// CHECK-NEXT:              scf.yield {product_source = "compute"} %[[VAL_12]] : !felt.type
// CHECK-NEXT:            } {product_source = "compute"}
// CHECK-NEXT:            array.write %[[VAL_5]]{{\[}}%[[VAL_6]]] = %[[VAL_8]] : <@N x !felt.type>, !felt.type {product_source = "compute"}
// CHECK-NEXT:          } {product_source = "compute"}
// CHECK-NEXT:          struct.writem %[[VAL_1]][@arr] = %[[VAL_5]] : <@TA::@A<[@N]>>, !array.type<@N x !felt.type> {product_source = "compute"}
// CHECK-NEXT:          %[[VAL_13:[0-9a-zA-Z_\.]+]] = poly.read_const @N : index {product_source = "constrain"}
// CHECK-NEXT:          %[[VAL_14:[0-9a-zA-Z_\.]+]] = arith.constant {product_source = "constrain"} 0 : index
// CHECK-NEXT:          %[[VAL_15:[0-9a-zA-Z_\.]+]] = arith.constant {product_source = "constrain"} 1 : index
// CHECK-NEXT:          %[[VAL_16:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_1]][@arr] : <@TA::@A<[@N]>>, !array.type<@N x !felt.type> {product_source = "constrain"}
// CHECK-NEXT:          scf.for %[[VAL_17:[0-9a-zA-Z_\.]+]] = %[[VAL_14]] to %[[VAL_13]] step %[[VAL_15]] {
// CHECK-NEXT:            %[[VAL_18:[0-9a-zA-Z_\.]+]] = arith.addi %[[VAL_17]], %[[VAL_15]] {product_source = "constrain"} : index
// CHECK-NEXT:            %[[VAL_19:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_16]]{{\[}}%[[VAL_17]]] : <@N x !felt.type>, !felt.type {product_source = "constrain"}
// CHECK-NEXT:            %[[VAL_20:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_16]]{{\[}}%[[VAL_18]]] : <@N x !felt.type>, !felt.type {product_source = "constrain"}
// CHECK-NEXT:            %[[VAL_21:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_0]]{{\[}}%[[VAL_17]]] : <@N x !felt.type>, !felt.type {product_source = "constrain"}
// CHECK-NEXT:            %[[VAL_22:[0-9a-zA-Z_\.]+]] = felt.sub %[[VAL_20]], %[[VAL_19]] : !felt.type, !felt.type {product_source = "constrain"}
// CHECK-NEXT:            constrain.eq %[[VAL_21]], %[[VAL_22]] : !felt.type, !felt.type {product_source = "constrain"}
// CHECK-NEXT:          } {product_source = "constrain"}
// CHECK-NEXT:          function.return %[[VAL_1]] : !struct.type<@TA::@A<[@N]>>
// CHECK-NEXT:        }
// CHECK-NEXT:        function.def @compute(%[[VAL_23:[0-9a-zA-Z_\.]+]]: !array.type<@N x !felt.type>) -> !struct.type<@TA::@A<[@N]>> attributes {function.allow_witness, product_source = "compute"} {
// CHECK-NEXT:          %[[VAL_24:[0-9a-zA-Z_\.]+]] = struct.new : <@TA::@A<[@N]>> {product_source = "compute"}
// CHECK-NEXT:          %[[VAL_25:[0-9a-zA-Z_\.]+]] = poly.read_const @N : index {product_source = "compute"}
// CHECK-NEXT:          %[[VAL_26:[0-9a-zA-Z_\.]+]] = arith.constant {product_source = "compute"} 0 : index
// CHECK-NEXT:          %[[VAL_27:[0-9a-zA-Z_\.]+]] = arith.constant {product_source = "compute"} 1 : index
// CHECK-NEXT:          %[[VAL_28:[0-9a-zA-Z_\.]+]] = array.new  : <@N x !felt.type>  {product_source = "compute"}
// CHECK-NEXT:          scf.for %[[VAL_29:[0-9a-zA-Z_\.]+]] = %[[VAL_26]] to %[[VAL_25]] step %[[VAL_27]] {
// CHECK-NEXT:            %[[VAL_30:[0-9a-zA-Z_\.]+]] = felt.const  0 {product_source = "compute"}
// CHECK-NEXT:            %[[VAL_31:[0-9a-zA-Z_\.]+]] = scf.for %[[VAL_32:[0-9a-zA-Z_\.]+]] = %[[VAL_29]] to %[[VAL_25]] step %[[VAL_27]] iter_args(%[[VAL_33:[0-9a-zA-Z_\.]+]] = %[[VAL_30]]) -> (!felt.type) {
// CHECK-NEXT:              %[[VAL_34:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_23]]{{\[}}%[[VAL_32]]] : <@N x !felt.type>, !felt.type {product_source = "compute"}
// CHECK-NEXT:              %[[VAL_35:[0-9a-zA-Z_\.]+]] = felt.add %[[VAL_33]], %[[VAL_34]] : !felt.type, !felt.type {product_source = "compute"}
// CHECK-NEXT:              scf.yield {product_source = "compute"} %[[VAL_35]] : !felt.type
// CHECK-NEXT:            } {product_source = "compute"}
// CHECK-NEXT:            array.write %[[VAL_28]]{{\[}}%[[VAL_29]]] = %[[VAL_31]] : <@N x !felt.type>, !felt.type {product_source = "compute"}
// CHECK-NEXT:          } {product_source = "compute"}
// CHECK-NEXT:          struct.writem %[[VAL_24]][@arr] = %[[VAL_28]] : <@TA::@A<[@N]>>, !array.type<@N x !felt.type> {product_source = "compute"}
// CHECK-NEXT:          function.return {product_source = "compute"} %[[VAL_24]] : !struct.type<@TA::@A<[@N]>>
// CHECK-NEXT:        }
// CHECK-NEXT:        function.def @constrain(%[[VAL_36:[0-9a-zA-Z_\.]+]]: !struct.type<@TA::@A<[@N]>>, %[[VAL_37:[0-9a-zA-Z_\.]+]]: !array.type<@N x !felt.type>) attributes {function.allow_constraint, product_source = "constrain"} {
// CHECK-NEXT:          %[[VAL_38:[0-9a-zA-Z_\.]+]] = poly.read_const @N : index {product_source = "constrain"}
// CHECK-NEXT:          %[[VAL_39:[0-9a-zA-Z_\.]+]] = arith.constant {product_source = "constrain"} 0 : index
// CHECK-NEXT:          %[[VAL_40:[0-9a-zA-Z_\.]+]] = arith.constant {product_source = "constrain"} 1 : index
// CHECK-NEXT:          %[[VAL_41:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_36]][@arr] : <@TA::@A<[@N]>>, !array.type<@N x !felt.type> {product_source = "constrain"}
// CHECK-NEXT:          scf.for %[[VAL_42:[0-9a-zA-Z_\.]+]] = %[[VAL_39]] to %[[VAL_38]] step %[[VAL_40]] {
// CHECK-NEXT:            %[[VAL_43:[0-9a-zA-Z_\.]+]] = arith.addi %[[VAL_42]], %[[VAL_40]] {product_source = "constrain"} : index
// CHECK-NEXT:            %[[VAL_44:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_41]]{{\[}}%[[VAL_42]]] : <@N x !felt.type>, !felt.type {product_source = "constrain"}
// CHECK-NEXT:            %[[VAL_45:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_41]]{{\[}}%[[VAL_43]]] : <@N x !felt.type>, !felt.type {product_source = "constrain"}
// CHECK-NEXT:            %[[VAL_46:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_37]]{{\[}}%[[VAL_42]]] : <@N x !felt.type>, !felt.type {product_source = "constrain"}
// CHECK-NEXT:            %[[VAL_47:[0-9a-zA-Z_\.]+]] = felt.sub %[[VAL_45]], %[[VAL_44]] : !felt.type, !felt.type {product_source = "constrain"}
// CHECK-NEXT:            constrain.eq %[[VAL_46]], %[[VAL_47]] : !felt.type, !felt.type {product_source = "constrain"}
// CHECK-NEXT:          } {product_source = "constrain"}
// CHECK-NEXT:          function.return {product_source = "constrain"}
// CHECK-NEXT:        }
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }
