// The outer loops fuse successfully. Their nested scf.if operations remain separate because the
// member read does not match the member written by the compute branch.
module attributes {llzk.lang = "llzk"} {
  struct.def @A {
    struct.member @foo : !felt.type
    struct.member @bar : !felt.type

    function.def @compute(%b: i1) -> !struct.type<@A> {
      %self = struct.new : <@A>
      %c0 = arith.constant 0 : index
      %c2 = arith.constant 2 : index
      %c1 = arith.constant 1 : index

      scf.for %i = %c0 to %c2 step %c1 {
        %0 = scf.if %b -> !felt.type {
          %a = felt.const 0
          scf.yield %a : !felt.type
        } else {
          %a = felt.const 1
          scf.yield %a : !felt.type
        }

        struct.writem %self[@foo] = %0 : <@A>, !felt.type
      }

      function.return %self : !struct.type<@A>
    }

    function.def @constrain(%self: !struct.type<@A>, %b: i1) {
      %c0 = arith.constant 0 : index
      %c2 = arith.constant 2 : index
      %c1 = arith.constant 1 : index

      scf.for %i = %c0 to %c2 step %c1 {
        %foo = struct.readm %self[@bar] : <@A>, !felt.type
        scf.if %b {
          %val = felt.const 0
          constrain.eq %foo, %val : !felt.type
        } else {
          %val = felt.const 1
          constrain.eq %foo, %val : !felt.type
        }
      }

      function.return
    }
  }
}

