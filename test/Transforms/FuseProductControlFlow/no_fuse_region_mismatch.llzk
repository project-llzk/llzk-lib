// CHECK-NEXT:              %[[VAL_49:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_43]]{{\[}}%[[VAL_47]]] : <@N x !felt.type>, !felt.type {product_source = "constrain"}
// CHECK-NEXT:              constrain.eq %[[VAL_48]], %[[VAL_49]] : !felt.type, !felt.type {product_source = "constrain"}
// CHECK-NEXT:            } {product_source = "constrain"}
// CHECK-NEXT:            scf.for %[[VAL_50:[0-9a-zA-Z_\.]+]] = %[[VAL_41]] to %[[VAL_40]] step %[[VAL_39]] {
// CHECK-NEXT:              %[[VAL_51:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_43]]{{\[}}%[[VAL_50]]] : <@N x !felt.type>, !felt.type {product_source = "constrain"}
// CHECK-NEXT:              constrain.eq %[[VAL_51]], %[[VAL_42]] : !felt.type, !felt.type {product_source = "constrain"}
