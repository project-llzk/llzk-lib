// A surviving constrain-if user prevents sinking the result-producing compute if. Conditional
// fusion remains legal, so the loops stay separate and the result is defined before its use.
module attributes {llzk.lang = "llzk"} {
  struct.def @F {
    struct.member @foo : !felt.type

    function.def @product(%condition: i1, %value: !felt.type) -> !struct.type<@F> attributes {function.allow_constraint, function.allow_witness} {
      %self = struct.new : <@F>
      %c0 = arith.constant 0 : index
      %c2 = arith.constant 2 : index
      %c1 = arith.constant 1 : index

      scf.for %i = %c0 to %c2 step %c1 {
        %loop_value = felt.const 10
      } {product_source = "compute"}

      %computed = scf.if %condition -> !felt.type {
        %then_value = felt.const 20
        scf.yield %then_value : !felt.type
      } else {
        %else_value = felt.const 30
        scf.yield %else_value : !felt.type
      } {product_source = "compute"}

      scf.if %condition {
        constrain.eq %computed, %value : !felt.type
      } else {
        constrain.eq %computed, %value : !felt.type
      } {product_source = "constrain"}

      scf.for %i = %c0 to %c2 step %c1 {
        constrain.eq %value, %value : !felt.type
      } {product_source = "constrain"}

      function.return %self : !struct.type<@F>
    }
  }
}
