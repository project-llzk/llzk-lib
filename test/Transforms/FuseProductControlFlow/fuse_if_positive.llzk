module attributes {llzk.lang = "llzk"} {
  struct.def @A {
    struct.member @foo : !felt.type

    function.def @product(%b: i1) -> !struct.type<@A> {
      %self = struct.new : <@A>
      %zero = arith.constant 0 : index
      %one = arith.constant 1 : index

      %computed = scf.if %b -> !felt.type {
        %zero_felt = felt.const 0
        scf.yield %zero_felt : !felt.type
      } else {
        %one_felt = felt.const 1
        scf.yield %one_felt : !felt.type
      } {product_source = "compute"}

      struct.writem %self[@foo] = %computed : <@A>, !felt.type

      // scf.while is unsupported structured control flow and must block movement.
      scf.if %b {
        %then_result = scf.while (%i = %zero) : (index) -> index {
          %condition = arith.cmpi slt, %i, %one : index
          scf.condition(%condition) %i : index
        } do {
        ^bb0(%i_next: index):
          scf.yield %i_next : index
        }
      } else {
        %else_result = scf.while (%i = %zero) : (index) -> index {
          %condition = arith.cmpi slt, %i, %one : index
          scf.condition(%condition) %i : index
        } do {
        ^bb0(%i_next: index):
          scf.yield %i_next : index
        }
      } {product_source = "constrain"}

      function.return %self : !struct.type<@A>
    }
  }
}
