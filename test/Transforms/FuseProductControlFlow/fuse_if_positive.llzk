// -----

// Loop fusion has priority when the source-local orders of a loop and conditional cross.
// The conditionals remain separate because fusing both pairs would require opposite orders.
module attributes {llzk.lang = "llzk"} {
  struct.def @E {
    struct.member @foo : !felt.type

    function.def @product(%condition: i1, %value: !felt.type) -> !struct.type<@E> attributes {function.allow_constraint, function.allow_witness} {
      %self = struct.new : <@E>
      %c0 = arith.constant 0 : index
      %c2 = arith.constant 2 : index
      %c1 = arith.constant 1 : index

      scf.for %i = %c0 to %c2 step %c1 {
        %computed = felt.const 10
      } {product_source = "compute"}

      scf.if %condition {
        %computed = felt.const 20
      } else {
        %computed = felt.const 30
      } {product_source = "compute"}

      scf.if %condition {
        constrain.eq %value, %value : !felt.type
      } else {
        constrain.eq %value, %value : !felt.type
      } {product_source = "constrain"}

      scf.for %i = %c0 to %c2 step %c1 {
        constrain.eq %value, %value : !felt.type
      } {product_source = "constrain"}

      function.return %self : !struct.type<@E>
    }
  }
}
