// RUN: llzk-opt -split-input-file --llzk-while-to-for --canonicalize %s | FileCheck --enable-var-scope %s

!F = !felt.type
module attributes {llzk.lang} {
  struct.def @A {
    function.def @product(%lo: !F, %hi: !F, %step: !F) -> !struct.type<@A> attributes {function.allow_non_native_field_ops} {
      %self = struct.new : <@A>
      %array = array.new : !array.type<10 x !F>
      scf.while (%i = %lo) : (!F) -> !F {
        %cond = bool.cmp lt(%i, %hi)
        scf.condition(%cond) %i : !F
      } do {
      ^bb0(%i: !F):
        %i_index = cast.toindex %i
        array.write %array[%i_index] = %i : !array.type<10 x !F>, !F
        %next = felt.add %i, %step
        scf.yield %next : !F
      } attributes {llzk.loopbounds = #llzk.loopbounds<0 to 10 step 1>}
      function.return %self : !struct.type<@A>
    }
  }
}
// CHECK-LABEL: function.def @product(%{{.*}}: !felt.type, %{{.*}}: !felt.type, %{{.*}}: !felt.type)
// CHECK-DAG:     %[[STEP_IDX:[0-9a-zA-Z_\.]+]] = felt.const 1
// CHECK-DAG:     %[[UB_IDX:[0-9a-zA-Z_\.]+]] = felt.const 10
// CHECK-DAG:     %[[LB_IDX:[0-9a-zA-Z_\.]+]] = felt.const 0
// CHECK:         %[[ARRAY:[0-9a-zA-Z_\.]+]] = array.new
// CHECK-DAG:     %[[LB_IDX_C:[0-9a-zA-Z_\.]+]] = cast.toindex %[[LB_IDX]] : !felt.type
// CHECK-DAG:     %[[UB_IDX_C:[0-9a-zA-Z_\.]+]] = cast.toindex %[[UB_IDX]] : !felt.type
// CHECK-DAG:     %[[STEP_IDX_C:[0-9a-zA-Z_\.]+]] = cast.toindex %[[STEP_IDX]] : !felt.type
// CHECK-NOT:     scf.while
// CHECK:         scf.for %[[IV:[0-9a-zA-Z_\.]+]] = %[[LB_IDX_C]] to %[[UB_IDX_C]] step %[[STEP_IDX_C]] {
// CHECK-NEXT:      %[[IV_FELT:[0-9a-zA-Z_\.]+]] = cast.tofelt %[[IV]] : index, !felt.type
// CHECK-NEXT:      %[[WRITE_IDX:[0-9a-zA-Z_\.]+]] = cast.toindex %[[IV_FELT]] : !felt.type
// CHECK-NEXT:      array.write %[[ARRAY]][%[[WRITE_IDX]]] = %[[IV_FELT]]
// CHECK-NEXT:    }
// CHECK-NOT:     scf.while
// -----

// Same as above but using a specified felt type "babybear"
!F = !felt.type<"babybear">
module attributes {llzk.lang} {
  struct.def @A {
    function.def @product(%lo: !F, %hi: !F, %step: !F) -> !struct.type<@A> attributes {function.allow_non_native_field_ops} {
      %self = struct.new : <@A>
      %array = array.new : !array.type<10 x !F>
      scf.while (%i = %lo) : (!F) -> !F {
        %cond = bool.cmp lt(%i, %hi) : !F, !F
        scf.condition(%cond) %i : !F
      } do {
      ^bb0(%i: !F):
        %i_index = cast.toindex %i : !F
        array.write %array[%i_index] = %i : !array.type<10 x !F>, !F
        %next = felt.add %i, %step : !F, !F
        scf.yield %next : !F
      } attributes {llzk.loopbounds = #llzk.loopbounds<0 to 10 step 1>}
      function.return %self : !struct.type<@A>
    }
  }
}
// CHECK-LABEL: function.def @product(%{{.*}}: !felt.type<"babybear">, %{{.*}}: !felt.type<"babybear">, %{{.*}}: !felt.type<"babybear">)
// CHECK-DAG:     %[[STEP_IDX:[0-9a-zA-Z_\.]+]] = arith.constant 1 : index
// CHECK-DAG:     %[[UB_IDX:[0-9a-zA-Z_\.]+]] = arith.constant 10 : index
// CHECK-DAG:     %[[LB_IDX:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK:         %[[ARRAY:[0-9a-zA-Z_\.]+]] = array.new
// CHECK-NOT:     scf.while
// CHECK:         scf.for %[[IV:[0-9a-zA-Z_\.]+]] = %[[LB_IDX]] to %[[UB_IDX]] step %[[STEP_IDX]] {
// CHECK-NEXT:      %[[IV_FELT:[0-9a-zA-Z_\.]+]] = cast.tofelt %[[IV]] : index, !felt.type<"babybear">
// CHECK-NEXT:      %[[WRITE_IDX:[0-9a-zA-Z_\.]+]] = cast.toindex %[[IV_FELT]] : !felt.type<"babybear">
// CHECK-NEXT:      array.write %[[ARRAY]][%[[WRITE_IDX]]] = %[[IV_FELT]] : <10 x !felt.type<"babybear">>, !felt.type<"babybear">
// CHECK-NEXT:    }
// CHECK-NOT:     scf.while
