// FLAT-NEXT:        %[[VAL_2:[0-9a-zA-Z_\.]+]] = felt.const  1 : <"bn128">
// FLAT-NEXT:        constrain.eq %[[VAL_2]], %[[VAL_2]] : !felt.type<"bn128">, !felt.type<"bn128">
// FLAT-NEXT:        constrain.eq %[[VAL_1]], %[[VAL_2]] : !felt.type<"bn128">, !felt.type<"bn128">
// FLAT-NEXT:        function.return
// FLAT-NEXT:      }

// -----

// Remap carried values on both sides of the IV, including uses nested in the condition region.
!F = !felt.type<"bn128">
module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  struct.def @Main {
    function.def @compute() -> !struct.type<@Main> {
      %self = struct.new : <@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>) attributes {function.allow_non_native_field_ops} {
      %lo = felt.const 1 : <"bn128">
      %hi = felt.const 6 : <"bn128">
      %step = felt.const 2 : <"bn128">
      %zero = felt.const 0 : <"bn128">
      %c0 = arith.constant 0 : index
      %c1 = arith.constant 1 : index
      %total, %end, %count = scf.while (%sum = %zero, %iv = %lo, %n = %c0) : (!F, !F, index) -> (!F, !F, index) {
        %value = felt.add %sum, %iv : !F, !F
        %hasIterations = arith.cmpi ugt, %n, %c0 : index
        scf.if %hasIterations {
          constrain.eq %value, %sum : !F, !F
        }
        %cond = bool.cmp lt(%iv, %hi) : !F, !F
        scf.condition(%cond) %sum, %iv, %n : !F, !F, index
      } do {
      ^bb0(%sum: !F, %iv: !F, %n: index):
        %nextSum = felt.add %sum, %iv : !F, !F
        %next = felt.add %iv, %step : !F, !F
        %nextN = arith.addi %n, %c1 : index
        scf.yield %nextSum, %next, %nextN : !F, !F, index
      } attributes {llzk.loopbounds = #llzk.loopbounds<1 to 6 step 2>}
      %countFelt = cast.tofelt %count : index, !F
      constrain.eq %total, %countFelt : !F, !F
      function.return
    }
  }
}

