// RUN: llzk-opt -split-input-file --llzk-while-to-for %s | FileCheck --enable-var-scope %s
// RUN: llzk-opt -split-input-file --llzk-flatten-constraints --canonicalize %s | FileCheck --enable-var-scope --check-prefix=FLAT %s
// RUN: llzk-opt -split-input-file --llzk-while-to-for --llzk-flatten-constraints --canonicalize %s | FileCheck --enable-var-scope --check-prefix=FLAT %s

// An accurate annotation must preserve the failing final constraint 2 == 1.
!F = !felt.type<"bn128">
module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  struct.def @Main {
    function.def @compute() -> !struct.type<@Main> {
      %self = struct.new : <@Main>
      function.return %self : !struct.type<@Main>
    }
    function.def @constrain(%self: !struct.type<@Main>) attributes {function.allow_non_native_field_ops} {
      %lo = felt.const 1 : <"bn128">
      %hi = felt.const 2 : <"bn128">
      %step = felt.const 1 : <"bn128">
      scf.while (%iv = %lo) : (!F) -> !F {
        constrain.eq %iv, %lo : !F, !F
        %cond = bool.cmp lt(%iv, %hi) : !F, !F
        scf.condition(%cond) %iv : !F
      } do {
      ^bb0(%iv: !F):
        %next = felt.add %iv, %step : !F, !F
        scf.yield %next : !F
      } attributes {llzk.loopbounds = #llzk.loopbounds<1 to 2 step 1>}
      function.return
    }
  }
}

