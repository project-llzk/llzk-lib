// CHECK-NEXT:      } {llzk.loopbounds = #llzk.loopbounds<2013265920 to 2013265922 step 1>}
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:    function.def @empty_equal(%[[VAL_40:[0-9a-zA-Z_\.]+]]: !felt.type<"babybear">, %[[VAL_41:[0-9a-zA-Z_\.]+]]: !felt.type<"babybear">, %[[VAL_42:[0-9a-zA-Z_\.]+]]: !felt.type<"babybear">) attributes {function.allow_non_native_field_ops} {
// CHECK-NEXT:      %[[VAL_43:[0-9a-zA-Z_\.]+]] = arith.constant 2013265922 : index
// CHECK-NEXT:      %[[VAL_44:[0-9a-zA-Z_\.]+]] = arith.constant 2013265922 : index
// CHECK-NEXT:      %[[VAL_45:[0-9a-zA-Z_\.]+]] = arith.constant 1 : index
// CHECK-NEXT:      scf.for %[[VAL_46:[0-9a-zA-Z_\.]+]] = %[[VAL_43]] to %[[VAL_44]] step %[[VAL_45]] {
// CHECK-NEXT:        %[[VAL_47:[0-9a-zA-Z_\.]+]] = cast.tofelt %[[VAL_46]] : index, !felt.type<"babybear">
// CHECK-NEXT:        %[[VAL_48:[0-9a-zA-Z_\.]+]] = bool.cmp lt(%[[VAL_47]], %[[VAL_41]]) : !felt.type<"babybear">, !felt.type<"babybear">
// CHECK-NEXT:        %[[VAL_49:[0-9a-zA-Z_\.]+]] = felt.add %[[VAL_47]], %[[VAL_42]] : !felt.type<"babybear">, !felt.type<"babybear">
// CHECK-NEXT:      } {llzk.loopbounds = #llzk.loopbounds<2013265922 to 2013265922 step 1>}
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:    function.def @empty_reversed(%[[VAL_50:[0-9a-zA-Z_\.]+]]: !felt.type<"babybear">, %[[VAL_51:[0-9a-zA-Z_\.]+]]: !felt.type<"babybear">, %[[VAL_52:[0-9a-zA-Z_\.]+]]: !felt.type<"babybear">) attributes {function.allow_non_native_field_ops} {
// CHECK-NEXT:      %[[VAL_53:[0-9a-zA-Z_\.]+]] = arith.constant 2013265922 : index
// CHECK-NEXT:      %[[VAL_54:[0-9a-zA-Z_\.]+]] = arith.constant 2013265921 : index
// CHECK-NEXT:      %[[VAL_55:[0-9a-zA-Z_\.]+]] = arith.constant 1 : index
// CHECK-NEXT:      scf.for %[[VAL_56:[0-9a-zA-Z_\.]+]] = %[[VAL_53]] to %[[VAL_54]] step %[[VAL_55]] {
// CHECK-NEXT:        %[[VAL_57:[0-9a-zA-Z_\.]+]] = cast.tofelt %[[VAL_56]] : index, !felt.type<"babybear">
// CHECK-NEXT:        %[[VAL_58:[0-9a-zA-Z_\.]+]] = bool.cmp lt(%[[VAL_57]], %[[VAL_51]]) : !felt.type<"babybear">, !felt.type<"babybear">
// CHECK-NEXT:        %[[VAL_59:[0-9a-zA-Z_\.]+]] = felt.add %[[VAL_57]], %[[VAL_52]] : !felt.type<"babybear">, !felt.type<"babybear">
// CHECK-NEXT:      } {llzk.loopbounds = #llzk.loopbounds<2013265922 to 2013265921 step 1>}
