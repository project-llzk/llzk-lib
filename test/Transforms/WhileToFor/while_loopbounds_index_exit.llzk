// RUN: llzk-opt --llzk-while-to-for --verify-diagnostics %s | FileCheck %s

// These annotations agree with the original BN128 loops; all arithmetic fits the field.
module attributes {llzk.lang} {
  // The two body IVs fit in index, but the final increment reaches INT64_MAX + 1.
  function.def @exit_overflow(%array: !array.type<1 x !felt.type<"bn128">>) attributes {function.allow_witness, function.allow_non_native_field_ops} {
    %lo = felt.const 9223372036854775804 : <"bn128">
    %hi = felt.const 9223372036854775807 : <"bn128">
    %step = felt.const 2 : <"bn128">
    %zero = arith.constant 0 : index
    // expected-warning@+1 {{'llzk-while-to-for' failed to transform loop: loopbounds final induction value cannot be represented as an index}}
    scf.while (%i = %lo) : (!felt.type<"bn128">) -> !felt.type<"bn128"> {
      %cond = bool.cmp lt(%i, %hi) : !felt.type<"bn128">, !felt.type<"bn128">
      scf.condition(%cond) %i : !felt.type<"bn128">
    } do {
    ^bb0(%i: !felt.type<"bn128">):
      array.write %array[%zero] = %i : !array.type<1 x !felt.type<"bn128">>, !felt.type<"bn128">
      %next = felt.add %i, %step : !felt.type<"bn128">, !felt.type<"bn128">
      scf.yield %next : !felt.type<"bn128">
    } attributes {llzk.loopbounds = #llzk.loopbounds<9223372036854775804 to 9223372036854775807 step 2>}
    function.return
  }

  // Trip-count rounding and the final value require more than signed 64-bit arithmetic.
  function.def @wide_exit_overflow(%array: !array.type<1 x !felt.type<"bn128">>) attributes {function.allow_witness, function.allow_non_native_field_ops} {
    %lo = felt.const 0 : <"bn128">
    %hi = felt.const 9223372036854775807 : <"bn128">
    %step = felt.const 9223372036854775806 : <"bn128">
    %zero = arith.constant 0 : index
    // expected-warning@+1 {{'llzk-while-to-for' failed to transform loop: loopbounds final induction value cannot be represented as an index}}
    scf.while (%i = %lo) : (!felt.type<"bn128">) -> !felt.type<"bn128"> {
      %cond = bool.cmp lt(%i, %hi) : !felt.type<"bn128">, !felt.type<"bn128">
      scf.condition(%cond) %i : !felt.type<"bn128">
    } do {
    ^bb0(%i: !felt.type<"bn128">):
      array.write %array[%zero] = %i : !array.type<1 x !felt.type<"bn128">>, !felt.type<"bn128">
      %next = felt.add %i, %step : !felt.type<"bn128">, !felt.type<"bn128">
      scf.yield %next : !felt.type<"bn128">
    } attributes {llzk.loopbounds = #llzk.loopbounds<0 to 9223372036854775807 step 9223372036854775806>}
    function.return
  }

  // An exact final value of INT64_MAX is representable.
  function.def @exit_at_index_max(%array: !array.type<1 x !felt.type<"bn128">>) attributes {function.allow_witness, function.allow_non_native_field_ops} {
    %lo = felt.const 9223372036854775803 : <"bn128">
    %hi = felt.const 9223372036854775807 : <"bn128">
    %step = felt.const 2 : <"bn128">
    %zero = arith.constant 0 : index
    scf.while (%i = %lo) : (!felt.type<"bn128">) -> !felt.type<"bn128"> {
      %cond = bool.cmp lt(%i, %hi) : !felt.type<"bn128">, !felt.type<"bn128">
      scf.condition(%cond) %i : !felt.type<"bn128">
    } do {
    ^bb0(%i: !felt.type<"bn128">):
      array.write %array[%zero] = %i : !array.type<1 x !felt.type<"bn128">>, !felt.type<"bn128">
      %next = felt.add %i, %step : !felt.type<"bn128">, !felt.type<"bn128">
      scf.yield %next : !felt.type<"bn128">
    } attributes {llzk.loopbounds = #llzk.loopbounds<9223372036854775803 to 9223372036854775807 step 2>}
    function.return
  }

  // Overshooting the exclusive upper bound is safe when the final value still fits.
  function.def @safe_overshoot(%array: !array.type<1 x !felt.type<"bn128">>) attributes {function.allow_witness, function.allow_non_native_field_ops} {
    %lo = felt.const 9223372036854775803 : <"bn128">
    %hi = felt.const 9223372036854775806 : <"bn128">
    %step = felt.const 2 : <"bn128">
    %zero = arith.constant 0 : index
    scf.while (%i = %lo) : (!felt.type<"bn128">) -> !felt.type<"bn128"> {
      %cond = bool.cmp lt(%i, %hi) : !felt.type<"bn128">, !felt.type<"bn128">
      scf.condition(%cond) %i : !felt.type<"bn128">
    } do {
    ^bb0(%i: !felt.type<"bn128">):
      array.write %array[%zero] = %i : !array.type<1 x !felt.type<"bn128">>, !felt.type<"bn128">
      %next = felt.add %i, %step : !felt.type<"bn128">, !felt.type<"bn128">
      scf.yield %next : !felt.type<"bn128">
    } attributes {llzk.loopbounds = #llzk.loopbounds<9223372036854775803 to 9223372036854775806 step 2>}
    function.return
  }

  // The trip-count numerator exceeds INT64_MAX, but the one-iteration loop is safe.
  function.def @full_index_step(%array: !array.type<1 x !felt.type<"bn128">>) attributes {function.allow_witness, function.allow_non_native_field_ops} {
    %lo = felt.const 0 : <"bn128">
    %hi = felt.const 9223372036854775807 : <"bn128">
    %step = felt.const 9223372036854775807 : <"bn128">
    %zero = arith.constant 0 : index
    scf.while (%i = %lo) : (!felt.type<"bn128">) -> !felt.type<"bn128"> {
      %cond = bool.cmp lt(%i, %hi) : !felt.type<"bn128">, !felt.type<"bn128">
      scf.condition(%cond) %i : !felt.type<"bn128">
    } do {
    ^bb0(%i: !felt.type<"bn128">):
      array.write %array[%zero] = %i : !array.type<1 x !felt.type<"bn128">>, !felt.type<"bn128">
      %next = felt.add %i, %step : !felt.type<"bn128">, !felt.type<"bn128">
      scf.yield %next : !felt.type<"bn128">
    } attributes {llzk.loopbounds = #llzk.loopbounds<0 to 9223372036854775807 step 9223372036854775807>}
    function.return
  }

  // An empty loop performs no increment, even with a maximal lower bound and step.
  function.def @empty_inverted_range(%array: !array.type<1 x !felt.type<"bn128">>) attributes {function.allow_witness, function.allow_non_native_field_ops} {
    %lo = felt.const 9223372036854775807 : <"bn128">
    %hi = felt.const 0 : <"bn128">
    %step = felt.const 9223372036854775807 : <"bn128">
    %zero = arith.constant 0 : index
    scf.while (%i = %lo) : (!felt.type<"bn128">) -> !felt.type<"bn128"> {
      %cond = bool.cmp lt(%i, %hi) : !felt.type<"bn128">, !felt.type<"bn128">
      scf.condition(%cond) %i : !felt.type<"bn128">
    } do {
    ^bb0(%i: !felt.type<"bn128">):
      array.write %array[%zero] = %i : !array.type<1 x !felt.type<"bn128">>, !felt.type<"bn128">
      %next = felt.add %i, %step : !felt.type<"bn128">, !felt.type<"bn128">
      scf.yield %next : !felt.type<"bn128">
    } attributes {llzk.loopbounds = #llzk.loopbounds<9223372036854775807 to 0 step 9223372036854775807>}
    function.return
  }

}

