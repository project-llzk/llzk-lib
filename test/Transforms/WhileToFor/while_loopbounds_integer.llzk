// RUN: llzk-opt --llzk-while-to-for %s | FileCheck %s
// RUN: llzk-opt --llzk-while-to-for --canonicalize %s | FileCheck %s --check-prefix=FOLDED

// Trusted annotations are materialized verbatim, independently of the IV's field.
module attributes {llzk.lang} {
  // A modulus-sized integer step must not become zero.
  function.def @modulus_step(%lo: !felt.type<"babybear">, %hi: !felt.type<"babybear">, %step: !felt.type<"babybear">, %array: !array.type<1 x !felt.type<"babybear">>) attributes {function.allow_witness, function.allow_non_native_field_ops} {
    %zero = arith.constant 0 : index
    scf.while (%i = %lo) : (!felt.type<"babybear">) -> !felt.type<"babybear"> {
      %cond = bool.cmp lt(%i, %hi) : !felt.type<"babybear">, !felt.type<"babybear">
      scf.condition(%cond) %i : !felt.type<"babybear">
    } do {
    ^bb0(%i: !felt.type<"babybear">):
      array.write %array[%zero] = %i : !array.type<1 x !felt.type<"babybear">>, !felt.type<"babybear">
      %next = felt.add %i, %step : !felt.type<"babybear">, !felt.type<"babybear">
      scf.yield %next : !felt.type<"babybear">
    } attributes {llzk.loopbounds = #llzk.loopbounds<0 to 10 step 2013265921>}
    function.return
  }

  // A step above the modulus must not shrink to its field representative.
  function.def @above_modulus_step(%lo: !felt.type<"babybear">, %hi: !felt.type<"babybear">, %step: !felt.type<"babybear">, %array: !array.type<1 x !felt.type<"babybear">>) attributes {function.allow_witness, function.allow_non_native_field_ops} {
    %zero = arith.constant 0 : index
    scf.while (%i = %lo) : (!felt.type<"babybear">) -> !felt.type<"babybear"> {
      %cond = bool.cmp lt(%i, %hi) : !felt.type<"babybear">, !felt.type<"babybear">
      scf.condition(%cond) %i : !felt.type<"babybear">
    } do {
    ^bb0(%i: !felt.type<"babybear">):
      array.write %array[%zero] = %i : !array.type<1 x !felt.type<"babybear">>, !felt.type<"babybear">
      %next = felt.add %i, %step : !felt.type<"babybear">, !felt.type<"babybear">
      scf.yield %next : !felt.type<"babybear">
    } attributes {llzk.loopbounds = #llzk.loopbounds<0 to 10 step 2013265922>}
    function.return
  }

  // The upper bound must also retain its integer value.
  function.def @upper_above_modulus(%lo: !felt.type<"babybear">, %hi: !felt.type<"babybear">, %step: !felt.type<"babybear">, %array: !array.type<1 x !felt.type<"babybear">>) attributes {function.allow_witness, function.allow_non_native_field_ops} {
    %zero = arith.constant 0 : index
    scf.while (%i = %lo) : (!felt.type<"babybear">) -> !felt.type<"babybear"> {
      %cond = bool.cmp lt(%i, %hi) : !felt.type<"babybear">, !felt.type<"babybear">
      scf.condition(%cond) %i : !felt.type<"babybear">
    } do {
    ^bb0(%i: !felt.type<"babybear">):
      array.write %array[%zero] = %i : !array.type<1 x !felt.type<"babybear">>, !felt.type<"babybear">
      %next = felt.add %i, %step : !felt.type<"babybear">, !felt.type<"babybear">
      scf.yield %next : !felt.type<"babybear">
    } attributes {llzk.loopbounds = #llzk.loopbounds<0 to 2013265931 step 1>}
    function.return
  }

  // Both bounds stay above the modulus, and the body retains its felt type.
  function.def @lower_above_modulus(%lo: !felt.type<"babybear">, %hi: !felt.type<"babybear">, %step: !felt.type<"babybear">, %array: !array.type<1 x !felt.type<"babybear">>) attributes {function.allow_witness, function.allow_non_native_field_ops} {
    %zero = arith.constant 0 : index
    scf.while (%i = %lo) : (!felt.type<"babybear">) -> !felt.type<"babybear"> {
      %cond = bool.cmp lt(%i, %hi) : !felt.type<"babybear">, !felt.type<"babybear">
      scf.condition(%cond) %i : !felt.type<"babybear">
    } do {
    ^bb0(%i: !felt.type<"babybear">):
      array.write %array[%zero] = %i : !array.type<1 x !felt.type<"babybear">>, !felt.type<"babybear">
      %next = felt.add %i, %step : !felt.type<"babybear">, !felt.type<"babybear">
      scf.yield %next : !felt.type<"babybear">
    } attributes {llzk.loopbounds = #llzk.loopbounds<2013265922 to 2013265925 step 1>}
    function.return
  }

  // The unused final IV is not the first result and has a different type from the bounds.
  function.def @carried_result(%lo: !felt.type, %hi: !felt.type, %step: !felt.type) -> index attributes {function.allow_non_native_field_ops} {
    %zero = arith.constant 0 : index
    %count, %end = scf.while (%sum = %zero, %i = %lo) : (index, !felt.type) -> (index, !felt.type) {
      %cond = bool.cmp lt(%i, %hi)
      scf.condition(%cond) %sum, %i : index, !felt.type
    } do {
    ^bb0(%sum: index, %i: !felt.type):
      %value = cast.toindex %i
      %next_sum = arith.addi %sum, %value : index
      %next = felt.add %i, %step
      scf.yield %next_sum, %next : index, !felt.type
    } attributes {llzk.loopbounds = #llzk.loopbounds<0 to 10 step 1>}
    function.return %count : index
  }
}

