// CHECK-NEXT:        scf.condition(%[[VAL_29]]) %[[VAL_28]] : !felt.type
// CHECK-NEXT:      } do {
// CHECK-NEXT:      ^bb0(%[[VAL_30:[0-9a-zA-Z_\.]+]]: !felt.type):
