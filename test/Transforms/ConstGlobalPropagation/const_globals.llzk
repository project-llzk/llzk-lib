// Generic IntegerAttr initializers may have a storage type different from the
// global's declared type. Propagation must materialize constants with the
// declared type before replacing the reads.
module attributes {llzk.lang} {
  "global.def"() <{constant, initial_value = 3 : i64, sym_name = "generic_index", type = index}> : () -> ()
  "global.def"() <{constant, initial_value = 1 : i64, sym_name = "generic_i1", type = i1}> : () -> ()

  function.def @read_generic_integers() -> (index, i1) {
    %index = global.read @generic_index : index
    %bool = global.read @generic_i1 : i1
    function.return %index, %bool : index, i1
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @read_generic_integers() -> (index, i1) {
// CHECK-NEXT:      %[[INDEX:[0-9a-zA-Z_\.]+]] = arith.constant 3 : index
// CHECK-NEXT:      %[[BOOL:[0-9a-zA-Z_\.]+]] = arith.constant true
// CHECK-NEXT:      function.return %[[INDEX]], %[[BOOL]] : index, i1
// CHECK-NEXT:    }
// CHECK-NEXT:  }
// -----

// A read can refer to more than one constant. Propagating @A erases the read,
// so propagation of @N must not retain a stale pointer to it.
module attributes {llzk.lang} {
  global.def const @A : index = 1
  global.def const @N : index = 2

  function.def @read_with_constant_metadata() -> index {
    %value = global.read @A : index {metadata = @N}
    function.return %value : index
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @read_with_constant_metadata() -> index {
// CHECK-NEXT:      %[[VAL_0:[0-9a-zA-Z_\.]+]] = arith.constant 1 : index
// CHECK-NEXT:      function.return %[[VAL_0]] : index
// CHECK-NEXT:    }
// CHECK-NEXT:  }
