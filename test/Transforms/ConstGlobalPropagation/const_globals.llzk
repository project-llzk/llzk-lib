// CHECK-NEXT:      %[[CONST:[0-9a-zA-Z_\.]+]] = felt.const  16
// CHECK-NEXT:      %[[VAL_0:[0-9a-zA-Z_\.]+]] = poly.unifiable_cast %[[CONST]] : (!felt.type) -> !felt.type<"babybear">
// CHECK-NEXT:      function.return %[[VAL_0]] : !felt.type<"babybear">
// CHECK-NEXT:    }
