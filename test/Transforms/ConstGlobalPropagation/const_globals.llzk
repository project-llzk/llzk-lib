module attributes {llzk.lang} {
  module @untyped_attr {
    global.def const @A : !felt.type<"babybear"> =  16
  }
  function.def @specified_as_unspecified() -> !felt.type {
    %a = global.read @untyped_attr::@A : !felt.type
    function.return %a : !felt.type
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    module @untyped_attr {
// CHECK-NEXT:    }
// CHECK-NEXT:    function.def @specified_as_unspecified() -> !felt.type {
// CHECK-NEXT:      %[[CONST:[0-9a-zA-Z_\.]+]] = felt.const  16 : <"babybear">
// CHECK-NEXT:      %[[VAL_0:[0-9a-zA-Z_\.]+]] = poly.unifiable_cast %[[CONST]] : (!felt.type<"babybear">) -> !felt.type
// CHECK-NEXT:      function.return %[[VAL_0]] : !felt.type
// CHECK-NEXT:    }
// CHECK-NEXT:  }
