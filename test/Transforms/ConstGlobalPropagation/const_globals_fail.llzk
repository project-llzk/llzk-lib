// RUN: llzk-opt -split-input-file -llzk-const-global-propagation -verify-diagnostics %s

module attributes {llzk.lang} {
  global.def const @G : index = 3

  struct.def @S {
    // expected-error@+1 {{type variable '!poly.tvar<@G>' must reference a parameter of its enclosing 'poly.template'}}
    struct.member @x : !poly.tvar<@G>
    function.def @product() -> !struct.type<@S> {
      %self = struct.new : !struct.type<@S>
      function.return %self : !struct.type<@S>
    }
  }
}

// -----

// Both specified fields unify with the unspecified global type, but not with each other.
// Const-global propagation must fail rather than create an invalid poly.unifiable_cast.
module attributes {llzk.lang} {
  global.def const @g : !felt.type = #felt<const 35 : !felt.type<"bn128">>

  function.def @read_as_babybear() -> !felt.type<"babybear"> {
    // expected-error@+1 {{'global.read' op cannot propagate initializer type '!felt.type<"bn128">' to read type '!felt.type<"babybear">'; the required poly.unifiable_cast is invalid}}
    %value = global.read @g : !felt.type<"babybear">
    function.return %value : !felt.type<"babybear">
  }
}
