// RUN: llzk-opt -split-input-file -llzk-pod-to-scalar %s | FileCheck --enable-var-scope %s

// A carried POD is captured and read inside an scf.if region.
!State = !pod.type<[@value: index]>
module attributes {llzk.lang} {
  function.def @while_if_carried_pod(%start: index, %count: index, %choose: i1) -> index {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %state = pod.new : !State
    pod.write %state[@value] = %start : !State, index
    %result:2 = scf.while (%i = %count, %pod = %state)
        : (index, !State) -> (index, !State) {
      %continue = arith.cmpi sgt, %i, %c0 : index
      scf.condition(%continue) %i, %pod : index, !State
    } do {
    ^bb0(%i: index, %pod: !State):
      %selected = scf.if %choose -> (index) {
        %value = pod.read %pod[@value] : !State, index
        scf.yield %value : index
      } else {
        %value = pod.read %pod[@value] : !State, index
        %next = arith.addi %value, %c1 : index
        scf.yield %next : index
      }
      pod.write %pod[@value] = %selected : !State, index
      %nextI = arith.subi %i, %c1 : index
      scf.yield %nextI, %pod : index, !State
    }
    %answer = pod.read %result#1[@value] : !State, index
    function.return %answer : index
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @while_if_carried_pod(%[[VAL_0:[0-9a-zA-Z_\.]+]]: index, %[[VAL_1:[0-9a-zA-Z_\.]+]]: index, %[[VAL_2:[0-9a-zA-Z_\.]+]]: i1) -> index {
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = arith.constant 1 : index
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:      %[[VAL_5:[0-9a-zA-Z_\.]+]]:2 = scf.while (%[[VAL_6:[0-9a-zA-Z_\.]+]] = %[[VAL_1]], %[[VAL_7:[0-9a-zA-Z_\.]+]] = %[[VAL_0]]) : (index, index) -> (index, index) {
// CHECK-NEXT:        %[[VAL_8:[0-9a-zA-Z_\.]+]] = arith.cmpi sgt, %[[VAL_6]], %[[VAL_4]] : index
// CHECK-NEXT:        scf.condition(%[[VAL_8]]) %[[VAL_6]], %[[VAL_7]] : index, index
// CHECK-NEXT:      } do {
// CHECK-NEXT:      ^bb0(%[[VAL_9:[0-9a-zA-Z_\.]+]]: index, %[[VAL_10:[0-9a-zA-Z_\.]+]]: index):
// CHECK-NEXT:        %[[VAL_11:[0-9a-zA-Z_\.]+]] = scf.if %[[VAL_2]] -> (index) {
// CHECK-NEXT:          scf.yield %[[VAL_10]] : index
// CHECK-NEXT:        } else {
// CHECK-NEXT:          %[[VAL_12:[0-9a-zA-Z_\.]+]] = arith.addi %[[VAL_10]], %[[VAL_3]] : index
// CHECK-NEXT:          scf.yield %[[VAL_12]] : index
// CHECK-NEXT:        }
// CHECK-NEXT:        %[[VAL_13:[0-9a-zA-Z_\.]+]] = arith.subi %[[VAL_9]], %[[VAL_3]] : index
// CHECK-NEXT:        scf.yield %[[VAL_13]], %[[VAL_11]] : index, index
// CHECK-NEXT:      }
// CHECK-NEXT:      function.return %[[VAL_5]]#1 : index
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

// A carried POD is captured and updated inside a nested scf.for region.
!State = !pod.type<[@value: index]>
module attributes {llzk.lang} {
  function.def @nested_loop_carried_pod(%start: index, %count: index) -> index {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %innerEnd = arith.constant 2 : index
    %state = pod.new : !State
    pod.write %state[@value] = %start : !State, index
    %result:2 = scf.while (%i = %count, %pod = %state)
        : (index, !State) -> (index, !State) {
      %continue = arith.cmpi sgt, %i, %c0 : index
      scf.condition(%continue) %i, %pod : index, !State
    } do {
    ^bb0(%i: index, %pod: !State):
      scf.for %j = %c0 to %innerEnd step %c1 {
        %value = pod.read %pod[@value] : !State, index
        %next = arith.addi %value, %j : index
        pod.write %pod[@value] = %next : !State, index
      }
      %nextI = arith.subi %i, %c1 : index
      scf.yield %nextI, %pod : index, !State
    }
    %answer = pod.read %result#1[@value] : !State, index
    function.return %answer : index
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @nested_loop_carried_pod(%[[VAL_0:[0-9a-zA-Z_\.]+]]: index, %[[VAL_1:[0-9a-zA-Z_\.]+]]: index) -> index {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = arith.constant 2 : index
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = arith.constant 1 : index
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:      %[[VAL_5:[0-9a-zA-Z_\.]+]]:2 = scf.while (%[[VAL_6:[0-9a-zA-Z_\.]+]] = %[[VAL_1]], %[[VAL_7:[0-9a-zA-Z_\.]+]] = %[[VAL_0]]) : (index, index) -> (index, index) {
// CHECK-NEXT:        %[[VAL_8:[0-9a-zA-Z_\.]+]] = arith.cmpi sgt, %[[VAL_6]], %[[VAL_4]] : index
// CHECK-NEXT:        scf.condition(%[[VAL_8]]) %[[VAL_6]], %[[VAL_7]] : index, index
// CHECK-NEXT:      } do {
// CHECK-NEXT:      ^bb0(%[[VAL_9:[0-9a-zA-Z_\.]+]]: index, %[[VAL_10:[0-9a-zA-Z_\.]+]]: index):
// CHECK-NEXT:        %[[VAL_11:[0-9a-zA-Z_\.]+]] = scf.for %[[VAL_12:[0-9a-zA-Z_\.]+]] = %[[VAL_4]] to %[[VAL_2]] step %[[VAL_3]] iter_args(%[[VAL_13:[0-9a-zA-Z_\.]+]] = %[[VAL_10]]) -> (index) {
// CHECK-NEXT:          %[[VAL_14:[0-9a-zA-Z_\.]+]] = arith.addi %[[VAL_13]], %[[VAL_12]] : index
// CHECK-NEXT:          scf.yield %[[VAL_14]] : index
// CHECK-NEXT:        }
// CHECK-NEXT:        %[[VAL_15:[0-9a-zA-Z_\.]+]] = arith.subi %[[VAL_9]], %[[VAL_3]] : index
// CHECK-NEXT:        scf.yield %[[VAL_15]], %[[VAL_11]] : index, index
// CHECK-NEXT:      }
// CHECK-NEXT:      function.return %[[VAL_5]]#1 : index
// CHECK-NEXT:    }
// CHECK-NEXT:  }
