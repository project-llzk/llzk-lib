// RUN: llzk-opt -llzk-pod-to-scalar %s | FileCheck %s

!Inner = !pod.type<[@values: !array.type<1 x index>]>
!Outer = !pod.type<[@inner: !Inner]>

// Returning the array read from an uninitialized nested POD is the minimal form of the residual
// POD failure exposed by Poseidon. The only aggregate read uniquely owns the result, so promotion
// cannot introduce an observable alias even though the array escapes the read-only use chain.
module attributes {llzk.lang} {
  function.def @return_nested_array() -> !array.type<1 x index> {
    %outer = pod.new : !Outer
    %inner = pod.read %outer[@inner] : !Outer, !Inner
    %values = pod.read %inner[@values] : !Inner, !array.type<1 x index>
    function.return %values : !array.type<1 x index>
  }
}

// -----

// Circom updates nested component inputs by reading the sole nested POD, modifying it, and writing
// the same value back. The read still uniquely owns the aggregate, and both writebacks become
// redundant once it is promoted.
module attributes {llzk.lang} {
  function.def @update_nested_array(%replacement: index) -> !array.type<1 x index> {
    %c0 = arith.constant 0 : index
    %outer = pod.new : !Outer
    %snapshot = pod.read %outer[@inner] : !Outer, !Inner
    %values = pod.read %snapshot[@values] : !Inner, !array.type<1 x index>
    array.write %values[%c0] = %replacement : !array.type<1 x index>, index
    %inner = pod.read %outer[@inner] : !Outer, !Inner
    pod.write %inner[@values] = %values : !Inner, !array.type<1 x index>
    pod.write %outer[@inner] = %inner : !Outer, !Inner
    %updated = pod.read %inner[@values] : !Inner, !array.type<1 x index>
    function.return %updated : !array.type<1 x index>
  }
}

// CHECK-LABEL:   module attributes {llzk.lang} {
// CHECK-NEXT:      function.def @return_nested_array() -> !array.type<1 x index> {
// CHECK-NEXT:        %[[VAL_0:[0-9a-zA-Z_\.]+]] = llzk.nondet : !array.type<1 x index>
// CHECK-NEXT:        function.return %[[VAL_0]] : !array.type<1 x index>
// CHECK-NEXT:      }
// CHECK-NEXT:    }

// CHECK-LABEL:   module attributes {llzk.lang} {
// CHECK-NEXT:      function.def @update_nested_array(%[[VAL_0:[0-9a-zA-Z_\.]+]]: index) -> !array.type<1 x index> {
// CHECK-NEXT:        %[[VAL_1:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:        %[[VAL_2:[0-9a-zA-Z_\.]+]] = llzk.nondet : !array.type<1 x index>
// CHECK-NEXT:        array.write %[[VAL_2]]{{\[}}%[[VAL_1]]] = %[[VAL_0]] : <1 x index>, index
// CHECK-NEXT:        function.return %[[VAL_2]] : !array.type<1 x index>
// CHECK-NEXT:      }
// CHECK-NEXT:    }
