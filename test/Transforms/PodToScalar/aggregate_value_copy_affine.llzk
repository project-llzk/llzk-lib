// RUN: llzk-opt %s -o /dev/null
// RUN: llzk-opt -llzk-pod-to-scalar -verify-diagnostics %s

#map = affine_map<()[s0] -> (s0)>
!Handle = !struct.type<@Template::@Box<[#map]>>
!Inner = !pod.type<[@handle: !Handle]>
!Outer = !pod.type<[@inner: !Inner]>
// expected-error@+1 {{llzk-pod-to-scalar left residual pod IR after reaching a fixpoint}}
module attributes {llzk.lang} {
  poly.template @Template {
    poly.param @N
    struct.def @Box {
      function.def @compute() -> !struct.type<@Template::@Box<[@N]>> {
        %self = struct.new : !struct.type<@Template::@Box<[@N]>>
        function.return %self : !struct.type<@Template::@Box<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@Template::@Box<[@N]>>) {
        function.return
      }
    }
  }
  function.def @snapshot(%n: index, %handle: !Handle) -> !Handle {
    %inner = pod.new()[%n] : !Inner
    pod.write %inner[@handle] = %handle : !Inner, !Handle
    // expected-note@+1 {{cannot promote POD record 'inner': POD copy requires affine-map instantiation operands that cannot be recovered}}
    %outer = pod.new()[%n] : !Outer
    pod.write %outer[@inner] = %inner : !Outer, !Inner
    %copy = pod.read %outer[@inner] : !Outer, !Inner
    %result = pod.read %copy[@handle] : !Inner, !Handle
    function.return %result : !Handle
  }
}
