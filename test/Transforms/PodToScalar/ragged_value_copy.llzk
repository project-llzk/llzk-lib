// RUN: llzk-opt -llzk-pod-to-scalar -verify-diagnostics %s

!Item = !pod.type<[@values: !array.type<? x index>]>
!Items = !array.type<2 x !Item>
module attributes {llzk.lang} {
  function.def @ragged_read_snapshot(%items: !Items, %i: index, %j: index, %replacement: index) -> index {
    // expected-error@+1 {{cannot copy nested array leaf: dynamic or symbolic payload arrays cannot be copied independently}}
    %item = array.read %items[%i] : !Items, !Item
    %first = pod.read %item[@values] : !Item, !array.type<? x index>
    %second = pod.read %item[@values] : !Item, !array.type<? x index>
    array.write %first[%j] = %replacement : !array.type<? x index>, index
    %value = array.read %second[%j] : !array.type<? x index>, index
    function.return %value : index
  }
}
