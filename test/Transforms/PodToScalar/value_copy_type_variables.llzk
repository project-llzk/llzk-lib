// RUN: llzk-opt -split-input-file -llzk-pod-to-scalar -verify-diagnostics %s

!Record = !pod.type<[@value: !poly.tvar<@T>]>
// expected-error@+1 {{llzk-pod-to-scalar left residual pod IR after reaching a fixpoint}}
module attributes {llzk.lang} {
  poly.template @Generic {
    poly.param @T : !poly.tvar<@T>
    function.def @direct(%value: !poly.tvar<@T>) -> !poly.tvar<@T> {
      // expected-note@+1 {{cannot promote POD record 'value'}}
      %record = pod.new { @value = %value } : !Record
      %result = pod.read %record[@value] : !Record, !poly.tvar<@T>
      function.return %result : !poly.tvar<@T>
    }
  }
}

// -----

!Record = !pod.type<[@value: !poly.tvar<@T>]>
!Outer = !pod.type<[@inner: !Record]>
// expected-error@+1 {{llzk-pod-to-scalar left residual pod IR after reaching a fixpoint}}
module attributes {llzk.lang} {
  poly.template @Generic {
    poly.param @T : !poly.tvar<@T>
    // expected-note@+1 {{cannot promote POD record 'value'}}
    function.def @nested(%value: !Record) -> !Record {
      // expected-note@+1 {{cannot promote POD record 'inner'}}
      %outer = pod.new { @inner = %value } : !Outer
      %result = pod.read %outer[@inner] : !Outer, !Record
      function.return %result : !Record
    }
  }
}

// -----

!Values = !array.type<3 x !poly.tvar<@T>>
!Box = !pod.type<[@values: !Values]>
// expected-error@+1 {{llzk-pod-to-scalar left residual pod IR after reaching a fixpoint}}
module attributes {llzk.lang} {
  poly.template @Generic {
    poly.param @T : !poly.tvar<@T>
    function.def @static_unsupported_element(%values: !Values) -> !Values {
      // expected-note@+1 {{cannot promote POD record 'values': array element copy is unsupported: unsupported value-copy type '!poly.tvar<@T>'}}
      %box = pod.new { @values = %values } : !Box
      %result = pod.read %box[@values] : !Box, !Values
      function.return %result : !Values
    }
  }
}

// -----

!Box = !pod.type<[@value: !poly.tvar<@T>]>
// expected-error@+1 {{llzk-pod-to-scalar left residual pod IR after reaching a fixpoint}}
module attributes {llzk.lang} {
  poly.template @Generic {
    poly.param @T : !poly.tvar<@T>
    function.def @unsupported_leaf(%value: !poly.tvar<@T>) -> !poly.tvar<@T> {
      // expected-note@+1 {{cannot promote POD record 'value': unsupported value-copy type '!poly.tvar<@T>'}}
      %box = pod.new { @value = %value } : !Box
      %result = pod.read %box[@value] : !Box, !poly.tvar<@T>
      function.return %result : !poly.tvar<@T>
    }
  }
}

// -----

// An unresolved type variable may later become mutable storage. Virtual POD accesses must
// enforce the same checked copy policy as local allocations.
!Record = !pod.type<[@value: !poly.tvar<@T>]>
// expected-error@+1 {{llzk-pod-to-scalar left residual pod IR after reaching a fixpoint}}
module attributes {llzk.lang} {
  poly.template @Generic {
    poly.param @T
    // expected-note@+1 {{cannot promote POD record 'value': unsupported value-copy type '!poly.tvar<@T>'}}
    function.def @direct_reads(%pod: !Record) -> (!poly.tvar<@T>, !poly.tvar<@T>) {
      %first = pod.read %pod[@value] : !Record, !poly.tvar<@T>
      %second = pod.read %pod[@value] : !Record, !poly.tvar<@T>
      function.return %first, %second : !poly.tvar<@T>, !poly.tvar<@T>
    }
  }
}

// -----

!Record = !pod.type<[@value: !poly.tvar<@T>]>
!Outer = !pod.type<[@inner: !Record]>
// expected-error@+1 {{llzk-pod-to-scalar left residual pod IR after reaching a fixpoint}}
module attributes {llzk.lang} {
  poly.template @Generic {
    poly.param @T
    // expected-note@+2 {{cannot promote POD record 'inner': POD record 'value': unsupported value-copy type '!poly.tvar<@T>'}}
    // expected-note@+1 {{cannot promote POD record 'value': unsupported value-copy type '!poly.tvar<@T>'}}
    function.def @nested_read(%pod: !Outer) -> !Record {
      %inner = pod.read %pod[@inner] : !Outer, !Record
      function.return %inner : !Record
    }
  }
}

// -----

!Record = !pod.type<[@value: !poly.tvar<@T>]>
// expected-error@+1 {{llzk-pod-to-scalar left residual pod IR after reaching a fixpoint}}
module attributes {llzk.lang} {
  poly.template @Generic {
    poly.param @T
    // expected-note@+1 {{cannot promote POD record 'value': unsupported value-copy type '!poly.tvar<@T>'}}
    function.def @virtual_write(%pod: !Record, %value: !poly.tvar<@T>) -> !poly.tvar<@T> {
      pod.write %pod[@value] = %value : !Record, !poly.tvar<@T>
      %result = pod.read %pod[@value] : !Record, !poly.tvar<@T>
      function.return %result : !poly.tvar<@T>
    }
  }
}

// -----

!State = !pod.type<[@value: !poly.tvar<@T>]>
// expected-error@+1 {{llzk-pod-to-scalar left residual pod IR after reaching a fixpoint}}
module attributes {llzk.lang} {
  poly.template @Generic {
    poly.param @T
    function.def @unknown_loop_leaf(%condition: i1, %seed: !poly.tvar<@T>) -> !poly.tvar<@T> {
      // expected-note@+1 {{cannot promote POD record 'value': unsupported value-copy type '!poly.tvar<@T>'}}
      %state = pod.new { @value = %seed } : !State
      // expected-note@+1 {{cannot promote POD record 'value': unsupported value-copy type '!poly.tvar<@T>'}}
      %result = scf.while (%pod = %state) : (!State) -> !State {
        scf.condition(%condition) %pod : !State
      } do {
      ^bb0(%pod: !State):
        %value = pod.read %pod[@value] : !State, !poly.tvar<@T>
        pod.write %pod[@value] = %value : !State, !poly.tvar<@T>
        scf.yield %pod : !State
      }
      %value = pod.read %result[@value] : !State, !poly.tvar<@T>
      function.return %value : !poly.tvar<@T>
    }
  }
}

// -----

!Unknown = !pod.type<[@value: !poly.tvar<@T>]>
// expected-error@+1 {{llzk-pod-to-scalar left residual pod IR after reaching a fixpoint}}
module attributes {llzk.lang} {
  poly.template @Generic {
    poly.param @T : !poly.tvar<@T>
    function.def @unsupported(%value: !poly.tvar<@T>) -> !poly.tvar<@T> {
      // expected-note@+1 {{cannot promote POD record 'value'}}
      %pod = pod.new { @value = %value } : !Unknown
      %copy = pod.read %pod[@value] : !Unknown, !poly.tvar<@T>
      function.return %copy : !poly.tvar<@T>
    }
  }
}
