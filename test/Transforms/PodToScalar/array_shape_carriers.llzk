// CHECK-NEXT:        function.return %[[VAL_3]] : !struct.type<@S>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_6:[0-9a-zA-Z_\.]+]]: !struct.type<@S>, %[[VAL_7:[0-9a-zA-Z_\.]+]]: !array.type<?,3 x index>, %[[VAL_8:[0-9a-zA-Z_\.]+]]: !array.type<? x none>, %[[VAL_9:[0-9a-zA-Z_\.]+]]: index) attributes {function.allow_constraint} {
