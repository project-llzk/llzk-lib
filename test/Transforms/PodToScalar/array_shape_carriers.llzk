!Elem = !pod.type<[@vals: !array.type<3 x !felt.type>]>
module attributes {llzk.lang} {
  struct.def @SignalCarrier {
    struct.member @m : !array.type<? x !Elem> {signal}

    function.def @compute() -> !struct.type<@SignalCarrier> {
      %self = struct.new : !struct.type<@SignalCarrier>
      function.return %self : !struct.type<@SignalCarrier>
    }

    function.def @constrain(%self: !struct.type<@SignalCarrier>) {
      function.return
    }
  }
}

