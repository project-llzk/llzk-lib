// RUN: llzk-opt -split-input-file -llzk-pod-to-scalar %s | FileCheck --enable-var-scope %s

#outer = affine_map<()[s0] -> (s0)>
#inner = affine_map<()[s0] -> (s0 + 1)>
!Elem = !pod.type<[@vals: !array.type<#inner x index>]>
!ElemArray = !array.type<#outer x !Elem>
module attributes {llzk.lang} {
  function.def @uninitialized(%n: index) -> !ElemArray {
    // The affine map initializer here is for the `#outer` map in `!ElemArray`, not the `#inner` map in `!Elem`.
    // The `#inner` map can only be initialized via an `array.new` that is then written to the pod which is not
    // present in this example. Thus, when `pod-to-scalar` combines the arrays to create a single, 2-D array,
    // the second dimension size must be `?` because no affine instantiation exists to provide as an affine
    // instantiation. However, the return value itself is unchanged so a `unifiable_cast` is used to convert.
    %arr = array.new{()[%n]} : !ElemArray
    function.return %arr : !ElemArray
  }
}

// CHECK: #[[$ATTR_0:[0-9a-zA-Z_\.]+]] = affine_map<()[s0] -> (s0)>
// CHECK: #[[$ATTR_1:[0-9a-zA-Z_\.]+]] = affine_map<()[s0] -> (s0 + 1)>
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @uninitialized(%[[VAL_0:[0-9a-zA-Z_\.]+]]: index) -> (!array.type<#[[$ATTR_0]],#[[$ATTR_1]] x index>, !array.type<#[[$ATTR_0]] x none>) {
// CHECK-NEXT:      %[[VAL_1:[0-9a-zA-Z_\.]+]] = array.new{(){{\[}}%[[VAL_0]]]} : <#[[$ATTR_0]],? x index>
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = poly.unifiable_cast %[[VAL_1]] : (!array.type<#[[$ATTR_0]],? x index>) -> !array.type<#[[$ATTR_0]],#[[$ATTR_1]] x index>
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = array.new{(){{\[}}%[[VAL_0]]]} : <#[[$ATTR_0]] x none>
// CHECK-NEXT:      function.return %[[VAL_2]], %[[VAL_3]] : !array.type<#[[$ATTR_0]],#[[$ATTR_1]] x index>, !array.type<#[[$ATTR_0]] x none>
// CHECK-NEXT:    }
// CHECK-NEXT:  }
