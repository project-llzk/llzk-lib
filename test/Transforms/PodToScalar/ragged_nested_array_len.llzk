// RUN: llzk-opt -split-input-file -llzk-pod-to-scalar -verify-diagnostics %s

// Ragged payload reads require copies before projections, shape queries, or boundary uses.
// Reject unsupported copies before constructing virtual POD storage without shape operands.

!Inner = !pod.type<[@vals: !array.type<? x index>]>
!OuterArr = !array.type<2 x !Inner>
module attributes {llzk.lang} {
  function.def @ragged_dynamic_len(%items: !OuterArr, %i: index) -> index {
    // expected-error@+1 {{cannot copy nested array leaf: dynamic or symbolic payload arrays cannot be copied independently}}
    %item = array.read %items[%i] : !OuterArr, !Inner
    %vals = pod.read %item[@vals] : !Inner, !array.type<? x index>
    %c0 = arith.constant 0 : index
    %len = array.len %vals, %c0 : !array.type<? x index>
    function.return %len : index
  }
}
// -----

!Inner = !pod.type<[@vals: !array.type<? x index>]>
!OuterArr = !array.type<2 x !Inner>
module attributes {llzk.lang} {
  function.def @ragged_dynamic_len_after_unifiable_cast(%items: !OuterArr, %i: index) -> index {
    // expected-error@+1 {{cannot copy nested array leaf: dynamic or symbolic payload arrays cannot be copied independently}}
    %item = array.read %items[%i] : !OuterArr, !Inner
    %vals = pod.read %item[@vals] : !Inner, !array.type<? x index>
    %cast = poly.unifiable_cast %vals : (!array.type<? x index>) -> !array.type<? x index>
    %c0 = arith.constant 0 : index
    %len = array.len %cast, %c0 : !array.type<? x index>
    function.return %len : index
  }
}
// -----

#map = affine_map<()[s0] -> (s0 + 1)>
!Inner = !pod.type<[@vals: !array.type<#map x index>]>
!OuterArr = !array.type<2 x !Inner>
module attributes {llzk.lang} {
  function.def @ragged_affine_len(%items: !OuterArr, %i: index) -> index {
    // expected-error@+1 {{cannot copy nested array leaf: dynamic or symbolic payload arrays cannot be copied independently}}
    %item = array.read %items[%i] : !OuterArr, !Inner
    %vals = pod.read %item[@vals] : !Inner, !array.type<#map x index>
    %c0 = arith.constant 0 : index
    %len = array.len %vals, %c0 : !array.type<#map x index>
    function.return %len : index
  }
}
// -----

#map = affine_map<()[s0] -> (s0 + 1)>
!Inner = !pod.type<[@vals: !array.type<#map x index>]>
!OuterArr = !array.type<2 x !Inner>
module attributes {llzk.lang} {
  function.def @ragged_affine_len_after_unifiable_cast(%items: !OuterArr, %i: index) -> index {
    // expected-error@+1 {{cannot copy nested array leaf: dynamic or symbolic payload arrays cannot be copied independently}}
    %item = array.read %items[%i] : !OuterArr, !Inner
    %vals = pod.read %item[@vals] : !Inner, !array.type<#map x index>
    %cast = poly.unifiable_cast %vals : (!array.type<#map x index>) -> !array.type<#map x index>
    %c0 = arith.constant 0 : index
    %len = array.len %cast, %c0 : !array.type<#map x index>
    function.return %len : index
  }
}
// -----

!Inner = !pod.type<[@vals: !array.type<? x index>]>
!OuterArr = !array.type<2 x !Inner>
module attributes {llzk.lang} {
  function.def @ragged_dynamic_whole_pod_eq(
      %items: !OuterArr, %other: !Inner, %i: index
  ) attributes {function.allow_constraint} {
    // expected-error@+1 {{cannot copy nested array leaf: dynamic or symbolic payload arrays cannot be copied independently}}
    %item = array.read %items[%i] : !OuterArr, !Inner
    constrain.eq %item, %other : !Inner
    function.return
  }
}
// -----

#map = affine_map<()[s0] -> (s0 + 1)>
!Inner = !pod.type<[@vals: !array.type<#map x index>]>
!OuterArr = !array.type<2 x !Inner>
module attributes {llzk.lang} {
  function.def @ragged_affine_whole_pod_eq(
      %items: !OuterArr, %other: !Inner, %i: index
  ) attributes {function.allow_constraint} {
    // expected-error@+1 {{cannot copy nested array leaf: dynamic or symbolic payload arrays cannot be copied independently}}
    %item = array.read %items[%i] : !OuterArr, !Inner
    constrain.eq %item, %other : !Inner
    function.return
  }
}
// -----

!Inner = !pod.type<[@vals: !array.type<? x index>]>
!OuterArr = !array.type<2 x !Inner>
module attributes {llzk.lang} {
  function.def @ragged_dynamic_array_of_pod_eq(
      %lhs: !OuterArr, %rhs: !OuterArr
  ) attributes {function.allow_constraint} {
    // expected-error@+2 {{'constrain.eq' op cannot lower nested dynamic array leaf equality for array-of-POD without per-element shape witnesses}}
    // expected-error@+1 {{failed to legalize operation 'constrain.eq'}}
    constrain.eq %lhs, %rhs : !OuterArr
    function.return
  }
}
// -----

#map = affine_map<()[s0] -> (s0 + 1)>
!Inner = !pod.type<[@vals: !array.type<#map x index>]>
!OuterArr = !array.type<2 x !Inner>
module attributes {llzk.lang} {
  function.def @ragged_affine_array_of_pod_eq(
      %lhs: !OuterArr, %rhs: !OuterArr
  ) attributes {function.allow_constraint} {
    // expected-error@+2 {{'constrain.eq' op cannot lower nested affine array leaf equality for array-of-POD without per-element shape witnesses}}
    // expected-error@+1 {{failed to legalize operation 'constrain.eq'}}
    constrain.eq %lhs, %rhs : !OuterArr
    function.return
  }
}
// -----

!Inner = !pod.type<[@vals: !array.type<? x index>]>
!OuterArr = !array.type<2 x !Inner>
module attributes {llzk.lang} {
  function.def @ragged_dynamic_containment(
      %items: !OuterArr, %needle: index, %i: index
  ) attributes {function.allow_constraint} {
    // expected-error@+1 {{cannot copy nested array leaf: dynamic or symbolic payload arrays cannot be copied independently}}
    %item = array.read %items[%i] : !OuterArr, !Inner
    %vals = pod.read %item[@vals] : !Inner, !array.type<? x index>
    constrain.in %vals, %needle : !array.type<? x index>, index
    function.return
  }
}
// -----

#map = affine_map<()[s0] -> (s0 + 1)>
!Inner = !pod.type<[@vals: !array.type<#map x index>]>
!OuterArr = !array.type<2 x !Inner>
module attributes {llzk.lang} {
  function.def @ragged_affine_containment(
      %items: !OuterArr, %needle: index, %i: index
  ) attributes {function.allow_constraint} {
    // expected-error@+1 {{cannot copy nested array leaf: dynamic or symbolic payload arrays cannot be copied independently}}
    %item = array.read %items[%i] : !OuterArr, !Inner
    %vals = pod.read %item[@vals] : !Inner, !array.type<#map x index>
    constrain.in %vals, %needle : !array.type<#map x index>, index
    function.return
  }
}
// -----

!Inner = !pod.type<[@vals: !array.type<? x index>]>
!OuterArr = !array.type<2 x !Inner>
module attributes {llzk.lang} {
  function.def @uses_len_after_call(%vals: !array.type<? x index>) -> index {
    %c0 = arith.constant 0 : index
    %len = array.len %vals, %c0 : !array.type<? x index>
    function.return %len : index
  }
  function.def @ragged_dynamic_call_arg(%items: !OuterArr, %i: index) -> index {
    // expected-error@+1 {{cannot copy nested array leaf: dynamic or symbolic payload arrays cannot be copied independently}}
    %item = array.read %items[%i] : !OuterArr, !Inner
    %vals = pod.read %item[@vals] : !Inner, !array.type<? x index>
    %len = function.call @uses_len_after_call(%vals) : (!array.type<? x index>) -> index
    function.return %len : index
  }
}
// -----

!Inner = !pod.type<[@vals: !array.type<? x index>]>
!OuterArr = !array.type<2 x !Inner>
module attributes {llzk.lang} {
  function.def @returns_ragged_dynamic_leaf(%items: !OuterArr, %i: index) -> !array.type<? x index> {
    // expected-error@+1 {{cannot copy nested array leaf: dynamic or symbolic payload arrays cannot be copied independently}}
    %item = array.read %items[%i] : !OuterArr, !Inner
    %vals = pod.read %item[@vals] : !Inner, !array.type<? x index>
    function.return %vals : !array.type<? x index>
  }
  function.def @ragged_dynamic_return_result(%items: !OuterArr, %i: index) -> index {
    %vals = function.call @returns_ragged_dynamic_leaf(%items, %i) : (!OuterArr, index) -> !array.type<? x index>
    %c0 = arith.constant 0 : index
    %len = array.len %vals, %c0 : !array.type<? x index>
    function.return %len : index
  }
}
// -----

#map = affine_map<()[s0] -> (s0 + 1)>
!Inner = !pod.type<[@vals: !array.type<#map x index>]>
!OuterArr = !array.type<2 x !Inner>
module attributes {llzk.lang} {
  function.def @ragged_affine_scf_yield(
      %items: !OuterArr, %fallback: !array.type<#map x index>, %i: index, %cond: i1
  ) attributes {function.allow_constraint} {
    // expected-error@+1 {{cannot copy nested array leaf: dynamic or symbolic payload arrays cannot be copied independently}}
    %item = array.read %items[%i] : !OuterArr, !Inner
    %vals = pod.read %item[@vals] : !Inner, !array.type<#map x index>
    %selected = scf.if %cond -> (!array.type<#map x index>) {
      scf.yield %vals : !array.type<#map x index>
    } else {
      scf.yield %fallback : !array.type<#map x index>
    }
    constrain.eq %selected, %fallback : !array.type<#map x index>
    function.return
  }
}
// -----

!Inner = !pod.type<[@vals: !array.type<? x index>]>
!OuterArr = !array.type<2 x !Inner>
module attributes {llzk.lang} {
  function.def @ragged_dynamic_for_iter(
      %items: !OuterArr, %i: index, %lb: index, %ub: index, %step: index
  ) -> index {
    // expected-error@+1 {{cannot copy nested array leaf: dynamic or symbolic payload arrays cannot be copied independently}}
    %item = array.read %items[%i] : !OuterArr, !Inner
    %vals = pod.read %item[@vals] : !Inner, !array.type<? x index>
    %carried = scf.for %iv = %lb to %ub step %step
        iter_args(%acc = %vals) -> (!array.type<? x index>) {
      scf.yield %acc : !array.type<? x index>
    }
    %c0 = arith.constant 0 : index
    %len = array.len %carried, %c0 : !array.type<? x index>
    function.return %len : index
  }
}
