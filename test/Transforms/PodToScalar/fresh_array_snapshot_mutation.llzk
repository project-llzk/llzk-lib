// RUN: llzk-opt -llzk-pod-to-scalar %s | FileCheck %s

!Item = !pod.type<[@x: index]>
!Items = !array.type<? x !Item>
!Box = !pod.type<[@items: !Items]>
module attributes {llzk.lang} {
  function.def @fresh_array_snapshot_mutation(%i: index, %replacement: index) -> (index, index) {
    %box = pod.new : !Box
    %first = pod.read %box[@items] : !Box, !Items
    %second = pod.read %box[@items] : !Box, !Items
    %item = pod.new { @x = %replacement } : !Item
    array.write %first[%i] = %item : !Items, !Item
    %readback = array.read %first[%i] : !Items, !Item
    %written = pod.read %readback[@x] : !Item, index
    %observed = array.read %second[%i] : !Items, !Item
    %value = pod.read %observed[@x] : !Item, index
    function.return %written, %value : index, index
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @fresh_array_snapshot_mutation(%[[VAL_0:[0-9a-zA-Z_\.]+]]: index, %[[VAL_1:[0-9a-zA-Z_\.]+]]: index) -> (index, index) {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = array.new  : <? x index>
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = array.new  : <? x index>
// CHECK-NEXT:      array.write %[[VAL_2]]{{\[}}%[[VAL_0]]] = %[[VAL_1]] : <? x index>, index
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_2]]{{\[}}%[[VAL_0]]] : <? x index>, index
// CHECK-NEXT:      %[[VAL_5:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_3]]{{\[}}%[[VAL_0]]] : <? x index>, index
// CHECK-NEXT:      function.return %[[VAL_4]], %[[VAL_5]] : index, index
// CHECK-NEXT:    }
// CHECK-NEXT:  }
