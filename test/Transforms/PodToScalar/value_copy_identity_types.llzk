// RUN: llzk-opt -split-input-file -llzk-pod-to-scalar %s | FileCheck --enable-var-scope %s

!Leaves = !pod.type<[@index: index, @bool: i1, @felt: !felt.type, @string: !string.type, @handle: !struct.type<@Box>]>
!Outer = !pod.type<[@leaves: !Leaves]>
module attributes {llzk.lang} {
  struct.def @Box {
    function.def @compute() -> !struct.type<@Box> {
      %self = struct.new : !struct.type<@Box>
      function.return %self : !struct.type<@Box>
    }
    function.def @constrain(%self: !struct.type<@Box>) {
      function.return
    }
  }
  function.def @identity_leaves(%i: index, %b: i1, %f: !felt.type, %s: !string.type, %h: !struct.type<@Box>) -> (index, i1, !felt.type, !string.type, !struct.type<@Box>) {
    %leaves = pod.new { @index = %i, @bool = %b, @felt = %f, @string = %s, @handle = %h } : !Leaves
    %outer = pod.new { @leaves = %leaves } : !Outer
    %copy = pod.read %outer[@leaves] : !Outer, !Leaves
    %ri = pod.read %copy[@index] : !Leaves, index
    %rb = pod.read %copy[@bool] : !Leaves, i1
    %rf = pod.read %copy[@felt] : !Leaves, !felt.type
    %rs = pod.read %copy[@string] : !Leaves, !string.type
    %rh = pod.read %copy[@handle] : !Leaves, !struct.type<@Box>
    function.return %ri, %rb, %rf, %rs, %rh : index, i1, !felt.type, !string.type, !struct.type<@Box>
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    struct.def @Box {
// CHECK-NEXT:      function.def @compute() -> !struct.type<@Box> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_0:[0-9a-zA-Z_\.]+]] = struct.new : <@Box>
// CHECK-NEXT:        function.return %[[VAL_0]] : !struct.type<@Box>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_1:[0-9a-zA-Z_\.]+]]: !struct.type<@Box>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    function.def @identity_leaves(%[[VAL_2:[0-9a-zA-Z_\.]+]]: index, %[[VAL_3:[0-9a-zA-Z_\.]+]]: i1, %[[VAL_4:[0-9a-zA-Z_\.]+]]: !felt.type, %[[VAL_5:[0-9a-zA-Z_\.]+]]: !string.type, %[[VAL_6:[0-9a-zA-Z_\.]+]]: !struct.type<@Box>) -> (index, i1, !felt.type, !string.type, !struct.type<@Box>) {
// CHECK-NEXT:      function.return %[[VAL_2]], %[[VAL_3]], %[[VAL_4]], %[[VAL_5]], %[[VAL_6]] : index, i1, !felt.type, !string.type, !struct.type<@Box>
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

!F = !felt.type<"bn128">
!State = !pod.type<[@child: !struct.type<@Child>]>

module attributes {llzk.lang} {
  struct.def @Child {
    struct.member @out : !F {llzk.pub}

    function.def @compute(%value: !F) -> !struct.type<@Child> {
      %self = struct.new : !struct.type<@Child>
      struct.writem %self[@out] = %value : !struct.type<@Child>, !F
      function.return %self : !struct.type<@Child>
    }

    function.def @constrain(%self: !struct.type<@Child>, %value: !F) {
      %out = struct.readm %self[@out] : !struct.type<@Child>, !F
      constrain.eq %out, %value : !F
      function.return
    }
  }

  // Repeated reads of one struct-valued record copy the component handle. They must therefore
  // continue to reference the same component rather than materializing independent structs.
  function.def @repeated_reads_alias(%child: !struct.type<@Child>) -> !F {
    %state = pod.new { @child = %child } : !State
    %first = pod.read %state[@child] : !State, !struct.type<@Child>
    %second = pod.read %state[@child] : !State, !struct.type<@Child>
    %firstOut = struct.readm %first[@out] : !struct.type<@Child>, !F
    %secondOut = struct.readm %second[@out] : !struct.type<@Child>, !F
    %sum = felt.add %firstOut, %secondOut : !F, !F
    function.return %sum : !F
  }

  // Scalarizing loop-carried POD state also forwards the same component handle as a leaf.
  function.def @while_carried_handle(
      %child: !struct.type<@Child>, %count: index, %initial: !F) -> !F {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %state = pod.new { @child = %child } : !State
    %result:3 = scf.while (%i = %count, %observed = %initial, %pod = %state)
        : (index, !F, !State) -> (index, !F, !State) {
      %condition = arith.cmpi sgt, %i, %c0 : index
      scf.condition(%condition) %i, %observed, %pod : index, !F, !State
    } do {
    ^bb0(%i: index, %observed: !F, %pod: !State):
      %sameChild = pod.read %pod[@child] : !State, !struct.type<@Child>
      %out = struct.readm %sameChild[@out] : !struct.type<@Child>, !F
      %next = arith.subi %i, %c1 : index
      scf.yield %next, %out, %pod : index, !F, !State
    }
    function.return %result#1 : !F
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    struct.def @Child {
// CHECK-NEXT:      struct.member @out : !felt.type<"bn128"> {llzk.pub}
// CHECK-NEXT:      function.def @compute(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !felt.type<"bn128">) -> !struct.type<@Child> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_1:[0-9a-zA-Z_\.]+]] = struct.new : <@Child>
// CHECK-NEXT:        struct.writem %[[VAL_1]][@out] = %[[VAL_0]] : <@Child>, !felt.type<"bn128">
// CHECK-NEXT:        function.return %[[VAL_1]] : !struct.type<@Child>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_2:[0-9a-zA-Z_\.]+]]: !struct.type<@Child>, %[[VAL_3:[0-9a-zA-Z_\.]+]]: !felt.type<"bn128">) attributes {function.allow_constraint} {
// CHECK-NEXT:        %[[VAL_4:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_2]][@out] : <@Child>, !felt.type<"bn128">
// CHECK-NEXT:        constrain.eq %[[VAL_4]], %[[VAL_3]] : !felt.type<"bn128">, !felt.type<"bn128">
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    function.def @repeated_reads_alias(%[[VAL_5:[0-9a-zA-Z_\.]+]]: !struct.type<@Child>) -> !felt.type<"bn128"> {
// CHECK-NEXT:      %[[VAL_6:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_5]][@out] : <@Child>, !felt.type<"bn128">
// CHECK-NEXT:      %[[VAL_7:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_5]][@out] : <@Child>, !felt.type<"bn128">
// CHECK-NEXT:      %[[VAL_8:[0-9a-zA-Z_\.]+]] = felt.add %[[VAL_6]], %[[VAL_7]] : !felt.type<"bn128">, !felt.type<"bn128">
// CHECK-NEXT:      function.return %[[VAL_8]] : !felt.type<"bn128">
// CHECK-NEXT:    }
// CHECK-NEXT:    function.def @while_carried_handle(%[[VAL_9:[0-9a-zA-Z_\.]+]]: !struct.type<@Child>, %[[VAL_10:[0-9a-zA-Z_\.]+]]: index, %[[VAL_11:[0-9a-zA-Z_\.]+]]: !felt.type<"bn128">) -> !felt.type<"bn128"> {
// CHECK-NEXT:      %[[VAL_12:[0-9a-zA-Z_\.]+]] = arith.constant 1 : index
// CHECK-NEXT:      %[[VAL_13:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:      %[[VAL_14:[0-9a-zA-Z_\.]+]]:3 = scf.while (%[[VAL_15:[0-9a-zA-Z_\.]+]] = %[[VAL_10]], %[[VAL_16:[0-9a-zA-Z_\.]+]] = %[[VAL_11]], %[[VAL_17:[0-9a-zA-Z_\.]+]] = %[[VAL_9]]) : (index, !felt.type<"bn128">, !struct.type<@Child>) -> (index, !felt.type<"bn128">, !struct.type<@Child>) {
// CHECK-NEXT:        %[[VAL_18:[0-9a-zA-Z_\.]+]] = arith.cmpi sgt, %[[VAL_15]], %[[VAL_13]] : index
// CHECK-NEXT:        scf.condition(%[[VAL_18]]) %[[VAL_15]], %[[VAL_16]], %[[VAL_17]] : index, !felt.type<"bn128">, !struct.type<@Child>
// CHECK-NEXT:      } do {
// CHECK-NEXT:      ^bb0(%[[VAL_19:[0-9a-zA-Z_\.]+]]: index, %[[VAL_20:[0-9a-zA-Z_\.]+]]: !felt.type<"bn128">, %[[VAL_21:[0-9a-zA-Z_\.]+]]: !struct.type<@Child>):
// CHECK-NEXT:        %[[VAL_22:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_21]][@out] : <@Child>, !felt.type<"bn128">
// CHECK-NEXT:        %[[VAL_23:[0-9a-zA-Z_\.]+]] = arith.subi %[[VAL_19]], %[[VAL_12]] : index
// CHECK-NEXT:        scf.yield %[[VAL_23]], %[[VAL_22]], %[[VAL_21]] : index, !felt.type<"bn128">, !struct.type<@Child>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.return %[[VAL_14]]#1 : !felt.type<"bn128">
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

!Shape = !array.type<? x none>
!Box = !pod.type<[@shape: !Shape]>
module attributes {llzk.lang} {
  function.def @copy_dynamic_shape(%box: !Box, %shape: !Shape) -> !Shape {
    pod.write %box[@shape] = %shape : !Box, !Shape
    %result = pod.read %box[@shape] : !Box, !Shape
    function.return %result : !Shape
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @copy_dynamic_shape(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !array.type<? x none>, %[[VAL_1:[0-9a-zA-Z_\.]+]]: !array.type<? x none>) -> !array.type<? x none> {
// CHECK-NEXT:      function.return %[[VAL_1]] : !array.type<? x none>
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

!Shape = !array.type<4 x none>
!Box = !pod.type<[@shape: !Shape]>
module attributes {llzk.lang} {
  function.def @copy_static_shape(%box: !Box, %shape: !Shape) -> !Shape {
    pod.write %box[@shape] = %shape : !Box, !Shape
    %result = pod.read %box[@shape] : !Box, !Shape
    function.return %result : !Shape
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @copy_static_shape(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !array.type<4 x none>, %[[VAL_1:[0-9a-zA-Z_\.]+]]: !array.type<4 x none>) -> !array.type<4 x none> {
// CHECK-NEXT:      function.return %[[VAL_1]] : !array.type<4 x none>
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

// A none-element array is a shape value, not an array with unsupported mutable payload.
!Shape = !array.type<3 x none>
!Box = !pod.type<[@shape: !Shape]>
module attributes {llzk.lang} {
  function.def @shape_copy(%shape: !Shape) -> !Shape {
    %box = pod.new { @shape = %shape } : !Box
    %result = pod.read %box[@shape] : !Box, !Shape
    function.return %result : !Shape
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @shape_copy(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !array.type<3 x none>) -> !array.type<3 x none> {
// CHECK-NEXT:      function.return %[[VAL_0]] : !array.type<3 x none>
// CHECK-NEXT:    }
// CHECK-NEXT:  }
