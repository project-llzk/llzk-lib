// RUN: llzk-opt -split-input-file -llzk-pod-to-scalar -verify-diagnostics %s | FileCheck %s

!Leaves = !pod.type<[@index: index, @bool: i1, @felt: !felt.type, @string: !string.type, @handle: !struct.type<@Box>]>
!Outer = !pod.type<[@leaves: !Leaves]>
module attributes {llzk.lang} {
  struct.def @Box {
    function.def @compute() -> !struct.type<@Box> {
      %self = struct.new : !struct.type<@Box>
      function.return %self : !struct.type<@Box>
    }
    function.def @constrain(%self: !struct.type<@Box>) {
      function.return
    }
  }
  function.def @identity_leaves(%i: index, %b: i1, %f: !felt.type, %s: !string.type, %h: !struct.type<@Box>) -> (index, i1, !felt.type, !string.type, !struct.type<@Box>) {
    %leaves = pod.new { @index = %i, @bool = %b, @felt = %f, @string = %s, @handle = %h } : !Leaves
    %outer = pod.new { @leaves = %leaves } : !Outer
    %copy = pod.read %outer[@leaves] : !Outer, !Leaves
    %ri = pod.read %copy[@index] : !Leaves, index
    %rb = pod.read %copy[@bool] : !Leaves, i1
    %rf = pod.read %copy[@felt] : !Leaves, !felt.type
    %rs = pod.read %copy[@string] : !Leaves, !string.type
    %rh = pod.read %copy[@handle] : !Leaves, !struct.type<@Box>
    function.return %ri, %rb, %rf, %rs, %rh : index, i1, !felt.type, !string.type, !struct.type<@Box>
  }
}

// -----

!Unknown = !pod.type<[@value: !poly.tvar<@T>]>
// expected-error@+1 {{llzk-pod-to-scalar left residual pod IR after reaching a fixpoint}}
module attributes {llzk.lang} {
  poly.template @Generic {
    poly.param @T : !poly.tvar<@T>
    function.def @unsupported(%value: !poly.tvar<@T>) -> !poly.tvar<@T> {
      // expected-note@+1 {{cannot promote POD record 'value'}}
      %pod = pod.new { @value = %value } : !Unknown
      %copy = pod.read %pod[@value] : !Unknown, !poly.tvar<@T>
      function.return %copy : !poly.tvar<@T>
    }
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    struct.def @Box {
// CHECK-NEXT:      function.def @compute() -> !struct.type<@Box> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_0:[0-9a-zA-Z_\.]+]] = struct.new : <@Box>
// CHECK-NEXT:        function.return %self : !struct.type<@Box>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_1:[0-9a-zA-Z_\.]+]]: !struct.type<@Box>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    function.def @identity_leaves(%[[VAL_2:[0-9a-zA-Z_\.]+]]: index, %[[VAL_3:[0-9a-zA-Z_\.]+]]: i1, %[[VAL_4:[0-9a-zA-Z_\.]+]]: !felt.type, %[[VAL_5:[0-9a-zA-Z_\.]+]]: !string.type, %[[VAL_6:[0-9a-zA-Z_\.]+]]: !struct.type<@Box>) -> (index, i1, !felt.type, !string.type, !struct.type<@Box>) {
// CHECK-NEXT:      function.return %arg0, %arg1, %arg2, %arg3, %arg4 : index, i1, !felt.type, !string.type, !struct.type<@Box>
// CHECK-NEXT:    }
// CHECK-NEXT:  }
