#outer = affine_map<()[s0] -> (s0)>
!Item = !pod.type<[@x: index]>
!Outer = !pod.type<[@items: !array.type<#outer x !Item>]>
module attributes {llzk.lang} {
  function.def @read_unwritten_dynamic(%n: index, %i: index) -> index {
    %p = pod.new()[%n] : !Outer
    %items = pod.read %p[@items] : !Outer, !array.type<#outer x !Item>
    %item = array.read %items[%i] : !array.type<#outer x !Item>, !Item
    %x = pod.read %item[@x] : !Item, index
    function.return %x : index
  }
}

