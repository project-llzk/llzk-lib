// -----

// COM: Regression test for deferred array-of-POD field reads inside loops. Step 3 must not
// COM: forward a parent-block write past an enclosing loop that carries writes to the same POD
// COM: record, or the loop body will keep reading the pre-loop array instead of the carried one.
!Item = !pod.type<[@x: index]>
!State = !pod.type<[@items: !array.type<2 x !Item>]>
module attributes {llzk.lang} {
  function.def @for_external_pod_array(%src: !State, %i: index) -> index {
    %items0 = pod.read %src[@items] : !State, !array.type<2 x !Item>
    %state = pod.new : !State
    pod.write %state[@items] = %items0 : !State, !array.type<2 x !Item>
    %c0 = arith.constant 0 : index
    %c2 = arith.constant 2 : index
    %c1 = arith.constant 1 : index
    scf.for %iv = %c0 to %c2 step %c1 {
      %cur = pod.read %state[@items] : !State, !array.type<2 x !Item>
      %item = array.read %cur[%i] : !array.type<2 x !Item>, !Item
      %x = pod.read %item[@x] : !Item, index
      pod.write %state[@items] = %cur : !State, !array.type<2 x !Item>
    }
    %final = pod.read %state[@items] : !State, !array.type<2 x !Item>
    %finalItem = array.read %final[%i] : !array.type<2 x !Item>, !Item
    %ret = pod.read %finalItem[@x] : !Item, index
    function.return %ret : index
  }

  function.def @while_external_pod_array(%src: !State, %count: index, %i: index) -> index {
    %items0 = pod.read %src[@items] : !State, !array.type<2 x !Item>
    %state = pod.new : !State
    pod.write %state[@items] = %items0 : !State, !array.type<2 x !Item>
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %res = scf.while (%n = %count) : (index) -> index {
      %cur = pod.read %state[@items] : !State, !array.type<2 x !Item>
      %item = array.read %cur[%i] : !array.type<2 x !Item>, !Item
      %x = pod.read %item[@x] : !Item, index
      %cond = arith.cmpi sgt, %n, %c0 : index
      scf.condition(%cond) %n : index
    } do {
    ^bb0(%n2: index):
      %cur2 = pod.read %state[@items] : !State, !array.type<2 x !Item>
      %item2 = array.read %cur2[%i] : !array.type<2 x !Item>, !Item
      %x2 = pod.read %item2[@x] : !Item, index
      pod.write %state[@items] = %cur2 : !State, !array.type<2 x !Item>
      %next = arith.subi %n2, %c1 : index
      scf.yield %next : index
    }
    %final = pod.read %state[@items] : !State, !array.type<2 x !Item>
    %finalItem = array.read %final[%i] : !array.type<2 x !Item>, !Item
    %ret = pod.read %finalItem[@x] : !Item, index
    function.return %ret : index
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @for_external_pod_array(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !array.type<2 x index>, %[[VAL_1:[0-9a-zA-Z_\.]+]]: index) -> index {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = array.new  : <2 x index>
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
