// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = array.new  : <? x index>
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = array.new  : <? x index>
// CHECK-NEXT:      array.write %[[VAL_2]]{{\[}}%[[VAL_0]]] = %[[VAL_1]] : <? x index>, index
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_2]]{{\[}}%[[VAL_0]]] : <? x index>, index
// CHECK-NEXT:      %[[VAL_5:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_3]]{{\[}}%[[VAL_0]]] : <? x index>, index
// CHECK-NEXT:      function.return %[[VAL_4]], %[[VAL_5]] : index, index
// CHECK-NEXT:    }
// CHECK-NEXT:  }
