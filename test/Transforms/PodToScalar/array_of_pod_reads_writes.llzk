// -----

!Item = !pod.type<[@x: index]>
!Items = !array.type<? x !Item>
!Box = !pod.type<[@items: !Items]>
module attributes {llzk.lang} {
  function.def @fresh_array_snapshot_mutation(%i: index, %replacement: index) -> (index, index) {
    %box = pod.new : !Box
    %first = pod.read %box[@items] : !Box, !Items
    %second = pod.read %box[@items] : !Box, !Items
    %item = pod.new { @x = %replacement } : !Item
    array.write %first[%i] = %item : !Items, !Item
    %readback = array.read %first[%i] : !Items, !Item
    %written = pod.read %readback[@x] : !Item, index
    %observed = array.read %second[%i] : !Items, !Item
    %value = pod.read %observed[@x] : !Item, index
    function.return %written, %value : index, index
  }
}

