!Item = !pod.type<[@x: index]>
!Outer = !pod.type<[@items: !array.type<2 x !Item>]>
module attributes {llzk.lang} {
  function.def @read_item(%p: !Outer, %i: index) -> index {
    %items = pod.read %p[@items] : !Outer, !array.type<2 x !Item>
    %item = array.read %items[%i] : !array.type<2 x !Item>, !Item
    %x = pod.read %item[@x] : !Item, index
    function.return %x : index
  }
}

