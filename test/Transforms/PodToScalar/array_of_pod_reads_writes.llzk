#outer = affine_map<()[s0] -> (s0)>
!Item = !pod.type<[@x: index]>
!Outer = !pod.type<[@items: !array.type<#outer x !Item>]>
module attributes {llzk.lang} {
  function.def @read_unwritten_dynamic(%n: index, %i: index) -> index {
    %p = pod.new()[%n] : !Outer
    %items = pod.read %p[@items] : !Outer, !array.type<#outer x !Item>
    %item = array.read %items[%i] : !array.type<#outer x !Item>, !Item
    %x = pod.read %item[@x] : !Item, index
    function.return %x : index
  }
}
// -----

#inner = affine_map<()[s0] -> (s0)>
!Item = !pod.type<[@x: index]>
!Outer = !pod.type<[@items: !array.type<#inner x !Item>, @tag: index]>
!OuterArray = !array.type<2 x !Outer>
// Writing a POD element must snapshot its symbolic array record instead of aliasing it.
// expected-error@+1 {{llzk-pod-to-scalar left residual pod IR after reaching a fixpoint}}
module attributes {llzk.lang} {
  function.def @write_elem(%arr: !OuterArray, %elem: !Outer, %i: index) -> !OuterArray {
    // expected-note@+1 {{cannot lower value-copy read of POD record 'items': dynamic or symbolic payload arrays cannot be copied independently; flatten or resolve array shapes first}}
    array.write %arr[%i] = %elem : !OuterArray, !Outer
    function.return %arr : !OuterArray
  }
}
