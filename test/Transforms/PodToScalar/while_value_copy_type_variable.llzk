// RUN: llzk-opt -llzk-pod-to-scalar -verify-diagnostics %s

!State = !pod.type<[@value: !poly.tvar<@T>]>
// expected-error@+1 {{llzk-pod-to-scalar left residual pod IR after reaching a fixpoint}}
module attributes {llzk.lang} {
  poly.template @Generic {
    poly.param @T
    function.def @unknown_loop_leaf(%condition: i1, %seed: !poly.tvar<@T>) -> !poly.tvar<@T> {
      // expected-note@+1 {{cannot promote POD record 'value': unsupported value-copy type '!poly.tvar<@T>'}}
      %state = pod.new { @value = %seed } : !State
      // expected-note@+1 {{cannot promote POD record 'value': unsupported value-copy type '!poly.tvar<@T>'}}
      %result = scf.while (%pod = %state) : (!State) -> !State {
        scf.condition(%condition) %pod : !State
      } do {
      ^bb0(%pod: !State):
        %value = pod.read %pod[@value] : !State, !poly.tvar<@T>
        pod.write %pod[@value] = %value : !State, !poly.tvar<@T>
        scf.yield %pod : !State
      }
      %value = pod.read %result[@value] : !State, !poly.tvar<@T>
      function.return %value : !poly.tvar<@T>
    }
  }
}
