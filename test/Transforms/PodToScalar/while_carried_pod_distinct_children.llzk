// RUN: llzk-opt -llzk-pod-to-scalar %s | FileCheck %s

!Child = !pod.type<[@value: index]>
!Parent = !pod.type<[@left: !Child, @right: !Child]>

// Read-only nested copies can be scalarized without introducing mutable snapshots.
module attributes {llzk.lang} {
  function.def @distinct_children(%count: index, %seed: index) -> index {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %child = pod.new : !Child
    pod.write %child[@value] = %seed : !Child, index
    %other = pod.new : !Child
    pod.write %other[@value] = %seed : !Child, index
    %parent = pod.new : !Parent
    pod.write %parent[@left] = %child : !Parent, !Child
    pod.write %parent[@right] = %other : !Parent, !Child
    %result:3 = scf.while (%i = %count, %observed = %seed, %pod = %parent)
        : (index, index, !Parent) -> (index, index, !Parent) {
      %cond = arith.cmpi sgt, %i, %c0 : index
      scf.condition(%cond) %i, %observed, %pod : index, index, !Parent
    } do {
    ^bb0(%i: index, %observed: index, %pod: !Parent):
      %left = pod.read %pod[@left] : !Parent, !Child
      %right = pod.read %pod[@right] : !Parent, !Child
      %leftValue = pod.read %left[@value] : !Child, index
      %rightValue = pod.read %right[@value] : !Child, index
      %seen = arith.addi %leftValue, %rightValue : index
      %next = arith.subi %i, %c1 : index
      scf.yield %next, %seen, %pod : index, index, !Parent
    }
    function.return %result#1 : index
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @distinct_children(%[[VAL_0:[0-9a-zA-Z_\.]+]]: index, %[[VAL_1:[0-9a-zA-Z_\.]+]]: index) -> index {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = arith.constant 1 : index
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]]:4 = scf.while (%[[VAL_5:[0-9a-zA-Z_\.]+]] = %[[VAL_0]], %[[VAL_6:[0-9a-zA-Z_\.]+]] = %[[VAL_1]], %[[VAL_7:[0-9a-zA-Z_\.]+]] = %[[VAL_1]], %[[VAL_8:[0-9a-zA-Z_\.]+]] = %[[VAL_1]]) : (index, index, index, index) -> (index, index, index, index) {
// CHECK-NEXT:        %[[VAL_9:[0-9a-zA-Z_\.]+]] = arith.cmpi sgt, %[[VAL_5]], %[[VAL_2]] : index
// CHECK-NEXT:        scf.condition(%[[VAL_9]]) %[[VAL_5]], %[[VAL_6]], %[[VAL_7]], %[[VAL_8]] : index, index, index, index
// CHECK-NEXT:      } do {
// CHECK-NEXT:      ^bb0(%[[VAL_10:[0-9a-zA-Z_\.]+]]: index, %[[VAL_11:[0-9a-zA-Z_\.]+]]: index, %[[VAL_12:[0-9a-zA-Z_\.]+]]: index, %[[VAL_13:[0-9a-zA-Z_\.]+]]: index):
// CHECK-NEXT:        %[[VAL_14:[0-9a-zA-Z_\.]+]] = arith.addi %[[VAL_12]], %[[VAL_13]] : index
// CHECK-NEXT:        %[[VAL_15:[0-9a-zA-Z_\.]+]] = arith.subi %[[VAL_10]], %[[VAL_3]] : index
// CHECK-NEXT:        scf.yield %[[VAL_15]], %[[VAL_14]], %[[VAL_12]], %[[VAL_13]] : index, index, index, index
// CHECK-NEXT:      }
// CHECK-NEXT:      function.return %[[VAL_4]]#1 : index
// CHECK-NEXT:    }
// CHECK-NEXT:  }
