// RUN: llzk-opt -llzk-pod-to-scalar -verify-diagnostics %s

!Item = !pod.type<[@x: index]>
!Items = !array.type<? x !Item>
!Box = !pod.type<[@items: !Items]>
// A projection must not bypass the unsupported copies at either POD boundary.
// expected-error@+1 {{llzk-pod-to-scalar left residual pod IR after reaching a fixpoint}}
module attributes {llzk.lang} {
  // expected-note@+1 {{cannot promote POD record 'items'}}
  function.def @deferred_write_read(%source: !Box, %i: index) -> index {
    %items = pod.read %source[@items] : !Box, !Items
    // expected-note@+1 {{cannot promote POD record 'items'}}
    %destination = pod.new : !Box
    pod.write %destination[@items] = %items : !Box, !Items
    %snapshot = pod.read %destination[@items] : !Box, !Items
    %item = array.read %snapshot[%i] : !Items, !Item
    %value = pod.read %item[@x] : !Item, index
    function.return %value : index
  }
}
