// RUN: llzk-opt -split-input-file -llzk-pod-to-scalar -verify-diagnostics %s

#len = affine_map<()[s0] -> (s0)>
!Values = !array.type<#len x index>
!Box = !pod.type<[@values: !Values]>

// A symbolic array cannot be enumerated to materialize an independent value copy.
// expected-error@+1 {{llzk-pod-to-scalar left residual pod IR after reaching a fixpoint}}
module attributes {llzk.lang} {
  function.def @unsupported_symbolic_copy(%n: index) -> !Values {
    // expected-note@+1 {{cannot promote POD record 'values': dynamic or symbolic payload arrays cannot be copied independently; flatten or resolve array shapes first}}
    %box = pod.new()[%n] : !Box
    %values = pod.read %box[@values] : !Box, !Values
    function.return %values : !Values
  }
}

// -----

#len = affine_map<()[s0] -> (s0)>
!Values = !array.type<#len x index>
!Box = !pod.type<[@values: !Values]>

// A preceding write must not make an unsupported symbolic array silently alias its source.
// expected-error@+1 {{llzk-pod-to-scalar left residual pod IR after reaching a fixpoint}}
module attributes {llzk.lang} {
  function.def @unsupported_symbolic_forwarding(%n: index, %source: !Values) -> !Values {
    // expected-note@+1 {{cannot promote POD record 'values': dynamic or symbolic payload arrays cannot be copied independently; flatten or resolve array shapes first}}
    %box = pod.new()[%n] : !Box
    pod.write %box[@values] = %source : !Box, !Values
    %values = pod.read %box[@values] : !Box, !Values
    function.return %values : !Values
  }
}

// -----

#len = affine_map<()[s0] -> (s0)>
!Values = !array.type<#len x index>
!Box = !pod.type<[@values: !Values]>

// A virtual POD argument must not turn an unsupported aggregate read into an alias of its leaf.
// expected-error@+1 {{llzk-pod-to-scalar left residual pod IR after reaching a fixpoint}}
module attributes {llzk.lang} {
  function.def @unsupported_virtual_pod_read(
      %box: !Box, %index: index, %replacement: index
  ) -> index {
    %first = pod.read %box[@values] : !Box, !Values
    array.write %first[%index] = %replacement : !Values, index
    %second = pod.read %box[@values] : !Box, !Values
    %observed = array.read %second[%index] : !Values, index
    function.return %observed : index
  }
}

// -----

#len = affine_map<()[s0] -> (s0)>
!Item = !pod.type<[@x: index]>
!Items = !array.type<#len x !Item>
!Box = !pod.type<[@items: !Items]>

// Split leaf arrays for a symbolic array-of-POD must not be forwarded as mutable backing storage.
module attributes {llzk.lang} {
  function.def @unsupported_deferred_array_copy(
      %box: !Box, %replacement: !Item, %index: index
  ) -> index {
    %first = pod.read %box[@items] : !Box, !Items
    // expected-error@+1 {{'array.write' op cannot mutate array-of-POD value read from POD record 'items': dynamic or symbolic payload arrays cannot be copied independently; flatten or resolve array shapes first}}
    array.write %first[%index] = %replacement : !Items, !Item
    %second = pod.read %box[@items] : !Box, !Items
    %item = array.read %second[%index] : !Items, !Item
    %observed = pod.read %item[@x] : !Item, index
    function.return %observed : index
  }
}
