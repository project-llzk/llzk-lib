// RUN: llzk-opt -split-input-file %s -o /dev/null
// RUN: llzk-opt -split-input-file -llzk-pod-to-scalar -verify-diagnostics %s

#len = affine_map<()[s0] -> (s0)>
!Values = !array.type<#len x index>
!Box = !pod.type<[@values: !Values]>

// A symbolic array cannot be enumerated to materialize an independent value copy.
// expected-error@+1 {{llzk-pod-to-scalar left residual pod IR after reaching a fixpoint}}
module attributes {llzk.lang} {
  function.def @unsupported_symbolic_copy(%n: index) -> !Values {
    // expected-note@+1 {{cannot promote POD record 'values': dynamic or symbolic payload arrays cannot be copied independently; flatten or resolve array shapes first}}
    %box = pod.new()[%n] : !Box
    %values = pod.read %box[@values] : !Box, !Values
    function.return %values : !Values
  }
}

// -----

#len = affine_map<()[s0] -> (s0)>
!Values = !array.type<#len x index>
!Box = !pod.type<[@values: !Values]>

// A preceding write must not make an unsupported symbolic array silently alias its source.
// expected-error@+1 {{llzk-pod-to-scalar left residual pod IR after reaching a fixpoint}}
module attributes {llzk.lang} {
  function.def @unsupported_symbolic_forwarding(%n: index, %source: !Values) -> !Values {
    // expected-note@+1 {{cannot promote POD record 'values': dynamic or symbolic payload arrays cannot be copied independently; flatten or resolve array shapes first}}
    %box = pod.new()[%n] : !Box
    pod.write %box[@values] = %source : !Box, !Values
    %values = pod.read %box[@values] : !Box, !Values
    function.return %values : !Values
  }
}

// -----

#len = affine_map<()[s0] -> (s0)>
!Values = !array.type<#len x index>
!Box = !pod.type<[@values: !Values]>

// A virtual POD argument must not turn an unsupported aggregate read into an alias of its leaf.
// expected-error@+1 {{llzk-pod-to-scalar left residual pod IR after reaching a fixpoint}}
module attributes {llzk.lang} {
  function.def @unsupported_virtual_pod_read(
      %box: !Box, %index: index, %replacement: index
  ) -> index {
    %first = pod.read %box[@values] : !Box, !Values
    array.write %first[%index] = %replacement : !Values, index
    %second = pod.read %box[@values] : !Box, !Values
    %observed = array.read %second[%index] : !Values, index
    function.return %observed : index
  }
}

// -----

#len = affine_map<()[s0] -> (s0)>
!Item = !pod.type<[@x: index]>
!Items = !array.type<#len x !Item>
!Box = !pod.type<[@items: !Items]>

// Split leaf arrays for a symbolic array-of-POD must not be forwarded as mutable backing storage.
module attributes {llzk.lang} {
  function.def @unsupported_deferred_array_copy(
      %box: !Box, %replacement: !Item, %index: index
  ) -> index {
    %first = pod.read %box[@items] : !Box, !Items
    // expected-error@+1 {{'array.write' op cannot mutate array-of-POD value read from POD record 'items': dynamic or symbolic payload arrays cannot be copied independently; flatten or resolve array shapes first}}
    array.write %first[%index] = %replacement : !Items, !Item
    %second = pod.read %box[@items] : !Box, !Items
    %item = array.read %second[%index] : !Items, !Item
    %observed = pod.read %item[@x] : !Item, index
    function.return %observed : index
  }
}

// -----

!Item = !pod.type<[@x: index]>
!Items = !array.type<? x !Item>
!Box = !pod.type<[@items: !Items]>
// A projection must not bypass the unsupported copies at either POD boundary.
// expected-error@+1 {{llzk-pod-to-scalar left residual pod IR after reaching a fixpoint}}
module attributes {llzk.lang} {
  // expected-note@+1 {{cannot promote POD record 'items'}}
  function.def @deferred_write_read(%source: !Box, %i: index) -> index {
    %items = pod.read %source[@items] : !Box, !Items
    // expected-note@+1 {{cannot promote POD record 'items'}}
    %destination = pod.new : !Box
    pod.write %destination[@items] = %items : !Box, !Items
    %snapshot = pod.read %destination[@items] : !Box, !Items
    %item = array.read %snapshot[%i] : !Items, !Item
    %value = pod.read %item[@x] : !Item, index
    function.return %value : index
  }
}

// -----

!Item = !pod.type<[@values: !array.type<? x index>]>
!Items = !array.type<2 x !Item>
module attributes {llzk.lang} {
  function.def @ragged_read_snapshot(%items: !Items, %i: index, %j: index, %replacement: index) -> index {
    // expected-error@+1 {{cannot copy nested array leaf: dynamic or symbolic payload arrays cannot be copied independently}}
    %item = array.read %items[%i] : !Items, !Item
    %first = pod.read %item[@values] : !Item, !array.type<? x index>
    %second = pod.read %item[@values] : !Item, !array.type<? x index>
    array.write %first[%j] = %replacement : !array.type<? x index>, index
    %value = array.read %second[%j] : !array.type<? x index>, index
    function.return %value : index
  }
}

// -----

#map = affine_map<()[s0] -> (s0)>
!Handle = !struct.type<@Template::@Box<[#map]>>
!Inner = !pod.type<[@handle: !Handle]>
!Outer = !pod.type<[@inner: !Inner]>
// expected-error@+1 {{llzk-pod-to-scalar left residual pod IR after reaching a fixpoint}}
module attributes {llzk.lang} {
  poly.template @Template {
    poly.param @N
    struct.def @Box {
      function.def @compute() -> !struct.type<@Template::@Box<[@N]>> {
        %self = struct.new : !struct.type<@Template::@Box<[@N]>>
        function.return %self : !struct.type<@Template::@Box<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@Template::@Box<[@N]>>) {
        function.return
      }
    }
  }
  function.def @snapshot(%n: index, %handle: !Handle) -> !Handle {
    %inner = pod.new()[%n] : !Inner
    pod.write %inner[@handle] = %handle : !Inner, !Handle
    // expected-note@+1 {{cannot promote POD record 'inner': POD copy requires affine-map instantiation operands that cannot be recovered}}
    %outer = pod.new()[%n] : !Outer
    pod.write %outer[@inner] = %inner : !Outer, !Inner
    %copy = pod.read %outer[@inner] : !Outer, !Inner
    %result = pod.read %copy[@handle] : !Inner, !Handle
    function.return %result : !Handle
  }
}
