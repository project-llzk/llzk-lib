// NOTE: Assertions have been autogenerated by scripts/generate-test-checks.py

// The script is designed to make adding checks to
// a test case fast, it is *not* designed to be authoritative
// about what constitutes a good test! The CHECK should be
// minimized and named to reflect the test intent.

// RUN: llzk-opt -split-input-file -llzk-pod-to-scalar %s | FileCheck --enable-var-scope %s

!Shape = !array.type<? x none>
!Box = !pod.type<[@shape: !Shape]>
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @copy_dynamic_shape(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !array.type<? x none>, %[[VAL_1:[0-9a-zA-Z_\.]+]]: !array.type<? x none>) -> !array.type<? x none> {
// CHECK-NEXT:      function.return %[[VAL_1]] : !array.type<? x none>
// CHECK-NEXT:    }
// CHECK-NEXT:  }
module attributes {llzk.lang} {
  function.def @copy_dynamic_shape(%box: !Box, %shape: !Shape) -> !Shape {
    pod.write %box[@shape] = %shape : !Box, !Shape
    %result = pod.read %box[@shape] : !Box, !Shape
    function.return %result : !Shape
  }
}

// -----

!Shape = !array.type<4 x none>
