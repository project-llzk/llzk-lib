// RUN: llzk-opt -split-input-file -llzk-pod-to-scalar %s | FileCheck --enable-var-scope %s

// Duplicate forwarding lowers successfully when the unused alias is eliminated.
!State = !pod.type<[@value: index]>

module attributes {llzk.lang} {
  function.def @lower_duplicate_forward(%count: index, %seed: index) -> index {
    %state = pod.new : !State
    pod.write %state[@value] = %seed : !State, index
    %result:3 = scf.while (%i = %count, %pod = %state, %unused = %state)
        : (index, !State, !State) -> (index, !State, !State) {
      %value = pod.read %pod[@value] : !State, index
      %condition = arith.cmpi sgt, %i, %value : index
      scf.condition(%condition) %i, %pod, %pod : index, !State, !State
    } do {
    ^bb0(%i: index, %pod0: !State, %pod1: !State):
      pod.write %pod0[@value] = %i : !State, index
      scf.yield %i, %pod0, %pod1 : index, !State, !State
    }
    %value = pod.read %result#1[@value] : !State, index
    function.return %value : index
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @lower_duplicate_forward(%[[VAL_0:[0-9a-zA-Z_\.]+]]: index, %[[VAL_1:[0-9a-zA-Z_\.]+]]: index) -> index {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]]:2 = scf.while (%[[VAL_3:[0-9a-zA-Z_\.]+]] = %[[VAL_0]], %[[VAL_4:[0-9a-zA-Z_\.]+]] = %[[VAL_1]]) : (index, index) -> (index, index) {
// CHECK-NEXT:        %[[VAL_5:[0-9a-zA-Z_\.]+]] = arith.cmpi sgt, %[[VAL_3]], %[[VAL_4]] : index
// CHECK-NEXT:        scf.condition(%[[VAL_5]]) %[[VAL_3]], %[[VAL_4]] : index, index
// CHECK-NEXT:      } do {
// CHECK-NEXT:      ^bb0(%[[VAL_6:[0-9a-zA-Z_\.]+]]: index, %[[VAL_7:[0-9a-zA-Z_\.]+]]: index):
// CHECK-NEXT:        scf.yield %[[VAL_6]], %[[VAL_6]] : index, index
// CHECK-NEXT:      }
// CHECK-NEXT:      function.return %[[VAL_2]]#1 : index
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

!Inner = !pod.type<[@value: index]>
!Outer = !pod.type<[@inner: !Inner]>

// The parent holds an independent copy, so writes to the carried source cannot affect the
// parent's snapshot and the carried source can now be scalarized.
module attributes {llzk.lang} {
  function.def @scalarize_live_parent_snapshot(%count: index, %seed: index) -> index {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %inner = pod.new : !Inner
    pod.write %inner[@value] = %seed : !Inner, index
    %outer = pod.new : !Outer
    pod.write %outer[@inner] = %inner : !Outer, !Inner
    %result:2 = scf.while (%i = %count, %innerArg = %inner)
        : (index, !Inner) -> (index, !Inner) {
      %condition = arith.cmpi sgt, %i, %c0 : index
      scf.condition(%condition) %i, %innerArg : index, !Inner
    } do {
    ^bb0(%i: index, %innerArg: !Inner):
      pod.write %innerArg[@value] = %i : !Inner, index
      %next = arith.subi %i, %c1 : index
      scf.yield %next, %innerArg : index, !Inner
    }
    %nested = pod.read %outer[@inner] : !Outer, !Inner
    %seen = pod.read %nested[@value] : !Inner, index
    function.return %seen : index
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @scalarize_live_parent_snapshot(%[[VAL_0:[0-9a-zA-Z_\.]+]]: index, %[[VAL_1:[0-9a-zA-Z_\.]+]]: index) -> index {
// CHECK-NEXT:      function.return %[[VAL_1]] : index
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// -----

!Inner = !pod.type<[@value: index]>
!Parent = !pod.type<[@inner: !Inner, @marker: index]>

// A separate scalar parent write does not invalidate the independent child snapshot.
module attributes {llzk.lang} {
  function.def @scalarize_mutated_live_parent(%count: index, %seed: index) -> index {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %inner = pod.new : !Inner
    pod.write %inner[@value] = %seed : !Inner, index
    %outer = pod.new : !Parent
    pod.write %outer[@inner] = %inner : !Parent, !Inner
    %result:2 = scf.while (%i = %count, %innerArg = %inner)
        : (index, !Inner) -> (index, !Inner) {
      %condition = arith.cmpi sgt, %i, %c0 : index
      scf.condition(%condition) %i, %innerArg : index, !Inner
    } do {
    ^bb0(%i: index, %innerArg: !Inner):
      pod.write %innerArg[@value] = %i : !Inner, index
      pod.write %outer[@marker] = %i : !Parent, index
      %next = arith.subi %i, %c1 : index
      scf.yield %next, %innerArg : index, !Inner
    }
    %nested = pod.read %outer[@inner] : !Parent, !Inner
    %seen = pod.read %nested[@value] : !Inner, index
    function.return %seen : index
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @scalarize_mutated_live_parent(%[[VAL_0:[0-9a-zA-Z_\.]+]]: index, %[[VAL_1:[0-9a-zA-Z_\.]+]]: index) -> index {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = llzk.nondet : index
// CHECK-NEXT:      function.return %[[VAL_1]] : index
// CHECK-NEXT:    }
// CHECK-NEXT:  }
