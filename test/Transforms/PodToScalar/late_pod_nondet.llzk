// RUN: llzk-opt --llzk-pod-to-scalar %s | FileCheck %s

// Mem2reg materializes a default value when an uninitialized nested POD record is read. The nested
// POD must remain explicit storage until a later SROA and mem2reg round scalarizes its leaf.
module attributes {llzk.lang} {
  function.def @read_uninitialized_nested_pod() -> index {
    %outer = pod.new : !pod.type<[@inner: !pod.type<[@value: index]>]>
    %inner = pod.read %outer[@inner] : <[@inner: !pod.type<[@value: index]>]>, !pod.type<[@value: index]>
    %value = pod.read %inner[@value] : <[@value: index]>, index
    function.return %value : index
  }

  // Two reads of an uninitialized nested record must still create independent snapshots.
  function.def @independent_uninitialized_reads(%replacement: index) -> index {
    %outer = pod.new : !pod.type<[@inner: !pod.type<[@value: index]>]>
    %first = pod.read %outer[@inner] : <[@inner: !pod.type<[@value: index]>]>, !pod.type<[@value: index]>
    %second = pod.read %outer[@inner] : <[@inner: !pod.type<[@value: index]>]>, !pod.type<[@value: index]>
    pod.write %first[@value] = %replacement : <[@value: index]>, index
    %value = pod.read %second[@value] : <[@value: index]>, index
    function.return %value : index
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @read_uninitialized_nested_pod() -> index {
// CHECK-NEXT:      %[[VAL_0:[0-9a-zA-Z_\.]+]] = llzk.nondet : index
// CHECK-NEXT:      function.return %nondet : index
// CHECK-NEXT:    }
// CHECK-NEXT:    function.def @independent_uninitialized_reads(%[[VAL_1:[0-9a-zA-Z_\.]+]]: index) -> index {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = llzk.nondet : index
// CHECK-NEXT:      function.return %nondet : index
// CHECK-NEXT:    }
// CHECK-NEXT:  }
