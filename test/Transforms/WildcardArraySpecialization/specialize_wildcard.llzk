// CHECK-NEXT:      %[[VAL_16:[0-9a-zA-Z_\.]+]] = function.call @"h\1Aead$$extern_!a<f:1>"(%[[VAL_15]], %[[VAL_14]]) : (!string.type, !array.type<1 x !felt.type>) -> !felt.type
// CHECK-NEXT:      function.return %[[VAL_16]] : !felt.type
// CHECK-NEXT:    }
// CHECK-NEXT:  }
