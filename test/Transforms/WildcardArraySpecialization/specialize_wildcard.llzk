// RUN: llzk-opt -split-input-file -llzk-specialize-wildcard-arrays -verify-diagnostics %s | FileCheck --enable-var-scope %s

module attributes {llzk.lang} {
  struct.def @Log {
    function.def @compute(%arg0: !string.type, %arg1: !array.type<? x !felt.type>) -> !struct.type<@Log> {
      %self = struct.new : !struct.type<@Log>
      function.return %self : !struct.type<@Log>
    }
    function.def @constrain(%arg0: !struct.type<@Log>, %arg1: !string.type, %arg2: !array.type<? x !felt.type>) {
      function.return
    }
  }

  function.def private @Log$$extern(!string.type, !array.type<? x !felt.type>) -> !felt.type attributes {extern}

  function.def @call_log_extern(%a: !array.type<1 x !felt.type>) -> !felt.type {
    %0 = poly.unifiable_cast %a : (!array.type<1 x !felt.type>) -> !array.type<? x !felt.type>
    %1 = string.new "extern: "
    %2 = function.call @Log$$extern(%1, %0) : (!string.type, !array.type<? x !felt.type>) -> !felt.type
    function.return %2 : !felt.type
  }

  struct.def @ComponentD {
    function.def @compute(%a: !array.type<1 x !felt.type>) -> !struct.type<@ComponentD> {
      %self = struct.new : !struct.type<@ComponentD>
      %1 = poly.unifiable_cast %a : (!array.type<1 x !felt.type>) -> !array.type<? x !felt.type>
      %2 = string.new "test: "
      %3 = function.call @Log::@compute(%2, %1) : (!string.type, !array.type<? x !felt.type>) -> !struct.type<@Log>
      function.return %self : !struct.type<@ComponentD>
    }

    function.def @constrain(%self: !struct.type<@ComponentD>, %a: !array.type<1 x !felt.type>) { function.return }
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    struct.def @"Log_!a<f:1>" {
// CHECK-NEXT:      function.def @compute(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !string.type, %[[VAL_1:[0-9a-zA-Z_\.]+]]: !array.type<1 x !felt.type>) -> !struct.type<@"Log_!a<f:1>"> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_2:[0-9a-zA-Z_\.]+]] = struct.new : <@"Log_!a<f:1>">
// CHECK-NEXT:        function.return %[[VAL_2]] : !struct.type<@"Log_!a<f:1>">
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_3:[0-9a-zA-Z_\.]+]]: !struct.type<@"Log_!a<f:1>">, %[[VAL_4:[0-9a-zA-Z_\.]+]]: !string.type, %[[VAL_5:[0-9a-zA-Z_\.]+]]: !array.type<1 x !felt.type>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    function.def private @"Log$$extern_!a<f:1>"(!string.type, !array.type<1 x !felt.type>) -> !felt.type attributes {extern}
// CHECK-NEXT:    function.def @call_log_extern(%[[VAL_6:[0-9a-zA-Z_\.]+]]: !array.type<1 x !felt.type>) -> !felt.type {
// CHECK-NEXT:      %[[VAL_7:[0-9a-zA-Z_\.]+]] = string.new "extern: "
// CHECK-NEXT:      %[[VAL_9:[0-9a-zA-Z_\.]+]] = function.call @"Log$$extern_!a<f:1>"(%[[VAL_7]], %[[VAL_6]]) : (!string.type, !array.type<1 x !felt.type>) -> !felt.type
// CHECK-NEXT:      function.return %[[VAL_9]] : !felt.type
// CHECK-NEXT:    }
// CHECK-NEXT:    struct.def @ComponentD {
// CHECK-NEXT:      function.def @compute(%[[VAL_10:[0-9a-zA-Z_\.]+]]: !array.type<1 x !felt.type>) -> !struct.type<@ComponentD> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_11:[0-9a-zA-Z_\.]+]] = string.new "test: "
// CHECK-NEXT:        %[[VAL_12:[0-9a-zA-Z_\.]+]] = struct.new : <@ComponentD>
// CHECK-NEXT:        %[[VAL_14:[0-9a-zA-Z_\.]+]] = function.call @"Log_!a<f:1>"::@compute(%[[VAL_11]], %[[VAL_10]]) : (!string.type, !array.type<1 x !felt.type>) -> !struct.type<@"Log_!a<f:1>">
// CHECK-NEXT:        function.return %[[VAL_12]] : !struct.type<@ComponentD>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_15:[0-9a-zA-Z_\.]+]]: !struct.type<@ComponentD>, %[[VAL_16:[0-9a-zA-Z_\.]+]]: !array.type<1 x !felt.type>) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }
// -----

module attributes {llzk.lang} {
  // Wildcard specialization appends its suffix without interpreting marker bytes in the base.
  // expected-warning@+1 {{Parameterized definition still has uses!}}
  function.def @"h\1Aead"(%arr: !array.type<? x !felt.type>) -> !felt.type {
    %cast = poly.unifiable_cast %arr : (!array.type<? x !felt.type>) -> !array.type<? x !felt.type>
    %zero = felt.const  0
    function.return %zero : !felt.type
  }

  function.def private @"h\1Aead$$extern"(%msg: !string.type, %arr: !array.type<? x !felt.type>) -> !felt.type attributes {extern}

  function.def @call_one_a(%arr: !array.type<1 x !felt.type>) -> !felt.type {
    %0 = function.call @"h\1Aead"(%arr) : (!array.type<1 x !felt.type>) -> !felt.type
    function.return %0 : !felt.type
  }

  function.def @call_one_b(%arr: !array.type<1 x !felt.type>) -> !felt.type {
    %0 = function.call @"h\1Aead"(%arr) : (!array.type<1 x !felt.type>) -> !felt.type
    function.return %0 : !felt.type
  }

  function.def @call_two(%arr: !array.type<2 x !felt.type>) -> !felt.type {
    %0 = function.call @"h\1Aead"(%arr) : (!array.type<2 x !felt.type>) -> !felt.type
    function.return %0 : !felt.type
  }

  function.def @call_unknown(%arr: !array.type<? x !felt.type>) -> !felt.type {
    %0 = function.call @"h\1Aead"(%arr) : (!array.type<? x !felt.type>) -> !felt.type
    function.return %0 : !felt.type
  }

  function.def @call_one_extern(%arr: !array.type<1 x !felt.type>) -> !felt.type {
    %msg = string.new "extern: "
    %0 = function.call @"h\1Aead$$extern"(%msg, %arr) : (!string.type, !array.type<1 x !felt.type>) -> !felt.type
    function.return %0 : !felt.type
  }
}
