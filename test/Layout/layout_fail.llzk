// RUN: llzk-translate %s --llzk-layout -verify-diagnostics

// Export does not instantiate templates or guess unresolved dimensions.

// expected-error @+1 {{LLZK layout requires a monomorphized llzk.main}}
module attributes {llzk.lang, llzk.main = !struct.type<@TMain::@Main<[2]>>} {
  poly.template @TMain {
    poly.param @N : index
    struct.def @Main {
      struct.member @values : !array.type<@N x !felt.type>
      function.def @compute() -> !struct.type<@TMain::@Main<[@N]>> {
        %self = struct.new : <@TMain::@Main<[@N]>>
        function.return %self : !struct.type<@TMain::@Main<[@N]>>
      }
      function.def @constrain(%self: !struct.type<@TMain::@Main<[@N]>>) { function.return }
    }
  }
}
